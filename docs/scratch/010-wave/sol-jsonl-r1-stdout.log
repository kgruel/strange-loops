   316	# ---------------------------------------------------------------------------
   317	# Ordering rule, as a pure function
   318	# ---------------------------------------------------------------------------
   319	
   320	def _f(rowid, fid):
   321	    return (rowid, (fid, "k", 1.0, "o", "", "{}", None))
   322	
   323	
   324	def _t(rowid, tid, cursor):
   325	    return (rowid, (tid, "n", 1.0, None, "o", "{}", None, "", cursor, None, None))
   326	
   327	
   328	def test_order_tick_lands_after_its_cursor_fact():
   329	    order = _receipt_order([_f(1, "A"), _f(2, "B"), _f(3, "C")],
   330	                           [(1, _t(1, "T", "B")[1])])
   331	    assert [r[0] for _, r in order] == ["A", "B", "T", "C"]
   332	
