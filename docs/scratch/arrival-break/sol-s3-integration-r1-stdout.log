  1643	def test_a_crash_retry_duplicate_does_not_weaken_the_read_forever():
  1644	    """The empirical case: one benign retry must not cost the file its O(1) opens.
  1645	
  1646	    A crash-retry duplicate is byte-identical BY CONSTRUCTION — the same entry,
  1647	    written again — and the journal is append-only, so the duplicate line is
  1648	    there for the life of the file. Weighting it would have bounded every
  1649	    subsequent read forever: ``established_head()`` raising for good, and the
  1650	    unchanged-open design gone, from a crash that lost nothing.
  1651	
  1652	    The skip record stays. What it stops doing is representing ignorance,
  1653	    because the content it skipped is a line this read already counted.
  1654	    """
  1655	    append_entry(observation(1))
  1656	    append_entry(observation(1))  # the retry, byte-identical
  1657	    for ordinal in (2, 3, 4, 5):
  1658	        append_entry(observation(ordinal))
  1659	
  1660	    result = read_journal(LINEAGE)
  1661	    assert any("byte-identical" in note for note in result.skipped), result.skipped
  1662	    known = result.established_head()  # ANSWERS rather than raising
  1663	    assert known is not None
  1664	    assert known.head == head(5)
  1665	    assert compare(known, head(5), None) is Outcome.UNCHANGED
  1666	    assert compare(known, head(7), known.head) is Outcome.ADVANCED
