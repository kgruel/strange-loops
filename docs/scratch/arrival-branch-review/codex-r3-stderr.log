  1630	        payload_text = json.dumps(d["payload"], default=_mapping_proxy_default)
  1631	
  1632	        prev_row = self._conn.execute(
  1633	            f"SELECT {_TICK_ROW_SQL} FROM ticks ORDER BY rowid DESC LIMIT 1"
  1634	        ).fetchone()
  1635	        prev_hash = _tick_row_hash(prev_row) if prev_row is not None else None
