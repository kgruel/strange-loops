   280	def _probe_log(path: Path) -> TargetInfo:
   281	    exists = path.is_file()
   282	    corroboration = _log_content_note(path) if exists else ""
   283	    return TargetInfo(
   284	        target_type="jsonl_log",
   285	        canonical_mode="jsonl",
   286	        canonical_path=path,
   287	        index_path=index_path_for(path),
   288	        exists=exists,
   289	        index_current=_currency(path) if exists else None,
   290	        declaration_status=None,
   291	        writable=_writable(path),
   292	        canonical_writable=write_surface_reason(path) is None,
   293	        reason=(
   294	            "JSONL-canonical log — the log is the store; the sibling .db "
   295	            "is a derived, rebuildable index" + corroboration
   296	        )
   297	        if exists
   298	        else "JSONL-canonical log locator — nothing on disk yet",
   299	    )
   300	
   301	
   302	def _probe_sqlite(path: Path) -> TargetInfo:
   303	    exists = path.is_file()
   304	    sibling_log = log_path_for(path)
   305	    corroboration = _sqlite_content_note(path) if exists else ""
   306	    if sibling_log.is_file():
   307	        return TargetInfo(
   308	            target_type="derived_index",
   309	            canonical_mode="jsonl",
   310	            canonical_path=sibling_log,
   311	            index_path=path,
   312	            exists=exists,
   313	            index_current=_currency(sibling_log),
   314	            declaration_status=None,
   315	            writable=False,
   316	            canonical_writable=write_surface_reason(sibling_log) is None,
   317	            reason=(
   318	                f"derived index over the JSONL-canonical log at "
   319	                f"{sibling_log} — NOT a write target: writing here is an "
   320	                "out-of-band insert the log cannot account for; writers "
   321	                "open the log (engine.jsonl_store.open_canonical_store)"
   322	                + corroboration
   323	            ),
   324	        )
   325	    return TargetInfo(
   326	        target_type="sqlite_store",
   327	        canonical_mode="sqlite",
   328	        canonical_path=path,
   329	        index_path=path,
   330	        exists=exists,
   331	        index_current=None,
   332	        declaration_status=None,
   333	        writable=_writable(path),
   334	        canonical_writable=write_surface_reason(path) is None,
   335	        reason=(
   336	            "sqlite-canonical store — no sibling canonical log; the db is "
   337	            "the store" + corroboration
   338	        )
   339	        if exists
   340	        else "sqlite-canonical store locator — nothing on disk yet",
   341	    )
