    45	def _signer(secret: str | None):
    46	    def signer(observer: str, digest: str) -> str | None:
    47	        if secret is None:
    48	            return None
    49	        return hashlib.sha256(f"{secret}:{observer}:{digest}".encode()).hexdigest()
