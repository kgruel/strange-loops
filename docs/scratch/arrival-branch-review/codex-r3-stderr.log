   235	                agreement=agreed,
   236	                signed_count=signed_count,
   237	                unsigned_count=unsigned_count,
   238	            )
   239	        finally:
   240	            reader.close()
   241	
   242	    # Bare store (.jsonl or .db)
   243	    canonical = info.canonical_path or target_path
   244	    index_path = info.index_path or canonical
   245	    reader, agreed = _ensure_reader(canonical, index_path)
   246	    try:
   247	        fact_total, tick_total, latest_ts, kinds, signed_counts = _compute_summary_stats(
   248	            reader, include_internal=include_internal
   249	        )
   250	        # signed_counts is (signed, TOTAL) — unsigned is the difference
   251	        signed_count = signed_counts[0] if signed_counts else 0
   252	        unsigned_count = (signed_counts[1] - signed_counts[0]) if signed_counts else 0
   253	
   254	        return ReadSummary(
   255	            target_type=info.target_type,
   256	            target_path=str(target_path),
   257	            canonical_mode=info.canonical_mode or "unknown",
   258	            canonical_path=str(canonical),
   259	            index_path=str(index_path),
   260	            declaration_status=None,
   261	            fact_total=fact_total,
   262	            tick_total=tick_total,
   263	            latest_ts=latest_ts,
   264	            kinds=kinds,
   265	            unfolded_kinds=[],
   266	            agreement=agreed,
   267	            signed_count=signed_count,
   268	            unsigned_count=unsigned_count,
   269	        )
   270	    finally:
   271	        reader.close()
   272	
   273	
   274	def read_facts(
   275	    target: Path | str,
   276	    *,
   277	    limit: int = 50,
   278	    kind: str | None = None,
   279	    observer: str | None = None,
   280	    order: str = "newest",
   281	    ordering: Ordering | None = None,
   282	    before: str | None = None,
   283	    after: str | None = None,
   284	    include_internal: bool = False,
   285	) -> FactPageResult:
   286	    """Read a bounded page of facts with stable witness pagination cursors.
   287	
   288	    Parameters:
   289	        target: Path to .vertex, .jsonl, or .db artifact.
   290	        limit: Maximum number of facts to return.
   291	        kind: Optional kind filter.
   292	        observer: Optional observer identity filter.
   293	        order: Sort direction along the ordering axis — 'oldest' ascending,
   294	            'newest' descending.
   295	        ordering: Declared read ordering. ``None`` keeps today's axis: receipt
   296	            order for a single-store vertex, the ``(ts, id)`` read lens for an
   297	            aggregate. Declaring ``Arrival()`` on a multi-store aggregate is
   298	            refused — see :func:`engine.vertex_reader.resolve_ordering`. Only
   299	            the resolved default axis is supported this cut; any other declared
   300	            ordering is refused rather than silently approximated.
   301	        before: Cursor token to fetch rows before (older than) the cursor in newest order.
   302	        after: Cursor token to fetch rows after (newer than) the cursor in oldest order.
   303	        include_internal: Whether to include internal `_decl.*` facts.
   304	
   305	    Returns:
   306	        FactPageResult containing deserialized fact items and pagination metadata.
   307	    """
   308	    if order not in ("newest", "oldest"):
   309	        raise SdkValueError(f"invalid order '{order}': expected 'newest' or 'oldest'")
   310	

