+from __future__ import annotations
+
+import json
+import tempfile
+from pathlib import Path
+
+from custody.signing import ARRIVAL_DOMAIN
+from engine.arrival import mint_lineage
+from engine.arrival_contract import RecordDraft, StoreDescriptor
+from engine.arrival_registry import BackendRegistry
+from lang import parse_vertex_file
+from migrate import TargetMismatchOnResumeRefused, identity, run_migration, transform
+from sign import ed25519
+
+
+def fixture(root: Path):
+    keys = ed25519.load_or_generate(root / "keys" / "alice")
+
+    def signer(observer: str, digest: str) -> str | None:
+        assert observer == "alice"
+        return ed25519.sign(keys, digest.encode(), domain=ARRIVAL_DOMAIN)
+
+    source = root / "legacy.jsonl"
+    source.write_text(json.dumps({
+        "t": "fact", "id": "legacy-id", "kind": "probe", "ts": 101.0,
+        "observer": "alice", "origin": "probe", "payload": "{}",
+    }) + "\n", encoding="utf-8")
+    vertex = root / "alice.vertex"
+    vertex.write_text(f'''name "Human Display Name"
+store "./legacy.jsonl"
+observers {{ alice {{ key "{keys.public_b64}" }} }}
+loops {{ probe {{ fold {{ items "collect" 10 }} }} }}
+''', encoding="utf-8")
+    expected = transform(source, parse_vertex_file(vertex), identity(), signer=signer).drafts[0]
+    return keys, signer, source, vertex, expected
+
+
+def staged(root: Path, filename: str | None = None):
+    keys, signer, source, vertex, expected = fixture(root)
+    lineage = mint_lineage()
+    target = root / (filename or f"{lineage}.arrival")
+    ledger, _ = BackendRegistry.with_builtin_backends().open(
+        StoreDescriptor(backend="file", location=str(target), lineage=lineage)
+    )
+    head = ledger.mint({
+        "observer": "alice", "signer": signer, "key": keys.public_b64,
+        "lineage": lineage, "at": 0.0,
+    })
+    return signer, source, vertex, expected, lineage, target, ledger, head
+
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    root = Path(tmp)
+
+    signer, source, vertex, expected, _, target, ledger, head = staged(root / "signature")
+    wrong = RecordDraft(expected.kind, expected.authored_at, expected.observer, expected.origin, expected.body, "outer-signature")
+    ledger.append(head, [wrong])
+    target_before, vertex_before = target.read_bytes(), vertex.read_bytes()
+    try:
+        run_migration(source, vertex, store_dir=target.parent, signer=signer, resume_target=target)
+    except TargetMismatchOnResumeRefused as exc:
+        print(f"signature: REFUSED ordinal={exc.ordinal} unchanged={target.read_bytes() == target_before and vertex.read_bytes() == vertex_before}")
+        assert exc.ordinal == 1
+        assert target.read_bytes() == target_before and vertex.read_bytes() == vertex_before
+    else:
+        raise AssertionError("outer-signed migrated draft resumed")
+
+    signer, source, vertex, expected, _, target, ledger, head = staged(root / "authored-at")
+    wrong = RecordDraft(expected.kind, expected.authored_at + 999.0, expected.observer, expected.origin, expected.body, expected.signature)
+    ledger.append(head, [wrong])
+    target_before, vertex_before = target.read_bytes(), vertex.read_bytes()
+    try:
+        run_migration(source, vertex, store_dir=target.parent, signer=signer, resume_target=target)
+    except TargetMismatchOnResumeRefused as exc:
+        print(f"authored_at: REFUSED ordinal={exc.ordinal} unchanged={target.read_bytes() == target_before and vertex.read_bytes() == vertex_before}")
+        assert exc.ordinal == 1
+        assert target.read_bytes() == target_before and vertex.read_bytes() == vertex_before
+    else:
+        raise AssertionError("wrong authored_at migrated draft resumed")
+
+    signer, source, vertex, _, lineage, target, _, _ = staged(root / "lineage", "friendly.arrival")
+    vertex_before = vertex.read_bytes()
+    try:
+        run_migration(source, vertex, store_dir=target.parent, signer=signer, resume_target=target)
+    except TargetMismatchOnResumeRefused as exc:
+        print(f"lineage: REFUSED filename={target.name!r} lineage_named_in_message={lineage in str(exc)}")
+        assert target.name in str(exc) and lineage in str(exc)
+        assert vertex.read_bytes() == vertex_before
+    else:
+        raise AssertionError("non-lineage-named target resumed")
+
+    signer, source, vertex, _, lineage, target, ledger, _ = staged(root / "control")
+    outcome = run_migration(source, vertex, store_dir=target.parent, signer=signer, resume_target=target)
+    rows = list(ledger.scan(through=outcome.head))
+    print(f"honest_control: resumed_head={outcome.head.ordinal} records={len(rows)} published={parse_vertex_file(vertex).store == Path('./' + target.name)}")
+    assert outcome.head.ordinal == 1 and len(rows) == 2
+
+print("PASS: complete draft identity, lineage naming, and honest partial resume hold")
