   193	# ---------------------------------------------------------------------------
   194	# The oracle
   195	# ---------------------------------------------------------------------------
   196	
   197	@pytest.mark.parametrize(
   198	    "eras",
   199	    [
   200	        {"prechain": True, "chained": True, "signed": True},
   201	        {"prechain": True, "chained": False, "signed": False},
   202	        {"prechain": False, "chained": True, "signed": False},
   203	        {"prechain": False, "chained": False, "signed": True},
   204	        {"prechain": True, "chained": False, "signed": True},
   205	    ],
   206	    ids=["all-eras", "prechain-only", "chained-only", "signed-only",
   207	         "prechain-plus-signed"],
   208	)
   209	def test_round_trip_is_hash_identical(tmp_path, eras):
   210	    from engine import tick_row_hash
   211	
   212	    src = _make_store(tmp_path / "src.db", **eras)
   213	    log = tmp_path / "src.jsonl"
   214	    dst = tmp_path / "rebuilt.db"
   215	
   216	    exported = export_jsonl(src, log)
   217	    rebuilt = rebuild_jsonl(log, dst)
   218	
   219	    src_facts, src_ticks = _fact_rows(src), _tick_rows(src)
   220	    dst_facts, dst_ticks = _fact_rows(dst), _tick_rows(dst)
   221	
   222	    # counts
   223	    assert (exported.facts, exported.ticks) == (len(src_facts), len(src_ticks))
   224	    assert (rebuilt.facts, rebuilt.ticks) == (len(src_facts), len(src_ticks))
   225	    assert exported.lines == len(src_facts) + len(src_ticks)
   226	
   227	    # byte-identical rows, in the same append order
   228	    assert dst_facts == src_facts
   229	    assert dst_ticks == src_ticks
   230	
   231	    # byte-identical row hashes, row for row
   232	    assert ([tick_row_hash(r) for r in dst_ticks]
   233	            == [tick_row_hash(r) for r in src_ticks])
   234	
   235	    # chain head via the tick_row_hash walk
   236	    assert _chain_head(dst) == _chain_head(src)
   237	
   238	    # verify passes on both
   239	    src_chain, src_factrep = _verify(src)
   240	    dst_chain, dst_factrep = _verify(dst)
   241	    assert src_chain["ok"] and dst_chain["ok"]
   242	    assert src_factrep["ok"] and dst_factrep["ok"]
   243	    assert dst_chain["ticks"] == src_chain["ticks"]
   244	
