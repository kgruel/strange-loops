  1351	def _torn_tail_guard(path: Path) -> str:
  1352	    """A newline when the file does not end in one, so an append cannot glue.
  1353	
  1354	    A crash mid-append leaves a fragment with no trailing newline. Appending
  1355	    straight onto it would concatenate the next entry into that fragment,
  1356	    producing ONE unreadable line — and the new entry's bytes would be lost
  1357	    inside it. The design's promise is that a torn tail costs at most the
  1358	    newest observation; without this guard an ordinary crash plus one commit
  1359	    would cost the next observation too.
  1360	
  1361	    Conservative when it cannot tell: an unreadable file gets the newline. A
  1362	    spurious blank line is skipped for free on read, while gluing is not
  1363	    recoverable at all.
  1364	    """
  1365	    try:
  1366	        with path.open("rb") as handle:
  1367	            if handle.seek(0, os.SEEK_END) == 0:
  1368	                return ""
  1369	            handle.seek(-1, os.SEEK_END)
  1370	            return "" if handle.read(1) == b"\n" else "\n"
  1371	    except OSError:
