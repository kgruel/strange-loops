   256	def _recover_then_open(
   257	    canonical: Path,
   258	    index: Path,
   259	    report: AgreementReport,
   260	    open_kwargs: dict[str, Any],
   261	) -> PreflightResult:
   262	    """Evidence first, then the store's own recovery, then the after-picture."""
   263	    import sqlite3
   264	
   265	    from .jsonl_codec import JsonlCodecError
   266	    from .jsonl_store import JsonlCanonicalUnsupported
   267	
   268	    mode = PreflightMode.RECOVER_THEN_OPEN
   269	    if not canonical.exists():
   270	        return _result(
   271	            mode, canonical, index, "unreadable", report=report,
   272	            reason=(
   273	                f"no canonical log at {canonical} — recovery rebuilds an "
   274	                "index FROM the log; it never invents a log"
   275	            ),
   276	        )
   277	    try:
   278	        # SOL-R2-03: a derived index that does not open as sqlite is
   279	        # discarded and rebuilt from the log by JsonlStore's own open —
   280	        # recovery lives at the store, not re-spelled here. A residual
   281	        # sqlite3.Error means that rebuild itself failed.
   282	        store = _open(canonical, open_kwargs)
   283	    except JsonlCanonicalUnsupported as exc:
   284	        return _result(
   285	            mode, canonical, index, "refused", report=report,
   286	            reason=f"recovery refused: {exc}",
   287	        )
   288	    except (JsonlCodecError, UnicodeDecodeError) as exc:
   289	        # Canonical corruption recovery cannot fix: the log itself does
   290	        # not decode (bad JSON, unknown discriminator, invalid UTF-8).
   291	        # Typed as ``unreadable`` — the canonical artifact cannot be read
   292	        # — with the pre-recovery audit evidence attached.
   293	        return _result(
   294	            mode, canonical, index, "unreadable", report=report,
   295	            reason=(
   296	                f"canonical log does not decode — corruption recovery "
   297	                f"cannot repair: {exc}"
   298	            ),
   299	        )
   300	    except sqlite3.Error as exc:
   301	        if _sqlite_busy(exc):
   302	            # SOL-R3-05: a transient BUSY/LOCKED is not failed corruption
   303	            # recovery — no rebuild ran and the canonical log reads fine.
   304	            # ``refused`` is the honest class for try-again-later (the
   305	            # closed vocabulary holds).
   306	            return _result(
   307	                mode, canonical, index, "refused", report=report,
   308	                reason=(
   309	                    f"store is busy — another handle holds the sqlite "
   310	                    f"write lock ({exc}); nothing was discarded, try again"
   311	                ),
   312	            )
   313	        return _result(
   314	            mode, canonical, index, "unreadable", report=report,
   315	            reason=(
   316	                f"derived index unusable and rebuilding it from the log "
   317	                f"also failed: {exc}"
   318	            ),
   319	        )
   320	    except OSError as exc:
   321	        # Environmental open failure (permissions, IO). The artifact may
   322	        # be fine; this process cannot read it — still ``unreadable``.
   323	        return _result(
   324	            mode, canonical, index, "unreadable", report=report,
   325	            reason=f"cannot open canonical store: {exc}",
   326	        )
   327	    recovered = not report.ok
   328	    return _result(
   329	        mode, canonical, index, "recovered" if recovered else "ok",
   330	        report=report,
   331	        post_report=audit_agreement(canonical) if recovered else None,
   332	        opened=True, recovered=recovered, store=store,
   333	        reason=(
   334	            "store recovered and opened; pre-recovery evidence in report, "
   335	            "post-recovery state in post_report"
   336	            if recovered
   337	            else "agreement audit passed; store opened (no recovery needed)"
   338	        ),
   339	    )
