   214	    assert not stale, (
   215	        "Rule 19: Stale _ALLOWLIST entries — the import they excused is no longer a violation:\n"
   216	        + "\n".join(stale)
   217	    )
     1	"""Quarantine ratchet guarding the freeze window against forbidden legacy imports.
     2	
     3	This ratchet guards the freeze window until slice 5 deletes those modules, at which point
     4	it dissolves (construction supersedes detection) — slice 5's residue sweep removes it.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import ast
    10	from pathlib import Path
    11	
    12	FORBIDDEN_MODULES: frozenset[str] = frozenset(
    13	    {
    14	        "engine.jsonl_codec",
    15	        "engine.jsonl_store",
    16	        "store.rebirth",
    17	        "store._conn",
    18	    }
    19	)
    20	
    21	
    22	def _collect_imported_names(py_path: Path) -> list[tuple[int, str]]:
    23	    """Parse a python file with ast and extract all imported module names."""
    24	    tree = ast.parse(py_path.read_text(encoding="utf-8"), filename=str(py_path))
    25	    imports: list[tuple[int, str]] = []
    26	    for node in ast.walk(tree):
    27	        if isinstance(node, ast.Import):
    28	            for alias in node.names:
    29	                imports.append((node.lineno, alias.name))
    30	        elif isinstance(node, ast.ImportFrom):
    31	            mod = node.module or ""
    32	            for alias in node.names:
    33	                full = f"{mod}.{alias.name}" if mod else alias.name
    34	                imports.append((node.lineno, full))
    35	                if mod:
    36	                    imports.append((node.lineno, mod))
    37	    return imports
    38	
    39	
    40	def test_quarantine_no_forbidden_legacy_imports() -> None:
    41	    """Walk every module under libs/migrate/src and assert none imports forbidden modules."""
    42	    src_dir = Path(__file__).resolve().parent.parent / "src"
    43	    py_files = sorted(src_dir.rglob("*.py"))
    44	    assert py_files, f"No python files found in {src_dir}"
    45	
    46	    violations: list[str] = []
    47	    for py_file in py_files:
    48	        imported = _collect_imported_names(py_file)
    49	        for lineno, name in imported:
    50	            for forbidden in FORBIDDEN_MODULES:
    51	                if name == forbidden or name.startswith(f"{forbidden}."):
    52	                    rel = py_file.relative_to(src_dir)
    53	                    violations.append(f"{rel}:{lineno} imports forbidden legacy module {forbidden!r} ({name})")
    54	
    55	    assert not violations, (
    56	        "Quarantine ratchet violation: forbidden legacy imports detected under libs/migrate/src:\n"
    57	        + "\n".join(violations)
    58	    )

