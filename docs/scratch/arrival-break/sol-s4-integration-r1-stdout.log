    89	def _make_vertex_file(
    90	    tmp_path: Path,
    91	    custodian_name: str,
    92	    custodian_key: str,
    93	    other_observers: list[tuple[str, str | None]],
    94	    store_rel_path: str = "./data/legacy.jsonl",
    95	) -> Path:
    96	    """Create a valid .vertex file on disk."""
    97	    v_path = tmp_path / "project.vertex"
    98	    obs_lines = [
    99	        f'  {custodian_name} {{\n    key "{custodian_key}"\n  }}',
   100	    ]
   101	    for name, key in other_observers:
   102	        if key is not None:
   103	            obs_lines.append(f'  {name} {{\n    key "{key}"\n  }}')
   104	        else:
   105	            obs_lines.append(f"  {name} {{ }}")
   106	
   107	    obs_block = "\n".join(obs_lines)
   108	    content = f"""name "{custodian_name}"
   109	store "{store_rel_path}"
   110	
   111	observers {{
   112	{obs_block}
   113	}}
   114	
   115	loops {{
   116	  concept {{ fold {{ items "collect" 100 }} }}
   117	  claim {{ fold {{ items "collect" 100 }} }}
   118	  event {{ fold {{ items "collect" 100 }} }}
   119	}}
   120	"""
   121	    v_path.write_text(content, encoding="utf-8")
   122	    return v_path
