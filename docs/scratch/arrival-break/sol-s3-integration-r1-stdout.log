  1724	    append_entry(observation(1))
  1725	    append_entry(observation(2))
  1726	    path = journal_path(LINEAGE)
  1727	    lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
  1728	    lines.insert(2, "{ damaged line\n")
  1729	    path.write_text("".join(lines), encoding="utf-8")
  1730	    append_reset(2)
  1731	    append_entry(observation(3, "b"))
