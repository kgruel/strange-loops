   334	def _open_combined(store_paths: list[Path]) -> tuple[sqlite3.Connection, list[str]]:
   335	    """Open the first store and ATTACH the rest. Returns (conn, aliases).
   336	
   337	    All databases are opened read-only via URI mode.
   338	    """
   339	    conn = sqlite3.connect(f"file:{store_paths[0]}?mode=ro", uri=True)
   340	    aliases = ["main"]
   341	    for i, path in enumerate(store_paths[1:], 1):
   342	        alias = f"s{i}"
   343	        assert alias.isidentifier() and alias.isascii(), f"Unsafe alias: {alias}"
   344	        conn.execute(f"ATTACH DATABASE ? AS [{alias}]", (f"file:{path}?mode=ro",))
   345	        aliases.append(alias)
   346	    return conn, aliases
