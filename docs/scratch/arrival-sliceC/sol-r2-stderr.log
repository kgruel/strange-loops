   101	def _compute_summary_stats(
   102	    reader: StoreReader,
   103	    *,
   104	    include_internal: bool = False,
   105	) -> tuple[int, int, float | None, dict[str, dict[str, Any]], tuple[int, int] | None]:
   106	    """Extract factual totals, tick counts, time bounds, and attestation metrics."""
   107	    raw_summary = reader.summary(include_internal=include_internal)
   108	    fact_total = raw_summary.get("facts", {}).get("total", 0)
   109	    tick_total = raw_summary.get("ticks", {}).get("total", 0)
   110	    kinds_dict = raw_summary.get("facts", {}).get("kinds", {})
   111	
   112	    all_latest: list[float] = []
   113	    kinds: dict[str, dict[str, Any]] = {}
   114	    for k, stats in kinds_dict.items():
   115	        earliest_iso = stats.get("earliest")
   116	        latest_iso = stats.get("latest")
   117	        if latest_iso is not None:
   118	            if isinstance(latest_iso, datetime):
   119	                all_latest.append(latest_iso.timestamp())
   120	            elif isinstance(latest_iso, (int, float)):
   121	                all_latest.append(float(latest_iso))
   122	            elif isinstance(latest_iso, str):
   123	                with contextlib.suppress(ValueError, TypeError):
   124	                    all_latest.append(datetime.fromisoformat(latest_iso).timestamp())
   125	        kinds[k] = {
   126	            "count": stats.get("count", 0),
   127	            "earliest": earliest_iso,
   128	            "latest": latest_iso,
   129	        }
   130	
   131	    latest_ts = max(all_latest) if all_latest else None
   132	    signed_counts = reader.signed_counts()
   133	    return fact_total, tick_total, latest_ts, kinds, signed_counts
