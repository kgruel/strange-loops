   163	
   164	def list_file_read(path: Path) -> tuple[list[str], list[PopulationRow]]:
   165	    """Read header + rows from a .list file.
   166	
   167	    Skips comments (#) and blank lines.
   168	    Last column gets remainder (split limit = len(header) - 1).
   169	    """
   170	    text = path.read_text()
   171	    lines = text.splitlines()
   172	    header: list[str] | None = None
   173	    rows: list[PopulationRow] = []
   174	
   175	    for raw in lines:
   176	        line = raw.strip()
   177	        if not line or line.startswith("#"):
   178	            continue
   179	
   180	        if header is None:
   181	            header = line.split()
   182	            continue
   183	
   184	        parts = line.split(None, len(header) - 1)
   185	        if len(parts) != len(header):
   186	            continue  # skip malformed rows
   187	        values = dict(zip(header, parts))
   188	        rows.append(PopulationRow(key=parts[0], values=values))
   189	
   190	    return header or [], rows
   191	
   192	
   193	def list_file_header(path: Path) -> list[str]:
   194	    """Read only the header row from a .list file.
   195	
   196	    Returns [] if no header is present.
   197	    """
   198	    if not path.exists():
   199	        return []
   200	    for raw in path.read_text().splitlines():
   201	        line = raw.strip()
   202	        if not line or line.startswith("#"):
   203	            continue
   204	        return line.split()
   205	    return []
   206	
   207	
   208	def list_file_add(path: Path, header: list[str], row: PopulationRow) -> None:
   209	    """Append row to .list file. Creates file with header if it doesn't exist."""
   210	    if not path.exists():
   211	        path.write_text(
   212	            " ".join(header)
   213	            + "\n"
   214	            + " ".join(row.values[h] for h in header)
   215	            + "\n"
   216	        )
   217	        return
   218	
   219	    with open(path, "a") as f:
   220	        f.write(" ".join(row.values[h] for h in header) + "\n")
   221	
   222	
   223	def list_file_rm(path: Path, key: str) -> bool:
   224	    """Remove row by key (first column). Returns True if found.
   225	
   226	    Preserves header, comments, and blank lines.
   227	    """
   228	    if not path.exists():
   229	        return False
   230	
   231	    lines = path.read_text().splitlines()
   232	    kept: list[str] = []
   233	    removed = False
   234	    header_seen = False
   235	
   236	    for line in lines:
   237	        stripped = line.strip()
   238	        if stripped and not stripped.startswith("#"):
   239	            if not header_seen:
   240	                # First non-comment, non-blank line is the header — always keep
   241	                header_seen = True
   242	                kept.append(line)
   243	                continue
   244	            parts = stripped.split(None, 1)
   245	            if parts and parts[0] == key:
   246	                removed = True
   247	                continue
   248	        kept.append(line)
   249	
   250	    if removed:
   251	        path.write_text("\n".join(kept) + "\n")
   252	    return removed
   253	
   254	
   255	def list_file_write(path: Path, header: list[str], rows: list[PopulationRow]) -> None:
   256	    """Full rewrite of a .list file."""
   257	    lines = [" ".join(header)]
   258	    for row in rows:
   259	        lines.append(" ".join(row.values[h] for h in header))
   260	    path.write_text("\n".join(lines) + "\n")
