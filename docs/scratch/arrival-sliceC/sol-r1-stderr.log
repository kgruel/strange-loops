    92	INTENT_SUFFIX = ".intent"
    93	# v2: ``old_decl_head`` persists an ARRIVAL coordinate (record ordinal, id)
    94	# for the arrival store family, where v1 persisted an index rowid. The shape
    95	# is unchanged — ``[int, str]`` either way — so nothing about the record's
    96	# form distinguishes a stale v1 coordinate from a live v2 one. The version
    97	# IS the discriminator, and recovery refuses a v1 intent loudly rather than
    98	# comparing a rowid against an ordinal and guessing.
    99	_INTENT_VERSION = 2
