   130	
   131	def _default_get_field(record: Any, field: str) -> Any:
   132	    if isinstance(record, Mapping):
   133	        return record.get(field)
   134	    return getattr(record, field, None)
   135	
   136	
   137	def _default_get_id(record: Any) -> Any:
   138	    if isinstance(record, Mapping):
   139	        return record["id"]
   140	    return record.id
   141	
   142	
   143	def totalize(
   144	    records: Iterable[R],
   145	    ordering: Ordering,
   146	    *,
   147	    get_field: Callable[[R, str], Any] = _default_get_field,
   148	    get_id: Callable[[R], Any] = _default_get_id,
   149	) -> list[R]:
   150	    """Order records under a declared Ordering. The one sort-key definition.
   151	
   152	    ``ByKey(K)``: sort key ``(K(record), record.id)``, id ascending. **The id
   153	    is a TIE-BREAK ONLY — never semantic time.**
   154	
   155	    A record without ``K`` is NOT in the ``ByKey(K)`` projection: a key names
   156	    what it projects, and absence is non-membership. A ``None`` value counts
   157	    as absent. This is exclusion-by-declaration — the caller named K — not
   158	    silent loss.
   159	
   160	    Key values of mixed types under one declared key are REFUSED with
   161	    ``OrderingError``. The check is strict TYPE IDENTITY, not comparability:
   162	    ``"5"`` and ``5`` refuse, ``True`` and ``1`` refuse, and so do ``1`` and
   163	    ``2.0`` — Python would happily order that last pair, and refusing it
   164	    anyway is the point. A key whose values are sometimes int and sometimes
   165	    float is a declaration the data does not support, and silently ordering it
   166	    would hide that. Same-typed values that do not compare (dicts, say) are
   167	    refused the same way.
   168	
   169	    A record that CARRIES ``K`` but has no id raises the accessor's own error
   170	    (``KeyError``/``AttributeError``), unwrapped and by ruling: an id is the
   171	    substrate's, not the declaration's, so its absence is a broken record
   172	    rather than an ordering declaration that does not fit the data. Only the
   173	    latter is what ``OrderingError`` means. A record missing ``K`` never
   174	    reaches the id accessor at all.
   175	
   176	    ``Arrival()`` returns the records as given — the store's native order is
   177	    the store's job to yield, never synthesized here. Both accessors are
   178	    ignored for ``Arrival()``.
   179	
   180	    Args:
   181	        records: The records to order.
   182	        ordering: ``Arrival()`` or ``ByKey(field)``.
   183	        get_field: Reads a named field off a record. The default reads a
   184	            Mapping key or an attribute, missing → None. Row-tuple callers
   185	            pass their own.
   186	        get_id: Reads the record id. The default reads the ``id`` Mapping key
   187	            or attribute.
   188	
   189	    Returns:
   190	        A new list, ordered. For ``ByKey``, records missing the key are absent.
   191	
   192	    Raises:
   193	        OrderingError: Mixed key types under the declared key, sort-key
   194	            elements — key value or tie-break id — that do not compare, or an
   195	            unknown Ordering variant.
   196	    """
   197	    match ordering:
   198	        case Arrival():
   199	            return list(records)
   200	        case ByKey(field=field):
   201	            keyed: list[tuple[Any, Any, R]] = []
   202	            key_type: type | None = None
   203	            for record in records:
   204	                value = get_field(record, field)
   205	                if value is None:
   206	                    continue
   207	                if key_type is None:
   208	                    key_type = type(value)
   209	                elif type(value) is not key_type:
   210	                    raise OrderingError(
   211	                        f"mixed key types under declared key {field!r}: "
   212	                        f"{key_type.__name__} and {type(value).__name__} "
   213	                        f"(offending value {value!r})"
   214	                    )
   215	                keyed.append((value, get_id(record), record))
   216	            try:
   217	                keyed.sort(key=lambda entry: (entry[0], entry[1]))
   218	            except TypeError as exc:
   219	                raise OrderingError(
   220	                    f"records under declared key {field!r} do not compare: {exc} "
   221	                    f"(the sort key is (K, id) — either element can be the "
   222	                    f"non-comparable one)"
   223	                ) from exc
   224	            return [entry[2] for entry in keyed]
   225	        case _:
   226	            raise OrderingError(f"unknown Ordering variant: {ordering!r}")
