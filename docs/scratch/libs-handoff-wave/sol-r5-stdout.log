  1327	def _resolve_combine_child(parent_vertex: Path, alias: str) -> Path | None:
  1328	    """Resolve a combine child by alias.
  1329	
  1330	    Given a combine vertex and an alias string, find the child entry
  1331	    with a matching alias and return its resolved vertex path.
  1332	    Returns None if the parent isn't a combine vertex or no alias matches.
  1333	    """
  1334	    from lang.population import resolve_vertex
  1335	
  1336	    try:
  1337	        ast = _parse_vertex(parent_vertex)
  1338	    except LoopsError:
  1339	        return None
  1340	
  1341	    if ast.combine is None:
  1342	        return None
  1343	
  1344	    for entry in ast.combine:
  1345	        if entry.alias == alias:
  1346	            ref = resolve_vertex(entry.name, loops_home())
  1347	            if not ref.is_absolute():
  1348	                ref = (parent_vertex.parent / ref).resolve()
  1349	            if ref.exists():
  1350	                return ref.resolve()
  1351	    return None
