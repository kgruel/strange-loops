     1	"""Compact a store — VACUUM + PRAGMA optimize.
     2	
     3	Reclaims space from deleted rows and WAL fragments,
     4	then runs SQLite's optimize pragma for index statistics.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	from dataclasses import dataclass
    10	from pathlib import Path
    11	
    12	from ._conn import _open
    13	
    14	
    15	@dataclass(frozen=True)
    16	class CompactResult:
    17	    """Size change from a compact operation."""
    18	
    19	    before_bytes: int
    20	    after_bytes: int
    21	    saved_bytes: int
    22	
    23	
    24	def compact_store(path: Path) -> CompactResult:
    25	    """VACUUM + PRAGMA optimize a store database.
    26	
    27	    Args:
    28	        path: Path to the store database.
    29	
    30	    Returns:
    31	        CompactResult with size before, after, and bytes saved.
    32	
    33	    Raises:
    34	        FileNotFoundError: If the database does not exist.
    35	    """
    36	    path = Path(path)
    37	
    38	    if not path.exists():
    39	        raise FileNotFoundError(f"Store not found: {path}")
    40	
    41	    before_bytes = _total_size(path)
    42	
    43	    conn = _open(path)
    44	    try:
    45	        conn.execute("VACUUM")
    46	        conn.execute("PRAGMA optimize")
    47	    finally:
    48	        conn.close()
    49	
    50	    after_bytes = _total_size(path)
    51	
    52	    return CompactResult(
    53	        before_bytes=before_bytes,
    54	        after_bytes=after_bytes,
    55	        saved_bytes=before_bytes - after_bytes,
    56	    )
    57	
    58	
    59	def _total_size(path: Path) -> int:
    60	    """Sum the size of the DB file plus any WAL/SHM sidecars."""
    61	    total = path.stat().st_size
    62	    for suffix in ("-wal", "-shm"):
    63	        sidecar = path.parent / (path.name + suffix)
    64	        if sidecar.exists():
    65	            total += sidecar.stat().st_size
    66	    return total
     1	"""Receive a store — create-or-merge with SQLite validation.
     2	
     3	The "other end" of push: validates the source is a SQLite database,
     4	then either copies it as a new store or merges into an existing one.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	import shutil
    10	from dataclasses import dataclass
    11	from pathlib import Path
    12	from typing import Literal
    13	
    14	from .merge import merge_store
    15	
    16	# First 16 bytes of every SQLite database file.
    17	_SQLITE_MAGIC = b"SQLite format 3\x00"
    18	
    19	
    20	@dataclass(frozen=True)
    21	class ReceiveResult:
    22	    """Outcome of a receive operation."""
    23	
    24	    status: Literal["created", "merged"]
    25	    facts: int
    26	    ticks: int
    27	
    28	
    29	def receive_store(target: Path, source: Path) -> ReceiveResult:
    30	    """Create-or-merge: receive a source store into a target location.
    31	
    32	    If the target doesn't exist, the source is copied as-is.
    33	    If the target exists, the source is merged into it (id-PK dedup).
    34	
    35	    Validates source has SQLite magic bytes before operating.
    36	
    37	    Args:
    38	        target: Path where the store should end up.
    39	        source: Path to the incoming store (e.g. a temp file from transport).
    40	
    41	    Returns:
    42	        ReceiveResult with status ("created" or "merged") and counts.
    43	
    44	    Raises:
    45	        FileNotFoundError: If source does not exist.
    46	        ValueError: If source is not a valid SQLite database.
    47	    """
    48	    source = Path(source)
    49	    target = Path(target)
    50	
    51	    if not source.exists():
    52	        raise FileNotFoundError(f"Source store not found: {source}")
    53	
    54	    _validate_sqlite(source)
    55	
    56	    if target.exists():
    57	        result = merge_store(target, source)
    58	        return ReceiveResult(
    59	            status="merged",
    60	            facts=result.facts_added,
    61	            ticks=result.ticks_added,
    62	        )
    63	    else:
    64	        target.parent.mkdir(parents=True, exist_ok=True)
    65	        shutil.copy2(str(source), str(target))
    66	
    67	        # Count what was created
    68	        from ._conn import _open
    69	
    70	        conn = _open(target, read_only=True)
    71	        try:
    72	            facts = conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0]
    73	            ticks = conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0]
    74	        finally:
    75	            conn.close()
    76	
    77	        return ReceiveResult(status="created", facts=facts, ticks=ticks)
    78	
    79	
    80	def _validate_sqlite(path: Path) -> None:
    81	    """Check that a file starts with the SQLite magic bytes."""
    82	    with open(path, "rb") as f:
    83	        header = f.read(16)
    84	    if header != _SQLITE_MAGIC:
    85	        raise ValueError(f"Not a valid SQLite database: {path}")
