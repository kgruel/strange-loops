   772	    def current_chain_head(self) -> str | None:
   773	        """The row-identity hash of the latest *chained* tick, or None.
   774	
   775	        What a successor tick's ``prev_hash`` commits to (era-aware
   776	        ``_tick_row_hash``) — the "chain head" a genesis pins. None when the
   777	        store has no chained tick (a pre-chain-only or empty store pins on
   778	        the fact cursor instead). Read-only; never migrates schema.
   779	        """
   780	        cols = {r[1] for r in self._conn.execute("PRAGMA table_info(ticks)")}
   781	        if "window_hash" not in cols:
   782	            return None
   783	        row_sql = _TICK_ROW_SQL if "signature" in cols else _TICK_ROW_SQL_V1
