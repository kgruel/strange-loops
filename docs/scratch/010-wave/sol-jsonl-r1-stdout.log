   150	                for fkind, info in data["facts"]["kinds"].items():
   151	                    recent = reader.recent_facts(fkind, 1)
   152	                    if recent:
   153	                        info["sample_payload"] = recent[0]["payload"]
   154	            if zoom >= 2:
   155	                for name, info in data["ticks"]["names"].items():
   156	                    recent = reader.recent_ticks(name, 3)
   157	                    if recent:
