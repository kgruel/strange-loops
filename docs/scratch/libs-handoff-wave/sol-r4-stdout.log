   628	            # Genuinely split every existing top-level child onto its own
   629	            # line — leaving siblings sharing one physical line would make
   630	            # a later line-based edit/remove of one silently take the rest.
   631	            new_lines.extend(
   632	                child_indent + node
   633	                for node in kdl_split_top_level_nodes(inner)
   634	            )
