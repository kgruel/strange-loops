   495	def _check_last_line(conn, canonical: Path, size: int, offset: int | None) -> Check:
   496	    """Judge the last line the index CONSUMED — not the last line on disk.
   497	
   498	    The bound is the stamped offset, because that is the only prefix of the
   499	    log the index ever claimed to account for. Judging the file's final line
   500	    instead accuses the index of an out-of-band edit every time the writer
   501	    crashes between the log's fsync and the index commit, or leaves a torn
   502	    tail — the two states the writer itself documents as normal, where the
   503	    unindexed bytes have no index row to match by construction. The offset
   504	    check already reports the shortfall once; reporting it again as tampering is a
   505	    false accusation inside the feature that exists to attest honestly.
   506	    """
   507	    bound = size if offset is None else min(offset, size)
   508	    scope = "final" if bound == size else "last consumed"
   509	    if bound == 0:
   510	        return Check(
   511	            "last-line", True,
   512	            "empty log" if size == 0 else "index has consumed no lines yet",
   513	        )
   514	    line = _last_line(canonical, bound)
   515	    if line is None:
   516	        return Check(
   517	            "last-line", False,
   518	            f"the log's {scope} line is incomplete or unreadable",
   519	        )
   520	    try:
   521	        records = deserialize_records(line)
   522	    except (JsonlCodecError, UnicodeError) as exc:
   523	        return Check(
   524	            "last-line", False, f"{scope} log line does not decode: {exc}"
   525	        )
   526	    # A batch line expands to N rows; EVERY one must match its index row, so
   527	    # an index-side edit to any row of the last ceremony is detected. Cost is
   528	    # bounded by ceremony size, not log size.
   529	    for t, row in records:
   530	        if not row_matches(conn, t, row):
   531	            return Check(
   532	                "last-line", False,
   533	                f"{scope} log {t} {row[0]} does not match the index row of "
   534	                "the same id — the index was edited out of band",
   535	            )
   536	    t, row = records[0]
   537	    label = (
   538	        f"{scope} log batch of {len(records)} fact(s)"
   539	        if len(records) > 1
   540	        else f"{scope} log {t} {row[0]}"
   541	    )
   542	    return Check("last-line", True, f"{label} matches the index")
