   154	            if isinstance(value, bool) or not isinstance(value, (int, float)):
   155	                return (
   156	                    f"{t} field {field!r} must be a number, got "
   157	                    f"{type(value).__name__}"
   158	                )
   159	            if isinstance(value, float):
   160	                if not math.isfinite(value):
   161	                    return (
   162	                        f"{t} field {field!r} must be a finite number, got "
   163	                        f"{value!r}"
   164	                    )
   165	            elif not (_JCS_INT_MIN <= value <= _JCS_INT_MAX):
   166	                return (
   167	                    f"{t} field {field!r} is outside the JCS safe-integer "
   168	                    f"domain: {value}"
   169	                )
   170	        elif not isinstance(value, str):
   171	            return (
   172	                f"{t} field {field!r} must be a string, got "
   173	                f"{type(value).__name__}"
   174	            )
   175	    if SIGNATURE_FIELD in obj and obj[SIGNATURE_FIELD] is None:
   176	        return f"{t} field 'signature' must be absent, not null, when unsigned"
   177	    sig = obj.get(SIGNATURE_FIELD)
   178	    if sig is not None and not isinstance(sig, str):
   179	        return f"{t} field 'signature' must be a string, got {type(sig).__name__}"
   180	    return None
   181	
   182	
   183	def _validate(obj: dict, spec: _Spec) -> None:
   184	    fault = row_object_fault(
   185	        obj,
   186	        t=spec.t,
   187	        frame="line",
   188	        fields=spec.fields,
   189	        allowed=spec.allowed,
   190	        nullable=spec.nullable,
   191	    )
   192	    if fault is not None:
   193	        raise JsonlCodecError(fault)
