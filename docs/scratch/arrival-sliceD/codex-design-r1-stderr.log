esses or\n    sub-millisecond clocks, monotonic sorting is not guaranteed (use `ts`\n    or `rowid` for sequence).\n    \"\"\"\n    from ulid import ULID\n\n    return str(ULID())"},{"file":"libs/engine/src/engine/sqlite_store.py","lines":"565","note":"fact_id generation via id_override or gen_id() in SqliteStore.append_attested","quote":"        fact_id = id_override if id_override is not None else gen_id()"},{"file":"libs/engine/src/engine/sqlite_store.py","lines":"1649","note":"tick_id generation via gen_id() in SqliteStore.append_tick_attested","quote":"        row = (gen_id(), d[\"name\"], d[\"ts\"], d[\"since\"], d[\"origin\"],"},{"file":"libs/engine/src/engine/arrival.py","lines":"662-683","note":"ResumeMark dataclass defining arrival coordinate triple","quote":"@dataclass(frozen=True)\nclass ResumeMark:\n    \"\"\"The position in an arrival log a consumer has processed through.\n\n    Opaque token for consumers (stores, projections, replication streams)\n    to persist alongside their derived state. A mark carries three\n    fields that together make resumption deterministic:\n\n    - arrival_lineage: the lineage id from the log's genesis record\n    - arrival_offset: byte offset into the file *immediately following*\n      the newline of the consumed record (0 when no records consumed)\n    - arrival_ordinal: the ordinal of the last consumed record (-1 when\n      no records consumed)\n    \"\"\"\n\n    arrival_lineage: str\n    arrival_offset: int\n    arrival_ordinal: int"},{"file":"libs/engine/src/engine/arrival_store.py","lines":"101-103","note":"store_meta table keys for arrival lineage, offset, ordinal","quote":"ARRIVAL_LINEAGE_KEY = \"arrival_lineage\"\nARRIVAL_OFFSET_KEY = \"arrival_offset\"\nARRIVAL_ORDINAL_KEY = \"arrival_ordinal\""},{"file":"libs/engine/src/engine/store_reader.py","lines":"148-154","note":"StoreReader.key_prefixes method signature taking kind, key_field, and prefix","quote":"    def key_prefixes(\n        self,\n        kind: str