   435	def _ordered_probes(store_path: Path, depth: int) -> list[Sample]:
   436	    """`StoreReader.ordered` under each declared Ordering, against `depth` facts.
   437	
   438	    Three arms, one fixture. `Arrival()` is the no-sort baseline (rowid scan);
   439	    `ByKey('ts')` orders on the envelope column (no JSON parse); `ByKey('index')`
   440	    orders on a payload key every fixture fact carries — the delta against the
   441	    'ts' arm at the same depth IS the payload-parse cost, and that intra-arm
   442	    comparison is legitimate where cross-sitting ones are not.
   443	
   444	    Every arm asserts the returned count: missing-K is non-membership, so a
   445	    fixture that dropped the key would measure a very fast nothing.
   446	    """
   447	    from atoms import Arrival, ByKey
   448	
   449	    reader = StoreReader(store_path)
   450	    return [
   451	        measure(
   452	            "arrival_ordered_arrival",
   453	            "arrival",
   454	            depth,
   455	            lambda: _assert_len(reader.ordered(depth, Arrival()), depth),
   456	        ),
   457	        measure(
   458	            "arrival_ordered_bykey_ts",
   459	            "arrival",
   460	            depth,
   461	            lambda: _assert_len(reader.ordered(depth, ByKey("ts")), depth),
   462	        ),
   463	        measure(
   464	            "arrival_ordered_bykey_payload",
   465	            "arrival",
   466	            depth,
   467	            lambda: _assert_len(reader.ordered(depth, ByKey("index")), depth),
   468	        ),
   469	    ]
