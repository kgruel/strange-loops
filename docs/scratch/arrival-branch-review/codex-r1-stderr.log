   385	def _entries_for(source_rows: _SourceRows, held: set[str]):
   386	    """The records to append, after dedup. Returns ``(entries, facts, ticks)``.
   387	
   388	    A group whose rows are ALL already in the target contributes no record.
   389	    A batch group that is partly deduped contributes its remainder: two or
   390	    more surviving rows still ride as one batch (the ceremony's atomicity is
   391	    the reason the batch exists), a single survivor rides as a plain fact
   392	    line, because a one-row batch is a second spelling the codec refuses.
   393	    """
   394	    from engine.arrival import Entry
   395	
   396	    entries: list[Entry] = []
   397	    facts = ticks = 0
   398	    for kind, rows in source_rows.groups:
   399	        fresh = [(t, row) for t, row in rows if row[0] not in held]
   400	        if not fresh:
   401	            continue
   402	        for t, row in fresh:
   403	            held.add(row[0])
   404	            if t == "fact":
   405	                facts += 1
   406	            else:
   407	                ticks += 1
   408	        entries.append(_entry_for(kind, fresh))
   409	    return entries, facts, ticks
