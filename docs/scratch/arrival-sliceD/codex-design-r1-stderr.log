   550	def durable_handle(pos: WitnessPosition) -> str | None:
   551	    """The PORTABLE address form for a position, or ``None`` if not serializable.
   552	
   553	    A10-narrowed durable-handle contract (final-contracts Session 1):
   554	
   555	    - **Adopted** store → ``fact:<lineage>/<id>`` — the lineage-qualified handle.
   556	      Re-resolving it elsewhere verifies the lineage and re-resolves the id in
   557	      the target store (never reuses a rowid), so the same handle can never
   558	      silently mean a different prefix across stores.
   559	    - **Unadopted** store (no lineage), or the empty/genesis sentinel → ``None``:
   560	      **durable serialization is REFUSED** (N1). The position is session-local;
   561	      no surrogate id is invented. A caller rendering cursor metadata MUST NOT
   562	      present a bare ``fact:<id>`` as a reusable handle here — it is not portable
   563	      (the id resolves in ANY store that merged the fact, to a different prefix).
   564	    """
   565	    if pos.unadopted or pos.lineage is None or not pos.fact_id:
   566	        return None
   567	    return f"fact:{pos.lineage}/{pos.fact_id}"
   568	
