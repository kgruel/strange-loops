    74	def _walk(reader: StoreReader, order: str, page_size: int, **filters) -> list[dict]:
    75	    """Page through the whole store; assert cursor plumbing along the way."""
    76	    items: list[dict] = []
    77	    cursor = None
    78	    while True:
    79	        kw = dict(filters)
    80	        if cursor is not None:
    81	            kw["before" if order == "newest" else "after"] = cursor
    82	        page = reader.query_facts(limit=page_size, order=order, **kw)
    83	        assert isinstance(page, FactPage)
    84	        assert page.order == order
    85	        assert len(page.items) <= page_size
    86	        items.extend(page.items)
    87	        if not page.truncated:
    88	            assert page.next is None
    89	            return items
    90	        assert page.next is not None
    91	        # The cursor is the 0.8.0 WitnessPosition — addressed by fact id +
    92	        # rowid, and the id is the page's last item (never compared/ordered).
    93	        assert page.next.fact_id == page.items[-1]["id"]
    94	        cursor = page.next
