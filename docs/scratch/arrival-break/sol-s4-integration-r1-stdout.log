   215	# Test 2: Kill-mid-append restart byte-identity gate (§I.4)
   216	# ---------------------------------------------------------------------------
   217	
   218	
   219	def test_kill_mid_append_restart_byte_identical(tmp_path: Path) -> None:
   220	    """(2) Kill-mid-append restart: append N/2 drafts, abandon, re-run with
   221	
   222	    resume_target= -> final target BYTE-IDENTICAL to uninterrupted run (§I.4).
   223	    """
   224	    store_dir = tmp_path / "data"
   225	    store_dir.mkdir(parents=True, exist_ok=True)
   226	    cust = CustodianFixture(tmp_path, "alice")
   227	    bob_key = ed25519.load_or_generate(tmp_path / "keys" / "bob").public_b64
   228	    carol_key = ed25519.load_or_generate(tmp_path / "keys" / "carol").public_b64
   229	
   230	    source_path = build_synthetic_jsonl(store_dir / "legacy.jsonl")
   231	    v_path = _make_vertex_file(
   232	        tmp_path,
   233	        custodian_name=cust.name,
   234	        custodian_key=cust.public,
   235	        other_observers=[("bob", bob_key), ("carol", carol_key)],
   236	    )
   237	
   238	    t_res = transform(source_path, parse_vertex_file(v_path), signer=cust.signer)
   239	    lineage = mint_lineage()
   240	    interrupted_target = store_dir / f"{lineage}.arrival"
   241	
   242	    registry = BackendRegistry.with_builtin_backends()
   243	    desc = StoreDescriptor(backend="file", location=str(interrupted_target), lineage=lineage)
   244	    ledger, _ = registry.open(desc)
   245	    genesis_head = ledger.mint(
   246	        {
   247	            "observer": t_res.genesis.custodian,
   248	            "signer": cust.signer,
   249	            "key": t_res.genesis.key,
   250	            "lineage": lineage,
   251	            "at": 0.0,
   252	        }
   253	    )
   254	
   255	    # Append half the drafts
   256	    half = len(t_res.drafts) // 2
   257	    records = []
   258	    prev_rh = genesis_head.record_hash
   259	    for i, d in enumerate(t_res.drafts[:half]):
   260	        rec = build_record(
   261	            lin=lineage,
   262	            ordinal=genesis_head.ordinal + 1 + i,
   263	            prev=prev_rh,
   264	            k=d.kind,
   265	            body=dict(d.body),
   266	            observer=d.observer,
   267	            origin=d.origin,
   268	            at=d.authored_at,
   269	            sig=d.signature,
   270	        )
   271	        records.append(rec)
   272	        prev_rh = rec["rh"]
   273	    ledger.replicate(expected=genesis_head, records=records)
   274	
   275	    # Now resume with run_migration(..., resume_target=interrupted_target)
   276	    outcome_resumed = run_migration(
   277	        source_path=source_path,
   278	        vertex_path=v_path,
   279	        store_dir=store_dir,
   280	        signer=cust.signer,
   281	        resume_target=interrupted_target,
   282	    )
   283	
   284	    # Generate reference uninterrupted file with identical lineage and drafts
   285	    ref_path = tmp_path / "reference.arrival"
   286	    ref_log = ArrivalLog.mint(
   287	        ref_path,
   288	        lineage=lineage,
   289	        observer=cust.name,
   290	        key=cust.public,
   291	        signer=cust.signer,
   292	        at=0.0,
   293	    )
   294	    gen_head = Head(lineage=lineage, ordinal=0, record_hash=ref_log.genesis()["rh"])
   295	    ref_records = []
   296	    prev_rh = gen_head.record_hash
   297	    for i, d in enumerate(t_res.drafts):
   298	        rec = build_record(
   299	            lin=lineage,
   300	            ordinal=gen_head.ordinal + 1 + i,
   301	            prev=prev_rh,
   302	            k=d.kind,
   303	            body=dict(d.body),
   304	            observer=d.observer,
   305	            origin=d.origin,
   306	            at=d.authored_at,
   307	            sig=d.signature,
   308	        )
   309	        ref_records.append(rec)
   310	        prev_rh = rec["rh"]
   311	    ref_log.append_records(ref_records, following=gen_head)
   312	
   313	    assert outcome_resumed.target_path.read_bytes() == ref_path.read_bytes(), (
   314	        "Final target MUST be byte-identical to uninterrupted run"
   315	    )
