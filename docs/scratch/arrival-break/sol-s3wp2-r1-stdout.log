[tool.hatch.build.targets.wheel]
packages = [
    "libs/atoms/src/atoms",
    "libs/custody/src/custody",
    "libs/engine/src/engine",
    "libs/lang/src/lang",
    "libs/sdk/src/sdk",
    "libs/sign/src/sign",
    "libs/store/src/store",
    "apps/loops/src/loops",
]

# The root runs the tests that belong to no single package — the architecture
# ratchets and tests/chaos — so it needs the same dev tooling every member
# already declares. Without this, `uv run pytest` at the root resolves only the
# flat wheel's runtime deps and dies with "Failed to spawn: pytest" on any
# machine whose .venv was not already dirty from an earlier run. uv.lock is
# gitignored, so CI resolves fresh every time and hit exactly that.
[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=6.0",
    "ruff>=0.8",
]

[tool.uv.workspace]
members = [
    "libs/atoms",
    "libs/custody",
    "libs/engine",
    "libs/lang",
    "libs/sdk",
    "libs/sign",
    "libs/store",
    "apps/loops",
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  check-architecture:
    name: Architecture Ratchets (Rule 16)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Run Architecture Ratchets
        run: ./dev check

  chaos-recovery:
    name: Chaos & Fault Injection
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Run Chaos Tests
        run: ./dev chaos

  lint:
    name: Lint (libs/custody, libs/sign)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Run Ruff Check
        run: uv run ruff check libs/custody libs/sign

  discover:
    name: Discover Packages
    runs-on: ubuntu-latest
    outputs:
      packages: ${{ steps.discover.outputs.packages }}
    steps:
      - uses: actions/checkout@v4
      # libs only, deliberately. apps/* is out of scope for CI: apps/loops is
      # slated for replacement, and the focus is the core libraries it will be
      # rebuilt on. Discovery is still a glob rather than a list, so a new
      # library reaches CI without editing this file — the point was never to
      # enumerate, it was to stop enumerating.
      - name: Discover libraries with tests
        id: discover
        run: |
          pkgs=$(python3 -c 'import json, sys; print(json.dumps(sys.argv[1:]))' $(for dir in libs/*/; do [ -d "${dir}tests" ] && basename "$dir"; done))
          echo "packages=$pkgs" >> "$GITHUB_OUTPUT"

  test-packages:
    name: Test (${{ matrix.package }})
    needs: discover
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        package: ${{ fromJson(needs.discover.outputs.packages) }}
    steps:
      - uses: actions/checkout@v4

      - name: Install uv
        uses: astral-sh/setup-uv@v4
        with:
          version: "latest"

[project]
name = "engine"
version = "0.1.0"
description = "Temporal infrastructure and identity — Tick, Vertex, Peer, Grant"
readme = "README.md"
authors = [{ name = "Kyle Gruel", email = "kylegruel@gmail.com" }]
requires-python = ">=3.11"
dependencies = [
    "atoms",
    "lang",
    "python-ulid>=3.0",
    "rfc8785>=0.1.4",
]

[tool.uv.sources]
atoms = { workspace = true }
lang = { workspace = true }
sign = { workspace = true }

[dependency-groups]
dev = [
    "hypothesis>=6.100",
    "mutmut>=3.2",
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
    "pytest-cov>=6.0",
    "ruff>=0.8",
    # Test-only: real Ed25519 material for the injected-signer seam
    # (conftest Custodian). Runtime engine never imports sign — custody
    # is the composition layer; this group keeps the injection boundary.
    "sign",
    "ty>=0.0.1a11",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/engine"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]

[tool.coverage.run]
source = ["src/engine"]
branch = true

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "\\.\\.\\.$",  # Protocol method stubs
]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "PTH"]

[tool.ty.environment]
python-version = "3.11"

[tool.mutmut]
paths_to_mutate = ["src/engine/witness.py"]
tests_dir = [
    "tests/test_witness_position.py",
    "tests/test_witness_address_helpers.py",
    "tests/test_diff_interval_report.py",
    "tests/test_fold_at.py",
]
also_copy = ["src"]
tests/chaos/test_sdk_faults.py
tests/chaos/test_storage_faults.py
