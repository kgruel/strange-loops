    54	def _open_store(path: Path, serialize, deserialize):
    55	    """Open the right store class for a canonical locator.
    56	
    57	    Never ``SqliteStore(path=...)`` directly: a ``.db`` looks identical
    58	    whether it is canonical or a derived index, so constructing one by hand
    59	    would write sqlite bytes straight into a declared canonical log the day
    60	    a declaration flips to ``.jsonl`` — an out-of-band insert the log never
    61	    accounts for. ``open_canonical_store`` is the one place that answers the
    62	    question, and it returns a plain ``SqliteStore`` for a ``.db`` locator,
    63	    which is every declaration this app has today.
    64	    """
    65	    from engine.jsonl_store import open_canonical_store
    66	
    67	    path.parent.mkdir(parents=True, exist_ok=True)
    68	    return open_canonical_store(path, serialize=serialize, deserialize=deserialize)
