   209	def _tick_row_hash(row: tuple) -> str:
   210	    """Era-aware identity hash — what the successor's prev_hash commits to.
   211	
   212	    Includes the signature key only when the row carries one, so every
   213	    pre-signature row (and every pre-chain row) hashes byte-identically to
   214	    delta 1 — no re-anchoring. For signed rows the successor chains over
   215	    content+signature, making signature-stripping a detectable break
   216	    (design/tick-signature-in-chain-envelope).
   217	    """
   218	    envelope = _tick_envelope(row)
   219	    if len(row) > 10 and row[10] is not None:
   220	        envelope["signature"] = row[10]
   221	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
   222	
   223	
   224	# Public name: the row-identity hash is a cross-lib contract. libs/store's
   225	# rebirth receipt records the source chain head with THE chain's hash
   226	# function — a reimplementation could silently diverge from what verify
   227	# walks. Same function, two names: _tick_row_hash stays the internal
   228	# spelling, tick_row_hash is the exported contract.
   229	def tick_row_hash(row: tuple) -> str:
   230	    """Era-aware tick row-identity hash (see _tick_row_hash)."""
   231	    return _tick_row_hash(row)
   232	
   233	
   234	def _fact_row_hash(row: tuple) -> str:
   235	    """Era-aware hash of one persisted fact row.
   236	
   237	    Row shape: (id, kind, ts, observer, origin, payload[, signature]).
   238	    The signature key is included only when the row carries one, so every
   239	    pre-signature fact row hashes byte-identically to delta 1/2 — already-
   240	    sealed window hashes never re-anchor. For signed facts the window
   241	    commits over content+signature, making fact-signature-stripping a
   242	    detectable break in any sealed window (delta-2 envelope trick, one
   243	    layer down — design/fact-signing-per-observer-keys).
   244	    """
   245	    envelope = {
   246	        "id": row[0], "kind": row[1], "ts": row[2],
   247	        "observer": row[3], "origin": row[4], "payload": row[5],
   248	    }
   249	    if len(row) > 6 and row[6] is not None:
   250	        envelope["signature"] = row[6]
   251	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
