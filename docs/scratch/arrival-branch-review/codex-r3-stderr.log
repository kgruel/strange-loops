   233	def arrival_path_for(base: Path | str) -> Path:
   234	    """The arrival log for a store base path: ``<name>.arrival``.
   235	
   236	    Suffix appended to the full name, never ``with_suffix`` — the residence
   237	    and ceremony sidecar helpers do the same, so ``alcove.db`` and ``alcove``
   238	    do not collapse onto one arrival path.
   239	    """
   240	    base = Path(base)
   241	    return base.parent / (base.name + ARRIVAL_SUFFIX)
   242	
   243	
   244	def lock_path_for(arrival_path: Path | str) -> Path:
   245	    """The append-exclusion lock beside a log: ``<name>.arrival.lock``.
   246	
   247	    Distinct from the index quarantine lock in ``jsonl_store``: different
   248	    resource, different holder, and the two must not be confused.
   249	    """
   250	    arrival_path = Path(arrival_path)
   251	    return arrival_path.parent / (arrival_path.name + LOCK_SUFFIX)
   252	
   253	
   254	def tmp_path_for(arrival_path: Path | str) -> Path:
   255	    """The genesis staging path: ``<name>.arrival.tmp``.
   256	
   257	    Genesis only. It is the mutex for minting — the process that wins
   258	    ``O_EXCL`` on this path is the one allowed to publish — so it is a fixed
   259	    name rather than a per-process temp file.
   260	    """
   261	    arrival_path = Path(arrival_path)
   262	    return arrival_path.parent / (arrival_path.name + TMP_SUFFIX)
