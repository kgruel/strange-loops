   453	def _check_inventory_equality(
   454	    source_inv: SourceInventory,
   455	    target_records: list[dict[str, Any]],
   456	    exceptions: TransformExceptions,
   457	) -> None:
   458	    """Assert inventory equality per §I.3 between source inventory and target projection.
   459	
   460	    Compares per-kind row counts, tick count, and observer census (accounting for
   461	    dropped units). Record counts are deliberately NOT compared (§I.3).
   462	
   463	    Partial-batch drops are refused upstream by the transformer, so its dropped-units
   464	    accounting covers whole-unit drops only.
   465	
   466	    Raises:
   467	        PublishPreconditionRefused: If any inventory metric diverges.
   468	    """
   469	    target_per_kind: dict[str, int] = defaultdict(int)
   470	    target_observer_census: dict[str, int] = defaultdict(int)
   471	    target_tick_count = 0
   472	
   473	    for rec in target_records:
   474	        k = rec.get("k")
   475	        if k in {GENESIS_KIND, KEY_INTRODUCTION_KIND}:
   476	            continue
   477	        if k not in {FACT_KIND, BATCH_KIND, TICK_KIND}:
   478	            continue
   479	
   480	        expanded = rows_of_body(k, rec["body"])
   481	        for row_k, row_tuple in expanded:
   482	            if row_k == FACT_KIND:
   483	                fact_id, kind, ts, observer, origin, payload, sig = row_tuple
   484	                target_per_kind[kind] += 1
   485	                target_observer_census[observer] += 1
   486	            elif row_k == TICK_KIND:
   487	                target_tick_count += 1
   488	
   489	    expected_per_kind = dict(source_inv.per_kind_counts)
   490	    expected_observer_census = dict(source_inv.observer_census)
   491	    expected_tick_count = source_inv.tick_count
   492	
   493	    # Account for dropped units (F7(d))
   494	    for du in exceptions.dropped_units:
   495	        for fk in du.fact_kinds:
   496	            if fk in expected_per_kind:
   497	                expected_per_kind[fk] -= 1
   498	                if expected_per_kind[fk] == 0:
   499	                    del expected_per_kind[fk]
   500	        for obs in du.observers:
   501	            if obs in expected_observer_census:
   502	                expected_observer_census[obs] -= 1
   503	                if expected_observer_census[obs] == 0:
   504	                    del expected_observer_census[obs]
   505	
   506	    mismatches: list[str] = []
   507	    if dict(target_per_kind) != expected_per_kind:
   508	        mismatches.append(
   509	            f"per-kind counts mismatch: source/expected={expected_per_kind} != target={dict(target_per_kind)}"
   510	        )
   511	    if dict(target_observer_census) != expected_observer_census:
   512	        mismatches.append(
   513	            f"observer census mismatch: source/expected={expected_observer_census} != target={dict(target_observer_census)}"
   514	        )
   515	    if target_tick_count != expected_tick_count:
   516	        mismatches.append(
   517	            f"tick count mismatch: source/expected={expected_tick_count} != target={target_tick_count}"
   518	        )
   519	
   520	    if mismatches:
   521	        raise PublishPreconditionRefused(
   522	            f"Inventory equality check failed: {'; '.join(mismatches)}. "
   523	            "Advisory: source and target contents diverge in census projection.",
   524	            condition="inventory_equality",
   525	        )
   526	
