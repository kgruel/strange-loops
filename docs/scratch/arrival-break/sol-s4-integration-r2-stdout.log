+forbidden_imports = {
+    "engine.jsonl_codec", "engine.jsonl_store", "store.rebirth", "store._conn",
+    "ckdl", "custody", "sign",
+}
+forbidden_calls = {"replicate", "bootstrap", "truncate_torn_tail"}
+bad_imports: list[str] = []
+bad_calls: list[str] = []
+arrival_log_imports: list[str] = []
+for path in sorted(source_root.glob("*.py")):
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    for node in ast.walk(tree):
+        modules: list[str] = []
+        if isinstance(node, ast.Import):
+            modules = [alias.name for alias in node.names]
+        elif isinstance(node, ast.ImportFrom):
+            modules = [node.module or ""]
+            if node.module == "engine.arrival" and any(alias.name == "ArrivalLog" for alias in node.names):
+                arrival_log_imports.append(f"{path.name}:{node.lineno}")
+        for module in modules:
+            if any(module == item or module.startswith(item + ".") for item in forbidden_imports):
+                bad_imports.append(f"{path.name}:{node.lineno}:{module}")
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in forbidden_calls:
+            bad_calls.append(f"{path.name}:{node.lineno}:{node.func.attr}")
+
+custodian_params = {
+    fn.__name__: [name for name in inspect.signature(fn).parameters if "custodian" in name]
+    for fn in (run_migration, transform)
+}
+print(f"forbidden_runtime_imports={bad_imports!r}")
+print(f"direct_ArrivalLog_imports={arrival_log_imports!r}")
+print(f"privileged_or_repair_calls={bad_calls!r}")
+print(f"custodian_parameters={custodian_params!r}")
+assert not bad_imports and not arrival_log_imports and not bad_calls
+assert custodian_params == {"run_migration": [], "transform": []}
+print("PASS: quarantine, admission-only structure, and signature pin hold")

