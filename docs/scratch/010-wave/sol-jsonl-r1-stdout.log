   274	    obj = json.loads(serialize_tick_row(TICK_SIGNED))
   275	    parts = [
   276	        f'"{k}":' + (number if k == field else json.dumps(v))
   277	        for k, v in obj.items()
   278	    ]
   279	    line = "{" + ",".join(parts) + "}"
   280	    with pytest.raises(JsonlCodecError):
   281	        deserialize_tick_row(line)
