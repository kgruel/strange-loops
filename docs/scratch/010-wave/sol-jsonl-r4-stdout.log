   173	def filter_task_facts(facts: list[dict], name: str) -> list[dict]:
   174	    """Filter facts belonging to a specific task.
   175	
   176	    Matches payload["name"] == name (task.* facts) or
   177	    payload["task"] == name (worker.* facts).
   178	    """
   179	    result = []
   180	    for f in facts:
   181	        payload = f.get("payload", {})
   182	        if payload.get("name") == name or payload.get("task") == name:
   183	            result.append(f)
   184	    return result
