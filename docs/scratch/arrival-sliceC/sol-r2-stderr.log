    63	def _resolve_combine_stores(ast: Any, vertex_path: Path) -> list[Path]:
    64	    """Resolve combine entries to a list of existing store paths.
    65	
    66	    For each CombineEntry, resolves the vertex name to a .vertex file,
    67	    parses it, and extracts its store path. Skips entries whose store
    68	    doesn't exist (graceful degradation).
    69	    """
    70	    from lang import parse_vertex_file, resolve_vertex
    71	
    72	    home = _loops_home()
    73	    store_paths: list[Path] = []
    74	
    75	    for entry in ast.combine:
    76	        vpath = resolve_vertex(entry.name, home)
    77	        if not vpath.is_absolute():
    78	            vpath = (vertex_path.parent / vpath).resolve()
    79	        if not vpath.exists():
    80	            continue
    81	
    82	        ref_ast = parse_vertex_file(vpath)
    83	        if ref_ast.store is None:
    84	            continue
    85	
    86	        sp = resolved_index(ref_ast.store, vpath)
    87	        if sp.exists():
    88	            store_paths.append(sp)
    89	
    90	    return store_paths
