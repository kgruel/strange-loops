   389	def _writable(path: Path) -> bool:
   390	    """Filesystem writability of ``path``, or of its nearest existing ancestor.
   391	
   392	    TOTAL over inaccessible paths (SOL-R3-03a): a path this process cannot
   393	    even stat (e.g. inside a non-searchable ``0222`` directory) is a
   394	    not-writable ANSWER, never an exception — the caller is asking a yes/no
   395	    question about a write surface.
   396	    """
   397	    probe = path
   398	    try:
   399	        while not probe.exists():
   400	            parent = probe.parent
   401	            if parent == probe:
   402	                return False
   403	            probe = parent
   404	        return os.access(probe, os.W_OK)
   405	    except OSError:
   406	        return False
