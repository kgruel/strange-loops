   364	def write_surface_reason(canonical_path: Path | str) -> str | None:
   365	    """Reason the canonical store's FULL write surface is unwritable, or None.
   366	
   367	    The surface a store-writing ceremony touches is wider than the canonical
   368	    artifact (SOL-R1-04 + SOL-R2-04): a JSONL-canonical open also writes the
   369	    derived sqlite index, and any sqlite open needs the containing directory
   370	    for its WAL/SHM siblings. Pure ``os.access`` inspection — ``_writable``
   371	    walks to the nearest existing ancestor, so a missing index counts as
   372	    creatable when its directory is writable. A location-scoped claim, never
   373	    an open-success promise. Idempotent on a ``.db`` (index == canonical).
   374	    """
   375	    canonical_path = Path(canonical_path)
   376	    if not _writable(canonical_path):
   377	        return f"canonical store not writable: {canonical_path}"
   378	    index = index_path_for(canonical_path)
   379	    if not _writable(index):
   380	        return f"derived index not writable: {index}"
   381	    if not _writable(canonical_path.parent):
   382	        return (
   383	            f"store directory not writable: {canonical_path.parent} — "
   384	            "sqlite needs it for WAL/SHM siblings"
   385	        )
   386	    return None
