   139	        conn.execute("ATTACH DATABASE ? AS src", (str(source),))
   140	
   141	        src_facts = conn.execute("SELECT COUNT(*) FROM src.facts").fetchone()[0]
   142	        src_ticks = conn.execute("SELECT COUNT(*) FROM src.ticks").fetchone()[0]
   143	
   144	        if dry_run:
   145	            conn.execute("SAVEPOINT merge_dry_run")
   146	
   147	        # The fact SIGNATURE travels (design/fact-signature-at-store-column):
   148	        # it is a per-observer authorship claim over content only — unlike
   149	        # the tick chain columns (store-local custody, stripped below).
   150	        # Carried verbatim, never re-signed. Era-aware: a source predating
   151	        # the column merges as NULL (honest pre-signature era).
   152	        src_cols = {r[1] for r in conn.execute("PRAGMA src.table_info(facts)")}
   153	        tgt_cols = {r[1] for r in conn.execute("PRAGMA table_info(facts)")}
   154	        if "signature" in src_cols and "signature" not in tgt_cols:
   155	            conn.execute("ALTER TABLE facts ADD COLUMN signature TEXT")
   156	            tgt_cols.add("signature")
   157	        if "signature" in tgt_cols:
   158	            sig_src = "signature" if "signature" in src_cols else "NULL"
   159	            ins_cols, sel_cols = (
   160	                "id, kind, ts, observer, origin, payload, signature",
   161	                f"id, kind, ts, observer, origin, payload, {sig_src}",
   162	            )
   163	        else:  # both pre-delta-3
   164	            ins_cols = sel_cols = "id, kind, ts, observer, origin, payload"
   165	        conn.execute(f"""
   166	            INSERT OR IGNORE INTO facts ({ins_cols})
   167	            SELECT {sel_cols}
   168	            FROM src.facts ORDER BY ts, id
   169	        """)
   170	        facts_added = conn.execute("SELECT changes()").fetchone()[0]
   171	
   172	        conn.execute("""
   173	            INSERT OR IGNORE INTO ticks (id, name, ts, since, origin, payload)
   174	            SELECT id, name, ts, since, origin, payload
   175	            FROM src.ticks ORDER BY ts, id
   176	        """)
   177	        ticks_added = conn.execute("SELECT changes()").fetchone()[0]
   178	
   179	        if dry_run:
   180	            conn.execute("ROLLBACK TO merge_dry_run")
   181	            conn.execute("RELEASE merge_dry_run")
   182	        else:
   183	            conn.commit()
   184	
   185	        conn.execute("DETACH DATABASE src")
   186	    finally:
   187	        conn.close()
