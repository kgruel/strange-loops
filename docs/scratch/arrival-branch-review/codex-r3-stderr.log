    40	def _build_exercised_store(tmp_path: Path) -> tuple[Path, _Custodian, _Custodian, int]:
    41	    """Movement 1 (mint), facts, a key introduction at a stated ordinal, a
    42	    declaration absorb (movement 2), a seal. Returns (log path, founder,
    43	    second custodian, the introduction's ordinal)."""
    44	    kyle = _Custodian(tmp_path, "kyle")
    45	    ana = _Custodian(tmp_path, "ana")
    46	
    47	    log = ArrivalLog.mint(
    48	        tmp_path / "s.arrival", observer="kyle", signer=kyle.signer, key=kyle.public
    49	    )
    50	
    51	    def signer(observer: str, digest: str) -> str | None:
    52	        by = {"kyle": kyle, "ana": ana}.get(observer)
    53	        return by.signer(observer, digest) if by else None
    54	
    55	    store: ArrivalStore = ArrivalStore(
    56	        path=tmp_path / "s.db",
    57	        serialize=lambda f: f.to_dict(),
    58	        deserialize=Fact.from_dict,
    59	        fact_signer=signer,
    60	    )
    61	    try:
    62	        store.append(Fact.of("note", "kyle", message="one"))  # ordinal 1
    63	        intro = log.append(
    64	            KEY_INTRODUCTION_KIND,
    65	            {"observer": "ana", "key": ana.public},
    66	            observer="kyle",
    67	            signer=kyle.signer,
    68	        )  # ordinal 2
    69	        store.append(Fact.of("note", "ana", message="two"))  # ordinal 3
    70	        docs = [d.as_json() for d in vertex_to_documents(parse_vertex(BASE))]
    71	        store.absorb_genesis(docs, observer="kyle", fact_signer=signer)  # ordinal 4
    72	        store.append_tick(  # the seal — ordinal 5
    73	            Tick(name="seal", ts=datetime.now(UTC), payload={"n": 2}, origin="x")
    74	        )
    75	    finally:
    76	        store.close()
    77	    return log.path, kyle, ana, intro["ord"]
    78	
