    94	# unambiguous ones. Named here so the gap reads as scoped, not missed.
    95	_NOT_MECHANIZED = ("event", "merge", "receipt")
    96	
    97	# camelCase and PascalCase boundaries. Both forms, so `JsonlOffset`,
    98	# `jsonlOffset` and `HTTPRewind` all split into the tokens they are made of —
    99	# case was the first evasion the reviewer found, and a scanner that only
   100	# matches the snake_case spelling is a scanner that bans one way of writing
   101	# the word.
   102	_CAMEL = re.compile(r"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])")
   103	_NAME_SEP = re.compile(r"[-_]+")
   104	_PROSE_SEP = re.compile(r"[^a-z0-9_]+")
   105	_NON_ALNUM = re.compile(r"[^a-z0-9]+")
   106	
   107	# Denied terms, separators removed, mapped back to their canonical spelling.
   108	# Comparing squashed lets `ReAnchor` (which camel-splits into `re` + `anchor`)
   109	# land on `reanchor`, without a substring test that would make `rewinding`
   110	# match `rewind`.
   111	_SQUASHED = {term.replace("_", ""): term for term in _DENIED}
   112	_MAX_TOKENS = 4  # longest denied term is 3 tokens; camel splitting can add one
   113	
   114	
   115	NAME = "name"
   116	PROSE = "prose"
   117	
   118	
   119	def _name_segments(text: str, mode: str) -> list[list[str]]:
   120	    """Split ``text`` into runs of tokens that a single NAME could span.
   121	
   122	    Two kinds of separator, and which is which depends on what the text IS.
   123	
   124	    In ``NAME`` mode the whole string is one name, so every separator joins:
   125	    `jsonl.offset`, `jsonl-offset`, `jsonl_offset` and `JsonlOffset` are the
   126	    same name written four ways. This is the mode for identifiers and for
   127	    strings that sit in identifier positions — a dict key, a subscript
   128	    index, an ``__all__`` entry, a string annotation.
   129	
   130	    In ``PROSE`` mode — docstrings — underscores, hyphens and camelCase still
   131	    join, but whitespace and punctuation end a segment, because they separate
   132	    names from each other rather than building one. That distinction is what
   133	    keeps a multi-word ban an IDENTIFIER ban. §4.2 bans these as
   134	    "identifiers, meta keys, field names, function names, or glossary terms";
   135	    matching `receipt_order` across a space would also condemn the sentence
   136	    "for a single-store vertex this is receipt order", which is `libs/sdk`'s
   137	    honest description of today's shipped behaviour and is Rule 17's
   138	    territory, not this rule's. Single-token bans still match in prose: one
   139	    word is unambiguous, a two-word phrase is not.
   140	    """
   141	    lowered = _CAMEL.sub("_", text).lower()
   142	    if mode == NAME:
   143	        return [[token for token in _NON_ALNUM.sub("_", lowered).split("_") if token]]
   144	    joined = _NAME_SEP.sub("_", lowered)
   145	    return [
   146	        [token for token in segment.split("_") if token]
   147	        for segment in _PROSE_SEP.sub(" ", joined).split()
   148	    ]
   149	
   150	
   151	def _denied_term(text: str, mode: str = NAME) -> str | None:
   152	    """The denied term ``text`` names, or None."""
   153	    for tokens in _name_segments(text, mode):
   154	        for start in range(len(tokens)):
   155	            for end in range(start + 1, min(start + _MAX_TOKENS, len(tokens)) + 1):
   156	                term = _SQUASHED.get("".join(tokens[start:end]))
   157	                if term is not None:
   158	                    return term
   159	    return None
   160	
   161	
   162	# ---------------------------------------------------------------------------
   163	# Allowlist — SHRINK ONLY.
   164	#
   165	# Entries are (path relative to repo root, a substring that must appear on the
   166	# offending line). Content markers, not line numbers: code moves, and a
   167	# line-numbered allowlist churns on every unrelated edit while silently
   168	# re-admitting a moved claim. Empty today, and an entry added here needs a
   169	# comment saying why the term is unavoidable at that site.
   170	# ---------------------------------------------------------------------------
   171	_ALLOWED: set[tuple[str, str]] = {
   172	    # The retired canonical-store boolean survives as an unexported shim for
   173	    # ONE caller: apps/loops/src/loops/commands/store.py:142 lazy-imports it
   174	    # before its mode check, and apps/ is diff-empty for the whole arrival
   175	    # wave, so the caller cannot move until the CLI-surface cut. The shim is
   176	    # not in residence.__all__, nothing else in libs names it, and
   177	    # tests/engine's tripwire pins the pairing — delete this entry together
   178	    # with the shim and the apps import.
   179	    ("libs/engine/src/engine/residence.py", "def is_jsonl_canonical"),
   180	    # The refusing override of the legacy history-mutating op must carry the
   181	    # legacy METHOD name or it overrides nothing — the name here IS the
   182	    # refusal surface. Falls away when the base method retires.
   183	    ("libs/engine/src/engine/arrival_store.py", "def reanchor"),
   184	    # The legacy mode's own exception family, raised where a merge into a
   185	    # `.jsonl`-canonical target is refused. The name IS that mode's honest
   186	    # name — the same reasoning that keeps its three meta keys unrenamed —
   187	    # and merge.py must NAME the class to raise it. Aliasing the import
   188	    # would silence this rule while changing nothing, which is precisely the
   189	    # evasion the probes below exist to catch. Falls away when `JsonlStore`
   190	    # retires and the refusal has nothing left to point at.
   191	    ("libs/store/src/store/merge.py", "raise jsonl_store.JsonlCanonicalUnsupported("),
   192	}
   193	
   194	
   195	def _files() -> list:
   196	    """Every shipped file the rule judges, derived from _SCAN_TARGETS.
   197	
   198	    A directory target expands to its `.py` files; a file target is itself.
   199	    Derived rather than hand-enumerated (docs/RATCHETS.md), so a module added
   200	    under `libs/sdk/src` after this was written is judged the moment it
   201	    exists.
   202	    """
   203	    files = []
   204	    for target in _SCAN_TARGETS:
   205	        path = REPO_ROOT / target
   206	        if path.is_dir():
   207	            files.extend(
   208	                p for p in sorted(path.rglob("*.py")) if "__pycache__" not in p.parts
   209	            )
   210	        elif path.is_file():
   211	            files.append(path)
   212	    return files
   213	
   214	
   215	def _strings_in(node: ast.AST | None) -> list[tuple[int, str]]:
   216	    """Every string constant inside a subtree, with its line.
   217	
   218	    Used for the two places a NAME can hide inside a string: a forward-ref
   219	    annotation (``def f(x: "JsonlOffset")``) and an ``__all__`` entry.
   220	    """
   221	    if node is None:
   222	        return []
   223	    return [
   224	        (child.lineno, child.value)
   225	        for child in ast.walk(node)
   226	        if isinstance(child, ast.Constant) and isinstance(child.value, str)
   227	    ]
   228	
   229	
   230	def _is_dunder_all(target: ast.expr) -> bool:
   231	    return isinstance(target, ast.Name) and target.id == "__all__"
   232	
   233	
   234	def _named(tree: ast.AST) -> list[tuple[int, str, str]]:
   235	    """Every (lineno, text, mode) this rule judges: things that NAME something.
   236	
   237	    In scope, all in ``NAME`` mode unless noted: identifiers (variables,
   238	    attributes, arguments, functions, classes, import aliases,
   239	    keyword-argument names); docstrings (``PROSE`` mode); and string
   240	    constants sitting in identifier positions —
   241	
   242	    * **dict keys and subscript indices**, because a key names a field just
   243	      as surely as an attribute does;
   244	    * **``__all__`` entries**, because an export list is naming, and it is
   245	      the most public naming a module does;
   246	    * **annotations**, including string forward references, because a
   247	      forward ref is an identifier the parser has not resolved yet.
   248	
   249	    Out of scope, and deliberately: comments, and string constants that are
   250	    not in one of those positions. That is the scoped claim — this rule
   251	    asserts the arrival surface does not NAME the retired vocabulary, not
   252	    that the words never appear. A comment saying "this replaces the old
   253	    offset meta key" is honest documentation of a boundary; an identifier
   254	    spelling it is the model coming back.
   255	
   256	    Also out of scope, named rather than discovered: ``__all__`` built by
   257	    call rather than by literal (``__all__.extend([...])``,
   258	    ``__all__ = list(...)``). Following those means evaluating the program,
   259	    which is the whole-program analysis a ratchet must not become. A repo
   260	    that starts building exports that way needs this list grown, and the
   260	    that starts building exports that way needs this list grown, and the
   261	    scan-target test is what will surface it.
   262	
   263	    Known-unscanned node types, listed so a future reader can see they were
   264	    considered rather than missed: dict-comprehension keys, ``except ... as``
   265	    names, and ``match`` capture patterns. Each could in principle carry a
   266	    denied name. None is widened for now because the shipped code does not
   267	    use those forms for retired vocabulary, and growing a detector without a
   268	    forcing case is the move this repo's practice warns against — the
   269	    detector would gain surface with nothing holding it honest. Any of them
   270	    becomes worth adding the day a real usage appears.
   271	    """
   272	    judged: list[tuple[int, str, str]] = []
   273	
   274	    def name(lineno: int, text: str) -> None:
   275	        judged.append((lineno, text, NAME))
   276	
   277	    for node in ast.walk(tree):
   278	        if isinstance(node, ast.Name):
   279	            name(node.lineno, node.id)
   280	        elif isinstance(node, ast.Attribute):
   281	            name(node.lineno, node.attr)
   282	        elif isinstance(node, ast.arg):
   283	            name(node.lineno, node.arg)
   284	            for lineno, text in _strings_in(node.annotation):
   285	                name(lineno, text)
   286	        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
   287	            name(node.lineno, node.name)
   288	            doc = ast.get_docstring(node, clean=False)
   289	            if doc:
   290	                judged.append((node.lineno, doc, PROSE))
   291	            for lineno, text in _strings_in(getattr(node, "returns", None)):
   292	                name(lineno, text)
   293	        elif isinstance(node, ast.Module):
   294	            doc = ast.get_docstring(node, clean=False)
   295	            if doc:
   296	                judged.append((1, doc, PROSE))
   297	        elif isinstance(node, ast.alias):
   298	            name(getattr(node, "lineno", 1), node.asname or node.name)
   299	        elif isinstance(node, ast.keyword) and node.arg:
   300	            name(node.value.lineno, node.arg)
   301	        elif isinstance(node, ast.Dict):
   302	            for key in node.keys:
   303	                if isinstance(key, ast.Constant) and isinstance(key.value, str):
   304	                    name(key.lineno, key.value)
   305	        elif isinstance(node, ast.Subscript):
   306	            index = node.slice
   307	            if isinstance(index, ast.Constant) and isinstance(index.value, str):
   308	                name(index.lineno, index.value)
   309	        elif isinstance(node, ast.Assign):
   310	            if any(_is_dunder_all(t) for t in node.targets):
   311	                for lineno, text in _strings_in(node.value):
   312	                    name(lineno, text)
   313	        elif isinstance(node, ast.AugAssign):
   314	            if _is_dunder_all(node.target):
   315	                for lineno, text in _strings_in(node.value):
   316	                    name(lineno, text)
   317	        elif isinstance(node, ast.AnnAssign):
   318	            for lineno, text in _strings_in(node.annotation):
   319	                name(lineno, text)
   320	            if _is_dunder_all(node.target):
   321	                for lineno, text in _strings_in(node.value):
   322	                    name(lineno, text)
   323	    return judged
   324	
   325	
   326	def _faults(source: str, rel: str) -> list[str]:
   327	    """Every denied name in one file's source, as reportable lines.
   328	
   329	    The production scan and the evasion probes below run through this one
   330	    function, so a probe cannot pass against a code path the real scan does
   331	    not use.
   332	    """
   333	    lines = source.splitlines()
   334	    found: list[str] = []
   335	    for lineno, text, mode in _named(ast.parse(source, filename=rel)):
   336	        term = _denied_term(text, mode)
   337	        if term is None:
   338	            continue
   339	        line = lines[lineno - 1] if 0 < lineno <= len(lines) else ""
   340	        if any(rel == p and marker in line for p, marker in _ALLOWED):
   341	            continue
   342	        found.append(f"{rel}:{lineno}: {term!r} — {_DENIED[term]}")
   343	    return found
   344	
