    89	def _genesis(store: JsonlStore) -> dict:
    90	    docs = [d.as_json() for d in vertex_to_documents(parse_vertex(BASE))]
    91	    return store.absorb_genesis(docs, observer="obs", fact_signer=_signer("k"))
