   401	class MergeDivergence(Exception):
   402	    """The same id carries DIFFERENT content on the two sides of a merge.
   403	
   404	    The admission table (decision:design/arrival-substrate-laws) is explicit:
   405	    id collision with different bytes is identity corruption and is REJECTED,
   406	    never resolved silently in either side's favour. Kyle's whole-branch r1
   407	    ruling (CX-BR-01, decision:design/arrival-branch-r1-rulings) applies that
   408	    law to this merge arm. The target-wins conformance vector pins the
   409	    LEGACY SQLITE arm only (its harness populates plain SqliteStores) and
   410	    its description now says so; this arrival arm's refusal is pinned by
   411	    TestDivergenceRefusal.
   412	
   413	    Comparison is deliberately strict — the fact signature included, so an
   414	    era-mixed pair (the same authored fact carried once with its signature
   415	    and once through a pre-signature-era slice) also refuses. Decided, not
   416	    accidental: a merge cannot tell that case apart from a stripped
   417	    signature, and the refusal message names the diverging field so the era
   418	    case is diagnosable at the site.
   419	    """
   420	
   421	
   422	def _comparable(t: str, row: tuple) -> tuple:
   423	    """One row's dedup-comparison body, shared by both sides of the merge.
   424	
   425	    Facts compare on the full authored 7-column body minus id. Ticks compare
   426	    on the chainless base minus id: chain columns and the tick signature are
   427	    store-local custody stripped by ``_entry_for`` on every merge, so the
   428	    target's chain can never ground a divergence claim against a source
   429	    tick that legitimately carries a different (or no) chain.
   430	    """
   431	    if t == "fact":
   432	        return ("fact", *row[1:7])
   433	    return ("tick", *row[1:6])
   434	
   435	
   436	_COMPARED_FIELDS = {
   437	    "fact": ("kind", "ts", "observer", "origin", "payload", "signature"),
   438	    "tick": ("name", "ts", "since", "origin", "payload"),
   439	}
   440	
   441	
   442	def _refuse_divergence(t: str, row: tuple, held_body: tuple) -> None:
   443	    incoming = _comparable(t, row)
   444	    if held_body[0] != incoming[0]:
   445	        diverging = ["row class"]
   446	    else:
   447	        diverging = [
   448	            name
   449	            for name, ours, theirs in zip(
   450	                _COMPARED_FIELDS[t], held_body[1:], incoming[1:], strict=True
   451	            )
   452	            if ours != theirs
   453	        ]
   454	    raise MergeDivergence(
   455	        f"{t} id {row[0]!r} exists on both sides with different content "
   456	        f"(diverging: {', '.join(diverging) or 'row class'}) — at most one "
   457	        "of them is what an arrival log says, and a merge that picked a "
   458	        "side would re-mint identity. Nothing was appended. Resolve the "
   459	        "contradiction at its source before merging."
   460	    )
   461	
   462	
   463	def _entries_for(source_rows: _SourceRows, held: dict[str, tuple]):
   464	    """The records to append, after dedup. Returns ``(entries, facts, ticks)``.
   465	
   466	    A row whose id the target holds is skipped ONLY when its comparison body
   467	    matches the target's (:func:`_comparable`); the same id over different
   468	    content raises :class:`MergeDivergence` before anything is appended.
   469	    A group whose rows are ALL already in the target contributes no record.
   470	    A batch group that is partly deduped contributes its remainder: two or
   471	    more surviving rows still ride as one batch (the ceremony's atomicity is
   472	    the reason the batch exists), a single survivor rides as a plain fact
   473	    line, because a one-row batch is a second spelling the codec refuses.
   474	    """
   475	    from engine.arrival import Entry
   476	
   477	    entries: list[Entry] = []
   478	    facts = ticks = 0
   479	    for kind, rows in source_rows.groups:
   480	        fresh = []
   481	        for t, row in rows:
   482	            body = held.get(row[0])
   483	            if body is not None:
   484	                if body != _comparable(t, row):
   485	                    _refuse_divergence(t, row, body)
   486	                continue
   487	            fresh.append((t, row))
   488	        if not fresh:
   489	            continue
   490	        for t, row in fresh:
   491	            held[row[0]] = _comparable(t, row)
   492	            if t == "fact":
   493	                facts += 1
   494	            else:
   495	                ticks += 1
   496	        entries.append(_entry_for(kind, fresh))
   497	    return entries, facts, ticks
   498	
   499	
   500	def _entry_for(kind: str, rows: list[tuple[str, tuple]]):
   501	    """One record for a group of surviving rows.
   502	
   503	    Record shape, asymmetric between facts and ticks, and the asymmetry is
   504	    inherited from the live write path rather than invented here:
   505	
   506	    * ``k`` is the row class, never a fact's own kind.
   507	    * ``observer``/``origin``/``at`` mirror the row's own columns, exactly as
   508	      the live path does. A merged fact's record claims its ORIGINAL
   509	      observer — the record describes the authored row, not the operator who
   510	      admitted it. A tick has no observer, so its record carries the tick's
   511	      name there, which is the authorship a tick has.
   512	    * **Fact bodies ride verbatim, the row's own signature included.** The
   513	      fact signature is a per-observer authorship claim over content only,
   514	      carried verbatim and never re-signed; era-aware NULL for a
   515	      pre-signature source.
   516	    * **Tick bodies carry chain columns and the tick signature as
   517	      NULL/absent.** ``prev_hash``/``window_start``/``fact_cursor``/
   518	      ``window_hash`` are store-local custody: carrying them verbatim would
   519	      put ticks in the target whose links reference the SOURCE's chain, so
   520	      the target's chain verification would break on every merged tick. And
   521	      keeping the tick signature while nulling the chain would be a
   522	      verification lie, because the tick signature covers the chain fields.
   523	      The codec accepts all five as nullable — this is the pre-chain era
   524	      shape, honestly claimed.
   525	
   526	    There is no record-level signature. ``merge_store`` takes no signer and
   527	    never will: there is no key to sign with, and the target's operator holds
   528	    no key for a foreign observer anyway. The authorship claim that survives
   529	    is the fact row's own signature, riding in the body. An ADMISSION
   530	    attestation — the target custodian's own claim that it admitted this
   531	    record — is a later cut's.
   532	    """
   533	    from engine.arrival import Entry
   534	    from engine.jsonl_codec import (
   535	        TICK_CHAIN_FIELDS,
   536	        TICK_FIELDS,
   537	        object_of_batch,
