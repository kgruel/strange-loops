   128	def test_snapshot_consistency_writer_appends_mid_pagination(db, order):
   129	    """Inside one snapshot bracket, a concurrent append is invisible: the
   130	    page stream equals the pre-write full scan, both orders."""
   131	    with StoreReader(db) as reader:
   132	        before_ids = [f["id"] for f in reader.query_facts(limit=1000, order=order).items]
   133	    with StoreReader(db) as reader:
   134	        with reader.snapshot():
   135	            first = reader.query_facts(limit=7, order=order)
   136	            # Mid-pagination write on a separate connection (WAL).
   137	            w = _open_store(db)
   138	            for j in range(5):
   139	                w.append(Fact.of("decision", "kyle", ts=2000.0 + j, seq=1000 + j))
   140	            w.close()
   141	            rest = _walk_from(reader, order, 7, first)
   142	    assert [f["id"] for f in first.items] + [f["id"] for f in rest] == before_ids
