   651	def kdl_remove_child(
   652	    text: str,
   653	    parent_path: list[str],
   654	    child_name: str,
   655	    child_key: str | None = None,
   656	    key_field: str | None = None,
   657	) -> str:
   658	    """Remove a child from the block at parent_path.
   659	
   660	    Matching modes:
   661	    - child_name only: removes first child whose first token is child_name
   662	    - + child_key (no key_field): match first quoted positional arg
   663	    - + child_key + key_field: match `key_field="child_key"` property
   664	
   665	    Removes the entire child span (single-line or multi-line block).
   666	    Raises ValueError if no matching child found.
   667	
   668	    Limitation: when the parent block is itself single-line
   669	    (``loops { decision { ... } }`` rendered on one line), there are no
   670	    child *lines* to scan and removal will raise "No matching child".
   671	    Use ``kdl_insert_child`` first to expand the parent across lines if
   672	    you need to mutate single-line parents.
   673	    """
   674	    had_trailing = text.endswith("\n")
   675	    lines = text.splitlines()
   676	    start, end = kdl_find_block(text, parent_path)
   677	
   678	    # Walk children at depth 0 inside the block.
   679	    depth = 0
   680	    i = start + 1
   681	    while i < end:
   682	        stripped = lines[i].strip()
   683	        if depth == 0 and _line_matches_child(stripped, child_name, child_key, key_field):
   684	            opens = lines[i].count("{") - lines[i].count("}")
   685	            if opens == 0:
   686	                # Single-line: remove this one line.
   687	                del lines[i]
   688	            else:
   689	                # Multi-line block child: walk to matching close.
   690	                d = opens
   691	                j = i + 1
   692	                while j < end and d > 0:
   693	                    d += lines[j].count("{") - lines[j].count("}")
   694	                    j += 1
   695	                del lines[i:j]
   696	            result = "\n".join(lines)
   697	            if had_trailing:
   698	                result += "\n"
   699	            return result
   700	        depth += lines[i].count("{") - lines[i].count("}")
   701	        i += 1
   702	
   703	    desc = (
   704	        f"{child_name}"
   705	        + (f" {key_field}={child_key!r}" if key_field else f' "{child_key}"' if child_key else "")
   706	    )
   707	    raise ValueError(
   708	        f"No matching child '{desc}' inside parent path {parent_path!r}"
   709	    )
