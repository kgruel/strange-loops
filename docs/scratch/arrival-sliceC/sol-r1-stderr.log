   850	    if not entries and ast.discover is not None:
   851	        # discover vertices also resolve through _resolve_stores
   852	        store_paths = _resolve_stores(ast, vertex_path)
   853	        # For discover, we don't have vertex paths — fall back to empty
   854	        # (discover children need their own vertex files for search fields)
   855	        if not store_paths:
   856	            return []
   857	        # Can't recurse without vertex paths; discover is not yet supported for search
   858	        return []
