   234	def _fact_row_hash(row: tuple) -> str:
   235	    """Era-aware hash of one persisted fact row.
   236	
   237	    Row shape: (id, kind, ts, observer, origin, payload[, signature]).
   238	    The signature key is included only when the row carries one, so every
   239	    pre-signature fact row hashes byte-identically to delta 1/2 — already-
   240	    sealed window hashes never re-anchor. For signed facts the window
   241	    commits over content+signature, making fact-signature-stripping a
   242	    detectable break in any sealed window (delta-2 envelope trick, one
   243	    layer down — design/fact-signing-per-observer-keys).
   244	    """
   245	    envelope = {
   246	        "id": row[0], "kind": row[1], "ts": row[2],
   247	        "observer": row[3], "origin": row[4], "payload": row[5],
   248	    }
   249	    if len(row) > 6 and row[6] is not None:
   250	        envelope["signature"] = row[6]
   251	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
