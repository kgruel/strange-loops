    90	def _ensure_reader(canonical_path: Path, index_path: Path) -> tuple[StoreReader, bool]:
    91	    """Ensure the target store index is current and return an open StoreReader.
    92	
    93	    Returns (StoreReader, agreement_boolean).
    94	    """
    95	    preflight = read_preflight(canonical_path, mode=PreflightMode.RECOVER_THEN_OPEN)
    96	    if preflight.store is not None:
    97	        preflight.store.close()
    98	    return StoreReader(index_path), preflight.agreed
