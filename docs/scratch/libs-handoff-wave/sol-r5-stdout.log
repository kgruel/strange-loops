    45	    if canonical == "jsonl":
    46	        return JsonlStore(
    47	            path=tmp_path / "v.db", log_path=tmp_path / "v.jsonl",
    48	            serialize=ser, deserialize=Fact.from_dict, **kw,
    49	        )
    50	    return SqliteStore(
    51	        path=tmp_path / "v.db", serialize=ser,
    52	        deserialize=Fact.from_dict, **kw,
    53	    )
