     1	"""sql_util — shared SQL predicate builders for the read paths.
     2	
     3	Tiny by design: a predicate that must mean the same thing at every read
     4	surface gets ONE spelling here, so no site can drift.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	__all__ = ["kind_subtree_predicate", "sqlite_busy"]
    10	
    11	
    12	def sqlite_busy(exc: BaseException) -> bool:
    13	    """Is this sqlite error a transient BUSY/LOCKED, not damage?
    14	
    15	    Primary evidence is the error code (``SQLITE_BUSY`` 5 / ``SQLITE_LOCKED``
    16	    6, low byte of any extended code); the message substring is the fallback
    17	    for wrappers that lose the code. ONE spelling (SOL-R4-04): preflight's
    18	    busy classification and the jsonl store's destructive-recovery guards
    19	    must agree, or an authentic ``SQLITE_LOCKED`` ("database table is
    20	    locked", which the old text-only guard missed) quarantines a healthy
    21	    index before preflight can classify it as refused-busy.
    22	    """
    23	    code = getattr(exc, "sqlite_errorcode", None)
    24	    if code is not None:
    25	        return (code & 0xFF) in (5, 6)
    26	    msg = str(exc)
    27	    return "database is locked" in msg or "database table is locked" in msg
    28	
    29	
    30	def kind_subtree_predicate(kind: str, column: str = "kind") -> tuple[str, list[str]]:
    31	    """``(sql, params)`` for "exactly this kind, or its dotted subtree".
    32	
    33	    Matches ``kind`` exactly and anything starting with ``kind + "."``
    34	    (``"ui"`` matches ``"ui"`` and ``"ui.key"``, never ``"uix"``).
    35	
    36	    Binary equality / ``substr`` prefix — deliberately not LIKE, which is
    37	    wrong twice here (SOL-R2-02): ``_``/``%`` are LIKE wildcards (and valid
    38	    kind characters), and LIKE compares ASCII case-insensitively; ``substr``
    39	    is an exact binary compare. Not GLOB either: ``*``/``?``/``[`` would
    40	    need escaping. The three params are the kind repeated.
    41	    """
    42	    return (
    43	        f"({column} = ? OR substr({column}, 1, length(?) + 1) = ? || '.')",
    44	        [kind, kind, kind],
    45	    )

