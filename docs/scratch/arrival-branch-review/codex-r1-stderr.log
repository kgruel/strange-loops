rchestration.py:551-587](file:///Users/kaygee/Code/loops-wt/explore-sliceC/libs/engine/tests/test_ceremony_orchestration.py#L551-L587): `test_apply_over_out_of_band_index_rows_refuses_typed_pre_intent`\n- [libs/engine/tests/test_ceremony_orchestration.py:589-619](file:///Users/kaygee/Code/loops-wt/explore-sliceC/libs/engine/tests/test_ceremony_orchestration.py#L589-L619): `test_intent_write_failure_closes_store_and_refuses_typed`\n- [libs/engine/tests/test_ceremony_orchestration.py:624-637](file:///Users/kaygee/Code/loops-wt/explore-sliceC/libs/engine/tests/test_ceremony_orchestration.py#L624-L637): `test_intent_create_is_exclusive_gate`\n- [libs/engine/tests/test_ceremony_orchestration.py:639-670](file:///Users/kaygee/Code/loops-wt/explore-sliceC/libs/engine/tests/test_ceremony_orchestration.py#L639-L670): `test_two_apply_race_second_refuses_winner_intent_untouched`\n{\"answer\":\"found\",\"locations\":[{\"file\":\"libs/engine/src/engine/sqlite_store.py\",\"lines\":\"1448-1475\",\"note\":\"Implementation of _declaration_head_in_txn: lineage-filtered _decl.*-only CAS predicate returning (rowid, id)\",\"quote\":\"    def _declaration_head_in_txn(\\n        self, conn: Any, lineage_id: str\\n    ) -\\u003e tuple[int, str] | None:\\n        \\\"\\\"\\\"The ``(rowid, id)`` of the newest self-lineage declaration row.\\n\\n        Genesis included; foreign-lineage ``_decl.*`` rows excluded (their\\n        payload stamps a different lineage). This is the CAS token\\n        ``absorb_edit`` compares ``expected_head`` against — receipt-ordered\\n        by rowid, the same axis the resolver folds on.\\n        \\\"\\\"\\\"\\n        best: tuple[int, str] | None = None\\n        rows = conn.execute(\\n            \\\"SELECT id, kind, rowid, payload FROM facts WHERE kind GLOB '_decl.*'\\\"\\n        ).fetchall()\\n        for fact_id, kind, rowid, payload_text in rows:\\n            if fact_id == lineage_id:\\n                pass  # own genesis participates\\n            else:\\n                try:\\n                    payload = json.loads(payload_text)\\n                except (json.JSONDecodeError, TypeError):\\n                    continue\\n                if payload.get(\\\"lineage\\\") != lineage_id:\\n                    continue\\n            candidate = (rowid, fact_id)\\n            if best is None or candidate \\u003e best:\\n                best = candidate\\n        return best\"},{\"file\":\"libs/engine/src/engine/sqlite_store.py\",\"lines\":\"1477-1493\",\"note\":\"Implementation of declaration_head public reader returning the CAS token tuple\",\"quote\":\"    def declaration_head(self) -\\u003e tuple[int, str] | None:\\n        \\\"\\\"\\\"Public read of the self-lineage declaration head (CAS token).\\n\\n        Captured by the CLI at diff time and passed back as ``absorb_edit``'s\\n        ``expected_head`` so a concurrent re-absorb between diff and apply is\\n        refused instead of silently interleaved. None when the lineage is not\\n        open (or unmarked-ambiguous — the write ceremony will refuse anyway).\\n        \\\"\\\"\\\"\\n        self._ensure_meta_table()\\n        conn = self._conn\\n        try:\\n            lineage = self._own_lineage_in_txn(conn)\\n        except AmbiguousGenesis:\\n            return None\\n        if lineage is None:\\n            return None\\n        return self._declaration_head_in_txn(conn, lineage)\"},{\"file\":\"libs/engine/src/engine/sqlite_store.py\",\"lines\":\"1098-1106\",\"note\":\"absorb_edit compares expected_head CAS token inside BEGIN IMMEDIATE transaction\",\"quote\":\"                if expected_head is not None:\\n                    head = self._declaration_head_in_txn(conn, lineage_id)\\n                    if head != tuple(expected_head):\\n                        raise StaleDeclarationHead(\\n                            f\\\"declaration head moved: expected {expected_head}, \\\"\\n                            f\\\"store is at {head} — another edit landed since \\\"\\n                            \\\"the diff was computed; re-run absorb against the \\\"\\n                            \\\"current head\\\"\\n                        )\"},{\"file\":\"libs/engine/src/engine/ceremony.py\",\"lines\":\"382\",\"note\":\"diff_declaration reads CAS token store.declaration_head()\",\"quote\":\"        expected_head = store.declaration_head()\"},{\"file\":\"apps/loops/src/loops/commands/store.py\",\"lines\":\"1257\",\"note\":\"store absorb CLI reads CAS token store.declaration_head()\",\"quote\":\"        expected_head = store.declaration_head()\"},{\"file\":\"libs/engine/src/engine/ceremony.py\",\"lines\":\"423-441\",\"note\":\"_write_intent serializes preview.expected_head into old_decl_head in the persisted intent record\",\"quote\":\"def _write_intent(preview: DeclarationUpdatePreview, observer: str) -\\u003e Path:\\n    intent = {\\n        \\\"v\\\": _INTENT_VERSION,\\n        \\\"mode\\\": preview.mode,\\n        \\\"vertex_path\\\": str(preview.vertex_path),\\n        \\\"canonical_path\\\": str(preview.canonical_path),\\n        \\\"created_ts\\\": datetime.now(UTC).timestamp(),\\n        \\\"observer\\\": observer,\\n        \\\"old_status\\\": preview.declaration_status,\\n        \\\"old_decl_head\\\": list(preview.expected_head)\\n        if preview.expected_head\\n        else None,\\n        \\\"old_store_fingerprint\\\": preview.old_store_fingerprint,\\n        \\\"lineage\\\": preview.generation.get(\\\"lineage\\\"),\\n        \\\"proposed_fingerprint\\\": preview.proposed_fingerprint,\\n        \\\"proposed_documents\\\": list(preview.documents),\\n        \\\"proposed_text\\\": preview.proposed_text,\\n    }\\n    path = intent_path_for(preview.vertex_path)\"},{\"file\":\"libs/engine/tests/test_absorb_edit.py\",\"lines\":\"191-220\",\"note\":\"test_stale_expected_head_refuses exercises CAS token comparison and StaleDeclarationHead refusal\",\"quote\":\"    def test_stale_expected_head_refuses(self, tmp_path):\\n        from engine.sqlite_store import StaleDeclarationHead\\n\\n        db = tmp_path / \\\"x.db\\\"\\n        s = _store(db)\\n        _genesis(s, parse_vertex(BASE))\\n        head = s.declaration_head()\\n        assert head is not None\\n        # A concurrent edit lands after the head was captured...\\n        s.absorb_edit(\\n            [Change(kind=DECL_KIND_DEFINED, subject=\\\"a\\\", payload={\\\"order\\\": 0},\\n                    annotation=\\\"modified\\\")],\\n            observer=\\\"obs\\\", fact_signer=_signer(\\\"k\\\"),\\n        )\\n        # ...so applying a diff computed against the old head refuses.\\n        with pytest.raises(StaleDeclarationHead):\\n            s.absorb_edit(\\n                [Change(kind=DECL_KIND_DEFINED, subject=\\\"b\\\", payload={\\\"order\\\": 1},\\n                        annotation=\\\"modified\\\")],\\n                observer=\\\"obs\\\", fact_signer=_signer(\\\"k\\\"), expected_head=head,\\n            )\\n        # And the current head is accepted.\\n        s.absorb_edit(\\n            [Change(kind=DECL_KIND_DEFINED, subject=\\\"b\\\", payload={\\\"order\\\": 1},\\n                    annotation=\\\"modified\\\")],\\n            observer=\\\"obs\\\", fact_signer=_signer(\\\"k\\\"),\\n            expected_head=s.declaration_head(),\\n        )\\n        s.close()\"},{\"file\":\"libs/engine/tests/test_absorb_edit.py\",\"lines\":\"221-287\",\"note\":\"test_cas_token_rides_the_receipt_axis tests that the CAS token is (rowid, id) receipt-ordered\",\"quote\":\"    def test_cas_token_rides_the_receipt_axis(self, tmp_path):\\n        \\\"\\\"\\\"The CAS token is (rowid, id), not (ts, id).\\n\\n        A backdated declaration row — appended LAST but stamped with an\\n        OLDER ts than the row before it — is the head under receipt order\\n        and is NOT the head under (ts, id). Pinning the two axes apart is\\n        the only way to prove the token tracks the axis the resolver\\n        actually folds on.\\n        \\\"\\\"\\\"\"},{\"file\":\"libs/engine/tests/test_jsonl_ceremonies.py\",\"lines\":\"207-222\",\"note\":\"test_stale_head_refuses_with_log_byte_identical tests expected_head CAS refusal on JSONL store\",\"quote\":\"def test_stale_head_refuses_with_log_byte_identical(tmp_path):\\n    store = open_store(tmp_path)\\n    _genesis(store)\\n    log = canonical_for(store._path, \\\"jsonl\\\")\\n    before = log.read_bytes()\\n    changes = _changes(store._path, EDIT_ONE)\\n    with pytest.raises(StaleDeclarationHead):\\n        store.absorb_edit(\\n            changes,\\n            observer=\\\"obs\\\",\\n            fact_signer=_signer(\\\"k\\\"),\\n            expected_head=(0, \\\"01BOGUS\\\"),\\n        )\\n    assert log.read_bytes() == before\\n    store.close()\"},{\"file\":\"libs/engine/tests/test_ceremony_orchestration.py\",\"lines\":\"504-522\",\"note\":\"test_intent_is_a_discoverable_sibling_with_pinned_fields checks old_decl_head in intent record\",\"quote\":\"def test_intent_is_a_discoverable_sibling_with_pinned_fields(world):\\n    _apply_genesis(world)\\n    preview = plan_declaration_update(world[\\\"vertex\\\"], proposed_text=world[\\\"edit\\\"])\\n    result = apply_declaration_update(\\n        preview, observer=\\\"obs\\\", credentials=Creds(), write_file=_boom\\n    )\\n    intent = result.intent_path\\n    assert intent == world[\\\"vertex\\\"].parent / \\\"x.vertex.intent\\\"\\n    record = json.loads(intent.read_text(encoding=\\\"utf-8\\\"))\\n    for key in (\\n        \\\"v\\\", \\\"mode\\\", \\\"vertex_path\\\", \\\"canonical_path\\\", \\\"old_decl_head\\\",\\n        \\\"old_store_fingerprint\\\", \\\"proposed_fingerprint\\\",\\n        \\\"proposed_documents\\\", \\\"proposed_text\\\",\\n    ):\\n        assert key in record\\n    assert record[\\\"mode\\\"] == \\\"edit\\\"\\n    assert record[\\\"old_decl_head\\\"] == list(preview.expected_head)\\n    recover_declaration_update(intent)  # leave the world clean\"}],\"not_covered\":\"No d