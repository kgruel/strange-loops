   276	def _resolve_witness_position_on_conn(
   277	    conn: sqlite3.Connection,
   278	    store_path: Path,
   279	    address: str,
   280	    *,
   281	    anchor: TickAnchor | None = None,
   282	    group_boundary: str = "refuse",
   283	) -> WitnessPosition:
   284	    """The body of :func:`resolve_witness_position`, operating on an
   285	    ALREADY-OPEN connection.
   286	
   287	    Extracted so a caller that needs MULTIPLE reads in one snapshot (e.g.
   288	    :func:`resolve_cut_summary`, 0.9.0 S6 sol P1) can share one connection/
   289	    transaction instead of paying ``resolve_witness_position``'s own
   290	    open-resolve-close per call — each such call is otherwise a separate
   291	    WAL snapshot, so a concurrent writer's commit landing between two calls
   292	    would make the second describe a LATER store state than the first, a
   293	    silent internal race. ``store_path`` is used only to stamp
   294	    ``WitnessPosition.store`` (the position's home store, read by
   295	    ``verify_position_for_store``'s cross-store guard) — no I/O against it
   296	    here; all reads go through ``conn``.
   297	    """
   298	    fact_id, rowid = _resolve_address_rowid(conn, address)
   299	    span = None if group_boundary == "allow" else receipt_group_span(conn, rowid)
   300	    if span is not None:
   301	        if group_boundary == "floor":
   302	            # Snap OUT of the ceremony to the position just before its first
   303	            # row — the last complete state (M3). Floor forms land on solid
   304	            # ground rather than refusing.
   305	            rowid = span[0] - 1
   306	            fact_id = _id_at_rowid(conn, rowid)
   307	        else:  # "refuse" — an exact fact:/seq: form never silently snaps.
   308	            raise MidReceiptGroupPosition(
   309	                f"witness position {address!r} (rowid {rowid}) lands inside "
   310	                f"the atomic receipt group at rowids {span[0]}..{span[1]} — "
   311	                "a declaration edit ceremony is all-or-nothing. Address the "
   312	                f"position at-or-after rowid {span[1]} (the ceremony's last "
   313	                "row) to include the whole edit, or before its first row to "
   314	                "exclude it."
   315	            )
   316	    marker = _read_own_lineage(conn)
   317	    seq = conn.execute(
   318	        "SELECT COUNT(*) FROM facts WHERE rowid <= ?", (rowid,)
   319	    ).fetchone()[0]
   320	    resolved_anchor = anchor if anchor is not None else _resolve_anchor(conn, rowid)
   321	    return WitnessPosition(
   322	        fact_id=fact_id,
   323	        rowid=rowid,
   324	        seq=seq,
   325	        lineage=marker,
   326	        unadopted=marker is None,
   327	        anchor=resolved_anchor,
   328	        store=str(Path(store_path).resolve()),
   329	    )
   330	
   331	
   332	def resolve_witness_position(
   333	    store_path: Path,
   334	    address: str,
   335	    *,
   336	    timeout: float = 5.0,
   337	    anchor: TickAnchor | None = None,
   338	    group_boundary: str = "refuse",
   339	) -> WitnessPosition:
   340	    """Resolve a witness address to a :class:`WitnessPosition` against one store.
   341	
   342	    Address forms handled at this engine seam:
   343	
   344	    - ``"head"`` — the newest received fact, captured atomically (frozen once
   345	      returned; no moving token). An empty store resolves to the empty prefix.
   346	    - :data:`GENESIS_SENTINEL` (``""``) — the empty / start-of-store position.
   347	    - a full, canonical fact id — resolved by **primary-key lookup only** (A3);
   348	      an unknown id raises :class:`UnknownWitnessHandle`. Prefix expansion and
   349	      ``seq:``/``tick:``/wall-clock address forms are CLI-layer resolutions that
   350	      produce a fact id (or a rowid) to hand here.
   351	
   352	    Runs the receipt-group guard (A2) — a mid-ceremony position raises
   353	    :class:`MidReceiptGroupPosition`. Reads the ``own_lineage`` marker to set
   354	    :attr:`WitnessPosition.unadopted` (N1).
   355	
   356	    ``anchor``: for a ``tick:``/wall-clock address, the CALLER already knows the
   357	    exact tick it snapped to (from :func:`resolve_tick_cursor` /
   358	    :func:`resolve_tick_floor`) and passes it here so it is PRESERVED as the
   359	    position's :attr:`~WitnessPosition.anchor` (review finding 7a). Re-deriving
   360	    it from the cursor would be wrong when several ticks seal the same
   361	    ``fact_cursor`` — one of them possibly *after* the requested mark — and the
   362	    re-derivation would name that later tick instead of the floor tick actually
   363	    selected. When ``None`` (head/seq/fact forms), the anchor is derived as the
   364	    last sealed tick at-or-before the position.
   365	
   366	    ``group_boundary`` governs a position that lands inside an atomic receipt
   367	    group (A2). ``"refuse"`` (default, for exact forms — ``fact:``/``seq:``)
   368	    raises :class:`MidReceiptGroupPosition`. ``"floor"`` (for floor-derived
   369	    forms — ``tick:``/wall-clock, chosen by the CLI resolver per address form)
   370	    **snaps** to the position just before the ceremony's first row — the last
   371	    complete ontology state — rather than refusing (M3). ``head`` never lands
   372	    mid-group (a completed ceremony committed atomically). ``"allow"`` skips
   373	    the guard entirely — reserved for READ-PROGRESS tokens (a pagination
   374	    page boundary, ``StoreReader.query_facts``) where the position marks how
   375	    far a listing walked, never a fold cut: refusing or snapping there would
   376	    make some pages unaddressable and break the no-dups/no-gaps pagination
   377	    contract. Never use ``"allow"`` for a position that will select a fold.
   378	    """
   379	    conn = _open_readonly(store_path, timeout=timeout)
   380	    if conn is None:
   381	        raise WitnessResolutionError(
   382	            f"{store_path} is not a usable store — cannot resolve a witness "
   383	            "position against it"
   384	        )
   385	    try:
   386	        return _resolve_witness_position_on_conn(
   387	            conn, store_path, address, anchor=anchor, group_boundary=group_boundary,
   388	        )
   389	    finally:
   390	        conn.close()
   391	
   392	
   393	@dataclass(frozen=True)
   394	class CutSummary:
   395	    """One-snapshot bundle of everything a seal-cut answer needs — head
   396	    witness position, store tick total, and (when sealed) the anchor tick's
   397	    own receipt ordinal — resolved within ONE read transaction (0.9.0 S6,
   398	    sol P1 review).
   399	
   400	    Three separate ``resolve_witness_position``/summary calls would each be
   401	    an independent WAL snapshot; a concurrent writer's commit landing
   402	    between two of them would make ``tick_total``/the anchor's ordinal
   403	    describe a LATER store state than the ``position`` they're reported
   404	    alongside — an internal race distinct from (and in addition to) the
   405	    caller-level TOCTOU between fetching a fold and resolving its cut
   406	    (``cli.witness_address.resolve_cut`` is called strictly AFTER its
   407	    caller's fold fetch completes for exactly that reason; see its
   408	    docstring). This dataclass is what makes the THREE READS themselves
   409	    atomic with each other.
   410	    """
   450	            anchor_seq: int | None = None
   451	            if position.anchor is not None:
   452	                try:
   453	                    anchor_position = _resolve_witness_position_on_conn(
   454	                        conn, store_path, position.anchor.fact_cursor,
   455	                    )
   456	                    anchor_seq = anchor_position.seq
   457	                except WitnessResolutionError:
   458	                    anchor_seq = None
   459	        finally:
   460	            conn.execute("ROLLBACK")
   461	    finally:
   462	        conn.close()
   463	    return CutSummary(position=position, tick_total=tick_total, anchor_seq=anchor_seq)
