   518	        node_closed = False
   519	
   520	    for ch in inner:
   521	        if in_str:
   522	            buf.append(ch)
   523	            if esc:
   524	                esc = False
   525	            elif ch == "\\":
   526	                esc = True
   527	            elif ch == '"':
   528	                in_str = False
   529	            continue
   530	        if node_closed and not ch.isspace():
   531	            if ch == ";":
   532	                _flush()
   533	                continue
   534	            _flush()
   535	        if ch == '"':
