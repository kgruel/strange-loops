   650	        kind = Kind(raw["kind"])
   651	        level = Level(raw["level"])
   652	    except (KeyError, ValueError):
   653	        return None
   654	    lineage = raw.get("lineage")
   655	    ordinal = raw.get("ordinal")
   656	    record_hash = raw.get("record_hash")
   657	    observed_at = raw.get("observed_at")
   658	    if (
   659	        not isinstance(lineage, str)
   660	        or not isinstance(ordinal, int)
   661	        or isinstance(ordinal, bool)
   662	        or not isinstance(record_hash, str)
   663	        or not isinstance(observed_at, (int, float))
   664	        or isinstance(observed_at, bool)
   665	    ):
