   672	def test_resolved_index_tails_an_existing_index_that_is_behind(tmp_path):
   673	    """An existing .db is not evidence of a current one.
   674	
   675	    Read-only invocations never construct a JsonlStore, so if resolution
   676	    short-circuits on index.exists() a durable-but-unindexed line stays
   677	    invisible indefinitely — a canonical fact reported as absent.
   678	    """
   679	    from engine.jsonl_store import resolved_index
   680	
   681	    store = open_store(tmp_path)
   682	    first = store.append(fact(message="one"))
   683	    store.close()
   684	
   685	    orphan = ("01UNINDEXED", "note", 2.0, "sol", "", json.dumps({"m": "two"}))
   686	    with (tmp_path / "s.jsonl").open("a", encoding="utf-8") as fh:
   687	        fh.write(serialize_fact_row(orphan) + "\n")
   688	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")] == [first]
   689	
   690	    index = resolved_index(tmp_path / "s.jsonl")
   691	    assert index == tmp_path / "s.db"
   692	    assert [r[0] for r in sqlite_facts(index)] == [first, "01UNINDEXED"]
