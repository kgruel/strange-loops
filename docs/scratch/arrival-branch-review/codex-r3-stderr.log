   751	    # -- minting -------------------------------------------------------
   752	
   753	    @classmethod
   754	    def mint(
   755	        cls,
   756	        path: Path | str,
   757	        *,
   758	        observer: str,
   759	        signer: Signer,
   760	        key: str,
   761	        origin: str = "",
   762	        lineage: str | None = None,
   763	        at: float | None = None,
   764	    ) -> ArrivalLog:
   765	        """Open a new lineage: write genesis and publish it atomically.
   766	
   767	        The genesis record is self-naming — the lineage id it carries is the
   768	        one its own coordinate ``(lin, 0)`` opens — and it must be signed:
   769	        genesis is the lineage's attestation root, and the signature is over
   770	        the ACTUAL final body, so the body is assembled first and signed
   771	        second. The body is ``{protocol, lineage, key}`` and nothing else
   772	        (decision:design/arrival-sliceA-authority §2.3): ``key`` is the
   773	        founding PUBLIC key in the ratified wire format, self-signed at
   774	        ordinal 0 — the anchor every later authorship answer resolves back
   775	        to. The document set is movement 2, records at ordinal >= 1; era
   776	        pins dissolve under the dense ordinal; containment claims belong to
   777	        the migration sidecar's genesis, never to a live store's.
   778	
   779	        ``key`` and ``signer`` must correspond — the grammar checks the
   780	        key's shape here, and :func:`verify_authorship` is where the
   781	        self-certification is cryptographically established. A mint whose
   782	        signer does not hold ``key`` produces a log the verifier refuses at
   783	        ordinal 0.
   784	
   785	        Staging wins ``O_EXCL`` on ``<name>.arrival.tmp`` FIRST and only then
   786	        checks for an existing log. That order is what makes minting a race
   787	        safe: the tmp path is the mutex, so the existence check happens with
   788	        the mutex held. Checking before creating would leave a window where
   789	        both processes see no log and the second one's rename destroys the
   790	        first one's store.
   791	
   792	        The directory is fsync'd once, here. The file's own fsync is not
   793	        enough at creation: an fsync'd file whose directory entry never
   794	        reached disk is a store that vanishes on power loss, and unlike the
   795	        old design there is no second copy to re-export from. Per-append
   796	        directory fsync is not needed — the entry already exists and only the
   797	        file's size and content change after this.
   798	        """
   799	        log = cls(path)
   800	        log.path.parent.mkdir(parents=True, exist_ok=True)
   801	
   802	        key_fault = _key_shape_fault(key)
   803	        if key_fault is not None:
   804	            raise GenesisRefused(
   805	                f"genesis founding key is malformed ({key_fault}) — the "
   806	                "ratified wire format is a raw-32-byte base64 public key"
   807	            )
   808	        lin = mint_lineage() if lineage is None else lineage
   809	        body = {"protocol": GRAMMAR_VERSION, "lineage": lin, "key": key}
   810	        at = time.time() if at is None else at
   811	        sig = signer(observer, content_commitment(GENESIS_KIND, at, observer, origin, body))
   812	        if not sig:
   813	            raise GenesisRefused(
   814	                f"genesis for lineage {lin} is unsigned — genesis is the lineage's "
   815	                f"attestation root and observer {observer!r} produced no signature"
   816	            )
   817	        line = encode_record(
   818	            build_record(
   819	                lin=lin, ordinal=0, prev=None, k=GENESIS_KIND, body=body,
   820	                observer=observer, origin=origin, at=at, sig=sig,
   821	            )
   822	        )
   823	
   824	        try:
   825	            fd = os.open(str(log.tmp_path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   826	        except FileExistsError as exc:
   827	            raise GenesisRefused(
   828	                f"{log.tmp_path} exists — another process is minting this lineage, "
   829	                "or a previous mint died mid-flight and left staging behind"
   830	            ) from exc
   831	        try:
   832	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
   833	                # The existence check runs with the staging mutex held, which
   834	                # is what makes it authoritative rather than a fast path.
   835	                if log.path.exists():
   836	                    raise GenesisRefused(
   837	                        f"{log.path} already exists — a lineage is minted once, and "
   838	                        "publishing over an existing log would destroy a store"
   839	                    )
   840	                fh.write(line + "\n")
   841	                fh.flush()
   842	                os.fsync(fh.fileno())
   843	            log.tmp_path.replace(log.path)
   844	        except BaseException:
   845	            # The staging create won, but the bytes never became durable —
   846	            # leave zero residue behind the failed mint.
   847	            with contextlib.suppress(OSError):
   848	                log.tmp_path.unlink()
   849	            raise
   850	        _fsync_dir(log.path.parent)
   851	        return log
   852	
