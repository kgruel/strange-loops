   364	def _row_counts(conn) -> dict[str, int]:
   365	    return {
   366	        "facts": conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0],
   367	        "ticks": conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0],
   368	    }
