  1380	def test_a_journal_with_no_readable_content_is_not_granted_a_receipt(tmp_path):
  1381	    """BLOCKING-2 at the seam: unreadable is not first contact.
  1382	
  1383	    An empty journal says nothing was ever accepted here and trust on first use
  1384	    is the honest answer. A journal holding content this build cannot read says
  1385	    heads WERE accepted and their ordinals are what was lost — so it gets no
  1386	    bootstrap receipt, because writing one would record a trust decision made
  1387	    precisely because the memory became unreadable.
  1388	    """
  1389	    log_path = minted(tmp_path / "s.arrival")
  1390	    append_legacy(log_path, "one")
  1391	    lineage = lineage_of(log_path)
  1392	    journal_path(lineage).parent.mkdir(parents=True, exist_ok=True)
  1393	    journal_path(lineage).write_text(
  1394	        json.dumps({"v": 1, "type": "arrival-head-observation"})
  1395	        + "\n"
  1396	        + json.dumps({"v": 99, "kind": "future"})
  1397	        + "\n",
  1398	        encoding="utf-8",
  1399	    )
  1400	    before = journal_bytes(lineage)
  1401	
  1402	    ledger = opened(log_path)
  1403	    comparison = ledger.opened.comparison
  1404	    assert isinstance(comparison, Indeterminate)
  1405	    assert comparison.at_least is None, "there is no bound to be had"
  1406	    assert journal_bytes(lineage) == before, "a receipt was written anyway"
