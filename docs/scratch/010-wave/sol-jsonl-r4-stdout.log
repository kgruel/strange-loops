    28	def _declared_store(vertex_name: str) -> tuple[str, Path]:
    29	    """The raw ``store`` locator in ``loops/{name}.vertex``, and that file's path.
    30	
    31	    One reader for the declaration, so the locator's **extension** — which is
    32	    ``engine.residence``'s authority switch — reaches every caller. A second
    33	    spelling of "where the store is" is a second answer to "which file is
    34	    authoritative", which is exactly the bug this collapses.
    35	    """
    36	    from lang import parse_vertex_file
    37	
    38	    vertex_path = _PKG_ROOT / "loops" / f"{vertex_name}.vertex"
    39	    vertex = parse_vertex_file(vertex_path)
    40	    return vertex.store or f"data/{vertex_name}.db", vertex_path
    41	
    42	
    43	def store_path() -> Path:
    44	    """The canonical task-store artifact for the current workspace.
    45	
    46	    The **canonical artifact**, like every path this module hands out: it is
    47	    what a writer must resolve. Reads go through ``engine.vertex_*``, which
    48	    resolves the index itself.
    49	
    50	    The declaration answers *what kind* of store (``.db`` → sqlite-canonical,
    51	    ``.jsonl`` → JSONL-canonical, per ``engine.residence``); the process cwd
    52	    answers *where*. That second half deliberately departs from residence's
    53	    "resolve relative to the vertex file" rule, and only here: this app's
    54	    contract is one task store per workspace (a worker runs in its own
    55	    worktree and writes that worktree's store), so a package-relative path
    56	    would collapse every workspace onto the packaged one. ``store_path_for``
    57	    is the portable resolution, used for the declarations that are not
    58	    per-workspace.
    59	    """
    60	    declared = Path(_declared_store("tasks")[0])
    61	    return declared if declared.is_absolute() else Path.cwd() / declared
    62	
    63	
    64	def store_path_for(vertex_name: str) -> Path:
    65	    """The canonical store artifact declared by ``loops/{name}.vertex``.
    66	
    67	    ``engine.residence`` owns the "which file is authoritative" rule; asking
    68	    it rather than re-deriving here is what keeps this app on the right side
    69	    of the authority switch when a declaration flips to ``.jsonl``.
    70	    """
    71	    from engine.residence import canonical_store_path
    72	
    73	    declared, vertex_path = _declared_store(vertex_name)
    74	    return canonical_store_path(declared, vertex_path)
    75	
