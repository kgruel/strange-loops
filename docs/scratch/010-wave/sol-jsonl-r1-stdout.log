   492	def test_two_open_handles_do_not_brick_the_store(tmp_path):
   493	    """Regression: per-handle count caching bricked a consistent store.
   494	
   495	    Two handles open at once (a daemon plus an ``sl emit``), one append
   496	    through each. The log has both lines, sqlite has both rows, the offset
   497	    equals the file size — fully consistent. A cached per-handle counter
   498	    made the second committer stamp 1 against COUNT(*)=2, so the next open
   499	    refused, naming out-of-band writers that never ran.
   500	    """
   501	    a = open_store(tmp_path)
   502	    b = open_store(tmp_path)
   503	    a.append(fact(message="from-a"))
   504	    b.append(fact(message="from-b"))
   505	    a.close()
   506	    b.close()
   507	
   508	    assert len(lines(log_path_for(tmp_path / "s.db"))) == 2
