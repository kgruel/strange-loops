   420	        records = deserialize_records(text)
   421	    except (JsonlCodecError, UnicodeError):
   422	        return False  # garbage past the offset is not an innocence claim
   423	    # A batch line is judged by its first inner row — the writer's crash
   424	    # window leaves the WHOLE ceremony line unindexed, so one probe is the
   425	    # same O(1) corroboration a plain line gets.
   426	    t, row = records[0]
