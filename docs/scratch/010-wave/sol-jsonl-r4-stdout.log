    77	def _open_store(path: Path, serialize, deserialize):
    78	    """Open the right store class for a canonical locator.
    79	
    80	    Never ``SqliteStore(path=...)`` directly: a ``.db`` looks identical
    81	    whether it is canonical or a derived index, so constructing one by hand
    82	    would write sqlite bytes straight into a declared canonical log the day
    83	    a declaration flips to ``.jsonl`` — an out-of-band insert the log never
    84	    accounts for. ``open_canonical_store`` is the one place that answers the
    85	    question, and it returns a plain ``SqliteStore`` for a ``.db`` locator,
    86	    which is every declaration this app has today.
    87	    """
    88	    from engine.jsonl_store import open_canonical_store
    89	
    90	    path.parent.mkdir(parents=True, exist_ok=True)
    91	    return open_canonical_store(path, serialize=serialize, deserialize=deserialize)
    92	
