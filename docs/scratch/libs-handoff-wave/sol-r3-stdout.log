   447	    def _stamp(self, offset: int, facts: int, ticks: int) -> None:
   448	        """Stage the offset + indexed-row-count marks (caller commits)."""
   449	        for key, value in (
   450	            (_OFFSET_KEY, offset),
   451	            (_FACT_COUNT_KEY, facts),
   452	            (_TICK_COUNT_KEY, ticks),
