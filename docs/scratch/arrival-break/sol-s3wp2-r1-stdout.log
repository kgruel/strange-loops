     1	"""Generator for comparison conformance vectors.
     2	
     3	Builds golden vectors pinning the head-comparison state machine — slice 3 of the
     4	arrival break, ``witness-protocol.html`` §07 as amended by the slice-3 rulings.
     5	The question the area answers is the one no backend can answer about itself: *is
     6	the log in front of me the same log this machine accepted yesterday?*
     7	
     8	**Two vector forms, and the split is the area's design point.**
     9	
    10	- ``form: "heads"`` hands a ``(known, presented, at_known)`` triple straight to
    11	  the pure classifier. These pin the seven §07 rows with NO journal encoding,
    12	  because §B.3's journal is a local cache grammar rather than wire — it is
    13	  deliberately not the record codec, it versions independently, and no other
    14	  implementation is obliged to have one. Routing every row through a journal
    15	  fixture would pin this repo's cache format onto an implementation that owes
    16	  only the state machine.
    17	- ``form: "journal"`` hands raw lines to the pure reader and then attempts the
    18	  comparison. Every read rule lives here and NONE of them is reachable from the
    19	  classifier: trust-epoch scoping, the maximum-ordinal rule, equivocation, the
    20	  incomplete-read lower bound, the header's three-way classification.
    21	
    22	Five families, each answering a question the others cannot:
    23	
    24	- ``comparison-classify-*``: the seven rows, in isolation, plus the guard-order
    25	  claim that a foreign lineage is judged before any ordinal arithmetic.
    26	- ``comparison-epoch-*``: a trust-reset opens a new epoch, RESET-INCLUSIVE, and
    27	  the epoch scopes the equivocation check too.
    28	- ``comparison-journal-*``: the maximum-ordinal read rule, equivocation and its
    29	  agreement control, and the two journals that are honestly first contact.
    30	- ``comparison-incomplete-*``: an incomplete read yields a LOWER BOUND — sound
    31	  below itself, unable to answer either proceed row — and the third state where
    32	  content was claimed and nothing at all could be read.
    33	- ``comparison-header-*``: the three-way classification, which never absorbs a
    34	  line and never refuses the file.
    35	
    36	Every vector is deterministic: one fixed lineage, fixed observation times, and
    37	record hashes derived from a fixed tag. Nothing here reads a clock.
    38	
    39	Well-formed journals are built through the real ``append_entry`` so the vectors
    40	pin the writer's actual bytes, under a TEMPORARY ``XDG_STATE_HOME`` that is
    41	asserted before the first append — this generator must never touch a real state
    42	root. Damage, ambiguity and foreign-build lines are spliced in afterwards, since
    43	they are by definition what the writer would not produce.
    44	
    45	Run once to generate/regenerate frozen vector files:
    46	    uv run --package engine python spec/conformance/generate_comparison.py
    47	"""
    48	
    49	from __future__ import annotations
    50	
    51	import hashlib
    52	import json
    53	import os
    54	import tempfile
    55	from collections.abc import Callable
    56	from dataclasses import dataclass
    57	from pathlib import Path
    58	from typing import Any
    59	
    60	from engine.arrival_contract import Head
    61	from engine.arrival_head_attestation import (
    62	    HeadAttestation,
    63	    HeadLowerBound,
    64	    HeadUnreadable,
    65	    IndeterminateComparison,
    66	    JournalEquivocation,
    67	    Kind,
    68	    Level,
    69	    append_entry,
    70	    compare,
    71	    journal_path,
    72	    parse_journal_lines,
    73	    state_root,
    74	)
    75	
    76	REPO_ROOT = Path(__file__).resolve().parents[2]
    77	COMPARISON_DIR = REPO_ROOT / "spec" / "conformance" / "vectors" / "comparison"
    78	
    79	# One fixed lineage across the area, so a reader comparing two vectors is
    80	# comparing histories and not identifiers. The second exists only to be a
    81	# DIFFERENT one.
    82	LINEAGE = "01M3COMPARISONVECTORLINEAGE"
    83	OTHER_LINEAGE = "01M3COMPARISONREPLACEMENT"
    84	
    85	# Fixed observation times. Witness metadata, never ledger order — so they are
    86	# constants rather than a clock, and nothing in the area depends on their order.
    87	OBSERVED_AT = 1788000000.0
    88	LOCATION = "/vectors/comparison/project.arrival"
    89	
    90	# The serialized type marker, restated rather than imported from the module's
    91	# private constant: a vector generator that reached into a private name would
    92	# make the frozen artifacts a function of an implementation detail.
    93	OBSERVATION_TYPE = "arrival-head-observation"
    94	
    95	
    96	def rh(tag: str) -> str:
    97	    """A deterministic stand-in record hash: 64 hex, stable across runs.
    98	
    99	    The journal stores heads it was handed and validates no hash, so these need
   100	    to be well-shaped rather than real. Derived from a tag so that two vectors
   101	    naming the same tag mean the same head and a reader can see it.
   102	    """
   103	    return hashlib.sha256(f"comparison-vector/{tag}".encode()).hexdigest()
   104	
   105	
   106	def head(ordinal: int, tag: str | None = None, lineage: str = LINEAGE) -> Head:
   107	    return Head(
   108	        lineage=lineage, ordinal=ordinal, record_hash=rh(tag or f"ord-{ordinal}")
   109	    )
   110	
   111	
   112	def entry(
   113	    ordinal: int,
   114	    *,
   115	    kind: Kind = Kind.ADVANCE,
   116	    level: Level = Level.COMMIT,
   117	    tag: str | None = None,
   118	) -> HeadAttestation:
   119	    return HeadAttestation(
   120	        head=head(ordinal, tag),
   121	        kind=kind,
   122	        level=level,
   123	        observed_at=OBSERVED_AT + ordinal,
   124	        location=LOCATION,
   125	    )
   126	
   127	
   128	def bootstrap() -> HeadAttestation:
   129	    """The first entry, at Level.MINT — this process minted the genesis."""
   130	    return entry(0, kind=Kind.BOOTSTRAP, level=Level.MINT)
   131	
   132	
   133	def reset(ordinal: int) -> HeadAttestation:
   134	    """An operator ceremony accepting a restore back to ``ordinal``.
   135	
   136	    ``Level.FULL`` because an operator who ran the ceremony verified from
   137	    genesis. Not load-bearing for any read rule: the epoch scope keys on
   138	    ``Kind.TRUST_RESET`` alone.
   139	    """
   140	    return entry(ordinal, kind=Kind.TRUST_RESET, level=Level.FULL)
   141	
   142	
   143	def head_json(value: Head | None) -> dict[str, Any] | None:
   144	    if value is None:
   145	        return None
   146	    return {
   147	        "lineage": value.lineage,
   148	        "ordinal": value.ordinal,
   149	        "record_hash": value.record_hash,
   150	    }
   151	
   152	
   153	def entry_json(value: HeadAttestation | None) -> dict[str, Any] | None:
   154	    if value is None:
   155	        return None
   156	    return {
   157	        "kind": value.kind.value,
   158	        "level": value.level.value,
   159	        "lineage": value.head.lineage,
   160	        "ordinal": value.head.ordinal,
   161	        "record_hash": value.head.record_hash,
   162	        "observed_at": value.observed_at,
   163	        "location": value.location,
   164	    }
   165	
   166	
   167	# ---------------------------------------------------------------------------
   168	# Line transforms — what a correct writer would never produce
   169	# ---------------------------------------------------------------------------
   170	
   171	
   172	def drop_header(lines: list[str]) -> list[str]:
   173	    """Remove the header, leaving readable entries with nothing describing them."""
   174	    return [line for line in lines if '"kind"' in line]
   175	
   176	
   177	def keep_header_only(lines: list[str]) -> list[str]:
   178	    return [line for line in lines if '"kind"' not in line]
   179	
   180	
   181	def torn(ordinal: int) -> Callable[[list[str]], list[str]]:
   182	    """Truncate the line holding ``ordinal`` mid-JSON, as a crash would."""
   183	
   184	    def apply(lines: list[str]) -> list[str]:
   185	        return [
   186	            line[: len(line) // 2] if f'"ordinal":{ordinal},' in line else line
   187	            for line in lines
   188	        ]
   189	
   190	    return apply
   191	
   192	
   193	def replace_at(ordinal: int, raw: str) -> Callable[[list[str]], list[str]]:
   194	    """Swap the line holding ``ordinal`` for a literal one."""
   195	
   196	    def apply(lines: list[str]) -> list[str]:
   197	        return [
   198	            raw if f'"ordinal":{ordinal},' in line else line for line in lines
   199	        ]
   200	
   201	    return apply
   202	
   203	
   204	def replace_header(raw: str) -> Callable[[list[str]], list[str]]:
   205	    def apply(lines: list[str]) -> list[str]:
   206	        return [raw if '"kind"' not in line else line for line in lines]
   207	
   208	    return apply
   209	
   210	
   211	def add_unknown_fields(ordinal: int) -> Callable[[list[str]], list[str]]:
   212	    """Give one v1 entry fields this build has never heard of."""
   213	
   214	    def apply(lines: list[str]) -> list[str]:
   215	        out = []
   216	        for line in lines:
   217	            if f'"ordinal":{ordinal},' in line:
   218	                decoded = json.loads(line)
   219	                decoded["issued_by"] = "a-later-build"
   220	                decoded["corroboration"] = {"facts": 41, "ticks": 7}
   221	                line = json.dumps(decoded, separators=(",", ":"), sort_keys=True)
   222	            out.append(line)
   223	        return out
   224	
   225	    return apply
   226	
   227	
   228	#: A header written by a build after this one: kindless, bearing the type
   229	#: marker, carrying fields this build does not know. Still a header.
   230	LATER_BUILD_HEADER = json.dumps(
   480	    ),
   481	    # --- family: the read rules --------------------------------------------
   482	    JournalCase(
   483	        name="comparison-journal-the-known-head-is-the-maximum-ordinal",
   484	        description=(
   485	            "The remembered head is the epoch's MAXIMUM-ordinal entry, not the "
   486	            "last line. Two writers append concurrently — the arrival lock "
   487	            "serializes their appends, not their journal writes — so lines land "
   488	            "out of order: A commits 5, B commits 6 and journals it, A journals 5 "
   489	            "last. Here the store presents the head recorded at ordinal 5, which "
   490	            "is a genuine restore from 6. Last-line semantics would read the "
   491	            "remembered head as 5 and call this unchanged, which is exactly the "
   492	            "silent re-acceptance the rule exists to close."
   493	        ),
   494	        entries=(bootstrap(), entry(6), entry(5)),
   495	        presented=head(5),
   496	    ),
   497	    JournalCase(
   498	        name="comparison-journal-equivocation-refuses-the-read",
   499	        description=(
   500	            "Two entries at the epoch's maximum ordinal with DIFFERENT record "
   501	            "hashes. The journal has recorded two incompatible histories and it "
   502	            "is not the journal's place to choose between them, so the read "
   503	            "refuses before any comparison — there is no outcome, because the "
   504	            "question of which head was accepted has no answer here."
   505	        ),
   506	        entries=(bootstrap(), entry(6, tag="branch-a"), entry(6, tag="branch-b")),
   507	        presented=head(6, "branch-a"),
   508	    ),
   509	    JournalCase(
   510	        name="comparison-journal-duplicate-entries-at-the-maximum-agree",
   511	        description=(
   512	            "The negative control for equivocation. Two entries at the maximum "
   513	            "ordinal carrying the SAME record hash are a duplicate observation, "
   514	            "not a conflict — a writer journaling a head twice records nothing "
   515	            "new and contradicts nothing. An equivocation refusal that fired here "
   516	            "would have stopped meaning equivocation."
   517	        ),
   518	        entries=(bootstrap(), entry(6), entry(6)),
   519	        presented=head(6),
   520	    ),
   521	    JournalCase(
   522	        name="comparison-journal-an-empty-journal-is-first-contact",
   523	        description=(
   524	            "No lines at all. An empty journal says nothing was ever accepted "
   525	            "here, and trust on first use is the honest answer to it. This is the "
   526	            "boundary the third state sits against: content claimed and "
   527	            "unreadable is NOT this."
   528	        ),
   529	        entries=(),
   530	        presented=head(0, "genesis"),
   531	    ),
   532	    JournalCase(
   533	        name="comparison-journal-a-header-only-journal-is-first-contact",
   534	        description=(
   535	            "A header and no entries. Still first contact: the header describes "
   536	            "the file's grammar and claims no head, so nothing has been accepted "
   537	            "here and nothing has been lost. First contact must stay reachable "
   538	            "wherever it is honest, or the third state would have swallowed it."
   539	        ),
   540	        entries=(bootstrap(),),
   541	        transform=keep_header_only,
   542	        presented=head(0, "genesis"),
   543	    ),
   544	    JournalCase(
   545	        name="comparison-journal-unknown-fields-on-a-v1-entry-are-read",
   546	        description=(
   547	            "The second negative control. An entry at THIS journal grammar "
   548	            "version carrying fields this build has never heard of is read "
   549	            "normally — the journal is append-only and never rewritten, so "
   550	            "unknown fields are preserved on disk by construction and ignored on "
   551	            "read. What makes an entry unusable is the grammar version, not "
   552	            "unfamiliar content; a reader that skipped on unfamiliar fields would "
   553	            "weaken its own claim over nothing."
   554	        ),
   555	        entries=(bootstrap(), entry(6)),
   556	        transform=add_unknown_fields(6),
   557	        presented=head(6),
   558	    ),
   559	    # --- family: the incomplete read ---------------------------------------
   560	    JournalCase(
   561	        name="comparison-incomplete-a-torn-line-yields-a-lower-bound",
   562	        description=(
   563	            "The fixture that refuted 'a mid-file skip is strictly safer than a "
   564	            "torn tail'. One epoch in file order [reset 90, 92, 91], true "
   565	            "remembered head 92; the line holding 92 is torn by a crash, and a "
   566	            "later well-formed entry survives after it. Skipping quietly would "
   567	            "lower the remembered head to 91 and call a genuine restore from 92 "
   568	            "UNCHANGED. So the loss is carried in the read's own type instead: "
   569	            "the head is known only to be AT LEAST 91, and a presented head EQUAL "
   570	            "to the bound cannot be called unchanged, because it may be a "
   571	            "rollback from the very entry the read missed. Note what is NOT done "
   572	            "— the file is not refused. Refusing would make an ordinary crash a "
   573	            "permanent incident, and it claims a protection this location cannot "
   574	            "deliver anyway, since anyone able to corrupt a line can delete the "
   575	            "journal instead and be met with trust on first use."
   576	        ),
   577	        entries=(bootstrap(), reset(90), entry(92), entry(91)),
   578	        transform=torn(92),
   579	        presented=head(91),
   580	    ),
   581	    JournalCase(
   582	        name="comparison-incomplete-a-bound-still-refuses-below-itself",
   583	        description=(
   584	            "What a bound CAN answer, which is the half a decline-only reading "
   585	            "would lose. The accepted head is at least 91, so a store presenting "
   586	            "89 is certainly below it and that is a rollback on any reading. The "
   587	            "bound is sound downward and unobtainable in both proceed directions: "
   588	            "nothing bounds the accepted head from ABOVE either, so a head above "
   589	            "the bound is not an advance — a lost entry may have sat at 200."
   590	        ),
   591	        entries=(bootstrap(), reset(90), entry(92), entry(91)),
   592	        transform=torn(92),
   593	        presented=head(89),
   594	    ),
   595	    JournalCase(
   596	        name="comparison-incomplete-a-headerless-journal-yields-a-bound",
   597	        description=(
   598	            "Readable entries with no header. This once refused the whole file; "
   599	            "it yields a BOUND instead, with the absence reported without a line "
   600	            "number because an absence does not have one. The entries are "
   601	            "self-describing evidence that heads were accepted, and what was lost "
   602	            "— the protocol and wire versions those record hashes derive under — "
   603	            "is exactly the kind of loss a lower bound is for. Refusing here would "
   604	            "be a verdict where a bound will do."
   605	        ),
   606	        entries=(bootstrap(), entry(6)),
   607	        transform=drop_header,
   608	        presented=head(6),
   609	    ),
   610	    JournalCase(
   611	        name="comparison-incomplete-nothing-readable-declines-every-comparison",
   612	        description=(
   613	            "The third state, and it is not the absence of one. This journal was "
   614	            "written entirely by a later build — its own header, its own entries "
   615	            "— so no attacker is involved, only version skew. Content was claimed "
   616	            "and none of it could be read, which says heads WERE accepted here and "
   617	            "their ordinals are precisely what was lost. There is no bound, so "
   618	            "unlike an incomplete read this cannot even answer rollback: every "
   619	            "comparison declines. Collapsing this into first contact would grant "
   620	            "trust on first use PRECISELY BECAUSE the journal became unreadable."
   621	        ),
