[project]
name = "strange-loops"
version = "0.11.0"
description = "A system for focusing attention"
readme = "README.md"
license = "MIT"
authors = [{ name = "Kyle Gruel", email = "kylegruel@gmail.com" }]
requires-python = ">=3.11"
# This is a FLAT vendored build: hatchling bundles every libs/*/src into one
# wheel (see [tool.hatch.build] below), so this list must mirror the UNION of
# all vendored libs' third-party deps by hand — the root does not depend on the
# workspace members, it inlines their source. A dep added to a lib's pyproject
# (e.g. engine's rfc8785, added with the JCS migration) is invisible to
# `uv tool install .` until it is also added here. `uv run --package` masks the
# gap because it resolves the workspace env, not this flat wheel.
dependencies = [
    "painted>=0.12.1,<0.14",
    "ckdl>=1.0",
    "pyjwt[crypto]>=2.9",
    "cryptography>=43",
    "python-ulid>=3.0",
    "rfc8785>=0.1.4",  # engine._canonical_bytes (JCS, RFC 8785)
    # python-ulid 3.1.0 imports typing_extensions unconditionally but doesn't
    # declare it. Pinning here until upstream (mdomke/python-ulid) fixes the
    # metadata. Drop when that ships.
    "typing_extensions>=4.0",
]

[project.scripts]
sl = "loops.main:main"
loops = "loops.main:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build]
only-include = [
    "libs/atoms/src/atoms",
    "libs/custody/src/custody",
    "libs/engine/src/engine",
    "libs/lang/src/lang",
    "libs/sdk/src/sdk",
    "libs/sign/src/sign",
    "libs/store/src/store",
    "apps/loops/src/loops",
    "README.md",
    "LICENSE",
]

[tool.hatch.build.targets.wheel]
packages = [
    "libs/atoms/src/atoms",
    "libs/custody/src/custody",
    "libs/engine/src/engine",
    "libs/lang/src/lang",
    "libs/sdk/src/sdk",
    "libs/sign/src/sign",
    "libs/store/src/store",
    "apps/loops/src/loops",
]

# The root runs the tests that belong to no single package — the architecture
# ratchets and tests/chaos — so it needs the same dev tooling every member
# already declares. Without this, `uv run pytest` at the root resolves only the
# flat wheel's runtime deps and dies with "Failed to spawn: pytest" on any
# machine whose .venv was not already dirty from an earlier run. uv.lock is
# gitignored, so CI resolves fresh every time and hit exactly that.
[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=6.0",
    "ruff>=0.8",
]

[tool.uv.workspace]
members = [
    "libs/atoms",
    "libs/custody",
    "libs/engine",
    "libs/lang",
    "libs/sdk",
    "libs/sign",
    "libs/store",
    "apps/loops",
]
[project]
name = "engine"
version = "0.1.0"
