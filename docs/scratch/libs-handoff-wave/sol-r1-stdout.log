    76	@dataclass(frozen=True)
    77	class TickAttestation:
    78	    """Persisted chain/signature state of the COMMITTED tick row.
    79	
    80	    Read back from the tick row the store committed when the boundary
    81	    fired — never inferred from whether a tick signer was wired.
    82	
    83	    - ``signed`` / ``signature_present`` — the committed row carries an
    84	      Ed25519 signature over its commitment hash (same coincidence note
    85	      as :class:`FactAttestation`).
    86	    - ``chained`` — the row carries the chain fields (``window_hash``
    87	      et al.); ``False`` marks a pre-chain-era row.
    88	    """
    89	
    90	    signed: bool
    91	    signature_present: bool
    92	    chained: bool
    93	
