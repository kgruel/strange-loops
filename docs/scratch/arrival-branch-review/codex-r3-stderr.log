   362	def test_the_arrival_surface_never_names_the_denied_vocabulary():
   363	    found: list[str] = []
   364	    for path in _files():
   365	        rel = str(path.relative_to(REPO_ROOT))
   366	        found.extend(_faults(path.read_text(), rel))
   367	
   368	    assert not found, (
   369	        "The arrival surface names vocabulary the arrival model retired "
   370	        "(decision:design/arrival-slice0-record-grammar §4.2). Rename to the "
   371	        "ratified glossary; do not add an allowlist entry unless the term is "
   372	        "genuinely unavoidable at that site:\n  " + "\n  ".join(sorted(found))
   373	    )
