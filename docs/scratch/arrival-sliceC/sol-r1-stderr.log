    36	def _single_member_vertex(tmp_path: Path, monkeypatch) -> tuple[Path, Path]:
    37	    """A combine-of-ONE aggregate — the shape the old rowid sort served."""
    38	    home = tmp_path / "loops_home"
    39	    solo_dir = home / "solo"
    40	    solo_dir.mkdir(parents=True)
    41	    (solo_dir / "solo.vertex").write_text(
    42	        'name "solo"\nstore "./store.db"\n'
    43	        'loops {\n  decision { fold { items "collect" 10 } }\n}\n'
    44	    )
    45	    combine = tmp_path / "combined.vertex"
    46	    combine.write_text(
    47	        'name "combined"\ncombine {\n    vertex "solo"\n}\n'
    48	        'loops {\n  decision { fold { items "collect" 10 } }\n}\n'
    49	    )
    50	    monkeypatch.setenv("LOOPS_HOME", str(home))
    51	    return combine, solo_dir / "store.db"
    52	
