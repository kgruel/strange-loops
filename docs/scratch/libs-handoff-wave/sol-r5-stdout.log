   643	class TestScannerProvableDomain:
   644	    """SOL-R4-01 arbiter ruling: end the lexical arms race with refusal.
   645	
   646	    KDL raw strings (``#"…"#`` / ``##"…"##``) are outside the quote-aware
   647	    scanner's PROVABLE DOMAIN. Mutations over vertex text containing
   648	    raw-string syntax must REFUSE with a typed, actionable ValueError —
   649	    never succeed with silent lexical loss.
   650	    """
   651	
   652	    # Sol's r4 repro 1: a raw string hides the same-line `task` sibling
   653	    # from _loops_block_child_names; with a second identical `task` later,
   654	    # edit/remove succeeded while the physical count fell 2 -> 1.
   655	    DUP_HIDDEN_BY_RAW = (
   656	        'name "t"\n'
   657	        "loops {\n"
   658	        '  decision { boundary after=1 { run #"echo " quoted"# } }; '
   659	        'task { fold { items "by" "name" } }\n'
   660	        '  task { fold { items "by" "name" } }\n'
   661	        "}\n"
   662	    )
   663	
