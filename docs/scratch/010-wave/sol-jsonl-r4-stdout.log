    19	def observer(args: argparse.Namespace | None = None) -> str:
    20	    """Resolve observer: --observer flag → STRANGE_LOOPS_OBSERVER → LOOPS_OBSERVER → ""."""
    21	    if args is not None:
    22	        flag = getattr(args, "observer", None)
    23	        if flag:
    24	            return flag
    25	    return os.environ.get("STRANGE_LOOPS_OBSERVER", os.environ.get("LOOPS_OBSERVER", ""))
