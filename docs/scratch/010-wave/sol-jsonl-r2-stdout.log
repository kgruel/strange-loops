   403	def test_duplicate_line_in_log_does_not_brick_reopen(tmp_path):
   404	    """Even a hand-corrupted log must leave the store openable.
   405	
   406	    The old failure mode: a rebuild raised from __init__ with DELETE FROM
   407	    facts uncommitted on a leaked connection, so every later open failed
   408	    with 'database is locked' — one bad open bricked the store forever.
   409	    """
   410	    import sqlite3
   411	
   412	    store = open_store(tmp_path)
   413	    log = log_path_for(store._path)
   414	    store.append(fact(message="one"))
   415	    store.close()
   416	
   417	    with log.open("a", encoding="utf-8") as fh:  # duplicate the only line
   418	        fh.write(lines(log)[0] + "\n")
   419	    conn = sqlite3.connect(str(tmp_path / "s.db"))
   420	    conn.execute("DELETE FROM store_meta WHERE key = 'jsonl_offset'")
   421	    conn.commit()
   422	    conn.close()
   423	
   424	    with pytest.raises(sqlite3.IntegrityError):
   425	        open_store(tmp_path)
   426	    # the db is not locked: a second attempt fails the same way, not worse
   427	    with pytest.raises(sqlite3.IntegrityError):
   428	        open_store(tmp_path)
