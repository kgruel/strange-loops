   217	        return join_horizontal(prefix, name_block, status_block)
   218	    elif status:
   219	        status_block = Block.text(status, _tick_status_style(status))
   220	        return join_horizontal(prefix, status_block)
   221	    else:
   222	        # Fallback for ticks without task/status payload
   223	        parts = [f"{k}={v}" for k, v in payload.items() if v is not None and v != ""]
   224	        summary = " ".join(parts) if parts else tick.get("name", "")
   225	        return join_horizontal(prefix, Block.text(summary, p.accent))
   226	
   227	
   228	def filter_task_ticks(ticks: list[dict], name: str) -> list[dict]:
   229	    """Filter tick dicts belonging to a specific task.
   230	
   231	    Matches payload["task"] == name.
   232	    """
   233	    result = []
   234	    for t in ticks:
   235	        payload = t.get("payload", {}) if isinstance(t.get("payload"), dict) else {}
   236	        if payload.get("task") == name:
   237	            result.append(t)
   238	    return result
