    "post_merge_ids": [
      "01COLLISION0000000000000001"
    ],
    "post_merge_facts": [
      [
        "01COLLISION0000000000000001",
        {
          "kind": "config",
          "ts": 100.0,
          "payload": {
            "setting": "mode",
            "val": "target_active"
          },
          "observer": "alice",
          "origin": ""
        }
      ]
    ]
  }
