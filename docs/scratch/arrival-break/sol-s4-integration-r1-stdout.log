   103	class MigrationRefused(Exception):
   104	    """Root exception for migration sidecar refusals.
   105	
   106	    Asserts conditions in a legacy source or staging pipeline that prevent
   107	    deterministic transformation and publication of an Arrival lineage.
   108	    """
   109	
   110	
   111	class LegacySourceRefused(MigrationRefused):
   112	    """Source contains defects (codec-invalid, mixed-observer, or absent-observer lines).
   113	
   114	    Carries structured data across all three enumerated legacy defect classes.
   115	    """
   116	
   117	    def __init__(
   118	        self,
   119	        *,
   120	        codec_invalid_lines: tuple[tuple[int, str], ...] | list[tuple[int, str]] = (),
   121	        mixed_observer_lines: (
   122	            tuple[tuple[int, tuple[str, ...], int], ...]
   123	            | list[tuple[int, tuple[str, ...], int]]
   124	        ) = (),
   125	        absent_observer_lines: (
   126	            tuple[tuple[int, int, tuple[str, ...], dict[str, int]], ...]
   127	            | list[tuple[int, int, tuple[str, ...], dict[str, int]]]
   128	        ) = (),
   129	        source: str | None = None,
   130	    ) -> None:
   131	        self.source = source
   132	        self.codec_invalid_lines: tuple[tuple[int, str], ...] = tuple(
   133	            (int(lineno), str(msg)) for lineno, msg in codec_invalid_lines
   134	        )
   135	        self.mixed_observer_lines: tuple[tuple[int, tuple[str, ...], int], ...] = tuple(
   136	            (int(lineno), tuple(str(o) for o in observers), int(absent_count))
   137	            for lineno, observers, absent_count in mixed_observer_lines
   138	        )
   139	        self.absent_observer_lines: tuple[
   140	            tuple[int, int, tuple[str, ...], dict[str, int]], ...
   141	        ] = tuple(
   142	            (
   143	                int(lineno),
   144	                int(absent_count),
   145	                tuple(str(o) for o in observers),
   146	                dict(spellings),
   147	            )
   148	            for lineno, absent_count, observers, spellings in absent_observer_lines
   149	        )
   150	        message = _format_refusal_message(
   151	            source=self.source,
   152	            codec_invalid_lines=self.codec_invalid_lines,
   153	            mixed_observer_lines=self.mixed_observer_lines,
   154	            absent_observer_lines=self.absent_observer_lines,
   155	        )
   156	        super().__init__(message)
   157	
