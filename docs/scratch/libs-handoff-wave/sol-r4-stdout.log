   409	def _log_content_note(path: Path) -> str:
   410	    """Corroborate a ``.jsonl`` suffix against its first complete line."""
   411	    try:
   412	        with path.open("rb") as fh:
   413	            raw = fh.readline()
   414	    except OSError as exc:
   415	        return f"; content unreadable: {exc}"
   416	    if not raw.strip():
   417	        return ""
   418	    if not raw.endswith(b"\n"):
   419	        return "; first line incomplete (torn or still being written)"
   420	    from .jsonl_codec import JsonlCodecError, deserialize_records
   421	
   422	    try:
   423	        deserialize_records(raw[:-1].decode("utf-8").strip())
   424	    except (JsonlCodecError, UnicodeError):
   425	        return "; content does not decode as loops log rows"
   426	    return ""
