     1	"""Residence ratchet — every tasks-vertex read must name its store.
     2	
     3	friction:tasks-read-write-residence-split. The tasks vertex is *packaged*
     4	(it ships inside the installed strange-loops package) while its store is
     5	*workspace-relative* (named by the cwd). So a reader that resolves the store
     6	from the vertex path silently reads the packaged-adjacent store instead of
     7	the workspace one the writers appended to. The fix at each call site is to
     8	pass ``store=workspace_store(vp)``.
     9	
    10	That fix has been missed twice (b7d44c0, then 88fe23b). Per CLAUDE.md's
    11	ratchet test, the durable form is structural, not review vigilance: enumerate
    12	every ``engine.vertex_*`` call in ``apps/tasks`` and require ``store=``,
    13	with a shrink-only allowlist for the sites that are legitimately
    14	package-relative on *both* sides (the ``project`` vertex, whose writers use
    15	``store_path_for("project")``).
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import ast
    21	from pathlib import Path
    22	
    23	_SRC = Path(__file__).resolve().parents[1] / "src" / "strange_loops"
    24	
    25	# Readers that resolve a store from the vertex path unless told otherwise.
    26	_READERS = {"vertex_facts", "vertex_ticks", "vertex_summary", "vertex_read"}
    27	
    28	# Shrink-only allowlist: (module path relative to _SRC, enclosing function,
    29	# callee) -> why this site may omit ``store=``. Entries may be removed, never
    30	# added without a reviewed reason — and a stale entry fails the second test.
    31	_PACKAGE_RELATIVE: dict[tuple[str, str, str], str] = {
    32	    ("commands/dashboard.py", "_project_summary", "vertex_summary"): (
    33	        "project vertex — writers use store_path_for('project'), package-relative on both sides"
    34	    ),
    35	    ("commands/project.py", "fetch_project_status", "vertex_read"): "project vertex",
    36	    ("commands/project.py", "fetch_project_status", "vertex_summary"): "project vertex",
    37	    ("commands/project.py", "fetch_project_log", "vertex_facts"): "project vertex",
    38	    ("commands/project.py", "cmd_project_bridge", "vertex_facts"): (
    39	        "reads the project vertex (the bridge's tasks-vertex read passes store=)"
    40	    ),
    41	}
    42	
    43	
    44	def _call_sites() -> list[tuple[tuple[str, str, str], int, bool]]:
    45	    """Every _READERS call under apps/tasks/src as (key, lineno, has_store)."""
    46	    sites: list[tuple[tuple[str, str, str], int, bool]] = []
    47	    for path in sorted(_SRC.rglob("*.py")):
    48	        rel = path.relative_to(_SRC).as_posix()
    49	        tree = ast.parse(path.read_text())
    50	        for node in ast.walk(tree):
    51	            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
    52	                continue
    53	            for call in ast.walk(node):
    54	                if not isinstance(call, ast.Call):
    55	                    continue
    56	                func = call.func
    57	                name = (
    58	                    func.id
    59	                    if isinstance(func, ast.Name)
    60	                    else func.attr
    61	                    if isinstance(func, ast.Attribute)
    62	                    else None
    63	                )
    64	                if name not in _READERS:
    65	                    continue
    66	                has_store = any(kw.arg == "store" for kw in call.keywords)
    67	                sites.append(((rel, node.name, name), call.lineno, has_store))
    68	    return sites
    69	
    70	
    71	def test_tasks_vertex_reads_name_their_store():
    72	    """Rule: no un-allowlisted vertex_* read may resolve its own store."""
    73	    sites = _call_sites()
    74	    assert sites, "the AST walk found no vertex_* calls — the ratchet went blind"
    75	
    76	    offenders = [
    77	        f"{rel}:{lineno} {func}() -> {callee}(...) without store="
    78	        for (rel, func, callee), lineno, has_store in sites
    79	        if not has_store and (rel, func, callee) not in _PACKAGE_RELATIVE
    80	    ]
    81	    assert not offenders, (
    82	        "tasks-vertex reads must pass store=workspace_store(vp) — the vertex is "
    83	        "packaged, the store is workspace-relative (friction:tasks-read-write-"
    84	        "residence-split):\n  " + "\n  ".join(offenders)
    85	    )
    86	
    87	
    88	def test_residence_allowlist_is_shrink_only():
    89	    """Every allowlist entry must still name a real store-less call site."""
    90	    live = {key for key, _lineno, has_store in _call_sites() if not has_store}
    91	    stale = sorted(key for key in _PACKAGE_RELATIVE if key not in live)
    92	    assert not stale, (
    93	        "stale residence allowlist entries — the call site moved, was renamed, "
    94	        "or already passes store=. Remove them; the allowlist only shrinks:\n  "
    95	        + "\n  ".join(str(k) for k in stale)
    96	    )
