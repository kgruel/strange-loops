        append_legacy(log_path, "one")
        opened(log_path)
        lineage = lineage_of(log_path)
        append_entry_for_damage(lineage)
        damage_a_line(lineage, "damage-me")
        before = journal_bytes(lineage)
    
        append_legacy(log_path, "two", "three")
