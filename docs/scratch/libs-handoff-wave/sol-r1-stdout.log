     1	"""Observer name matching with namespace support.
     2	
     3	Observer names can be bare (``loops-claude``) or namespaced
     4	(``kyle/loops-claude``).  Namespaced names encode a delegation
     5	relationship: ``principal/agent``.
     6	
     7	Matching rules (flat phase — no hierarchical walk):
     8	
     9	- Exact match always succeeds.
    10	- If one side is bare and the other namespaced, match the bare name
    11	  against the namespaced name's leaf (agent part).
    12	- If both sides are namespaced, require exact match.
    13	
    14	This keeps backward compatibility: bare names work everywhere they
    15	did before.  Namespaced names participate transparently.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	
    21	def observer_leaf(name: str) -> str:
    22	    """Extract the leaf (agent) part of an observer name.
    23	
    24	    ``kyle/loops-claude`` → ``loops-claude``
    25	    ``loops-claude`` → ``loops-claude``
    26	    """
    27	    if "/" in name:
    28	        return name.rsplit("/", 1)[1]
    29	    return name
    30	
    31	
    32	def observer_matches(a: str, b: str) -> bool:
    33	    """Check whether two observer names refer to the same agent.
    34	
    35	    Supports namespaced names: ``kyle/loops-claude`` matches
    36	    ``loops-claude`` (bare declaration).  Both bare → exact match.
    37	    Both namespaced → exact match only.
    38	    """
    39	    if a == b:
    40	        return True
    41	    a_ns = "/" in a
    42	    b_ns = "/" in b
    43	    if a_ns and not b_ns:
    44	        return a.rsplit("/", 1)[1] == b
    45	    if b_ns and not a_ns:
    46	        return b.rsplit("/", 1)[1] == a
    47	    # Both namespaced but different full names
    48	    return False
