    86	__all__ = ["EXPORT_CODEC", "FileLedger", "FileQuery"]
    87	
    88	# The one wire codec this backend exports and imports. Named after the grammar
    89	# it is, and versioned separately from `GRAMMAR_VERSION` on purpose: the codec
    90	# is what an export FILE claims about its own framing, and a future codec that
    91	# packed the same records differently would leave the record grammar alone.
    92	EXPORT_CODEC = "arrival-jsonl-v1"
    93	
    94	# How the codec frames one record. A manifest field rather than a convention,
    95	# because "each element is one record's line INCLUDING its newline" is what
    96	# makes ``b"".join(prefix.records)`` byte-identical to the log's own prefix —
    97	# a property a reader can only rely on if the export states it.
    98	_FRAMING = "newline-terminated"
    99	
   100	
   101	# What an append has established before it reports success. The mechanism is
   102	# named because the profile alone does not tell an operator what to check:
   103	# §05's callout is explicit that this contract is LOCAL POSIX storage, and
   104	# that moving the same bytes onto NFS does not inherit it.
   105	_DURABILITY = DurabilityReceipt(
   106	    profile=DurabilityProfile.HOST,
   107	    mechanism="advisory flock, one write, one fsync, on local POSIX storage",
   108	)
   109	
   110	
   111	def _decoded(prefix: ExportedPrefix) -> list[dict]:
   112	    """The export's records, decoded and held to the grammar.
   113	
   114	    :func:`engine.arrival.decode_record` is the gate, so a record whose ``rh``
   115	    does not recompute never reaches the import — the bytes travelled, and
   116	    anything that travelled has to be re-established rather than assumed.
   117	
   118	    Framing is read from the manifest and ENFORCED: a codec that says its
   119	    elements are newline-terminated and hands over one that is not has
   120	    contradicted itself, and quietly accepting either shape would make
   121	    ``b"".join(records)`` mean two different things.
   122	    """
   123	    framing = prefix.manifest.get("framing")
   124	    if framing != _FRAMING:
   125	        raise ValueError(
   126	            f"this backend reads {_FRAMING!r} framing and nothing else, but "
   127	            f"this export's manifest claims {framing!r}"
   128	        )
   129	    records: list[dict] = []
   130	    for index, line in enumerate(prefix.records):
   131	        if not line.endswith(b"\n"):
   132	            raise ArrivalCorrupt(
   133	                f"element {index} carries no newline, but the manifest claims "
   134	                f"{_FRAMING!r} framing",
   135	                index,
   136	            )
   137	        records.append(decode_record(line[:-1]))
   138	    return records
   139	
   140	
   141	def _refuse_disagreeing_manifest(
   142	    prefix: ExportedPrefix, imported: Sequence[Mapping[str, Any]]
   143	) -> None:
   144	    """Re-derive every manifest claim from the records and compare.
   145	
   146	    A manifest travels with the bytes it describes, so it is exactly as
   147	    trustworthy as they are: checking it is the only thing that makes carrying
   148	    one worth doing. Each claim is re-derived rather than sampled — a count
   149	    that matched while the head did not would still be a corrupt export.
   150	
   151	    Density is what makes this cheap: the prefix runs from ordinal 0 to the
   152	    captured head with nothing missing, so ``count`` is arithmetic and the
   153	    starting ordinal is a constant.
   154	    """
   155	    if not imported:
   156	        raise ArrivalCorrupt(
   157	            "this export holds no records — a prefix runs from genesis, so "
   158	            "the smallest honest export is one record",
   159	            0,
   160	        )
   161	    if prefix.manifest.get("protocol") != GRAMMAR_VERSION:
   162	        raise ArrivalCorrupt(
   163	            f"this export claims protocol {prefix.manifest.get('protocol')!r}, "
   164	            f"but this backend reads grammar {GRAMMAR_VERSION}",
   165	            0,
   166	        )
   167	    if imported[0]["ord"] != 0:
   168	        raise ArrivalCorrupt(
   169	            f"this export starts at ordinal {imported[0]['ord']}, not 0 — a "
   170	            "prefix that does not start at genesis is a suffix, and importing "
   171	            "one is replication, not import",
   172	            imported[0]["ord"],
   173	        )
   174	    last = imported[-1]
   175	    derived = Head(
   176	        lineage=last["lin"], ordinal=last["ord"], record_hash=last["rh"]
   177	    )
   178	    if derived != prefix.head:
   179	        raise ArrivalCorrupt(
   180	            f"this export's records end at {derived}, but it claims to capture "
   181	            f"{prefix.head}",
   182	            last["ord"],
   183	        )
   184	    claimed = (
   185	        prefix.manifest.get("lineage"),
   186	        prefix.manifest.get("through_ordinal"),
   187	        prefix.manifest.get("through_record_hash"),
   188	        prefix.manifest.get("count"),
   189	    )
   190	    if claimed != (derived.lineage, derived.ordinal, derived.record_hash, len(imported)):
   191	        raise ArrivalCorrupt(
   192	            f"this export's manifest claims {claimed}, but its records give "
   193	            f"{(derived.lineage, derived.ordinal, derived.record_hash, len(imported))}",
   194	            last["ord"],
   195	        )
   196	
   197	
   198	def _head_of(record: Mapping[str, Any]) -> Head:
   199	    """A record's coordinate as a contract :class:`Head`.
   200	
   201	    The one place the wire field names meet the neutral type. Keeping it to
   202	    one function is what lets the rest of this module talk in ``Head`` and
   203	    the log keep talking in records.
   204	    """
   205	    return Head(
   206	        lineage=record["lin"], ordinal=record["ord"], record_hash=record["rh"]
   207	    )
