   268	def _parse_vertex_or_raise(text: str, context: str):
   269	    """Parse vertex text, wrapping parser errors as a clear ValueError."""
   270	    from .loader import parse_vertex
   271	
   272	    try:
   273	        return parse_vertex(text)
