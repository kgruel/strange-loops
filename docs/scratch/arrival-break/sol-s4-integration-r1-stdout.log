   433	                    if observer is None or observer == "":
   434	                        spelling = "empty" if observer == "" else "missing"
   435	                        absent_observer_lines.append((rowid, 1, (), {spelling: 1}))
   436	                        continue
   437	
   438	                    if not isinstance(observer, str):
   439	                        codec_invalid_lines.append(
   440	                            (rowid, f"fact field 'observer' must be a string, got {type(observer).__name__}")
   441	                        )
   442	                        continue
