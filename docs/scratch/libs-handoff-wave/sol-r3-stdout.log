   105	
   106	def resolve_template(vertex: VertexFile, qualifier: str | None) -> TemplateSource:
   107	    """Find target template source.
   108	
   109	    Single template -> qualifier optional.
   110	    Multiple -> qualifier required, matched against .loop stem.
   111	    When no qualifier and multiple templates share a stem, prefers the
   112	    file-backed template (the growable population) over inline-only ones.
   113	    Raises ValueError with helpful message listing available templates.
   114	    """
   115	    templates = [
   116	        s for s in (vertex.sources or ()) if isinstance(s, TemplateSource)
   117	    ]
   118	
   119	    if not templates:
   120	        raise ValueError(f"Vertex '{vertex.name}' has no template sources")
   121	
   122	    if len(templates) == 1 and qualifier is None:
   123	        return templates[0]
   124	
   125	    if qualifier is not None:
   126	        matches = [t for t in templates if template_name(t) == qualifier]
   127	        if len(matches) == 1:
   128	            return matches[0]
   129	        if len(matches) > 1:
   130	            # Multiple templates with same stem — prefer file-backed
   131	            file_backed = [t for t in matches if t.from_ is not None]
   132	            if len(file_backed) == 1:
   133	                return file_backed[0]
   134	            raise ValueError(
   135	                f"Multiple templates named '{qualifier}' in vertex "
   136	                f"'{vertex.name}'. Cannot disambiguate."
   137	            )
   138	        names = [template_name(t) for t in templates]
   139	        raise ValueError(
   140	            f"No template '{qualifier}' in vertex '{vertex.name}'. "
   141	            f"Available: {', '.join(names)}"
   142	        )
   143	
   144	    # No qualifier — check for unique stems
   145	    names = [template_name(t) for t in templates]
   146	    unique_names = set(names)
   147	    if len(unique_names) == 1:
   148	        # All templates share same stem — prefer file-backed
   149	        file_backed = [t for t in templates if t.from_ is not None]
   150	        if len(file_backed) == 1:
   151	            return file_backed[0]
   152	
   153	    raise ValueError(
   154	        f"Vertex '{vertex.name}' has {len(templates)} templates: "
   155	        f"{', '.join(names)}. Specify one with vertex/template."
   156	    )
