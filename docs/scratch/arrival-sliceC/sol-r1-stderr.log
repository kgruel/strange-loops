    74	    def test_fact_replace_preserves_untouched_fields(self, fact: Fact, new_ts: float) -> None:
    75	        """Replacing a Fact field via __replace__ updates it while preserving untouched fields."""
    76	        replaced = fact.__replace__(ts=new_ts)
    77	        assert replaced.ts == new_ts
    78	        assert replaced.kind == fact.kind
    79	        assert replaced.payload == fact.payload
    80	        assert replaced.observer == fact.observer
    81	        assert replaced.origin == fact.origin
    82	
    83	    @settings(max_examples=200)
    84	    @given(fact=facts())
    85	    def test_fact_hash_equality_consistency(self, fact: Fact) -> None:
    86	        """Equal facts produce identical hash values and can be safely collected into sets."""
    87	        d = fact.to_dict()
    88	        twin = Fact.from_dict(d)
    89	        assert hash(fact) == hash(twin)
    90	        assert len({fact, twin}) == 1
    91	
