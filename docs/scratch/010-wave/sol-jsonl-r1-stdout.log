   166	def test_signing_era_survives_the_new_path(tmp_path):
   167	    """A signed fact appended through the JSONL path must verify: the
   168	    commitment is over the payload TEXT the log carries."""
   169	    signed: dict[str, str] = {}
   170	
   171	    def fact_signer(observer: str, commitment: str) -> str | None:
   172	        if observer != "kyle":
   173	            return None
   174	        signed[commitment] = f"sig::{commitment}"
   175	        return signed[commitment]
   176	
   177	    store = open_store(tmp_path, fact_signer=fact_signer)
   178	    fid = store.append(fact())
   179	    store.append(fact(observer="nokey"))
   180	    store.close()
   181	
   182	    rows = {r[0]: r for r in sqlite_facts(tmp_path / "s.db")}
   183	    row = rows[fid]
   184	    commitment = _fact_commitment_hash(row[1], row[2], row[3], row[4], row[5])
   185	    assert row[6] == f"sig::{commitment}"          # signed under the stored text
   186	    assert [r[6] for r in rows.values() if r[3] == "nokey"] == [None]
   187	
   188	    # …and the line re-derives the same commitment, so verification survives.
   189	    log_rows = [r for t, r in map(deserialize_row, lines(tmp_path / "s.jsonl"))]
   190	    line = [r for r in log_rows if r[0] == fid][0]
   191	    assert _fact_commitment_hash(line[1], line[2], line[3], line[4], line[5]) == commitment
   192	    assert line[6] == row[6]
