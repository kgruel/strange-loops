   323	        row_id = elem["id"]
   324	        if row_id in seen_ids:
   325	            raise JsonlCodecError(f"duplicate id {row_id!r} within one batch")
   326	        seen_ids.add(row_id)
   327	
   328	
   329	def _row_of(obj: dict, spec: _Spec) -> tuple:
   330	    """A VALIDATED record object as its full-arity row tuple."""

