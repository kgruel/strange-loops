  1017	                lineage = record["lin"]
  1018	            elif record["lin"] != lineage:
  1019	                raise ArrivalCorrupt(
  1020	                    f"record claims lineage {record['lin']!r}, "
  1021	                    f"but this log's lineage is {lineage!r}",
  1022	                    expected,
  1023	                )
