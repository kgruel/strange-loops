   586	def test_post_fsync_failure_leaves_the_line_recoverable_on_the_same_handle(tmp_path):
   587	    """An append must never stamp the offset past an unindexed durable line.
   588	
   589	    The sqlite write can fail *after* the log line is fsynced (the stamp,
   590	    the commit, a disk error, the process dying). The line is durable and
   591	    the offset unstamped — recoverable. But a long-lived handle keeps
   592	    appending, and if it stamped the new offset it would bury the orphan
   593	    while every later open reported "synced". Three appends, the middle
   594	    one's index write failing: all three must survive with stable ids.
   595	    """
   596	    store = open_store(tmp_path)
   597	    first = store.append(fact(message="one"))
   598	
   599	    real_stamp = store._stamp
   600	    calls = {"n": 0}
   601	
   602	    def failing_stamp(*args):
   603	        calls["n"] += 1
   604	        raise RuntimeError("simulated sqlite failure after fsync")
   605	
   606	    store._stamp = failing_stamp
   607	    with pytest.raises(RuntimeError):
   608	        store.append(fact(message="two"))
   609	    store._stamp = real_stamp
   610	    assert calls["n"] == 1
   611	
   612	    # The line is durable; the index and the offset never saw it.
   613	    assert len(lines(tmp_path / "s.jsonl")) == 2
   614	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")] == [first]
   615	    assert offset_of(store) < (tmp_path / "s.jsonl").stat().st_size
   616	
   617	    # Same handle, next append: reconcile picks the orphan up first.
   618	    third = store.append(fact(message="three"))
   619	    store.close()
   620	
   621	    log_ids = [deserialize_row(ln)[1][0] for ln in lines(tmp_path / "s.jsonl")]
   622	    assert len(log_ids) == 3
   623	    assert log_ids[0] == first and log_ids[2] == third
   624	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")] == log_ids
   625	
   626	    reopened = open_store(tmp_path)
   627	    assert reopened.catch_up() == "synced"
   628	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")] == log_ids
   629	    reopened.close()
