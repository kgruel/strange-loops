  1037	            expected += 1
  1038	            prev = record[_RH]
  1039	
  1040	    def read(self, ordinal: int) -> dict:
  1041	        """The record at ``ordinal``, reached by a verified walk.
  1042	
  1043	        The walk is the only way in on purpose: reading a coordinate means
  1044	        having established that everything before it is intact, because a
  1045	        record whose predecessors do not chain is not at the coordinate it
  1046	        claims.
  1047	        """
  1048	        if not _is_int(ordinal) or ordinal < 0:
  1049	            raise ArrivalError(f"ordinal must be an integer >= 0, got {ordinal!r}")
