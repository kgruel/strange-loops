   140	def _scan_targets() -> list:
   141	    """Every shipped-prose file this rule judges.
   142	
   143	    Derived from the filesystem, never hand-enumerated (docs/RATCHETS.md): a
   144	    hand-written list is a silent pass for every lib, app, and doc added after
   145	    it was written.
   146	    """
   147	    targets: list = []
   148	    for production in ("libs", "apps"):
   149	        base = REPO_ROOT / production
   150	        if not base.is_dir():
   151	            continue
   152	        for package in sorted(base.iterdir()):
   153	            src = package / "src"
   154	            if src.is_dir():
   155	                targets.extend(src.rglob("*.py"))
   156	    for docs_root in ("spec", "docs"):
   157	        base = REPO_ROOT / docs_root
   158	        if base.is_dir():
   159	            targets.extend(base.rglob("*.md"))
   160	    # Conformance generators: their CASE descriptions are copied verbatim into
   161	    # the vectors, which are normative artifacts other implementations read.
   162	    generators = REPO_ROOT / "spec" / "conformance"
   163	    if generators.is_dir():
   164	        targets.extend(sorted(generators.glob("generate_*.py")))
   165	    tracked = _tracked_files()
   166	    kept: list = []
   167	    for p in sorted(set(targets)):
   168	        if {"mutants", "__pycache__", ".venv"} & set(p.parts):
   169	            continue
   170	        rel = p.relative_to(REPO_ROOT).as_posix()
   171	        if rel not in tracked or rel.startswith("docs/scratch/"):
   172	            continue
   173	        kept.append(p)
   174	    return kept
