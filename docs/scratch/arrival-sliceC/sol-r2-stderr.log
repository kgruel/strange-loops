   209	        reader, agreed = _ensure_reader(canonical, index_path)
   210	        try:
   211	            fact_total, tick_total, latest_ts, kinds, signed_counts = _compute_summary_stats(
   212	                reader, include_internal=include_internal
   213	            )
   214	            unfolded = [
   215	                k
   216	                for k in kinds
   217	                if decl_ast is not None and k not in decl_ast.loops and not k.startswith("_decl.")
   218	            ]
   219	            # signed_counts is (signed, TOTAL) — unsigned is the difference
   220	            signed_count = signed_counts[0] if signed_counts else 0
   221	            unsigned_count = (signed_counts[1] - signed_counts[0]) if signed_counts else 0
   222	
   223	            return ReadSummary(
   224	                target_type="vertex",
   225	                target_path=str(target_path),
   226	                canonical_mode=info.canonical_mode or "unknown",
   227	                canonical_path=str(canonical),
   228	                index_path=str(index_path),
   229	                declaration_status=decl_status or "unknown",
   230	                fact_total=fact_total,
   231	                tick_total=tick_total,
   232	                latest_ts=latest_ts,
   233	                kinds=kinds,
   234	                unfolded_kinds=unfolded,
   235	                agreement=agreed,
   236	                signed_count=signed_count,
   237	                unsigned_count=unsigned_count,
   238	            )
   239	        finally:
   240	            reader.close()
   241	
   242	    # Bare store (.jsonl or .db)
   243	    canonical = info.canonical_path or target_path
   244	    index_path = info.index_path or canonical
   245	    reader, agreed = _ensure_reader(canonical, index_path)
   246	    try:
   247	        fact_total, tick_total, latest_ts, kinds, signed_counts = _compute_summary_stats(
   248	            reader, include_internal=include_internal
   249	        )
   250	        # signed_counts is (signed, TOTAL) — unsigned is the difference
   251	        signed_count = signed_counts[0] if signed_counts else 0
   252	        unsigned_count = (signed_counts[1] - signed_counts[0]) if signed_counts else 0
   253	
   254	        return ReadSummary(
   255	            target_type=info.target_type,
   256	            target_path=str(target_path),
   257	            canonical_mode=info.canonical_mode or "unknown",
   258	            canonical_path=str(canonical),
   259	            index_path=str(index_path),
   260	            declaration_status=None,
   261	            fact_total=fact_total,
   262	            tick_total=tick_total,
   263	            latest_ts=latest_ts,
   264	            kinds=kinds,
   265	            unfolded_kinds=[],
   266	            agreement=agreed,
   267	            signed_count=signed_count,
   268	            unsigned_count=unsigned_count,
   269	        )
   270	    finally:
   271	        reader.close()
