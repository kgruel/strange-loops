    78	def parse_duration(s: str) -> float:
    79	    """Parse duration string like '7d', '24h', '1h' to seconds."""
    80	    m = re.match(r"^(\d+)([dhms])$", s)
    81	    if not m:
    82	        raise ValueError(f"Invalid duration: {s!r} (expected e.g. '7d', '24h', '1h')")
    83	    value = int(m.group(1))
    84	    unit = m.group(2)
    85	    multipliers = {"d": 86400, "h": 3600, "m": 60, "s": 1}
    86	    return value * multipliers[unit]
