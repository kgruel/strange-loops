   228	class ConflictingFoldSpec(Exception):
   229	    """Two source vertices declare the same kind with different fold specs."""
   230	
   231	    def __init__(self, kind: str, source_a: str, source_b: str) -> None:
   232	        self.kind = kind
   233	        super().__init__(
   234	            f"Conflicting fold spec for '{kind}' from '{source_a}' and '{source_b}'. "
   235	            f"Add an explicit '{kind}' declaration to the aggregation vertex to resolve."
   236	        )
   237	
   238	
   239	def _specs_match(a: Any, b: Any) -> bool:
   240	    """Check if two Specs have equivalent fold declarations.
   241	
   242	    Compares fold ops (type + parameters) — the part that determines
   243	    how facts accumulate. Ignores name/about metadata.
   244	    """
   245	    if len(a.folds) != len(b.folds):
   246	        return False
   247	    for fa, fb in zip(a.folds, b.folds):
   248	        if type(fa) is not type(fb):
   249	            return False
   250	        # Compare fold-relevant attributes (key for Upsert, limit for Collect)
   251	        if hasattr(fa, "key") and fa.key != fb.key:
   252	            return False
   253	        if hasattr(fa, "limit") and fa.limit != fb.limit:
   254	            return False
   255	    return True
   256	
   257	
   258	def _collect_source_specs(
   259	    ast: Any,
   260	    vertex_path: Path,
   261	    *,
   262	    override_kinds: frozenset[str] = frozenset(),
   263	    as_of: float | None = None,
   264	) -> dict:
   265	    """Collect fold specs from all source vertices, erroring on conflicts.
   266	
   267	    Union semantics: all source kinds are included. When two sources
   268	    declare the same kind with matching fold specs, it passes through.
   269	    When they conflict (same kind, different fold), raises
   270	    ConflictingFoldSpec — the aggregation vertex must explicitly declare
   271	    an override to resolve.
   272	
   273	    Kinds in *override_kinds* are skipped during conflict detection —
   274	    the aggregation vertex's own declaration will take precedence.
   275	
   276	    ``as_of`` resolves each MEMBER declaration at the same event-time cutoff
   277	    (equal-cursor semantics, review finding 6): an aggregate without its own
   278	    loops replays ``ts<=T`` member facts, and those must fold under the member
   279	    ontology in force AT T — not head, which could carry a fold-key rename
   280	    introduced after T. (Membership itself stays current — the disclosed
   281	    aggregate-head derogation; only the ontology rides the cutoff.)
   282	    """
   283	    from lang import resolve_vertex
   284	
   285	    from .compiler import compile_vertex
   286	
   287	    merged: dict = {}
   288	    # Track which source each kind came from (for error messages)
   289	    source_of: dict[str, str] = {}
   290	
   291	    def _merge_from(ref_ast: Any, source_name: str) -> None:
   292	        if not ref_ast.loops:
   293	            return
   294	        source_specs = compile_vertex(ref_ast)
   295	        for kind, spec in source_specs.items():
   296	            if kind in merged:
   297	                if kind in override_kinds:
   298	                    pass  # Aggregation will override — skip conflict check
   299	                elif not _specs_match(merged[kind], spec):
   300	                    raise ConflictingFoldSpec(kind, source_of[kind], source_name)
   301	                # Matching specs or overridden — keep existing
   302	            else:
   303	                merged[kind] = spec
   304	                source_of[kind] = source_name
   305	
   306	    if ast.combine is not None:
   307	        home = _loops_home()
   308	        for entry in ast.combine:
   309	            vpath = resolve_vertex(entry.name, home)
   310	            if not vpath.is_absolute():
   311	                vpath = (vertex_path.parent / vpath).resolve()
   312	            if not vpath.exists():
   313	                continue
   314	            try:
   315	                ref_ast = load_declaration(vpath, as_of=as_of)
   316	            except Exception:
   317	                continue
   318	            _merge_from(ref_ast, entry.name)
   319	
   320	    elif ast.discover is not None:
   321	        base_dir = vertex_path.parent
   322	        for match in sorted(base_dir.glob(ast.discover)):
   323	            if match.suffix != ".vertex" or match.resolve() == vertex_path.resolve():
   324	                continue
   325	            try:
   326	                ref_ast = load_declaration(match, as_of=as_of)
   327	            except Exception:
   328	                continue
   329	            _merge_from(ref_ast, match.stem)
   330	
   331	    return merged
   332	
