  1302	    def append_tick(self, tick: Tick, *, enforce_floor: bool = True) -> None:
  1303	        """Append a tick to the ticks table, extending the hash chain.
  1304	
  1305	        ``enforce_floor`` (the tick-signing floor, decision design/tick-signing
  1306	        -era-is-a-floor) is ON BY DEFAULT: when no signature was produced AND
  1307	        the store is already in the signed era, refuse — raise
  1308	        ``UnsignedTickInSignedEra`` BEFORE writing, so no unsigned tick is
  1309	        appended and the chain's era-monotonicity holds. Default-on makes the
  1310	        invariant fail-safe: every live mint (each verb that fires a boundary —
  1311	        ``sl seal``, ``sl emit <v> seal``, count/predicate boundaries — and any
  1312	        other live caller such as the tasks harness) is protected without
  1313	        opting in. Only re-mint paths that reconstruct history under their own
  1314	        signer wiring (rebirth/slice/replay) pass ``enforce_floor=False`` — the
  1315	        exemptions are named, not the enforcement.
  1316	
  1317	        Chain semantics (see design/tick-chain-at-store-layer):
  1318	        - prev_hash: sha256 of the previous tick row (any era) — None for
  1319	          the first row in the store.
  1320	        - window bounds are explicit fact ids; membership and ordering are
  1321	          APPEND ORDER (rowid), never id order — the cursor is the id of the
  1322	          newest fact BY ROWID, not MAX(id) (see ORDERING AUTHORITY above):
  1323	          - first tick in a new store: window_start "" (covers all facts);
  1324	          - first chained tick after pre-chain rows: window_start =
  1325	            current append edge (epoch marker — claims no coverage of
  1326	            history it cannot vouch for);
  1327	          - otherwise: window_start = previous tick's fact_cursor.
  1328	        - window_hash commits to every fact row in (window_start, fact_cursor].
  1329	        - signature (delta 2): when a tick_signer was injected, signs the
  1330	          commitment hash of the new row; NULL otherwise (pre-signature era).
  1331	        """
  1332	        self._ensure_sync()
  1333	        self._ensure_chain_columns()
  1334	        # Every read below (prev_row, the fact cursor, the signed-era probe)
  1335	        # derives chain state from sqlite. Where sqlite is a derived index,
  1336	        # it must have consumed the whole canonical log first — see
  1337	        # _sync_derived_state.
  1338	        self._sync_derived_state()
  1339	        d = tick.to_dict()
  1340	        payload_text = json.dumps(d["payload"], default=_mapping_proxy_default)
  1341	
  1342	        prev_row = self._conn.execute(
  1343	            f"SELECT {_TICK_ROW_SQL} FROM ticks ORDER BY rowid DESC LIMIT 1"
  1344	        ).fetchone()
  1345	        prev_hash = _tick_row_hash(prev_row) if prev_row is not None else None
  1346	
  1347	        edge_row = self._conn.execute(
  1348	            "SELECT id FROM facts ORDER BY rowid DESC LIMIT 1"
  1349	        ).fetchone()
  1350	        fact_cursor = edge_row[0] if edge_row else ""
