   266	def _iter_lines(canonical: Path) -> Iterator[tuple[int, int, str]]:
   267	    """Yield ``(lineno, end_offset, line)`` for every COMPLETE log line.
   268	
   269	    Streams one line at a time — a 111MB log is never resident. An incomplete
   270	    tail (the torn-write window) ends iteration: it was never indexed, and
   271	    truncating it is the *writer's* job, not an auditor's.
   272	    """
   273	    with canonical.open("rb") as fh:
   274	        pos = 0
   275	        for lineno, raw in enumerate(fh, 1):
   276	            if not raw.endswith(b"\n"):
   277	                return
   278	            pos += len(raw)
   279	            text = raw[:-1].decode("utf-8", "replace").strip()
   280	            if text:
   281	                yield lineno, pos, text
   282	
   283	
   284	def _last_line(canonical: Path, size: int) -> str | None:
   285	    """The last complete line of the log, read without scanning the file."""
   286	    if size <= 0:
   287	        return None
   288	    with canonical.open("rb") as fh:
   289	        end = size
   290	        fh.seek(end - 1)
   291	        if fh.read(1) != b"\n":
   292	            return None
   293	        # Walk back in chunks until a newline appears before the final one.
   294	        chunk = 64 * 1024
   295	        start = end - 1
   296	        while start > 0:
   297	            read_from = max(0, start - chunk)
   298	            fh.seek(read_from)
   299	            buf = fh.read(start - read_from)
   300	            idx = buf.rfind(b"\n")
