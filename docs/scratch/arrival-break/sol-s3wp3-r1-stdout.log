  1284	def test_an_incomplete_read_proceeds_labeled_at_or_above_the_bound(tmp_path):
  1285	    """The posture's choice, pinned.
  1286	
  1287	    At and above the bound is the genuinely indeterminate region: equal is not
  1288	    unchanged (it may be a rollback from the entry the read missed) and higher
  1289	    is not advanced (nothing bounds the accepted head from above). The seam
  1290	    proceeds and claims NEITHER — the report carries no outcome at all — and
  1291	    the refusal that was not raised is carried on it.
  1292	
  1293	    Refusing instead would make one crashed writer a store that never opens
  1294	    again: the journal is append-only and the torn-tail guard preserves the
  1295	    fragment, so an incomplete read is permanent. That is verbatim the argument
  1296	    WP1's amended ruling used to reject refusing one level down.
  1297	    """
  1298	    log_path = minted(tmp_path / "s.arrival")
  1299	    append_legacy(log_path, "one")
  1300	    opened(log_path)
  1301	    lineage = lineage_of(log_path)
  1302	
  1303	    append_entry_for_damage(lineage)
  1304	    damage_a_line(lineage, "damage-me")
  1305	
  1306	    ledger = opened(log_path)
  1307	    comparison = ledger.opened.comparison
  1308	    assert isinstance(comparison, Indeterminate)
  1309	    assert comparison.at_least is not None
  1310	    assert comparison.skipped
  1311	    assert isinstance(comparison.refusal, IndeterminateComparison)
  1312	    # Unignorable by construction: there is no outcome to read off it.
  1313	    assert not hasattr(comparison, "outcome")
  1314	    # The ledger still works — reads are what a crash must not brick.
  1315	    assert ledger.head().ordinal == 1
