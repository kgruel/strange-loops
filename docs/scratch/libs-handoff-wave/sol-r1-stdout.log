  1253	    # -- write-through (S3) -------------------------------------------------
  1254	
  1255	    def _ensure_writer(self):
  1256	        """Build (once) and hold the writer program for this handle's store.
  1257	
  1258	        The writer is the single held runtime that fires and persists
  1259	        boundaries; ``receive`` refreshes its signers per write. It is discarded
  1260	        and rebuilt on an ontology change (see ``_recompile``)."""
  1261	        if self._writer is not None:
  1262	            return self._writer
  1263	        from engine.program import load_vertex_program
  1264	
  1265	        self._writer = load_vertex_program(self._vertex_path)
  1266	        return self._writer
  1267	
  1268	    def _apply_credentials(self, creds: WriteCredentials) -> None:
  1269	        """Install operation-fresh signers on the held writer store, per write.
  1270	
  1271	        Setting the store's signer fields per operation (rather than caching
  1272	        them at construction) is the "operation-fresh provider" the contract
  1273	        requires — it directly answers the handle-lifetime signer wedge."""
  1274	        store = getattr(self._writer.vertex, "_store", None)
  1275	        if store is not None:
  1276	            store._tick_signer = creds.tick_signer
  1277	            store._fact_signer = creds.fact_signer
  1278	
  1279	    def receive(
  1280	        self,
  1281	        fact: Fact,
  1282	        grant: Grant | None = None,
  1283	        *,
  1284	        expect: object | None = None,
  1285	        id_override: str | None = None,
  1286	        admit_undeclared: bool = False,
  1287	    ) -> ReceiveResult:
  1288	        """Write a fact through the held handle, without a full reload (S3).
  1289	
  1290	        Applies only the caller-supplied ``grant`` — declared observer
  1291	        admission policy is NOT resolved here (that is :meth:`receive_as`);
  1292	        this entry is the explicit bypass. Strict-mode kind admission is
  1293	        still enforced by the underlying engine receive;
  1294	        ``admit_undeclared=True`` is its explicit bypass.
  1295	
  1296	        Sequence: catch the handle up (so the write sees external commits),
  1297	        fetch operation-fresh signers from the :class:`CredentialProvider` at the
  1298	        moment of the write, call the live receive path **exactly once** (the
  1299	        writer is the only party that fires and persists a boundary), then
  1300	        reconstruct the canonical ``(ts, id)`` snapshot at the new head and
  1301	        return a :class:`ReceiveResult`. A locally backdated fact therefore
  1302	        cannot leave the published state in live-tail order — it folds at its
  1303	        ``(ts, id)`` position on reconstruction.
  1304	
  1305	        **Post-write reconstruction canonicalizes STATE, not ADMISSION.** A
  1306	        pre-refresh does not make the boundary/admission decision serializable:
  1307	        another writer can commit between catch-up and this append, and this
  1308	        handle's grant/observer/reserved-namespace/route/boundary gating was
  1309	        evaluated against the pre-write compile. The post-write rebuild repairs
  1310	        the published *state* but does not and cannot re-adjudicate the
  1311	        *admission* of the already-committed fact. Closing that window is the
  1312	        sibling conditional-emit/CAS + fact-plus-tick transaction; this handle
  1313	        must not claim to have done so (ticked's close lock remains until then).
  1314	
  1315	        ``expect`` is the named CAS seam — it is REFUSED
  1316	        (:class:`ConditionalEmitUnsupported`) rather than faked, because
  1317	        implementing refresh→compare→append would not be CAS and is forbidden.
  1318	
  1319	        Gate rejection returns the existing ``Receipt(stored=False)`` and
  1320	        ``change=None``. If the fact commits but boundary/tick persistence then
  1321	        raises, the handle catches up and raises
  1322	        :class:`ReceiveCommittedError` — the caller MUST know the fact landed;
  1323	        retrying as uncommitted would duplicate data.
  1324	        """
  1325	        with self._lock:
  1326	            self._ensure_usable()
  1327	            if expect is not None:
  1328	                raise ConditionalEmitUnsupported(
  1329	                    "receive(expect=...) is the conditional-emit/CAS seam — "
  1330	                    "refused rather than faked. Post-write reconstruction "
  1331	                    "canonicalizes STATE, not ADMISSION; a serializable "
  1332	                    "expectation is the sibling CAS design, not this handle."
  1333	                )
