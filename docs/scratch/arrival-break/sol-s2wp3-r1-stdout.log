         arrival_lineage=marks[ARRIVAL_LINEAGE_KEY][0],
         arrival_offset=int(marks[ARRIVAL_OFFSET_KEY][0]),
         arrival_ordinal=int(marks[ARRIVAL_ORDINAL_KEY][0]),
