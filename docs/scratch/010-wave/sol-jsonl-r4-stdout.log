   148	def fact_line(fact: dict) -> "Block":
   149	    """Render a single fact as a styled Block."""
   150	    from painted.core.block import Block
   151	    from painted.palette import current_palette
   152	
   153	    p = current_palette()
   154	    ts = fact["ts"]
   155	    if isinstance(ts, datetime):
   156	        dt = ts
   157	    else:
   158	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   159	
   160	    time_str = format_ts(dt)
   161	    kind = fact["kind"]
   162	    obs = fact.get("observer", "")
   163	    payload = fact["payload"]
   164	
   165	    parts = [f"{k}={v}" for k, v in payload.items() if v is not None and v != ""]
   166	    summary = " ".join(parts)
   167	
   168	    who = f" ({obs})" if obs else ""
   169	    text = f"  {time_str} [{kind}]{who} {summary}" if summary else f"  {time_str} [{kind}]{who}"
   170	    return Block.text(text, p.muted)
