    28	def workspace_store(vp: Path) -> Path:
    29	    """The canonical task store a read of *vp* must resolve, for this workspace.
    30	
    31	    The reader half of the split ``store.store_path`` documents for writers:
    32	    the declaration answers *what kind* of store (``.db`` → sqlite-canonical,
    33	    ``.jsonl`` → JSONL-canonical, per ``engine.residence``); the process cwd
    34	    answers *where*. Reads went through ``engine.vertex_*`` with the vertex
    35	    file alone, which resolves package-relative — so a worker wrote its
    36	    worktree's store and read the packaged one, and saw zero tasks. Passing
    37	    this as ``store=`` restores the same contract on both sides: one task
    38	    store per workspace.
    39	
    40	    Canonical, not the index: ``engine``'s readers resolve (and materialize)
    41	    the derived index for a ``.jsonl`` locator themselves.
    42	    """
    43	    from lang import parse_vertex_file
    44	
    45	    declared = Path(parse_vertex_file(vp).store or "data/tasks.db")
    46	    return declared if declared.is_absolute() else Path.cwd() / declared
    47	
    48	
    49	def _extract_task(states: dict[str, dict], name: str) -> dict | None:
    50	    """Extract a single task's state from folded specs."""
    51	    created = states.get("task.created", {}).get("items", {}).get(name)
    52	    if created is None:
    53	        return None
    54	
    55	    result: dict[str, Any] = {"name": name}
    56	    result["title"] = created.get("title", "")
    57	    result["base_branch"] = created.get("base_branch", "")
    58	    result["description"] = created.get("description", "")
    59	
    60	    assigned = states.get("task.assigned", {}).get("items", {}).get(name)
    61	    if assigned:
    62	        result["harness"] = assigned.get("harness", "")
    63	        result["worktree"] = assigned.get("worktree", "")
    64	
    65	    # Status: task.stage overrides completion/merge/assign/create
    66	    stage = states.get("task.stage", {}).get("items", {}).get(name)
    67	    completed = states.get("task.completed", {}).get("items", {}).get(name)
    68	    merged = states.get("task.merged", {}).get("items", {}).get(name)
    69	
    70	    if stage:
    71	        result["status"] = stage.get("status", "")
    72	    elif completed:
    73	        result["status"] = "completed"
    74	    elif merged:
    75	        result["status"] = "merged"
    76	    elif assigned:
    77	        result["status"] = "assigned"
    78	    else:
    79	        result["status"] = "created"
    80	
    81	    # Worker PID from worker.started
    82	    ws = states.get("worker.started", {}).get("items", {}).get(name)
    83	    if ws:
    84	        result["pid"] = ws.get("pid")
    85	
    86	    # Worker status from worker.output.complete (replaces PID liveness)
    87	    woc = states.get("worker.output.complete", {}).get("items", {}).get(name)
    88	    if woc:
    89	        status = woc.get("status", "ok")
    90	        result["worker"] = "error" if status == "error" else "stopped"
    91	        result["exit_code"] = woc.get("returncode")
    92	
    93	    return result
    94	
    95	
    96	def fold_task_state(vp: Path, name: str) -> dict | None:
    97	    """Fold task facts into current state for one task via vertex_read."""
    98	    states = vertex_read(vp, store=workspace_store(vp))
    99	    return _extract_task(states, name)
   100	
   101	
   102	def fold_all_tasks(vp: Path) -> list[dict]:
   103	    """Fold all tasks from the vertex store via vertex_read."""
   104	    states = vertex_read(vp, store=workspace_store(vp))
   105	    names = sorted(states.get("task.created", {}).get("items", {}).keys())
   106	    return [s for name in names if (s := _extract_task(states, name)) is not None]
