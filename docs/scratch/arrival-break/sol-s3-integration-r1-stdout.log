   668	        head=Head(lineage=lineage, ordinal=ordinal, record_hash=record_hash),
   669	        kind=kind,
   670	        level=level,
   671	        observed_at=float(observed_at),
   672	        location=raw["location"] if isinstance(raw.get("location"), str) else "",
   673	        note=raw["note"] if isinstance(raw.get("note"), str) else "",
