   101	    def fact_kind_stats(self, *, include_internal: bool = False) -> dict[str, dict]:
   102	        """Per-kind fact counts and time ranges.
   103	
   104	        Excludes the reserved ``_decl.*`` declaration-event namespace by
   105	        default (SPEC §9.4 — every read surface excludes it; ``GLOB`` not
   106	        ``LIKE``, since ``_`` is a LIKE single-char wildcard, not a GLOB one).
   107	        Pass ``include_internal=True`` for the explicit escape hatch.
   108	        """
   109	        where = "" if include_internal else "WHERE kind NOT GLOB '_decl.*'"
   110	        rows = self._conn.execute(
   111	            f"SELECT kind, COUNT(*), MIN(ts), MAX(ts) FROM facts {where} GROUP BY kind"
   112	        ).fetchall()
   113	        return {
   114	            r[0]: {
   115	                "count": r[1],
   116	                "earliest": datetime.fromtimestamp(r[2], tz=timezone.utc),
   117	                "latest": datetime.fromtimestamp(r[3], tz=timezone.utc),
   118	            }
   119	            for r in rows
   120	        }
   121	
   122	    def fact_key_stats(self, kind: str, key_field: str) -> dict:
   123	        """Per-fold-key stats within one kind — the containment level below kind.
   124	
   125	        ``GROUP BY json_extract(payload, '$.<key_field>')`` over the kind
   126	        partition (rides ``idx_facts_kind``). Returns ``{key_value: {count,
   127	        earliest, latest}}``, count-descending then latest-descending — the
   128	        same shape as :meth:`fact_kind_stats`, one containment level down
   129	        (vertex ⊃ kind ⊃ key). The ``None`` bucket collects facts of this kind
   130	        that are missing the key field (the silently-orphaned case CLAUDE.md
   131	        warns about) — it doubles as an orphan diagnostic, rendered ``(no
   132	        <field>)`` by the lens.
   133	        """
   134	        path = "$." + key_field
   135	        rows = self._conn.execute(
   136	            "SELECT json_extract(payload, ?) AS k, COUNT(*), MIN(ts), MAX(ts) "
   137	            "FROM facts WHERE kind = ? "
   138	            "GROUP BY k ORDER BY COUNT(*) DESC, MAX(ts) DESC",
   139	            (path, kind),
   140	        ).fetchall()
   141	        return {
   142	            r[0]: {
   143	                "count": r[1],
   144	                "earliest": datetime.fromtimestamp(r[2], tz=timezone.utc),
   145	                "latest": datetime.fromtimestamp(r[3], tz=timezone.utc),
   146	            }
   147	            for r in rows
   148	        }
   149	
   150	    def key_prefixes(
   151	        self, kind: str, key_field: str, *, prefix: str = "", limit: int = 200,
   152	    ) -> list[str]:
   153	        """Namespace prefixes (or scoped full keys) for one kind's fold-key field.
   154	
   155	        The completion-time sibling of :meth:`fact_key_stats`: that method
   156	        computes an unbounded ``GROUP BY`` over the whole kind partition for a
   157	        display lens; this one is a bounded probe for shell ``<TAB>`` — a
   158	        single ``LIMIT``-capped read of the ``limit`` most-recently INSERTED
   159	        facts of ``kind`` (rowid order, not timestamp order — after a merge
   160	        appends older-``ts`` foreign facts, those count as recent here; a
   161	        namespace live only in lower-rowid facts can be missed), with the
   162	        prefix/full-key split done in Python rather than a second SQL shape.
   163	        TAB must stay instant, so this trades completeness for a fixed, small
   164	        amount of I/O regardless of store size.
   165	
   166	        Two modes, chosen by whether ``prefix`` already contains a ``/``:
   167	
   168	        - no slash yet — the namespace-prefix drill: distinct first path
   169	          segments (``practice/``, ``design/``...) among the sampled keys.
   170	        - slash present — the scoped drill: full fold-key values starting
   171	          with ``prefix`` (``practice/`` -> ``practice/review-altitude``...).
   172	
   173	        Sorted for a stable TAB order. Keys missing the fold-key field (the
   174	        ``None`` bucket ``fact_key_stats`` surfaces as an orphan diagnostic)
   175	        are silently skipped here — nothing to complete from them.
   176	        """
   177	        # ORDER BY rowid, not ts: the single-column kind index is internally
   178	        # (kind, rowid), so this reads exactly ``limit`` index entries
   179	        # backwards with no temp B-tree — ``ORDER BY ts`` would scan and sort
   180	        # the whole kind partition before LIMIT applies (Sol review
   181	        # review/completion-t3 #6; a query-plan regression test holds this).
   182	        # Insertion order ≈ recency, which is all a completion probe needs.
   183	        path = "$." + key_field
   184	        rows = self._conn.execute(
   185	            "SELECT json_extract(payload, ?) AS k FROM facts "
   186	            "WHERE kind = ? ORDER BY rowid DESC LIMIT ?",
   187	            (path, kind, limit),
   188	        ).fetchall()
   189	        keys = [r[0] for r in rows if r[0]]
   190	        if "/" in prefix:
   191	            return sorted({k for k in keys if k.startswith(prefix)})
   192	        namespaces: set[str] = set()
   193	        for k in keys:
   194	            if "/" in k:
   195	                namespaces.add(k.split("/", 1)[0] + "/")
   196	        return sorted(namespaces)
   197	
   198	    def ordered(
   199	        self, prefix: int, key: "Ordering", *, include_internal: bool = False
   200	    ) -> list[dict]:
