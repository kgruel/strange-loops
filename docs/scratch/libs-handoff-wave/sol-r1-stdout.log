   465	def verify_position_for_store(
   466	    at: WitnessPosition, store_path: Path, *, timeout: float = 5.0
   467	) -> WitnessPosition:
   468	    """Return the position to APPLY against ``store_path``, or refuse (A10).
   469	
   470	    A witness position's ``rowid`` is an index into ONE store's append order;
   471	    applying it to another store silently selects an unrelated prefix. Cases:
   472	
   473	    - the target store IS the store the position was resolved against (same
   474	      resolved path) — returns ``at`` unchanged (its rowid is valid, unadopted
   475	      handles included, N1);
   476	    - the position is lineage-qualified (adopted) AND the target store shares
   477	      that lineage — **re-resolves** ``at.fact_id`` in the target store and
   478	      returns the target-store position. The source rowid is NEVER reused: append
   479	      order is per-store, so a merge that copied the fact reorders it (B1c). A
   480	      fact id absent from the target raises :class:`UnknownWitnessHandle`;
   481	      - an unadopted position (no lineage) on a different store, or a lineage
   482	      mismatch, raises :class:`WitnessLineageMismatch` with teaching.
   483	
   484	    Called at every engine ``at=`` selector (``vertex_fold`` / ``vertex_facts`` /
   485	    ``resolve_declaration_documents``) before the rowid is applied, so no read
   486	    layer trusts a foreign position — the guard that the in-memory check alone
   487	    could not give once a handle is serialized and re-used across stores.
   488	    """
   489	    target = str(Path(store_path).resolve())
   490	    if at.store == target:
   491	        return at
   492	    if at.lineage is None:
   493	        raise WitnessLineageMismatch(
   494	            f"witness position (fact {at.fact_id!r}) was resolved against "
   495	            f"{at.store} but is being applied to {target} — an UNADOPTED handle "
   496	            "is session-local to its own store (N1); its rowid means nothing "
   497	            "here. Resolve the position against this store, or adopt the store "
   498	            "to mint a portable lineage-qualified handle."
   499	        )
   500	    conn = _open_readonly(store_path, timeout=timeout)
   501	    target_lineage = _read_own_lineage(conn) if conn is not None else None
   502	    if conn is not None:
   503	        conn.close()
   504	    if target_lineage != at.lineage:
   505	        raise WitnessLineageMismatch(
   506	            f"witness position (lineage {at.lineage}) was resolved against "
   507	            f"{at.store} and does not match this store's lineage "
