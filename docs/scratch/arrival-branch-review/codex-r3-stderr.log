   217	class AppendRejected(ArrivalError):
   218	    """A candidate record does not follow the log's head.
   219	
   220	    Append validates, it does not assign: the coordinate is written into the
   221	    record, so a candidate whose ``ord`` is not the head's plus one, whose
   222	    ``lin`` is not the log's lineage, or whose ``prev`` does not name the
   223	    head's ``rh`` is refused before a byte is written. A rejected append
   224	    leaves the log exactly as it was.
   225	    """
