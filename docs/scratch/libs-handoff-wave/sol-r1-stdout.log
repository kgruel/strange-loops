    44	def _write_vertex(tmp_path: Path, body: str, name: str = "t") -> Path:
    45	    vpath = tmp_path / f"{name}.vertex"
    46	    store = tmp_path / f"{name}.db"
    47	    vpath.write_text(body.format(store=store))
    48	    return vpath
    49	
    50	
    51	def _stored_kinds(store: Path) -> list[str]:
    52	    conn = sqlite3.connect(str(store))
    53	    try:
    54	        return [r[0] for r in conn.execute("SELECT kind FROM facts ORDER BY rowid")]
    55	    finally:
    56	        conn.close()
