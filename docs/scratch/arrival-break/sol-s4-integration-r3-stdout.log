+from lang import StoreClauseSpan, effective_store_clause
+
+
+clause = 'store "./legacy.jsonl" backend=r##"fi "# fake"##'
+tail = ' \t/* KEEP BLOCK */ // KEEP LINE " tail\r\n'
+text = 'name "project"\r\n' + clause + tail + 'loops {}\r\n'
+located = effective_store_clause(text)
+assert located.count == 1
+assert located.span == (len('name "project"\r\n'), len('name "project"\r\n') + len(clause))
+start, end = located.span
+edited = text[:start] + 'store "./target.arrival" backend="file"' + text[end:]
+assert text[start:end] == clause
+preserved = edited.endswith(tail + 'loops {}\r\n')
+assert preserved
+doc = StoreClauseSpan.__doc__ or ""
+assert "Sub-line span" in doc
+assert "Trailing bytes on the same" in doc
+print(f"span={located.span} slice={text[start:end]!r}")
+print(f"tail={text[end:end + len(tail)]!r} preserved={preserved}")
+print("PASS: StoreClauseSpan documentation matches half-open span and slicing behavior")

