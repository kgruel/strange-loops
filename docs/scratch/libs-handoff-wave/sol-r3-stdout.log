   420	@pytest.fixture(params=["jsonl", "sqlite"])
   421	def split_world(request, tmp_path: Path):
   422	    """Vertex in a writable dir; the store in its OWN subdirectory — so the
   423	    store directory can go read-only while the canonical file stays
   424	    writable (sol's SOL-R2-04 repro shape)."""
   425	    storedir = tmp_path / "store"
   426	    storedir.mkdir()
   427	    locator = "./store/x.jsonl" if request.param == "jsonl" else "./store/x.db"
   428	    vertex = tmp_path / "x.vertex"
   429	    vertex.write_text(BASE.format(store=f'store "{locator}"'), encoding="utf-8")
   430	    return {
   431	        "mode": request.param,
   432	        "vertex": vertex,
   433	        "base": BASE.format(store=f'store "{locator}"'),
   434	        "edit": EDIT.format(store=f'store "{locator}"'),
   435	        "log": storedir / "x.jsonl",
   436	        "index": storedir / "x.db",
   437	        "storedir": storedir,
   438	    }
