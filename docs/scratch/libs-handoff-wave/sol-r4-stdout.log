   342	def _sqlite_preflight(
   343	    canonical: Path, mode: PreflightMode, open_kwargs: dict[str, Any]
   344	) -> PreflightResult:
   345	    """Sqlite-canonical: no log/index pair, so agreement is vacuous.
   346	
   347	    A MISSING db is ``unreadable`` in every mode — ``SqliteStore.__init__``
   348	    creates a missing file, and a *read* preflight never creates. Even
   349	    RECOVER_THEN_OPEN refuses: recovery rebuilds derived state from a
   350	    canonical artifact; with no artifact there is nothing to recover FROM
   351	    (the sqlite mirror of "recovery never invents a log"). Store creation
   352	    is a different verb.
   353	    """
   354	    if not canonical.exists():
   355	        return _result(
   356	            mode, canonical, canonical, "unreadable",
   357	            reason=(
   358	                f"no sqlite-canonical store at {canonical} — a read "
   359	                "preflight never creates a store"
   360	            ),
   361	        )
   362	    reason = (
   363	        "sqlite-canonical store — no derived index to audit; agreement is "
   364	        "vacuous (chain verification is verify_chain's scope)"
   365	    )
   366	    if mode is PreflightMode.AUDIT_ONLY:
   367	        return _result(
   368	            mode, canonical, canonical, "ok", agreed=True, reason=reason,
   369	        )
   370	    store = _open(canonical, open_kwargs)
   371	    return _result(
   372	        mode, canonical, canonical, "ok", agreed=True, opened=True,
   373	        store=store, reason=reason + "; store opened",
   374	    )
