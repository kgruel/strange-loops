   348	
   349	# Combined-read row shape: (id, kind, ts, observer, origin, payload, rowid).
   350	_ROW_INDEX = {"id": 0, "kind": 1, "ts": 2, "observer": 3, "origin": 4, "payload": 5}
   351	
   352	#: The ENVELOPE keys, positioned in the combined-read row. Derived from the
   353	#: atoms family rule rather than restated, so this row-shaped surface cannot
   354	#: drift from the mapping-shaped one (:func:`atoms.resolve_key_field`): only
   355	#: ``ts`` and ``id`` are envelope-resolved. ``kind``/``observer``/``origin``
   356	#: are stored columns but NOT key candidates — they resolve against the
   357	#: payload like any other declared key, which almost never carries them, so
   358	#: their projection is empty by non-membership rather than a grouping of the
   359	#: read by its columns.
   360	#:
   361	#: ts is a sqlite REAL column, so column-backed ts values are always float —
   362	#: the atoms strict type-identity check never sees an int/float mix here.
   363	_ROW_ENVELOPE_COLUMNS = {field: _ROW_INDEX[field] for field in ENVELOPE_KEYS}
   364	
   365	
   366	def _row_field(row: tuple, field: str) -> Any:
   367	    """Read a declared ordering key off a combined-read row.
   368	
   369	    The row-shaped spelling of :func:`atoms.resolve_key_field`: the envelope
   370	    keys are read straight off the tuple, anything else is a flat payload
   371	    field and costs a JSON parse. The default orderings (``Arrival()``,
   372	    ``ByKey('ts')``) are envelope-only and never reach the parse.
   373	    """
   374	    index = _ROW_ENVELOPE_COLUMNS.get(field)
   375	    if index is not None:
   376	        return row[index]
   377	    return json.loads(row[5]).get(field)
   378	
   379	
   380	def _row_id(row: tuple) -> str:
   381	    return row[0]
   382	
   383	
   384	def resolve_ordering(ordering: Ordering | None, *, single_store: bool) -> Ordering:
   385	    """Resolve the declared read ordering, applying the Q2 rule.
   386	
   387	    Single store: ``Arrival()`` by default — the substrate's native order,
   388	    which is also the fold axis. Aggregate: ``ByKey('ts')`` by default, the
   389	    event-time read lens. ``Arrival()`` on an aggregate is REFUSED.
   390	
   391	    Raises:
   392	        OrderingError: ``Arrival()`` declared on an aggregate read.
   393	    """
   394	    if ordering is None:
   395	        return Arrival() if single_store else ByKey("ts")
   396	    if not single_store and isinstance(ordering, Arrival):
   397	        raise OrderingError(
   398	            "Arrival() is not available on an aggregate read: arrival ordinals are "
   399	            "dense per-log, so a combined view of several stores has no cross-store "
   400	            "arrival total order. Declare ByKey(field) instead — e.g. ByKey('ts'), "
   401	            "the aggregate default."
   402	        )
   403	    return ordering
   404	
   405	
   406	def _fetch_combined_rows(
   407	    conn: sqlite3.Connection,
   408	    aliases: list[str],
   409	    until_ts: float | None,
   410	    ordering: Ordering,
   411	) -> list[tuple]:
   412	    """All fact rows across the attached stores, ready for ``ordering``.
   413	
   414	    Under ``Arrival()`` the rows are put in the store's native ARRIVAL order
   415	    (rowid ascending) here, because yielding that order is the store's job and
   416	    ``totalize`` will not synthesize it. ``Arrival()`` is reachable only for a
   417	    single store — :func:`resolve_ordering` refuses it on an aggregate, where
   418	    rowid is per-store and no native total order exists.
   419	
   420	    Under ``ByKey(K)`` the rows come back exactly as read: ``totalize`` sorts
   421	    on ``(K, id)``, and ``id`` is unique, so the key is total and the input
   422	    order cannot reach the output. Sorting first would be work discarded.
   423	    """
   424	    ts_clause = " WHERE ts <= ?" if until_ts is not None else ""
   425	    selects = [
   426	        f"SELECT id, kind, ts, observer, origin, payload, rowid "
   427	        f"FROM {'[' + a + '].' if a != 'main' else ''}facts{ts_clause}"
   428	        for a in aliases
   429	    ]
   430	    sql = " UNION ALL ".join(selects)
   431	    params = (until_ts,) * len(aliases) if until_ts is not None else ()
   432	    rows = conn.execute(sql, params).fetchall()
   433	    # Sort in Python — avoids a SQLite index scan for the ORDER BY, which
   434	    # causes random I/O (~14ms vs ~1ms for unsorted read).
   435	    if isinstance(ordering, Arrival):
   436	        rows.sort(key=lambda r: r[6])
   437	    return rows
   438	
   439	
   440	def _combined_read(
   441	    ast: Any, vertex_path: Path, specs: dict, *, observer: str | None = None,
   442	    ordering: Ordering | None = None,
   443	    return_payloads: bool = False,
