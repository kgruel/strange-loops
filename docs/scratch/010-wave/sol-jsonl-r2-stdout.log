    38	def store_path_for(vertex_name: str) -> Path:
    39	    """The canonical store artifact declared by ``loops/{name}.vertex``.
    40	
    41	    ``engine.residence`` owns the "which file is authoritative" rule; asking
    42	    it rather than re-deriving here is what keeps this app on the right side
    43	    of the authority switch when a declaration flips to ``.jsonl``.
    44	    """
    45	    from engine.residence import canonical_store_path
    46	    from lang import parse_vertex_file
    47	
    48	    vertex_path = _PKG_ROOT / "loops" / f"{vertex_name}.vertex"
    49	    vertex = parse_vertex_file(vertex_path)
    50	    declared = vertex.store or f"data/{vertex_name}.db"
    51	    return canonical_store_path(declared, vertex_path)
