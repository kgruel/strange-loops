    if field_mismatches:
        raise PublishPreconditionRefused(
            "Verification-by-re-parse failed: non-store fields modified during surgical edit: "
            f"{', '.join(field_mismatches)}. Advisory: verify .vertex file format.",
            condition="vertex_fields_equality",
        )

    # Atomic write via temp file in the same directory + fsync + os.replace
    v_dir = v_path.parent
    temp_path = v_dir / f".tmp_{v_path.name}_{uuid4().hex}"
    try:
        with temp_path.open("w", encoding="utf-8") as f:
            f.write(edited_text)
            f.flush()
            os.fsync(f.fileno())
        temp_path.replace(v_path)
    finally:
        if temp_path.exists():
            with contextlib.suppress(OSError):
                temp_path.unlink()


