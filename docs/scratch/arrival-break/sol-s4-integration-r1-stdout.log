    70	class CustodianFixture:
    71	    """One observer's real Ed25519 keypair plus injected signer/verifier."""
    72	
    73	    def __init__(self, tmp_path: Path, name: str) -> None:
    74	        self.name = name
    75	        self.keypair = ed25519.load_or_generate(tmp_path / "keys" / name)
    76	        self.public = self.keypair.public_b64
    77	
    78	    def signer(self, observer: str, digest: str) -> str | None:
    79	        return ed25519.sign(self.keypair, digest.encode(), domain=ARRIVAL_DOMAIN)
    80	
    81	    def verify(self, key_b64: str, signature: str, digest: str) -> bool:
    82	        try:
    83	            pub = ed25519.public_key_from_b64(key_b64)
    84	        except ValueError:
    85	            return False
    86	        return ed25519.verify(pub, signature, digest.encode(), domain=ARRIVAL_DOMAIN)
