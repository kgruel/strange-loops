   668	    def _row_matches(self, t: str, row: tuple) -> bool:
   669	        table, columns = (
   670	            ("facts", FACT_COLUMNS) if t == "fact" else ("ticks", TICK_COLUMNS)
   671	        )
   672	        stored = self._conn.execute(
   673	            f"SELECT {', '.join(columns)} FROM {table} WHERE id = ?", (row[0],)
   674	        ).fetchone()
   675	        if stored is None:
   676	            return False
   677	        # Compare VALUES, not re-serialized text: sqlite's REAL affinity
   678	        # returns 1700000000.0 for a line carrying 1700000000, and
   679	        # re-serializing would make every integral ts/since look corrupt —
   680	        # a full rebuild on every open, drowning the real-corruption signal.
   681	        # Python's cross-type numeric equality normalizes that uniformly.
   682	        return tuple(stored) == tuple(row)
