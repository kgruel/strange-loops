   140	                for name, info in data["ticks"]["names"].items():
   141	                    ts_list = reader.tick_timestamps(name, 50)
   142	                    buckets = _bucket_timestamps(ts_list, 8)
   143	                    info["sparkline"] = spark(buckets)
   144	                    # Extract payload key names from latest tick
   145	                    recent = reader.recent_ticks(name, 1)
   146	                    info["payload_keys"] = (
   147	                        list(recent[0].payload.keys()) if recent else []
   148	                    )
