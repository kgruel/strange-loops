   200	    if obj.get("t") != "tick":
   201	        raise JsonlCodecError(f"expected t='tick', got {obj.get('t')!r}")
   202	    _validate(obj, _TICK_FIELDS, _TICK_KEYS, _TICK_NULLABLE, "tick")
   203	    return _row_tuple(obj, _TICK_FIELDS)
   204	
   205	
   206	def deserialize_row(line: str) -> tuple[str, tuple]:
   207	    """Decode any line, dispatching on ``"t"``. Returns ``(t, row)``."""
   208	    obj = _load(line)
   209	    t = obj.get("t")
   210	    if t == "fact":
   211	        _validate(obj, _FACT_FIELDS, _FACT_KEYS, _FACT_NULLABLE, "fact")
   212	        return "fact", _row_tuple(obj, _FACT_FIELDS)
   213	    if t == "tick":
   214	        _validate(obj, _TICK_FIELDS, _TICK_KEYS, _TICK_NULLABLE, "tick")
   215	        return "tick", _row_tuple(obj, _TICK_FIELDS)
   216	    raise JsonlCodecError(f"unknown record discriminator t={t!r}")
     1	"""jsonl_store — the canonical write path: JSONL is the store, sqlite an index.
     2	
     3	The authority flip of design/architecture/jsonl-canonical-store. Today a
     4	store's truth lives in sqlite; here the truth is ONE interleaved append-only
     5	log per store (``<name>.jsonl``, sibling of ``<name>.db``) and sqlite is a
     6	derived, rebuildable index over it.
     7	
     8	Seam choice (subclass, not wrapper)
     9	-----------------------------------
    10	``SqliteStore.append``/``append_tick`` do the mint work — id generation,
    11	chain linkage, window hashing, era-aware signing, the signing floor — and
    12	then persist one fully-assembled row. That row is *already* the exact shape
    13	the commitment hashers and :mod:`engine.jsonl_codec` take (7 fact fields /
    14	11 tick fields), so the only thing this layer must change is **where the row
    15	lands first**. A wrapper would have to re-derive or re-implement all of that
    16	mint logic to see the row; a subclass overriding the ``_write_fact_row`` /
    17	``_write_tick_row`` seam sees it for free, inherits every read method
    18	(``since``/``since_raw``/``between``/``StoreReader``/FTS) byte-for-byte
    19	unchanged, and adds no branch to the read path. Mint logic stays in one
    20	place; only durability order is overridden.
    21	
    22	Write order (the receipt originates at the log)
    23	-----------------------------------------------
    24	1. serialize the row through the S1 codec — ``payload`` rides as the
    25	   VERBATIM stored TEXT, never re-serialized, so every existing signature
    26	   and commitment hash survives the round trip;
    27	2. **stage** the sqlite INSERT in an open, uncommitted transaction. Nothing
    28	   is observable yet, but a rejected row (duplicate id via ``id_override``
    29	   on the transport/replay path, constraint violation) fails *here* — before
    30	   any byte reaches the log, so a refused write can never leave an orphan
    31	   line the index doesn't name;
    32	3. append the line + ``\\n`` to the log, ``flush()`` + ``os.fsync()`` — the
    33	   line is durable *before* the id is anything anyone can observe;
    34	4. stamp the consumed byte offset and row counts and COMMIT — the index row
    35	   becomes visible only after its line is durable, and row, offset and
    36	   counts can never disagree. Any failure rolls the whole transaction back,
    37	   leaving the log untouched;
    38	5. return the id. The id in the receipt is the id in the durable line.
    39	
    40	Staging the INSERT before the append inverts the literal "sqlite indexed
    41	after" ordering, but preserves the property that ordering exists for: an
    42	uncommitted row is invisible to every reader, and the commit lands strictly
    43	after the fsync. Crash between fsync and commit → the row is rolled back and
    44	the offset unstamped, so the next open tails the line forward.
    45	
    46	Catch-up on open
    47	----------------
    48	``store_meta.jsonl_offset`` holds the byte offset of the log consumed into
    49	sqlite. On open:
    50	
    51	- ``offset == size`` — in sync, nothing to do.
    52	- ``offset < size`` — sqlite is behind (crash between step 2 and step 3, or
    53	  an out-of-band append): tail forward, indexing the missed lines verbatim.
    54	- ``offset > size`` (log shrank), the byte at ``offset - 1`` is not a
    55	  newline, or the last line ending at ``offset`` does not re-serialize to
    56	  the sqlite row it names — full rebuild of the sqlite index from the log,
    57	  logged loudly at WARNING. That last check is the "hash match": a
    58	  byte-compare of the codec's canonical line against the indexed row is
    59	  exactly a commitment comparison, done on one line rather than the file.
    60	- **offset absent** with a non-empty log: a store that has never recorded a
    61	  consumption point cannot claim any prefix is indexed, so it rebuilds
    62	  (rather than tailing from 0 into PK conflicts). This is also the shape a
    63	  freshly exported log + its source db has, and rebuild is the honest answer
    64	  there: it makes the index a pure function of the log.
    65	
    66	A torn final line (crash mid-write, no trailing newline) is **truncated**
    67	off the log before any tailing or appending — not merely skipped. Leaving
    68	partial bytes at the tail would let the next append concatenate onto junk
    69	and corrupt the canonical log. Truncation is the only mutation this layer
    70	ever performs on the log; everything else is append.
    71	
    72	Catch-up and rebuild insert rows **verbatim**: no signer runs, no floor
    73	check, no id minted, signatures ride as stored. Indexing is not re-emitting
    74	(same posture as ``store.jsonl.rebuild_jsonl``). A rebuild clears ``facts``
    75	and ``ticks`` only — ``store_meta`` (notably ``own_lineage``, the store's
    76	identity, which is not a fact) is preserved.
    77	
    78	This follows the :class:`engine.tailer.Tailer` pattern (persisted byte
    79	offset, complete-lines-only, incomplete tail left alone) but does not use
    80	the class: ``Tailer`` ``json.loads``-es each line before handing it on,
    81	discarding the verbatim line text this layer needs for the integrity
    82	compare and for the era-exact codec decode.
    83	
    84	Out-of-band sqlite writers
    85	--------------------------
    86	``libs/store``'s ``merge``/``receive``/``rebirth``/``compact`` open their own
    87	connection to the ``.db`` and write ``facts``/``ticks`` directly, bypassing
    88	the log entirely. This layer cannot refuse them (they never touch this
    89	class), so it *detects* them: the offset stamp carries the fact/tick counts
    90	consumed from the log, and open compares them against ``COUNT(*)``. A
    91	mismatch refuses with :class:`JsonlCanonicalUnsupported` rather than
    92	rebuilding — rebuilding would silently destroy exactly the rows that were
    93	written out of band. Honest limit: counts catch out-of-band *inserts* on an
    94	otherwise normal open, not in-place *updates* (those are the last-line
    95	compare's job), and not a store that simultaneously trips a rebuild trigger
    96	— a cleared offset marker or a shrunk log makes the stamped counts exactly
    97	as untrustworthy as the offset, so the rebuild runs and out-of-band rows are
    98	lost with it. Checking counts *before* rebuilding would block legitimate
    99	recoveries; two abnormal events have to stack to reach that window.
   100	
   101	The counts are never cached per handle: every stamp derives them from the
   102	*committed* marker, read under the write lock the INSERT already took. Two
   103	open handles on one store (a daemon plus an ``sl emit``) would otherwise each
   104	stamp their own stale idea of the total, and a perfectly consistent store
   105	would refuse to open, naming writers that never ran.
   106	
   107	Not yet wired (loud, not silent)
   108	--------------------------------
   109	History-mutating ops would rewrite rows sqlite-side while the log kept the
   110	originals, making the index no longer a function of the log. Until the log
   111	rewrite ceremony is designed they refuse with :class:`JsonlCanonicalUnsupported`:
   112	``absorb_edit`` and ``reanchor`` here; ``rebirth``/``compact`` live in
   113	``libs/store`` and are detected, not refused (above). ``absorb_genesis`` refuses
   114	too — the judgment call the slice allowed. It is append-shaped, not
   115	history-mutating, but its write is a ``BEGIN IMMEDIATE`` compare-and-swap
   116	that may roll back *after* the row is built; flush-first durability would
   117	make a rolled-back genesis real in the log. Reconciling the two orderings is
   118	design work, not a small wiring, so it fails loudly here.
   119	"""
   120	
   121	from __future__ import annotations
   122	
   123	import logging
   124	import os
   125	from pathlib import Path
   126	from typing import Any, Generic, TypeVar
   127	
   128	from .jsonl_codec import (
   129	    JsonlCodecError,
   130	    deserialize_row,
   131	    serialize_fact_row,
   132	    serialize_tick_row,
   133	)
   134	from .sqlite_store import SqliteStore
   135	
   136	__all__ = [
   137	    "JsonlCanonicalUnsupported",
   138	    "JsonlStore",
   139	    "ensure_index",
   140	    "log_path_for",
   141	    "open_canonical_store",
   142	    "resolved_index",
   143	]
   144	
   145	_log = logging.getLogger(__name__)
   146	
   147	T = TypeVar("T")
   148	
   149	_OFFSET_KEY = "jsonl_offset"
   150	_FACT_COUNT_KEY = "jsonl_fact_count"
   151	_TICK_COUNT_KEY = "jsonl_tick_count"
   152	
   153	_CHUNK = 64 * 1024
   154	
   155	_FACT_INSERT = (
   156	    "INSERT INTO facts (id, kind, ts, observer, origin, payload, signature) "
   157	    "VALUES (?, ?, ?, ?, ?, ?, ?)"
   158	)
   159	_TICK_INSERT = (
   160	    "INSERT INTO ticks (id, name, ts, since, origin, payload, "
   161	    "prev_hash, window_start, fact_cursor, window_hash, signature) "
   162	    "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
   163	)
   164	
   165	
   166	class JsonlCanonicalUnsupported(NotImplementedError):
   167	    """A history-mutating op was called on a JSONL-canonical store.
   168	
   169	    Rewriting sqlite rows in place would break the layer's whole claim — that
   170	    the index is a function of the log (design/architecture/jsonl-canonical
   171	    -store). The log-rewrite ceremony is not designed yet, so these refuse
   172	    rather than silently diverge.
   173	    """
   174	
   175	
   176	def log_path_for(db_path: Path) -> Path:
   177	    """The canonical log beside a store db: ``<name>.db`` → ``<name>.jsonl``."""
   178	    return Path(db_path).with_suffix(".jsonl")
   179	
   180	
   181	def open_canonical_store(canonical: Path, **kwargs: Any) -> SqliteStore[Any]:
   182	    """Open the right store class for a store locator (see ``engine.residence``).
   183	
   184	    ``.jsonl`` → :class:`JsonlStore` over the sibling index; anything else →
   185	    :class:`SqliteStore` at the path itself. One place to ask "which file is
   186	    authoritative here", so no write site can answer it differently.
   187	    """
   188	    from .residence import index_path_for, is_jsonl_canonical
   189	
   190	    canonical = Path(canonical)
   191	    if is_jsonl_canonical(canonical):
   192	        return JsonlStore(path=index_path_for(canonical), log_path=canonical, **kwargs)
   193	    return SqliteStore(path=canonical, **kwargs)
   194	
   195	
   196	def ensure_index(canonical: Path) -> Path:
   197	    """Materialize the sqlite index for a JSONL-canonical log. Returns its path.
   198	
   199	    The doctrine's fresh-clone case: the ``.jsonl`` is tracked in git, the
   200	    derived ``.db`` is not, so the first read after a clone finds no index.
   201	    Opening a :class:`JsonlStore` runs the S3 catch-up (offset absent + a
   202	    non-empty log ⇒ full rebuild), which is exactly "materialize the index
   203	    from the log". Closing immediately leaves no handle behind.
   204	
   205	    A no-op — no store constructed, no lock taken — when the index already
   206	    exists, or when ``canonical`` is not JSONL-canonical, or when the log
   207	    itself is missing (nothing to build from; let the caller's own
   208	    not-found handling speak). Read paths may call this on every resolve.
   209	    """
   210	    from .residence import index_path_for, is_jsonl_canonical
   211	
   212	    canonical = Path(canonical)
   213	    index = index_path_for(canonical)
   214	    if not is_jsonl_canonical(canonical) or index.exists() or not canonical.exists():
   215	        return index
   216	    store: JsonlStore[Any] = JsonlStore(
   217	        path=index,
   218	        log_path=canonical,
   219	        serialize=lambda d: d,
   220	        deserialize=lambda d: d,
   221	    )
   222	    store.close()
   223	    return index
   224	
   225	
   226	def resolved_index(declared: Path | str, vertex_path: Path | None = None) -> Path:
   227	    """:func:`engine.residence.resolve_store_path`, materializing on the way.
   228	
   229	    The read path's resolution seam. ``resolve_store_path`` is pure — it can
   230	    only *name* the sqlite index — so a fresh clone (log tracked, derived
   231	    index not) resolves to a path that does not exist, and every reader's
   232	    ``if not store_path.exists()`` answers "empty store" for the one
   233	    invocation that should have built it. Resolving through here makes
   234	    materialization part of resolution, so no reader can observe the gap.
   235	
   236	    Identical to ``resolve_store_path`` in every other case: the same path,
   237	    with :func:`ensure_index`'s stat-only no-op in front of it.
   238	    """
   239	    from .residence import canonical_store_path
   240	
   241	    return ensure_index(canonical_store_path(declared, vertex_path))
   242	
   243	
   244	class JsonlStore(SqliteStore[T], Generic[T]):
   245	    """A store whose canonical persistence is its JSONL log.
   246	
   247	    Same constructor as :class:`SqliteStore` plus an optional ``log_path``
   248	    (defaults to the db path with a ``.jsonl`` suffix). Opening runs
   249	    catch-up; every append writes the log first.
   250	    """
   251	
   252	    def __init__(self, *, log_path: Path | None = None, **kwargs: Any) -> None:
   253	        super().__init__(**kwargs)
   254	        self._log_path = (
   255	            Path(log_path) if log_path is not None else log_path_for(self._path)
   256	        )
   257	        self._ensure_fact_signature_column()
   258	        self._ensure_chain_columns()
   259	        self._ensure_meta_table()
   260	        try:
   261	            self.catch_up()
   262	        except BaseException:
   263	            # A raise out of __init__ must leave the db reopenable: an
   264	            # uncommitted DELETE on a leaked connection locks the file
   265	            # forever, turning one bad open into a permanently bricked store.
   266	            try:
   267	                self._conn.rollback()
   268	            finally:
   269	                self._conn.close()
   270	            raise
   271	
   272	    @property
   273	    def log_path(self) -> Path:
   274	        """The canonical log this store's sqlite index derives from."""
   275	        return self._log_path
   276	
   277	    # ---- offset bookkeeping ------------------------------------------
   278	
   279	    def _read_meta_int(self, key: str) -> int | None:
   280	        row = self._conn.execute(
   281	            "SELECT value FROM store_meta WHERE key = ?", (key,)
   282	        ).fetchone()
   283	        if row is None:
   284	            return None
   285	        try:
   286	            return int(row[0])
   287	        except (TypeError, ValueError):
   288	            return None
   289	
   290	    def _read_offset(self) -> int | None:
   291	        return self._read_meta_int(_OFFSET_KEY)
   292	
   293	    def _marked_counts(self) -> tuple[int, int] | None:
   294	        """The committed (fact, tick) counts the log accounts for.
   295	
   296	        ``None`` for a store whose markers were never written (pre-marker
   297	        store): there is nothing to compare against, and inventing a
   298	        baseline from this handle's guesses is exactly the bug the markers
   299	        exist to avoid. Always read from the db, never cached per handle —
   300	        a second open handle would otherwise stamp its own stale idea of
   301	        the count over a concurrent writer's correct one.
   302	        """
   303	        facts = self._read_meta_int(_FACT_COUNT_KEY)
   304	        ticks = self._read_meta_int(_TICK_COUNT_KEY)
   305	        if facts is None or ticks is None:
   306	            return None
   307	        return facts, ticks
   308	
   309	    def _stamp(self, offset: int, facts: int, ticks: int) -> None:
   310	        """Stage the offset + indexed-row-count marks (caller commits)."""
   311	        sql = "INSERT OR REPLACE INTO store_meta (key, value) VALUES (?, ?)"
   312	        for key, value in (
   313	            (_OFFSET_KEY, offset),
   314	            (_FACT_COUNT_KEY, facts),
   315	            (_TICK_COUNT_KEY, ticks),
   316	        ):
   317	            self._conn.execute(sql, (key, str(value)))
   318	
   319	    def _row_counts(self) -> tuple[int, int]:
   320	        facts = self._conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0]
   321	        ticks = self._conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0]
   322	        return int(facts), int(ticks)
   323	
   324	    def _log_size(self) -> int:
   325	        try:
   326	            return self._log_path.stat().st_size
   327	        except OSError:
   328	            return 0
   329	
   330	    # ---- the write path ----------------------------------------------
   331	
   332	    def _append_line(self, line: str) -> int:
   333	        """Append one durable line; return the log size after it.
   334	
   335	        fsync, not just flush: the receipt is minted here, so the line must
   336	        outlive a power cut, not merely a process crash.
   337	        """
   338	        self._log_path.parent.mkdir(parents=True, exist_ok=True)
   339	        data = (line + "\n").encode("utf-8")
   340	        with self._log_path.open("ab") as fh:
   341	            fh.write(data)
   342	            fh.flush()
   343	            os.fsync(fh.fileno())
   344	        return self._log_size()
   345	
   346	    def _write(self, sql: str, row: tuple, line: str, is_fact: bool) -> None:
   347	        """Stage the INSERT, make the line durable, then stamp and commit.
   348	
   349	        The INSERT runs first, uncommitted: a rejected row (duplicate id from
   350	        ``id_override``, any constraint) fails before a byte reaches the log,
   351	        so a refused append can never orphan a line. Nothing is observable
   352	        until the commit, which happens strictly after the fsync.
   353	        """
   354	        try:
   355	            self._conn.execute(sql, row)
   356	            # The INSERT has taken sqlite's write lock, so the committed
   357	            # markers read here cannot be raced by another handle: whatever
   358	            # a concurrent writer stamped is already visible, and nothing
   359	            # further can land until we commit or roll back. Increment from
   360	            # that committed value — never from a per-handle cache, which
   361	            # would stamp a stale count over another writer's correct one
   362	            # and brick the store on the next open.
   363	            marked = self._marked_counts()
   364	            if marked is None:
   365	                facts, ticks = self._row_counts()  # pre-marker store: adopt
   366	            else:
   367	                facts, ticks = marked
   368	                facts += 1 if is_fact else 0
   369	                ticks += 0 if is_fact else 1
   370	            offset = self._append_line(line)
   371	            self._stamp(offset, facts, ticks)
   372	            self._conn.commit()
   373	        except BaseException:
   374	            self._conn.rollback()
   375	            raise
   376	
   377	    def _write_fact_row(self, row: tuple) -> None:
   378	        self._write(_FACT_INSERT, row, serialize_fact_row(row), True)
   379	
   380	    def _write_tick_row(self, row: tuple) -> None:
   381	        self._write(_TICK_INSERT, row, serialize_tick_row(row), False)
   382	
   383	    # ---- catch-up -----------------------------------------------------
   384	
   385	    def catch_up(self) -> str:
   386	        """Reconcile the sqlite index with the log. Returns what it did:
   387	        ``"synced"``, ``"tailed"``, ``"rebuilt"`` or ``"empty"``."""
   388	        self._truncate_torn_line()
   389	        size = self._log_size()
   390	        offset = self._read_offset()
   391	
   392	        if size == 0:
   393	            # No log yet. An index with rows but no log is not a
   394	            # JSONL-canonical store — refuse rather than invent a log.
   395	            if self._has_rows():
   396	                raise JsonlCanonicalUnsupported(
   397	                    f"{self._path} has indexed rows but no canonical log at "
   398	                    f"{self._log_path} — export it first "
   399	                    "(store.jsonl.export_jsonl), then open it JSONL-canonical"
   400	                )
   401	            self._index_offset(0, 0, 0)
   402	            return "empty"
   403	
   404	        if offset is None:
   405	            self._rebuild("no consumed-offset marker recorded")
   406	            return "rebuilt"
   407	        if offset > size:
   408	            self._rebuild(f"log shrank: offset {offset} > size {size}")
   409	            return "rebuilt"
   410	        if not self._prefix_intact(offset):
   411	            self._rebuild(f"log content at offset {offset} does not match the index")
   412	            return "rebuilt"
   413	
   414	        marked = self._marked_counts()
   415	        if marked is None:
   416	            # Pre-marker store: no baseline exists, so nothing can be judged
   417	            # out of band. Adopt the current row counts as the baseline so
   418	            # every later open has something honest to compare against.
   419	            base_facts, base_ticks = self._row_counts()
   420	            judge = False
   421	        else:
   422	            base_facts, base_ticks = marked
   423	            judge = True
   424	
   425	        if offset == size:
   426	            if judge:
   427	                self._refuse_out_of_band(base_facts, base_ticks)
   428	            else:
   429	                self._index_offset(offset, base_facts, base_ticks)
   430	            return "synced"
   431	
   432	        facts, ticks = self._tail_forward(offset, base_facts, base_ticks)
   433	        if judge:
   434	            self._refuse_out_of_band(facts, ticks)
   435	        return "tailed"
   436	
   437	    def _refuse_out_of_band(self, expect_facts: int, expect_ticks: int) -> None:
   438	        """Refuse a db carrying rows that never came through the log.
   439	
   440	        ``libs/store``'s merge/receive/rebirth/compact open their own
   441	        connection and INSERT straight into ``facts``/``ticks``. Those rows
   442	        are invisible to the log, so the index is no longer a function of it.
   443	        Refusing is the only non-destructive answer: rebuilding would delete
   444	        precisely the out-of-band rows. Catches inserts, not in-place
   445	        updates — those are the last-line compare's job.
   446	        """
   447	        facts, ticks = self._row_counts()
   448	        if facts == expect_facts and ticks == expect_ticks:
   449	            return
   450	        raise JsonlCanonicalUnsupported(
   451	            f"{self._path} holds rows that did not come through "
   452	            f"{self._log_path}: sqlite has {facts} fact(s)/{ticks} tick(s), the "
   453	            f"log accounts for {expect_facts}/{expect_ticks}. "
   454	            "Out-of-band writers (store.merge, store.receive, rebirth, "
   455	            "compact) are not wired for a JSONL-canonical store. Recovery: "
   456	            "open it as a plain SqliteStore and re-export the log "
   457	            "(store.jsonl.export_jsonl) before reopening JSONL-canonical."
   458	        )
   459	
   460	    def _has_rows(self) -> bool:
   461	        for table in ("facts", "ticks"):
   462	            if self._conn.execute(f"SELECT EXISTS(SELECT 1 FROM {table})").fetchone()[0]:
   463	                return True
   464	        return False
   465	
   466	    def _index_offset(self, offset: int, facts: int, ticks: int) -> None:
   467	        self._stamp(offset, facts, ticks)
   468	        self._conn.commit()
   469	
   470	    def _last_newline_before(self, fh, end: int) -> int:
   471	        """Byte offset just past the last ``\\n`` strictly before ``end``.
   472	
   473	        Scans backwards in chunks — never loads the whole log, and never
   474	        gives up as a function of line length (a single 70KB payload must
   475	        not silently disable the integrity check). 0 when there is none.
   476	        """
   477	        pos = end
   478	        while pos > 0:
   479	            start = max(0, pos - _CHUNK)
   480	            fh.seek(start)
   481	            chunk = fh.read(pos - start)
