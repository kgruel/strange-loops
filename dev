#!/usr/bin/env bash
# Dev harness for the monorepo root — repo-level invariants & outer-loop verification.
#
# Commands:
#   ./dev check      # Repo-level architectural ratchets (tests/test_architecture.py)
#   ./dev test       # Run full unit/property test suite across all workspace libraries
#   ./dev chaos      # Run storage fault injection and disaster recovery tests (tests/chaos/)
#   ./dev bench      # Run cross-layer benchmark suite (benchmarks/benchmark_hotpath.py)
#   ./dev all        # Run check, test, chaos, and bench verification
set -euo pipefail

cd "$(dirname "$0")"

cmd="${1:-help}"
shift || true

case "$cmd" in
    check)
        exec uv run pytest tests/test_architecture.py -q "$@"
        ;;
    chaos)
        exec uv run pytest tests/chaos/ -q "$@"
        ;;
    bench)
        exec uv run python benchmarks/benchmark_hotpath.py "$@"
        ;;
    test)
        echo "=== Running all workspace library test suites ==="
        # Run root architecture & chaos
        uv run pytest tests/test_architecture.py tests/chaos/ -q
        # Run per-package suites
        for pkg in atoms custody engine lang sign store; do
            if [ -d "libs/$pkg" ]; then
                echo "--- libs/$pkg ---"
                uv run --package "$pkg" pytest "libs/$pkg/tests" -q
            fi
        done
        if [ -d "libs/sdk" ]; then
            echo "--- libs/sdk ---"
            uv run --package sdk pytest libs/sdk/tests -q
        fi
        echo "✅ All test suites passed!"
        ;;
    all)
        echo "=== 1. Architectural Check ==="
        uv run pytest tests/test_architecture.py -q
        echo "=== 2. Chaos & Fault Injection ==="
        uv run pytest tests/chaos/ -q
        echo "=== 3. Workspace Test Suites ==="
        "$0" test
        echo "=== 4. Hotpath Benchmarks vs Baseline ==="
        uv run python benchmarks/benchmark_hotpath.py --compare benchmarks/baseline.json --threshold 10
        echo "🎉 Full monorepo verification complete!"
        ;;
    *)
        echo "Usage: ./dev <command> [args...]"
        echo ""
        echo "Commands:"
        echo "  check    Run architecture ratchets (tests/test_architecture.py)"
        echo "  test     Run unit/property suites across all libraries"
        echo "  chaos    Run storage fault injection tests (tests/chaos/)"
        echo "  bench    Run cross-layer benchmark harness (benchmarks/)"
        echo "  all      Run check, chaos, test, and bench comparison"
        exit "$([ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] && echo 0 || echo 1)"
        ;;
esac
