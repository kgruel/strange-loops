   342	def _open_combined(store_paths: list[Path]) -> tuple[sqlite3.Connection, list[str]]:
   343	    """Open the first store and ATTACH the rest. Returns (conn, aliases).
   344	
   345	    All databases are opened read-only via URI mode.
   346	    """
   347	    conn = sqlite3.connect(f"file:{store_paths[0]}?mode=ro", uri=True)
   348	    aliases = ["main"]
   349	    for i, path in enumerate(store_paths[1:], 1):
   350	        alias = f"s{i}"
   351	        assert alias.isidentifier() and alias.isascii(), f"Unsafe alias: {alias}"
   352	        conn.execute(f"ATTACH DATABASE ? AS [{alias}]", (f"file:{path}?mode=ro",))
   353	        aliases.append(alias)
   354	    return conn, aliases
