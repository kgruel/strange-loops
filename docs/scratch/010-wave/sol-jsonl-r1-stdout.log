   405	        counts: dict[str, int] = {}
   406	        for f in facts:
   407	            kind = f["kind"]
   408	            counts[kind] = counts.get(kind, 0) + 1
   409	        for t in ticks:
   410	            counts["tick"] = counts.get("tick", 0) + 1
   411	        parts = [f"{n} {k}" for k, n in sorted(counts.items())]
   412	        return Block.text(", ".join(parts), p.muted)
   413	
   414	    # SUMMARY/DETAILED/FULL — date-grouped timeline
   415	    entries: list[tuple[float, str, dict]] = []
   416	    for f in facts:
   417	        ts = f["ts"]
   418	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   419	        entries.append((ts_val, "fact", f))
   420	    for t in ticks:
   421	        ts = t["ts"]
   422	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   423	        entries.append((ts_val, "tick", t))
   424	
   425	    entries.sort(key=lambda e: e[0])
   426	
   427	    # Group by date, then join groups with gap=1
   428	    date_groups: list[Block] = []
   429	    current_group: list[Block] = []
   430	    current_date = None
   431	    for ts_val, entry_type, item in entries:
   432	        dt = datetime.fromtimestamp(ts_val, tz=timezone.utc)
   433	        date_str = format_date(dt)
   434	        if date_str != current_date:
   435	            if current_group:
   436	                date_groups.append(join_vertical(*current_group))
   437	            current_group = [Block.text(f"{date_str}:", p.accent)]
   438	            current_date = date_str
   439	
   440	        if entry_type == "fact":
   441	            current_group.extend(fact_line_zoom(item, zoom))
   442	        else:
   443	            current_group.extend(tick_line_zoom(item, zoom))
   444	
   445	    if current_group:
   446	        date_groups.append(join_vertical(*current_group))
   447	
   448	    return join_vertical(*date_groups, gap=1)
