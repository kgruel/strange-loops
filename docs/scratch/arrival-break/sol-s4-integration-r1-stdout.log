   179	def preflight_journal() -> None:
   180	    """Pre-flight head journal directory and write permissions (§D.3).
   181	
   182	    Ensures the state root and heads/ directory exist and can be written to
   183	    before minting genesis, eliminating common NotWitnessed failure causes
   184	    while failure is still free.
   185	
   186	    Raises:
   187	        JournalPreflightRefused: If heads directory cannot be created or written.
   188	    """
   189	    try:
   190	        hdir = heads_dir()
   191	        hdir.mkdir(parents=True, exist_ok=True)
   192	        probe_path = hdir / f".probe_preflight_{uuid4().hex}"
   193	        probe_path.write_bytes(b"probe\n")
   194	        probe_path.unlink()
   195	    except OSError as exc:
   196	        raise JournalPreflightRefused(
   197	            f"Head journal preflight failed: {exc}. "
   198	            "Advisory: check that state root ($XDG_STATE_HOME or ~/.local/state) "
   199	            "exists and is writable by the current user.",
   200	            path=str(locals().get("hdir", "")),
   201	        ) from exc
