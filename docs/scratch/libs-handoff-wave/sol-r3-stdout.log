   362	class JsonlStore(SqliteStore[T], Generic[T]):
   363	    """A store whose canonical persistence is its JSONL log.
   364	
   365	    Same constructor as :class:`SqliteStore` plus an optional ``log_path``
   366	    (defaults to the db path with a ``.jsonl`` suffix). Opening runs
   367	    catch-up; every append writes the log first.
   368	    """
   369	
   370	    def __init__(self, *, log_path: Path | None = None, **kwargs: Any) -> None:
   371	        super().__init__(**kwargs)
   372	        self._log_path = (
   373	            Path(log_path) if log_path is not None else log_path_for(self._path)
   374	        )
   375	        try:
   376	            self._open_index()
   377	        except sqlite3.Error as exc:
   378	            # The derived index itself does not open as sqlite (non-sqlite
   379	            # bytes, truncated header — low-level corruption catch-up cannot
   380	            # route around). The index is DERIVED and the canonical log is
   381	            # the store, so discarding and rebuilding it from the log is this
   382	            # layer's own recovery, same class as the _rebuild triggers. Two
   383	            # guards keep the unlink honest: a transient lock is not
   384	            # corruption (re-raise — another handle owns a live index), and
   385	            # with no canonical log on disk the db is the only artifact
   386	            # (re-raise — never destroy what cannot be re-derived).
   387	            if "database is locked" in str(exc) or not self._log_path.is_file():
   388	                raise
   389	            from .residence import sqlite_sidecars
   390	
   391	            _log.warning(
   392	                "jsonl-canonical: derived index %s unusable (%s) — "
   393	                "discarding and rebuilding from %s",
   394	                self._path, exc, self._log_path,
   395	            )
   396	            for stale in (self._path, *sqlite_sidecars(self._path)):
   397	                stale.unlink(missing_ok=True)
   398	            super().__init__(**kwargs)  # fresh empty index at the same path
   399	            self._open_index()  # offset absent + non-empty log ⇒ rebuild
   400	
   401	    def _open_index(self) -> None:
   402	        """Schema prep + catch-up, leaving the db reopenable on failure."""
   403	        try:
   404	            self._ensure_fact_signature_column()
   405	            self._ensure_chain_columns()
   406	            self._ensure_meta_table()
   407	            self.catch_up()
   408	        except BaseException:
   409	            # A raise out of __init__ must leave the db reopenable: an
   410	            # uncommitted DELETE on a leaked connection locks the file
   411	            # forever, turning one bad open into a permanently bricked store.
   412	            try:
   413	                self._conn.rollback()
   414	            finally:
   415	                self._conn.close()
   416	            raise
   417	
   418	    @property
   419	    def log_path(self) -> Path:
   420	        """The canonical log this store's sqlite index derives from."""
   421	        return self._log_path
   422	
   423	    # ---- offset bookkeeping ------------------------------------------
   424	
   425	    def _read_meta_int(self, key: str) -> int | None:
   426	        return _as_int(self._meta_get(key))
   427	
   428	    def _read_offset(self) -> int | None:
   429	        return self._read_meta_int(_OFFSET_KEY)
   430	
   431	    def _marked_counts(self) -> tuple[int, int] | None:
   432	        """The committed (fact, tick) counts the log accounts for.
   433	
   434	        ``None`` for a store whose markers were never written (pre-marker
   435	        store): there is nothing to compare against, and inventing a
   436	        baseline from this handle's guesses is exactly the bug the markers
   437	        exist to avoid. Always read from the db, never cached per handle —
   438	        a second open handle would otherwise stamp its own stale idea of
   439	        the count over a concurrent writer's correct one.
   440	        """
   441	        facts = self._read_meta_int(_FACT_COUNT_KEY)
