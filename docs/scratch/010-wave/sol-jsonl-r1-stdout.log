   386	def log_block_zoom(facts: list[dict], ticks: list[dict] | None, zoom) -> "Block":
   387	    """Render facts and ticks with zoom-aware detail.
   388	
   389	    MINIMAL: kind counts one-liner.
   390	    SUMMARY/DETAILED/FULL: date-grouped timeline using fact_line_zoom/tick_line_zoom.
   391	    """
   392	    from painted import Zoom
   393	    from painted.core.block import Block
   394	    from painted.core.compose import join_vertical
   395	    from painted.palette import current_palette
   396	
   397	    ticks = ticks or []
   398	    p = current_palette()
   399	
   400	    if not facts and not ticks:
   401	        return Block.text("No facts in the given time range.", p.muted)
   402	
   403	    if zoom == Zoom.MINIMAL:
