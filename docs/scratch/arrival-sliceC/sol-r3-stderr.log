    30	        # A low key with a high id still sorts before a high key with a low id.
    31	        records = [rec("z", ts=1), rec("a", ts=2)]
    32	        assert [r["id"] for r in totalize(records, ByKey("ts"))] == ["z", "a"]
    33	
    34	    def test_key_may_be_any_flat_payload_field(self):
    35	        records = [rec("a", name="pear"), rec("b", name="apple")]
    36	        assert [r["id"] for r in totalize(records, ByKey("name"))] == ["b", "a"]
    37	
