  1205	def last_entry(lineage: str) -> tuple[int, HeadAttestation] | None:
  1206	    """The last readable entry and its PHYSICAL LINE, or None if there is none.
  1207	
  1208	    Both halves, because a trust reset binds to both — see
  1209	    :attr:`HeadAttestation.follows`. File order, not maximum ordinal: a reset
  1210	    binds to the entry it is physically appended after, which is what a later
  1211	    reader finds sitting in front of it.
  1212	
