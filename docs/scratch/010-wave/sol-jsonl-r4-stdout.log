  1612	def _extract_field(payload: dict, field: str) -> str:
  1613	    """Extract a search field value from a payload, handling nested paths and polymorphic values.
  1614	
  1615	    Supports:
  1616	    - Flat fields: ``"prompt"`` → ``payload["prompt"]``
  1617	    - Dot paths: ``"message.content"`` → ``payload["message"]["content"]``
  1618	    - String values: returned directly
  1619	    - List of dicts: extracts ``"text"`` from each element, concatenates
  1620	    - List of strings: concatenated
  1621	    - Dict values: JSON-serialized (fallback)
  1622	    - Missing fields: empty string
  1623	    """
  1624	    # Traverse dot path
  1625	    value: Any = payload
  1626	    for part in field.split("."):
  1627	        if isinstance(value, dict):
  1628	            value = value.get(part)
  1629	        else:
  1630	            return ""
  1631	        if value is None:
  1632	            return ""
  1633	
  1634	    # Resolve polymorphic value
  1635	    if isinstance(value, str):
  1636	        return value
  1637	    if isinstance(value, list):
  1638	        parts = []
  1639	        for item in value:
  1640	            if isinstance(item, str):
  1641	                parts.append(item)
  1642	            elif isinstance(item, dict):
  1643	                text = item.get("text")
  1644	                if isinstance(text, str):
  1645	                    parts.append(text)
  1646	        return " ".join(parts)
  1647	    if isinstance(value, dict):
  1648	        return json.dumps(value)
  1649	    return str(value)
