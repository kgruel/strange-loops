   298	
   299	    with pytest.raises(HeadMismatch):
   300	        ledger.append(stale, [_draft(2)])
   301	
   302	    # A placement fault reaches the caller as itself, not as HeadMismatch.
   303	    head = ledger._log.head()
   304	    with pytest.raises(AppendRejected) as caught:
   305	        ledger._log.append_record(
   306	            build_record(
   307	                lin=head["lin"], ordinal=head["ord"] + 9, prev=head["rh"],
   308	                k="note", body={}, observer="kyle",
   309	            )
   310	        )
   311	    assert not isinstance(caught.value, HeadMismatch)
