     1	"""The cut-A gate, answered literally (decision:design/arrival-sliceA-authority §7).
     2	
     3	G1 — the authority test: build an arrival store, exercise it (facts, a key
     4	introduction, a declaration absorb, a seal), DELETE EVERY PROJECTION, and
     5	assert identity, records, authorship and ordering all still answer from the
     6	``.arrival`` file alone, through :meth:`engine.arrival.ArrivalLog.walk` —
     7	``own_lineage`` included, with ``store_meta`` gone with the index.
     8	
     9	G2 — the exclusivity trace: a second key introduced at a stated ordinal,
    10	every projection deleted, every signature verified from the log alone, the
    11	trace emitted as ``(key, lineage, ordinal)`` rows — and no key resolving
    12	from anywhere but a log coordinate.
    13	
    14	G3 — apps/ diff-empty: the per-slice gate law, checked against git.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import json
    20	from datetime import UTC, datetime
    21	from pathlib import Path
    22	
    23	from atoms import Fact
    24	from lang import parse_vertex
    25	from lang.document import DECL_GENESIS, vertex_to_documents
    26	
    27	from engine.arrival import (
    28	    KEY_INTRODUCTION_KIND,
    29	    ArrivalLog,
    30	    verify_authorship,
    31	)
    32	from engine.arrival_store import ArrivalStore
    33	from engine.residence import sqlite_sidecars
    34	from engine.tick import Tick
    35	from tests.conftest import ARRIVAL_VERTEX_SRC as BASE
    36	from tests.conftest import Custodian as _Custodian
    37	from tests.conftest import ed25519_verify as _verify
    38	
    39	
    40	def _build_exercised_store(tmp_path: Path) -> tuple[Path, _Custodian, _Custodian, int]:
    41	    """Movement 1 (mint), facts, a key introduction at a stated ordinal, a
    42	    declaration absorb (movement 2), a seal. Returns (log path, founder,
    43	    second custodian, the introduction's ordinal)."""
    44	    kyle = _Custodian(tmp_path, "kyle")
    45	    ana = _Custodian(tmp_path, "ana")
    46	
    47	    log = ArrivalLog.mint(
    48	        tmp_path / "s.arrival", observer="kyle", signer=kyle.signer, key=kyle.public
    49	    )
    50	
    51	    def signer(observer: str, digest: str) -> str | None:
    52	        by = {"kyle": kyle, "ana": ana}.get(observer)
    53	        return by.signer(observer, digest) if by else None
    54	
    55	    store: ArrivalStore = ArrivalStore(
    56	        path=tmp_path / "s.db",
    57	        serialize=lambda f: f.to_dict(),
    58	        deserialize=Fact.from_dict,
    59	        fact_signer=signer,
    60	    )
    61	    try:
    62	        store.append(Fact.of("note", "kyle", message="one"))  # ordinal 1
    63	        intro = log.append(
    64	            KEY_INTRODUCTION_KIND,
    65	            {"observer": "ana", "key": ana.public},
    66	            observer="kyle",
    67	            signer=kyle.signer,
    68	        )  # ordinal 2
    69	        store.append(Fact.of("note", "ana", message="two"))  # ordinal 3
    70	        docs = [d.as_json() for d in vertex_to_documents(parse_vertex(BASE))]
    71	        store.absorb_genesis(docs, observer="kyle", fact_signer=signer)  # ordinal 4
    72	        store.append_tick(  # the seal — ordinal 5
    73	            Tick(name="seal", ts=datetime.now(UTC), payload={"n": 2}, origin="x")
    74	        )
    75	    finally:
    76	        store.close()
    77	    return log.path, kyle, ana, intro["ord"]
    78	
    79	
    80	def _delete_every_projection(log_path: Path) -> None:
    81	    index = log_path.with_suffix(".db")
    82	    for stale in (index, *sqlite_sidecars(index), log_path.with_suffix(".jsonl")):
    83	        stale.unlink(missing_ok=True)
    84	    remaining = {p.name for p in log_path.parent.iterdir() if p.is_file()}
    85	    assert remaining & {"s.arrival"} == {"s.arrival"}
    86	    assert not any(n.endswith((".db", "-wal", "-shm", ".jsonl")) for n in remaining)
    87	
    88	
    89	# --- G1 ----------------------------------------------------------------------
    90	
    91	
    92	def test_g1_everything_answers_from_the_arrival_file_alone(tmp_path):
    93	    log_path, kyle, ana, intro_ordinal = _build_exercised_store(tmp_path)
    94	    _delete_every_projection(log_path)
    95	
    96	    log = ArrivalLog(log_path)
    97	    records = list(log.walk())  # the walk IS the integrity statement (C2)
    98	
    99	    # Identity: the store's own lineage derives from the log with
   100	    # store_meta gone — the single strongest assertion in the gate.
   101	    lineage = log.lineage()
   102	    assert all(r["lin"] == lineage for r in records)
   103	
   104	    # Ordering: dense ordinals from 0, by walk verification.
   105	    assert [r["ord"] for r in records] == list(range(len(records)))
   106	
   107	    # Records: everything the store was exercised with is present and
   108	    # readable — facts with verbatim payload text, the declaration absorb,
   109	    # the seal.
   110	    kinds = [r["k"] for r in records]
   111	    assert kinds == ["genesis", "fact", "key", "fact", "fact", "tick"]
   112	    fact_bodies = [r["body"] for r in records if r["k"] == "fact"]
   113	    messages = [
   114	        json.loads(b["payload"]).get("message")
   115	        for b in fact_bodies
   116	        if b["kind"] == "note"
   117	    ]
   118	    assert messages == ["one", "two"]
   119	    decl = [b for b in fact_bodies if b["kind"] == DECL_GENESIS]
   120	    assert len(decl) == 1
   121	    assert decl[0]["id"] == lineage  # own_lineage, re-derivable from the log
   122	    assert set(json.loads(decl[0]["payload"])) == {"protocol", "documents"}
   123	    assert records[-1]["body"]["t"] == "tick"
   124	
   125	    # Authorship: every signature verifies from the log alone.
   126	    rows = verify_authorship(log, _verify)
   127	    assert {r.observer for r in rows} >= {"kyle", "ana"}
   128	
   129	
   130	# --- G2 ----------------------------------------------------------------------
   131	
   132	
   133	def test_g2_the_exclusivity_trace(tmp_path):
   134	    log_path, kyle, ana, intro_ordinal = _build_exercised_store(tmp_path)
   135	    _delete_every_projection(log_path)
   136	    assert not list(tmp_path.glob("*.vertex")), "no registry artifact exists at all"
   137	
   138	    log = ArrivalLog(log_path)
   139	    lineage = log.lineage()
   140	    rows = verify_authorship(log, _verify)
   141	
   142	    # Every signature in the log is covered by exactly one trace row.
   143	    signed = [r["ord"] for r in log.walk() if "sig" in r]
   144	    assert [r.ordinal for r in rows] == signed and signed
   145	
   146	    # The trace: (key, lineage, ordinal) — every verifying key resolves
   147	    # from a coordinate IN THIS LOG, and from nowhere else. The founding
   148	    # key resolves from the genesis coordinate; ana's from the stated
   149	    # introduction ordinal.
   150	    trace = [(r.key, r.introduced_lineage, r.introduced_ordinal) for r in rows]
   151	    assert all(lin == lineage for _, lin, _ in trace)
   152	    assert set(trace) == {
   153	        (kyle.public, lineage, 0),
   154	        (ana.public, lineage, intro_ordinal),
   155	    }
   156	    assert intro_ordinal == 2  # the stated ordinal, pinned
   157	
   158	    # The keys the trace names are IN the records at those coordinates —
   159	    # the coordinate is not a label, it is where the key lives.
   160	    assert log.read(0)["body"]["key"] == kyle.public
   161	    assert log.read(intro_ordinal)["body"]["key"] == ana.public
   162	
   163	
   164	def test_g2_the_verifier_consults_nothing_beside_the_log(tmp_path, monkeypatch):
   165	    """The exclusivity claim, checked mechanically: with the working
   166	    directory pointed at an empty directory and every projection gone, the
   167	    only file the verifier can possibly have read is the log it was
   168	    handed."""
   169	    log_path, kyle, ana, _ = _build_exercised_store(tmp_path)
   170	    _delete_every_projection(log_path)
   171	    elsewhere = tmp_path / "elsewhere"
   172	    elsewhere.mkdir()
   173	    monkeypatch.chdir(elsewhere)
   174	    rows = verify_authorship(ArrivalLog(log_path), _verify)
   175	    assert rows

