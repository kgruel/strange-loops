   436	@dataclass(frozen=True)
   437	class Rederivation:
   438	    """What a re-derivation did — counts, not a promise."""
   439	
   440	    lineage: str
   441	    ordinal: int
   442	    """The last record consumed; -1 when the log carried none."""
   443	    records: int
   444	    facts: int
   445	    ticks: int
   446	    projections: tuple[str, ...]
   447	
   448	
   449	def rederive_projections(
   450	    canonical: Path, *, derived_log: bool = False
   451	) -> Rederivation:
   452	    """Discard an arrival store's projections and rebuild them from the log.
   453	
   454	    The explicit operator verb. Building an ABSENT projection stays
   455	    automatic (an absent projection destroys nothing when built); an
   456	    EXISTING projection carrying rows is evidence, and discarding evidence
   457	    is an operator's decision — so it is spelled here, off the object the
   458	    write path holds.
   459	
   460	    Replays from **ordinal 0, never partially**: the rowids handed out by a
   461	    replay from empty reproduce the original assignment exactly, which is
   462	    what keeps outstanding witness positions and seals valid across a
   463	    re-derivation. A partial rebuild would renumber.
   464	
   465	    Refuses (:class:`~engine.arrival_store.ArrivalCanonicalUnsupported`)
   466	    when ``own_lineage`` is present and names a lineage other than the
   467	    log's — that index is some other log's projection, and silently
   468	    repointing it would be the strongest lie available in this design. The
   469	    check runs BEFORE anything is cleared.
   470	    """
   471	    canonical = Path(canonical)
   472	    log = ArrivalLog(canonical)
   473	    lineage = log.lineage()  # refuses when this is not an arrival log
   474	    index = index_path_for(canonical)
   475	
   476	    conn = sqlite3.connect(str(index))
   477	    conn.isolation_level = None  # explicit transaction control
   478	    try:
   479	        _ensure_index_schema(conn)
   480	        conn.execute("BEGIN IMMEDIATE")
   481	        try:
   482	            marker = _meta_get(conn, _OWN_LINEAGE_KEY)
   483	            if marker is not None and marker != lineage:
   484	                _unsupported(
   485	                    f"{index} carries an own_lineage marker of {marker!r}, "
   486	                    f"but the log at {canonical} opens lineage {lineage!r} — "
   487	                    "this index is some other log's projection; re-deriving "
   488	                    "it would repoint an identity claim rather than rebuild "
   489	                    "one"
   490	                )
   491	
   492	            conn.execute("DELETE FROM facts")
   493	            conn.execute("DELETE FROM ticks")
   494	            conn.execute("DROP TABLE IF EXISTS facts_fts")
   495	            conn.execute("DROP TABLE IF EXISTS fts_state")
   496	
   497	            records = facts = ticks = 0
   498	            last: ResumeMark | None = None
   499	            _, walked = log.walk_marked(None)
   500	            for record, mark in walked:
   501	                for t, row in rows_of_record(record):
   502	                    conn.execute(
   503	                        FACT_INSERT_SQL if t == "fact" else TICK_INSERT_SQL, row
   504	                    )
   505	                    if t == "fact":
   506	                        facts += 1
   507	                    else:
   508	                        ticks += 1
   509	                records += 1
   510	                last = mark
   511	
   512	            own = licensed_own_lineage(conn, lineage)
   513	            if own is not None:
   514	                _meta_set(conn, _OWN_LINEAGE_KEY, own)
   515	            if last is not None:
   516	                _stamp_mark(conn, last)
   517	            conn.execute("COMMIT")
   518	        except BaseException:
   519	            conn.execute("ROLLBACK")
   520	            raise
   521	    finally:
   522	        conn.close()
   523	
   524	    if derived_log:
   525	        # Derived from the arrival log, in its own pass, AFTER the index
   526	        # transaction closed — never from the rows just written. A
   527	        # projection of a projection would let a poisoned index launder
   528	        # itself into a second artifact.
   529	        write_derived_log(canonical)
   530	    projections = ("index", "derived-log") if derived_log else ("index",)
   531	    return Rederivation(
   532	        lineage=lineage,
   533	        ordinal=-1 if last is None else last.arrival_ordinal,
   534	        records=records,
   535	        facts=facts,
   536	        ticks=ticks,
   537	        projections=projections,
   538	    )
   539	
