        if mark is None:
            return None
        if not self.path.exists():
            return None
        try:
            lineage = self.lineage()
        except (GenesisRefused, ArrivalError):
            return None
        if mark.arrival_lineage != lineage:
            return None
        if not _is_int(mark.arrival_offset) or not _is_int(mark.arrival_ordinal):
