   570	def diff_interval_report(
   571	    store_path: Path,
   572	    pos1: WitnessPosition,
   573	    pos2: WitnessPosition,
   574	    *,
   575	    timeout: float = 5.0,
   500	                if deserialize.__func__ is Fact.from_dict.__func__:
   501	                    self._fact_class = Fact
   502	                    self._direct_fact_build = True
