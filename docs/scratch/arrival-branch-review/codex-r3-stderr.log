   400	        byte reaches the log and a refused write can never orphan a record.
   401	        The record's body is the codec's object for the COMMITTED read-back
   402	        row — the index and the log must derive-match. The record's arrival signature comes from
   403	        the injected ``fact_signer`` over the arrival commitment; the same
   404	        callable, a different digest, and the composing layer's
   405	        domain-separation prefix already binds both to this store family.
   406	
   407	        A record another writer lands in the log between the reconcile and
   408	        the append would otherwise be skipped forever: our record arrives
   409	        one ordinal later and the stamped mark would claim consumption it
   410	        never performed. The append's own coordinate is the tell — when it
   411	        is not the reconciled ordinal plus one, the staged INSERT rolls
   412	        back (our record is already durable in the log) and catch-up
   413	        consumes everything forward instead, the interloper included. The
   414	        returned signature is the committed row's either way: catch-up
   415	        re-inserts the identical row verbatim from the record's body.
   416	        """
   417	        consumed = self._reconcile()
   418	        # Codec pre-flight on the ASSEMBLED row, NOT dead work: sqlite's
   419	        # column affinity coerces (e.g. a string ts commits as REAL), so the
   420	        # committed-row encode below would ACCEPT a row the codec refuses
   421	        # — this is the gate that fails at the append site, where it is
   422	        # attributable, instead of laundering the value.
   423	        encode_row(row)
   424	        try:
   425	            self._db.execute(sql, row)
   426	            committed_row = self._committed_full_row(
   427	                "facts" if is_fact else "ticks", row[0]
   428	            )
   429	            committed = committed_row[-1]  # signature is the last column
   430	            body = encode_row(committed_row)
   431	            record, mark = self._log.append_marked(
   432	                "fact" if is_fact else "tick",
   433	                body,
   434	                observer=committed_row[3] if is_fact else committed_row[1],
   435	                origin=committed_row[4],
   436	                at=committed_row[2],
   437	                signer=self._fact_signer if is_fact else None,
   438	            )
   439	            # consumed is None on one REACHABLE interleave: the log was
   440	            # empty at reconcile time and another process minted the
   441	            # genesis inside the reconcile->append gap. Legal interleave is
   442	            # refuse-or-consume, never crash — so a missing reconciled mark
   443	            # takes the same gap path as a stale one: roll back and consume
   444	            # everything forward, the fresh genesis included.
   445	            if consumed is None or record["ord"] != consumed.arrival_ordinal + 1:
   446	                self._db.rollback()
   447	                self.catch_up()
   448	                return committed
   449	            self._stamp_mark(mark)
   450	            self._db.commit()
   451	            return committed
   452	        except BaseException:
   453	            self._db.rollback()
   454	            raise
