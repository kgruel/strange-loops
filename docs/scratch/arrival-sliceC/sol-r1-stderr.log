   102	@pytest.mark.parametrize(
   103	    "vector_path", _load_vectors(LENS_VECTORS_DIR), ids=lambda p: p.stem
   104	)
   105	def test_conformance_lens(vector_path: Path, tmp_path: Path) -> None:
   106	    with open(vector_path, encoding="utf-8") as f:
   107	        vector = json.load(f)
   108	
   109	    for key in ("name", "description", "input", "expected"):
   110	        assert key in vector, f"Vector {vector_path} missing {key!r}"
   111	
   112	    kind = vector["input"]["kind"]
   113	    parent = _build_combine_vertex(tmp_path, kind, vector["input"]["members"])
   114	
   115	    rows = vertex_facts(parent, 0.0, float("inf"), kind=kind)
   116	    ordering = _decode_ordering(vector["input"].get("ordering"))
   117	
   118	    if ordering == DEFAULT_ORDERING:
   119	        # The production combined read's (ts ASC, id ASC) IS this declaration.
   120	        assert [r["id"] for r in rows] == vector["expected"]["lens_order"]
   121	        return
   122	
   123	    if "error" in vector["expected"]:
   124	        with pytest.raises(OrderingError):
   125	            _totalize_rows(rows, ordering)
   126	        return
   127	
   128	    ordered = _totalize_rows(rows, ordering)
   129	    assert [r["id"] for r in ordered] == vector["expected"]["lens_order"]
   130	
   131	
   132	def test_lens_area_is_not_empty() -> None:
   133	    """Guard the discovery glob: an empty area would pass vacuously."""
   134	    assert _load_vectors(LENS_VECTORS_DIR), "no lens vectors discovered"
   135	
   136	
   137	def test_lens_area_covers_both_key_families_and_a_refusal() -> None:
   138	    """Guard the key axis itself.
   139	
   140	    The runner branches three ways; a vector set that lost its non-default-key
   141	    family, or its refusal case, would still pass every parametrized case while
   142	    silently exercising only the ts arm.
   143	    """
   144	    orderings, refusals = [], 0
   145	    for path in _load_vectors(LENS_VECTORS_DIR):
   146	        with path.open(encoding="utf-8") as f:
   147	            vector = json.load(f)
   148	        orderings.append(_decode_ordering(vector["input"].get("ordering")))
   149	        refusals += "error" in vector["expected"]
   150	
   151	    assert DEFAULT_ORDERING in orderings, "ts family missing"
   152	    assert any(o != DEFAULT_ORDERING for o in orderings), "no non-ts key family"
   153	    assert refusals, "no refusal vector"
   154	
   155	
   156	#: An adversarial record set for the cross-surface check: the payload key
   157	#: `seq`, the envelope `ts` and the envelope `id` each impose a DIFFERENT
   158	#: order (mirroring `lens-by-key-payload-seq`), so two surfaces that disagree
   159	#: about where a key resolves cannot accidentally agree on the sequence.
   160	_CROSS_SURFACE_FACTS = [
   161	    ("01TESTULID0000000000000003", {"kind": "record", "ts": 1000.0,
   162	     "payload": {"seq": 2}, "observer": "kyle"}),
   163	    ("01TESTULID0000000000000001", {"kind": "record", "ts": 3000.0,
   164	     "payload": {"seq": 3}, "observer": "kyle"}),
   165	    ("01TESTULID0000000000000002", {"kind": "record", "ts": 2000.0,
   166	     "payload": {"seq": 1, "kind": "in-the-payload"}, "observer": "kyle"}),
   167	]
   168	
   169	
   170	@pytest.mark.parametrize(
   171	    "field,expected_size", [("ts", 3), ("id", 3), ("seq", 3), ("kind", 1)]
   172	)
   173	def test_ordered_and_the_lens_resolver_agree_on_the_key_family(
   174	    field: str, expected_size: int, tmp_path: Path
   175	) -> None:
   176	    """`StoreReader.ordered` and the conformance lens read one declaration alike.
   177	
   178	    The family rule (`ts`/`id` from the envelope, everything else from the
   179	    payload) is `atoms.resolve_key_field`, but sharing a function only helps
   180	    if every surface actually routes through it. This holds the two ends
   181	    against each other on all three arms: an envelope key that is
   182	    column-backed (`ts`), an envelope key that is the id itself, and a payload
   183	    key, and a stored column that is NOT an envelope key (`kind`), which
   184	    resolves against the payload like any other declared key. Under the
   185	    payload-only resolver `ordered` used to carry, the `ts` arm returns []
   186	    against a full lens order; under a resolver that treats every stored
   187	    column as envelope-backed, the `kind` arm returns all three.
   188	    """
   189	    from atoms import ByKey
   190	    from engine.store_reader import StoreReader
   191	
   192	    parent = _build_combine_vertex(
   193	        tmp_path, "record", {"a": [(fid, f) for fid, f in _CROSS_SURFACE_FACTS]}
   194	    )
   195	    rows = vertex_facts(parent, 0.0, float("inf"), kind="record")
   196	    lens_order = [r["id"] for r in _totalize_rows(rows, ByKey(field))]
   197	
   198	    with StoreReader(tmp_path / "a.db") as reader:
   199	        reader_order = [f["id"] for f in reader.ordered(len(rows), ByKey(field))]
   200	
   201	    assert reader_order == lens_order
   202	    # Guard against a vacuous pass: each arm's size is pinned, so an
   203	    # agreed-upon EMPTY projection can never stand in for agreement.
   204	    assert len(lens_order) == expected_size

