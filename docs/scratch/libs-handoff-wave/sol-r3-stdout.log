   467	    # ---- the write path ----------------------------------------------
   468	
   469	    def _append_line(self, line: str) -> int:
   470	        """Append one durable line; return the log size after it.
   471	
   472	        fsync, not just flush: the receipt is minted here, so the line must
   473	        outlive a power cut, not merely a process crash.
   474	        """
   475	        self._log_path.parent.mkdir(parents=True, exist_ok=True)
   476	        data = (line + "\n").encode("utf-8")
   477	        with self._log_path.open("ab") as fh:
   478	            fh.write(data)
   479	            fh.flush()
   480	            os.fsync(fh.fileno())
