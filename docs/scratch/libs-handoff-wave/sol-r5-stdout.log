   368	def _assert_unique_kind_nodes(text: str, context: str) -> None:
   369	    """Refuse duplicate loop-kind nodes in the INPUT (SOL-R3-01 part a).
   370	
   371	    The parser collapses duplicate kind names last-wins, so the parser
   372	    oracle is structurally blind to them: a splice that loses one physical
   373	    duplicate parses definition-equal. Duplicates in the input are
   374	    pathological — a pre-condition refusal on the raw text, not a safety
   375	    detector; the parser oracle remains the post-condition authority.
   376	    """
   377	    from collections import Counter
   378	
   379	    counted = Counter(
   380	        n for n in _loops_block_child_names(text)
   381	        if n not in _RESERVED_KIND_NAMES
   382	    )
   383	    dupes = sorted(n for n, c in counted.items() if c > 1)
   384	    if dupes:
   385	        raise ValueError(
   386	            f"{context}: duplicate loop-kind declaration(s) {dupes} in the "
   387	            "loops block — the parser resolves duplicates last-wins, so a "
   388	            "text mutation over them cannot be verified; deduplicate the "
   389	            "vertex by hand first"
   390	        )
