{
  "name": "replay-timestamp-tie-id-asc",
  "description": "Pins decision:design/replay-total-order: when two facts share identical timestamps, replay tie-breaks by fact ID ascending (id ASC), regardless of append order.",
  "input": {
    "spec": {
      "name": "record",
      "state_fields": [
        {
          "name": "items",
          "kind": "dict"
        },
        {
          "name": "history",
          "kind": "list"
        }
      ],
      "folds": [
        {
          "op": "collect",
          "target": "history"
        },
        {
          "op": "upsert",
          "target": "items",
          "key": "k"
        }
      ]
    },
    "facts": [
      [
        "01TESTULID0000000000000002",
        {
          "kind": "record",
          "ts": 1000.0,
          "payload": {
            "k": "same_key",
            "val": "from_higher_id"
          },
          "observer": "kyle",
          "origin": ""
        }
      ],
      [
        "01TESTULID0000000000000001",
        {
          "kind": "record",
          "ts": 1000.0,
          "payload": {
            "k": "same_key",
            "val": "from_lower_id"
          },
          "observer": "kyle",
          "origin": ""
        }
      ]
    ]
  },
  "expected": {
    "items": {
      "same_key": {
        "k": "same_key",
        "val": "from_lower_id",
        "_ts": 1000.0,
        "_observer": "kyle",
        "_origin": "",
        "_id": "01TESTULID0000000000000001",
        "_n": 2
      }
    },
    "history": [
      {
        "k": "same_key",
        "val": "from_higher_id",
        "_ts": 1000.0,
        "_observer": "kyle",
        "_origin": "",
        "_id": "01TESTULID0000000000000002"
      },
      {
        "k": "same_key",
        "val": "from_lower_id",
        "_ts": 1000.0,
        "_observer": "kyle",
        "_origin": "",
        "_id": "01TESTULID0000000000000001"
      }
    ]
  }
}
