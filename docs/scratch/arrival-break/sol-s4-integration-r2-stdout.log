diff --git a//tmp/sol-s4-r2/probe_comment.py b//tmp/sol-s4-r2/probe_comment.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec230e1b79c179ce5d3ce1b2b971e88d8337ddb2
--- /dev/null
+++ b//tmp/sol-s4-r2/probe_comment.py
@@ -0,0 +1,29 @@
+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from migrate import edit_vertex_store_clause
+
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    vertex = Path(tmp) / "project.vertex"
+    marker = "// retain: operator chose this archive"
+    original = f'''name "display"
+  store "./legacy.jsonl" backend="old"   {marker}
+loops {{ probe {{ fold {{ items "collect" 10 }} }} }}
+'''
+    vertex.write_text(original, encoding="utf-8")
+    edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+    edited = vertex.read_text(encoding="utf-8")
+    old_line = original.splitlines(keepends=True)[1]
+    new_line = edited.splitlines(keepends=True)[1]
+    old_tail = old_line[old_line.index(marker) - 3:]
+    new_tail = new_line[new_line.index(marker) - 3:]
+    print(f"edited_store_line={new_line.rstrip()}")
+    print(f"trailing_bytes_preserved={new_tail == old_tail}")
+    print(f"other_lines_byte_equal={original.splitlines(keepends=True)[0:1] + original.splitlines(keepends=True)[2:] == edited.splitlines(keepends=True)[0:1] + edited.splitlines(keepends=True)[2:]}")
+    assert new_tail == old_tail
+    assert marker in edited
+
+print("PASS: same-line trailing bytes survive surgical publish")
