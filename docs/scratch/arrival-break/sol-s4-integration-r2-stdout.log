-   683	        MigrationRefused: On any source defect, resume mismatch, torn tail,
-   684	            preflight failure, or precondition violation.
-   685	        FileNotFoundError: If source or vertex file does not exist.
-   686	    """
-   687	    src_path = Path(source_path).resolve()
-   688	    v_path = Path(vertex_path).resolve()
-   689	    s_dir = Path(store_dir).resolve()
-   690	
