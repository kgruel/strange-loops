   157	
   158	
   159	def serialize_fact_row(row: tuple) -> str:
   160	    """Encode a fact row ``(id, kind, ts, observer, origin, payload[, signature])``."""
   161	    return _dump(_encode_obj(row, _SPEC["fact"]))
   162	
   163	
   164	def serialize_tick_row(row: tuple) -> str:
   165	    """Encode a tick row (``_TICK_ROW_SQL`` order, signature optional)."""
   166	    return _dump(_encode_obj(row, _SPEC["tick"]))
   167	
   168	
   169	def serialize_batch(rows: list[tuple]) -> str:
   170	    """Encode a multi-row ceremony as ONE atomic line.
   171	
   172	    ``rows`` are fact row tuples in emission order. One row collapses to a
   173	    plain fact line — a 1-row batch would be a second spelling of the same
   174	    record (the "signature must be absent, not null" ethos), so the envelope
   175	    exists only where multi-row atomicity does. Zero rows is a caller bug.
   176	
   177	    Same both-directions symmetry as the scalar serializers: the built
   178	    envelope is held to :func:`_validate_batch` before dumping, so a bad row
   179	    fails at the append site instead of bricking every later open.
   180	    """
