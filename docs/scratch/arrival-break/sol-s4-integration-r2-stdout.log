from __future__ import annotations

import json
import sys
from pathlib import Path

from migrate import LegacySourceRefused, inventory


root = Path("/tmp/sol-s4-r1/gf3")
root.mkdir(parents=True, exist_ok=True)
source = root / "multi-class.jsonl"
target = root / "must-not-exist.arrival"
if target.exists():
    target.unlink()


def fact(row_id: str, observer: str) -> dict[str, object]:
    return {
        "t": "fact",
        "id": row_id,
        "kind": "probe",
        "ts": 1.0,
        "observer": observer,
        "origin": "probe",
        "payload": "{}",
    }


source.write_text(
    json.dumps(
        {
            "t": "batch",
            "rows": [
                fact("a", "alice"),
                fact("b", "bob"),
                fact("c", ""),
            ],
        },
        separators=(",", ":"),
    )
    + "\n",
    encoding="utf-8",
)

try:
    inventory(source)
except LegacySourceRefused as exc:
    print(f"codec_invalid_lines={exc.codec_invalid_lines!r}")
    print(f"mixed_observer_lines={exc.mixed_observer_lines!r}")
    print(f"absent_observer_lines={exc.absent_observer_lines!r}")
    print(f"target_exists={target.exists()}")
    if (
        exc.mixed_observer_lines == ((1, ("alice", "bob"), 1),)
        and exc.absent_observer_lines == ((1, 1, ("alice", "bob"), {"empty": 1}),)
        and not target.exists()
    ):
        print("PASS: every applicable class enumerated with empty spelling preserved")
        raise SystemExit(0)
    print("FAIL: the offending line was not enumerated in every applicable class")
    raise SystemExit(1)
else:
    print("FAIL: defective mixed+empty batch was accepted")
    raise SystemExit(2)
