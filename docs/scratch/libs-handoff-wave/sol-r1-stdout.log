     1	"""Declared admission policy at the engine boundary (libs-handoff S3).
     2	
     3	Two coupled contracts:
     4	
     5	* Observer-grant resolution (LIBS_CHANGES P1): ``grant_for_observer`` +
     6	  ``VertexProgram.receive_as`` / ``VertexHandle.receive_as`` resolve the
     7	  declaration's ``observers { grant { potential } }`` automatically. Five
     8	  cases — no observers block, unknown observer, declared without grant,
     9	  declared with potential, aggregate — each proven both ways: the enforced
    10	  path rejects/admits per declaration, and the explicit bypass (the raw
    11	  ``receive`` entry) admits.
    12	* Strict enforcement (decision:design/strict-enforcement-at-engine-receive):
    13	  ``strict true`` makes ``Vertex.receive_receipt`` refuse undeclared kinds
    14	  with typed ``UndeclaredKind`` BEFORE storage; bypass only via the explicit
    15	  ``admit_undeclared=True``. Non-strict behavior is preserved verbatim —
    16	  undeclared facts store, read raw, and fold once the kind is declared.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import json
    22	import sqlite3
    23	from pathlib import Path
    24	
    25	import pytest
    26	from atoms import Fact
    27	
    28	from engine.admission import (
    29	    AdmissionError,
    30	    AggregateAdmissionUnsupported,
    31	    UndeclaredKind,
