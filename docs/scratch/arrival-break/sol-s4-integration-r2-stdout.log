    37	def _format_absent_desc(spelling_map: dict[str, int]) -> str:
    38	    empty_cnt = spelling_map.get("empty", 0)
    39	    missing_cnt = spelling_map.get("missing", 0)
    40	    absent_count = empty_cnt + missing_cnt
    41	
    42	    if empty_cnt > 0 and missing_cnt == 0:
    43	        return f"{absent_count} row(s) with observer='' (empty string)"
    44	    elif missing_cnt > 0 and empty_cnt == 0:
    45	        return f"{absent_count} row(s) missing 'observer' field"
    46	    elif empty_cnt > 0 and missing_cnt > 0:
    47	        return (
    48	            f"{absent_count} row(s) with absent/empty observer "
    49	            f"({missing_cnt} missing, {empty_cnt} empty '')"
    50	        )
    51	    else:
    52	        return f"{absent_count} row(s) missing 'observer' field"
    53	
