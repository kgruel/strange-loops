  1454	def test_replaying_the_predecessor_with_the_reset_does_not_reopen_the_epoch():
  1455	    """Sol r2's repro. Identity alone was defeated by replaying CONTEXT.
  1456	
  1457	    Re-appending the historical predecessor and the reset as an ordered suffix
  1458	    reproduces the recorded identity exactly — the entry the copy names really
  1459	    is sitting in front of it. Identity was the right kind of binding and the
  1460	    wrong amount of it: it is a property of the bytes, so bytes can carry it.
  1461	
  1462	    The physical line cannot be carried. Copied bytes appended later land
  1463	    later, so the position claim is stale no matter how much surrounding
  1464	    context comes with them, which is what makes this close the class rather
  1465	    than the instance.
  1466	    """
  1467	    legitimate = _journal_reset_at_5_then_advanced_to_8()
  1468	    predecessor = observation(10)
  1469	
  1470	    append_entry(predecessor)  # the context, replayed
  1471	    append_entry(legitimate)  # and the reset behind it
  1472	
  1473	    result = read_journal(LINEAGE)
  1474	    # BOTH copied lines are literal replays, so both are skipped — the reset
  1475	    # and the advance that was replayed to give it its context. Neither the
  1476	    # epoch nor K moves.
  1477	    duplicates = [note for note in result.skipped if "byte-identical" in note]
  1478	    assert len(duplicates) == 2, result.skipped
  1479	    assert isinstance(result.known, EstablishedHead)
  1480	    assert result.established_head().head.ordinal == 8
  1481	    assert compare(result.established_head(), head(5), None) is Outcome.ROLLBACK
