   292	
   293	# Delimiters of KDL string syntax the lexical scanners cannot track.
   294	# ``#"`` opens (and ``"#`` closes) a raw string of any hash depth — matching
   295	# either substring anywhere (even inside a plain string) is deliberately
   296	# over-broad: refusal is the cheap, permanent answer (zero raw strings in the
   297	# .vertex corpus). ``\"\"\"`` is a KDL multi-line string opener, equally
   298	# untrackable by the single-line quote scan.
   299	_UNPROVABLE_DELIMITERS = ('#"', '"#', '"""')
   300	
   301	
   302	def _assert_scanner_provable_domain(text: str, context: str) -> None:
   303	    """Refuse mutation over syntax the lexical scanners cannot prove safe.
   304	
   305	    See the module docstring's PROVABLE DOMAIN contract (SOL-R4-01). The
   306	    scan covers the WHOLE vertex text, not just the ``loops`` block: the
   307	    block span itself is found by the same raw-string-blind line scan, so a
   308	    raw string outside the block could corrupt the span the guards inspect.
   309	    """
   310	    for delim in _UNPROVABLE_DELIMITERS:
   311	        if delim in text:
   312	            raise ValueError(
   313	                f"{context}: the vertex text contains {delim!r} — KDL "
   314	                "raw-string / multi-line-string syntax the mutation "
   315	                "scanner cannot prove safe to splice over (its guards "
   316	                'track plain "…" strings only); edit the file by hand'
   317	            )
