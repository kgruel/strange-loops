   177	def _found_claims() -> set[tuple[str, str]]:
   178	    """Every (path, line) where ts-ordering is stated near fold vocabulary."""
   179	    found: set[tuple[str, str]] = set()
   180	    for path in _scan_targets():
   181	        rel = str(path.relative_to(REPO_ROOT))
   182	        try:
   183	            lines = path.read_text().splitlines()
   184	        except (OSError, UnicodeDecodeError):
   185	            continue
   186	        for i, line in enumerate(lines):
   187	            if not _TS_ORDER.search(line):
   188	                continue
   189	            window = "\n".join(lines[max(0, i - _WINDOW) : i + _WINDOW + 1])
   190	            if _FOLD_VOCAB.search(window):
   191	                found.add((rel, line.strip()))
   192	    return found
   193	
