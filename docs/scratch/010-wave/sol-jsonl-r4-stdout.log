   187	def _tick_status_style(status: str):
   188	    """Map tick status to a palette style."""
   189	    from painted.palette import current_palette
   190	
   191	    p = current_palette()
   192	    if status == "completed":
   193	        return p.success
   194	    if status == "errored":
   195	        return p.error
   196	    if status == "exhausted":
   197	        return p.warning
   198	    return p.accent
