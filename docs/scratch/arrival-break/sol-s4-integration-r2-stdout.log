--- /dev/null
+++ b//tmp/sol-s4-r2/probe_scanner_raw.py
@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from lang import effective_store_clause, parse_vertex_file
+from migrate import PublishPreconditionRefused, edit_vertex_store_clause
+
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    vertex = Path(tmp) / "project.vertex"
+    text = '''name r#"project " store decoy"#
+store "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+'''
+    vertex.write_text(text, encoding="utf-8")
+    parsed = parse_vertex_file(vertex)
+    located = effective_store_clause(text, vertex)
+    located_slice = text[slice(*located.span)] if located.span else None
+    before = vertex.read_bytes()
+    print(f"parsed_name={parsed.name!r} parsed_store={str(parsed.store)!r}")
+    print(f"count={located.count} span={located.span} slice={located_slice!r}")
+    try:
+        edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+    except PublishPreconditionRefused as exc:
+        print(f"edit=REFUSED condition={exc.condition} file_unchanged={vertex.read_bytes() == before}")
+        assert vertex.read_bytes() == before
+    else:
+        print("edit=ACCEPTED")
+    real_start = text.index('store "./legacy.jsonl"')
+    if located.span != (real_start, real_start + len('store "./legacy.jsonl"')):
+        print("FAIL: hash-raw string decoy captured instead of the effective store clause")
+        raise SystemExit(1)
+
+print("PASS: hash-raw strings are modeled by the source locator")

