   375	        if origin:
   376	            lines.append(Block.text(f"      origin={origin}", p.muted))
   377	        return lines
   378	
   379	    # DETAILED: normal tick line + origin continuation
   380	    lines = [tick_line(tick)]
   381	    if origin:
   382	        lines.append(Block.text(f"      origin={origin}", p.muted))
   383	    return lines
