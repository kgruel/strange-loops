    66	class Fact:
    67	    """An intentional observation — something that happened at a specific time.
    68	
    69	    Kind is an open string (no enum, no constrained set). Structure comes
    70	    from Shape, not from kind.
    71	
    72	    Attributes:
    73	        kind: Open, domain-specific routing key ("heartbeat", "deploy", etc.)
    74	        ts: Epoch seconds (float) — when observed. Display formatting is caller's problem.
    75	        payload: The details — Shape knows the structure
    76	        observer: Who produced this observation (required)
    77	        origin: Which loop/vertex produced this fact ("" for external observations,
    78	                non-empty for derived facts from tick-to-fact bridging)
    79	    """
    80	
    81	    __slots__ = ("kind", "ts", "payload", "observer", "origin")
    82	    __match_args__ = ("kind", "ts", "payload", "observer", "origin")
    83	    __dataclass_fields__ = _LazyDataclassFields()
    84	
    85	    def __class_getitem__(cls, item):
    86	        return cls
    87	
    88	    def __init__(self, kind: str, ts: float, payload=None, observer: str = "", origin: str = "") -> None:
    89	        object.__setattr__(self, "kind", kind)
    90	        object.__setattr__(self, "ts", ts)
    91	        if isinstance(payload, dict):
    92	            object.__setattr__(self, "payload", MappingProxyType(dict(payload)))
    93	        else:
    94	            object.__setattr__(self, "payload", payload)
    95	        object.__setattr__(self, "observer", observer)
    96	        object.__setattr__(self, "origin", origin)
    97	
    98	    def __setattr__(self, name, value):
    99	        from dataclasses import FrozenInstanceError
   100	        raise FrozenInstanceError("cannot assign to field")
   101	
   102	    def __delattr__(self, name):
   103	        from dataclasses import FrozenInstanceError
   104	        raise FrozenInstanceError("cannot assign to field")
   105	
   106	    def __eq__(self, other):
   107	        if not isinstance(other, Fact):
   108	            return NotImplemented
   109	        return (self.kind, self.ts, self.payload, self.observer, self.origin) == \
   110	               (other.kind, other.ts, other.payload, other.observer, other.origin)
   111	
   112	    def __hash__(self):
   113	        return hash((self.kind, self.ts, _freeze(self.payload), self.observer, self.origin))
   114	
   115	    def __repr__(self):
   116	        return (f"Fact(kind={self.kind!r}, ts={self.ts!r}, payload={self.payload!r}, "
   117	                f"observer={self.observer!r}, origin={self.origin!r})")
