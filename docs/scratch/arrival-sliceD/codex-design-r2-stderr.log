   142	def _encode_obj(row: tuple, spec: _Spec) -> dict:
   143	    """Build the line object for a row — and hold it to the decoder's rules.
   144	
   145	    ``serialize(x)`` must always be decodable. Checking arity alone let a
   146	    row with a *typed*-wrong field through: a fact carrying ``ts="1.0"``
   147	    (a string, which sqlite's REAL affinity accepts) got a durable JSONL
   148	    receipt, and then every subsequent open failed on decode — the store
   149	    bricked by a line its own serializer wrote. Running the decoder's
   150	    :func:`_validate` over the object before dumping makes the two
   151	    directions symmetric by construction rather than by parallel
   152	    maintenance, and puts the error at the append site, where it is
   153	    attributable to the caller that built the row.
   154	    """
   155	    n = len(spec.fields)
   156	    if len(row) not in (n, n + 1):
   157	        raise JsonlCodecError(
   158	            f"{spec.t} row must have {n} or {n + 1} fields, got {len(row)}"
   159	        )
