  1535	# ---------------------------------------------------------------------------
  1536	# Authorship — the first verifier
  1537	# ---------------------------------------------------------------------------
  1538	
  1539	
  1540	@dataclass(frozen=True)
  1541	class KeyResolution:
  1542	    """Where one verified signature's key came from — a coordinate, always.
  1543	
  1544	    One row per verified signature, and the row IS the exclusivity claim
  1545	    made checkable: ``key`` was resolved from ``(introduced_lineage,
  1546	    introduced_ordinal)`` in the log, and from nowhere else. ``ordinal`` is
  1547	    the record whose signature the key verified; ``observer`` is who the
  1548	    log says that key speaks for.
  1549	    """
  1550	
  1551	    ordinal: int
  1552	    observer: str
  1553	    key: str
  1554	    introduced_lineage: str
  1555	    introduced_ordinal: int
  1556	
  1557	
  1558	def verify_authorship(log: ArrivalLog, verify: Verify) -> tuple[KeyResolution, ...]:
  1559	    """Verify every signature in the log, resolving keys from the log alone.
  1560	
  1561	    The ruled rule, implemented verbatim (decision:design/arrival-sliceA-
  1562	    authority): **a key is valid at position N iff it was introduced at a
  1563	    position < N, or N is the genesis position and the record is
  1564	    self-certifying.** Self-certification is legal at ordinal 0 and nowhere
  1565	    else — the genesis signature must verify against its own
  1566	    ``body["key"]``, which is what turns a self-naming genesis into a
  1567	    self-certifying one. A key introduction at ordinal >= 1
  1568	    (:data:`KEY_INTRODUCTION_KIND`) is a record whose body names an
  1569	    observer and a key, signed by a key already valid for the INTRODUCING
  1570	    record's observer; only after that signature verifies does the named
  1571	    key join the registry, at the introduction's own ordinal.
  1572	
  1573	    Keys are bound to observers, not free-floating (an instantiation
  1574	    decision recorded in the slice-A design fact): the genesis key speaks
  1575	    for the genesis record's observer, an introduced key for the observer
  1576	    its body names. A record's signature is tried against every key valid
  1577	    for that record's OWN observer at its position — observer-agnostic
  1578	    resolution would let one observer's record verify under another's key,
  1579	    and authorship would stop being an answer.
  1580	
  1581	    Resolution consults the log and nothing else — no registry file, no
  1582	    projection, no artifact beside the log (the ruled exclusivity claim).
  1583	    ``verify`` is injected, never imported, same posture as :data:`Signer`.
  1584	
  1585	    Walks the whole log via :meth:`ArrivalLog.walk`, so structural
  1586	    integrity is established for free; this is an O(n) surface where the
  1587	    whole file is the question. Unsigned non-genesis records make no
  1588	    authorship claim and produce no row. Returns one
  1589	    :class:`KeyResolution` per verified signature, in log order; raises
  1590	    :class:`AuthorshipUnverified` on the first signature that no valid key
  1591	    verifies.
  1592	    """
  1593	    # observer -> [(key, introduced_ordinal)] in introduction order.
  1594	    registry: dict[str, list[tuple[str, int]]] = {}
  1595	    rows: list[KeyResolution] = []
  1596	
  1597	    for record in log.walk():
  1598	        ordinal = record["ord"]
  1599	        # The walk holds every record to the genesis's lineage, so this is
  1600	        # one value for the whole loop; re-read per record for simplicity.
  1601	        lineage = record["lin"]
  1602	
  1603	        if ordinal == 0:
  1604	            # Genesis: self-certifying, and only here. The walk already held
  1605	            # it to every structural genesis rule, key shape included.
  1606	            key = record["body"]["key"]
  1607	            digest = _commitment_of(record)
  1608	            if not verify(key, record[_SIG], digest):
  1609	                raise AuthorshipUnverified(
  1610	                    "genesis signature does not verify against the founding "
  1611	                    "key its own body carries — the log is not "
  1612	                    "self-certifying",
  1613	                    0,
  1614	                )
  1615	            registry[record["observer"]] = [(key, 0)]
  1616	            rows.append(
  1617	                KeyResolution(
  1618	                    ordinal=0,
  1619	                    observer=record["observer"],
  1620	                    key=key,
  1621	                    introduced_lineage=record["lin"],
  1622	                    introduced_ordinal=0,
  1623	                )
  1624	            )
  1625	            continue
  1626	
  1627	        if _SIG in record:
  1628	            rows.append(_resolve(record, registry, lineage, verify))
  1629	        if record["k"] == KEY_INTRODUCTION_KIND:
  1630	            # The signature just verified under an already-valid key (the
  1631	            # placement rules make an unsigned introduction unspellable),
  1632	            # so the named key joins the registry at THIS ordinal: valid
  1633	            # strictly after it, per the ruled clause.
  1634	            named = record["body"]["observer"]
  1635	            registry.setdefault(named, []).append((record["body"]["key"], ordinal))
  1636	
  1637	    return tuple(rows)
  1638	
  1639	
  1640	def _resolve(
  1641	    record: dict,
  1642	    registry: dict[str, list[tuple[str, int]]],
  1643	    lineage: str,
  1644	    verify: Verify,
  1645	) -> KeyResolution:
  1646	    """Resolve the key that verifies ``record``'s signature, or refuse.
  1647	
  1648	    Tries, in introduction order, every key the log introduced for this
  1649	    record's observer at a position strictly before the record's own. The
  1650	    record's own body is deliberately never consulted — that would be
  1651	    self-certification above ordinal 0, which the ruled rule forbids.
  1652	    """
  1653	    ordinal = record["ord"]
  1654	    digest = _commitment_of(record)
  1655	    candidates = [
  1656	        (key, introduced)
  1657	        for key, introduced in registry.get(record["observer"], [])
  1658	        if introduced < ordinal
  1659	    ]
  1660	    for key, introduced in candidates:
  1661	        if verify(key, record[_SIG], digest):
  1662	            return KeyResolution(
  1663	                ordinal=ordinal,
  1664	                observer=record["observer"],
  1665	                key=key,
  1666	                introduced_lineage=lineage,
  1667	                introduced_ordinal=introduced,
  1668	            )
  1669	    if not candidates:
  1670	        raise AuthorshipUnverified(
  1671	            f"no key valid for observer {record['observer']!r} at this "
  1672	            "position — a key is valid at N only when introduced at a "
  1673	            "position strictly before N",
  1674	            ordinal,
  1675	        )
  1676	    raise AuthorshipUnverified(
  1677	        f"signature verifies under none of the {len(candidates)} key(s) the "
  1678	        f"log introduced for observer {record['observer']!r} before this "
  1679	        "position",
  1680	        ordinal,
  1681	    )
  1682	
  1683	
  1684	def _commitment_of(record: dict) -> str:
  1685	    """The content commitment a record's signature covers."""
  1686	    return content_commitment(
  1687	        record["k"], record["at"], record["observer"], record["origin"],
  1688	        record["body"],
  1689	    )
  1690	
  1691	
  1692	# ---------------------------------------------------------------------------
  1693	# Byte helpers
  1694	# ---------------------------------------------------------------------------
  1695	
  1696	
  1697	def _last_newline_before(fh, end: int) -> int:
  1698	    """Byte offset just past the last ``\\n`` strictly before ``end``.
  1699	
  1700	    Scans backwards in chunks — never loads the whole log, and never gives up
  1701	    as a function of line length. 0 when there is none.
  1702	    """
  1703	    pos = end
  1704	    while pos > 0:
  1705	        start = max(0, pos - _CHUNK)
  1706	        fh.seek(start)
  1707	        chunk = fh.read(pos - start)
  1708	        idx = chunk.rfind(b"\n")
  1709	        if idx != -1:
  1710	            return start + idx + 1
  1711	        pos = start
  1712	    return 0
  1713	
