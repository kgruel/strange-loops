from __future__ import annotations

import json
from pathlib import Path

from custody.signing import ARRIVAL_DOMAIN
from engine.arrival import content_commitment, mint_lineage
from engine.arrival_contract import Full, RecordDraft, StoreDescriptor
from engine.arrival_registry import BackendRegistry
from lang import parse_vertex_file
from migrate import identity, run_migration, transform
from sign import ed25519


root = Path("/tmp/sol-s4-r1/resume-outer-signature")
root.mkdir(parents=True, exist_ok=True)
for path in root.rglob("*"):
    if path.is_file():
        path.unlink()

keypair = ed25519.load_or_generate(root / "keys" / "alice")
public_key = keypair.public_b64


def signer(observer: str, digest: str) -> str | None:
    assert observer == "alice"
    return ed25519.sign(keypair, digest.encode(), domain=ARRIVAL_DOMAIN)


source = root / "legacy.jsonl"
source.write_text(
    json.dumps(
        {
            "t": "fact",
            "id": "legacy-id",
            "kind": "probe",
            "ts": 1.0,
            "observer": "alice",
            "origin": "probe",
            "payload": "{}",
        },
        separators=(",", ":"),
    )
    + "\n",
    encoding="utf-8",
)
vertex = root / "project.vertex"
vertex.write_text(
    f'''name "alice"
store "./legacy.jsonl"

observers {{
  alice {{
    key "{public_key}"
  }}
}}

loops {{
  probe {{ fold {{ items "collect" 10 }} }}
}}
''',
    encoding="utf-8",
)

result = transform(source, parse_vertex_file(vertex), identity(), signer=signer)
assert len(result.drafts) == 1
expected = result.drafts[0]
assert expected.signature is None

lineage = mint_lineage()
target = root / f"{lineage}.arrival"
registry = BackendRegistry.with_builtin_backends()
ledger, _query = registry.open(
    StoreDescriptor(backend="file", location=str(target), lineage=lineage)
)
head = ledger.mint(
    {
        "observer": "alice",
        "signer": signer,
        "key": public_key,
        "lineage": lineage,
        "at": 0.0,
    }
)
digest = content_commitment(
    expected.kind,
    expected.authored_at,
    expected.observer,
    expected.origin,
    expected.body,
)
outer_signature = signer("alice", digest)
assert outer_signature is not None
signed_draft = RecordDraft(
    kind=expected.kind,
    authored_at=expected.authored_at,
    observer=expected.observer,
    origin=expected.origin,
    body=expected.body,
    signature=outer_signature,
)
head = ledger.append(head, [signed_draft]).after
assert ledger.verify(Full(through=head)) == head
before = target.read_bytes()

outcome = run_migration(
    source,
    vertex,
    store_dir=root,
    signer=signer,
    transform_rule=identity(),
    resume_target=target,
)
records = list(ledger.scan(through=outcome.head))
actual_signature = records[1].get("sig")
print(f"expected_draft_signature={expected.signature!r}")
print(f"resumed_target_signature={actual_signature!r}")
print(f"migration_published={parse_vertex_file(vertex).store == Path('./' + target.name)}")
print(f"target_bytes_unchanged={target.read_bytes() == before}")
if actual_signature is None:
    print("PASS: resume preserved the outer-unsigned migration invariant")
    raise SystemExit(0)
print("FAIL: resume accepted and published an outer-signed migrated record")
raise SystemExit(1)
