   346	def test_scan_targets_all_exist():
   347	    """A target that has moved silently stops being judged."""
   348	    missing = [t for t in _SCAN_TARGETS if not (REPO_ROOT / t).exists()]
   349	    assert not missing, f"Rule 18 scans paths that no longer exist: {missing}"
   350	
   351	
   352	def test_allowlist_entries_still_apply():
   353	    """Stale allowlist entries must be cleaned up, not left as cover."""
   354	    for path, marker in _ALLOWED:
   355	        full = REPO_ROOT / path
   356	        assert full.exists(), f"Stale allowlist entry: {path} no longer exists"
   357	        assert marker in full.read_text(), (
   358	            f"Stale allowlist entry: {path} no longer contains {marker!r}"
   359	        )
