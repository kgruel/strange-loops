  1285	# ---------------------------------------------------------------------------
  1286	# The import-closure ratchet (§B.1)
  1287	# ---------------------------------------------------------------------------
  1288	
  1289	
  1290	def test_reading_a_head_journal_does_not_drag_the_adapter_in():
  1291	    """The journal must stay readable when the store it witnesses cannot open.
  1292	
  1293	    A module that dragged the file codec and sqlite3 behind it would tie its
  1294	    own readability to the health of the thing it is judging — which is the
  1295	    whole reason this is stdlib plus the contract.
  1296	    """
  1297	    source = (
  1298	        "import sys\n"
  1299	        "import engine.arrival_head_attestation as m\n"
  1300	        "assert 'sqlite3' not in sys.modules, 'sqlite3 was imported'\n"
  1301	        "assert 'engine.arrival' not in sys.modules, 'the adapter was imported'\n"
  1302	        "m.parse_journal_lines([])\n"
  1303	        "assert 'sqlite3' not in sys.modules, 'reading imported sqlite3'\n"
  1304	        "assert 'engine.arrival' not in sys.modules, 'reading imported the adapter'\n"
  1305	    )
  1306	    result = subprocess.run(
  1307	        [sys.executable, "-c", source], capture_output=True, text=True
  1308	    )
  1309	    assert result.returncode == 0, result.stderr
  1310	
  1311	
  1312	# ---------------------------------------------------------------------------
  1313	# Trust-reset replay (finding:s3wp3-trust-reset-replay)
  1314	# ---------------------------------------------------------------------------
  1315	
  1316	
  1317	def test_a_replayed_trust_reset_does_not_reopen_the_epoch_it_closed():
  1318	    """Sol r1's repro. An entry is bytes, so an old reset can be re-appended.
  1319	
  1320	    A reset accepting head 5 legitimately closed the epoch that reached 10.
  1321	    The journal then advanced to 8. Re-appending a byte-copy of that reset
  1322	    would, on last-reset-wins, scope the epoch to it again and read *K* as 5 —
  1323	    so a store rolled back to 5 opens UNCHANGED and the abandoned epoch is
  1324	    resurrected. Silent re-acceptance, reached through the one entry kind whose
  1325	    whole job is to be the licensed way down.
  1326	
  1327	    The binding makes the replay INEXPRESSIBLE rather than merely detectable:
  1328	    the copy names the entry it originally followed, and at the end of the
  1329	    journal that is not the entry in front of it. It is skipped and reported,
  1330	    the genuine earlier reset still opens the epoch, and *K* stays at 8.
  1331	    """
  1332	    for ordinal in range(1, 11):
  1333	        append_entry(observation(ordinal))
  1334	    legitimate = append_reset(5, note="restored from archive; abandoned 10")
  1335	    # A DIFFERENT digest after the restore: the store re-advances through a new
  1336	    # history, so ordinal 6 after the reset is not the ordinal 6 before it.
  1337	    # Modelling it as the same bytes would have been the fixture asserting a
  1338	    # store no backend produces.
  1339	    for ordinal in (6, 7, 8):
  1340	        append_entry(observation(ordinal, "b"))
  1341	
  1342	    append_entry(legitimate)  # the replay: the very same entry, again
  1343	
  1344	    result = read_journal(LINEAGE)
  1345	    # A replay is recorded and weightless, so the read stays ESTABLISHED — one
  1346	    # replayed line must not cost the journal its O(1) unchanged opens.
  1347	    assert isinstance(result.known, EstablishedHead)
  1348	    assert result.established_head().head.ordinal == 8, "the replay moved K"
  1349	    # Caught by the byte-duplicate gate, which now fires BEFORE the position
  1350	    # binding ever sees the line — a literal replay is literal bytes.
  1351	    assert any("byte-identical" in note for note in result.skipped), result.skipped
  1352	    assert compare(result.established_head(), head(5), None) is Outcome.ROLLBACK
  1353	
  1354	
  1355	def test_the_genuine_reset_is_still_honored_after_the_replay_is_rejected():
  1356	    """Rejecting a replay must not reject the reset it was copied from.
  1357	
  1358	    The scan keeps walking back for an earlier valid boundary, so the epoch is
  1359	    still the one the operator opened — otherwise closing the replay hole would
  1360	    reintroduce the deadlock the epoch scoping exists to prevent.
  1361	    """
  1362	    for ordinal in range(1, 11):
  1363	        append_entry(observation(ordinal))
  1364	    legitimate = append_reset(5)
  1365	    append_entry(observation(8, "b"))
  1366	    append_entry(legitimate)
  1367	
  1368	    result = read_journal(LINEAGE)
  1369	    # The epoch still opens at the legitimate reset, and the replayed copy is
  1370	    # not in it at all now: the byte-duplicate gate drops the line before it
  1371	    # can be an entry, let alone a boundary.
  1372	    assert [entry.head.ordinal for entry in result.epoch] == [5, 8]
  1373	    assert isinstance(result.known, EstablishedHead)
  1374	    assert result.established_head().head.ordinal == 8
