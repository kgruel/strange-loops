   339	
   340	def _read_arrival_source(canonical: Path) -> _SourceRows:
   341	    """Walk the source's arrival log from ordinal 0, in ORDINAL order.
   342	
   343	    NON-NEGOTIABLE. Merging is replaying the source's arrival into the
   344	    target's arrival; it consumes no event-time input at all. Structural
   345	    records expand to no rows and so contribute no group — a lineage's
   346	    genesis and its key introductions belong to that lineage, and carrying
   347	    them across would claim the target's log opened them.
   348	    """
   349	    from engine.arrival import ArrivalLog
   350	    from engine.arrival_projection import rows_of_record
   351	
   352	    groups: list[tuple[str, list[tuple[str, tuple]]]] = []
   353	    facts = ticks = 0
   354	    for record in ArrivalLog(canonical).walk():
   355	        rows = rows_of_record(record)
   356	        if not rows:
   357	            continue
   358	        groups.append((record["k"], rows))
   359	        for t, _row in rows:
   360	            if t == "fact":
   361	                facts += 1
   362	            else:
   363	                ticks += 1
   364	    return _SourceRows(groups=groups, fact_count=facts, tick_count=ticks)
   365	
   366	
   367	def _read_index_source(source: Path) -> _SourceRows:
   368	    """Facts in ``rowid`` order, then ticks in ``rowid`` order — two passes.
   369	
   370	    The transport case: ``slice_store`` emits a plain ``.db``. Deterministic,
   371	    and deliberately NOT routed through any event-time sort. Ticks after
   372	    facts is safe because ticks never feed fold state.
   373	    """
   374	    conn = _open(source, read_only=True)
   375	    try:
   376	        fact_cols = {r[1] for r in conn.execute("PRAGMA table_info(facts)")}
   377	        signature = "signature" if "signature" in fact_cols else "NULL"
   378	        fact_rows = conn.execute(
   379	            "SELECT id, kind, ts, observer, origin, payload, "
   380	            f"{signature} FROM facts ORDER BY rowid"
   381	        ).fetchall()
   382	        tick_rows = conn.execute(
   383	            "SELECT id, name, ts, since, origin, payload FROM ticks ORDER BY rowid"
   384	        ).fetchall()
   385	    finally:
   386	        conn.close()
   387	
   388	    groups: list[tuple[str, list[tuple[str, tuple]]]] = [
   389	        ("fact", [("fact", tuple(row))]) for row in fact_rows
   390	    ]
   391	    # The tick rows ride at BASE arity, chainless — this source shape has no
   392	    # chain to carry, because chain state is store-local and a transport
   393	    # slice never brought it. Padding to full arity here would be undone
   394	    # immediately: _entry_for strips the chain off every tick it sees.
   395	    groups.extend(("tick", [("tick", tuple(row))]) for row in tick_rows)
   396	    return _SourceRows(
   397	        groups=groups, fact_count=len(fact_rows), tick_count=len(tick_rows)
   398	    )
