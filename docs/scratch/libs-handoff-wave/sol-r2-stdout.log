   283	def _reject_shared_line(text: str, kind: str, verb: str) -> None:
   284	    """Fail loud when ``kind``'s physical line carries sibling nodes.
   285	
   286	    Line-based edit/remove operates on whole physical lines; a kind sharing
   287	    its line with siblings would silently take them with it. Refuse instead
   288	    (matching the documented reject-over-support posture for single-line
   289	    blocks). No-op when the kind is absent — the caller's own not-found
   290	    path reports that.
   291	    """
   292	    try:
   293	        start, end = kdl_find_block(text, ["loops", kind])
   294	    except ValueError:
   295	        return  # absent kind: caller reports not-found
   296	    if start != end:
   297	        return  # multi-line kind block: the span is unambiguous
   298	    line = text.splitlines()[start].strip()
   299	    if len(kdl_split_top_level_nodes(line)) > 1:
   300	        raise ValueError(
   301	            f"cannot {verb} kind {kind!r}: its line holds sibling "
   302	            "declarations too — a line-based mutation would silently "
   303	            "remove them; split each kind onto its own line first"
   304	        )
