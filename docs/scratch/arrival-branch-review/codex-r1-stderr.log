import hashlib, tempfile
from pathlib import Path
from atoms import Fact
from engine.sqlite_store import SqliteStore
from engine.witness import diff_interval_report, resolve_witness_position

def signer(observer, commitment):
    return 'sig:'+hashlib.sha256(f'{observer}/{commitment}'.encode()).hexdigest()
def make(path, label):
    s=SqliteStore(path=path,serialize=lambda f:f.to_dict(),deserialize=Fact.from_dict,fact_signer=signer)
    s.absorb_genesis([{'kind':'vertex-defined','subject':label,'payload':{'name':label}}],observer=label,fact_signer=signer)
    s.append(Fact.of('note',label,n=1))
    s.close()
with tempfile.TemporaryDirectory() as d:
    a,b=Path(d)/'a.db',Path(d)/'b.db'
    make(a,'a'); make(b,'b')
    pa,pb=resolve_witness_position(a,'head'),resolve_witness_position(b,'head')
    print('lineages_differ=',pa.lineage "'!= pb.lineage)
    print('"'stores_differ=',pa.store "'!= pb.store)
    try:
        answer=diff_interval_report(a,pa,pb)
    except Exception as exc:
        print('"'raised=',type(exc).__name__,str(exc))
    else:
        print('raised=None')
        print('cross_lineage_answer=',answer)
