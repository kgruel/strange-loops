   425	def _placement_fault(record: dict, ordinal: int) -> str | None:
   426	    """Why ``record`` may not sit at ``ordinal``, or None when it may.
   427	
   428	    One rule stated once, in both directions: **the genesis kind belongs at
   429	    ordinal 0 and nowhere else.** At 0 a record must satisfy every genesis
   430	    rule; above 0 it must not claim to be a genesis at all. A key
   431	    introduction (:data:`KEY_INTRODUCTION_KIND`) is held to its structural
   432	    rules at any ordinal it appears: signed, and a body naming an observer
   433	    and a well-formed key.
   434	
   435	    Structural rules only, deliberately: whether the genesis signature
   436	    verifies against ``body["key"]`` — self-certification — and whether an
   437	    introduction's signer was valid at its position are cryptographic
   438	    questions, answered by :func:`verify_authorship` with an injected
   439	    verifier. This function stays pure so every caller (walk, append, open)
   440	    can run it without carrying one.
   441	
   442	    This exists as one function because the two directions were previously
   443	    checked in four places with three different sets of rules, and the gaps
   444	    between them were exactly the holes: a forged unsigned genesis walked
   445	    clean because only :meth:`ArrivalLog.genesis` demanded a signature, and
   446	    a second genesis could be appended at an interior ordinal because
   447	    nothing checked the kind on the way in. Callers differ only in the error
   448	    class they raise — opening a file that is not an arrival log, walking one
   449	    that has been tampered with, and refusing an append are three different
   450	    conversations about the same rule.
   451	    """
   452	    if ordinal == 0:
   453	        if record["k"] != GENESIS_KIND:
   454	            return f"first record has kind {record['k']!r}, not a genesis"
   455	        if record["ord"] != 0:
   456	            return f"first record carries ord {record['ord']!r}, not 0"
   457	        if record["prev"] is not None:
   458	            return "first record carries a prev — genesis opens the chain"
   459	        if _SIG not in record:
   460	            return (
   461	                "genesis carries no signature — genesis is the lineage's "
   462	                "attestation root"
   463	            )
   464	        claimed = record["body"].get("lineage")
   465	        if claimed != record["lin"]:
   466	            return (
   467	                f"genesis is not self-naming — body claims lineage {claimed!r} "
   468	                f"but the coordinate says {record['lin']!r}"
   469	            )
   470	        key_fault = _key_shape_fault(record["body"].get("key"))
   471	        if key_fault is not None:
   472	            return (
   473	                f"genesis carries no well-formed founding key ({key_fault}) — "
   474	                "a live-store genesis introduces the founding public key at "
   475	                "ordinal 0; a keyless genesis belongs to the migration "
   476	                "sidecar, not to this grammar"
   477	            )
   478	        return None
   479	    if record["k"] == GENESIS_KIND:
   480	        return (
   481	            f"a genesis at ordinal {ordinal} — the genesis kind belongs at "
   482	            "ordinal 0 and nowhere else, and a lineage is opened once"
   483	        )
   484	    if record["k"] == KEY_INTRODUCTION_KIND:
   485	        if _SIG not in record:
   486	            return (
   487	                "a key introduction carries no signature — an introduction "
   488	                "is vouched for by a key that is already valid, never "
   489	                "self-certifying above ordinal 0"
   490	            )
   491	        named = record["body"].get("observer")
   492	        if not isinstance(named, str) or not named:
   493	            return "a key introduction's body must name the observer the key speaks for"
   494	        key_fault = _key_shape_fault(record["body"].get("key"))
   495	        if key_fault is not None:
   496	            return f"a key introduction's body carries no well-formed key: {key_fault}"
   497	    return None
   498	
   499	
   500	def _authority_fault(record: dict, lineage: str) -> str | None:
   501	    """Why ``record`` may not be ADOPTED AS AN AUTHORITY, or None when it may.
   502	
   503	    An authority is an existing on-disk record the code takes as a starting
   504	    point and derives from: the head an append chains onto, the anchor a
   505	    resume walk continues from. Reading a record forward and adopting one as
   506	    a premise are different acts, and only the first was ever checked —
   507	    twice, review found the same residual shape, because a rule enforced on
   508	    the way past a record says nothing about a record you never walked to.
   509	
   510	    So: validate at every adoption site, not at a proxy for it. A record may
   511	    be adopted when it decodes and its ``rh`` recomputes (the caller's
   512	    :func:`decode_record` established that), when it may sit at the ordinal
   513	    it claims (:func:`_placement_fault`), and when it belongs to this log's
   514	    lineage.
   515	
   516	    What adoption does NOT establish, and deliberately: that the record
   517	    chains back to genesis, or that its claimed ordinal matches its physical
   518	    position in the file. Both need a walk of the whole prefix, which is the
   519	    O(n) cost these O(1) paths exist to avoid. The residual is narrow —
   520	    density is re-checked from the adopted record onward, so a hostile
   521	    coordinate is refused one record later — and :meth:`ArrivalLog.walk` is
   522	    the integrity statement whenever the whole file is the question.
   523	    """
   524	    fault = _placement_fault(record, record["ord"])
   525	    if fault is not None:
   526	        return fault
   527	    if record["lin"] != lineage:
   528	        return (
   529	            f"record claims lineage {record['lin']!r}, "
   530	            f"but this log's lineage is {lineage!r}"
   531	        )
   532	    return None
   533	
   534	
   535	def content_commitment(
   536	    k: str, at: float, observer: str, origin: str, body: dict
   537	) -> str:
   538	    """The digest a signature covers: sha256 over JCS of the five content
   539	    fields.
   540	
   541	    Content only. The coordinate, ``prev``, ``rh``, and ``sig`` itself are
   542	    all outside it — the first three because they are custody context rather
   543	    than authored content, the last because a signature cannot sign itself.
   544	    That exclusion is what makes a signature transport-stable: any store
   545	    holding the record re-derives the same digest and verifies authorship
   546	    against the observer registry without trusting the sender.
   547	    """
   548	    envelope = {"k": k, "at": at, "observer": observer, "origin": origin, "body": body}
   549	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
   550	
   551	
   552	def record_hash(record: dict) -> str:
   553	    """``rh``: sha256 over JCS of the whole record with ``rh`` removed.
   554	
   555	    Covers the coordinate and the signature, which is how the coordinate is
   556	    tamper-evident without being signed, and how ``prev`` gets something to
   557	    point at.
   558	    """
   559	    return hashlib.sha256(
   560	        _canonical_bytes({key: value for key, value in record.items() if key != _RH})
   561	    ).hexdigest()
   562	
   563	
   564	def _no_duplicate_keys(pairs: list[tuple[str, object]]) -> dict:
   565	    """JSON's last-wins duplicate resolution would let one line carry two
   566	    ordinals and a reader silently pick one. Reject instead."""
   567	    seen: dict = {}
   568	    for key, value in pairs:
   569	        if key in seen:
   570	            _bad(f"duplicate key {key!r} in one JSON object")
   571	        seen[key] = value
   572	    return seen
   573	
   574	
   575	def build_record(
   576	    *,
   577	    lin: str,
   578	    ordinal: int,
   579	    prev: str | None,
   580	    k: str,
   581	    body: dict,
   582	    observer: str,
   583	    origin: str = "",
   584	    at: float | None = None,
   585	    sig: str | None = None,
   586	) -> dict:
   587	    """Assemble one validated record, ``rh`` computed and last.
   588	
   589	    ``at`` is wall clock at append. It is authored content and rides inside
   590	    the signed envelope — an unsigned timestamp is a claim anyone downstream
   591	    can rewrite. It is never an ordering input: nothing sorts by it and no
   592	    later slice's declared orders may name it.
   593	    """
   594	    record: dict = {
   595	        "v": GRAMMAR_VERSION,
   596	        "lin": lin,
   597	        "ord": ordinal,
   598	        "prev": prev,
   599	        "at": time.time() if at is None else at,
   600	        "k": k,
   601	        "observer": observer,
   602	        "origin": origin,
   603	        "body": body,
   604	    }
   605	    if sig is not None:
   606	        record[_SIG] = sig
   607	    _validate(record, require_rh=False)
   608	    record[_RH] = record_hash(record)
   609	    return record
   610	
   611	
   612	def encode_record(record: dict) -> str:
   613	    """One line, no trailing newline.
   614	
   615	    ``ensure_ascii`` keeps the line 7-bit and free of raw U+2028/U+2029,
   616	    ``allow_nan=False`` refuses the non-JSON float constants, and
   617	    ``separators`` drops insignificant whitespace. Together they are why
   618	    newline framing is safe rather than merely conventional: no encoded
   619	    record can contain a raw newline, so a ``\\n`` in the file is
   620	    unambiguously a boundary.
   621	    """
   622	    _validate(record, require_rh=True)
   623	    if record[_RH] != record_hash(record):
   624	        _bad("rh does not match the record it is attached to")
   625	    ordered = {key: record[key] for key in RECORD_FIELDS}
   626	    if _SIG in record:
   627	        ordered[_SIG] = record[_SIG]
   628	    ordered[_RH] = record[_RH]
   629	    return json.dumps(ordered, ensure_ascii=True, allow_nan=False, separators=(",", ":"))
   630	
   631	
   632	def decode_record(line: str | bytes) -> dict:
   633	    """Decode one line and hold it to the grammar, ``rh`` included.
   634	
   635	    Raises :class:`ArrivalGrammarError`. The caller decides what a failure
   636	    means — the walk turns it into :class:`ArrivalCorrupt` with a coordinate
   637	    attached, because at that point there is a position to name.
   638	    """
   639	    if isinstance(line, bytes):
   640	        try:
   641	            line = line.decode("utf-8")
   642	        except UnicodeError as exc:
   643	            _bad(f"line is not valid UTF-8: {exc}")
   644	    try:
   645	        record = json.loads(line, object_pairs_hook=_no_duplicate_keys)
   646	    except ValueError as exc:
   647	        if isinstance(exc, ArrivalGrammarError):
   648	            raise
   649	        _bad(f"line is not valid JSON: {exc}")
   650	    _validate(record, require_rh=True)
   651	    if record[_RH] != record_hash(record):
   652	        _bad("rh does not recompute — the record's bytes have changed")
   653	    return record
   654	
