   318	def _check_equivalence(
   319	    source_path: Path,
   320	    target_records: list[dict[str, Any]],
   321	    rule: Transform,
   322	) -> EquivalenceResult:
   323	    """Compare expected logical rows derived from unmodified source against target records."""
   324	    src = LegacySource.read(source_path)
   325	
   326	    expected_rows: list[dict[str, Any]] = []
   327	    for unit in src.units:
   328	        if isinstance(unit, FlatFactUnit):
   329	            mf = rule.map_fact(unit.row)
   330	            if mf is not None:
   331	                expected_rows.append(
   332	                    {
   333	                        "row_kind": "fact",
   334	                        "id": mf.id,
   335	                        "kind": mf.kind,
   336	                        "ts": mf.ts,
   337	                        "observer": mf.observer,
   338	                        "origin": mf.origin,
   339	                        "payload": mf.payload,
   340	                        "signature": mf.signature,
   341	                    }
   342	                )
   343	        elif isinstance(unit, BatchUnit):
   344	            for r in unit.rows:
   345	                mf = rule.map_fact(r)
   346	                if mf is not None:
   347	                    expected_rows.append(
   348	                        {
   349	                            "row_kind": "fact",
   350	                            "id": mf.id,
   351	                            "kind": mf.kind,
   352	                            "ts": mf.ts,
   353	                            "observer": mf.observer,
   354	                            "origin": mf.origin,
   355	                            "payload": mf.payload,
   356	                            "signature": mf.signature,
   357	                        }
   358	                    )
   359	        elif isinstance(unit, TickUnit):
   360	            expected_rows.append(
   361	                {
   362	                    "row_kind": "tick",
   363	                    "id": unit.id,
   364	                    "name": unit.name,
   365	                    "ts": unit.ts,
   366	                    "since": unit.since,
   367	                    "origin": unit.origin,
   368	                    "payload": unit.payload,
   369	                    "prev_hash": unit.prev_hash,
   370	                    "window_start": unit.window_start,
   371	                    "fact_cursor": unit.fact_cursor,
   372	                    "window_hash": unit.window_hash,
   373	                    "signature": unit.signature,
   374	                }
   375	            )
   376	
   377	    target_rows: list[dict[str, Any]] = []
   378	    for rec in target_records:
   379	        k = rec.get("k")
   380	        if k in {GENESIS_KIND, KEY_INTRODUCTION_KIND}:
   381	            continue
   382	        if k not in {FACT_KIND, BATCH_KIND, TICK_KIND}:
   383	            continue
   384	
   385	        expanded = rows_of_body(k, rec["body"])
   386	        for row_k, row_tuple in expanded:
   387	            if row_k == FACT_KIND:
   388	                fact_id, kind, ts, observer, origin, payload, sig = row_tuple
   389	                target_rows.append(
   390	                    {
   391	                        "row_kind": "fact",
   392	                        "id": fact_id,
   393	                        "kind": kind,
   394	                        "ts": ts,
   395	                        "observer": observer,
   396	                        "origin": origin,
   397	                        "payload": payload,
   398	                        "signature": sig,
   399	                    }
   400	                )
   401	            elif row_k == TICK_KIND:
   402	                (
   403	                    tick_id,
   404	                    name,
   405	                    ts,
   406	                    since,
   407	                    origin,
   408	                    payload,
   409	                    prev_hash,
   410	                    window_start,
   411	                    fact_cursor,
   412	                    window_hash,
   413	                    sig,
   414	                ) = row_tuple
   415	                target_rows.append(
   416	                    {
   417	                        "row_kind": "tick",
   418	                        "id": tick_id,
   419	                        "name": name,
   420	                        "ts": ts,
   421	                        "since": since,
   422	                        "origin": origin,
   423	                        "payload": payload,
   424	                        "prev_hash": prev_hash,
   425	                        "window_start": window_start,
   426	                        "fact_cursor": fact_cursor,
   427	                        "window_hash": window_hash,
   428	                        "signature": sig,
   429	                    }
   430	                )
   431	
   432	    mismatches: list[str] = []
   433	    if len(expected_rows) != len(target_rows):
   434	        mismatches.append(
   435	            f"row count mismatch: expected {len(expected_rows)} logical rows, found {len(target_rows)}"
   436	        )
   437	    else:
   438	        for i, (exp, tgt) in enumerate(zip(expected_rows, target_rows, strict=True)):
   439	            if exp != tgt:
   440	                diff_keys = [k for k in exp if exp.get(k) != tgt.get(k)]
   441	                mismatches.append(
   442	                    f"row {i} mismatch on {diff_keys}: expected {exp} != target {tgt}"
   443	                )
   444	
   445	    return EquivalenceResult(
   446	        matched=(len(mismatches) == 0),
   447	        source_rows=len(expected_rows),
   448	        target_rows=len(target_rows),
   449	        mismatches=tuple(mismatches),
   450	    )
