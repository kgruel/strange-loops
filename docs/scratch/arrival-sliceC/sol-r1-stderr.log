   868	            vpath, query, kind=kind, kinds=kinds, since=since, until=until,
   869	            limit=limit, observer=observer, as_of=as_of,
   870	        )
   871	        all_results.extend(child_results)
   872	
   873	    # Sort by ts descending (newest first), apply limit
   874	    all_results.sort(key=lambda f: f["ts"], reverse=True)
   875	    return all_results[:limit]
