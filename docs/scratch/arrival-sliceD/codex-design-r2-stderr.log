  1576	    def append_tick(self, tick: Tick, *, enforce_floor: bool = True) -> str:
  1577	        """Append a tick to the ticks table, extending the hash chain.
  1578	        Returns the tick row id assigned (so a receipt can read the
  1579	        committed row back — ``tick_signature_state``); historical callers
