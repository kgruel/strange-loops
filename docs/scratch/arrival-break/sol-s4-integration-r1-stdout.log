   974	def effective_store_clause(text: str, path: Path | None = None) -> StoreClauseSpan:
   975	    """Locate the single effective top-level store clause in a .vertex document.
   976	
   977	    Parses the KDL document to count top-level store nodes, and scans the source
   978	    text (quote- and comment-aware) to locate the line character span
   979	    of the effective clause.
   980	
   981	    Note: ``span`` covers the character offsets of the entire line containing the
   982	    effective store clause (excluding trailing newline). Any same-line comments
   983	    trailing the store clause are within this span and will be replaced upon rewrite.
   984	
   985	    Returns:
   986	        StoreClauseSpan with:
   987	        - span: (start_char, end_char) line slice in text if exactly 1 effective store node exists, else None
   988	        - count: total number of top-level store nodes in the parsed document
   989	
   990	    Raises:
   991	        ParseError: If the document contains invalid KDL syntax.
   992	    """
   993	    _ensure_ckdl()
   994	    try:
   995	        doc = ckdl.parse(text)
   996	    except ckdl.ParseError as e:
   997	        raise ParseError(str(e), Location(path, 1)) from e
   998	    except Exception as e:
   999	        raise ParseError(str(e), Location(path, 1)) from e
  1000	
  1001	    store_nodes = [node for node in doc.nodes if node.name == "store"]
  1002	    count = len(store_nodes)
  1003	    if count != 1:
  1004	        return StoreClauseSpan(span=None, count=count)
  1005	
  1006	    _CODE, _STRING, _BLOCK_COMMENT, _LINE_COMMENT = 0, 1, 2, 3
  1007	    state = _CODE
  1008	    esc = False
  1009	    bc_depth = 0
  1010	    brace_depth = 0
  1011	    slashdash = False
  1012	
  1013	    lines = text.splitlines(keepends=True)
  1014	    line_starts: list[int] = []
  1015	    curr = 0
  1016	    for l in lines:
  1017	        line_starts.append(curr)
  1018	        curr += len(l)
  1019	
  1020	    def line_for_pos(pos: int) -> tuple[int, int]:
  1021	        for idx in range(len(line_starts) - 1, -1, -1):
  1022	            if pos >= line_starts[idx]:
  1023	                return idx + 1, line_starts[idx]
  1024	        return 1, 0
  1025	
  1026	    matches: list[tuple[int, tuple[int, int], str]] = []
  1027	    i = 0
  1028	    n = len(text)
  1029	    while i < n:
  1030	        ch = text[i]
  1031	        if state == _STRING:
  1032	            if esc:
  1033	                esc = False
  1034	            elif ch == "\\":
  1035	                esc = True
  1036	            elif ch == '"':
  1037	                state = _CODE
  1038	        elif state == _LINE_COMMENT:
  1039	            if ch == "\n":
  1040	                state = _CODE
  1041	        elif state == _BLOCK_COMMENT:
  1042	            if ch == "/" and i + 1 < n and text[i + 1] == "*":
  1043	                bc_depth += 1
  1044	                i += 1
  1045	            elif ch == "*" and i + 1 < n and text[i + 1] == "/":
  1046	                bc_depth -= 1
  1047	                i += 1
  1048	                if bc_depth == 0:
  1049	                    state = _CODE
  1050	        else:  # _CODE
  1051	            if ch == '"':
  1052	                state = _STRING
  1053	            elif ch == "/" and i + 1 < n and text[i + 1] == "/":
  1054	                state = _LINE_COMMENT
  1055	                i += 1
  1056	            elif ch == "/" and i + 1 < n and text[i + 1] == "*":
  1057	                bc_depth = 1
  1058	                state = _BLOCK_COMMENT
  1059	                i += 1
  1060	            elif ch == "/" and i + 1 < n and text[i + 1] == "-":
  1061	                slashdash = True
  1062	                i += 1
  1063	            elif ch == "{":
  1064	                brace_depth += 1
  1065	            elif ch == "}":
  1066	                if brace_depth > 0:
  1067	                    brace_depth -= 1
  1068	            elif ch == "\n" or ch == ";":
  1069	                slashdash = False
  1070	            elif ch.isalpha() or ch in ("_", "-"):
  1071	                id_start = i
  1072	                while i < n and (text[i].isalnum() or text[i] in ("_", "-", ".")):
  1073	                    i += 1
  1074	                ident = text[id_start:i]
  1075	                i -= 1
  1076	                if ident == "store" and brace_depth == 0:
  1077	                    if not slashdash:
  1078	                        l_no, l_start = line_for_pos(id_start)
  1079	                        l_text = lines[l_no - 1]
  1080	                        l_end = l_start + len(l_text.rstrip("\r\n"))
  1081	                        matches.append((l_no, (l_start, l_end), l_text.rstrip("\r\n")))
  1082	                    else:
  1083	                        slashdash = False
  1084	        i += 1
  1085	
  1086	    if len(matches) == 1:
  1087	        _l_no, span, _raw = matches[0]
  1088	        return StoreClauseSpan(span=span, count=count)
  1089	    return StoreClauseSpan(span=None, count=count)
   695	    name: str
   696	
   697	
   698	@dataclass(frozen=True)
   699	class StoreClauseSpan:
   700	    """Line span and multiplicity of the effective store clause in a .vertex document.
   701	
   702	    Note: ``span`` covers the character offsets of the entire line containing the
   703	    effective store clause (excluding trailing newline). Any same-line comments
   704	    trailing the store clause are within this span and will be replaced upon rewrite.
   705	    """
