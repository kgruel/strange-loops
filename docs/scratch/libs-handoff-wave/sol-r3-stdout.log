   359	def test_recover_then_open_rebuilds_a_non_sqlite_index(tmp_path):
   360	    """SOL-R2-03: corrupt derived index (non-sqlite bytes) must not leak a
   361	    raw sqlite3.DatabaseError — the index is derived, the log is valid, so
   362	    recovery deletes and rebuilds the index from the log."""
   363	    log, db = seeded_jsonl(tmp_path)
   364	    db.write_bytes(b"this is definitely not a sqlite database\n" * 20)
   365	    for side in ("-wal", "-shm"):
   366	        p = Path(str(db) + side)
   367	        if p.exists():
   368	            p.unlink()
   369	    r = read_preflight(log, PreflightMode.RECOVER_THEN_OPEN)
   370	    assert (r.status, r.opened, r.recovered) == ("recovered", True, True)
   371	    assert r.report is not None  # pre-recovery evidence kept
   372	    assert r.post_report is not None and r.post_report.ok
   373	    assert isinstance(r.store, JsonlStore)
   374	    r.store.close()
   375	    with sqlite3.connect(db) as conn:
   376	        assert conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0] == 3
   377	        assert conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0] == 1
