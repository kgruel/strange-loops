   598	def _index_cursor(conn, table: str, columns: tuple[str, ...]):
   599	    cols = _present(conn, table, columns)
   600	    return len(cols), conn.execute(
   601	        f"SELECT {', '.join(cols)} FROM {table} ORDER BY rowid"
   602	    )
   603	
   604	
   605	def _deep_checks(conn, canonical: Path, offset: int | None) -> list[Check]:
   606	    """Compare every log line against the index, in order.
   607	
   608	    ``offset`` is the prefix the index claims to have consumed, passed in only
   609	    when that claim was CORROBORATED against the log (:func:`_suffix_unindexed`
   610	    — a rewound marker arrives here as ``None``). A failure on a line that ends
   611	    BEYOND it is in bytes that were never meant to have an index row yet (see
   612	    :attr:`Check.beyond_offset`). Failures inside the consumed prefix are the
   613	    real thing and stay unflagged.
   614	
   615	    The walk does not stop at the first divergence. Every divergence is a fact
   616	    about a different line, and the chain verdict is derived from LOG content —
   617	    so stopping early would trade a real answer ("the chain re-derives" /
   618	    "these ticks broke") for a vacuous one over zero ticks. Divergences
   619	    accumulate (the reported list is capped; the count is not) and every
   620	    decodable canonical row keeps feeding the chain. Only an undecodable line
   621	    truly ends the walk, and then the chain says it ABORTED rather than ``ok``.
   622	    """
   623	
   624	    def beyond(end: int) -> bool:
   625	        return offset is not None and end > offset
   626	
   627	    fact_arity, fact_rows = _index_cursor(conn, "facts", FACT_COLUMNS)
   628	    tick_arity, tick_rows = _index_cursor(conn, "ticks", TICK_COLUMNS)
   629	    cursors = {"fact": (fact_arity, fact_rows), "tick": (tick_arity, tick_rows)}
   630	    seen = {"fact": 0, "tick": 0}
   631	
   632	    chain = _ChainWalk()
   633	    diverged = _Divergences()
   634	
   635	    for lineno, end, line in _iter_lines(canonical):
   636	        try:
   637	            records = deserialize_records(line)
   638	        except (JsonlCodecError, UnicodeError) as exc:
   639	            diverged.add(
   640	                f"log line {lineno} does not decode: {exc}", beyond(end)
   641	            )
   642	            chain.abort(lineno)
   643	            break
   644	        # D1 boundary: same-ts across a batch is the declaration ceremony's
   645	        # invariant, not a codec rule. absorb_edit stamps one ts; a batch
   646	        # whose rows are all _decl.* kinds but carry mixed ts is therefore an
   647	        # audit divergence here — never a decode error at the codec gate.
   648	        if len(records) > 1 and all(
   649	            row[1].startswith("_decl.") for _t, row in records
   650	        ):
   651	            stamps = {row[2] for _t, row in records}
   652	            if len(stamps) > 1:
   653	                diverged.add(
   654	                    f"log line {lineno}: declaration batch carries "
   655	                    f"{len(stamps)} distinct ts — a ceremony is a single "
   656	                    "ontology transition and stamps one effective timestamp",
   657	                    False,
   658	                )
   659	        for t, row in records:
   660	            arity, rows = cursors[t]
   661	            stored = rows.fetchone()
   662	            seen[t] += 1
   663	            if stored is None:
   664	                diverged.add(
   665	                    f"log line {lineno} ({t} {row[0]}) has no index row — the "
   666	                    f"index holds only {seen[t] - 1} {t}(s)",
   667	                    beyond(end),
   668	                )
   669	            elif tuple(stored) != _trim(row, arity):
   670	                diverged.add(
   671	                    f"log line {lineno} ({t} {row[0]}) disagrees with index "
   672	                    f"{t} {stored[0]} at the same position"
   673	                    + (
   674	                        ""
   675	                        if stored[0] == row[0]
   676	                        else " — the index rows are out of log order"
   677	                    ),
   678	                    False,
   679	                )
   680	            # The chain is re-derived from the LOG, so an index divergence on
   681	            # this line says nothing about whether the log's own chain holds.
   682	            chain.feed(lineno, t, row)
   683	
   684	    if diverged:
   685	        content = diverged.verdict()
   686	    else:
   687	        extra = [
   688	            f"{n} extra {t}(s)"
   689	            for t, (_a, rows) in cursors.items()
   690	            if (n := len(rows.fetchall()))
   691	        ]
   692	        content = (
   693	            Check(
   694	                "content", False,
   695	                "index holds row(s) the log never carried: " + ", ".join(extra),
   696	            )
   697	            if extra
   698	            else Check(
   699	                "content", True,
   700	                f"{seen['fact']} fact(s) and {seen['tick']} tick(s) match the "
   701	                "log field-for-field, in order",
   702	            )
   703	        )
   704	    return [content, chain.verdict()]
   705	
