   456	    def _write_fact_row(self, row: tuple) -> str | None:
   457	        return self._write(FACT_INSERT_SQL, row, object_of_fact_row, True)
   458	
   459	    def _write_tick_row(self, row: tuple) -> str | None:
   460	        return self._write(TICK_INSERT_SQL, row, object_of_tick_row, False)
