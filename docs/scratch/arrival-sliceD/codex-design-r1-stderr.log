   519	def _resolve_address_rowid(conn: sqlite3.Connection, address: str) -> tuple[str, int]:
   520	    """Map an address to ``(fact_id, rowid)`` — primary-key lookup only (A3)."""
   521	    if address == GENESIS_SENTINEL:
   522	        return GENESIS_SENTINEL, 0
   523	    if address == "head":
   524	        row = conn.execute(
   525	            "SELECT id, rowid FROM facts ORDER BY rowid DESC LIMIT 1"
   526	        ).fetchone()
   527	        if row is None:
   528	            return GENESIS_SENTINEL, 0  # empty store → empty prefix
   529	        return row[0], row[1]
   530	    # A full fact id — PK point lookup, never ordered or parsed.
   531	    row = conn.execute(
   532	        "SELECT rowid FROM facts WHERE id = ?", (address,)
   533	    ).fetchone()
   534	    if row is None:
   535	        raise UnknownWitnessHandle(
   536	            f"no fact with id {address!r} in this store — a witness handle "
   537	            "resolves by exact id (ids are opaque; never parsed or ordered)"
   538	        )
   539	    return address, row[0]
   540	
   541	
   542	def _id_at_rowid(conn: sqlite3.Connection, rowid: int) -> str:
   543	    """The fact id at ``rowid``, or the empty sentinel for rowid <= 0."""
   544	    if rowid <= 0:
   545	        return GENESIS_SENTINEL
   546	    row = conn.execute("SELECT id FROM facts WHERE rowid = ?", (rowid,)).fetchone()
   547	    return row[0] if row else GENESIS_SENTINEL
