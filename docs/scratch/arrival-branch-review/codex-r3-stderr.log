   131	def _merge_into_sqlite(target: Path, source: Path, *, dry_run: bool) -> MergeResult:
   132	    """ATTACH DATABASE + INSERT OR IGNORE, unchanged.
   133	
   134	    Seam rule S3: every change in the arrival wave is conditional on the
   135	    declared locator, so a sqlite-canonical store merges exactly as it did.
   136	    """
