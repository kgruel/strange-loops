   239	def _specs_match(a: Any, b: Any) -> bool:
   240	    """Check if two Specs have equivalent fold declarations.
   241	
   242	    Compares fold ops (type + parameters) — the part that determines
   243	    how facts accumulate. Ignores name/about metadata.
   244	    """
