   495	    def _declaration_head_in_txn(
   496	        self, conn: Any, lineage_id: str
   497	    ) -> tuple[int, str] | None:
   498	        """The ``(record_ordinal, id)`` of the newest self-lineage declaration.
   499	
   500	        The CAS token names the axis this store actually accretes on. Its
   501	        first coordinate is the ARRIVAL ordinal of the log record whose
   502	        expansion carries the row — so the rows of one batch record (a
   503	        multi-change edit ceremony) share an ordinal and the tie-break falls
   504	        to the fact id, which is the one place this axis is observably not
   505	        the index's rowid.
   506	
   507	        The predicate is the base class's, verbatim: own genesis
   508	        participates, and a foreign ``_decl.*`` row is excluded by the
   509	        lineage its payload stamps. Only the coordinate changed.
   510	
   511	        The log answers, because the log is the store. No ordinal column, no
   512	        side table: a second place the coordinate is written is a second
   513	        thing that can disagree with the log, and the indexer/re-deriver
   514	        disagreement is the one this family does not tolerate. The cost is
   515	        one forward walk per read — twice per edit ceremony, and ceremonies
   516	        are rare.
   517	
   518	        Bounded at the reconciled position rather than at end-of-file. The
   519	        ceremony reads this INSIDE its transaction, having reconciled
   520	        against a specific prefix; a record another writer lands mid-ceremony
   521	        is :meth:`_ceremony_persist`'s ``following`` refusal to judge, not
   522	        this read's, and the bound also keeps a walk from reaching a tail
   523	        that is mid-append.
   524	        """
   525	        mark = self._read_mark()
   526	        if mark is None:
   527	            return None
   528	        best: tuple[int, str] | None = None
   529	        for record in self._log.walk():
   530	            ordinal = record["ord"]
   531	            if ordinal > mark.arrival_ordinal:
   532	                break
   533	            for kind_of_row, row in rows_of_record(record):
   534	                if kind_of_row != "fact":
   535	                    continue
   536	                fact_id, kind, payload_text = row[0], row[1], row[5]
   537	                if not kind.startswith("_decl."):
   538	                    continue
   539	                if fact_id == lineage_id:
   540	                    pass  # own genesis participates
   541	                else:
   542	                    try:
   543	                        payload = json.loads(payload_text)
   544	                    except (json.JSONDecodeError, TypeError):
   545	                        continue
   546	                    if payload.get("lineage") != lineage_id:
   547	                        continue
   548	                candidate = (ordinal, fact_id)
   549	                if best is None or candidate > best:
   550	                    best = candidate
   551	        return best
   552	
