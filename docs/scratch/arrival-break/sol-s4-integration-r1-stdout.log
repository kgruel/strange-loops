   400	                    "SELECT rowid, id, kind, ts, observer, origin, payload"
   401	                    + (", signature" if sig_col else "")
   402	                    + " FROM facts ORDER BY rowid"
   403	                )
   404	                for raw in conn.execute(query_facts):
   405	                    rowid = raw[0]
