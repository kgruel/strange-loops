+                '    _a = importlib.import_module("tools.gen")\n'
+                "    _b = importlib.import_module(SOMETHING)\n"
+            ),
+        },
+    )
+    assert _production_imports_of_non_production(repo) == []
+    assert _production_computed_dynamic_imports(repo) == []
