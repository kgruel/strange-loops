    40	def _mixed_era_id(i: int) -> str:
    41	    """An id whose lexicographic order REVERSES append order, mixing eras.
    42	
    43	    Even appends get a uuid4-shaped id, odd appends a ULID-shaped one; the
    44	    leading counter descends as i ascends so ``ORDER BY id`` is exactly the
    45	    reverse of ``ORDER BY rowid``. Any id-as-position bug inverts the walk.
    46	    """
    47	    tag = 999 - i
    48	    if i % 2 == 0:
    49	        return f"{tag:03d}4a7b-{i:04d}-uuid-era0-abcdef012345"
    50	    return f"{tag:03d}ULIDERA{i:04d}ZZZZZZZZZZ"
    51	
    52	
    53	KINDS = ["decision", "thread", "log", "decision.sub"]
    54	OBSERVERS = ["kyle", "kyle/loops-claude", "sol"]
    55	N = 53
    56	
    57	
    58	@pytest.fixture
    59	def db(tmp_path: Path) -> Path:
    60	    """A store of N facts with adversarial ids, non-monotonic ts, interior
    61	    ``_decl.*`` rows, and multiple kinds/observers."""
    62	    path = tmp_path / "s5.db"
    63	    store = _open_store(path)
    64	    for i in range(N):
    65	        kind = "_decl.kind_defined" if i % 11 == 5 else KINDS[i % len(KINDS)]
    66	        # Every 7th fact is backdated — event time disagrees with append order.
    67	        ts = 500.0 - i if i % 7 == 3 else 1000.0 + i
    68	        fact = Fact.of(kind, OBSERVERS[i % len(OBSERVERS)], ts=ts, seq=i)
    69	        store.append(fact, id_override=_mixed_era_id(i))
    70	    store.close()
    71	    return path
