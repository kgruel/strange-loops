   541	# --- index plumbing, kept off the store classes ------------------------------
   542	
   543	
   544	def _ensure_index_schema(conn: sqlite3.Connection) -> None:
   545	    """Make the index connectable as an index, whatever era it is from.
   546	
   547	    Every statement is idempotent. The schema statements are the store
   548	    class's own — imported rather than restated, so a schema column and a
   549	    re-derived row can never drift apart — and the two column migrations
   550	    mirror the store's, so an index written before the chain columns or the
   551	    fact signature existed re-derives instead of failing on a missing
   552	    column.
   553	    """
   554	    for stmt in _SCHEMA_STMTS:
   555	        conn.execute(stmt)
   556	    conn.execute(
   557	        "CREATE TABLE IF NOT EXISTS store_meta (key TEXT PRIMARY KEY, value TEXT)"
   558	    )
   559	    fact_cols = {r[1] for r in conn.execute("PRAGMA table_info(facts)")}
   560	    if "signature" not in fact_cols:
   561	        conn.execute("ALTER TABLE facts ADD COLUMN signature TEXT")
   562	    tick_cols = {r[1] for r in conn.execute("PRAGMA table_info(ticks)")}
   563	    for col in ("prev_hash", "window_start", "fact_cursor", "window_hash", "signature"):
   564	        if col not in tick_cols:
   565	            conn.execute(f"ALTER TABLE ticks ADD COLUMN {col} TEXT")
   566	    conn.commit()
   567	
   568	
   569	def _meta_get(conn: sqlite3.Connection, key: str) -> str | None:
   570	    row = conn.execute(
   571	        "SELECT value FROM store_meta WHERE key = ?", (key,)
   572	    ).fetchone()
   573	    return None if row is None else row[0]
   574	
   575	
   576	def _meta_set(conn: sqlite3.Connection, key: str, value: object) -> None:
   577	    conn.execute(
   578	        "INSERT OR REPLACE INTO store_meta (key, value) VALUES (?, ?)",
   579	        (key, str(value)),
   580	    )
   581	
   582	
   583	def _stamp_mark(conn: sqlite3.Connection, mark: ResumeMark) -> None:
   584	    """The resume mark's three fields, written through this module's own
   585	    connection. The key names are the store's — imported inside the
   586	    function because :mod:`engine.arrival_store` sits above this one."""
   587	    from .arrival_store import (
   588	        ARRIVAL_LINEAGE_KEY,
   589	        ARRIVAL_OFFSET_KEY,
   590	        ARRIVAL_ORDINAL_KEY,
   591	    )
   592	
   593	    _meta_set(conn, ARRIVAL_LINEAGE_KEY, mark.arrival_lineage)
   594	    _meta_set(conn, ARRIVAL_OFFSET_KEY, mark.arrival_offset)
   595	    _meta_set(conn, ARRIVAL_ORDINAL_KEY, mark.arrival_ordinal)
  1120	    def _anchor_for(self, mark: ResumeMark | None) -> tuple[int, dict, str] | None:
  1121	        """Adopt ``mark``'s anchor, or None when the mark cannot be trusted.
  1122	
  1123	        The single adoption site for the resume path: it reads the anchor
  1124	        once and applies every check, and both :meth:`resume_offset` and
  1125	        :meth:`walk_from` consume its answer. They used to validate and
  1126	        re-read separately, which meant the place where the anchor actually
  1127	        became an authority was not the place the checks lived — the proxy
  1128	        shape behind two rounds of findings.
  1129	
  1130	        Five checks, all of which must hold:
  1131	
  1132	        1. The mark's lineage is this log's. A mark from another lineage is
  1133	           not stale, it is a mark about a different file, and pointing it
  1134	           here is meaningless.
  1135	        2. The offset is an integer inside ``0..size``. A negative offset is
  1136	           not a seek position to try, it is metadata that cannot be true.
  1137	        3. It lands strictly on a record boundary.
  1138	        4. The record ending there carries the ordinal the mark claims.
  1139	        5. That record may be adopted as an authority
  1140	           (:func:`_authority_fault`) — its own lineage is the genesis's,
  1141	           and it may sit where it claims to sit. Without the first half, a
  1142	           crafted interior record with a foreign lineage and a recomputing
  1143	           ``rh`` becomes the anchor and the tail walk verifies the rest of
  1144	           the file against the attacker's lineage. Without the second, a
  1145	           record the full walk refuses becomes a legal place to resume
  1146	           from, and the resume path consumes straight past corruption the
  1147	           read path stops at.
  1148	
  1149	        What these do NOT establish is in :func:`_authority_fault`: the
  1150	        anchor is checked for self-consistency, never for chaining back to
  1151	        genesis. The mark is a cheap boundary check; :meth:`walk` is the
  1152	        integrity statement.
  1153	
  1154	        Returns ``(offset, anchor, lineage)``, the lineage always the
  1155	        genesis's and never the anchor's.
  1156	        """
  1157	        if mark is None:
  1158	            return None
  1159	        if not self.path.exists():
  1160	            return None
  1161	        try:
  1162	            lineage = self.lineage()
  1163	        except (GenesisRefused, ArrivalError):
  1164	            return None
  1165	        if mark.arrival_lineage != lineage:
  1166	            return None
  1167	        if not _is_int(mark.arrival_offset) or not _is_int(mark.arrival_ordinal):
  1168	            return None
  1169	        if mark.arrival_offset == 0:
  1170	            return None  # nothing consumed; identical to a fresh start
  1171	        if not 0 <= mark.arrival_offset <= self.size():
  1172	            return None
  1173	        anchor = self._record_ending_at(mark.arrival_offset)
  1174	        if anchor is None or anchor["ord"] != mark.arrival_ordinal:
  1175	            return None
  1176	        if _authority_fault(anchor, lineage) is not None:
  1177	            return None
  1178	        return mark.arrival_offset, anchor, lineage
  1179	
  1180	    def _record_ending_at(self, offset: int) -> dict | None:
  1181	        """The record whose ``\\n`` is the byte before ``offset``, or None
  1182	        when the offset is not a boundary or the record does not decode."""
  1183	        with self.path.open("rb") as fh:
  1184	            fh.seek(offset - 1)
  1185	            if fh.read(1) != b"\n":
  1186	                return None
  1187	            start = _last_newline_before(fh, offset - 1)
  1188	            fh.seek(start)
  1189	            raw = fh.read(offset - 1 - start)
  1190	        try:
  1191	            return decode_record(raw)
  1192	        except ArrivalGrammarError:
  1193	            return None
  1194	
  1195	    def walk_from(self, mark: ResumeMark | None) -> tuple[int, Iterator[dict]]:
  1196	        """Resume a consumption: the ordinal resumed at, and the records after.
  1197	
  1198	        :meth:`walk_marked` minus the marks — one adoption/verification
  1199	        path, two projections of it. Returns ``(0, ...)`` whenever the mark
  1200	        is rejected, so a caller that persists progress learns it is
  1201	        starting over instead of discovering it by ordinal.
  1202	        """
  1203	        resumed, pairs = self.walk_marked(mark)
  1204	        return resumed, _records_only(pairs)
  1205	
  1206	    def walk_marked(
  1207	        self, mark: ResumeMark | None
  1208	    ) -> tuple[int, Iterator[tuple[dict, ResumeMark]]]:
  1209	        """:meth:`walk_from`, yielding each record WITH its resume mark.
  1210	
  1211	        For the consumer that indexes what it reads and must persist how far
  1212	        it got: the mark beside each record is the one that licenses
  1213	        resuming just past it, exact to the byte because the verification
  1214	        loop tracked it. ``(0, ...)`` means the walk starts over — either no
  1215	        mark was offered or the offered one was rejected, and the caller
  1216	        that persists progress must treat its prior state accordingly.
  1217	        """
  1218	        adopted = self._anchor_for(mark)
  1219	        if adopted is None:
  1220	            resumed, pairs = 0, self._walk_marked_from_zero()
  1221	        else:
  1222	            offset, anchor, lineage = adopted
  1223	            # The lineage comes from the GENESIS, never from the anchor: an
  1224	            # anchor is a record found at a byte offset a caller supplied,
  1225	            # and letting it name the lineage would let it decide what the
  1226	            # rest of the walk is checked against.
  1227	            resumed, pairs = anchor["ord"] + 1, self._walk_tail(offset, anchor, lineage)
  1228	
  1229	        def marked() -> Iterator[tuple[dict, ResumeMark]]:
  1230	            for record, end in pairs:
  1231	                yield record, ResumeMark(
  1232	                    arrival_lineage=record["lin"],
  1233	                    arrival_offset=end,
  1234	                    arrival_ordinal=record["ord"],
  1235	                )
  1236	
  1237	        return resumed, marked()
  1238	
  1239	    def _walk_marked_from_zero(self) -> Iterator[tuple[dict, int]]:
  1240	        if not self.path.exists():
  1241	            return
  1242	        with self.path.open("rb") as fh:
  1243	            yield from self._verify_from(fh, expected=0, prev=None, lineage=None)
  1244	
  1245	    def _walk_tail(
  1246	        self, offset: int, anchor: dict, lineage: str
  1247	    ) -> Iterator[tuple[dict, int]]:
  1248	        """:meth:`walk`'s verification, started from a validated anchor.
  1249	
  1250	        Literally the same rules, not merely the same list of them: both
  1251	        paths run :meth:`_verify_from`, and only the starting point differs.
  1252	        ``lineage`` is the log's, established from its genesis by the
  1253	        caller, so the anchor never decides what the rest is checked
  1254	        against.
  1255	        """
  1256	        with self.path.open("rb") as fh:
  1257	            fh.seek(offset)
  1258	            yield from self._verify_from(
  1259	                fh, expected=anchor["ord"] + 1, prev=anchor[_RH], lineage=lineage
  1260	            )
   330	    canonical = Path(canonical)
   331	    from .residence import index_path_for
   332	
   333	    checks: list[Check] = []
   334	    size = _log_size(canonical)
   335	    if size < 0:
   336	        return AgreementReport(
   337	            (Check("log", False, f"canonical log unreadable at {canonical}"),)
   338	        )
   339	
   340	    conn = _open_index(index_path_for(canonical))
   341	    if conn is None:
   342	        return AgreementReport(
   343	            (
   344	                Check(
   345	                    "index",
   346	                    False,
   347	                    f"no readable derived index at {index_path_for(canonical)} — "
   348	                    "run any read verb to materialize it, then verify",
   349	                ),
   350	            )
   351	        )
   352	    try:
   353	        checks.append(Check("index", True, "derived index readable"))
   354	        offset = _meta_int(conn, OFFSET_KEY)
   355	        counts = _row_counts(conn)
   356	        checks.append(_check_offset(conn, canonical, offset, size))
   357	        checks.append(_check_counts(conn, counts))
   358	        checks.append(_check_last_line(conn, canonical, size, offset))
   359	        return AgreementReport(tuple(checks), counts=counts)
   360	    finally:
   361	        conn.close()
   362	
