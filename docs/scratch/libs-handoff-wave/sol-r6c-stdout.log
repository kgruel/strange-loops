   445	    """Scan lines[lo..hi] for a block matching segment. Brace-depth tracked.
   446	
   447	    Skips over nested children at depth>0 so we only match siblings of the
   448	    target's scope. Returns (start_line, end_line) inclusive.
   449	    """
   450	    start = -1
   451	    depth = 0
   452	    i = lo
   453	    while i <= hi:
   454	        stripped = lines[i].strip()
   455	        if start == -1:
   456	            # Only consider lines at depth 0 (sibling scope) as potential matches.
   457	            if _line_opens_matching_block(stripped, segment):
   458	                start = i
   459	                depth = stripped.count("{") - stripped.count("}")
   460	                if depth == 0:
   461	                    return start, i
   462	            else:
   463	                # Track depth changes from non-matching opens so we skip their bodies.
   464	                opens = stripped.count("{")
   465	                closes = stripped.count("}")
   466	                if opens > closes:
   467	                    # Skip this nested block's body entirely.
   468	                    body_depth = opens - closes
   469	                    j = i + 1
   470	                    while j <= hi and body_depth > 0:
   471	                        body_depth += lines[j].count("{") - lines[j].count("}")
   472	                        j += 1
   473	                    i = j
   474	                    continue
   475	        else:
   476	            depth += stripped.count("{") - stripped.count("}")
