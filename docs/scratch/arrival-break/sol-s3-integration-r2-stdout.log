  2050	def test_a_new_decree_lifts_the_fence(tmp_path):
  2051	    """The lift rule, end to end — and the reason the fence needs one.
  2052	
  2053	    Without it the ceremony re-bricks the store: an operator who genuinely
  2054	    wants the recovered history back would have no way to say so, and the
  2055	    remedy would be permanent refusal. A later decree supersedes the earlier
  2056	    abandonment, so recovery costs exactly one ceremony.
  2057	    """
  2058	    log_path, lineage, abandoned, backup = _reset_away_from(tmp_path)
  2059	    log_path.write_bytes(backup)
  2060	    with pytest.raises(AbandonedHistoryFenced):
  2061	        opened(log_path)
  2062	
  2063	    trust_reset(  # the operator decrees the recovered head
  2064	        accepted=abandoned,
  2065	        abandoned=None,
  2066	        refused=None,
  2067	        reason="the archive copy was the authentic history; adopting it",
  2068	        location=str(log_path),
  2069	        observed_at=6000.0,
  2070	    )
  2071	
  2072	    comparison = opened(log_path).opened.comparison
  2073	    assert isinstance(comparison, Compared)
  2074	    assert comparison.outcome is Outcome.UNCHANGED
  2075	    assert read_journal(lineage).established_head().head == abandoned
  2076	
  2077	
  2078	def test_a_branch_grown_offline_past_the_abandoned_head_is_refused(tmp_path):
  2079	    """Reach: every coordinate of the descent, not just the presented head.
  2080	
  2081	    The abandoned entry sits at *N+1* while the restored branch has grown on to
  2082	    *N+3*, so the presented head is a coordinate the journal has never seen.
  2083	    Checking only the head waves it straight through — the fence has to ask
  2084	    about the path.
  2085	    """
  2086	    log_path, lineage, abandoned, backup = _reset_away_from(tmp_path)
  2087	    log_path.write_bytes(backup)
  2088	    append_legacy(log_path, "three", "four")  # the branch grew while away
  2089	    grown = FileLedger(ArrivalLog(log_path)).verify(Open())
  2090	    assert grown.ordinal > abandoned.ordinal
  2091	
  2092	    with pytest.raises(AbandonedHistoryFenced) as excinfo:
  2093	        opened(log_path)
  2094	    assert f"ordinal {abandoned.ordinal}" in str(excinfo.value)
  2095	
  2096	
  2097	def test_a_legitimate_re_advance_inside_the_abandoned_span_is_accepted(tmp_path):
  2098	    """Pin 1: identity-keyed, so the fence is not an ordinal span.
  2099	
  2100	    After a reset to *N* the store re-advances and mints a NEW *N+1* — a
  2101	    different record at an ordinal the abandoned history also used. A span
  2102	    fence would refuse this forever, which would make the ceremony a store's
  2103	    last act. Only the exact abandoned records are fenced.
  2104	    """
  2105	    log_path, lineage, abandoned, _backup = _reset_away_from(tmp_path)
  2106	
  2107	    # The truncation left a projection holding a resume mark the shortened log
  2108	    # rejects, so drop it and let the legacy path rebuild — a fixture concern,
  2109	    # not the fence's.
  2110	    index_path_for(log_path).unlink(missing_ok=True)
  2111	    append_legacy(log_path, "a genuinely new record")
  2112	    fresh = FileLedger(ArrivalLog(log_path)).verify(Open())
  2113	    assert fresh.ordinal == abandoned.ordinal, "same ordinal, by construction"
  2114	    assert fresh.record_hash != abandoned.record_hash
  2115	
  2116	    comparison = opened(log_path).opened.comparison
  2117	    assert isinstance(comparison, Compared)
  2118	    assert comparison.outcome is Outcome.ADVANCED
  2119	
