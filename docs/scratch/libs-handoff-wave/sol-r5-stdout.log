   226	def _write_vertex(home: Path, name: str, *, store: str | None) -> Path:
   227	    vdir = home / name
   228	    vdir.mkdir(parents=True)
   229	    vertex_path = vdir / f"{name}.vertex"
   230	    store_line = f'store "{store}"\n' if store is not None else ""
   231	    vertex_path.write_text(
   232	        f'name "{name}"\n'
   233	        f"{store_line}"
   234	        "loops {\n"
   235	        "  counter {\n"
   236	        "    fold { count \"inc\" }\n"
   237	        "  }\n"
   238	        "}\n"
   239	    )
   240	    return vertex_path
