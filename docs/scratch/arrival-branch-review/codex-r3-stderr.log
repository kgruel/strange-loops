  1025	                raise ArrivalCorrupt(
  1026	                    f"ordinal succession broken: found ord {record['ord']!r} "
  1027	                    f"where {expected} was due",
  1028	                    expected,
  1029	                )
  1030	            if record["prev"] != prev:
  1031	                raise ArrivalCorrupt(
  1032	                    f"prev names {record['prev']!r}, "
  1033	                    f"but the preceding record's rh is {prev!r}",
  1034	                    expected,
  1035	                )
