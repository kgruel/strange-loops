  1524	def test_an_injected_collision_costs_a_walk_and_never_an_acceptance():
  1525	    """Where the gate is wrong, it must be wrong on the verification side.
  1526	
  1527	    Two genuinely independent events that serialize to identical bytes are
  1528	    indistinguishable from a replay, so the gate drops the later one. This
  1529	    constructs exactly that — a post-reset entry whose bytes coincide with one
  1530	    from the abandoned epoch — and pins the consequence, rather than resting on
  1531	    the collision being improbable.
  1532	
  1533	    The consequence is that *K* reads LOWER than the truth. The store then
  1534	    presents a head above it, which is an ADVANCE, and the advance branch is
  1535	    the one that pays for a verified walk: descent from the remembered head is
  1536	    established before anything is accepted. Cost, not credulity — the failure
  1537	    lands on the verification side, never on acceptance.
  1538	    """
  1539	    for ordinal in (1, 2, 3):
  1540	        append_entry(observation(ordinal))
  1541	    append_reset(1)
  1542	    append_entry(observation(3))  # a genuine new entry, colliding with line 4
  1543	
  1544	    result = read_journal(LINEAGE)
  1545	    assert any("byte-identical" in note for note in result.skipped)
  1546	    # K is the reset head, NOT the colliding 3 — lower than the truth.
  1547	    assert result.known.at_least.head.ordinal == 1
  1548	    # A store at the true head is therefore an ADVANCE, which must establish
  1549	    # descent rather than be believed: with no vouched record at K, REWRITE.
  1550	    assert compare(result.known.at_least, head(3), None) is Outcome.REWRITE
  1551	    assert compare(result.known.at_least, head(3), head(1)) is Outcome.ADVANCED
