    74	# --- Tick hash chain -------------------------------------------------------
    75	#
    76	# The chain is a STORE-LAYER property, not a Tick-atom property (project
    77	# decision design/tick-chain-at-store-layer). Each persisted tick row commits
    78	# to (a) the previous tick row via prev_hash and (b) the fact window
    79	# (window_start, fact_cursor] via window_hash — making both the tick sequence
    80	# and the fact stream tamper-evident under verification. The Tick dataclass
    81	# stays pure; merged/transported stores start fresh chains (new custody
    82	# context). Rows written before the chain existed keep NULL chain columns —
    83	# a visible pre-chain era, never retro-claimed.
    84	#
    85	# ORDERING AUTHORITY (observation design/event-order-vs-witness-order): window
    86	# cursors are fact IDS (portable handles), but window MEMBERSHIP and hashing
    87	# follow APPEND ORDER (rowid) — never id order. The chain's claim is receipt-
    88	# integrity ("this store received these facts and nothing changed after
    89	# sealing"), not chronology. Two reasons id order is the wrong authority here:
    90	# (1) mixed-id-era stores — uuid4-era ids (2026-03-15..05-16) sort above every
    91	# ULID, so MAX(id) pins to a mid-history fact forever and every window minted
    92	# after is empty (friction chain-cursor-assumes-ulid-order); (2) late arrival —
    93	# a backfilled/synced fact honestly carrying an old event timestamp would land
    94	# INSIDE a sealed id-window and raise a false tamper alarm, where in witness
    95	# order it lands on the live edge and the next tick seals it as received-now.
    96	# Event order (ULID, fact.ts) remains the READ path's order; the two orders
    97	# answer different questions and neither substitutes for the other.
    98	#
    99	# Delta 2 (design/tick-signature-on-every-tick): each tick row may carry an
   100	# Ed25519 signature over its COMMITMENT hash (the 10 chain fields). Signing
   101	# is injected, never imported — the store takes an optional signer callable
   102	# (digest str -> signature str); verify_chain takes an optional verifier
   103	# (signature str, digest str -> bool). apps/loops composes both with
   104	# libs/sign. Pre-signature rows keep NULL — a visible era, same posture as
   105	# the pre-chain era. The successor's prev_hash commits to the signature
   106	# (design/tick-signature-in-chain-envelope): the row-IDENTITY hash is
   107	# era-aware (includes the signature key only when non-NULL), so stripping a
   108	# signature breaks the successor's link and a forger must rewrite the whole
   109	# chain ahead — at which point only the registry outside the store (and
   110	# external witnessing, a later delta) anchors the truth.
   111	
   112	_CHAIN_COLUMNS = ("prev_hash", "window_start", "fact_cursor", "window_hash",
   113	                  "signature")
   114	
   115	# Persisted column order — ONE spelling, derived from the codec's field
   116	# tuples. The schema, the INSERTs, the SELECTs and the JSONL line all order
   117	# their columns the same way by construction; a row assembled for one is the
   118	# row the others take. Spelling it a second time is how a fact ends up with
   119	# its observer in the origin column.
   120	FACT_COLUMNS = (*jsonl_codec.FACT_FIELDS, "signature")
   121	TICK_COLUMNS = (*jsonl_codec.TICK_FIELDS, "signature")
   122	
