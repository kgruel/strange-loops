   121	def _child_topology_entry(ref_ast: Any, vpath: Path, base_dir: Path) -> dict:
   122	    """Build a topology entry dict for a single child vertex."""
   123	    from lang.ast import FoldBy
   124	
   125	    kind_keys: dict[str, str] = {}
   126	    for kind_name, loop_def in ref_ast.loops.items():
   127	        for fold_decl in loop_def.folds:
   128	            if isinstance(fold_decl.op, FoldBy):
   129	                kind_keys[kind_name] = fold_decl.op.key_field
   130	                break
   131	
   132	    store_str = ""
   133	    if ref_ast.store is not None:
   134	        sp = resolved_index(ref_ast.store, vpath)
   135	        store_str = str(sp)
   136	
   137	    try:
   138	        rel_path = str(vpath.relative_to(base_dir))
   139	    except ValueError:
   140	        rel_path = str(vpath)
   141	
   142	    return {
   143	        "name": ref_ast.name,
   144	        "path": rel_path,
   145	        "store": store_str,
   146	        "kind_keys": kind_keys,
   147	    }
