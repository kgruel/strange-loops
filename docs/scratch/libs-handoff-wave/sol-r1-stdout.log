   518	def _resolve_address_rowid(conn: sqlite3.Connection, address: str) -> tuple[str, int]:
   519	    """Map an address to ``(fact_id, rowid)`` — primary-key lookup only (A3)."""
   520	    if address == GENESIS_SENTINEL:
   521	        return GENESIS_SENTINEL, 0
   522	    if address == "head":
   523	        row = conn.execute(
   524	            "SELECT id, rowid FROM facts ORDER BY rowid DESC LIMIT 1"
   525	        ).fetchone()
   526	        if row is None:
   527	            return GENESIS_SENTINEL, 0  # empty store → empty prefix
   528	        return row[0], row[1]
   529	    # A full fact id — PK point lookup, never ordered or parsed.
   530	    row = conn.execute(
   531	        "SELECT rowid FROM facts WHERE id = ?", (address,)
   532	    ).fetchone()
   533	    if row is None:
   534	        raise UnknownWitnessHandle(
   535	            f"no fact with id {address!r} in this store — a witness handle "
   536	            "resolves by exact id (ids are opaque; never parsed or ordered)"
   537	        )
   538	    return address, row[0]
