   208	def test_page_boundary_strictly_inside_decl_ceremony_does_not_refuse(tmp_path):
   209	    """MUTATION KILLER for group_boundary='allow' (gate finding).
   210	
   211	    The main fixture's ``_decl.*`` rows are singletons — never mid-group — so
   212	    reverting the witness.py allow-mode change leaves the other tests green.
   213	    This store carries a REAL contiguous receipt group (3 adjacent ``_decl``
   214	    rows, one shared ts, one shared lineage — the ``receipt_group_span``
   215	    heuristic's exact signature), and an include_internal limit=1 walk puts a
   216	    page boundary strictly INSIDE the span (first <= rowid < last). With the
   217	    allow mode reverted, next-cursor resolution raises
   218	    MidReceiptGroupPosition there; with it, the walk completes losslessly —
   219	    a page mark is read progress, not a fold cut.
   220	    """
   221	    path = tmp_path / "ceremony.db"
   222	    store = _open_store(path)
   223	    ids = [store.append(Fact.of("decision", "kyle", ts=1.0 + i, topic=f"t{i}"))
   224	           for i in range(2)]
   225	    for j in range(3):  # contiguous ceremony: same ts, same lineage, adjacent rowids
   226	        ids.append(store.append(Fact.of(
   227	            "_decl.kind_defined", "kyle", ts=99.0, lineage="L-ceremony", seq=j,
   228	        )))
   229	    ids.append(store.append(Fact.of("thread", "kyle", ts=200.0, name="after")))
   230	    store.close()
   231	
   232	    from engine.witness import receipt_group_span
   233	    import sqlite3
   234	    conn = sqlite3.connect(str(path))
   235	    # Prove the fixture is adversarial: the middle ceremony row IS mid-group.
   236	    mid_rowid = conn.execute("SELECT rowid FROM facts WHERE id = ?", (ids[3],)).fetchone()[0]
   237	    assert receipt_group_span(conn, mid_rowid) is not None
   238	    conn.close()
   239	
   240	    with StoreReader(path) as reader:
   241	        paged = _walk(reader, "oldest", 1, include_internal=True)
   242	    assert [f["id"] for f in paged] == ids
