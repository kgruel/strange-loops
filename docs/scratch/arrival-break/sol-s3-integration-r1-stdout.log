  1532	def test_an_injected_collision_costs_a_walk_and_never_an_acceptance():
  1533	    """Where the gate is wrong, it must be wrong on the verification side.
  1534	
  1535	    Two genuinely independent events that serialize to identical bytes are
  1536	    indistinguishable from a replay, so the gate drops the later one. This
  1537	    constructs exactly that — a post-reset entry whose bytes coincide with one
  1538	    from the abandoned epoch — and pins the consequence, rather than resting on
  1539	    the collision being improbable.
  1540	
  1541	    The consequence is that *K* reads LOWER than the truth. The store then
  1542	    presents a head above it, which is an ADVANCE, and the advance branch is
  1543	    the one that pays for a verified walk: descent from the remembered head is
  1544	    established before anything is accepted. Cost, not credulity — the failure
  1545	    lands on the verification side, never on acceptance.
  1546	    """
  1547	    for ordinal in (1, 2, 3):
  1548	        append_entry(observation(ordinal))
  1549	    append_reset(1)
  1550	    append_entry(observation(3))  # a genuine new entry, colliding with line 4
  1551	
  1552	    result = read_journal(LINEAGE)
  1553	    assert any("byte-identical" in note for note in result.skipped)
  1554	    # K is the reset head, NOT the colliding 3 — lower than the truth. And the
  1555	    # read is now ESTABLISHED at that low K, which is what makes the dedup
  1556	    # predicate acceptance-load-bearing: a false match discards a real line and
  1557	    # still claims to know the head. This is the pin for that weight.
  1558	    known = result.established_head()
  1559	    assert known is not None
  1560	    assert known.head.ordinal == 1
  1561	    # A store at the true head is therefore an ADVANCE, which must establish
  1562	    # descent rather than be believed: with no vouched record at K, REWRITE.
  1563	    assert compare(known, head(3), None) is Outcome.REWRITE
  1564	    assert compare(known, head(3), head(1)) is Outcome.ADVANCED
  1565	
