+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from lang import ParseError, effective_store_clause, parse_vertex_file
+from migrate import PublishPreconditionRefused, edit_vertex_store_clause
+
+
+ACCEPTED_CASES = {
+    "hash_raw_decoy": (
+        '''name r#"project " store decoy"#
+store "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+''',
+        'store "./legacy.jsonl"',
+        ' // KEEP',
+    ),
+    "hash_raw_property": (
+        '''name "project"
+store "./legacy.jsonl" backend=r#"fi" // OLD PROPERTY BYTES"# // KEEP COMMENT
+loops { probe { fold { items "collect" 10 } } }
+''',
+        'store "./legacy.jsonl" backend=r#"fi" // OLD PROPERTY BYTES"#',
+        ' // KEEP COMMENT',
+    ),
+    "hash_raw_deletes_comment": (
+        '''name "project"
+store "./legacy.jsonl" backend=r#"fi" fake"# // KEEP OPERATOR " tail
+loops { probe { fold { items "collect" 10 } } }
+''',
+        'store "./legacy.jsonl" backend=r#"fi" fake"#',
+        ' // KEEP OPERATOR " tail',
+    ),
+}
+
+REFUSED_CASES = {
+    "quoted_store_node": '''name "project"
+"store" "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+''',
+    "raw_store_node": '''name "project"
+r#"store"# "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+''',
+}
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r3") as tmp:
+    root = Path(tmp)
+    for case, (text, clause, tail) in ACCEPTED_CASES.items():
+        vertex = root / f"{case}.vertex"
+        vertex.write_text(text, encoding="utf-8")
+        parsed = parse_vertex_file(vertex)
+        located = effective_store_clause(text, vertex)
+        expected = (text.index(clause), text.index(clause) + len(clause))
+        assert located.count == 1 and located.span == expected
+        before_prefix = text[: expected[0]]
+        before_suffix = text[expected[1] :]
+        edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+        edited = vertex.read_text(encoding="utf-8")
+        replacement = 'store "./target.arrival" backend="file"'
+        assert edited == before_prefix + replacement + before_suffix
+        assert tail in edited
+        print(
+            f"{case}: parsed_store={str(parsed.store)!r} count={located.count} "
+            f"span={located.span} slice={text[slice(*located.span)]!r} "
+            f"edit=ACCEPTED tail_preserved=True"
+        )
+
+    for case, text in REFUSED_CASES.items():
+        vertex = root / f"{case}.vertex"
