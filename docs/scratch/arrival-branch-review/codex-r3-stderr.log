    66	def _read(path: Path) -> list[str]:
    67	    """A derived log's lines, or ``[]`` when the file is absent or empty.
    68	
    69	    An absent ``%O`` is the ordinary new-file merge (neither side had the
    70	    file at the merge base); an unterminated final line is a torn tail and
    90	
    91	    **The union key is the ROW ID, and identity is the whole canonical
    92	    line.** A batch line carries several ids and every one of them maps to
    93	    that same whole line — which is why the key cannot be a naive ``(t, id)``
    94	    pair read off the object: a batch has no single id, and the same row can
    95	    be a plain fact line on one side and ride inside a batch on the other.
    96	    Mapping id → whole line makes that a detectable divergence rather than a
    97	    silent duplicate.
    98	
    99	    Lines are CANONICALIZED before comparison, through engine's one spelling
   100	    of the grammar, so key order or whitespace noise cannot mint a false
   101	    conflict.
   102	    """
   103	    from engine.arrival_projection import canonical_line
   104	    from engine.jsonl_codec import deserialize_records
   105	
   106	    index: dict[str, str] = {}
   107	    for line in lines:
   108	        canonical = canonical_line(line)
   109	        for _t, row in deserialize_records(canonical):
   110	            row_id = row[0]
   111	            previous = index.get(row_id)
   112	            if previous is not None and previous != canonical:
   113	                raise DerivedLogMergeConflict(
   114	                    f"{side} carries row id {row_id} twice, with different "
   115	                    "bytes — no index can consume such a log, so there is "
   116	                    "nothing here to merge"
   117	                )
   118	            index[row_id] = canonical
   119	    return index
   120	
   121	
   122	def merge_derived_log(
   123	    base: Path, ours: Path, theirs: Path, out: Path | None = None
   124	) -> DerivedLogMergeResult:
   125	    """Union two derived logs, or refuse. Writes ``out`` (default ``ours``).
   126	
   127	    Per row id:
   128	
   129	    ==================================  ==========================
   130	    id on one side only                 include
   131	    id on both sides, identical bytes   include once
   132	    id on both sides, DIFFERENT bytes   **REFUSE**
   133	    id in ``base``, absent from a side  **REFUSE**
   134	    ==================================  ==========================
   135	
   136	    *Same id, different bytes* is a custody contradiction: at most one of
   137	    them is what an arrival log says. Today's ``INSERT OR IGNORE`` resolves
   138	    the same collision silently in the target's favour, and that is the
   139	    behaviour this cut removes — a driver that picked a side would re-mint
   140	    it.
   141	
   142	    *Loss against base* cannot happen to a projection of an append-only log.
   143	    If one branch's file lost a line the other kept, that branch's log was
   144	    rewritten. Refusing is the only non-destructive answer, and it is the
   145	    property that makes this a SEMANTIC driver rather than ``merge=union``.
   146	
   147	    Output is byte-sorted and byte-identical to a fresh derivation of the
   148	    merged set.
   149	    """
   150	    from engine.arrival_projection import sort_key
   151	
   152	    base_index = _index(_read(Path(base)), "the merge base")
   153	    our_index = _index(_read(Path(ours)), "our side")
   154	    their_index = _index(_read(Path(theirs)), "their side")
   155	
   156	    for row_id in sorted(base_index):
   157	        for side, index in (("ours", our_index), ("theirs", their_index)):
   158	            if row_id not in index:
   159	                raise DerivedLogMergeConflict(
   160	                    f"row id {row_id} is in the merge base but absent from "
   161	                    f"{side} — a projection of an append-only log cannot "
   162	                    "lose a line, so that side's log was rewritten; refusing "
   163	                    "rather than choosing which history is real"
   164	                )
   165	
   166	    shared = 0
   167	    merged = dict(our_index)
   168	    for row_id, line in their_index.items():
   169	        existing = merged.get(row_id)
   170	        if existing is None:
   171	            merged[row_id] = line
   172	            continue
   173	        shared += 1
   174	        if existing != line:
   175	            raise DerivedLogMergeConflict(
   176	                f"row id {row_id} carries different bytes on the two sides — "
   177	                "at most one of them is what an arrival log says, and "
   178	                "choosing between them would re-mint the silent-overwrite "
   179	                "this driver exists to remove"
   180	            )
   181	
   182	    lines = sorted(set(merged.values()), key=sort_key)
   183	    target = Path(ours if out is None else out)
   184	    target.write_text(
   185	        "".join(line + "\n" for line in lines), encoding="utf-8"
   186	    )
   187	    return DerivedLogMergeResult(
   188	        lines=len(lines),
   189	        from_ours=len(our_index),
   190	        from_theirs=len(their_index),
