    91	def grant_for_observer(ast: "VertexFile", observer: str) -> "Grant | None":
    92	    """Resolve the declared admission policy for ``observer`` to a Grant.
    93	
    94	    The five contract cases (LIBS_CHANGES P1, observer admission):
    95	
    96	    * **aggregate vertex** (``combine``/``discover`` set) — raises
    97	      :class:`AggregateAdmissionUnsupported`; members own admission.
    98	    * **no observers block** — returns ``None``: the declaration carries
    99	      no observer policy, admission is unrestricted.
   100	    * **unknown observer** (observers declared, this one absent) — raises
   101	      :class:`UnknownObserver`: a declared-policy vertex admits only
   102	      declared observers.
   103	    * **declared observer without a grant** — returns ``None``: declared,
   104	      unconstrained (same admission as no-policy, reached deliberately).
   105	    * **declared observer with a potential set** — returns a
   106	      :class:`~engine.peer.Grant` carrying that ``potential`` frozenset.
   107	
   108	    Returns:
   109	        ``Grant | None`` suitable for ``Vertex.receive(fact, grant)``.
   110	    """
   111	    if ast.combine is not None or ast.discover is not None:
   112	        raise AggregateAdmissionUnsupported(ast.name)
   113	
   114	    if not ast.observers:
   115	        return None
   116	
   117	    for decl in ast.observers:
   118	        if decl.name == observer:
   119	            if decl.grant is None:
   120	                return None
   121	            from .peer import Grant
   122	
   123	            return Grant(potential=frozenset(decl.grant.potential))
   124	
   125	    raise UnknownObserver(observer, ast.name)
   126	
   127	
   128	__all__ = [
   129	    "AdmissionError",
   130	    "UnknownObserver",
   131	    "UndeclaredKind",
   132	    "AggregateAdmissionUnsupported",
   133	    "grant_for_observer",
   134	]
     1	"""Vertex: where loops meet.
     2	
     3	A Vertex manages fold engines, routes facts by kind to the right
     4	consumer, holds an optional Store, and produces Ticks when a
     5	temporal boundary fires.
     6	
     7	Kind-based routing: register a fold for each kind. When a fact
     8	arrives, the Vertex dispatches to the matching fold engine.
     9	Projection is the internal fold engine detail — callers register
    10	folds, not Projections.
    11	
    12	Boundary triggering: a fold engine can declare a boundary kind.
    13	When a fact with that kind arrives, the engine's state is snapshot
    14	into a Tick and optionally reset. The boundary fires after the fold
    15	completes (fold-before-boundary).
    16	
    17	Decoupled boundary evaluation: evaluate_boundaries() checks boundary
    18	triggers for facts that arrived via external emit (between vertex runs).
    19	Facts folded during replay don't trigger boundaries — evaluate_boundaries()
    20	scans the current period's facts and fires any matching boundaries against
    21	the fully-rebuilt fold state. Called by the Executor before source execution.
    22	
    23	Grant-aware receive: the Vertex gates facts against an optional Grant's
    24	potential. Observer-state kinds (focus.{observer}, scroll.{observer},
    25	selection.{observer}) must match the fact's observer.
    26	"""
    27	
