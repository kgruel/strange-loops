    80	def _delete_every_projection(log_path: Path) -> None:
    81	    index = log_path.with_suffix(".db")
    82	    for stale in (index, *sqlite_sidecars(index), log_path.with_suffix(".jsonl")):
    83	        stale.unlink(missing_ok=True)
    84	    remaining = {p.name for p in log_path.parent.iterdir() if p.is_file()}
    85	    assert remaining & {"s.arrival"} == {"s.arrival"}
    86	    assert not any(n.endswith((".db", "-wal", "-shm", ".jsonl")) for n in remaining)
    87	
