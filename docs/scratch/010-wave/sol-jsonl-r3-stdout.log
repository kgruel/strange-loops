   462	    def _reconcile(self) -> None:
   463	        """Refuse to stamp past a durable line the index has not consumed.
   464	
   465	        A failure *after* the fsync (sqlite error, power cut, the process
   466	        dying) rolls the transaction back, leaving the line durable and the
   467	        offset unstamped — that is the recoverable state, and the next open
   468	        tails it forward. But a long-lived handle never reopens: it would
   469	        append line N+1 and stamp the offset past *both*, burying the orphan
   470	        forever while reporting ``synced``. So every append reconciles first.
   471	
   472	        Cheap in the common case: one ``store_meta`` read and one ``stat``,
   473	        no scan, no lock. Only a disagreement pays for :meth:`catch_up`
   474	        (which also covers a shrunk log, a torn tail and untrustworthy
   475	        offset metadata). Two handles racing the same orphan line is a loud
   476	        failure, not a silent one: the loser's tail INSERT hits the primary
   477	        key, rolls back, and the line stays recoverable.
   478	        """
   479	        if self._read_offset() == self._log_size():
   480	            return
   481	        self.catch_up()
