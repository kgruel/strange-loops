   718	def test_custodian_is_derived_never_caller_supplied() -> None:
   719	    """The custodian identity cannot be supplied by a caller (sol r1 finding
   720	    s4-sol-r1-custodian-authority-source, arm b): it derives from the custody
   721	    self-observer. This pins the public surfaces against a reintroduced
   722	    override parameter — a caller-suppliable custodian is the bypass sol
   723	    constructed (a mallory genesis under an alice declaration)."""
   724	    import inspect
   725	
   726	    from migrate.sidecar import run_migration
   727	    from migrate.transform import transform
   728	
   729	    for fn in (run_migration, transform):
   730	        for name in inspect.signature(fn).parameters:
   731	            assert "custodian" not in name, (
   732	                f"{fn.__name__} grew a caller-supplied custodian parameter "
   733	                f"({name!r}) — the custodian is derived from the declaration, "
   734	                "never supplied"
   735	            )
   974	def _scan_kdl_node_end(text: str, start_pos: int) -> int:
   975	    """Scan forward from start_pos (start of node name) to find the end character offset
   976	    of the node's arguments and properties (excluding trailing whitespace/comments/terminators).
   977	    """
   978	    i = start_pos
   979	    n = len(text)
   980	    node_end = start_pos
   981	
   982	    while i < n:
   983	        ch = text[i]
   984	
   985	        # Check for line comment or newline or semicolon or child block
   986	        if ch in ("\n", "\r", ";", "{", "}"):
   987	            break
   988	        if ch == "/" and i + 1 < n and text[i + 1] == "/":
   989	            break
   990	
   991	        # Check for whitespace
   992	        if ch.isspace():
   993	            i += 1
   994	            continue
   995	
   996	        # Check for block comment /* ... */
   997	        if ch == "/" and i + 1 < n and text[i + 1] == "*":
   998	            bc_depth = 1
   999	            i += 2
  1000	            while i < n and bc_depth > 0:
  1001	                if text[i] == "/" and i + 1 < n and text[i + 1] == "*":
  1002	                    bc_depth += 1
  1003	                    i += 2
  1004	                elif text[i] == "*" and i + 1 < n and text[i + 1] == "/":
  1005	                    bc_depth -= 1
  1006	                    i += 2
  1007	                else:
  1008	                    i += 1
  1009	            continue
  1010	
  1011	        # Check for string token
  1012	        if ch == '"':
  1013	            i += 1
  1014	            while i < n:
  1015	                if text[i] == "\\":
  1016	                    i += 2
  1017	                elif text[i] == '"':
  1018	                    i += 1
  1019	                    break
  1020	                else:
  1021	                    i += 1
  1022	            node_end = i
  1023	            continue
  1024	
  1025	        # Raw string: r"..." or r#"..."#
  1026	        if ch == "r" and i + 1 < n and (text[i + 1] == '"' or text[i + 1] == "#"):
  1027	            hashes = 0
  1028	            idx = i + 1
  1029	            while idx < n and text[idx] == "#":
  1030	                hashes += 1
  1031	                idx += 1
  1032	            if idx < n and text[idx] == '"':
  1033	                i = idx + 1
  1034	                end_pat = '"' + ("#" * hashes)
  1035	                found = text.find(end_pat, i)
  1036	                if found != -1:
  1037	                    i = found + len(end_pat)
  1038	                else:
  1039	                    i = n
  1040	                node_end = i
  1041	                continue
  1042	
  1043	        # Bare token / property (key=val or arg)
  1044	        tok_start = i
  1045	        while i < n and not text[i].isspace() and text[i] not in (";", "{", "}", "\n", "\r"):
  1046	            if text[i] == "/" and i + 1 < n and (text[i + 1] in ("/", "*")):
  1047	                break
  1048	            if text[i] == '"':
  1049	                # Embedded string in property like backend="file"
  1050	                i += 1
  1051	                while i < n:
  1052	                    if text[i] == "\\":
  1053	                        i += 2
  1054	                    elif text[i] == '"':
  1055	                        i += 1
  1056	                        break
  1057	                    else:
  1058	                        i += 1
  1059	            else:
  1060	                i += 1
  1061	        node_end = i
  1062	
  1063	    return node_end
  1064	
