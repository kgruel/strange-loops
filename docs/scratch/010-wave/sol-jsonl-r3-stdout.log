   558	    def _sync_derived_state(self) -> None:
   559	        """Seam: bring derived state up to date before reading chain state.
   560	
   561	        A no-op here — sqlite IS the state. A subclass whose sqlite is a
   562	        DERIVED index (engine.jsonl_store) must reconcile the index with its
   563	        canonical log *before* any mint reads chain state from it: a durable
   564	        but unindexed line would otherwise be invisible to the predecessor,
   565	        window-start and fact-cursor derivation, and the resulting mis-linked
   566	        tick lands in the canonical log where no rebuild can repair it.
   567	
   568	        Called at the top of ``append_tick``, before the ``prev_row`` read.
   569	        NOT called from ``current_chain_head``: its only production caller is
   570	        ``absorb_genesis``, which reads it inside ``BEGIN IMMEDIATE`` — a
   571	        reconcile there would commit mid-transaction. That path refuses
   572	        outright on a JSONL-canonical store, so the gap is closed already.
   573	        """
