   726	    def _committed_signature(self, table: str, row_id: str) -> str | None:
   727	        """The COMMITTED signature; raises if the row itself is gone.
   728	
   729	        The one read-back per write (SOL-R3-02): executed after the INSERT
   730	        — so any AFTER triggers have already fired — and before the commit,
   731	        it reads exactly what will be committed. An ABSENT row (something
   732	        deleted it out from under the staged INSERT) is a typed refusal
   733	        (SOL-R4-02): callers roll back — a store that eats rows must not
   734	        get a stored=True receipt.
   735	        """
   736	        exists, signature = self._committed_row_state(table, row_id)
   737	        if not exists:
   738	            raise CommittedRowMissing(
   739	                f"the inserted {table} row {row_id} is ABSENT at pre-commit "
   740	                "read-back (a schema-level rewrite, e.g. an AFTER INSERT "
   741	                "trigger, deleted it) — rolling back; refusing to mint a "
   742	                "stored receipt for a row the store did not keep"
   743	            )
   744	        return signature
