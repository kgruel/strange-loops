   121	
   122	def _append_facts(store, n, observer, base):
   123	    """Append facts through the production write path (engine.append).
   124	
   125	    The store's serializer is identity, so the "event" is already the dict
   126	    shape append() consumes — no atoms dependency in libs/store.
   127	    """
   128	    for i in range(n):
   129	        store.append({
   130	            "kind": "thread",
   131	            "ts": base + i,
   132	            "observer": observer,
   133	            "origin": "",
   134	            "payload": {"name": f"arc-{observer}-{i}", "status": "open"},
   135	        })
   136	
