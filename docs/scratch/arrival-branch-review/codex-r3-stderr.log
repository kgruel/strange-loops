   418	# --- helpers ----------------------------------------------------------------
   419	
   420	
     1	"""canonical_audit — does the derived index still agree with the canonical log?
     2	
     3	A JSONL-canonical store (design/architecture/jsonl-canonical-store) has two
     4	artifacts: the ``.jsonl`` log, which IS the store, and the sibling ``.db``,
     5	which is an index derived from it. Every verification surface before this
     6	module walked the *index* only, so an out-of-band sqlite row — a row the log
     7	never carried — still rendered ``✓ chain intact`` at rc=0. That is a false
     8	attestation of exactly the lie-class the chain exists to prevent
     9	(design/store/verify-canonical-agreement).
    10	
    11	This module is the reader that judges the two artifacts against each other.
    12	
    13	**Pure reader, by contract.** Nothing here constructs a :class:`~engine.
    14	jsonl_store.JsonlStore`. That constructor *repairs* — catch-up, torn-line
    15	truncation, rebuild-on-divergence — and repair destroys the evidence
    16	verification exists to inspect. Open-time recovery and verification are
    17	opposite contracts, so they never share a code path: the log is read with
    18	plain file IO through :mod:`engine.jsonl_codec`, the index with a read-only
    19	sqlite connection, and neither offset nor count marker is ever written.
    20	
    21	Two depths:
    22	
    23	``audit_agreement``  (L1, the default gate)
    24	    Three O(1)-ish checks: the stamped byte offset equals the log's size, the
    25	    stamped row counts equal ``COUNT(*)`` per table, and the last complete log
    26	    line agrees field-for-field with the index row it names. Cheap enough to
    27	    run in front of every store read verb.
    28	
    29	``audit_deep``  (``--deep``)
    30	    Streams every log line — bounded memory, never the whole 111MB-class log
    31	    at once — comparing fields *and* order against the index rows in rowid
    32	    order, then re-derives the tick hash chain FROM CANONICAL CONTENT rather
    33	    than from the index it is judging.
    34	
    35	SCOPE BOUNDARY, stated rather than implied: a *coordinated* edit of an
    36	unsealed fact in both artifacts is uncaught here, because nothing yet commits
    37	to that fact's content — the witnesses at the live edge are the fact's own
    38	signature and the next seal, not this audit. Pinned by
    39	``test_interior_tamper_of_an_unsealed_fact_is_caught_by_nothing``.
    40	"""
    41	
    42	from __future__ import annotations
   314	
   315	
   316	def audit_agreement(canonical: Path) -> AgreementReport:
   317	    """The default gate: do the log and its index still agree, cheaply?
   318	
   319	    Three checks, in the order a divergence is most likely to be explained by:
   320	
   321	    ``index``      the derived index exists and is a readable store
   322	    ``offset``     stamped byte offset == the log's size on disk
   323	    ``counts``     stamped fact/tick counts == ``COUNT(*)`` per table
   324	    ``last-line``  the last complete log line == the index row it names
   325	
   326	    Together they catch the two lie-shapes the index-only walk missed: an
   327	    out-of-band sqlite row (counts diverge) and a durable-but-unindexed log
   328	    line (offset diverges). Interior agreement is ``audit_deep``'s scope.
   329	    """
   330	    canonical = Path(canonical)
   331	    from .residence import index_path_for
   332	
   333	    checks: list[Check] = []
   334	    size = _log_size(canonical)
   383	def _suffix_unindexed(conn, canonical: Path, offset: int, size: int) -> bool:
   384	    """Does the log past ``offset`` START with a genuinely unindexed line?
   385	
   386	    The corroboration behind :attr:`Check.beyond_offset`, and no more than
   387	    that. The writer's crash window has one shape: the log holds durable bytes
   388	    the index has NOT consumed, so the first line past the stamped offset has
   389	    no row in the index. Reading that one line is O(1) and turns "the
   390	    suspect's own marker says so" into a claim the log supports — but it says
   391	    NOTHING about the rest of the suffix, which is why no caller may read a
   392	    True here as innocence. Corroborating every suffix line is
   393	    :func:`audit_deep`'s scope, by construction: it already streams them.
   394	
   395	    False (the marker is not merely behind) when the offset does not land on a
   396	    line boundary, when the first line does not decode, or when the index
   397	    already holds a row for it — the marker was rewound below rows the index
   398	    consumed, which no writer produces. True for a torn final line: those
   399	    bytes were never indexed, which is precisely the interrupted-append window.
   400	    """
   401	    if not 0 <= offset < size:
   402	        return False
   403	    if offset > 0:
   404	        with canonical.open("rb") as fh:
   405	            fh.seek(offset - 1)
   406	            if fh.read(1) != b"\n":
   407	                return False
   408	    with canonical.open("rb") as fh:
   409	        fh.seek(offset)
   410	        while True:
   411	            raw = fh.readline()
   412	            if not raw:
   413	                return False  # nothing but blank bytes past the offset
   414	            if not raw.endswith(b"\n"):
   415	                return True  # torn tail — never indexed, by construction
   416	            text = raw[:-1].decode("utf-8", "replace").strip()
   417	            if text:
   418	                break
   419	    try:
   420	        records = deserialize_records(text)
   421	    except (JsonlCodecError, UnicodeError):
   422	        return False  # garbage past the offset is not an innocence claim
   423	    # A batch line is judged by its first inner row — the writer's crash
   424	    # window leaves the WHOLE ceremony line unindexed, so one probe is the
   425	    # same O(1) corroboration a plain line gets.
   426	    t, row = records[0]
   427	    return not _index_has_row(conn, t, row[0])
   428	
   429	
   430	def _check_offset(conn, canonical: Path, offset: int | None, size: int) -> Check:
