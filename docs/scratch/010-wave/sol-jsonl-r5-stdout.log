    28	def workspace_store(vp: Path) -> Path:
    29	    """The canonical task store a read of *vp* must resolve, for this workspace.
    30	
    31	    The reader half of the split ``store.store_path`` documents for writers:
    32	    the declaration answers *what kind* of store (``.db`` → sqlite-canonical,
    33	    ``.jsonl`` → JSONL-canonical, per ``engine.residence``); the process cwd
    34	    answers *where*. Reads went through ``engine.vertex_*`` with the vertex
    35	    file alone, which resolves package-relative — so a worker wrote its
    36	    worktree's store and read the packaged one, and saw zero tasks. Passing
    37	    this as ``store=`` restores the same contract on both sides: one task
    38	    store per workspace.
    39	
    40	    Canonical, not the index: ``engine``'s readers resolve (and materialize)
    41	    the derived index for a ``.jsonl`` locator themselves.
    42	    """
    43	    from lang import parse_vertex_file
    44	
    45	    declared = Path(parse_vertex_file(vp).store or "data/tasks.db")
    46	    return declared if declared.is_absolute() else Path.cwd() / declared
