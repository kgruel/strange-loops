+import json
+
+from engine.admission import SourceRows, admit_records
+from engine.arrival import ArrivalLog, Entry
+from engine.arrival_contract import Head
+from tests.conftest import STUB_KEY, stub_sign
+
+
+def test_reviewer_owned_cache_retry(tmp_path):
+    rows = [
+        ("01MINEA", "note", 11.0, "kyle", "", json.dumps({"n": 1}), None),
+        ("01MINEB", "note", 12.0, "kyle", "", json.dumps({"n": 2}), None),
+    ]
+    source = SourceRows(
+        groups=[("fact", [("fact", row)], None) for row in rows],
+        fact_count=2,
+        tick_count=0,
+    )
+    log = ArrivalLog.mint(tmp_path / "review.arrival", observer="review", signer=stub_sign, key=STUB_KEY)
+    sentinel = ("fact", "note", 1.0, "kyle", "", "{}", None)
+    caller_cache = {"01SENTINEL": sentinel}
+    original_identity = id(caller_cache)
+    state_calls = 0
+    rederive_calls = 0
+
+    def target_state():
+        nonlocal state_calls
+        state_calls += 1
+        head = log.head()
+        pin = Head(lineage=head["lin"], ordinal=head["ord"], record_hash=head["rh"])
+        if state_calls == 1:
+            log.append_marked_many([
+                Entry(k="fact", body={"id": "01RACER", "k": "note", "at": 10.0, "p": "{}"}, observer="kyle", origin="", at=10.0)
+            ], following=None)
+        assert id(caller_cache) == original_identity
+        return caller_cache, pin
+
+    def rederive():
+        nonlocal rederive_calls
+        rederive_calls += 1
+
+    result = admit_records(log, source, target_state=target_state, rederive=rederive)
+    assert (result.facts_added, result.facts_skipped) == (2, 0)
+    assert state_calls == 2
+    assert rederive_calls == 1
+    assert caller_cache == {"01SENTINEL": sentinel}
+    ids = {r["body"]["id"] for r in log.walk() if r["k"] == "fact"}
+    assert {"01MINEA", "01MINEB"}.issubset(ids)

