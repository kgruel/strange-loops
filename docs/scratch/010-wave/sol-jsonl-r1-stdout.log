   532	
   533	def test_rebuild_drops_the_rowid_keyed_fts_index(tmp_path):
   534	    """DELETE FROM facts resets rowids, so facts_fts/fts_state must go.
   535	
   536	    Surviving FTS rows key on facts.rowid and would resolve stale text to
   537	    freshly re-indexed facts, while fts_state.last_rowid would keep the
   538	    incremental path from ever indexing them.
   539	    """
   540	    import sqlite3
   541	
   542	    store = open_store(tmp_path)
   543	    for i in range(3):
   544	        store.append(fact(message=f"m{i}"))
   545	    store.close()
   546	
   547	    db = tmp_path / "s.db"
   548	    conn = sqlite3.connect(str(db))
   549	    conn.executescript(
   550	        "CREATE VIRTUAL TABLE facts_fts USING fts5("
   551	        "  text_content, fact_rowid UNINDEXED, kind UNINDEXED,"
   552	        "  observer UNINDEXED);"
   553	        "CREATE TABLE fts_state (key TEXT PRIMARY KEY, value TEXT);"
   554	    )
   555	    conn.execute(
   556	        "INSERT INTO facts_fts(text_content, fact_rowid, kind, observer) "
   557	        "VALUES ('m1', 2, 'note', 'kyle')"
   558	    )
   559	    conn.execute("INSERT INTO fts_state(key, value) VALUES ('last_rowid', '3')")
   560	    conn.commit()
   561	    conn.close()
   562	
   563	    log = log_path_for(db)
   564	    kept = lines(log)[0]
   565	    log.write_text(kept + "\n", encoding="utf-8")  # shrink → forces a rebuild
   566	
   567	    reopened = open_store(tmp_path)
   568	    assert len(sqlite_facts(db)) == 1
   569	    reopened.close()
   570	
   571	    conn = sqlite3.connect(str(db))
   572	    try:
   573	        present = {
   574	            r[0]
   575	            for r in conn.execute(
   576	                "SELECT name FROM sqlite_master WHERE type IN ('table','view')"
   577	            )
   578	        }
   579	    finally:
   580	        conn.close()
   581	    assert "facts_fts" not in present
   582	    assert "fts_state" not in present

codex
The two stated S3 fixes are present in the intended seams: marker counts now come from committed metadata under SQLite’s write lock, and rebuild drops both rowid-keyed FTS tables. I’m now checking whether recovery behavior around those seams creates sibling failure modes—especially corrupt complete lines being mistaken for torn writes, and whether every application write truly uses the canonical locator.
