   544	def _ensure_index_schema(conn: sqlite3.Connection) -> None:
   545	    """Make the index connectable as an index, whatever era it is from.
   546	
   547	    Every statement is idempotent. The schema statements are the store
   548	    class's own — imported rather than restated, so a schema column and a
   549	    re-derived row can never drift apart — and the two column migrations
   550	    mirror the store's, so an index written before the chain columns or the
   551	    fact signature existed re-derives instead of failing on a missing
   552	    column.
   553	    """
   554	    for stmt in _SCHEMA_STMTS:
   555	        conn.execute(stmt)
   556	    conn.execute(
   557	        "CREATE TABLE IF NOT EXISTS store_meta (key TEXT PRIMARY KEY, value TEXT)"
   558	    )
   559	    fact_cols = {r[1] for r in conn.execute("PRAGMA table_info(facts)")}
   560	    if "signature" not in fact_cols:
   561	        conn.execute("ALTER TABLE facts ADD COLUMN signature TEXT")
   562	    tick_cols = {r[1] for r in conn.execute("PRAGMA table_info(ticks)")}
   563	    for col in ("prev_hash", "window_start", "fact_cursor", "window_hash", "signature"):
   564	        if col not in tick_cols:
   565	            conn.execute(f"ALTER TABLE ticks ADD COLUMN {col} TEXT")
   566	    conn.commit()
