   362	    else:
   363	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   364	
   365	    payload = tick.get("payload", {}) if isinstance(tick.get("payload"), dict) else {}
   366	    origin = tick.get("origin", "")
   367	
   368	    if zoom == Zoom.FULL:
