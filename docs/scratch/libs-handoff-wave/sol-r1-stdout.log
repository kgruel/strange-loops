    53	@dataclass(frozen=True)
    54	class FactAttestation:
    55	    """Persisted signature state of the COMMITTED fact row.
    56	
    57	    Populated by reading the row the store actually committed (never from
    58	    "keys exist locally" inference — a per-observer signer that returns
    59	    ``None`` yields ``signed=False`` even when signing is configured;
    60	    write-receipt-vs-temporal-query, LIBS_CHANGES P1).
    61	
    62	    - ``signed`` — the committed row carries an authorship signature.
    63	    - ``observer`` — the observer the row was committed under (the
    64	      authorship claim's subject).
    65	    - ``signature_present`` — the row-level flag; at write time this
    66	      coincides with ``signed`` (both read off the same committed column),
    67	      kept distinct so the shape can carry verification-grade claims
    68	      without renaming.
    69	    """
    70	
    71	    signed: bool
    72	    observer: str
    73	    signature_present: bool
    74	
