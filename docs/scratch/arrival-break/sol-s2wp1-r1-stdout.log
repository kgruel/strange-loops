    90	    # retired model coming back. Unambiguous and single-concept, so it
    91	    # mechanizes exactly the way `receipt_order` already does.
    92	    "fold_order": "the ordering claim is the arrival ordinal, not a fold order",
    93	    "receipt_mode": "there is no mode — custody is structural, not configured",
    94	    "reanchor": "not an operation in the arrival model",
    95	    "rewind": "not an operation in the arrival model",
    96	    "mergeability": "not a property of custody",
    97	    "union_discipline": "not a property of custody",
