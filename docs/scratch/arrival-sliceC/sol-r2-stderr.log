    66	def _rowid_ids_by_direct_sqlite(db_path: Path) -> list[str]:
    67	    """The OLD single-store semantics, read straight off sqlite.
    68	
    69	    Independent of production code: the pin compares against this, not against
    70	    anything the new path computes.
    71	    """
    72	    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    73	    try:
    74	        rows = conn.execute("SELECT id, rowid FROM facts").fetchall()
    75	    finally:
    76	        conn.close()
    77	    rows.sort(key=lambda r: r[1])
    78	    return [r[0] for r in rows]
