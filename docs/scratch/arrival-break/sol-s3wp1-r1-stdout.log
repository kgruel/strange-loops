   897	
   898	# ---------------------------------------------------------------------------
   899	# Writing the journal
   900	# ---------------------------------------------------------------------------
   901	
   902	
   903	def _torn_tail_guard(path: Path) -> str:
   904	    """A newline when the file does not end in one, so an append cannot glue.
   905	
   906	    A crash mid-append leaves a fragment with no trailing newline. Appending
   907	    straight onto it would concatenate the next entry into that fragment,
   908	    producing ONE unreadable line — and the new entry's bytes would be lost
   909	    inside it. The design's promise is that a torn tail costs at most the
   910	    newest observation; without this guard an ordinary crash plus one commit
   911	    would cost the next observation too.
   912	
   913	    Conservative when it cannot tell: an unreadable file gets the newline. A
   914	    spurious blank line is skipped for free on read, while gluing is not
   915	    recoverable at all.
   916	    """
   917	    try:
   918	        with path.open("rb") as handle:
   919	            if handle.seek(0, os.SEEK_END) == 0:
   920	                return ""
   921	            handle.seek(-1, os.SEEK_END)
   922	            return "" if handle.read(1) == b"\n" else "\n"
   923	    except OSError:
   924	        return "\n"
   925	
   926	
   927	def _write_all(handle: int, payload: bytes) -> None:
   928	    """Write every byte, or raise. A short write is a self-inflicted torn line."""
   929	    written = 0
   930	    while written < len(payload):
   931	        count = os.write(handle, payload[written:])
   932	        if count <= 0:
   933	            raise OSError(
   934	                f"journal write stalled after {written} of {len(payload)} bytes"
   935	            )
   936	        written += count
   937	
   938	
   939	def append_entry(entry: HeadAttestation) -> Path:
   940	    """Append one observation. Returns the journal it landed in.
   941	
   942	    Append-only, so there is no read-modify-write, no torn partial update and
   943	    no lock. Retaining every previously accepted head is also what makes an
   944	    under-evidenced advance *recoverable* rather than a loss: *K* stays in the
   945	    journal forever, so the periodic audit can re-examine everything accepted
   946	    since the last reset. A single overwritten value could not offer that at
   947	    any price, because it would have forgotten *K* — and it could not hold the
   948	    bootstrap receipt either, since the first advance would erase it.
   949	
   950	    A brand-new journal gets its header and its first entry in one write. The
   951	    exclusive create keeps two racing writers from each emitting a header; the
   952	    reader tolerates a second one anyway, because a create race is cheaper to
   953	    survive than to prevent.
   954	
   955	    **Every open carries O_APPEND, including the exclusive create.** Without it
   956	    the creating writer's descriptor sits at offset zero, and a second writer
   957	    that lost the create race can land a complete entry there first — which the
   958	    creator then overwrites. The journal would have silently forgotten a head,
   959	    and a later restore to the surviving ordinal would classify UNCHANGED: the
   960	    exact failure the maximum-ordinal read rule exists to close, arriving
   961	    through the write path instead.
   962	    """
   963	    path = journal_path(entry.head.lineage)
   964	    path.parent.mkdir(parents=True, exist_ok=True)
   965	    line = _entry_line(entry)
   966	    try:
   967	        handle = os.open(
   968	            path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_APPEND, 0o600
   969	        )
   970	    except FileExistsError:
   971	        # An empty existing file is a creator that crashed between the
   972	        # exclusive create and its write. Supplying the header here is what
   973	        # keeps that crash from leaving a headerless journal, which the reader
   974	        # refuses as structural damage.
   975	        payload = _torn_tail_guard(path) + line
   976	        if path.exists() and path.stat().st_size == 0:
   977	            payload = _header_line() + line
   978	        handle = os.open(path, os.O_WRONLY | os.O_APPEND)
   979	    else:
   980	        payload = _header_line() + line
   981	    try:
   982	        _write_all(handle, payload.encode("utf-8"))
   983	    finally:
   984	        os.close(handle)
   985	    return path
   986	
   987	
   988	# ---------------------------------------------------------------------------
   989	# The audit's all-journaled-heads check (§C.4)
   990	# ---------------------------------------------------------------------------
   991	
   992	
   993	def unaccounted_heads(
   994	    epoch: Iterable[HeadAttestation],
   995	    at_ordinal: Callable[[int], Head | None],
   996	) -> tuple[HeadAttestation, ...]:
   997	    """Journaled heads the store can no longer account for.
   998	
   999	    The periodic audit does not merely re-verify the current chain — it checks
  1000	    that every head journaled **in the current trust epoch** is still present
  1001	    at its own ordinal with its own hash. That single walk is what makes the
  1002	    cheap per-open check safe: an advance accepted today on partial evidence
  1003	    is re-examined against the complete record of everything accepted since
  1004	    the last reset.
  1005	
  1006	    The epoch scope is not a convenience. A legitimately accepted restore
  1007	    leaves heads in the journal that the restored store does not and cannot
  1008	    contain; auditing against those would fail permanently and train an
  1009	    operator to ignore the audit, which is worse than not running one.
  1010	
  1011	    ``at_ordinal`` is injected rather than imported so this module never
  1012	    reaches for a backend or a projection auditor. The audit producer that
  1013	    supplies it is WP3's.
  1014	    """
  1015	    return tuple(
  1016	        entry for entry in epoch if at_ordinal(entry.head.ordinal) != entry.head
  1017	    )
