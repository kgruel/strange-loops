   166	def tick_line(tick: dict) -> "Block":
   167	    """Render a single tick dict as a styled Block.
   168	
   169	    Default: `  HH:MM ⚡ task-name status` with status colored by outcome.
   170	    The ⚡ and status color distinguish ticks from regular fact lines.
   171	    Accepts a tick dict (from tick_to_dict or fetch functions).
   172	    """
   173	    from painted.core.block import Block
   174	    from painted.core.compose import join_horizontal
   175	    from painted.palette import current_palette
   176	
   177	    p = current_palette()
