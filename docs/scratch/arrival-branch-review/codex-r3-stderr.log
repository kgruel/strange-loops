    99	def _spec() -> Spec:
   100	    """Upsert by topic — last write wins, so the fold is order-SENSITIVE."""
   101	    return Spec(
   102	        name="decision",
   103	        state_fields=(Field(name="items", kind="dict"),),
   104	        folds=(Upsert(target="items", key="topic"),),
   105	    )
   106	
   107	
   108	def _payloads(records: list[dict[str, Any]]) -> list[dict[str, Any]]:
   109	    return [{"topic": "t", "position": r["id"], "_ts": r["ts"], "_id": r["id"]} for r in records]
   110	
   111	
   112	def test_replay_from_suffix_replay_is_sound_under_arrival_only() -> None:
   113	    """`Spec.replay_from` onto a held state — the checkpoint's mechanism.
   114	
   115	    Under Arrival it reproduces the cold replay exactly. Under ByKey('ts') the
   116	    same suffix replay disagrees, because the backdated record belonged BEFORE
   117	    the records already folded into the checkpoint.
   118	    """
   119	    spec = _spec()
   120	    all_records = [*_RECORDS, _LATE_ARRIVAL]
   121	
   122	    for ordering, sound in ((Arrival(), True), (ByKey("ts"), False)):
   123	        prefix = totalize(_RECORDS, ordering)
   124	        checkpoint = spec.replay(_payloads(prefix))
   125	        warm = spec.replay_from(checkpoint, _payloads([_LATE_ARRIVAL]))
   126	        cold = spec.replay(_payloads(totalize(all_records, ordering)))
   127	
   128	        assert (warm == cold) is sound, (
   129	            f"suffix replay under {ordering!r}: expected agreement={sound}"
   130	        )
   131	        assert is_suffix_stable(ordering) is sound
   132	
