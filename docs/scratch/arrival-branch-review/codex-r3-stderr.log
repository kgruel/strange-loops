  1481	            raise AppendRejected(
  1482	                f"candidate claims lineage {record['lin']!r}, "
  1483	                f"but this log's lineage is {head['lin']!r}"
  1484	            )
  1485	        if record["ord"] != head["ord"] + 1:
  1486	            raise AppendRejected(
  1487	                f"candidate carries ord {record['ord']!r}, "
  1488	                f"but the head is at {head['ord']} so {head['ord'] + 1} is due"
  1489	            )
  1490	        if record["prev"] != head[_RH]:
  1491	            raise AppendRejected(
  1492	                f"candidate's prev names {record['prev']!r}, "
  1493	                f"but the head's rh is {head[_RH]!r}"
  1494	            )
  1495	        fault = _placement_fault(record, record["ord"])
  1496	        if fault is not None:
  1497	            raise AppendRejected(f"candidate refused: {fault}")
  1498	
  1499	    def _truncate_torn_tail(self) -> int:
  1500	        """Drop an unterminated final record. Returns the bytes cut.
  1501	
  1502	        MUST be called with the append lock held — see
  1503	        :meth:`_append_under_lock`. Truncation, not skipping: partial bytes
  1504	        left at the tail would be concatenated onto by the next append, and
  1505	        the result would be a corrupt interior that refuses forever.
  1506	        """
  1507	        size = self.size()
  1508	        if size == 0:
  1509	            return 0
  1510	        with self.path.open("rb") as fh:
  1511	            fh.seek(size - 1)
  1512	            if fh.read(1) == b"\n":
  1513	                return 0
  1514	            cut = _last_newline_before(fh, size)
  1515	        # cut is 0 when the whole file is one partial record.
  1516	        with self.path.open("r+b") as fh:
  1517	            fh.truncate(cut)
  1518	            fh.flush()
  1519	            os.fsync(fh.fileno())
  1520	        return size - cut
  1521	
  1522	    def truncate_torn_tail(self) -> int:
  1523	        """Take the lock and drop an unterminated final record.
  1524	
  1525	        The public spelling, for an opener that wants the log made
  1526	        appendable without appending. Same rule: only the tail, only what
  1527	        was never complete, only under the lock.
  1528	        """
  1529	        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
  1530	        with self.lock_path.open("ab") as lock_fh:
  1531	            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
  1532	            return self._truncate_torn_tail()
  1533	
