    20	@dataclass(frozen=True)
    21	class FactPage:
    22	    """One bounded page of a generic fact query (:meth:`StoreReader.query_facts`).
    23	
    24	    ``next`` is a 0.8.0 :class:`~engine.witness.WitnessPosition` — the SAME
    25	    cursor type every other temporal seam uses, not a second cursor species.
    26	    It marks the LAST item of this page on the witness (append/rowid) axis;
    27	    hand it back as ``before`` (order ``"newest"``) or ``after`` (order
    28	    ``"oldest"``) to fetch the next page. ``None`` means the walk is complete
    29	    (equivalently: ``truncated`` is False).
    30	
    31	    ``truncated`` is True when more matching rows existed beyond ``limit`` in
    32	    the SAME read snapshot the items came from.
    33	    """
    34	
    35	    items: list[dict]
    36	    next: "WitnessPosition | None"
    37	    truncated: bool
    38	    #: The order the page was walked in — echoed so a consumer holding only
    39	    #: the page knows which parameter ``next`` feeds.
    40	    order: str
