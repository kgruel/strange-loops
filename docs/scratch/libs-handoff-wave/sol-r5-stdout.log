   281	def _parse_vertex_or_raise(text: str, context: str):
   282	    """Parse vertex text, wrapping parser errors as a clear ValueError."""
   283	    from .loader import parse_vertex
   284	
   285	    try:
   286	        return parse_vertex(text)
   287	    except Exception as exc:
   288	        raise ValueError(
   289	            f"{context}: input is not a parseable vertex: {exc}"
   290	        ) from exc
