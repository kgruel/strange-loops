   518	def _merge_probe(tmpdir: Path, depth: int) -> Sample:
   519	    """`merge_derived_log` of two branches, `depth` shared + depth/2 unique each.
   520	
   521	    The driver reads three line files, unions by row id, refuses on
   522	    contradiction, and writes byte-sorted output — expect linear in total
   523	    lines. A superlinear curve here blocks ship: the driver runs inside real
   524	    `git merge` invocations.
   525	
   526	    `out=` keeps the pristine fixtures pristine, so every sample merges the
   527	    same inputs instead of an already-merged accumulation.
   528	    """
   529	    from engine.arrival import ArrivalLog
   530	    from engine.arrival_projection import write_derived_log
   531	    from store.derived_log_merge import merge_derived_log
   532	
   533	    def _row(ident: str, index: int) -> dict:
   534	        return {
   535	            "t": "fact",
   536	            "id": ident,
   537	            "kind": "note",
   538	            "ts": 1_700_000_000.0 + index,
   539	            "observer": "ledger",
   540	            "origin": "ledger",
   541	            "payload": json.dumps({"index": index}),
   542	        }
   543	
   544	    def _log_with(path: Path, ids: list[tuple[str, int]]) -> Path:
   545	        log = ArrivalLog.mint(
   546	            path, observer="ledger", signer=_stub_sign, key=_stub_key()
   547	        )
   548	        for ident, index in ids:
   549	            log.append("fact", _row(ident, index), observer="ledger")
   550	        write_derived_log(path)
   551	        return path.with_suffix(".jsonl")
   552	
   553	    def _ident(tag: str, i: int) -> str:
   554	        return f"01{tag}{i:023d}"[:26]
   555	
   556	    half = max(1, depth // 2)
   557	    shared = [(_ident("S", i), i) for i in range(depth)]
   558	    ours_only = [(_ident("A", i), depth + i) for i in range(half)]
   559	    theirs_only = [(_ident("B", i), depth + half + i) for i in range(half)]
   560	
   561	    base = _log_with(tmpdir / "base.arrival", shared)
   562	    ours = _log_with(tmpdir / "ours.arrival", shared + ours_only)
   563	    theirs = _log_with(tmpdir / "theirs.arrival", shared + theirs_only)
   564	    out = tmpdir / "merged.jsonl"
   565	    expected = depth + 2 * half
   566	
   567	    def one_merge() -> None:
   568	        result = merge_derived_log(base, ours, theirs, out=out)
   569	        if result.lines != expected:
   570	            raise ProbeError(f"merge produced {result.lines} lines, expected {expected}")
   571	
   572	    return measure("arrival_merge_regen", "arrival", depth, one_merge)
   573	
