   172	def row_matches(conn, t: str, row: tuple) -> bool:
   173	    """Does the index row named by this log row carry the same VALUES?
   174	
   175	    Value equality, never re-serialized text: sqlite's REAL affinity returns
   176	    ``1700000000.0`` for a line carrying ``1700000000``, so a byte comparison
   177	    would call every integral ``ts`` corrupt. Python's cross-type numeric
   178	    equality normalizes that uniformly.
   179	
   180	    Extracted from ``JsonlStore._row_matches`` — which now delegates here —
   181	    so open-time reconciliation and out-of-band verification cannot drift
   182	    into two different definitions of "the same row".
   183	    """
