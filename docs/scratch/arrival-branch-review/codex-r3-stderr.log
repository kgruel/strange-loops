    69	# 2. Why: an append extends Arrival, but INSERTS into ByKey
    70	
    71	
    72	_RECORDS: list[dict[str, Any]] = [
    73	    {"id": "r1", "ts": 300.0},
    74	    {"id": "r2", "ts": 400.0},
    75	]
    76	#: Backdated: arrives last, but its key puts it FIRST under ByKey("ts").
    77	_LATE_ARRIVAL: dict[str, Any] = {"id": "r3", "ts": 100.0}
    78	
    79	
    80	def test_append_extends_the_arrival_projection_at_its_end() -> None:
    81	    prefix = totalize(_RECORDS, Arrival())
    82	    extended = totalize([*_RECORDS, _LATE_ARRIVAL], Arrival())
    83	
    84	    assert extended[: len(prefix)] == prefix, "arrival prefix moved"
    85	    assert extended[len(prefix) :] == [_LATE_ARRIVAL]
    86	    assert is_suffix_stable(Arrival()), "observed suffix-stable; predicate must agree"
    87	
    88	
    89	def test_append_inserts_into_the_middle_of_a_by_key_projection() -> None:
    90	    ordering = ByKey("ts")
    91	    prefix = totalize(_RECORDS, ordering)
    92	    extended = totalize([*_RECORDS, _LATE_ARRIVAL], ordering)
    93	
    94	    assert extended[0] == _LATE_ARRIVAL, "backdated record should sort first"
    95	    assert extended[: len(prefix)] != prefix, "the held prefix is no longer a prefix"
    96	    assert not is_suffix_stable(ordering), "observed NOT suffix-stable; predicate must agree"
