     1	"""Migration sidecar refusals and exception hierarchy.
     2	
     3	All refusals in the migration sidecar root in :class:`MigrationRefused`.
     4	This hierarchy is strictly distinct from ``ArrivalBodyError`` and
     5	``ContractRefusal``:
     6	- It represents sidecar-specific assertions about legacy source contents
     7	  prior to target admission, or sink/publish preconditions.
     8	- Exception types make location claims about what the source carries or lacks,
     9	  and do not encode or promise remedies in their types or docstrings.
    10	- Advisory prose naming operator options is carried in the exception message.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	
    16	
    17	__all__ = [
    18	    "MigrationRefused",
    19	    "LegacySourceRefused",
    20	    "BatchRegroupRefused",
    21	    "DeclarationKeyRefused",
    22	    "MissingCustodianKeyRefused",
    23	    "JournalPreflightRefused",
    24	    "TargetMismatchOnResumeRefused",
    25	    "TargetUnopenable",
    26	    "TornTailRefused",
    27	    "PublishPreconditionRefused",
    28	    "SourceChangedRefused",
    29	    "LegacyStorageRefused",
    30	    "ReportVerificationRefused",
    31	    "ReportMalformedRefused",
    32	    "ReportBadSignatureRefused",
    33	    "ReportMissingTargetRefused",
    34	    "ReportHeadMismatchRefused",
    35	    "ReportTargetUnopenableRefused",
    36	]
    37	
    38	
    39	def _format_refusal_message(
    40	    *,
    41	    source: str | None,
    42	    codec_invalid_lines: tuple[tuple[int, str], ...],
    43	    mixed_observer_lines: tuple[tuple[int, tuple[str, ...], int], ...],
    44	    absent_observer_lines: tuple[tuple[int, int, tuple[str, ...], dict[str, int]], ...],
    45	) -> str:
    46	    source_prefix = f"for source {source!r} " if source else ""
    47	    sections: list[str] = []
    48	
    49	    if codec_invalid_lines:
    50	        enum_codec = "\n".join(
    51	            f"  line {lineno}: {msg}"
    52	            for lineno, msg in codec_invalid_lines
    53	        )
    54	        sections.append(
    55	            "The following source line(s) failed codec validation:\n"
    56	            f"{enum_codec}"
    57	        )
    58	
    59	    if mixed_observer_lines:
    60	        enum_mixed = "\n".join(
    61	            f"  line {lineno}: observers {', '.join(repr(o) for o in observers)}"
    62	            + (f" ({absent_count} row(s) missing 'observer' field)" if absent_count > 0 else "")
    63	            for lineno, observers, absent_count in mixed_observer_lines
    64	        )
    65	        sections.append(
    66	            "The following source line(s) carry batch rows spanning more than one observer "
    67	            "(GF-3 violation), which cannot map to a single Arrival record:\n"
    68	            f"{enum_mixed}"
    69	        )
    70	
    71	    if absent_observer_lines:
    72	        formatted_absent: list[str] = []
    73	        for lineno, absent_count, observers, spelling_map in absent_observer_lines:
    74	            empty_cnt = spelling_map.get("empty", 0)
    75	            missing_cnt = spelling_map.get("missing", 0)
    76	
    77	            if empty_cnt > 0 and missing_cnt == 0:
    78	                desc = f"{absent_count} row(s) with observer='' (empty string)"
    79	            elif missing_cnt > 0 and empty_cnt == 0:
    80	                desc = f"{absent_count} row(s) missing 'observer' field"
    81	            elif empty_cnt > 0 and missing_cnt > 0:
    82	                desc = f"{absent_count} row(s) with absent/empty observer ({missing_cnt} missing, {empty_cnt} empty '')"
    83	            else:
    84	                desc = f"{absent_count} row(s) missing 'observer' field"
    85	
    86	            rem = f" (remaining observers: {', '.join(repr(o) for o in observers)})" if observers else ""
    87	            formatted_absent.append(f"  line {lineno}: {desc}{rem}")
    88	
    89	        enum_absent = "\n".join(formatted_absent)
    90	        sections.append(
    91	            "The following source line(s) carry batch rows missing the required 'observer' field:\n"
    92	            f"{enum_absent}"
    93	        )
    94	
    95	    body = "\n\n".join(sections)
    96	    return (
    97	        f"Migration refused {source_prefix}(legacy source defects found).\n"
    98	        f"{body}\n"
    99	        "Advisory: repair the source line(s) by hand or re-run migration after a ruled re-ceremony."
   100	    )
