    67	def ordering_to_wire(ordering: Ordering) -> dict[str, Any]:
    68	    """Serialize an Ordering for the vector wire schema."""
    69	    if isinstance(ordering, ByKey):
    70	        return {"by_key": ordering.field}
    71	    raise ValueError(f"lens vectors declare ByKey orderings only, got {ordering!r}")
