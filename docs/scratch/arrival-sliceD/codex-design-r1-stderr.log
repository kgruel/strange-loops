   789	            return None
   790	        # _tick_row_hash reads an 11-field row (signature at [10]); a delta-1
   320	        an absent index is: absent→present destroys nothing.
   321	
   322	        A PRESENT marker is never touched, so this path can never overwrite
   323	        an identity claim. Judging a present, disagreeing marker is
   324	        :func:`engine.arrival_projection.rederive_projections`'s, where the
   325	        stamp would be destructive.
   326	
   327	        Returns whether it staged a write, so the caller knows whether a
   328	        commit is owed on the otherwise-no-op path.
   329	        """
   330	        if self._meta_get("own_lineage") is not None:
   331	            return False
   332	        try:
   333	            lineage = self._log.lineage()
   334	        except GenesisRefused:
   335	            return False
   336	        own = licensed_own_lineage(self._db, lineage)
   337	        if own is None:
   338	            return False
   339	        self._meta_set("own_lineage", own)
   340	        return True
