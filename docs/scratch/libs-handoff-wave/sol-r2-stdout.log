   339	def edit_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   340	    """Replace an existing kind's definition in place; returns the new text.
   341	
   342	    Preserves the kind's position and all surrounding content. Not
   343	    supported when the whole ``loops`` block is a single line (the
   344	    documented expand-on-insert limitation is one-way).
   345	    """
   346	    _validate_kind_name(kind)
   347	    _reject_shared_line(text, kind, "edit")
   348	    try:
   349	        start, end = kdl_find_block(text, ["loops", kind])
   350	    except ValueError as exc:
   351	        raise ValueError(
   352	            f"kind {kind!r} not found in loops block (single-line loops "
   353	            "blocks cannot be edited in place — expand across lines first): "
   354	            f"{exc}"
   355	        ) from exc
   356	
   357	    lines = text.splitlines()
   358	    kind_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   359	    child = loop_def_to_kdl(kind, definition)
   360	    new_lines = [
   361	        (kind_indent + ln) if ln.strip() else ln for ln in child.splitlines()
   362	    ]
   363	    lines[start : end + 1] = new_lines
   364	    result = "\n".join(lines)
   365	    if text.endswith("\n"):
   366	        result += "\n"
   367	    return _validated(result, f"edit_vertex_kind({kind!r})")
