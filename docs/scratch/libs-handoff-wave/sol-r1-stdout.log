   221	class Vertex:
   222	    """Where loops meet.
   223	
   224	    Register folds by kind. Receive facts routed by kind. Fire a
   225	    temporal boundary to produce a Tick snapshot of all fold states.
   226	
   227	    Optionally backed by a Store — if provided, every received fact
   228	    is appended to the store before routing.
   229	
   230	    Grant-aware: receive() takes a Fact (with observer) and optional Grant.
   231	    The Vertex gates facts against the grant's potential (if provided) and
   232	    enforces observer-state kind ownership based on fact.observer.
   233	
   234	    Nesting: a Vertex can contain child vertices. After local routing,
   235	    facts are forwarded to children that accept the kind. Child ticks
   236	    become facts that re-enter the parent.
   237	    """
   238	
   239	    def __init__(
   240	        self, name: str = "", *, store: Store | None = None,
   241	        strict: bool = False,
   242	    ) -> None:
   243	        self._name = name
   244	        # Declared strict admission: when True, receive() refuses undeclared
   245	        # kinds with a typed UndeclaredKind BEFORE storage (bypass only via
   246	        # the explicit admit_undeclared parameter). See
   247	        # decision:design/strict-enforcement-at-engine-receive.
   248	        self._strict = strict
   249	        self._loops: dict[str, Loop] = {}
   250	        self._boundary_map: dict[str, str] = {}  # boundary_kind → fold_kind
   251	        self._has_loop_boundaries = False
   252	        self._boundary_match: dict[str, tuple[tuple[str, str], ...]] = {}  # boundary_kind → match
   253	        self._boundary_conditions: dict[str, tuple] = {}  # boundary_kind → conditions
   254	        # Vertex-level boundaries — a vertex may declare several, each firing
   255	        # the whole vertex. Evaluated in declaration order (first match fires).
   256	        self._vertex_boundaries: list[_VertexBoundarySpec] = []
   257	        self._vertex_boundary_kinds: set[str] = set()  # fast accepts() membership
   258	        self._vertex_period_start: datetime | None = None
   259	        self._store = store
   260	        self._replaying = False  # suppress boundaries during replay
   261	        self._has_children = False
   262	        self._children: list[Vertex] = []
   263	        self._routes: dict[str, str] = {}  # pattern → loop_name
   264	        self._has_routes = False
   265	        self._route_cache: dict[str, str | None] = {}
   266	        self._accepts_cache: dict[str, bool] = {}
   267	        self._parse_pipelines: dict[str, list] = {}  # kind → compiled ParseOp list
   268	
   269	    @property
   270	    def name(self) -> str:
   271	        """Vertex name — stamped as origin on produced Ticks."""
   272	        return self._name
   273	
   274	    @property
   275	    def _has_vertex_boundary(self) -> bool:
   276	        """True when the vertex declares at least one vertex-level boundary."""
   277	        return bool(self._vertex_boundaries)
   278	
   279	    def _match_vertex_boundary(
   280	        self, kind: str, payload: Any,
   281	    ) -> _VertexBoundarySpec | None:
   282	        """First vertex-level boundary spec this fact satisfies, or None.
   283	
   284	        Declaration order is authoritative: a fact that satisfies more than one
   285	        boundary fires the first-declared match only (one fact → one tick).
   286	        Payload match and fold-state conditions are both checked.
   287	        """
   288	        for spec in self._vertex_boundaries:
   289	            if spec.kind != kind:
   290	                continue
   291	            if spec.match and not all(
   292	                payload.get(k) == v for k, v in spec.match
   293	            ):
   294	                continue
   295	            if spec.conditions:
   296	                cond_loop = self._loops.get(self._routed_kind(kind))
   297	                if cond_loop is None or not _eval_conditions(
   298	                    cond_loop.state, spec.conditions
   299	                ):
   300	                    continue
   301	            return spec
   302	        return None
   303	
   304	    @property
   305	    def children(self) -> list[Vertex]:
   306	        """Child vertices, in registration order."""
   307	        return list(self._children)
   308	
   309	    def add_child(self, child: Vertex) -> None:
   310	        """Add a child vertex.
   311	
   312	        Facts received by this vertex will be forwarded to children that
   313	        accept the kind. Ticks produced by children become facts that
   314	        re-enter this vertex.
   315	        """
   316	        self._children.append(child)
   317	        self._has_children = True
   318	        self._accepts_cache.clear()
   319	
   320	    def set_routes(self, routes: dict[str, str]) -> None:
   321	        """Set pattern-based routing rules.
   322	
   323	        Routes map glob patterns to loop names. When a fact arrives,
   324	        patterns are checked in order and the first match determines
   325	        which loop receives the fact.
   326	
   327	        Pattern syntax (fnmatch):
   328	        - * matches any sequence of characters
   329	        - ? matches any single character
   330	        - [seq] matches any character in seq
   331	
   332	        Examples:
   333	            {"disk.*": "disk"}      # disk.usage, disk.io → disk loop
   334	            {"proc.*": "proc"}      # proc.cpu, proc.mem → proc loop
   335	            {"disk": "disk"}        # exact match (no wildcards)
   336	
   337	        Args:
   338	            routes: Dict mapping glob patterns to loop names
   339	        """
   340	        self._routes = routes.copy()
   341	        self._has_routes = bool(self._routes)
   342	        self._route_cache.clear()
   343	        self._accepts_cache.clear()
   344	
   345	    def set_parse_pipelines(self, pipelines: dict[str, list]) -> None:
   346	        """Set per-kind parse pipelines.
   347	
   348	        Parse pipelines transform fact payloads before routing to folds.
   349	        Derived fields are added alongside originals.
   350	
   351	        Args:
   352	            pipelines: Dict mapping kind name to list of compiled ParseOps
   353	        """
   354	        self._parse_pipelines = pipelines.copy()
