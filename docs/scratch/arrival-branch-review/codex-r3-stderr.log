   166	
   167	def _tick_commitment_hash(row: tuple) -> str:
   168	    """Hash the commitment fields — what the signer signs.
   169	
   170	    Never includes the signature (sign-the-content; a signature cannot
   171	    sign itself).
   172	    """
   173	    return hashlib.sha256(_canonical_bytes(_tick_envelope(row))).hexdigest()
