    12	def _bucket_timestamps(timestamps: list[float], width: int) -> list[float]:
    13	    """Bucket timestamps into equal-width time bins, return counts per bin.
    14	
    15	    *timestamps* should be sorted newest-first (as returned by
    16	    ``StoreReader.tick_timestamps``).  Returns *width* floats — one
    17	    count per bin, ordered oldest→newest so the visual reads left-to-right.
    18	    """
    19	    if not timestamps or width <= 0:
    20	        return []
    21	    lo, hi = min(timestamps), max(timestamps)
    22	    if lo == hi:
    23	        # All ticks at same instant — single spike in the middle
    24	        buckets = [0.0] * width
    25	        buckets[width // 2] = float(len(timestamps))
    26	        return buckets
    27	    span = hi - lo
    28	    buckets = [0.0] * width
    29	    for ts in timestamps:
    30	        idx = int((ts - lo) / span * (width - 1))
    31	        idx = max(0, min(idx, width - 1))
    32	        buckets[idx] += 1.0
    33	    return buckets
