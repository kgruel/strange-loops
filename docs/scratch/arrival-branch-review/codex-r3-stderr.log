   253	
   254	def _fact_commitment_hash(
   255	    kind: str, ts: float, observer: str, origin: str, payload_text: str
   256	) -> str:
   257	    """Hash the fact's CONTENT commitment — what the fact signer signs.
   258	
   259	    Content-only by design (design/fact-signature-at-store-column):
   260	    excludes id and rowid, which are custody context, not authored
   261	    content. This is what makes the signature transport-stable — any
   262	    store holding the row can re-derive the commitment and verify
   263	    authorship against the observer registry without trusting the
   264	    sender. Stored payload TEXT is embedded verbatim (same posture as
   265	    the tick envelope: byte-level tamper detection, no re-serialization).
   266	    Never includes the signature (a signature cannot sign itself).
   267	    """
   268	    envelope = {
   269	        "kind": kind, "ts": ts, "observer": observer,
   270	        "origin": origin, "payload": payload_text,
   271	    }
   272	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
