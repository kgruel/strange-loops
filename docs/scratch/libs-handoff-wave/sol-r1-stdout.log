   651	    def _last_newline_before(self, fh, end: int) -> int:
   652	        """Byte offset just past the last ``\\n`` strictly before ``end``.
   653	
   654	        Scans backwards in chunks — never loads the whole log, and never
   655	        gives up as a function of line length (a single 70KB payload must
   656	        not silently disable the integrity check). 0 when there is none.
