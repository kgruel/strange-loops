  1522	    def truncate_torn_tail(self) -> int:
  1523	        """Take the lock and drop an unterminated final record.
  1524	
  1525	        The public spelling, for an opener that wants the log made
  1526	        appendable without appending. Same rule: only the tail, only what
  1527	        was never complete, only under the lock.
  1528	        """
  1529	        self.lock_path.parent.mkdir(parents=True, exist_ok=True)
  1530	        with self.lock_path.open("ab") as lock_fh:
  1531	            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
  1532	            return self._truncate_torn_tail()
