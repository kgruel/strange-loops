from lang.document import DECL_VERTEX_DEFINED
from engine.jsonl_store import JsonlStore
from engine.sqlite_store import UnsignableGenesis, UnsignableEdit

mk=lambda p: JsonlStore(path=p, serialize=lambda f:f.to_dict(), deserialize=Fact.from_dict)
signer=lambda observer,digest:'sig-'+digest[:8]
with TemporaryDirectory() as td:
    root=Path(td)
    # genesis mismatch
    g=mk(root/'g.db')
    g._conn.execute('CREATE TRIGGER null_sig AFTER INSERT ON facts BEGIN UPDATE facts SET signature=NULL WHERE id=NEW.id; END')
    try: g.absorb_genesis([{'subject':'vertex','kind':DECL_VERTEX_DEFINED}], observer='kyle', fact_signer=signer)
    except Exception as e: print('genesis',type(e).__name__,(root/'g.jsonl').stat().st_size if (root/'g.jsonl').exists() else 0,g.total)
    g.close()
    # edit mismatch
    e=mk(root/'e.db')
    e.absorb_genesis([{'subject':'vertex','kind':DECL_VERTEX_DEFINED}], observer='kyle', fact_signer=signer)
    before=(root/'e.jsonl').read_bytes()
    e._conn.execute('CREATE TRIGGER null_sig AFTER INSERT ON facts BEGIN UPDATE facts SET signature=NULL WHERE id=NEW.id; END')
    change=SimpleNamespace(kind=DECL_VERTEX_DEFINED,subject='vertex',payload={'name':'t2'},annotation='modified')
    try: e.absorb_edit([change],observer='kyle',fact_signer=signer)
    except Exception as ex: print('edit',type(ex).__name__,(root/'e.jsonl').read_bytes()==before,e.total)
    e.close()
