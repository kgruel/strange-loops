   628	def _member_labels(paths: list[Path]) -> dict[Path, str]:
   629	    """Collision-free ``member`` labels for aggregate stores (review finding 3).
   630	
   631	    The stem is the friendly default, but ``a/events.db`` and ``b/events.db``
   632	    both stem to ``events`` — indistinguishable, so a consumer could resolve a
   633	    tick's ``fact_cursor`` against the WRONG member store. Colliding stems are
   634	    qualified with their parent directory name; if that still collides (same
   635	    leaf dir under different roots), the whole set falls back to full resolved
   636	    paths. Non-colliding stems stay short.
   637	    """
   638	    from collections import Counter
   639	
   640	    stem_counts = Counter(p.stem for p in paths)
   641	    labels: dict[Path, str] = {
   642	        p: (p.stem if stem_counts[p.stem] == 1 else f"{p.parent.name}/{p.stem}")
   643	        for p in paths
   644	    }
   645	    if len(set(labels.values())) < len(set(paths)):
   646	        labels = {p: str(p.resolve()) for p in paths}
   647	    return labels
   648	
