      "name": "config",
      "state_fields": [
        {
          "name": "values",
          "kind": "dict"
        },
        {
          "name": "updates",
          "kind": "list"
        }
      ],
      "folds": [
        {
          "op": "upsert",
          "target": "values",
          "key": "setting"
        },
        {
          "op": "collect",
          "target": "updates"
        }
      ]
    },
    "facts": [
