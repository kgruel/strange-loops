   101	def parse_duration(s: str) -> float:
   102	    """Parse duration string like '7d', '24h', '1h' to seconds."""
   103	    m = re.match(r"^(\d+)([dhms])$", s)
   104	    if not m:
   105	        raise ValueError(f"Invalid duration: {s!r} (expected e.g. '7d', '24h', '1h')")
   106	    value = int(m.group(1))
   107	    unit = m.group(2)
   108	    multipliers = {"d": 86400, "h": 3600, "m": 60, "s": 1}
   109	    return value * multipliers[unit]
