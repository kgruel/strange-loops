  1359	def test_a_degraded_open_writes_nothing(tmp_path):
  1360	    """The degradation never launders itself into a memory.
  1361	
  1362	    A written entry would raise the bound on evidence the read did not have,
  1363	    and would make a lost line look accounted for. Nothing is lost by not
  1364	    writing: ``skipped`` is derived from the journal's own bytes, so every
  1365	    later open re-derives the same degradation.
  1366	    """
  1367	    log_path = minted(tmp_path / "s.arrival")
  1368	    append_legacy(log_path, "one")
  1369	    opened(log_path)
  1370	    lineage = lineage_of(log_path)
  1371	    append_entry_for_damage(lineage)
  1372	    damage_a_line(lineage, "damage-me")
