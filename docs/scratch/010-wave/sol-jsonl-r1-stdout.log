   124	def test_crash_window_reopen_tails_forward_with_stable_receipt(tmp_path):
   125	    """The crash the flip exists to survive: the line is durable, the index
   126	    never got it. Reopening must recover the row with its id unchanged."""
   127	    store = open_store(tmp_path)
   128	    kept = store.append(fact(message="indexed"))
   129	
   130	    # Simulate: line flushed, process died before the sqlite transaction.
   131	    lost_row = ("01LOSTFACT", "note", 2.0, "kyle", "", json.dumps({"m": "lost"}))
   132	    from engine.jsonl_codec import serialize_fact_row
   133	
   134	    with (tmp_path / "s.jsonl").open("a", encoding="utf-8") as fh:
   135	        fh.write(serialize_fact_row(lost_row) + "\n")
   136	    store.close()
   137	
   138	    store = open_store(tmp_path)
   139	    assert store.catch_up() == "synced"  # the reopen already caught it up
   140	    ids = [r[0] for r in sqlite_facts(tmp_path / "s.db")]
   141	    assert ids == [kept, "01LOSTFACT"]
   142	    assert offset_of(store) == (tmp_path / "s.jsonl").stat().st_size
   143	    store.close()
