    55	def _format_refusal_message(
    56	    *,
    57	    source: str | None,
    58	    codec_invalid_lines: tuple[tuple[int, str], ...],
    59	    mixed_observer_lines: tuple[tuple[int, tuple[str, ...], dict[str, int]], ...],
    60	    absent_observer_lines: tuple[tuple[int, int, tuple[str, ...], dict[str, int]], ...],
    61	) -> str:
    62	    source_prefix = f"for source {source!r} " if source else ""
    63	    sections: list[str] = []
    64	
    65	    if codec_invalid_lines:
    66	        enum_codec = "\n".join(
    67	            f"  line {lineno}: {msg}"
    68	            for lineno, msg in codec_invalid_lines
    69	        )
    70	        sections.append(
    71	            "The following source line(s) failed codec validation:\n"
    72	            f"{enum_codec}"
    73	        )
    74	
    75	    if mixed_observer_lines:
    76	        formatted_mixed: list[str] = []
    77	        for lineno, observers, spelling_map in mixed_observer_lines:
    78	            obs_str = ", ".join(repr(o) for o in observers)
    79	            total_absent = sum(spelling_map.values())
    80	            if total_absent > 0:
    81	                desc = _format_absent_desc(spelling_map)
    82	                formatted_mixed.append(f"  line {lineno}: observers {obs_str} ({desc})")
    83	            else:
    84	                formatted_mixed.append(f"  line {lineno}: observers {obs_str}")
    85	        enum_mixed = "\n".join(formatted_mixed)
    86	        sections.append(
    87	            "The following source line(s) carry batch rows spanning more than one observer "
    88	            "(GF-3 violation), which cannot map to a single Arrival record:\n"
    89	            f"{enum_mixed}"
    90	        )
    91	
    92	    if absent_observer_lines:
    93	        formatted_absent: list[str] = []
    94	        for lineno, _absent_count, observers, spelling_map in absent_observer_lines:
    95	            desc = _format_absent_desc(spelling_map)
    96	            if observers:
    97	                rem = f" (remaining observers: {', '.join(repr(o) for o in observers)})"
    98	            else:
    99	                rem = ""
   100	            formatted_absent.append(f"  line {lineno}: {desc}{rem}")
   101	
   102	        enum_absent = "\n".join(formatted_absent)
   103	        sections.append(
   104	            "The following source line(s) carry batch rows missing the required 'observer' field:\n"
   105	            f"{enum_absent}"
   106	        )
   107	
   108	    body = "\n\n".join(sections)
   109	    return (
   110	        f"Migration refused {source_prefix}(legacy source defects found).\n"
   111	        f"{body}\n"
   112	        "Advisory: repair the source line(s) by hand or re-run migration after a ruled re-ceremony."
   113	    )
