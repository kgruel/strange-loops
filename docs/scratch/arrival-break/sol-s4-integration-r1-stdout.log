    38	# Map known distribution names to their top-level import module names.
    39	_DIST_TO_MODULES: dict[str, set[str]] = {
    40	    "python_ulid": {"ulid"},
    41	    "python-ulid": {"ulid"},
    42	    "pyjwt": {"jwt"},
    43	    "pyyaml_ft": {"yaml"},
    44	    "pyyaml-ft": {"yaml"},
    45	    "pyyaml": {"yaml"},
    46	    "typing_extensions": {"typing_extensions"},
    47	    "typing-extensions": {"typing_extensions"},
    48	    "rfc8785": {"rfc8785"},
    49	    "pytest_cov": {"pytest_cov"},
    50	    "pytest-cov": {"pytest_cov"},
    51	    "pytest_asyncio": {"pytest_asyncio"},
    52	    "pytest-asyncio": {"pytest_asyncio"},
    53	    "linkify_it_py": {"linkify_it"},
    54	    "markdown_it_py": {"markdown_it"},
    55	    "mdit_py_plugins": {"mdit_py_plugins"},
