   555	    def _genesis_lineage_id(self) -> str:
   556	        """The declaration genesis row projects the ARRIVAL lineage.
   557	
   558	        ``store_meta.own_lineage`` is stamped with this same value by the
   559	        base ceremony, so identity is written from arrival, read from
   560	        sqlite, and re-derivable from the log with every projection gone —
   561	        the strongest assertion in the cut's gate. The row id being the
   562	        lineage id preserves the legacy invariant the CAS head-tracking
   563	        keys off.
   564	        """
   565	        try:
   566	            return self._log.lineage()
   567	        except GenesisRefused as exc:
   568	            raise GenesisRefused(
   569	                f"{self._log.path} has no arrival genesis — the declaration "
   570	                "absorb is movement 2; mint the arrival genesis (movement 1, "
