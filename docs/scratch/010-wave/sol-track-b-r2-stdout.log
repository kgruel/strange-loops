package conform

import (
	"testing"

	"github.com/kaygee/loops-go/atoms"
	"github.com/kaygee/loops-go/store"
)

// M1: Go reads a Python-written store and reproduces identical fold state.
//
// This is the top-risk milestone collapsed to one assertion: store-read
// interop (read the .db Python wrote, unchanged) AND fold/parse semantic
// parity over real data. `id` is not part of the replayed Fact, so the result
// is ULID-independent — isolating pure semantic parity.

type storeFixture struct {
	PythonCommit string `json:"python_commit"`
	DB           string `json:"db"`
	Kind         string `json:"kind"`
	Folds        []any  `json:"folds"`
	StateFields  []struct {
		Name string `json:"name"`
		Kind string `json:"kind"`
	} `json:"state_fields"`
	Expected map[string]any `json:"expected"`
}

func TestM1StoreReplayParity(t *testing.T) {
	var fx storeFixture
	loadJSON(t, "../stores/proc.expected.json", &fx)

	dbPath := vectorsDir(t) + "/../stores/" + fx.DB
	payloads, err := store.Payloads(dbPath)
	if err != nil {
		t.Fatalf("read store %s: %v (regenerate: uv run python tools/gen_store_fixture.py in the loops repo)", dbPath, err)
	}
	t.Logf("M1: read %d facts from Python store @ python %.9s", len(payloads), fx.PythonCommit)
	if len(payloads) == 0 {
		t.Fatal("no facts read from store")
	}

	folds, err := atoms.DecodeFolds(fx.Folds)
	if err != nil {
		t.Fatalf("decode folds: %v", err)
	}
	fields := make([]atoms.Field, len(fx.StateFields))
	for i, sf := range fx.StateFields {
		fields[i] = atoms.Field{Name: sf.Name, Kind: sf.Kind}
	}
	spec := &atoms.Spec{Folds: folds, StateFields: fields}

	got := spec.Replay(payloads)
	if d := Diff(got, fx.Expected); d != "" {
		t.Fatalf("M1 fold-state parity divergence over Python store:\n%s", d)
	}
}
package conform

import (
	"testing"

	"github.com/kaygee/loops-go/atoms"
	"github.com/kaygee/loops-go/store"
)

// Merge-commutativity differential (SPEC §6.2). The fixture holds two real
// merged stores produced by the Python store-merge op: merge_ab.db = A<-B and
// merge_ba.db = B<-A. Their physical rowid layouts differ, but every fact keeps
// its (ts, id) verbatim, so replaying in (ts, id) order MUST reproduce the same
// derived state from both directions — and that state MUST equal the
// Python-replayed expected. This exercises the order-sensitive folds (Collect,
// Window, Upsert-overwrite) that diverge under the incumbent's ORDER BY rowid.
//
// Reference: the loops repo's libs/store/tests/test_merge.py::TestMergeFoldCommutativity
// Regenerate (in the loops repo): uv run python tools/gen_merge_fixture.py --loops-go .
type mergeFixture struct {
	PythonCommit string   `json:"python_commit"`
	DBs          []string `json:"dbs"`
	Folds        []any    `json:"folds"`
	StateFields  []struct {
		Name string `json:"name"`
		Kind string `json:"kind"`
	} `json:"state_fields"`
	Expected map[string]any `json:"expected"`
}

func TestMergeCommutativity(t *testing.T) {
	var fx mergeFixture
	loadJSON(t, "../stores/merge.expected.json", &fx)

	folds, err := atoms.DecodeFolds(fx.Folds)
	if err != nil {
		t.Fatalf("decode folds: %v", err)
	}
	fields := make([]atoms.Field, len(fx.StateFields))
	for i, sf := range fx.StateFields {
		fields[i] = atoms.Field{Name: sf.Name, Kind: sf.Kind}
	}
	spec := &atoms.Spec{Folds: folds, StateFields: fields}

	if len(fx.DBs) != 2 {
		t.Fatalf("expected 2 merged dbs, got %d", len(fx.DBs))
	}
	for _, db := range fx.DBs {
		t.Run(db, func(t *testing.T) {
			dbPath := vectorsDir(t) + "/../stores/" + db
			payloads, err := store.Payloads(dbPath)
			if err != nil {
				t.Fatalf("read %s: %v (regenerate: uv run python tools/gen_merge_fixture.py in the loops repo)", db, err)
			}
			got := spec.Replay(payloads)
			if d := Diff(got, fx.Expected); d != "" {
				t.Fatalf("merge-direction %s re-fold divergence under (ts,id) replay:\n%s", db, d)
			}
		})
	}
}

