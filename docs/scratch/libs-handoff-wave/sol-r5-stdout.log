   195	
   196	def _present(conn, table: str, columns: tuple[str, ...]) -> tuple[str, ...]:
   197	    """``columns`` narrowed to those the table actually has.
   198	
   199	    A pre-signature-era index has no ``signature`` column. Verification never
   200	    migrates schema (the same rule ``verify_chain`` holds), so it asks for what
   201	    is there and compares the arity it got.
   202	    """
   203	    have = {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}
   204	    return tuple(c for c in columns if c in have)
   205	
