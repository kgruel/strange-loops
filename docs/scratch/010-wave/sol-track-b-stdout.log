func (f TopN) build() FoldFn {
	return func(state, payload map[string]any) {
		keyVal, hasKey := payload[f.Key]
		byVal, hasBy := payload[f.By]
		if !hasKey || keyVal == nil || !hasBy || byVal == nil {
			return
		}
		if !isNumber(byVal) {
			reject(state, f.Target) // off-type `by` value skips + counts (§4.4)
			return
		}
		items, _ := state[f.Target].(map[string]any)
		if items == nil {
			items = map[string]any{}
		}
		items[asString(keyVal)] = cloneMap(payload)

		if len(items) > f.N {
			keys := make([]string, 0, len(items))
			for k := range items {
				keys = append(keys, k)
			}
			// NOTE: Python sorts insertion-ordered dict keys with a stable
			// sort, so ties evict by insertion order. Go maps have no order;
			// we tie-break by key string for determinism. This DIVERGES from
			// Python for equal `by` values (none in the conformance corpus).
			// Logged in FINDINGS.md as a promote-to-protocol candidate.
			sort.SliceStable(keys, func(i, j int) bool {
				bi := numOr(items[keys[i]].(map[string]any), f.By, 0)
				bj := numOr(items[keys[j]].(map[string]any), f.By, 0)
				if bi == bj {
					return keys[i] < keys[j]
				}
				if f.Desc {
					return bi > bj
				}
				return bi < bj
			})
			keep := map[string]any{}
			for _, k := range keys[:f.N] {
				keep[k] = items[k]
			}
			items = keep
		}
		state[f.Target] = items
	}
package atoms

import (
	"sort"
	"strings"
)

// FoldFn mutates state in place from a payload. Mirrors Python's
// (state: dict, payload: dict) -> None closures from atoms/engine.py.
type FoldFn func(state, payload map[string]any)

// FoldOp is a fold descriptor. The concrete types mirror atoms/fold.py.
type FoldOp interface {
	build() FoldFn
}

// reject implements the R2 off-type rule (SPEC §4.4): a numeric fold that meets
// an off-type or missing-required value SKIPS the fold and records the rejection
// in a deterministic `{target}_rejected` counter that is part of fold state.
// Errors-as-state — visible in every snapshot, replay-deterministic (no clock,
// no IO), and it keeps Avg's denominator honest. Mirrors atoms/engine._reject.
// See decision design/fold-off-type-skip-with-counter (loops 14eb723).
func reject(state map[string]any, target string) {
	key := target + "_rejected"
	state[key] = numOr(state, key, 0) + 1
}

// isNumber reports whether v is an off-type-rule "number" — int/float only.
// bool is OFF-TYPE (SPEC §1.2: true ≢ 1). asFloat already excludes bool, so
// this is its boolean projection; numeric strings are off-type too (no
// coercion). Mirrors atoms/engine._is_number.
func isNumber(v any) bool { _, ok := asFloat(v); return ok }

// --- Primitive folds (atoms/fold.py) ---

type Latest struct{ Target string }
type Count struct{ Target string }
type Sum struct {
	Target string
	Field  string
}
type Collect struct {
	Target string
	Max    int // 0 = unbounded
}
type Upsert struct {
	Target string
	Key    string
}

// --- Convenience folds ---

type TopN struct {
	Target string
	Key    string
	By     string
	N      int
	Desc   bool
}
type Min struct {
	Target string
	Field  string
}
type Max struct {
	Target string
	Field  string
}
type Avg struct {
	Target string
	Field  string
}
type Window struct {
	Target string
	Field  string
	Size   int
}

func (f Latest) build() FoldFn {
	return func(state, payload map[string]any) {
		// R2 (SPEC §4.4): a missing _ts is rejected, never substituted with the
		// wall clock — time.time() would make fold state depend on WHEN replay
		// ran, breaking replay determinism. Mirrors atoms/engine._make_latest.
		ts, ok := payload["_ts"]
		if !ok || ts == nil {
			reject(state, f.Target)
			return
		}
		state[f.Target] = ts
	}
}

func (f Count) build() FoldFn {
	return func(state, payload map[string]any) {
		state[f.Target] = numOr(state, f.Target, 0) + 1
	}
}

func (f Sum) build() FoldFn {
	return func(state, payload map[string]any) {
		v, ok := payload[f.Field]
		if !ok || v == nil {
			return // missing field is silent (no-op), NOT a rejection (§4.1)
		}
		if !isNumber(v) {
			reject(state, f.Target) // off-type (bool, string) skips + counts (§4.4)
			return
		}
		nv, _ := asFloat(v)
		state[f.Target] = numOr(state, f.Target, 0) + nv
	}
