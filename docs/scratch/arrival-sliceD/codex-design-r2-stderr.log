  1531	    def _cursor_rowid(self, fact_id: str) -> int | None:
  1532	        """Resolve a window cursor (fact id) to its rowid — witness order.
  1533	
  1534	        "" (start-of-store / empty-store sentinel) resolves to 0, before the
  1535	        first rowid. A cursor whose fact no longer exists resolves to None:
  1536	        the window is unresolvable and hashes as empty — any non-empty
  1537	        commitment over it then mismatches. (Deleting a cursor fact that was
  1538	        itself inside a covered window already breaks THAT window's hash.)
  1539	        """
  1540	        if fact_id == "":
  1541	            return 0
  1542	        row = self._conn.execute(
  1543	            "SELECT rowid FROM facts WHERE id = ?", (fact_id,)
  1544	        ).fetchone()
