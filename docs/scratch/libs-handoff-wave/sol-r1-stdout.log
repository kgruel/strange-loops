   257	            # domain (``1e999`` overflows to inf; a 400-digit integer exceeds
   258	            # the safe-integer bound). Range-check here — the literal parser
   259	            # only sees the NaN/Infinity spellings.
   260	            if isinstance(value, float):
   261	                if not math.isfinite(value):
   262	                    raise JsonlCodecError(
   263	                        f"{t} field {field!r} must be a finite number, got "
   264	                        f"{value!r}"
   265	                    )
   266	            elif not (_JCS_INT_MIN <= value <= _JCS_INT_MAX):
   267	                raise JsonlCodecError(
   268	                    f"{t} field {field!r} is outside the JCS safe-integer "
   269	                    f"domain: {value}"
   270	                )
   271	        elif not isinstance(value, str):
   272	            raise JsonlCodecError(
   273	                f"{t} field {field!r} must be a string, got "
   274	                f"{type(value).__name__}"
   275	            )
   276	    if _SIGNATURE in obj and obj[_SIGNATURE] is None:
   277	        # Absent IS the unsigned era; an explicit null is a second spelling
   278	        # of the same state, so serialize stays the unique canonical form.
   279	        raise JsonlCodecError(
   280	            f"{t} field 'signature' must be absent, not null, when unsigned"
   281	        )
   282	    sig = obj.get(_SIGNATURE)
   283	    if sig is not None and not isinstance(sig, str):
   284	        raise JsonlCodecError(
   285	            f"{t} field 'signature' must be a string, got {type(sig).__name__}"
   286	        )
   287	
   288	
   289	def _validate_batch(obj: dict) -> None:
   290	    """Hold a batch envelope to the structural rules — both directions."""
   291	    unknown = sorted(set(obj) - _BATCH_KEYS)
   292	    if unknown:
   293	        raise JsonlCodecError(f"unknown field(s) in batch line: {unknown}")
   294	    rows = obj.get(_ROWS)
   295	    if not isinstance(rows, list):
   296	        raise JsonlCodecError(
   297	            "batch field 'rows' must be an array of fact records, got "
   298	            f"{type(rows).__name__}"
   299	        )
   300	    if len(rows) < _MIN_BATCH_ROWS:
   301	        raise JsonlCodecError(
   302	            f"batch must carry at least {_MIN_BATCH_ROWS} rows, got "
   303	            f"{len(rows)} — a 1-row batch is a second spelling of a plain "
   304	            "fact line, and an empty one encodes nothing"
   305	        )
   306	    seen_ids: set = set()
   307	    for i, elem in enumerate(rows):
   308	        if not isinstance(elem, dict):
   309	            raise JsonlCodecError(
   310	                f"batch row {i} must be a JSON object, got {type(elem).__name__}"
   311	            )
   312	        t = elem.get("t")
   313	        if t == _BATCH:
   314	            raise JsonlCodecError(f"batch row {i} is a nested batch — batches do not nest")
   315	        if t == "tick":
   316	            raise JsonlCodecError(
   317	                f"batch row {i} is a tick record — ticks are minted "
   318	                "one-at-a-time and chain-linked, never batched"
   319	            )
   320	        if t != "fact":
   321	            raise JsonlCodecError(f"batch row {i} has unknown record discriminator t={t!r}")
