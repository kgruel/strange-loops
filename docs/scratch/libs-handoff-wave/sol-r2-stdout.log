   447	def apply_declaration_update(
   448	    preview: DeclarationUpdatePreview,
   449	    *,
   450	    observer: str,
   451	    credentials: CredentialProvider | None = None,
   452	    write_file: Callable[[Path, str | None], None] | None = None,
   453	) -> DeclarationUpdateResult:
   454	    """Apply a planned declaration update — atomic, or a typed state.
   455	
   456	    Sequence (store-first, every prefix recoverable):
   457	
   458	    1. durable intent (sibling ``.vertex.intent``, tempfile+fsync+rename);
   459	    2. the S1b store ceremony — ``absorb_genesis`` or
   460	       ``absorb_edit(expected_head=preview.expected_head)`` — which holds the
   461	       identity check, CAS, sign-final-payload, and append in ONE
   462	       transaction; a stale preview refuses INSIDE that transaction with the
   463	       canonical log byte-identical;
   464	    3. the file-cache replace (``write_file`` injectable; the shipped default
   465	       atomically writes ``preview.proposed_text``);
   466	    4. intent removal.
   467	
   468	    A failure in (2) removes the intent (nothing mutated) and returns
   469	    ``stale``/``refused``. A failure in (3) — including process death,
   470	    which simply never reaches (4) — leaves the intent for
   471	    :func:`recover_declaration_update` and, when the process survives to
   472	    report it, returns the typed ``needs-recovery`` state.
   473	
   474	    ``credentials`` supplies the operation-fresh fact signer
   475	    (:class:`~engine.handle.CredentialProvider`, the ratified S3 shape);
   476	    ``None`` or a ``None`` signer refuses at the store's own signing gate —
   477	    declaration events are the attestation root.
   478	    """
   479	    from .sqlite_store import (
   480	        AmbiguousGenesis,
   481	        GenesisExists,
   482	        NoGenesis,
   483	        ReservedKindViolation,
   484	        StaleDeclarationHead,
   485	        UnsignableEdit,
   486	        UnsignableGenesis,
   487	    )
   488	
   489	    vertex_path = preview.vertex_path
   490	    pending = intent_path_for(vertex_path)
   491	    if pending.exists():
   492	        return DeclarationUpdateResult(
   493	            status="pending-intent",
   494	            reason=(
   495	                f"pending declaration-update intent at {pending} — run "
   496	                "recover_declaration_update first"
   497	            ),
   498	            intent_path=pending,
   499	        )
   500	    if not preview.applicable:
   501	        return DeclarationUpdateResult(status="refused", reason=preview.reason)
   502	    if preview.mode == "edit" and not preview.changes:
   503	        return DeclarationUpdateResult(
   504	            status="noop", reason="file matches store head — nothing to apply"
   505	        )
   506	
   507	    # Canonical-store writability gate (SOL-R1-04): a typed refusal BEFORE
   508	    # any intent lands — and before the edit-mode currency pre-check, whose
   509	    # store open could itself fail raw on an unwritable file. An unwritable
   510	    # store must leave zero residue.
   511	    from .probe import _writable
   512	
   513	    if not _writable(preview.canonical_path):
