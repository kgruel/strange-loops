   133	def test_g2_the_exclusivity_trace(tmp_path):
   134	    log_path, kyle, ana, intro_ordinal = _build_exercised_store(tmp_path)
   135	    _delete_every_projection(log_path)
   136	    assert not list(tmp_path.glob("*.vertex")), "no registry artifact exists at all"
   137	
   138	    log = ArrivalLog(log_path)
   139	    lineage = log.lineage()
   140	    rows = verify_authorship(log, _verify)
   141	
   142	    # Every signature in the log is covered by exactly one trace row.
   143	    signed = [r["ord"] for r in log.walk() if "sig" in r]
   144	    assert [r.ordinal for r in rows] == signed and signed
   145	
   146	    # The trace: (key, lineage, ordinal) — every verifying key resolves
   147	    # from a coordinate IN THIS LOG, and from nowhere else. The founding
   148	    # key resolves from the genesis coordinate; ana's from the stated
   149	    # introduction ordinal.
   150	    trace = [(r.key, r.introduced_lineage, r.introduced_ordinal) for r in rows]
   151	    assert all(lin == lineage for _, lin, _ in trace)
   152	    assert set(trace) == {
   153	        (kyle.public, lineage, 0),
   154	        (ana.public, lineage, intro_ordinal),
   155	    }
   156	    assert intro_ordinal == 2  # the stated ordinal, pinned
   157	
   158	    # The keys the trace names are IN the records at those coordinates —
   159	    # the coordinate is not a label, it is where the key lives.
   160	    assert log.read(0)["body"]["key"] == kyle.public
   161	    assert log.read(intro_ordinal)["body"]["key"] == ana.public
