   246	def test_export_places_ticks_after_their_window(full_store, tmp_path):
   247	    """Each tick line follows the fact line named by its fact_cursor."""
   248	    from engine.jsonl_codec import deserialize_row
   249	
   250	    log = tmp_path / "out.jsonl"
   251	    export_jsonl(full_store, log)
   252	    records = [deserialize_row(ln) for ln in log.read_text().splitlines()]
   253	
   254	    seen: list[str] = []
   255	    for t, row in records:
   256	        if t == "fact":
   257	            seen.append(row[0])
   258	            continue
   259	        cursor = row[8]
   260	        if cursor:
   261	            assert cursor in seen, "tick precedes the fact at its cursor"
   262	            # nothing after the cursor fact has been emitted yet
   263	            assert seen[-1] == cursor
