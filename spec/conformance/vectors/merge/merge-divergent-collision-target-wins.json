          "kind": "config",
          "ts": 100.0,
          "payload": {
            "setting": "mode",
            "val": "target_active"
          },
          "observer": "alice",
          "origin": ""
        }
      ]
    ],
    "source": [
      [
        "01COLLISION0000000000000001",
        {
          "kind": "config",
          "ts": 100.0,
          "payload": {
            "setting": "mode",
            "val": "source_divergent_override"
          },
          "observer": "bob",
          "origin": ""
        }
      ]
    ]
  },
  "expected": {
