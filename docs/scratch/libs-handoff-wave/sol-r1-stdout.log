    87	    def test_configured_but_none_signer_is_signed_false(
    88	        self, tmp_path, canonical,
    89	    ):
    90	        """Oracle 2 + 5 (mutation check): signing is CONFIGURED (the signer
    91	        callable is wired) but returns None for bob — the committed row is
    92	        unsigned and the receipt must say so. In the same store alice's row
    93	        IS signed under identical configuration: any implementation reading
    94	        configuration instead of the committed row returns the same answer
    95	        for both observers and fails one of these assertions."""
    96	        store = _store(tmp_path, canonical,
    97	                       fact_signer=_fake_signer_for({"alice"}))
    98	        v = _vertex(store)
    99	
   100	        r_alice = v.receive_receipt(Fact.of("note", "alice", n=1))
   101	        r_bob = v.receive_receipt(Fact.of("note", "bob", n=2))
   102	
   103	        assert r_alice.attestation.signed is True
   104	        assert r_bob.attestation == FactAttestation(
   105	            signed=False, observer="bob", signature_present=False,
   106	        )
   107	        # The committed rows agree — attestation mirrors the store, both ways.
   108	        assert store.fact_signature(r_alice.fact_id) is not None
   109	        assert store.fact_signature(r_bob.fact_id) is None
