   721	
   722	def test_interior_sqlite_tamper_of_a_sealed_fact_survives_open_but_fails_verify(
   723	    tmp_path,
   724	):
   725	    """The honest scope of the two layers, pinned.
   726	
   727	    Open-time detection is cheap on purpose: the last consumed line's
   728	    integrity compare plus the stamped row counts. Those catch out-of-band
   729	    *inserts* and an edit to the last-consumed row — not an in-place update
   730	    to an interior one. Full content verification is the chain walk's job:
   731	    a sealed fact's window hash commits to its content, so `store verify`
   732	    breaks on exactly the edit that opens clean.
   733	    """
   734	    import sqlite3
   735	
   736	    store = open_store(tmp_path)
   737	    store.append(fact(message="first"))
   738	    store.append(fact(message="second"))
   739	    store.append_tick(
   740	        Tick(name="seal", ts=datetime.now(UTC), payload={"n": 2}, origin="t")
   741	    )
   742	    assert store.verify_chain()["ok"]
   743	    store.close()
   744	
   745	    db = tmp_path / "s.db"
   746	    conn = sqlite3.connect(str(db))
   747	    fid, payload = conn.execute(
   748	        "SELECT id, payload FROM facts ORDER BY rowid"
   749	    ).fetchone()
   750	    conn.execute(
   751	        "UPDATE facts SET payload = ? WHERE id = ?",
   752	        (json.dumps({**json.loads(payload), "message": "TAMPERED"}), fid),
   753	    )
   754	    conn.commit()
   755	    conn.close()
   756	
   757	    store = open_store(tmp_path)
   758	    # Open-time detection does NOT see this — counts match and the tampered
   759	    # row is not the last consumed line. Documented, not claimed otherwise.
   760	    assert store.catch_up() == "synced"
     1	"""JSONL line codec — payload verbatimness, hash re-derivation, strictness.
     2	
     3	The whole point of the codec is that a row can leave sqlite, live as a line
     4	of text, come back, and still hash to the same commitment. Every signature
     5	in every live store depends on it, across three eras (pre-chain, chained,
     6	signed), so the era matrix is tested explicitly.
     7	"""
     8	
     9	import json
    10	
    11	import pytest
    12	
    13	from engine.jsonl_codec import (
    14	    JsonlCodecError,
    15	    deserialize_row,
    16	    serialize_fact_row,
    17	    serialize_tick_row,
    18	)
    19	from engine.sqlite_store import (
    20	    _fact_commitment_hash,
    21	    _fact_row_hash,
    22	    _tick_row_hash,
    23	)
    24	
    25	def deserialize_fact_row(line):
    26	    """Decode, asserting the line declares itself a fact."""
    27	    t, row = deserialize_row(line)
    28	    assert t == "fact"
    29	    return row
    30	
    31	
    32	def deserialize_tick_row(line):
    33	    """Decode, asserting the line declares itself a tick."""
    34	    t, row = deserialize_row(line)
    35	    assert t == "tick"
    36	    return row
    37	
    38	
    39	# --- fixtures: rows of every era -------------------------------------------
    40	
    41	TRICKY_PAYLOAD = json.dumps(
    42	    {
    43	        "message": 'he said "hi"\nthen\tleft\r\n',
    44	        "ünïcødé": "日本語 — emoji 🌀, U+2028\u2028 U+2029\u2029",
    45	        "backslash": "C:\\path\\to\\\u0000nul",
    46	        "nested": {"a": [1, 2.5, None, True]},
    47	    },
    48	    ensure_ascii=False,
    49	)
    50	
    51	# High-precision ts: shortest-roundtrip repr must survive the text hop.
    52	TS = 1721359123.4567891
    53	
    54	FACT_V1 = ("01JFACT", "decision", TS, "kyle", "loops", TRICKY_PAYLOAD)
    55	FACT_SIGNED = (*FACT_V1, "sig-fact-abc")
    56	FACT_UNSIGNED_7 = (*FACT_V1, None)
    57	
    58	TICK_PRECHAIN = (
    59	    "01JTICK", "project", TS, None, "loops", TRICKY_PAYLOAD,
    60	    None, None, None, None,
    61	)
    62	TICK_CHAINED = (
    63	    "01JTICK2", "project", TS, TS - 60.0, "loops", TRICKY_PAYLOAD,
    64	    "prevhash", "2026-08-11T00:00:00Z", "01JFACT", "windowhash",
    65	)
    66	TICK_SIGNED = (*TICK_CHAINED, "sig-tick-xyz")
    67	TICK_UNSIGNED_11 = (*TICK_CHAINED, None)
    68	
    69	
    70	# --- (a) payload verbatim + lossless round-trip ----------------------------
    71	
    72	
    73	@pytest.mark.parametrize("row", [FACT_V1, FACT_SIGNED, FACT_UNSIGNED_7])
    74	def test_fact_round_trip_is_lossless(row):
    75	    back = deserialize_fact_row(serialize_fact_row(row))
    76	    assert len(back) == 7
    77	    assert back[:6] == row[:6]
    78	    assert back[6] == (row[6] if len(row) > 6 else None)
    79	    assert back[5] == TRICKY_PAYLOAD  # verbatim, character for character
    80	    assert back[2] == TS
    81	
    82	
    83	@pytest.mark.parametrize(
    84	    "row", [TICK_PRECHAIN, TICK_CHAINED, TICK_SIGNED, TICK_UNSIGNED_11]
    85	)
    86	def test_tick_round_trip_is_lossless(row):
    87	    back = deserialize_tick_row(serialize_tick_row(row))
    88	    assert len(back) == 11
    89	    assert back[:10] == row[:10]
    90	    assert back[10] == (row[10] if len(row) > 10 else None)
    91	    assert back[5] == TRICKY_PAYLOAD
