   119	    def __replace__(self, **changes):
   120	        """Support dataclasses.replace() and copy.replace()."""
   121	        return type(self)(
   122	            kind=changes.get("kind", self.kind),
   123	            ts=changes.get("ts", self.ts),
   124	            payload=changes.get("payload", self.payload),
   125	            observer=changes.get("observer", self.observer),
   126	            origin=changes.get("origin", self.origin),
   127	        )
   128	
   129	    @classmethod
   130	    def of(cls, kind: str, observer: str, *, origin: str = "", ts: float | None = None, **data) -> Fact:
   131	        """Create a Fact with auto-timestamp and dict payload."""
   132	        return cls(kind=kind, ts=ts if ts is not None else time.time(), payload=data, observer=observer, origin=origin)
   133	
   134	    @classmethod
   135	    def tick(cls, name: str, observer: str, *, origin: str = "", ts: float | None = None, **data) -> Fact:
   136	        """Create a boundary-related Fact with tick. prefix."""
   137	        return cls(kind=f"tick.{name}", ts=ts if ts is not None else time.time(), payload=data, observer=observer, origin=origin)
   138	
   139	    def to_dict(self) -> dict:
   140	        """Convert to a plain dict for serialization."""
   141	        payload = dict(self.payload) if isinstance(self.payload, MappingProxyType) else self.payload
   142	        return {
   143	            "kind": self.kind,
   144	            "ts": self.ts,
   145	            "payload": payload,
   146	            "observer": self.observer,
   147	            "origin": self.origin,
   148	        }
   149	
   150	    @classmethod
   151	    def from_dict(cls, d: dict) -> Fact:
   152	        """Reconstruct a Fact from a dict."""
   153	        return cls(
   154	            kind=d["kind"],
   155	            ts=float(d["ts"]),
   156	            payload=d["payload"],
   157	            observer=d["observer"],
   158	            origin=d.get("origin", ""),
   159	        )
   160	
