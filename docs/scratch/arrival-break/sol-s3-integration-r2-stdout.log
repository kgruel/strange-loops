  2010	def test_restoring_the_abandoned_backup_is_refused_by_the_fence(tmp_path):
  2011	    """Sol's silent loop, closed.
  2012	
  2013	    The loop: reset from an abandoned head back to *N*, restore the authentic
  2014	    backup, and the open verifies descent HONESTLY — the chain really does
  2015	    reach the abandoned head from the decreed one — so it answered ADVANCED,
  2016	    journaled that head back into the current epoch, and every later open read
  2017	    UNCHANGED. No refusal, no fork, repeatable forever, and the acceptance
  2018	    erased its own evidence by recording it.
  2019	
  2020	    Verified descent was never the whole question. The chain is intact; what it
  2021	    is not is the history this machine's operator decided to keep.
  2022	    """
  2023	    log_path, _lineage, abandoned, backup = _reset_away_from(tmp_path)
  2024	
  2025	    log_path.write_bytes(backup)
  2026	    with pytest.raises(AbandonedHistoryFenced) as excinfo:
  2027	        opened(log_path)
  2028	
  2029	    assert abandoned.record_hash in str(excinfo.value)
  2030	    assert "trust-reset ceremony" in str(excinfo.value)
