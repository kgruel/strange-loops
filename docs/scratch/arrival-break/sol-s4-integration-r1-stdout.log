    18	
    19	
    20	def test_sqlite3_confined_to_engine_store():
    21	    """Only engine and store may import sqlite3.
    22	
    23	    atoms, lang, and painted have no business touching the database.
    24	    Database access flows through engine's vertex interface.
    25	    """
    26	    violations = []
    27	    for lib_dir in (REPO_ROOT / "libs").iterdir():
    28	        if not lib_dir.is_dir():
    29	            continue
    30	        lib_name = lib_dir.name
    31	        if lib_name in _SQLITE_ALLOWED_LIBS:
