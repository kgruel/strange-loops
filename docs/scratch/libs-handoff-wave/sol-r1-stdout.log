   108	def intent_path_for(vertex_path: Path | str) -> Path:
   109	    """The durable-intent sibling for a vertex: ``<name>.vertex.intent``."""
   110	    vertex_path = Path(vertex_path)
   111	    return vertex_path.parent / (vertex_path.name + INTENT_SUFFIX)
