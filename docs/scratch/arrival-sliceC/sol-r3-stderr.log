from itertools import permutations
from atoms import ByKey, OrderingError, totalize

def category(exc):
    msg = str(exc).lower()
    if \"mixed key types\" in msg: return \"MIXED_K\"
    if \"nan key value\" in msg: return \"NAN_K\"
    if \"nan tie-break id\" in msg: return \"NAN_ID\"
    if \"do not compare\" in msg: return \"NONCOMPARE\"
    return \"OTHER\"

def run(labels, kvals, idvals=None):
    records = [{\"id\": label, \"k\": kvals[label]} for label in labels]
    getter = (lambda r: idvals[r[\"id\"]]) if idvals is not None else (lambda r: r[\"id\"])
    try:
        out = totalize(records, ByKey(\"k\"), get_id=getter)
        return \"OK:\" + \",\".join(r[\"id\"] for r in out)
    except OrderingError as exc:
        return category(exc) + \":\" + str(exc).split(\" — \", 1)[0]

