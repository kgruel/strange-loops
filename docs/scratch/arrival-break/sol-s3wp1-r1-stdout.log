+++ b/review_probe_s3wp1.py
@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+import hashlib
+import json
+import multiprocessing as mp
+import os
+import tempfile
+from pathlib import Path
+
+from engine.arrival_contract import Head
+from engine.arrival_head_attestation import (
+    HeadAttestation,
+    JournalEquivocation,
+    Kind,
+    Level,
+    append_entry,
+    journal_path,
+    parse_journal_lines,
+    read_journal,
+    unaccounted_heads,
+)
+
+LINEAGE = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
+
+
+def obs(ordinal: int, digest: str, observed_at: float) -> HeadAttestation:
+    return HeadAttestation(
+        Head(LINEAGE, ordinal, digest * 64), Kind.ADVANCE, Level.COMMIT,
+        observed_at, "/tmp/store", "probe",
+    )
+
+
+def writer(root: str, start: mp.synchronize.Event, lo: int, hi: int) -> None:
+    os.environ["XDG_STATE_HOME"] = root
+    start.wait()
+    for ordinal in range(lo, hi):
+        append_entry(obs(ordinal, "a", float(ordinal)))
+
+
+def main() -> None:
+    with tempfile.TemporaryDirectory() as root:
+        os.environ["XDG_STATE_HOME"] = root
+        start = mp.Event()
+        ps = [mp.Process(target=writer, args=(root, start, 0, 2000)),
+              mp.Process(target=writer, args=(root, start, 2000, 4000))]
+        for p in ps:
+            p.start()
+        start.set()
+        for p in ps:
+            p.join()
+        path = journal_path(LINEAGE)
+        lines = path.read_text().splitlines()
+        decoded = [json.loads(line) for line in lines]
+        result = read_journal(LINEAGE)
+        print("concurrency", [p.exitcode for p in ps], len(lines), len(decoded),
+              len(result.entries), result.established_head().head.ordinal,
+              sum(1 for row in decoded if row.get("type") == "arrival-head-observation"))
+
+    same = parse_journal_lines([
+        json.dumps({"type": "arrival-head-observation"}),
+        json.dumps({"v": 1, "kind": "advance", "level": "commit", "lineage": LINEAGE,
+                    "ordinal": 7, "record_hash": "a" * 64, "observed_at": 1.0}),
+        json.dumps({"v": 1, "kind": "audit", "level": "full", "lineage": LINEAGE,
+                    "ordinal": 7, "record_hash": "a" * 64, "observed_at": 99.0}),
+    ])
+    print("same-head-different-time", same.established_head().head.ordinal,
+          same.established_head().observed_at)
+
+    try:
+        parse_journal_lines([
+            json.dumps({"type": "arrival-head-observation"}),
+            json.dumps({"v": 1, "kind": "advance", "level": "commit", "lineage": LINEAGE,
+                        "ordinal": 7, "record_hash": "a" * 64, "observed_at": 1.0}),
+            json.dumps({"v": 1, "kind": "advance", "level": "commit", "lineage": LINEAGE,
+                        "ordinal": 7, "record_hash": "b" * 64, "observed_at": 1.0}),
+        ])
+    except Exception as exc:
+        print("equivocation", type(exc).__name__, isinstance(exc, JournalEquivocation))
+
+    header_with_added_kind = [
+        json.dumps({"v": 1, "type": "arrival-head-observation", "kind": "header-v2", "extra": 1}),
+        json.dumps({"v": 1, "kind": "advance", "level": "commit", "lineage": LINEAGE,
+                    "ordinal": 7, "record_hash": "a" * 64, "observed_at": 1.0}),
+    ]
+    try:
+        parse_journal_lines(header_with_added_kind)
+    except Exception as exc:
+        print("header-added-field", type(exc).__name__, str(exc))
+
+    entry = obs(12, "c", 42.25)
+    with tempfile.TemporaryDirectory() as root:
+        os.environ["XDG_STATE_HOME"] = root
+        path = append_entry(entry)
+        reread = read_journal(LINEAGE).established_head()
+        fields = json.loads(path.read_text().splitlines()[1])
+        print("roundtrip", reread == entry, sorted(fields), fields)
+        with path.open("a") as f:
+            f.write(json.dumps({"v": 1, "kind": "advance", "level": "commit", "lineage": LINEAGE,
+                                "ordinal": 13, "record_hash": "d" * 64, "observed_at": 43.0,
+                                "future": {"kept": True}}) + "\n")
+        before = path.read_bytes()
+        append_entry(obs(14, "e", 44.0))
+        after = path.read_bytes()
+        print("append-only-preserves-unknown", after.startswith(before), hashlib.sha256(before).hexdigest())
+
+    epoch = (obs(3, "a", 1.0),)
+    print("hostile-lookup", unaccounted_heads(epoch, lambda ordinal: epoch[0].head),
+          unaccounted_heads(epoch, lambda ordinal: Head(LINEAGE, ordinal, "b" * 64)))
+
+
+if __name__ == "__main__":
+    main()

