   320	        # page comes off the (ts, id) lens whatever its member count, so that is
   321	        # the axis a declared ordering is checked against.
   322	        _check_declared_ordering(ordering, single_store=not is_aggregate)
   323	
   324	        if is_aggregate:
   325	            # Multi-store aggregate vertex
   326	            all_facts = vertex_facts(
   327	                target_path,
   328	                since_ts=0.0,
   329	                until_ts=float("inf"),
   330	                kind=kind,
   331	                observer=observer,
   332	                include_internal=include_internal,
   333	            )
   334	            if order == "newest":
   335	                all_facts = list(reversed(all_facts))
   336	
   337	            capped = all_facts[:limit]
   338	            truncated = len(all_facts) > len(capped)
   339	            return FactPageResult(
   340	                items=capped,

