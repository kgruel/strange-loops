import ast, subprocess
path='libs/engine/src/engine/arrival_head_attestation.py'

def source(rev): return subprocess.check_output(['git','show',f'{rev}:{path}'], text=True)
def isdoc(stmt): return isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant) and isinstance(stmt.value.value, str)
def strip_body(body):
    out=[]
    for i, stmt in enumerate(body):
        if isdoc(stmt) and (i == 0 or isinstance(body[i-1], (ast.Assign, ast.AnnAssign))):
            continue
        out.append(stmt)
    return out

def strip(tree):
    for node in ast.walk(tree):
        for field in ('body','orelse','finalbody'):
            body=getattr(node,field,None)
            if isinstance(body,list): setattr(node,field,strip_body(body))
    ast.fix_missing_locations(tree)
    return tree

