   668	        'name "t"\n'
   669	        "loops {\n"
   670	        "  decision {\n"
   671	        '    boundary after=1 { run #"echo " quoted"# } // KEEP\n'
   672	        "  }\n"
   673	        '  task { fold { items "by" "name" } }\n'
   674	        "}\n"
   675	    )
