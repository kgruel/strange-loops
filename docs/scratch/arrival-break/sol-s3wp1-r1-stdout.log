[project]
name = "engine"
version = "0.1.0"
description = "Temporal infrastructure and identity — Tick, Vertex, Peer, Grant"
readme = "README.md"
authors = [{ name = "Kyle Gruel", email = "kylegruel@gmail.com" }]
requires-python = ">=3.11"
dependencies = [
    "atoms",
    "lang",
    "python-ulid>=3.0",
    "rfc8785>=0.1.4",
]

[tool.uv.sources]
atoms = { workspace = true }
lang = { workspace = true }
sign = { workspace = true }

[dependency-groups]
dev = [
    "hypothesis>=6.100",
    "mutmut>=3.2",
    "pytest>=8.0",
    "pytest-asyncio>=0.24",
    "pytest-cov>=6.0",
    "ruff>=0.8",
    # Test-only: real Ed25519 material for the injected-signer seam
    # (conftest Custodian). Runtime engine never imports sign — custody
    # is the composition layer; this group keeps the injection boundary.
    "sign",
    "ty>=0.0.1a11",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/engine"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]

[tool.coverage.run]
source = ["src/engine"]
branch = true

[tool.coverage.report]
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "\\.\\.\\.$",  # Protocol method stubs
]

[tool.ruff]
line-length = 100
target-version = "py311"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "PTH"]

[tool.ty.environment]
python-version = "3.11"

[tool.mutmut]
paths_to_mutate = ["src/engine/witness.py"]
tests_dir = [
    "tests/test_witness_position.py",
    "tests/test_witness_address_helpers.py",
    "tests/test_diff_interval_report.py",
    "tests/test_fold_at.py",
]
also_copy = ["src"]
    "libs/engine/src/engine",
    "libs/lang/src/lang",
    "libs/sdk/src/sdk",
    "libs/sign/src/sign",
    "libs/store/src/store",
    "apps/loops/src/loops",
]

# The root runs the tests that belong to no single package — the architecture
# ratchets and tests/chaos — so it needs the same dev tooling every member
# already declares. Without this, `uv run pytest` at the root resolves only the
# flat wheel's runtime deps and dies with "Failed to spawn: pytest" on any
# machine whose .venv was not already dirty from an earlier run. uv.lock is
# gitignored, so CI resolves fresh every time and hit exactly that.
[dependency-groups]
dev = [
    "pytest>=8.0",
    "pytest-cov>=6.0",
    "ruff>=0.8",
]

[tool.uv.workspace]
members = [
    "libs/atoms",
    "libs/custody",
    "libs/engine",
    "libs/lang",
    "libs/sdk",
    "libs/sign",
    "libs/store",
    "apps/loops",
]
