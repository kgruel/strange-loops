   489	    def _reconcile(self) -> None:
   490	        """Refuse to stamp past a durable line the index has not consumed.
   491	
   492	        A failure *after* the fsync (sqlite error, power cut, the process
   493	        dying) rolls the transaction back, leaving the line durable and the
   494	        offset unstamped — that is the recoverable state, and the next open
   495	        tails it forward. But a long-lived handle never reopens: it would
   496	        append line N+1 and stamp the offset past *both*, burying the orphan
   497	        forever while reporting ``synced``. So every append reconciles first.
   498	
   499	        Cheap in the common case: one ``store_meta`` read and one ``stat``,
   500	        no scan, no lock. Only a disagreement pays for :meth:`catch_up`
   501	        (which also covers a shrunk log, a torn tail and untrustworthy
   502	        offset metadata). Two handles racing the same orphan line is a loud
   503	        failure, not a silent one: the loser's tail INSERT hits the primary
   504	        key, rolls back, and the line stays recoverable.
   505	        """
   506	        if self._read_offset() == self._log_size():
   507	            return
   508	        self.catch_up()
   509	
   510	    def _sync_derived_state(self) -> None:
   511	        """Reconcile before the mint reads chain state off the index.
   512	
   513	        ``_write``'s reconcile is too late for a tick: ``append_tick`` has by
   514	        then already derived ``prev_hash``, ``window_start`` and the fact
   515	        cursor from an index that may not have consumed a durable line. The
   516	        successor would link past the orphan, and that mis-linkage goes into
   517	        the canonical log itself — where no later catch-up or rebuild can
   518	        repair it. Reconciling in front of the derivation costs two syscalls
   519	        when the index is current.
   520	        """
   521	        self._reconcile()
   522	
   523	    def _ceremony_persist(self, rows: list[tuple]) -> None:
   524	        """Make a declaration ceremony canonical: one durable line, stamped.
   525	
   526	        Runs inside the ceremony's open ``BEGIN IMMEDIATE`` transaction,
   527	        after every CAS check passed and the fact INSERTs (+ meta stamps)
   528	        are staged, immediately before the caller's COMMIT — the same shape
   529	        as :meth:`_write` steps 3–4. One row serializes as a plain fact
   530	        line; several as one ``batch`` envelope line (the log's atomicity
   531	        unit), so recovery can never expose a partial ceremony. Any failure
   532	        after the fsync rolls the index back and leaves the line durable
   533	        and unindexed — the standard recoverable state the next
   534	        open/reconcile tails forward, all N rows atomically.
   535	        """
   536	        line = serialize_batch(rows) if len(rows) > 1 else serialize_fact_row(rows[0])
   537	        # Same committed-marker discipline as _write: the staged INSERTs
   538	        # hold sqlite's write lock, so the marker read here cannot be raced.
   539	        marked = self._marked_counts()
   540	        if marked is None:
   541	            # Pre-marker store: adopt. _row_counts() already includes the
   542	            # ceremony's staged rows on this connection.
   543	            facts, ticks = self._row_counts()
   544	        else:
   545	            facts, ticks = marked
   546	            facts += len(rows)
   547	        offset = self._append_line(line)
   548	        self._stamp(offset, facts, ticks)
   549	
   550	    def _write_fact_row(self, row: tuple) -> None:
   551	        self._write(FACT_INSERT_SQL, row, serialize_fact_row(row), True)
   552	
   553	    def _write_tick_row(self, row: tuple) -> None:
   554	        self._write(TICK_INSERT_SQL, row, serialize_tick_row(row), False)
   555	
   556	    # ---- catch-up -----------------------------------------------------
   557	
   558	    def catch_up(self) -> str:
   559	        """Reconcile the sqlite index with the log. Returns what it did:
   560	        ``"synced"``, ``"tailed"``, ``"rebuilt"`` or ``"empty"``."""
   561	        self._truncate_torn_line()
   562	        size = self._log_size()
   563	        offset = self._read_offset()
   564	
   565	        if size == 0:
   566	            # No log yet. An index with rows but no log is not a
   567	            # JSONL-canonical store — refuse rather than invent a log.
   568	            if self._has_rows():
   569	                raise JsonlCanonicalUnsupported(
   570	                    f"{self._path} has indexed rows but no canonical log at "
   571	                    f"{self._log_path} — export it first "
   572	                    "(store.jsonl.export_jsonl), then open it JSONL-canonical"
   573	                )
   574	            self._index_offset(0, 0, 0)
   575	            return "empty"
   576	
   577	        if offset is None:
   578	            self._rebuild("no consumed-offset marker recorded")
   579	            return "rebuilt"
   580	        if not 0 <= offset <= size:
   581	            # Outside the log's byte range in either direction. A negative
   582	            # offset is not a seek position to try — it is metadata that
   583	            # cannot be true, exactly as untrustworthy as one past the end.
   584	            self._rebuild(f"offset {offset} outside the log's 0..{size} byte range")
   585	            return "rebuilt"
   586	        if not self._prefix_intact(offset):
   587	            self._rebuild(f"log content at offset {offset} does not match the index")
   588	            return "rebuilt"
   589	
   590	        marked = self._marked_counts()
   591	        if marked is None:
   592	            # Pre-marker store: no baseline exists, so nothing can be judged
   593	            # out of band. Adopt the current row counts as the baseline so
   594	            # every later open has something honest to compare against.
   595	            base_facts, base_ticks = self._row_counts()
   596	            judge = False
   597	        else:
   598	            base_facts, base_ticks = marked
   599	            judge = True
   600	
   601	        if offset == size:
   602	            if judge:
   603	                self._refuse_out_of_band(base_facts, base_ticks)
   604	            else:
   605	                self._index_offset(offset, base_facts, base_ticks)
   606	            return "synced"
   607	
   608	        try:
   609	            facts, ticks = self._tail_forward(offset, base_facts, base_ticks)
   610	        except _RowAlreadyIndexed as collision:
   611	            self._rebuild(str(collision))
   612	            return "rebuilt"
   613	        if judge:
   614	            self._refuse_out_of_band(facts, ticks)
   615	        return "tailed"
