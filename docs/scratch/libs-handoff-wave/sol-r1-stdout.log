   799	    def _tail_forward(
   800	        self, offset: int, base_facts: int, base_ticks: int
   801	    ) -> tuple[int, int]:
   802	        try:
   803	            facts, ticks, end = self._index_lines(offset, base_facts, base_ticks)
   804	        except _RowAlreadyIndexed as collision:
