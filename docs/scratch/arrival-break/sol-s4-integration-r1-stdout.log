   407	                    sig = raw[7] if sig_col else None
   408	
   409	                    obj = {
   410	                        "id": fact_id,
   411	                        "kind": kind,
   412	                        "ts": ts,
   413	                        "origin": origin,
   414	                        "payload": payload,
   415	                    }
   416	                    if sig is not None:
   417	                        obj["signature"] = sig
   418	
   419	                    fault = row_object_fault(
   420	                        obj,
   421	                        t="fact",
   422	                        frame="row",
   423	                        fields=FACT_FIELDS,
   424	                        allowed=_SPEC["fact"].allowed,
   425	                        nullable=FACT_NULLABLE,
   426	                        skip_fields=frozenset({"observer"}),
   427	                    )
