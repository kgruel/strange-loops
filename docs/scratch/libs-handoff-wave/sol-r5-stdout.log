   185	        ("facts", FACT_COLUMNS) if t == "fact" else ("ticks", TICK_COLUMNS)
   186	    )
   187	    columns = _present(conn, table, columns)
   188	    stored = conn.execute(
   189	        f"SELECT {', '.join(columns)} FROM {table} WHERE id = ?", (row[0],)
   190	    ).fetchone()
   191	    if stored is None:
   192	        return False
   193	    return tuple(stored) == _trim(row, len(columns))
