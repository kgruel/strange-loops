   190	def _reject_constant(name: str) -> None:
   191	    """Refuse the non-JSON literals ``NaN``/``Infinity``/``-Infinity``.
   192	
   193	    Serialization uses ``allow_nan=False``, so these can never be emitted;
   194	    admitting them on read would let a corrupt line past the codec gate and
   195	    detonate later inside the JCS commitment hashers (or land a NaN ``ts``
