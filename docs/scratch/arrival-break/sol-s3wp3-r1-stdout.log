  1237	
  1238	def append_entry_for_damage(lineage: str) -> None:
  1239	    """A recognizable extra entry, so a specific line can be damaged.
  1240	
  1241	    Written at a LOWER ordinal than the remembered head, so damaging it leaves
  1242	    the bound exactly where it was: the point is to make the read incomplete
  1243	    without changing what the surviving entries prove. That is also the honest
  1244	    shape of the real failure — a crash costs a line, not a claim.
  1245	    """
  1246	    append_entry(
  1247	        HeadAttestation(
  1248	            head=Head(
  1249	                lineage=lineage, ordinal=0, record_hash="damage-me" + "0" * 55
  1250	            ),
  1251	            kind=Kind.AUDIT,
  1252	            level=Level.FULL,
  1253	            observed_at=1.0,
  1254	            note="damage-me",
  1255	        )
  1256	    )
