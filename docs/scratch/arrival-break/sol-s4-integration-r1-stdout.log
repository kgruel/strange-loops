   122	                observer_census[row.observer] += 1
   123	                era = classify_id_era(row.id)
   124	                id_era_census[era] += 1
   125	        elif isinstance(unit, TickUnit):
   126	            total_rows += 1
   127	            tick_count += 1
   128	
   129	    return SourceInventory(
