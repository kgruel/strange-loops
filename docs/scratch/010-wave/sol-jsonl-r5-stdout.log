    88	def test_residence_allowlist_is_shrink_only():
    89	    """Every allowlist entry must still name a real store-less call site."""
    90	    live = {key for key, _lineno, has_store in _call_sites() if not has_store}
    91	    stale = sorted(key for key in _PACKAGE_RELATIVE if key not in live)
    92	    assert not stale, (
    93	        "stale residence allowlist entries — the call site moved, was renamed, "
    94	        "or already passes store=. Remove them; the allowlist only shrinks:\n  "
    95	        + "\n  ".join(str(k) for k in stale)
