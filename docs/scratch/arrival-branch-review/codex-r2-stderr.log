    after=(root/'target.arrival').read_bytes()
    print('arrival_target_byte_identical=',after==before)
    print('arrival_target_sha256_before=',hashlib.sha256(before).hexdigest())
    print('arrival_target_sha256_after =',hashlib.sha256(after).hexdigest())

