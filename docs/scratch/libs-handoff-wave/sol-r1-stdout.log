   435	def apply_declaration_update(
   436	    preview: DeclarationUpdatePreview,
   437	    *,
   438	    observer: str,
   439	    credentials: CredentialProvider | None = None,
   440	    write_file: Callable[[Path, str | None], None] | None = None,
   441	) -> DeclarationUpdateResult:
   442	    """Apply a planned declaration update — atomic, or a typed state.
   443	
   444	    Sequence (store-first, every prefix recoverable):
   445	
   446	    1. durable intent (sibling ``.vertex.intent``, tempfile+fsync+rename);
   447	    2. the S1b store ceremony — ``absorb_genesis`` or
   448	       ``absorb_edit(expected_head=preview.expected_head)`` — which holds the
   449	       identity check, CAS, sign-final-payload, and append in ONE
   450	       transaction; a stale preview refuses INSIDE that transaction with the
   451	       canonical log byte-identical;
   452	    3. the file-cache replace (``write_file`` injectable; the shipped default
   453	       atomically writes ``preview.proposed_text``);
   454	    4. intent removal.
   455	
   456	    A failure in (2) removes the intent (nothing mutated) and returns
   457	    ``stale``/``refused``. A failure in (3) — including process death,
   458	    which simply never reaches (4) — leaves the intent for
   459	    :func:`recover_declaration_update` and, when the process survives to
   460	    report it, returns the typed ``needs-recovery`` state.
   461	
   462	    ``credentials`` supplies the operation-fresh fact signer
   463	    (:class:`~engine.handle.CredentialProvider`, the ratified S3 shape);
   464	    ``None`` or a ``None`` signer refuses at the store's own signing gate —
   465	    declaration events are the attestation root.
   466	    """
   467	    from .sqlite_store import (
   468	        AmbiguousGenesis,
   469	        GenesisExists,
   470	        NoGenesis,
   471	        ReservedKindViolation,
   472	        StaleDeclarationHead,
   473	        UnsignableEdit,
   474	        UnsignableGenesis,
   475	    )
   476	
   477	    vertex_path = preview.vertex_path
   478	    pending = intent_path_for(vertex_path)
   479	    if pending.exists():
   480	        return DeclarationUpdateResult(
   481	            status="pending-intent",
