package atoms

// Spec is a data contract: input/state fields + fold rules. Mirrors
// atoms/spec.py Spec (the Shape alias). Boundary is out of M0/M1 scope.
type Spec struct {
	Name        string
	About       string
	InputFields []Field
	StateFields []Field
	Folds       []FoldOp

	foldFns []FoldFn // lazily compiled (see compiled)
}

func (s *Spec) compiled() []FoldFn {
	if s.foldFns == nil {
		fns := make([]FoldFn, len(s.Folds))
		for i, f := range s.Folds {
			fns[i] = f.build()
		}
		s.foldFns = fns
	}
	return s.foldFns
}

// InitialState builds the initial state dict from StateFields. Mirrors
// Spec.initial_state().
func (s *Spec) InitialState() map[string]any {
	state := map[string]any{}
	for _, f := range s.StateFields {
		state[f.Name] = initialValue(f.Kind)
	}
	return state
}

// Apply returns new state from old state + payload, deep-copying so fold fns
// (which mutate in place) never touch the input. Pure. Mirrors Spec.apply().
func (s *Spec) Apply(state, payload map[string]any) map[string]any {
	next := deepCopyMap(state)
	for _, fn := range s.compiled() {
		fn(next, payload)
	}
	return next
}

// Replay folds a sequence of payloads into a fresh InitialState, mutating in
// place. Mirrors Spec.replay(). Every fold is applied to every payload — there
// is NO kind routing at this layer (that lives in the engine's Vertex). M1
// certifies parity of this choice, so the fixture must mirror it.
func (s *Spec) Replay(payloads []map[string]any) map[string]any {
	fns := s.compiled()
	state := s.InitialState()
	for _, payload := range payloads {
		for _, fn := range fns {
			fn(state, payload)
		}
	}
	return state
}

// deepCopyMap / deepCopyValue replicate copy.deepcopy over the JSON value
// model so Apply is pure even though fold bodies mutate nested containers.
func deepCopyMap(m map[string]any) map[string]any {
	out := make(map[string]any, len(m))
	for k, v := range m {
		out[k] = deepCopyValue(v)
	}
	return out
}

func deepCopyValue(v any) any {
	switch x := v.(type) {
	case map[string]any:
		return deepCopyMap(x)
	case []any:
		out := make([]any, len(x))
		for i, e := range x {
			out[i] = deepCopyValue(e)
		}
		return out
	default:
		return x // scalars (float64, string, bool, nil) are immutable
	}
}

