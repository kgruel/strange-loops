+        "lineage": lineage, "at": 0.0,
+    }
+)
+head = ledger.append(head, drafts).after
+outcome = run_migration(
+    source, vertex, store_dir=root, signer=signer,
+    transform_rule=identity(), resume_target=target,
+)
+print(f"lineage={lineage}")
