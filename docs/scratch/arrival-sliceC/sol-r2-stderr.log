    84	    def test_the_fixture_discriminates_arrival_from_event_time(self, tmp_path, monkeypatch):
    85	        """Guard on the pin below: ts order must NOT equal arrival order."""
    86	        _, db = _single_member_vertex(tmp_path, monkeypatch)
