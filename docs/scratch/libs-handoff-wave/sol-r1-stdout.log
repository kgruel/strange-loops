   249	        if field in _NUMERIC:
   250	            # bool is an int subclass — reject it explicitly.
   251	            if isinstance(value, bool) or not isinstance(value, (int, float)):
   252	                raise JsonlCodecError(
   253	                    f"{t} field {field!r} must be a number, got "
   254	                    f"{type(value).__name__}"
   255	                )
