   679	    def _last_newline_before(self, fh, end: int) -> int:
   680	        """Byte offset just past the last ``\\n`` strictly before ``end``.
   681	
   682	        Scans backwards in chunks — never loads the whole log, and never
   683	        gives up as a function of line length (a single 70KB payload must
   684	        not silently disable the integrity check). 0 when there is none.
