   324	    return _validated(result, f"edit_vertex_kind({kind!r})")
   325	
   326	
   327	def remove_vertex_kind(text: str, kind: str) -> str:
   328	    """Remove a kind's definition from vertex text; returns the new text.
   329	
   330	    Not supported when the whole ``loops`` block is a single line. Refuses
   331	    (via post-validation) when removal would leave an invalid vertex, e.g.
   332	    removing the last kind of a vertex with no other sources.
   333	    """
   334	    _validate_kind_name(kind)
   335	    try:
   336	        result = kdl_remove_child(text, ["loops"], kind)
   337	    except ValueError as exc:
   338	        raise ValueError(
   339	            f"kind {kind!r} not found in loops block (single-line loops "
   340	            "blocks cannot be mutated in place — expand across lines first): "
   341	            f"{exc}"
   342	        ) from exc
   343	    return _validated(result, f"remove_vertex_kind({kind!r})")

