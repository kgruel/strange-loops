+        for name in names:
+            if any(name == bad or name.startswith(bad + ".") for bad in forbidden_imports):
+                bad_imports.append(f"{path.name}:{node.lineno}:{name}")
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            if node.func.attr in forbidden_calls:
+                bad_calls.append(f"{path.name}:{node.lineno}:{node.func.attr}")
+
+print(f"forbidden_runtime_imports={bad_imports!r}")
+print(f"direct_ArrivalLog_imports={arrival_log_imports!r}")
+print(f"privileged_or_repair_calls={bad_calls!r}")
+if bad_imports or arrival_log_imports or bad_calls:
+    print("FAIL: migration quarantine/admission-only structure regressed")
+    raise SystemExit(1)
+print("PASS: quarantine and admission-only structure hold")
