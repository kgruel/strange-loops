   393	def generate_lens_vectors() -> None:
   394	    LENS_DIR.mkdir(parents=True, exist_ok=True)
   395	
   396	    for case in LENS_CASES:
   397	        with tempfile.TemporaryDirectory() as tmp_dir:
   398	            parent = build_combine_vertex(Path(tmp_dir), case)
   399	            rows = vertex_facts(parent, 0.0, float("inf"), kind=case.kind)
   400	
   401	        expected = _expected_for(case, rows)
   402	
   403	        input_block: dict[str, Any] = {
   404	            "kind": case.kind,
   405	            "members": {
   406	                label: [[fid, fact_to_dict(f)] for fid, f in facts]
   407	                for label, facts in case.members.items()
   408	            },
   409	        }
   410	        if case.ordering != DEFAULT_ORDERING:
   411	            input_block["ordering"] = ordering_to_wire(case.ordering)
   412	
   413	        vector = {
   414	            "name": case.name,
   415	            "description": case.description,
   416	            "input": input_block,
   417	            "expected": expected,
   418	        }
   419	
   420	        out_path = LENS_DIR / f"{case.name}.json"
     1	"""Conformance runner for the declared read lens.
     2	
     3	Loads all vectors dynamically from spec/conformance/vectors/lens/*.json.
     4	
     5	Fold replay is receipt order (rowid ASC), which is per-store. Reads across a
     6	combine vertex's member stores have no receipt axis, so they read under a
     7	DECLARED key: `input.ordering`, defaulting to `{"by_key": "ts"}` when absent.
     8	
     9	- The default ts family runs through the production combined read
    10	  (`vertex_facts`), whose (ts ASC, id ASC) ordering IS that declaration. It
    11	  is the last place ts tie-breaking and sub-millisecond ts precision still
    12	  carry ordering force.
    13	- Declared non-default keys totalize the combined read's records through the
    14	  atoms primitive, which owns the one `(K(record), id ASC)` definition.
    15	
    16	Field resolution is `atoms.resolve_key_field` (`ts`/`id` from the envelope,
    17	everything else from the payload) — the SAME function the generator and
    18	`StoreReader.ordered` bind, so the family rule is shared rather than restated
    19	per surface. `lens-by-key-payload-seq`, whose payload-key order disagrees with
    20	both its ts order and its id order, still catches a reader that resolves keys
    21	its own way.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import json
    27	from pathlib import Path
    28	from typing import Any
    29	
    30	import pytest
    31	from atoms import Fact
    32	from atoms.ordering import ByKey, OrderingError, resolve_key_field, totalize
    33	from engine.sqlite_store import SqliteStore
    34	from engine.vertex_reader import vertex_facts
    35	
    36	REPO_ROOT = Path(__file__).resolve().parents[3]
    37	LENS_VECTORS_DIR = REPO_ROOT / "spec" / "conformance" / "vectors" / "lens"
    38	
    39	_MEMBER_KDL = (
    40	    'name "{label}"\n'
    41	    'store "{store}"\n'
    42	    'loops {{\n  {kind} {{\n    fold {{\n      n "inc"\n    }}\n  }}\n}}\n'
    43	)
    44	_LOOPS_KDL = 'loops {{\n  {kind} {{\n    fold {{\n      n "inc"\n    }}\n  }}\n}}\n'
    45	
    46	
    47	#: The ordering a vector is read under when `input.ordering` is absent.
    48	DEFAULT_ORDERING = ByKey("ts")
    49	
    50	
    51	def _decode_ordering(wire: dict[str, Any] | None) -> ByKey:
    52	    if wire is None:
    53	        return DEFAULT_ORDERING
    54	    assert "by_key" in wire, f"unsupported lens ordering on the wire: {wire!r}"
    55	    return ByKey(wire["by_key"])
    56	
    57	
    58	def _totalize_rows(rows: list[dict[str, Any]], ordering: ByKey) -> list[dict[str, Any]]:
    59	    return totalize(rows, ordering, get_field=resolve_key_field, get_id=lambda r: r["id"])
    60	
    61	
    62	def _load_vectors(vectors_dir: Path) -> list[Path]:
    63	    return sorted(vectors_dir.glob("*.json"))
    64	
    65	
    66	def _decode_fact(data: dict[str, Any]) -> Fact:
    67	    return Fact(
    68	        kind=data["kind"],
    69	        ts=data["ts"],
    70	        payload=data["payload"],
    71	        observer=data["observer"],
    72	        origin=data.get("origin", ""),
    73	    )
    74	
    75	
    76	def _build_combine_vertex(root: Path, kind: str, members: dict[str, Any]) -> Path:
    77	    member_paths = []
    78	    for label, facts in members.items():
    79	        store_path = root / f"{label}.db"
    80	        vertex_path = root / f"{label}.vertex"
    81	        vertex_path.write_text(
    82	            _MEMBER_KDL.format(label=label, store=store_path, kind=kind)
    83	        )
    84	        store = SqliteStore(
    85	            path=store_path,
    86	            serialize=lambda f: f.to_dict() if isinstance(f, Fact) else f,
    87	            deserialize=Fact.from_dict,
    88	        )
    89	        for fid, fact_dict in facts:
    90	            store.append(_decode_fact(fact_dict), id_override=fid)
    91	        store.close()
    92	        member_paths.append(vertex_path)
    93	
    94	    parent = root / "parent.vertex"
    95	    refs = "\n".join(f'  vertex "{p}"' for p in member_paths)
    96	    parent.write_text(
    97	        f'name "parent"\ncombine {{\n{refs}\n}}\n' + _LOOPS_KDL.format(kind=kind)
    98	    )
    99	    return parent
   100	
