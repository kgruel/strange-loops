    73	class AggregateAdmissionUnsupported(AdmissionError):
    74	    """Admission policy cannot be resolved against an aggregate vertex.
    75	
    76	    Combine/discover aggregates are read-path compositions over member
    77	    stores; writes target a member directly, and each member's own
    78	    declaration is the admission authority. Resolving a grant against the
    79	    aggregate would invent a policy no member declared.
    80	    """
    81	
    82	    def __init__(self, vertex: str) -> None:
    83	        super().__init__(
    84	            f"vertex {vertex!r} is a combine/discover aggregate — admission "
    85	            f"policy resolves against a member declaration, not the "
    86	            f"aggregate. Write to the member vertex directly."
    87	        )
    88	        self.vertex = vertex
    89	
