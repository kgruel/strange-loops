   615	        protocol: int | None = None,
   616	    ) -> dict[str, Any]:
   617	        """Open the store's declaration lineage — the atomic genesis primitive.
   618	
   619	        The lineage-opening ceremony's write half (SPEC §9.2 era rule),
   620	        performed as ONE ``BEGIN IMMEDIATE`` transaction so the identity check,
   621	        the era pins, and the append are indivisible: a concurrent emit cannot
   622	        falsify a pin between read and write, and two concurrent absorbs cannot
   623	        both mint a genesis (the second blocks on the write lock, then sees the
   624	        first's row and refuses).
   625	
   626	        Steps, all inside the transaction:
   627	
   628	        1. Refuse (``GenesisExists``) if the store's OWN lineage is already
   629	           open: the ``store_meta.own_lineage`` marker exists, or (pre-marker
   630	           compat) exactly one ``_decl.genesis`` row exists — that row is
   631	           adopted as self and the marker backfilled before refusing. Foreign
   632	           genesis rows (marker present, ids differ) do NOT block: merge
   633	           legitimately carries them as inert citizens (§9.2 Lineage), and a
   634	           store that received one must still be able to mint its own
   635	           identity. No marker + several genesis rows refuses as ambiguous.
   636	        2. Read the era pins — chain head (latest chained tick's row hash) and
   637	           fact cursor (newest fact by WITNESS order / rowid) — so
   638	           "everything before me predates historization" is verifiable.
   639	        3. Build the whole payload (``documents`` + ``protocol`` + pins), sign
   640	           its CONTENT commitment under ``observer`` via ``fact_signer``, and
   641	           refuse (``UnsignableGenesis``, rollback) if no signature is
   642	           produced. The signed commitment is over the ACTUAL final payload,
   643	           never a throwaway probe — genesis is the attestation root.
   644	        4. Append the ``_decl.genesis`` row, stamp ``store_meta.own_lineage``
   645	           with its id (the store-local identity marker — merge copies facts,
   646	           never meta, so identity cannot arrive from outside), and commit.
   647	           The genesis row's own id IS the lineage id (§9.2), returned in the
   648	           receipt.
   649	
   650	        This is protocol surface the Go conformance oracle mirrors: the payload
   651	        shape (``protocol``, ``documents``, ``chain_head``, ``fact_cursor``),
   652	        the witness-order cursor, and the sign-final-payload rule are the
   653	        contract. ``documents`` are the subject-scoped declaration documents
   654	        (from ``lang.document.vertex_to_documents``); this method stamps the
   655	        protocol and pins around them.
   656	
   657	        Returns a receipt dict: ``{lineage, protocol, documents, chain_head,
   658	        fact_cursor, observer, signed}``.
   659	        """
   660	        from lang.document import DECL_GENESIS, DECLARATION_PROTOCOL_VERSION
   661	
   662	        if protocol is None:
   663	            protocol = DECLARATION_PROTOCOL_VERSION
   664	
   665	        # Prepare schema OUTSIDE the transaction (these commit): the genesis
   666	        # write and the chain-head read need the signature and chain columns
   667	        # present. Safe pre-work — they mutate no facts.
   668	        self._ensure_sync()
   669	        self._ensure_fact_signature_column()
   670	        self._ensure_chain_columns()
   671	        self._ensure_meta_table()
   672	
   673	        conn = self._conn
   674	        prev_iso = conn.isolation_level
   675	        conn.isolation_level = None  # autocommit — explicit transaction control
   676	        try:
   677	            conn.execute("BEGIN IMMEDIATE")
   678	            try:
   679	                own = self._own_lineage_in_txn(conn)
   680	                if own is not None:
   681	                    raise GenesisExists(
   682	                        "the store's own lineage is already open "
   683	                        f"(own_lineage {own}) — re-absorb/edit is a later "
   684	                        "ceremony (no --force)"
   685	                    )
   686	
   687	                chain_head = self.current_chain_head()
   688	                frow = conn.execute(
   689	                    "SELECT id FROM facts ORDER BY rowid DESC LIMIT 1"
   690	                ).fetchone()
   691	                fact_cursor = frow[0] if frow else None
   692	
   693	                payload = {
   694	                    "protocol": protocol,
   695	                    "documents": list(documents),
   696	                    "chain_head": chain_head,
   697	                    "fact_cursor": fact_cursor,
   698	                }
   699	                ts = datetime.now(_UTC).timestamp()
   700	                lineage_id = gen_id()
   701	                payload_text = json.dumps(payload)
   702	                signature = (
   703	                    fact_signer(
   704	                        observer,
   705	                        _fact_commitment_hash(
   706	                            DECL_GENESIS, ts, observer, origin, payload_text
   707	                        ),
   708	                    )
   709	                    if fact_signer is not None
   710	                    else None
