   204	def edit_vertex_store_clause(
   205	    vertex_path: Path | str,
   206	    target_location: str,
   207	    *,
   208	    backend: str = "file",
   209	) -> None:
   210	    """Surgically edit the store clause in a .vertex file with verification-by-re-parse (§H.1).
   211	
   212	    Replaces the positional location and sets backend="file", writes to a temp file
   213	    in the same directory, fsyncs, and atomically replaces the .vertex file.
   214	
   215	    Args:
   216	        vertex_path: Path to the .vertex file to edit.
   217	        target_location: Formatted location string to put in the store clause.
   218	        backend: Backend name (defaults to 'file').
   219	
   220	    Raises:
   221	        PublishPreconditionRefused: If verification-by-re-parse fails or store clause
   222	            cannot be unambiguously located.
   223	        FileNotFoundError: If vertex_path does not exist.
   224	    """
   225	    v_path = Path(vertex_path).resolve()
   226	    if not v_path.exists():
   227	        raise FileNotFoundError(f"Vertex file not found: {v_path}")
   228	
   229	    original_text = v_path.read_text(encoding="utf-8")
   230	    pre_ast = parse_vertex(original_text, v_path)
   231	
   232	    try:
   233	        store_span = effective_store_clause(original_text, v_path)
   234	    except Exception as exc:
   235	        raise PublishPreconditionRefused(
   236	            f"Verification-by-re-parse failed: .vertex could not be parsed: {exc}. "
   237	            "Advisory: check .vertex file syntax.",
   238	            condition="vertex_reparse",
   239	        ) from exc
   240	
   241	    if store_span.count > 1:
   242	        raise PublishPreconditionRefused(
   243	            "the store clause cannot be unambiguously located for a surgical edit: "
   244	            f"found {store_span.count} duplicate store nodes",
   245	            condition="vertex_store_duplicate_nodes",
   246	        )
   247	
   248	    if store_span.count == 0 or store_span.span is None:
   249	        raise PublishPreconditionRefused(
   250	            "the store clause cannot be unambiguously located for a surgical edit: "
   251	            "matched store line does not correspond to an effective store node",
   252	            condition="vertex_store_ineffective",
   253	        )
   254	
   255	    start, end = store_span.span
   256	    new_store_clause = f'store "{target_location}" backend="{backend}"'
   257	    edited_text = original_text[:start] + new_store_clause + original_text[end:]
   258	
   259	    # Verification-by-re-parse
   260	    try:
   261	        post_ast = parse_vertex(edited_text, v_path)
   262	    except Exception as exc:
   263	        raise PublishPreconditionRefused(
   264	            f"Verification-by-re-parse failed: edited .vertex could not be parsed: {exc}. "
   265	            "Advisory: check .vertex file syntax.",
   266	            condition="vertex_reparse",
   267	        ) from exc
   268	
   269	    if post_ast.store != Path(target_location):
   270	        raise PublishPreconditionRefused(
   271	            f"Verification-by-re-parse failed: expected store={Path(target_location)!r}, got {post_ast.store!r}. "
   272	            "Advisory: check store clause location property.",
   273	            condition="vertex_store_location",
   274	        )
   275	
   276	    if post_ast.store_backend != BackendDecl(name=backend):
   277	        raise PublishPreconditionRefused(
   278	            f"Verification-by-re-parse failed: expected store_backend={BackendDecl(name=backend)!r}, got {post_ast.store_backend!r}. "
   279	            "Advisory: check store clause backend property.",
   280	            condition="vertex_store_backend",
   281	        )
   282	
   283	    # Assert every non-store field is untouched (F7(a) via VertexFile.__match_args__)
   284	    ignored = {"store", "store_backend", "path"}
   285	    field_mismatches: list[str] = []
   286	    for field in VertexFile.__match_args__:
   287	        if field in ignored:
   288	            continue
   289	        if getattr(post_ast, field) != getattr(pre_ast, field):
   290	            field_mismatches.append(
   291	                f"{field} ({getattr(pre_ast, field)!r} != {getattr(post_ast, field)!r})"
   292	            )
   293	
   294	    if field_mismatches:
   295	        raise PublishPreconditionRefused(
   296	            f"Verification-by-re-parse failed: non-store fields modified during surgical edit: {', '.join(field_mismatches)}. "
   297	            "Advisory: verify .vertex file format.",
   298	            condition="vertex_fields_equality",
   299	        )
   300	
   301	    # Atomic write via temp file in the same directory + fsync + os.replace
   302	    v_dir = v_path.parent
   303	    temp_path = v_dir / f".tmp_{v_path.name}_{uuid4().hex}"
   304	    try:
   305	        with temp_path.open("w", encoding="utf-8") as f:
   306	            f.write(edited_text)
   307	            f.flush()
   308	            os.fsync(f.fileno())
   309	        os.replace(temp_path, v_path)
   310	    finally:
   311	        if temp_path.exists():
   312	            try:
   313	                temp_path.unlink()
   314	            except OSError:
   315	                pass
