   739	def _combined_summary(
   740	    ast: Any, vertex_path: Path, *, include_internal: bool = False
   741	) -> dict:
   742	    """Merged summary across multiple stores (combinatorial vertex_summary).
   743	
   744	    Excludes the reserved ``_decl.*`` namespace by default (SPEC §9.4),
   745	    same rule and same ``GLOB`` (not ``LIKE``) as the single-store path in
   746	    :meth:`StoreReader.fact_kind_stats`.
   747	    """
   748	    store_paths = _resolve_stores(ast, vertex_path)
   749	    if not store_paths:
   750	        return {"facts": {"total": 0, "kinds": {}}, "ticks": {"total": 0, "names": {}}}
   751	
   752	    conn, aliases = _open_combined(store_paths)
   753	    try:
   754	        # Aggregate fact counts per kind
   755	        kind_where = "" if include_internal else "WHERE kind NOT GLOB '_decl.*'"
   756	        selects_facts = [
   757	            f"SELECT kind, COUNT(*), MIN(ts), MAX(ts) "
   758	            f"FROM {'[' + a + '].' if a != 'main' else ''}facts {kind_where} GROUP BY kind"
   759	            for a in aliases
   760	        ]
   761	        sql_facts = " UNION ALL ".join(selects_facts)
   762	        rows = conn.execute(sql_facts).fetchall()
   763	
   764	        # Merge per-kind stats (counts add, times take min/max)
   765	        kind_stats: dict[str, dict] = {}
   766	        total_facts = 0
   767	        for kind, count, min_ts, max_ts in rows:
   768	            total_facts += count
   769	            if kind in kind_stats:
   770	                existing = kind_stats[kind]
   771	                existing["count"] += count
   772	                existing["earliest"] = min(existing["earliest"], datetime.fromtimestamp(min_ts, tz=timezone.utc))
   773	                existing["latest"] = max(existing["latest"], datetime.fromtimestamp(max_ts, tz=timezone.utc))
   774	            else:
   775	                kind_stats[kind] = {
   776	                    "count": count,
   777	                    "earliest": datetime.fromtimestamp(min_ts, tz=timezone.utc),
   778	                    "latest": datetime.fromtimestamp(max_ts, tz=timezone.utc),
   779	                }
   780	
   781	        # Aggregate tick counts per name
   782	        selects_ticks = [
   783	            f"SELECT name, COUNT(*), MIN(ts), MAX(ts) "
   784	            f"FROM {'[' + a + '].' if a != 'main' else ''}ticks GROUP BY name"
   785	            for a in aliases
   786	        ]
   787	        sql_ticks = " UNION ALL ".join(selects_ticks)
   788	        tick_rows = conn.execute(sql_ticks).fetchall()
   789	
   790	        name_stats: dict[str, dict] = {}
   791	        total_ticks = 0
   792	        for tick_name, count, min_ts, max_ts in tick_rows:
   793	            total_ticks += count
   794	            if tick_name in name_stats:
   795	                existing = name_stats[tick_name]
   796	                existing["count"] += count
   797	                existing["earliest"] = min(existing["earliest"], datetime.fromtimestamp(min_ts, tz=timezone.utc))
   798	                existing["latest"] = max(existing["latest"], datetime.fromtimestamp(max_ts, tz=timezone.utc))
   799	            else:
   800	                name_stats[tick_name] = {
   801	                    "count": count,
   802	                    "earliest": datetime.fromtimestamp(min_ts, tz=timezone.utc),
   803	                    "latest": datetime.fromtimestamp(max_ts, tz=timezone.utc),
   804	                }
   805	
   806	        return {
   807	            "facts": {"total": total_facts, "kinds": kind_stats},
   808	            "ticks": {"total": total_ticks, "names": name_stats},
   809	        }
   810	    finally:
   811	        conn.close()
   812	
   813	
   814	def _combined_search(
   815	    ast: Any,
   816	    vertex_path: Path,
   817	    query: str,
   818	    *,
   819	    kind: str | None = None,
   820	    kinds: Iterable[str] | None = None,
   821	    since: float | None = None,
   822	    until: float | None = None,
   823	    limit: int = 100,
   824	    observer: str | None = None,
   825	    as_of: float | None = None,
   826	) -> list[dict]:
   827	    """Search across combined children by delegating vertex_search to each child.
   828	
   829	    ``as_of`` is forwarded to each child (SPEC §9.3). The AGGREGATE's own
   830	    declaration resolves head (its member-set history is not historized — a
   831	    build-plan non-goal), but each child is a single store and MUST honor the
   832	    cursor for its own ``search`` fields — ``as_of`` is a shared wall-clock
   833	    ``ts``, so "as of T" resolves each child's declaration at T.
   834	
   835	    ``kinds`` is forwarded to each child's own ``vertex_search`` call
   836	    unchanged (S2 sol P2) — each child's SQL-level query is restricted to
   837	    the trustworthy kind set BEFORE that child's own ``limit`` applies, so a
   838	    stale kind in one child can't crowd out a fresh kind's matches within
