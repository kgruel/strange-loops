   141	def _canonical_bytes(obj: object) -> bytes:
   142	    """Canonical encoding for commitment hashing: JCS, RFC 8785.
   143	
   144	    Upgraded from implementation-local json.dumps 2026-06-12
   145	    (decision design/attestation-canonicalization-jcs): the Go conformance
   146	    oracle is the federation-facing consumer the original docstring named
   147	    as the upgrade trigger, and cross-implementation hash divergence
   148	    renders as a false tamper alarm. Pre-JCS chains were re-anchored at
   149	    the swap (sl store reanchor), not grandfathered — SPEC §8.1.
   150	
   151	    Stored payload TEXT is still embedded verbatim as a string value, so
   152	    hashes detect byte-level tampering without re-serialization concerns
   153	    leaking in from payload content.
   154	    """
   155	    return rfc8785.dumps(obj)
