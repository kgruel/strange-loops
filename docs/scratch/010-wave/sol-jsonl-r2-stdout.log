   245	
   246	def deserialize_row(line: str) -> tuple[str, tuple]:
   247	    """Decode any line, dispatching on ``"t"``. Returns ``(t, row)`` with the
   248	    row at full arity (7 fact fields / 11 tick fields, signature last)."""
   249	    obj = _load(line)
   250	    t = obj.get("t")
   251	    spec = _SPEC.get(t) if isinstance(t, str) else None
   252	    if spec is None:
   253	        raise JsonlCodecError(f"unknown record discriminator t={t!r}")
   254	    _validate(obj, spec)
   255	    return spec.t, (*(obj[f] for f in spec.fields), obj.get(_SIGNATURE))
     1	"""residence — where a vertex's store lives, and which file is authoritative.
     2	
     3	A vertex declares one ``store`` locator. That locator names the **canonical
     4	artifact**, and its extension is the mode switch:
     5	
     6	===============  ==========================================================
     7	``.jsonl``       JSONL-canonical (design/architecture/jsonl-canonical-store).
     8	                 The log is the store; the sqlite index is derived and
     9	                 rebuildable, and lives at the sibling ``.db`` path.
    10	``.db``          sqlite-canonical (the status quo). No log.
    11	``.sqlite``
    12	===============  ==========================================================
    13	
    14	Extension-as-switch is not new here: :func:`engine.compiler.materialize_vertex`
    15	already dispatched ``.db``/``.sqlite`` to ``SqliteStore`` and everything else
    16	to the flat ``EventStore``. This module states the rule once and gives every
    17	caller the paths it can want:
    18	
    19	- :func:`canonical_store_path` — the declared artifact, absolute.
    20	- :func:`index_path_for` — the sqlite file to *connect* to.
    21	- :func:`log_path_for` — its inverse, the log beside a store db.
    22	- :func:`resolve_store_path` — declared → index composed, the read path's
    23	  workhorse.
    24	
    25	Both directions of the ``.db``↔``.jsonl`` sibling bijection live here: a
    26	naming rule stated in two modules is a naming rule that can disagree.
    27	
    28	Why the read path resolves to the index and not the canonical file: reads are
    29	sqlite reads (``StoreReader``, FTS, ``since``/``between``, direct
    30	``sqlite3.connect``) and stay exactly as they are under the flip. Only the
    31	*write* path cares which file is authoritative, and it asks with
    32	:func:`is_jsonl_canonical`. The three-line "resolve relative to the vertex
    33	file" idiom this replaces was duplicated at ~25 call sites; collapsing it is
    34	what makes one translation point possible at all.
    35	
    36	Pure functions over paths — no I/O, no store construction. Materializing a
    37	missing index is :func:`engine.jsonl_store.ensure_index`, which needs I/O and
    38	therefore does not live here.
    39	"""
    40	
    41	from __future__ import annotations
    42	
    43	from pathlib import Path
    44	
    45	__all__ = [
    46	    "CANONICAL_LOG_SUFFIX",
    47	    "SQLITE_SUFFIXES",
    48	    "canonical_store_path",
    49	    "index_path_for",
    50	    "is_jsonl_canonical",
    51	    "log_path_for",
    52	    "resolve_store_path",
    53	]
    54	
    55	CANONICAL_LOG_SUFFIX = ".jsonl"
    56	SQLITE_SUFFIXES = (".db", ".sqlite")
    57	
    58	
    59	def is_jsonl_canonical(declared: Path | str) -> bool:
    60	    """True when this store locator names a JSONL-canonical log."""
    61	    return Path(declared).suffix == CANONICAL_LOG_SUFFIX
    62	
    63	
    64	def canonical_store_path(declared: Path | str, vertex_path: Path | None) -> Path:
    65	    """The declared artifact as an absolute path.
    66	
    67	    Relative locators resolve against the *vertex file's* directory, never
    68	    the process cwd — a vertex is portable, a cwd is not.
    69	    """
    70	    path = Path(declared)
    71	    if not path.is_absolute() and vertex_path is not None:
    72	        path = (Path(vertex_path).parent / path).resolve()
    73	    return path
    74	
    75	
    76	def index_path_for(canonical: Path | str) -> Path:
    77	    """The sqlite file to connect to for a given canonical locator.
    78	
    79	    JSONL-canonical → the sibling ``.db``; sqlite-canonical → itself.
    80	    Idempotent: feeding an index path back through returns it unchanged.
    81	    """
    82	    path = Path(canonical)
    83	    if is_jsonl_canonical(path):
    84	        return path.with_suffix(".db")
    85	    return path
    86	
    87	
    88	def log_path_for(db_path: Path | str) -> Path:
    89	    """The canonical log beside a store db: ``<name>.db`` → ``<name>.jsonl``.
    90	
    91	    The inverse of :func:`index_path_for`, and equally idempotent.
    92	    """
    93	    return Path(db_path).with_suffix(CANONICAL_LOG_SUFFIX)
    94	
    95	
    96	def resolve_store_path(declared: Path | str, vertex_path: Path | None) -> Path:
    97	    """Declared locator → absolute sqlite path to read from.
    98	
    99	    The single translation point for the read path. Does not check
   100	    existence and does not materialize a missing index; callers that must
   101	    tolerate a fresh clone go through :func:`engine.jsonl_store.ensure_index`.
   102	    """
   103	    return index_path_for(canonical_store_path(declared, vertex_path))

