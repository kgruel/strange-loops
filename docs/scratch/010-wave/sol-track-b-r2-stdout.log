package conform

import (
	"testing"

	"github.com/kaygee/loops-go/atoms"
	"github.com/kaygee/loops-go/store"
)

// Same-ts id tie-break (SPEC §4.6, resolved by §6.2) — vector family 3.
//
// §4.6 pre-authorized this vector: "The conformance corpus contains no ties
// yet, so the differential oracle does not catch it; a tie vector should be
// added once §6.2 is frozen." §6.2 froze at d865954.
//
// The fixture is a store, not a fold vector, because the id-less fold-vector
// schema applies payloads in ARRAY order — ordering is an input there, never
// something under test (§6.2's own note says as much). A .db carries ids, and
// store.ReadFacts's `ORDER BY ts, id` is the code this exercises.
//
// tie.db is built so witness order (rowid) and event order (ts, id) disagree
// on every row: four facts share one ts with ids running against insertion
// order, and a fifth sits at a LOWER ts with the HIGHEST id and the LAST rowid
// (so ts is pinned as primary, id as the tie-break, not the sort key).
//
// The fixture ships both answers — `expected` for (ts, id) replay and
// `expected_rowid_order` for rowid replay — and this test asserts BOTH
// directions. The negative control matters: without it the vector could decay
// into a tautology if the fixture were ever regenerated from an order-blind
// table.
//
// Regenerate (in the loops repo): uv run python tools/gen_tie_fixture.py --loops-go .
type tieFixture struct {
	PythonCommit string   `json:"python_commit"`
	DB           string   `json:"db"`
	Kind         string   `json:"kind"`
	RowidOrder   []string `json:"rowid_order"`
	EventOrder   []string `json:"event_order"`
	Folds        []any    `json:"folds"`
	StateFields  []struct {
		Name string `json:"name"`
		Kind string `json:"kind"`
	} `json:"state_fields"`
	Expected           map[string]any `json:"expected"`
	ExpectedRowidOrder map[string]any `json:"expected_rowid_order"`
}

func loadTieFixture(t *testing.T) (tieFixture, map[string]any) {
	t.Helper()
	var fx tieFixture
	loadJSON(t, "../stores/tie.expected.json", &fx)

	dbPath := vectorsDir(t) + "/../stores/" + fx.DB
	payloads, err := store.Payloads(dbPath)
	if err != nil {
		t.Fatalf("read store %s: %v (regenerate: uv run python tools/gen_tie_fixture.py in the loops repo)", dbPath, err)
	}
	if len(payloads) != len(fx.RowidOrder) {
		t.Fatalf("read %d facts, fixture declares %d", len(payloads), len(fx.RowidOrder))
	}
	t.Logf("tie vector: %d facts @ python %.9s; rowid order %v, event order %v",
		len(payloads), fx.PythonCommit, fx.RowidOrder, fx.EventOrder)

	folds, err := atoms.DecodeFolds(fx.Folds)
	if err != nil {
		t.Fatalf("decode folds: %v", err)
	}
	fields := make([]atoms.Field, len(fx.StateFields))
	for i, sf := range fx.StateFields {
		fields[i] = atoms.Field{Name: sf.Name, Kind: sf.Kind}
	}
	spec := &atoms.Spec{Folds: folds, StateFields: fields}
	return fx, spec.Replay(payloads)
}

// TestSameTSIDTieBreak is the replay-order half: the order-sensitive folds
// (Upsert last-write-wins, Collect, Window) must reproduce Python's (ts, id)
// replay and must NOT reproduce the rowid replay. An implementation reading
// ORDER BY rowid, or sorting unstably over the tied ts, fails every one.
func TestSameTSIDTieBreak(t *testing.T) {
	fx, got := loadTieFixture(t)

	// `top` is asserted separately — see TestSameTSIDTieBreakTopNEviction.
	for _, facet := range []string{"entities", "log", "tags"} {
		t.Run(facet, func(t *testing.T) {
			if d := Diff(got[facet], fx.Expected[facet]); d != "" {
				t.Fatalf("(ts, id) replay divergence on %q:\n%s", facet, d)
			}
			if SemanticEqual(got[facet], fx.ExpectedRowidOrder[facet]) {
				t.Fatalf("%q matches the ROWID-order answer — either the reader "+
					"replayed by rowid, or the fixture stopped discriminating the "+
					"two axes (regenerate it)", facet)
			}
		})
	}
}

// TestSameTSIDTieBreakTopNEviction is the §4.6 half, and it is the one this
// implementation cannot satisfy today.
//
// §4.6: "An implementation MUST evict equal-`by` items by `(ts, id)` arrival
// order (equivalently: preserve `(ts, id)` insertion order in the target and
// break ties with a stable sort)." Python's target is an insertion-ordered
// dict under a stable sort, so it does this for free. Go's is a
// `map[string]any` with no order, and `atoms.TopN` tie-breaks by key string
// instead — the divergence FINDINGS §3 logged as a concrete fix-both.
//
// The gap is NOT a straightforward code fix, which is why this vector stops
// here rather than turning the suite red. Arrival order is recoverable from
// neither side of what a fold sees: the target map is unordered, and the
// payload carries `_ts` but no `id` (store.ReadFacts injects the first and
// drops the second). For items tied on BOTH `by` and `ts` — exactly this
// fixture — no content-derived rule can order them. Closing it takes a
// protocol decision: carry the id into the fold layer, or make a TopN target
// an ordered map (which JSON's value model says objects are not). That is a
// design-gate item, tracked in the loops repo at
// docs/dev/loops-go-protocol-queue.md.
//
// So this asserts what IS true today, and RETIRES ITSELF: if Go ever starts
// agreeing with Python here, the skip becomes a failure telling you to promote
// the facet into TestSameTSIDTieBreak. A muted test that cannot notice its own
// premise expiring is the thing FINDINGS I1 complains about.
func TestSameTSIDTieBreakTopNEviction(t *testing.T) {
	fx, got := loadTieFixture(t)

	// True regardless: whatever Go keeps, it is not what a rowid replay keeps.
	if SemanticEqual(got["top"], fx.ExpectedRowidOrder["top"]) {
		t.Fatalf("`top` matches the ROWID-order answer:\n%s",
			Diff(got["top"], fx.ExpectedRowidOrder["top"]))
	}

	if SemanticEqual(got["top"], fx.Expected["top"]) {
		t.Fatal("Go's TopN now agrees with Python on the §4.6 equal-`by` " +
			"tie-break. The gap closed: move `top` into TestSameTSIDTieBreak's " +
			"facet list, delete this test, and retire FINDINGS §3.")
	}
	t.Skipf("KNOWN GAP (SPEC §4.6 / FINDINGS §3): Go evicts equal-`by` items by "+
		"key string, Python by (ts, id) arrival order.\n  want (ts,id): %v\n  got  (Go)  : %v",
		fx.Expected["top"], got["top"])
}
