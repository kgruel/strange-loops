  1547	    def _window_hash(self, start: str, end: str) -> str:
  1548	        """Hash the fact window (start, end] in witness order (rowid).
  1549	
  1550	        Cursors are fact ids; ordering and membership are append order — see
  1551	        the ORDERING AUTHORITY note in the chain comment block. Id order is
  1552	        not append order in mixed-id-era stores, and a late-arriving fact
  1553	        with an old event-time id must not retroactively enter a sealed
  1554	        window.
  1555	        """
  1556	        h = hashlib.sha256()
  1557	        lo = self._cursor_rowid(start)
  1558	        hi = self._cursor_rowid(end)
  1559	        if lo is None or hi is None:
  1560	            return h.hexdigest()  # unresolvable cursor → empty commitment
  1561	        # Era-aware row hash: include the signature column when it exists.
  1562	        # Unsigned rows hash identically either way (the signature key is
  1563	        # only added when non-NULL), so pre-delta-3 sealed windows verify
  1564	        # unchanged; signed facts are strip-detectable once sealed.
  1565	        cols = "id, kind, ts, observer, origin, payload"
  1566	        if self._facts_have_signature_column():
  1567	            cols += ", signature"
  1568	        for row in self._conn.execute(
  1569	            f"SELECT {cols} FROM facts "
  1570	            "WHERE rowid > ? AND rowid <= ? ORDER BY rowid",
  1571	            (lo, hi),
  1572	        ):
  1573	            h.update(_fact_row_hash(row).encode())
  1574	        return h.hexdigest()
