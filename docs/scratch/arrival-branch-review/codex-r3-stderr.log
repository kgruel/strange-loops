    97	
    98	# The kind that introduces a key into the log's own registry. Its body names
    99	# the observer the key speaks for and the key itself; the record must be
   100	# signed by a key that is ALREADY valid at its ordinal, which is what makes
   101	# the registry a chain of custody rather than a mutable table.
   102	KEY_INTRODUCTION_KIND = "key"
   103	
   104	# Emitted key order. Transport encoding, not canonicalization — the same
   105	# posture ``jsonl_codec._dump`` documents; canonicalization for hashing is JCS
   106	# and is independent of the order bytes come out in. ``rh`` is last purely as
   107	# a reading convenience: it cannot cover itself, so it is computed over the
   108	# object with ``rh`` removed.
   109	RECORD_FIELDS = ("v", "lin", "ord", "prev", "at", "k", "observer", "origin", "body")
   110	_SIG = "sig"
   111	_RH = "rh"
   112	_ALLOWED = frozenset((*RECORD_FIELDS, _SIG, _RH))
   113	
   114	# JCS (RFC 8785) numeric domain — mirrors the guard ``jsonl_codec`` puts at
   115	# its own gate. An integer outside it is not canonicalizable, so a record
   116	# carrying one cannot be hashed: refuse at the codec rather than detonate
   117	# inside the hasher.
   118	_JCS_INT_MAX = 2**53 - 1
   119	_JCS_INT_MIN = -(2**53) + 1
   120	
   121	# Reverse scan granularity for finding a line boundary. Chunked so the scan
   122	# never loads the whole log and never gives up as a function of line length.
   123	_CHUNK = 64 * 1024
   124	
   125	_HEX = frozenset("0123456789abcdef")
   126	
   127	# A signer is injected, never imported: engine does not depend on ``sign``.
   128	# Shape matches the store's ``fact_signer`` — (observer, commitment digest
   129	# hex) -> signature, or None when that observer has no key.
   130	Signer = Callable[[str, str], "str | None"]
   131	
   132	# Verification is injected under the same posture. Shape: (public key in the
   133	# ratified wire format, signature, commitment digest hex) -> bool. The
   134	# composing layer supplies the algorithm and the domain-separation prefix;
   135	# this module supplies WHICH key may speak at WHICH position, and nothing
   136	# about how a signature is checked.
   137	Verify = Callable[[str, str, str], bool]
   138	
   139	# The ratified key wire format: an Ed25519 public key as raw-32-byte base64,
   140	# copy-identical to the composing layer's on-disk public-key file. The
   141	# grammar pins the shape (so a malformed key is refused at the append site);
   142	# the algorithm stays the injected verifier's business.
   143	_KEY_RAW_LEN = 32
