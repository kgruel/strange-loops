   569	def diff_interval_report(
   570	    store_path: Path,
   571	    pos1: WitnessPosition,
   572	    pos2: WitnessPosition,
   573	    *,
   574	    timeout: float = 5.0,
   575	) -> dict:
   576	    """Interval honesty info between two witness positions (0.8.0 ``--diff``, M8/A13).
   577	
   578	    A bare structural (kind, key) diff between two fold reconstructions can
   579	    look "clean" (no changed keys) while something still happened in the
   580	    receipt stream between the two positions — this reports the two things
   581	    a payload-level diff cannot see:
   582	
   583	    - ``late_arrivals``: facts received in the interval between the two
   584	      positions whose ``ts`` is EARLIER than the newest ts already visible
   585	      at the earlier position — an arrival that inserts itself BEFORE facts
   586	      the earlier position already replayed in ``(ts, id)`` order (the same
   587	      phenomenon ``_n`` in ``_diff_snapshot`` surfaces at the per-key level,
   588	      reported here store-wide). Each entry is ``{"id", "kind", "ts"}``,
   589	      newest-received first. ``_decl.*`` rows are excluded (domain facts
   590	      only — a declaration change is reported separately below).
   591	    - ``declaration_changed``: True when any ``_decl.*`` row falls in the
   592	      interval — the ontology itself may have moved between the two
   593	      positions (a rekey, a new kind, ...), independent of whether any
   594	      domain payload changed.
   595	
   596	    Symmetric by rowid (``lo``/``hi`` = ``min``/``max(pos1.rowid,
   597	    pos2.rowid)``): ``--diff B..A`` (the later position named first) reports
   598	    identically to ``--diff A..B``. Both positions MUST be resolved against
   599	    the SAME store — the caller (``cli.views.fold._run_diff``) already
   600	    requires this, since both diff endpoints resolve against one vertex.
   601	    """
   602	    conn = _open_readonly(store_path, timeout=timeout)
   603	    if conn is None:
   604	        raise WitnessResolutionError(
   605	            f"{store_path} is not a usable store — cannot compute a diff "
   606	            "interval report against it"
   607	        )
   608	    try:
   609	        lo, hi = sorted((pos1.rowid, pos2.rowid))
   610	        if lo == hi:
   611	            return {"late_arrivals": [], "declaration_changed": False}
   612	        newest_row = conn.execute(
   613	            "SELECT MAX(ts) FROM facts WHERE rowid <= ? AND kind NOT GLOB '_decl.*'",
   614	            (lo,),
   615	        ).fetchone()
   616	        newest_ts_at_lo = newest_row[0] if newest_row else None
   617	        late_arrivals: list[dict] = []
   618	        if newest_ts_at_lo is not None:
   619	            rows = conn.execute(
   620	                "SELECT id, kind, ts FROM facts WHERE rowid > ? AND rowid <= ? "
   621	                "AND kind NOT GLOB '_decl.*' AND ts < ? ORDER BY rowid DESC",
   622	                (lo, hi, newest_ts_at_lo),
   623	            ).fetchall()
   624	            late_arrivals = [{"id": r[0], "kind": r[1], "ts": r[2]} for r in rows]
   625	        decl_row = conn.execute(
   626	            "SELECT 1 FROM facts WHERE rowid > ? AND rowid <= ? "
   627	            "AND kind GLOB '_decl.*' LIMIT 1",
   628	            (lo, hi),
   629	        ).fetchone()
   630	        return {
   631	            "late_arrivals": late_arrivals,
   632	            "declaration_changed": decl_row is not None,
   633	        }
   634	    finally:
   635	        conn.close()
