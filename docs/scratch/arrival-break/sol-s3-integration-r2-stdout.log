  2033	def test_the_fenced_open_journals_nothing(tmp_path):
  2034	    """The loop closed at its source: the acceptance is what erased the evidence.
  2035	
  2036	    A fenced open must leave the journal exactly as it found it, or the very
  2037	    next open would compare against a head this one refused — which is how the
  2038	    cycle became invisible in the first place.
  2039	    """
  2040	    log_path, lineage, _abandoned, backup = _reset_away_from(tmp_path)
  2041	    before = journal_bytes(lineage)
  2042	
  2043	    log_path.write_bytes(backup)
  2044	    with pytest.raises(AbandonedHistoryFenced):
  2045	        opened(log_path)
  2046	
  2047	    assert journal_bytes(lineage) == before
  2048	
