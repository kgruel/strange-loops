   100	# ---------------------------------------------------------------------------
   101	# 1. Concurrent append, dense ordinals — THE GATE
   102	# ---------------------------------------------------------------------------
   103	
   104	_APPEND_WORKER = """
   105	    import sys
   106	    from engine.arrival import ArrivalLog
   107	
   108	    path, count, tag = sys.argv[1], int(sys.argv[2]), sys.argv[3]
   109	    log = ArrivalLog(path)
   110	    for i in range(count):
   111	        # No retry on purpose. The lock is supposed to make every append
   112	        # succeed first time; a rejection here means the head was read
   113	        # outside the critical section, and the worker must fail loudly
   114	        # rather than paper over it.
   115	        log.append("note", {"w": tag, "i": i}, observer=tag)
   116	    """
   117	
   118	
   119	def test_gate_concurrent_append_keeps_ordinals_dense(tmp_path):
   120	    """Four processes × 250 appends each against one log.
   121	
   122	    Exactly N×M+1 records, every line decodes, ordinals run 0..N×M with no
   123	    gap and no repeat, every ``prev`` matches its predecessor's ``rh``, and
   124	    every ``rh`` recomputes. This is the test the whole design exists to
   125	    pass.
   126	    """
   127	    log = _mint(tmp_path)
   128	    workers = [
   129	        _run(_APPEND_WORKER, str(log.path), str(APPENDS), f"w{n}",
   130	             tmp_path=tmp_path, name=f"append{n}")
   131	        for n in range(WRITERS)
   132	    ]
   133	    for n, worker in enumerate(workers):
   134	        out, err = worker.communicate(timeout=600)
   135	        assert worker.returncode == 0, f"writer {n} failed:\n{out}\n{err}"
   136	
   137	    _verify_by_hand(log, WRITERS * APPENDS + 1)
   138	
   139	    # And the module's own walk agrees with the hand check.
   140	    walked = list(log.walk())
   141	    assert [r["ord"] for r in walked] == list(range(WRITERS * APPENDS + 1))
   142	    # Every writer's appends all landed, and none landed twice.
   143	    from collections import Counter
   144	
   145	    tally = Counter(r["body"]["w"] for r in walked[1:])
   146	    assert tally == {f"w{n}": APPENDS for n in range(WRITERS)}
   147	
