    22	def _fake_signer_for(signing_observers: set[str]):
    23	    """A per-observer fact signer: signs only the named observers.
    24	
    25	    Deterministic fake scheme — signature is 'sig:' + digest, verifiable by
    26	    the matching fake verifier below. Configuration-wise, signing IS
    27	    configured for every observer (the callable exists); the per-observer
    28	    None return is the honesty case the contract names.
    29	    """
    30	
    31	    def signer(observer: str, digest: str) -> str | None:
    32	        if observer in signing_observers:
    33	            return f"sig:{digest}"
    34	        return None
    35	
    36	    return signer
    37	
    38	
    39	def _fake_verifier(observer: str, signature: str, digest: str) -> bool:
    40	    return signature == f"sig:{digest}"
