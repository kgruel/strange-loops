   583	    def fact_signature(self, fact_id: str) -> str | None:
   584	        """Signature column of the COMMITTED fact row, or None.
   585	
   586	        The read-back half of the write-receipt attestation contract
   587	        (LIBS_CHANGES P1): the committed row is the authority on whether a
   588	        write was signed — never "keys exist locally" inference. Returns
   589	        None for an unsigned row, a pre-signature-column schema, or an
   590	        unknown id (callers that need to distinguish absence hold the id
   591	        ``append`` just returned). Read-only: never migrates schema.
   592	        """
   593	        if self._conn is None:
   594	            raise RuntimeError(f"store closed: {self._path}")
   595	        if not self._facts_have_signature_column():
   596	            return None
   597	        row = self._conn.execute(
   598	            "SELECT signature FROM facts WHERE id = ?", (fact_id,)
   599	        ).fetchone()
   600	        return row[0] if row is not None else None
   601	
   602	    def tick_signature_state(self, tick_id: str) -> tuple[str | None, bool] | None:
   603	        """(signature, chained) of the COMMITTED tick row; None if unknown id.
   604	
   605	        Same committed-row authority as :meth:`fact_signature`, for the
   606	        ticks axis: ``signature`` is the row's persisted Ed25519 signature
   607	        (None in the pre-signature era), ``chained`` whether the row
   608	        carries chain fields (``window_hash`` non-NULL). Read-only: never
   609	        migrates schema — pre-chain/pre-signature schemas report
   610	        ``(None, False)`` for a known id.
   611	        """
   612	        if self._conn is None:
   613	            raise RuntimeError(f"store closed: {self._path}")
   614	        if self._ticks_have_chain_columns():
   615	            select = "signature, window_hash"
   616	        else:
   617	            cols = {r[1] for r in self._conn.execute("PRAGMA table_info(ticks)")}
   618	            select = ", ".join(
   619	                c if c in cols else f"NULL AS {c}"
   620	                for c in ("signature", "window_hash")
   621	            )
   622	        row = self._conn.execute(
   623	            f"SELECT {select} FROM ticks WHERE id = ?", (tick_id,)
   624	        ).fetchone()
