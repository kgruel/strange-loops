from __future__ import annotations

import json
from pathlib import Path

from custody.signing import ARRIVAL_DOMAIN
from engine.arrival_contract import StoreDescriptor
from engine.arrival_registry import BackendRegistry
from migrate import identity, run_migration
from sign import ed25519


root = Path("/tmp/sol-s4-r1/custodian-override")
root.mkdir(parents=True, exist_ok=True)
for path in root.rglob("*"):
    if path.is_file():
        path.unlink()
alice = ed25519.load_or_generate(root / "keys" / "alice")
mallory = ed25519.load_or_generate(root / "keys" / "mallory")


def mallory_signer(observer: str, digest: str) -> str | None:
    assert observer == "mallory"
    return ed25519.sign(mallory, digest.encode(), domain=ARRIVAL_DOMAIN)


source = root / "legacy.jsonl"
source.write_text(
    json.dumps(
        {
            "t": "fact", "id": "id", "kind": "probe", "ts": 1.0,
            "observer": "alice", "origin": "probe", "payload": "{}",
        },
        separators=(",", ":"),
    ) + "\n",
    encoding="utf-8",
)
vertex = root / "project.vertex"
vertex.write_text(
    f'''name "alice"
store "./legacy.jsonl"
observers {{
  alice {{
    key "{alice.public_b64}"
  }}
}}
loops {{
  probe {{ fold {{ items "collect" 10 }} }}
}}
''',
    encoding="utf-8",
)
outcome = run_migration(
    source,
    vertex,
    store_dir=root,
    signer=mallory_signer,
    transform_rule=identity(),
    custodian="mallory",
    custodian_key=mallory.public_b64,
)
ledger, _ = BackendRegistry.with_builtin_backends().open(
    StoreDescriptor(backend="file", location=str(outcome.target_path))
)
genesis = list(ledger.scan(through=outcome.head))[0]
print("declared_vertex_name='alice'")
print(f"genesis_observer={genesis['observer']!r}")
print(f"genesis_key_is_declared_alice={genesis['body']['key'] == alice.public_b64}")
if genesis["observer"] == "alice" and genesis["body"]["key"] == alice.public_b64:
    print("PASS: genesis is pinned to the declaration")
    raise SystemExit(0)
print("FAIL: public overrides bypassed the declared custodian identity and key")
raise SystemExit(1)
