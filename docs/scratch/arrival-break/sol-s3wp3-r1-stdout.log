   496	    Cost: the full walk, plus one verified walk per journaled head in the
   497	    epoch. "Periodic" is operator cadence and this is the operator-cadence
   498	    path, so the honest lookup is worth more than a cheaper one — but the cost
   499	    is real, and a store whose epoch holds many entries is where a
   500	    single-walk-with-a-table form would earn its keep. Named rather than
   501	    pre-paid; its forcing consumer is a store large enough to notice.
   502	    """
   503	    ledger.verify(Full(through=presented))
   504	    unaccounted = unaccounted_heads(epoch, _vouched_at(ledger, presented.lineage))
   505	    if unaccounted:
   506	        raise AuditFoundUnaccountedHeads(
   507	            "the store can no longer account for "
   508	            f"{len(unaccounted)} head(s) journaled in the current trust epoch: "
   509	            + "; ".join(
   510	                f"ordinal {entry.head.ordinal} ({entry.head.record_hash})"
   511	                for entry in unaccounted
   512	            )
   513	            + ". No audit entry was written — one would record a verification "
   514	            "that did not happen. Locate a replica or backup that holds them, "
   515	            "or run the explicit trust-reset ceremony and record the gap",
   516	            heads=tuple(unaccounted),
   517	        )
   518	    return append_entry(
   519	        HeadAttestation(
   520	            head=presented,
   521	            kind=Kind.AUDIT,
   522	            level=Level.FULL,
   523	            observed_at=observed_at,
   524	            location=canonical_location(location),
   525	            note=projection,
   526	        )
   527	    )
