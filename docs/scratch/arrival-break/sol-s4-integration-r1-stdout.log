    71	def _normalize_dep(dep_str: str) -> set[str]:
    72	    """Extract top-level module names from a dependency requirement string."""
    73	    m = re.match(r"^([a-zA-Z0-9_\-\.]+)", dep_str)
    74	    if not m:
    75	        return {dep_str}
    76	    raw = m.group(1).lower()
    77	    if raw in _DIST_TO_MODULES:
    78	        return _DIST_TO_MODULES[raw]
    79	    norm = raw.replace("-", "_")
    80	    if norm in _DIST_TO_MODULES:
    81	        return _DIST_TO_MODULES[norm]
    82	    return {norm}
    83	
    84	
    85	def _get_package_declared_modules(pkg_dir: Path, include_dev: bool = False) -> set[str]:
    86	    """Extract all declared module names from a package's pyproject.toml."""
    87	    pyproject = pkg_dir / "pyproject.toml"
    88	    if not pyproject.exists():
    89	        return set()
    90	    with open(pyproject, "rb") as f:
    91	        data = tomllib.load(f)
    92	    deps = data.get("project", {}).get("dependencies", [])
    93	    declared: set[str] = set()
    94	    for d in deps:
    95	        declared.update(_normalize_dep(d))
    96	    if include_dev:
    97	        dev_deps = data.get("dependency-groups", {}).get("dev", [])
    98	        for d in dev_deps:
    99	            declared.update(_normalize_dep(d))
   100	    return declared
