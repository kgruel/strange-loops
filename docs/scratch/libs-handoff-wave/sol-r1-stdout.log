   545	# --- --deep: line-by-line, and the chain from canonical content ------------
   546	
   547	
   548	def audit_deep(canonical: Path) -> AgreementReport:
   549	    """Stream the whole log and judge the index against it, line by line.
   550	
   551	    Runs :func:`audit_agreement` first (a cheap check that already failed is
   552	    the more useful report), then two deeper passes in one streaming walk:
   553	
   554	    1. **Content and order.** Every log line is decoded and compared, field
   555	       for field, against the next index row in *rowid* order for its table.
   556	       Facts and ticks carry independent rowids, so cross-table interleave is
   557	       not recoverable from sqlite and is not claimed to be checked — per
   558	       table, order is exact.
   559	    2. **The chain, re-derived from canonical content.** ``prev_hash``,
   560	       ``window_start`` continuity and ``window_hash`` are recomputed from the
   561	       rows the *log* carries, using the same era-aware hashers the write path
   562	       used. This is the check the index-only walk cannot make: a chain that
   563	       verifies against a poisoned index still has to verify against the log.
   564	
   565	    Memory is bounded by row COUNT, not payload size: the walk keeps one
   566	    32-byte digest and one id per fact, and never holds a payload after the
   567	    line that carried it is judged.
   568	    """
   569	    canonical = Path(canonical)
   570	    from .residence import index_path_for
   571	
   572	    base = audit_agreement(canonical)
   573	    if any(c.name in ("log", "index") and not c.ok for c in base.checks):
   574	        return AgreementReport(base.checks, deep=True, counts=base.counts)
   575	
   576	    conn = _open_index(index_path_for(canonical))
   577	    if conn is None:  # pragma: no cover — audit_agreement just opened it
   578	        return AgreementReport(base.checks, deep=True)
   579	    try:
   580	        offset = _meta_int(conn, OFFSET_KEY)
   581	        # The same corroboration L1 made: a content failure is only excusable
   582	        # as beyond-the-consumed-prefix when the log suffix past the offset
   583	        # really starts unindexed. Reading the flag off the marker alone would
   584	        # let a rewind stamp ``"beyond_offset": true`` onto a tampered line in
   585	        # ``--json``.
   586	        unconsumed = offset is not None and _suffix_unindexed(
   587	            conn, canonical, offset, _log_size(canonical)
   588	        )
   589	        checks = [
   590	            *base.checks,
   591	            *_deep_checks(conn, canonical, offset if unconsumed else None),
   592	        ]
   593	        return AgreementReport(tuple(checks), deep=True, counts=base.counts)
   594	    finally:
   595	        conn.close()
   596	
