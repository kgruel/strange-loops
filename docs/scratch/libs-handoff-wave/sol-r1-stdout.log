    69	
    70	class _Spec:
    71	    """Everything the codec knows about one record type, keyed by ``"t"``.
    72	
    73	    Fact and tick differ only in their field tuple and which fields may be
    74	    null; both directions of both types then run one code path, so a rule
    75	    added here cannot apply to one type and be forgotten for the other.
    76	    """
    77	
    78	    __slots__ = ("t", "fields", "allowed", "nullable")
    79	
    80	    def __init__(self, t: str, fields: tuple[str, ...], nullable: frozenset[str]):
    81	        self.t = t
    82	        self.fields = fields
    83	        self.allowed = frozenset((*fields, _SIGNATURE, "t"))
    84	        self.nullable = nullable
    85	
    86	
    87	_SPEC = {
    88	    "fact": _Spec("fact", FACT_FIELDS, frozenset()),
    89	    "tick": _Spec(
    90	        "tick",
    91	        TICK_FIELDS,
    92	        frozenset(("since", "prev_hash", "window_start", "fact_cursor", "window_hash")),
    93	    ),
    94	}
    95	
    96	# The third record type is STRUCTURAL, not field-shaped, so it does not fit
    97	# _Spec: a ``"t":"batch"`` envelope carries ``rows`` — an array of ≥ 2
    98	# ordinary fact record objects, each validated against ``_SPEC["fact"]`` in
    99	# full (verbatim payload TEXT per row, so signatures and commitment hashes
   100	# survive round-trip unchanged). One line is the log's atomicity unit, so a
   101	# batch is how a multi-row ceremony (absorb_edit) lands atomically.
   102	# Structural rules (design:architecture/jsonl-declaration-ceremony-encoding):
   103	# no ticks inside (ticks are minted one-at-a-time and chain-linked), no
   104	# nested batches, no duplicate id within one batch (otherwise a dup only
   105	# surfaces three layers away as a rebuild-time PK collision), no envelope
   106	# key besides t/rows. Same-ts across rows is deliberately NOT a codec rule
   107	# (D1): it is the declaration ceremony's invariant, enforced by absorb_edit
   108	# and asserted by audit_deep — baking it in here would block future
   109	# batch-emit reuse with distinct ts.
   110	_BATCH = "batch"
   111	_ROWS = "rows"
   112	_BATCH_KEYS = frozenset(("t", _ROWS))
   113	_MIN_BATCH_ROWS = 2
   114	
   115	# JCS (RFC 8785) numeric domain — mirrors rfc8785._impl._INT_MIN/_INT_MAX.
   116	# Integers outside it, and non-finite floats, are not canonicalizable, so a
   117	# line carrying one cannot be hashed: reject at the codec gate rather than
   118	# detonating inside the commitment hashers.
   119	_JCS_INT_MAX = 2**53 - 1
   120	_JCS_INT_MIN = -(2**53) + 1
   121	
   122	
   123	def _dump(obj: dict) -> str:
   124	    """Encode one line. ensure_ascii keeps lines 7-bit and free of raw
   125	    U+2028/U+2029; allow_nan=False refuses non-JSON floats explicitly;
   126	    separators drop insignificant whitespace. Key order is the dict's
   127	    insertion order — sqlite column order — not sorted: this is a transport
   128	    encoding, not a canonicalization (JCS lives in the hashers)."""
