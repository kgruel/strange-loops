  1444	def _journal_reset_at_5_then_advanced_to_8() -> HeadAttestation:
  1445	    """Ordinals 1-10, a legitimate reset accepting 5, then 6-8. Returns the reset."""
  1446	    for ordinal in range(1, 11):
  1447	        append_entry(observation(ordinal))
  1448	    legitimate = append_reset(5, note="restored from archive; abandoned 10")
