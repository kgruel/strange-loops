  1259	def test_an_incomplete_read_still_refuses_a_fork_at_the_bound(tmp_path):
  1260	    """The posture's second half: the bound is a real accepted entry.
  1261	
  1262	    A presented head at the bound's ordinal with a different hash means two
  1263	    records claim one height, and the lost lines cannot make that agree.
  1264	    """
  1265	    log_path = minted(tmp_path / "s.arrival")
  1266	    genesis_only = log_path.read_bytes()
  1267	    append_legacy(log_path, "one")
  1268	    opened(log_path)
  1269	    lineage = lineage_of(log_path)
  1270	
  1271	    append_entry_for_damage(lineage)
  1272	    damage_a_line(lineage, "damage-me")
  1273	
  1274	    other = tmp_path / "other.arrival"
  1275	    other.write_bytes(genesis_only)
  1276	    append_legacy(other, "a different one")
  1277	    log_path.write_bytes(other.read_bytes())
  1278	
  1279	    with pytest.raises(HeadFork) as excinfo:
  1280	        opened(log_path)
  1281	    assert "incomplete" in str(excinfo.value)
