   383	def _suffix_unindexed(conn, canonical: Path, offset: int, size: int) -> bool:
   384	    """Does the log past ``offset`` START with a genuinely unindexed line?
   385	
   386	    The corroboration behind :attr:`Check.beyond_offset`, and no more than
   387	    that. The writer's crash window has one shape: the log holds durable bytes
   388	    the index has NOT consumed, so the first line past the stamped offset has
   389	    no row in the index. Reading that one line is O(1) and turns "the
   390	    suspect's own marker says so" into a claim the log supports — but it says
   391	    NOTHING about the rest of the suffix, which is why no caller may read a
   392	    True here as innocence. Corroborating every suffix line is
   393	    :func:`audit_deep`'s scope, by construction: it already streams them.
   394	
   395	    False (the marker is not merely behind) when the offset does not land on a
   396	    line boundary, when the first line does not decode, or when the index
   397	    already holds a row for it — the marker was rewound below rows the index
   398	    consumed, which no writer produces. True for a torn final line: those
   399	    bytes were never indexed, which is precisely the interrupted-append window.
   400	    """
   401	    if not 0 <= offset < size:
   402	        return False
   403	    if offset > 0:
   404	        with canonical.open("rb") as fh:
   405	            fh.seek(offset - 1)
   406	            if fh.read(1) != b"\n":
   407	                return False
   408	    with canonical.open("rb") as fh:
   409	        fh.seek(offset)
   410	        while True:
   411	            raw = fh.readline()
   412	            if not raw:
   413	                return False  # nothing but blank bytes past the offset
   414	            if not raw.endswith(b"\n"):
   415	                return True  # torn tail — never indexed, by construction
   416	            text = raw[:-1].decode("utf-8", "replace").strip()
   417	            if text:
   418	                break
   419	    try:
   420	        records = deserialize_records(text)
   421	    except (JsonlCodecError, UnicodeError):
   422	        return False  # garbage past the offset is not an innocence claim
   423	    # A batch line is judged by its first inner row — the writer's crash
   424	    # window leaves the WHOLE ceremony line unindexed, so one probe is the
   425	    # same O(1) corroboration a plain line gets.
   426	    t, row = records[0]
   427	    return not _index_has_row(conn, t, row[0])
