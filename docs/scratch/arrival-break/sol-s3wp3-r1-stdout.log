  1213	def test_an_incomplete_read_still_refuses_a_head_below_the_bound(tmp_path):
  1214	    """The posture's first half: every SOUND refusal still fires.
  1215	
  1216	    A presented head below the bound is below the accepted head whatever the
  1217	    read missed — the readable entries bound it from below, and damage cannot
  1218	    lower a bound beneath what the surviving entries prove. Proceeding here
  1219	    would be the silent re-acceptance the journal exists to prevent, and it
  1220	    would be reachable by damaging one line.
  1221	    """
  1222	    log_path = minted(tmp_path / "s.arrival")
  1223	    append_legacy(log_path, "one")
  1224	    backup = log_path.read_bytes()
  1225	    append_legacy(log_path, "two", "three")
  1226	    opened(log_path)
  1227	    lineage = lineage_of(log_path)
  1228	
  1229	    append_entry_for_damage(lineage)
  1230	    damage_a_line(lineage, "damage-me")
  1231	
  1232	    log_path.write_bytes(backup)
  1233	    with pytest.raises(HeadRollback) as excinfo:
  1234	        opened(log_path)
  1235	    assert "incomplete" in str(excinfo.value)
