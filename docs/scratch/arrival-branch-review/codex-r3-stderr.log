   377	# Evasion probes — review round 1, F3.
   378	#
   379	# Every one of these got past the first cut of this rule. They are test cases
   380	# now so the detector cannot quietly regress to matching one spelling of a
   381	# word, which is the failure mode a denylist has.
   382	# ---------------------------------------------------------------------------
   383	
   384	
   385	@pytest.mark.parametrize(
   386	    "source, term",
   387	    [
   388	        # The four the reviewer found.
   389	        ("JsonlOffset = 1\n", "jsonl_offset"),
   390	        ("RECEIPT_ORDER = 1\n", "receipt_order"),
   391	        ("def Rewind():\n    pass\n", "rewind"),
   392	        ("X = {'jsonl_offset': 1}\n", "jsonl_offset"),
   393	        # The pair that was missing from the denylist entirely.
   394	        ("union_discipline = 1\n", "union_discipline"),
   395	        ("X = {'union-discipline': 1}\n", "union_discipline"),
   396	        # Same shapes, generalized — the point is the spelling, not the term.
   397	        ("jsonlOffset = 1\n", "jsonl_offset"),
   398	        ("class ReAnchor:\n    pass\n", "reanchor"),
   399	        ("def f(Mergeability=None):\n    pass\n", "mergeability"),
   400	        ("record['RECEIPT_MODE'] = 1\n", "receipt_mode"),
   401	        ('def f():\n    """We rewind the log here."""\n', "rewind"),
   402	        # Round 2, F3-R2. An export list is naming, and it is the most
   403	        # public naming a module does.
   404	        ('__all__ = ["jsonl_offset"]\n', "jsonl_offset"),
   405	        ('__all__ = ["a"]\n__all__ += ["Rewind"]\n', "rewind"),
   406	        # A string forward reference is an identifier the parser has not
   407	        # resolved yet.
   408	        ('def f(x: "JsonlOffset"):\n    pass\n', "jsonl_offset"),
   409	        ('def f() -> "ReAnchor":\n    pass\n', "reanchor"),
   410	        ('x: "Mergeability" = None\n', "mergeability"),
   411	        # In NAME mode every separator joins, so punctuation cannot split a
   412	        # key out of reach the way it did before.
   413	        ('X = {"jsonl.offset": 1}\n', "jsonl_offset"),
   414	        ('X = {"union discipline": 1}\n', "union_discipline"),
   415	        ("UnionDiscipline = 1\n", "union_discipline"),
   416	    ],
   417	)
   418	def test_the_detector_catches_known_evasions(source, term):
   419	    faults = _faults(source, "probe.py")
   420	    assert faults, f"evasion not caught: {source!r}"
   421	    assert term in faults[0], f"caught as the wrong term: {faults[0]}"
