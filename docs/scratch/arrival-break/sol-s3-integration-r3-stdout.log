  1132	def _scan(
  1133	    lines: Iterable[str],
  1134	) -> tuple[list[tuple[int, HeadAttestation]], _Skips, bool]:
  1135	    """Every readable entry with its PHYSICAL LINE ORDINAL, what was skipped,
  1136	    and whether a header was seen.
  1137	
  1138	    The line number is the file's own, counted from 1 over every line including
  1139	    ones this build skipped — never an index among the entries that happened to
  1140	    parse. That distinction is the whole of the position claim: an index among
  1141	    valid entries is a judgment, and a future build that classifies one line
  1142	    differently renumbers every entry after it, silently voiding every reset
  1143	    bound below. Physical line N is line N forever in a file that is only ever
  1144	    appended to.
  1145	
  1146	    Split out of :func:`parse_journal_lines` so a caller can reach the entries
  1147	    WITHOUT the judgment built on top of them. That judgment can refuse —
  1148	    :func:`_known_of` raises on equivocation — and the trust-reset ceremony
  1149	    needs the last entry precisely when the journal is in a state a full read
  1150	    will not answer for. A recovery path that depended on the read it recovers
  1151	    from would be unusable exactly when it is needed.
  1152	    """
  1153	    entries: list[tuple[int, HeadAttestation]] = []
  1154	    skips = _Skips()
  1155	    seen: dict[str, int] = {}
  1156	    header_seen = False
  1157	    for index, line in enumerate(lines):
  1158	        stripped = line.strip()
  1159	        if not stripped:
  1160	            continue
  1161	        try:
  1162	            decoded = json.loads(stripped)
  1163	        except ValueError as exc:
  1164	            skips.missed(
  1165	                f"line {index + 1}: does not parse ({exc})", line=index + 1
  1166	            )
  1167	            continue
  1168	        verdict = _classify(decoded)
  1169	        if verdict is _HEADER:
  1170	            # Not tracked by position: two writers racing to create the same
  1171	            # journal can each write one, so "the header is line 1" is not a
  1172	            # property this reader may assume.
  1173	            header_seen = True
  1174	            continue
  1175	        if verdict is _AMBIGUOUS:
  1176	            skips.missed(
  1177	                f"line {index + 1}: carries both the journal type marker and "
  1178	                "an entry kind, so this build cannot say which it is",
  1179	                line=index + 1,
  1180	            )
  1181	            continue
  1182	        entry = _parse_entry(decoded)
  1183	        if entry is None:
  1184	            skips.missed(
  1185	                f"line {index + 1}: not readable by this build", line=index + 1
  1186	            )
  1187	            continue
  1188	        if stripped in seen:
  1189	            # A LITERAL RE-ASSERTION: recorded, and WEIGHTLESS. The line's
  1190	            # content is one this read already counted, so nothing about the
  1191	            # accepted head is unknown because of it.
  1192	            skips.re_asserted(
  1193	                f"line {index + 1}: byte-identical to line {seen[stripped]}, "
  1194	                "so it re-asserts an observation this journal already holds "
  1195	                "rather than recording a new one — a replayed line cannot "
  1196	                "count twice"
  1197	            )
  1198	            continue
