/bin/zsh -lc "UV_CACHE_DIR=/private/tmp/loops-uv-cache uv run --all-packages --no-sync python - <<'PY'
import base64, hashlib, json, sqlite3, tempfile, shutil
from pathlib import Path
from atoms import Fact
from engine.arrival import ArrivalLog
from engine.arrival_store import ensure_arrival_index
from engine.sqlite_store import SqliteStore
from engine.witness import (
    WitnessLineageMismatch, diff_interval_report, resolve_witness_position,
)
from store import MergeDivergence, merge_store

KEY=base64.b64encode(b'k'*32).decode()
def sign(observer, commitment):
    return 'sig:'+hashlib.sha256(f'{observer}/{commitment}'.encode()).hexdigest()
def arrival_body(msg, signature=None):
    row={'t':'fact','id':'COLLIDE','kind':'note','ts':1700000000.0,
         'observer':'alice','origin':'','payload':json.dumps({'message':msg})}
    if signature is not None: row['signature']=signature
    return row
def make_arrival(root,name,row):
    log=ArrivalLog.mint(root/f'{name}.arrival',observer='alice',signer=sign,key=KEY)
    log.append('fact',row,observer='alice',at=row['ts'])
    ensure_arrival_index(log.path)
    return root/f'{name}.db'
def make_legacy(path,row):
    s=SqliteStore(path=path,serialize=lambda f:f.to_dict(),deserialize=Fact.from_dict)
    s.append(Fact.from_dict(row))
    s.close()
def adopted(path,label):
    s=SqliteStore(path=path,serialize=lambda f:f.to_dict(),deserialize=Fact.from_dict,fact_signer=sign)
    s.absorb_genesis([{'kind':'vertex-defined','subject':label,'payload':{'name':label}}],observer=label,fact_signer=sign)
    s.append(Fact.of('note',label,n=1))
    s.close()

with tempfile.TemporaryDirectory() as d:
    root=Path(d)
    # CX-BR-01: exact r1 arrival collision, plus identical pair.
    target=make_arrival(root,'target',arrival_body('TARGET'))
    source=make_arrival(root,'source',arrival_body('SOURCE', signature='definitely-not-valid'))
    before=(root/'target.arrival').read_bytes()
