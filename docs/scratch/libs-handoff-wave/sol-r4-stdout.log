   324	
   325	# ---------------------------------------------------------------------------
   326	# KDL text manipulation — generic path-parametric splice
   327	# ---------------------------------------------------------------------------
   328	#
   329	# Path encoding (list[str]): each entry is the stripped-line header of a
   330	# block, optionally including its first quoted positional arg.
   331	#
   332	#   ["loops"]                          → matches `loops { ... }`
   333	#   ["loops", "decision"]              → `decision { ... }` inside loops
   334	#   ['template "feed.loop"']           → top-level `template "feed.loop" { ... }`
   335	#   ['sources', 'template "feed.loop"']→ template inside a sources block
   336	#   ['combine', 'vertex "./foo.vertex"'] → vertex entry inside combine
   337	#
   338	# Quoted-arg matching uses Path() equality so ./feed.loop == feed.loop.
   339	# Bare-name segments match the first token only — fine for singleton parents
   340	# (loops, observers, combine, lens, sources) which is the corpus reality.
   341	
   342	
   343	def _parse_segment(segment: str) -> tuple[str, str | None]:
   344	    """Parse a path segment into (name, optional_quoted_key).
   345	
   346	    'loops'                   -> ('loops', None)
   347	    'template "feed.loop"'    -> ('template', 'feed.loop')
   348	    'vertex "./project.vertex"' -> ('vertex', './project.vertex')
   349	    """
   350	    import re
   351	    m = re.match(r'^(\S+)(?:\s+"([^"]+)")?\s*$', segment)
   352	    if not m:
   353	        raise ValueError(f"Invalid path segment: {segment!r}")
   354	    return m.group(1), m.group(2)
   355	
   356	
   357	def _line_opens_matching_block(stripped: str, segment: str) -> bool:
   358	    """True iff `stripped` is the opening line of a block matching `segment`."""
   359	    if "{" not in stripped:
   360	        return False
   361	    name, key = _parse_segment(segment)
   362	    if not stripped.startswith(name):
   363	        return False
   364	    # Ensure name is a complete token, not a prefix (e.g. 'loops' should not
   365	    # match 'loopstest'). The next char must be space, brace, or quote.
   366	    nxt = stripped[len(name) : len(name) + 1]
   367	    if nxt and nxt not in (" ", "{", '"', "\t"):
   368	        return False
   369	    if key is None:
   370	        return True
   371	    import re
   372	    m = re.search(r'"([^"]+)"', stripped)
   373	    if not m:
   374	        return False
   375	    from pathlib import Path
   376	    return Path(m.group(1)) == Path(key)
   377	
   378	
   379	def _line_matches_child(
   380	    stripped: str,
   381	    child_name: str,
   382	    child_key: str | None = None,
   383	    key_field: str | None = None,
   384	) -> bool:
   385	    """Match a child line by name + optional discriminator.
   386	
   387	    - name only: first token equals child_name
   388	    - + child_key (no key_field): match first quoted positional arg via Path()
   389	    - + child_key + key_field: match `key_field="child_key"` property substring
   390	    """
   391	    if not stripped.startswith(child_name):
   392	        return False
   393	    nxt = stripped[len(child_name) : len(child_name) + 1]
   394	    if nxt and nxt not in (" ", "{", '"', "\t"):
   395	        return False
   396	    if child_key is None:
   397	        return True
   398	    if key_field is not None:
   399	        return f'{key_field}="{child_key}"' in stripped
   400	    # Positional first-quoted-arg match (Path-style)
   401	    import re
   402	    m = re.search(r'"([^"]+)"', stripped)
   403	    if not m:
   404	        return False
   405	    from pathlib import Path
   406	    return Path(m.group(1)) == Path(child_key)
   407	
   408	
   409	def kdl_find_block(text: str, path: list[str]) -> tuple[int, int]:
   410	    """Locate a nested block by path. Returns (start_line_idx, end_line_idx) inclusive.
   411	
   412	    Each path segment is `'name'` for a bare-name block, or `'name "key"'` for
   413	    a block discriminated by its first quoted positional arg. Walks brace
   414	    depth to scope each segment's search to its parent's body.
   415	
   416	    Raises ValueError on missing or unclosed blocks.
   417	    """
   418	    if not path:
   419	        raise ValueError("path must contain at least one segment")
   420	    lines = text.splitlines()
   421	    # Search window: full file for first segment, then narrows.
   422	    search_start = 0
   423	    search_end = len(lines) - 1
   424	    block_start = -1
   425	    block_end = -1
   426	
   427	    for seg_idx, segment in enumerate(path):
   428	        block_start, block_end = _scan_block(
   429	            lines, search_start, search_end, segment
   430	        )
   431	        # Next segment searches strictly inside this block's body.
   432	        search_start = block_start + 1
   433	        search_end = block_end - 1
   434	        # If we're at the last segment, we're done.
   435	        if seg_idx == len(path) - 1:
   436	            return block_start, block_end
   437	
   438	    # Unreachable — loop always returns inside.
   439	    raise ValueError(f"Block not found for path {path!r}")
   440	
   441	
   442	def _scan_block(
   443	    lines: list[str], lo: int, hi: int, segment: str
   444	) -> tuple[int, int]:
   445	    """Scan lines[lo..hi] for a block matching segment. Brace-depth tracked.
   446	
   447	    Skips over nested children at depth>0 so we only match siblings of the
   448	    target's scope. Returns (start_line, end_line) inclusive.
   449	    """
   450	    start = -1
   451	    depth = 0
   452	    i = lo
   453	    while i <= hi:
   454	        stripped = lines[i].strip()
   455	        if start == -1:
   456	            # Only consider lines at depth 0 (sibling scope) as potential matches.
   457	            if _line_opens_matching_block(stripped, segment):
   458	                start = i
   459	                depth = stripped.count("{") - stripped.count("}")
   460	                if depth == 0:
   461	                    return start, i
   462	            else:
   463	                # Track depth changes from non-matching opens so we skip their bodies.
   464	                opens = stripped.count("{")
   465	                closes = stripped.count("}")
   466	                if opens > closes:
   467	                    # Skip this nested block's body entirely.
   468	                    body_depth = opens - closes
   469	                    j = i + 1
   470	                    while j <= hi and body_depth > 0:
   471	                        body_depth += lines[j].count("{") - lines[j].count("}")
   472	                        j += 1
   473	                    i = j
   474	                    continue
   475	        else:
   476	            depth += stripped.count("{") - stripped.count("}")
   477	            if depth <= 0:
   478	                return start, i
   479	        i += 1
   480	
   481	    if start != -1:
   482	        raise ValueError(f"Unclosed block for segment {segment!r}")
   483	    raise ValueError(f"Block not found for segment {segment!r}")
   484	
   485	
   486	def _detect_indent(lines: list[str], start: int, end: int) -> str:
   487	    """Detect indentation of children within a block."""
   488	    for i in range(start + 1, end + 1):
   489	        stripped = lines[i].strip()
   490	        if stripped and stripped != "}":
   491	            return lines[i][: len(lines[i]) - len(lines[i].lstrip())]
   492	    # Fallback: parent line indent + 2 spaces
   493	    parent_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   494	    return parent_indent + "  "
   495	
