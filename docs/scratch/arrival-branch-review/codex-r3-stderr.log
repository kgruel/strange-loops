   151	class ArrivalError(Exception):
   152	    """Base for every refusal the arrival log raises."""
   153	
   154	
   155	class ArrivalGrammarError(ArrivalError, ValueError):
   156	    """A record object does not match the grammar.
   157	
   158	    Raised in BOTH directions from one validator: an encode is held to the
   159	    same domain a decode enforces, so a wrongly typed field fails at the
   160	    append site, where it is attributable, rather than becoming a durable
   161	    line that bricks every later open.
   162	    """
   163	
   164	
   165	class ArrivalCorrupt(ArrivalError):
   166	    """A complete record in the log is not intact, and the log refuses.
   167	
   168	    Corruption is anything a complete line can be wrong about: it fails to
   169	    decode, its ``rh`` does not recompute, its ordinal breaks the dense
   170	    succession, or its ``prev`` does not name its predecessor. None of it is
   171	    a state an appender can produce, so it is evidence of a torn write that
   172	    somehow survived, of an out-of-band edit, or of tampering — and the safe
   173	    answer is a human look, not a silent skip or a truncation.
   174	
   175	    ``ordinal`` names where the walk stopped: the ordinal the record was
   176	    expected to carry, so the human has a place to start reading.
   177	    """
   178	
   179	    def __init__(self, message: str, ordinal: int) -> None:
   180	        super().__init__(f"arrival log corrupt at ordinal {ordinal}: {message}")
   181	        self.ordinal = ordinal
   182	
   183	
   184	class GenesisRefused(ArrivalError):
   185	    """A lineage cannot be opened, or a file cannot be read as an arrival log.
   186	
   187	    Three shapes, all refusals rather than repairs: the arrival file already
   188	    exists (a lineage is minted exactly once, and overwriting one destroys a
   189	    store); the genesis carries no signature (genesis is the lineage's
   190	    attestation root — the existing unsignable-genesis rule, carried across);
   191	    or the file's first record is not a valid genesis, in which case the file
   192	    is not an arrival log and there is nothing to infer. Identity is never
   193	    read out of content: position 0 is structural and cannot be forged into
   194	    existence by appending.
   195	    """
   196	
   197	
   198	class AuthorshipUnverified(ArrivalError):
   199	    """A signed record's authorship cannot be established from the log.
   200	
   201	    Raised by :func:`verify_authorship` when a signature fails to verify
   202	    under every key that is valid for its observer at its position — the
   203	    ruled rule: a key is valid at position N iff it was introduced at a
   204	    position < N, or N is the genesis position and the record is
   205	    self-certifying. A failure is evidence of a forged signature, a key
   206	    introduction that never happened, or a self-certification attempted
   207	    above ordinal 0 — never a state this module's own writers can produce.
   208	
   209	    ``ordinal`` names the record whose authorship failed.
   210	    """
   211	
   212	    def __init__(self, message: str, ordinal: int) -> None:
   213	        super().__init__(f"authorship unverified at ordinal {ordinal}: {message}")
   214	        self.ordinal = ordinal
