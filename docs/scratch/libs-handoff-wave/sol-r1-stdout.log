   201	def _no_duplicate_keys(pairs: list[tuple[str, object]]) -> dict:
   202	    """Build the object, refusing a key spelled twice.
   203	
   204	    ``json.loads`` resolves duplicates last-wins, so ``"id":"A","id":"B"``
   205	    decodes as ``B`` — two different lines with two different meanings that
   206	    a reader silently collapses to one. A canonical log admits exactly one
   207	    spelling per record; ambiguity is corruption, not a parse detail.
   208	    """
   209	    obj: dict = {}
   210	    for key, value in pairs:
   211	        if key in obj:
   212	            raise JsonlCodecError(f"duplicate key {key!r} in line")
