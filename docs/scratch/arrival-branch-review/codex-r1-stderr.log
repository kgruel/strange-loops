   575	def probe_arrival(depth: int) -> list[Sample]:
   576	    """The cut C surfaces, characterized at `depth` — the pre-ship benchmark.
   577	
   578	    Four receipted families: ordered() under each Ordering, the payload-key
   579	    parse cost (the bykey_payload vs bykey_ts delta), the CAS head walk, and
   580	    the derived-log merge driver. Scoped to the receipted item, no wider.
   581	    """
   582	    samples: list[Sample] = []
   583	    with tempfile.TemporaryDirectory() as tmpdir:
   584	        tmp = Path(tmpdir)
   585	        ordered_path = tmp / "ordered.db"
   586	        store = _new_store(ordered_path)
   587	        for i in range(depth):
   588	            store.append(_fact(i))
   589	        store.close()
   590	        samples.extend(_ordered_probes(ordered_path, depth))
   591	        samples.append(_cas_head_probe(tmp, depth))
   592	        samples.append(_merge_probe(tmp, depth))
   593	    return samples
