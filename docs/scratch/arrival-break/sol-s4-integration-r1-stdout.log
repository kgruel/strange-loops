   121	def row_object_fault(
   122	    obj: dict,
   123	    *,
   124	    t: str,
   125	    frame: str,
   126	    fields: tuple[str, ...],
   127	    allowed: frozenset[str],
   128	    nullable: frozenset[str],
   129	    skip_fields: frozenset[str] = frozenset(),
   130	) -> str | None:
   131	    """Why ``obj`` is not a well-formed row object, or None when it is.
   132	
   133	    Minimal seam: ``skip_fields`` allows callers (such as inventory batch
   134	    validation) to validate row structure, typing, and invariants while
   135	    excluding specific fields (e.g. ``observer``) from presence checks,
   136	    enabling inventory classification of absent vs mixed conditions without
   137	    duplicating the row grammar.
   138	    """
   139	    unknown = sorted(set(obj) - allowed)
   140	    if unknown:
   141	        return f"unknown field(s) in {t} {frame}: {unknown}"
   142	    checked_fields = [f for f in fields if f not in skip_fields]
   143	    missing = [f for f in checked_fields if f not in obj]
   144	    if missing:
   145	        return f"missing field(s) in {t} {frame}: {missing}"
   146	    for field in checked_fields:
   147	        value = obj[field]
   148	        if value is None:
   149	            if field not in nullable:
   150	                return f"{t} field {field!r} must not be null"
   151	            continue
