   374	def test_rejected_insert_never_orphans_a_line(tmp_path):
   375	    """A duplicate id must fail BEFORE the line is durable.
   376	
   377	    The INSERT is staged first precisely so a refused append cannot leave a
   378	    line the index doesn't name — otherwise the next successful append would
   379	    stamp the offset past the orphan and the index would stop being a
   380	    function of the log, silently.
   381	    """
   382	    import sqlite3
   383	
   384	    store = open_store(tmp_path)
   385	    log = log_path_for(store._path)
   386	    first = store.append(fact(message="one"))
   387	
   388	    with pytest.raises(sqlite3.IntegrityError):
   389	        store.append(fact(message="dup"), id_override=first)
   390	    assert len(lines(log)) == 1  # no orphan line
   391	
   392	    third = store.append(fact(message="three"))
   393	    assert offset_of(store) == log.stat().st_size
   394	    store.close()
   395	
   396	    reopened = open_store(tmp_path)
   397	    assert reopened.catch_up() == "synced"
   398	    assert [r[0] for r in sqlite_facts(reopened._path)] == [first, third]
   399	    reopened.close()
