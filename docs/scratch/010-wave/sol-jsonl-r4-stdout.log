   212	def tick_line(tick: dict) -> "Block":
   213	    """Render a single tick dict as a styled Block.
   214	
   215	    Default: `  HH:MM ⚡ task-name status` with status colored by outcome.
   216	    The ⚡ and status color distinguish ticks from regular fact lines.
   217	    Accepts a tick dict (from tick_to_dict or fetch functions).
   218	    """
   219	    from painted.core.block import Block
