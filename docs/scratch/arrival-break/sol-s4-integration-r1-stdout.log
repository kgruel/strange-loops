diff --git a//tmp/sol-s4-r1/probe_gf3_multiclass.py b//tmp/sol-s4-r1/probe_gf3_multiclass.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2194afa63688b37ccbe7db120c87a04bac35dc9
--- /dev/null
+++ b//tmp/sol-s4-r1/probe_gf3_multiclass.py
@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+from migrate import LegacySourceRefused, inventory
+
+
+root = Path("/tmp/sol-s4-r1/gf3")
+root.mkdir(parents=True, exist_ok=True)
+source = root / "multi-class.jsonl"
+target = root / "must-not-exist.arrival"
+if target.exists():
+    target.unlink()
+
+
+def fact(row_id: str, observer: str) -> dict[str, object]:
+    return {
+        "t": "fact",
+        "id": row_id,
+        "kind": "probe",
+        "ts": 1.0,
+        "observer": observer,
+        "origin": "probe",
+        "payload": "{}",
+    }
+
+
+source.write_text(
+    json.dumps(
+        {
+            "t": "batch",
+            "rows": [
+                fact("a", "alice"),
+                fact("b", "bob"),
+                fact("c", ""),
+            ],
+        },
+        separators=(",", ":"),
+    )
+    + "\n",
+    encoding="utf-8",
+)
+
+try:
+    inventory(source)
+except LegacySourceRefused as exc:
+    print(f"codec_invalid_lines={exc.codec_invalid_lines!r}")
+    print(f"mixed_observer_lines={exc.mixed_observer_lines!r}")
+    print(f"absent_observer_lines={exc.absent_observer_lines!r}")
+    print(f"target_exists={target.exists()}")
+    if (
+        exc.mixed_observer_lines == ((1, ("alice", "bob"), 1),)
+        and exc.absent_observer_lines == ((1, 1, ("alice", "bob"), {"empty": 1}),)
+        and not target.exists()
+    ):
+        print("PASS: every applicable class enumerated with empty spelling preserved")
+        raise SystemExit(0)
+    print("FAIL: the offending line was not enumerated in every applicable class")
+    raise SystemExit(1)
+else:
+    print("FAIL: defective mixed+empty batch was accepted")
+    raise SystemExit(2)
diff --git a//tmp/sol-s4-r1/probe_resume_authored_at.py b//tmp/sol-s4-r1/probe_resume_authored_at.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1204857cd750122616a70185ac1941019dc948a
--- /dev/null
+++ b//tmp/sol-s4-r1/probe_resume_authored_at.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from custody.signing import ARRIVAL_DOMAIN
+from engine.arrival import mint_lineage
+from engine.arrival_contract import RecordDraft, StoreDescriptor
+from engine.arrival_registry import BackendRegistry
+from lang import parse_vertex_file
+from migrate import identity, run_migration, transform
+from sign import ed25519
+
+
+root = Path("/tmp/sol-s4-r1/resume-authored-at")
+root.mkdir(parents=True, exist_ok=True)
+for path in root.rglob("*"):
+    if path.is_file():
+        path.unlink()
+
+keypair = ed25519.load_or_generate(root / "keys" / "alice")
+public_key = keypair.public_b64
+
+
+def signer(observer: str, digest: str) -> str | None:
+    assert observer == "alice"
+    return ed25519.sign(keypair, digest.encode(), domain=ARRIVAL_DOMAIN)
+
+
+source = root / "legacy.jsonl"
+source.write_text(
+    json.dumps(
+        {
+            "t": "fact",
+            "id": "legacy-id",
+            "kind": "probe",
+            "ts": 1.0,
+            "observer": "alice",
+            "origin": "probe",
+            "payload": "{}",
+        },
+        separators=(",", ":"),
+    )
+    + "\n",
+    encoding="utf-8",
+)
+vertex = root / "project.vertex"
+vertex.write_text(
+    f'''name "alice"
+store "./legacy.jsonl"
+observers {{
+  alice {{
+    key "{public_key}"
+  }}
+}}
+loops {{
+  probe {{ fold {{ items "collect" 10 }} }}
+}}
+''',
+    encoding="utf-8",
+)
+expected = transform(
+    source, parse_vertex_file(vertex), identity(), signer=signer
+).drafts[0]
+
+lineage = mint_lineage()
+target = root / f"{lineage}.arrival"
+ledger, _query = BackendRegistry.with_builtin_backends().open(
+    StoreDescriptor(backend="file", location=str(target), lineage=lineage)
+)
+head = ledger.mint(
+    {
+        "observer": "alice",
+        "signer": signer,
+        "key": public_key,
+        "lineage": lineage,
+        "at": 0.0,
+    }
+)
+wrong_at = expected.authored_at + 999.0
+head = ledger.append(
+    head,
+    [
+        RecordDraft(
+            kind=expected.kind,
+            authored_at=wrong_at,
+            observer=expected.observer,
+            origin=expected.origin,
+            body=expected.body,
+            signature=None,
+        )
+    ],
+).after
+before = target.read_bytes()
+outcome = run_migration(
+    source,
+    vertex,
+    store_dir=root,
+    signer=signer,
+    transform_rule=identity(),
+    resume_target=target,
+)
+actual_at = list(ledger.scan(through=outcome.head))[1]["at"]
+print(f"expected_authored_at={expected.authored_at!r}")
+print(f"resumed_target_authored_at={actual_at!r}")
+print(f"target_bytes_unchanged={target.read_bytes() == before}")
+if actual_at == expected.authored_at:
+    print("PASS: resume derived the complete expected draft")
+    raise SystemExit(0)
+print("FAIL: resume accepted and published a non-byte-identical draft timestamp")
+raise SystemExit(1)
diff --git a//tmp/sol-s4-r1/probe_resume_outer_signature.py b//tmp/sol-s4-r1/probe_resume_outer_signature.py
