   153	def _json_default(obj: object) -> object:
   154	    """Handle MappingProxyType in JSON serialization."""
   155	    from types import MappingProxyType
   156	    if isinstance(obj, MappingProxyType):
   157	        return dict(obj)
   158	    raise TypeError(f"Object of type {type(obj).__name__} is not JSON serializable")
