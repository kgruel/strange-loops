   129	def _child_topology_entry(ref_ast: Any, vpath: Path, base_dir: Path) -> dict:
   130	    """Build a topology entry dict for a single child vertex."""
   131	    from lang.ast import FoldBy
   132	
   133	    kind_keys: dict[str, str] = {}
   134	    for kind_name, loop_def in ref_ast.loops.items():
   135	        for fold_decl in loop_def.folds:
   136	            if isinstance(fold_decl.op, FoldBy):
   137	                kind_keys[kind_name] = fold_decl.op.key_field
   138	                break
   139	
   140	    store_str = ""
   141	    if ref_ast.store is not None:
   142	        sp = resolved_index(ref_ast.store, vpath)
   143	        store_str = str(sp)
   144	
   145	    try:
   146	        rel_path = str(vpath.relative_to(base_dir))
   147	    except ValueError:
   148	        rel_path = str(vpath)
   149	
   150	    return {
   151	        "name": ref_ast.name,
   152	        "path": rel_path,
   153	        "store": store_str,
   154	        "kind_keys": kind_keys,
   155	    }
   156	
   157	
   158	def _collect_topology_info(ast: Any, vertex_path: Path) -> list[dict]:
   159	    """Collect topology info for each child vertex in a discover/combine walk.
   160	
   161	    Returns a list of dicts with keys: name, path, store, kind_keys.
   162	    """
   163	    from lang import resolve_vertex
   164	
   165	    children: list[dict] = []
   166	    base_dir = vertex_path.parent
   167	
   168	    if ast.discover is not None:
   169	        for match in sorted(base_dir.glob(ast.discover)):
   170	            if match.suffix != ".vertex" or match.resolve() == vertex_path.resolve():
   171	                continue
   172	            try:
   173	                ref_ast = load_declaration(match)
   174	            except Exception:
   175	                continue
   176	            children.append(_child_topology_entry(ref_ast, match, base_dir))
   177	
   178	    elif ast.combine is not None:
   179	        home = _loops_home()
   180	        for entry in ast.combine:
   181	            vpath = resolve_vertex(entry.name, home)
   182	            if not vpath.is_absolute():
   183	                vpath = (base_dir / vpath).resolve()
   184	            if not vpath.exists():
   185	                continue
   186	            try:
   187	                ref_ast = load_declaration(vpath)
   188	            except Exception:
   189	                continue
   190	            children.append(_child_topology_entry(ref_ast, vpath, base_dir))
   191	
   192	    return children
   193	
   194	
   195	def emit_topology(vertex_path: Path) -> None:
   196	    """Walk discover/combine children and emit _topology facts to the aggregation's store.
   197	
   198	    Each discovered child becomes a _topology fact with name, path, store,
   199	    and kind_keys. Uses upsert fold (by name), so re-emission is idempotent.
   200	
   201	    Requires the vertex to have a store declaration.
   202	    """
   203	    ast = load_declaration(vertex_path)
   204	    if ast.store is None:
   205	        return
   206	
   207	    children = _collect_topology_info(ast, vertex_path)
   208	    if not children:
   209	        return
   210	
   211	    # open_canonical_store, not SqliteStore: under a JSONL-canonical vertex a
   212	    # direct sqlite write here would be an out-of-band insert, invisible to
   213	    # the log and caught (loudly) by the next open's count check.
   214	    from .jsonl_store import open_canonical_store
   215	
   216	    store = open_canonical_store(
   217	        canonical_store_path(ast.store, vertex_path),
   218	        serialize=lambda d: d,
   219	        deserialize=lambda d: d,
   220	    )
   221	
   222	    try:
   223	        ts = _time.time()
   224	        for child in children:
   225	            store.append({
   226	                "kind": "_topology",
   227	                "ts": ts,
   228	                "observer": ast.name,
   229	                "origin": "",
   230	                "payload": child,
   231	            })
   232	    finally:
   233	        store.close()
