    50	def _open(path: Path, *, read_only: bool = False) -> sqlite3.Connection:
    51	    """Open a store database.
    52	
    53	    Read-only mode uses URI to avoid WAL/SHM sidecars.
    54	    Write mode sets WAL journal and NORMAL synchronous.
    55	    """
    56	    if read_only:
    57	        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    58	    else:
    59	        conn = sqlite3.connect(str(path))
    60	        conn.execute("PRAGMA journal_mode=WAL")
    61	        conn.execute("PRAGMA synchronous=NORMAL")
    62	    return conn
    63	
    64	
    65	def _create(path: Path) -> sqlite3.Connection:
    66	    """Create a fresh store with canonical schema.
    67	
    68	    Parent directories are created if needed.
    69	    Raises FileExistsError if the database file already exists.
    70	    """
    71	    path = Path(path)
    72	    if path.exists():
    73	        raise FileExistsError(f"Store already exists: {path}")
    74	    path.parent.mkdir(parents=True, exist_ok=True)
    75	    conn = sqlite3.connect(str(path))
    76	    conn.execute("PRAGMA journal_mode=WAL")
    77	    conn.execute("PRAGMA synchronous=NORMAL")
    78	    conn.executescript(_SCHEMA)
    79	    return conn
