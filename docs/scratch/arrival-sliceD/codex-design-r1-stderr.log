   290	@dataclass(frozen=True)
   291	class DerivedLogAgreement:
   292	    """Whether the derived log and the arrival log hold the same set.
   293	
   294	    There is **no staleness marker**. The offset/count triple does not get a
   295	    third sibling: the derived log's currency is a SET question, and the
   296	    honest answer to a set question is a set comparison, not a stamp. A
   297	    marker would also reintroduce offset custody inside the mutable artifact
   298	    being judged.
   299	    """
   300	
   301	    ok: bool
   302	    missing: int
   303	    """Row-class records the arrival log carries and the file does not.
   304	
   305	    Structural records are outside the projection, so a healthy store is
   306	    never reported as missing its genesis.
   307	    """
   308	    extra: int
   309	    """Lines the arrival log never carried."""
   310	    detail: str
   311	
   312	
   313	def _derived_digests(canonical: Path) -> set[bytes]:
   314	    """Digest every line the arrival log projects, retaining none of them.
   315	
   316	    Deliberately NOT ``{_digest(line) for line in derived_lines(...)}``:
   317	    :func:`derived_lines` must materialize every line because it SORTS them,
   318	    and an audit that borrowed it inherited a cost it does not need. Here
   319	    each line is produced, hashed, and dropped, so what survives the walk is
   320	    32 bytes per record.
   321	
   322	    The bound, stated exactly rather than loosely: peak is **flat in record
   323	    count** and **linear in the size of the LARGEST single record**. What
   324	    survives the walk is 32 bytes per record; what is in flight is one
   325	    record, which costs a small multiple of its own size because it is
   326	    decoded, re-encoded and hashed. Measured: 5, 10, 20 and 40 records of
   327	    1 MB each all peak at 7.02 MB, while one 4 MB record peaks at 28 MB.
   328	
   329	    So "bounded by record count, never payload size" holds in the sense
   330	    that matters — an audit over a big store does not grow with the store —
   331	    but a single enormous record is still transiently expensive, and saying
   332	    otherwise would be the kind of unbounded promise this module refuses to
   333	    make elsewhere.
   334	    """
   335	    digests: set[bytes] = set()
   336	    for record in ArrivalLog(canonical).walk():
   337	        line = line_of_record(record)
   338	        if line is not None:
   339	            digests.add(_digest(line))
   340	    return digests
   341	
   342	
   343	def audit_derived_log(canonical: Path) -> DerivedLogAgreement:
   344	    """Re-derive and diff. An operation, not a promise.
   345	
   346	    The repo's established contract for derived artifacts (``verify_rebirth``
   347	    is the precedent). Each side's lines are hashed to 32 bytes as they are
   348	    produced and two set differences taken, so memory is bounded by RECORD
   349	    COUNT and never by total payload size — see :func:`_derived_digests` for
   350	    the exact bound.
   351	
   352	    The reported counts survive digest-only sets, because a set difference
   353	    over digests has the same cardinality as one over the lines they stand
   354	    for. Nothing in :class:`DerivedLogAgreement` echoes line CONTENT — the
   355	    detail names paths and counts — so the result is bounded too.
   356	    """
   357	    canonical = Path(canonical)
   358	    target = derived_log_path_for(canonical)
   359	    derived = _derived_digests(canonical)
   360	
   361	    if not target.exists():
   362	        return DerivedLogAgreement(
   363	            ok=not derived,
   364	            missing=len(derived),
   365	            extra=0,
   366	            detail=(
   367	                f"no derived log at {target}"
   368	                + ("" if not derived else f"; the arrival log projects {len(derived)} line(s)")
   369	            ),
   370	        )
   371	
   372	    present = set()
   373	    with target.open("rb") as fh:
   374	        for raw in fh:
   375	            if raw.endswith(b"\n"):
   376	                present.add(hashlib.sha256(raw[:-1]).digest())
   377	            elif raw:
   378	                # A torn tail is not a line: it was never terminated, so it
   379	                # never claimed to be a record. Counting it as `extra` would
   380	                # report a crashed derivation as a disagreement about
   381	                # content; the honest reading is that the file is short.
   382	                pass
   383	
   384	    missing = len(derived - present)
   385	    extra = len(present - derived)
   386	    ok = not missing and not extra
   387	    return DerivedLogAgreement(
   388	        ok=ok,
   389	        missing=missing,
   390	        extra=extra,
   391	        detail=(
   392	            f"{target} agrees with {canonical}"
   393	            if ok
   394	            else (
   395	                f"{target} disagrees with {canonical}: {missing} record(s) the "
   396	                f"arrival log carries are absent, {extra} line(s) it never "
   397	                "carried are present"
   398	            )
   399	        ),
   400	    )
   401	
   402	
   403	def _digest(line: str) -> bytes:
   404	    return hashlib.sha256(line.encode("utf-8")).digest()
   405	
   406	
   407	def licensed_own_lineage(conn: sqlite3.Connection, lineage: str) -> str | None:
   408	    """The ``own_lineage`` value this index's rows license, or None.
   409	
   410	    The stamp is licensed by a **consumed ``_decl.genesis`` fact row whose
   411	    id is the log's lineage** — movement 2, the declaration absorb, which is
   412	    what stamps the marker on the live path. Two narrowings, both
   413	    load-bearing:
   414	
   415	    * NOT the mere existence of the arrival genesis at ordinal 0 (movement
   416	      1). Stamping on that would flip a minted-but-never-absorbed store to
   417	      "adopted", and ``witness.durable_handle`` would start emitting
   418	      portable handles for stores that never opened a declaration lineage —
   419	      a witness-semantics widening that is not this cut's.
   420	    * NOT any ``_decl.genesis`` row. A merged store's log can carry a
   421	      FOREIGN genesis row verbatim, and stamping that would mint the
   422	      "marker without its genesis" corruption the declaration resolver
   423	      already names.
   424	
   425	    Restricted this way the stamp is a pure projection restore with zero
   426	    semantic change.
   427	    """
   428	    from lang.document import DECL_GENESIS
   429	
   430	    row = conn.execute(
   431	        "SELECT id FROM facts WHERE id = ? AND kind = ?", (lineage, DECL_GENESIS)
   432	    ).fetchone()
   433	    return None if row is None else row[0]
