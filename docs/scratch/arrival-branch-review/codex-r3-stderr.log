    98	# The resume mark's three store_meta keys — the ratified fields and no
    99	# others. The old cursor custody's row counts deliberately do not return:
   100	# the ordinal is dense, so "how many records precede this one" is ``ord``,
   101	# by construction.
   102	ARRIVAL_LINEAGE_KEY = "arrival_lineage"
   103	ARRIVAL_OFFSET_KEY = "arrival_offset"
   104	ARRIVAL_ORDINAL_KEY = "arrival_ordinal"
