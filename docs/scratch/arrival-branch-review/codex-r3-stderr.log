  1645	        else:

--- arrival projection core ---
   110	
   111	def has_rows(conn: sqlite3.Connection) -> bool:
   112	    """Does this index carry any fact or tick row?
   113	
   114	    The one spelling for both log-canonical stores. It is the predicate that
   115	    separates "an absent projection, which builds automatically because
   116	    building it destroys nothing" from "an existing projection carrying
   117	    state, whose re-derivation is an operator's decision" — so the two
   118	    stores asking it differently would be two answers to the question this
   119	    cut is about.
   120	    """
   121	    for table in ("facts", "ticks"):
   122	        if conn.execute(f"SELECT EXISTS(SELECT 1 FROM {table})").fetchone()[0]:
   123	            return True
   124	    return False
   125	
   126	
   127	def _projects(record: dict) -> bool:
   128	    """Does this record project at all — and is it a record we may project?
   129	
   130	    The classification BOTH projections make, spelled once. It is the same
   131	    question in both directions (an index row and a derived-log line are two
   132	    encodings of one row-class body), and the two projections answering it
   133	    separately is how they would come to disagree about a store.
   134	
   135	    ``False`` is the structural class — genesis, key introductions. Their
   136	    bodies are not codec objects at all (the codec refuses them on unknown
   137	    fields), and skipping them loses nothing: their content lives in the
   138	    arrival log, which is the store. An unrecognized kind is neither class
   139	    and refuses here, once, for both callers.
   140	    """
   141	    kind = record["k"]
   142	    if kind in _STRUCTURAL_KINDS:
   143	        return False
   144	    if kind not in _ROW_KINDS:
   145	        _unsupported(
   146	            f"record kind {kind!r} at ordinal {record['ord']} is not one "
   147	            "this store's projections know how to derive — refusing rather "
   148	            "than silently dropping it"
   149	        )
   150	    return True
   151	
   152	
   153	def rows_of_record(record: dict) -> list[tuple[str, tuple]]:
   154	    """The index rows one arrival record expands to, in order.
   155	
   156	    ONE definition of "what a record indexes to", consumed by both the
   157	    catch-up indexer and the re-deriver. Two definitions is how the writer
   158	    and the re-deriver end up disagreeing about a store, which is the one
   159	    disagreement this cut cannot tolerate.
   160	
   161	    Structural records expand to **no rows** — see :func:`_projects`, which
   162	    is also where an unknown kind is refused.
   163	    """
   164	    if not _projects(record):
   165	        return []
   166	    return records_from_object(record["body"])
   167	
   168	
   169	# --- the derived .jsonl log --------------------------------------------------
   170	
   171	
   172	def derived_log_path_for(canonical: Path) -> Path:
   173	    """Where an arrival log's derived ``.jsonl`` projection lives.
   174	
   175	    ``<name>.jsonl`` beside the ``<name>.arrival`` — NO new suffix. This is
   176	    the shape :func:`engine.probe.probe_target` already classifies as
   177	    ``derived_log`` ("custody is the arrival log's, so this file is a
   178	    projection, not a store"). Cut A named the half-migrated shape; cut B is
   179	    what makes it deliberate rather than transitional, and a
   180	    ``.derived.jsonl`` spelling would strand the classification and break
   181	    every last-0.x reader the projection exists for.
   182	    """
   183	    return canonical_for(index_path_for(canonical), "jsonl")
   184	
   185	
   186	def line_of_record(record: dict) -> str | None:
   187	    """The derived log's line for one arrival record, or None for no line.
   188	
   189	    Row-class records (fact/tick/batch) each emit ONE line — the codec
   190	    encoding of that record's ``body`` and of nothing else. Because the body
   191	    IS the codec's object for the committed row, re-encoding it is an
   192	    identity round trip and the payload keeps riding as verbatim stored
   193	    TEXT. A batch record's body emits as one ``batch`` line, unchanged.
   194	
   195	    **NON-NEGOTIABLE: structural records (genesis, key introduction) have no
   196	    derived-log line**, exactly as the index skips them — their bodies are
   197	    not codec objects at all. Their content is not lost: it lives in the
   198	    arrival log, which is the store.
   199	
   200	    Not "the same arms as :func:`rows_of_record`" but literally the same
   201	    call: both wrap :func:`_projects` and differ only in the terminal codec
   202	    encoding, so the index and the derived log cannot disagree about which
   203	    records project.
   204	    """
   205	    if not _projects(record):
   206	        return None
   207	    return serialize_object(record["body"])
   208	
   209	
   210	def canonical_line(line: str) -> str:
   211	    """One derived-log line in its canonical form, validated.
   212	
   213	    The grammar and the sort key have ONE home. A consumer that rewrites a
   214	    derived log — the git merge driver is the only one — imports this rather
   215	    than re-spelling "decode, validate, re-encode in field order", so driver
   216	    output and a fresh derivation cannot drift.
   217	    """
   218	    return serialize_object(json.loads(line))
   219	
   220	
   221	def sort_key(line: str) -> bytes:
   222	    """The derived log's ordering: byte-lexicographic over the encoded line.
   223	
   224	    Spelled as a function because the ORDER IS A RULE, not an incidental
   225	    ``sorted()`` call — the merge driver must sort by exactly what a fresh
   226	    derivation sorts by.
   227	    """
   228	    return line.encode("utf-8")
   229	
   230	
   231	def derived_lines(log: ArrivalLog) -> list[str]:
   232	    """Every derived-log line for an arrival log, byte-lexicographically sorted.
   233	
   234	    **NON-NEGOTIABLE: line order carries no meaning, and no reader may
   235	    attribute one to it.** Byte sort is the only order that is a pure
   236	    function of the SET: it needs no field semantics, is reproducible by
   237	    ``sort(1)`` in any language, and is what lets the git merge driver
   238	    produce the same bytes a fresh derivation produces without knowing any
   239	    ordinal.
   240	
   241	    Two consequences, stated here rather than left to be found:
   242	
   243	    1. **The derived log is not a chain-verification surface.** Tick chain
   244	       order is not file order — a chain walk over a byte-sorted projection
   245	       would report breaks on a healthy store. Chain verification reads the
   246	       arrival log.
   247	    2. **A last-0.x reader rebuilding from this file folds in byte order.**
   248	       That is a real interim hazard for the migration sidecar, and it is
   249	       named here for that design; the sidecar's own answer is to consume
   250	       the ``.arrival``, which carries the ordinal.
   251	
   252	    **NON-NEGOTIABLE: derived from the arrival log alone, never from the
   253	    index.** Deriving it from sqlite would make it a projection of a
   254	    projection, and a poisoned index would launder itself into a second
   255	    artifact.
   256	    """
   257	    lines = set()
   258	    for record in log.walk():
   259	        line = line_of_record(record)
   260	        if line is not None:
   261	            lines.add(line)
   262	    return sorted(lines, key=sort_key)
   263	
   264	
   265	def write_derived_log(canonical: Path) -> int:
   266	    """Materialize the derived ``.jsonl`` projection. Returns the line count.
   267	
   268	    **NON-NEGOTIABLE: on demand only, never on the append path.** Appending
   269	    to a byte-sorted file is not an append, and regenerating it per emit is
   270	    O(n) per write — the O(n^2) ingest shape this arc already paid for once.
   271	    A lagging derived log is NOT an error: nothing in ``libs/`` reads it,
   272	    because reads execute through the index in every mode (arrival law 1).
   273	
   274	    Written through a temp file and renamed, so a crash mid-derivation
   275	    leaves the previous projection rather than a truncated one.
   276	    """
   277	    canonical = Path(canonical)
   278	    target = derived_log_path_for(canonical)
   279	    lines = derived_lines(ArrivalLog(canonical))
   280	    tmp = target.with_name(target.name + ".tmp")
   281	    payload = "".join(line + "\n" for line in lines)
   282	    with tmp.open("w", encoding="utf-8") as fh:
   283	        fh.write(payload)
   284	        fh.flush()
   285	        os.fsync(fh.fileno())
   286	    tmp.replace(target)
   287	    return len(lines)
   288	
