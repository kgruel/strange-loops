  1000	        newline, tracked from the handle's position at entry so a consumer
  1001	        (:meth:`walk_marked`) can persist an exact resume mark. The public
  1002	        walks project the record out.
  1003	        """
  1004	        offset = fh.tell()
  1005	        for raw in fh:
  1006	            if not raw.endswith(b"\n"):
  1007	                return  # in flight, or torn — either way not the reader's to judge
  1008	            offset += len(raw)
  1009	            try:
  1010	                record = decode_record(raw[:-1])
  1011	            except ArrivalGrammarError as exc:
  1012	                raise ArrivalCorrupt(str(exc), expected) from exc
  1013	            fault = _placement_fault(record, expected)
  1014	            if fault is not None:
  1015	                raise ArrivalCorrupt(fault, expected)
