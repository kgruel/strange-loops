from engine.jsonl_store import JsonlStore

for attempt in range(20):
  with TemporaryDirectory(dir='/tmp') as d:
    root=Path(d); db=root/'x.db'; log=root/'x.jsonl'
    seed=JsonlStore(path=db,log_path=log,serialize=lambda f:f.to_dict(),deserialize=Fact.from_dict)
    seed.append(Fact.of('k','o',n=1)); seed.close()
    db.write_bytes(b'not sqlite\\n'*100)
    for s in ('-wal','-shm'):
      Path(str(db)+s).unlink(missing_ok=True)
    bar=Barrier(2); orig=Path.unlink; seen={}; lk=Lock(); results=[]
    def patched(self,*a,**kw):
      if self==db:
        tid=__import__('threading').get_ident()
        with lk:
          first=tid not in seen; seen[tid]=1
        if first: bar.wait(timeout=5)
      return orig(self,*a,**kw)
    Path.unlink=patched
    def run():
      try:
        s=JsonlStore(path=db,log_path=log,serialize=lambda f:f.to_dict(),deserialize=Fact.from_dict)
        results.append(('ok',s));
