   150	def _collect_topology_info(ast: Any, vertex_path: Path) -> list[dict]:
   151	    """Collect topology info for each child vertex in a discover/combine walk.
   152	
   153	    Returns a list of dicts with keys: name, path, store, kind_keys.
   154	    """
   155	    from lang import resolve_vertex
   156	
   157	    children: list[dict] = []
   158	    base_dir = vertex_path.parent
   159	
   160	    if ast.discover is not None:
   161	        for match in sorted(base_dir.glob(ast.discover)):
   162	            if match.suffix != ".vertex" or match.resolve() == vertex_path.resolve():
   163	                continue
   164	            try:
   165	                ref_ast = load_declaration(match)
   166	            except Exception:
   167	                continue
   168	            children.append(_child_topology_entry(ref_ast, match, base_dir))
   169	
   170	    elif ast.combine is not None:
   171	        home = _loops_home()
   172	        for entry in ast.combine:
   173	            vpath = resolve_vertex(entry.name, home)
   174	            if not vpath.is_absolute():
   175	                vpath = (base_dir / vpath).resolve()
   176	            if not vpath.exists():
   177	                continue
   178	            try:
   179	                ref_ast = load_declaration(vpath)
   180	            except Exception:
   181	                continue
   182	            children.append(_child_topology_entry(ref_ast, vpath, base_dir))
   183	
   184	    return children
   185	
   186	
   187	def emit_topology(vertex_path: Path) -> None:
   188	    """Walk discover/combine children and emit _topology facts to the aggregation's store.
   189	
   190	    Each discovered child becomes a _topology fact with name, path, store,
   191	    and kind_keys. Uses upsert fold (by name), so re-emission is idempotent.
   192	
   193	    Requires the vertex to have a store declaration.
   194	    """
   195	    ast = load_declaration(vertex_path)
   196	    if ast.store is None:
   197	        return
   198	
   199	    children = _collect_topology_info(ast, vertex_path)
   200	    if not children:
   201	        return
   202	
   203	    # open_canonical_store, not SqliteStore: under a JSONL-canonical vertex a
   204	    # direct sqlite write here would be an out-of-band insert, invisible to
   205	    # the log and caught (loudly) by the next open's count check.
   206	    from .jsonl_store import open_canonical_store
   207	
   208	    store = open_canonical_store(
   209	        canonical_store_path(ast.store, vertex_path),
   210	        serialize=lambda d: d,
   211	        deserialize=lambda d: d,
   212	    )
   213	
   214	    try:
   215	        ts = _time.time()
   216	        for child in children:
   217	            store.append({
   218	                "kind": "_topology",
   219	                "ts": ts,
   220	                "observer": ast.name,
   221	                "origin": "",
   222	                "payload": child,
   223	            })
   224	    finally:
   225	        store.close()
