   375	def test_rejected_insert_never_orphans_a_line(tmp_path):
   376	    """A duplicate id must fail BEFORE the line is durable.
   377	
   378	    The INSERT is staged first precisely so a refused append cannot leave a
   379	    line the index doesn't name — otherwise the next successful append would
   380	    stamp the offset past the orphan and the index would stop being a
   381	    function of the log, silently.
   382	    """
   383	    import sqlite3
   384	
   385	    store = open_store(tmp_path)
   386	    log = log_path_for(store._path)
   387	    first = store.append(fact(message="one"))
   388	
   389	    with pytest.raises(sqlite3.IntegrityError):
   390	        store.append(fact(message="dup"), id_override=first)
   391	    assert len(lines(log)) == 1  # no orphan line
   392	
   393	    third = store.append(fact(message="three"))
   394	    assert offset_of(store) == log.stat().st_size
   395	    store.close()
   396	
   397	    reopened = open_store(tmp_path)
   398	    assert reopened.catch_up() == "synced"
   399	    assert [r[0] for r in sqlite_facts(reopened._path)] == [first, third]
   400	    reopened.close()
