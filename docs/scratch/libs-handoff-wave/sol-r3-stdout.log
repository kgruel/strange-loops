   441	
   442	def _scan_block(
   443	    lines: list[str], lo: int, hi: int, segment: str
   444	) -> tuple[int, int]:
   445	    """Scan lines[lo..hi] for a block matching segment. Brace-depth tracked.
   446	
   447	    Skips over nested children at depth>0 so we only match siblings of the
   448	    target's scope. Returns (start_line, end_line) inclusive.
   449	    """
   450	    start = -1
   451	    depth = 0
   452	    i = lo
   453	    while i <= hi:
   454	        stripped = lines[i].strip()
   455	        if start == -1:
   456	            # Only consider lines at depth 0 (sibling scope) as potential matches.
   457	            if _line_opens_matching_block(stripped, segment):
   458	                start = i
   459	                depth = stripped.count("{") - stripped.count("}")
   460	                if depth == 0:
   461	                    return start, i
   462	            else:
   463	                # Track depth changes from non-matching opens so we skip their bodies.
   464	                opens = stripped.count("{")
   465	                closes = stripped.count("}")
   466	                if opens > closes:
   467	                    # Skip this nested block's body entirely.
   468	                    body_depth = opens - closes
   469	                    j = i + 1
   470	                    while j <= hi and body_depth > 0:
   471	                        body_depth += lines[j].count("{") - lines[j].count("}")
   472	                        j += 1
   473	                    i = j
   474	                    continue
   475	        else:
   476	            depth += stripped.count("{") - stripped.count("}")
   477	            if depth <= 0:
   478	                return start, i
   479	        i += 1
   480	
   481	    if start != -1:
   482	        raise ValueError(f"Unclosed block for segment {segment!r}")
   483	    raise ValueError(f"Block not found for segment {segment!r}")
   484	
   485	
   486	def _detect_indent(lines: list[str], start: int, end: int) -> str:
   487	    """Detect indentation of children within a block."""
   488	    for i in range(start + 1, end + 1):
   489	        stripped = lines[i].strip()
   490	        if stripped and stripped != "}":
   491	            return lines[i][: len(lines[i]) - len(lines[i].lstrip())]
   492	    # Fallback: parent line indent + 2 spaces
   493	    parent_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   494	    return parent_indent + "  "
   495	
   496	
   497	def kdl_split_top_level_nodes(inner: str) -> list[str]:
   498	    """Split single-line KDL children into their top-level nodes.
   499	
   500	    Quote-aware (including ``\\"`` escapes) and brace-depth-aware: splits at
   501	    depth-0 ``;`` separators, and at the boundary after a depth-0 ``}`` when
   502	    the next node starts without a ``;`` (``decision { } task { }``).
   503	    Content inside strings or nested braces is never split.
   504	    """
   505	    nodes: list[str] = []
   506	    buf: list[str] = []
   507	    depth = 0
   508	    in_str = False
   509	    esc = False
   510	    node_closed = False  # buf holds a balanced node ended by a depth-0 '}'
   511	
   512	    def _flush() -> None:
   513	        nonlocal buf, node_closed
   514	        s = "".join(buf).strip()
   515	        if s:
   516	            nodes.append(s)
   517	        buf = []
   518	        node_closed = False
   519	
   520	    for ch in inner:
   521	        if in_str:
   522	            buf.append(ch)
   523	            if esc:
   524	                esc = False
   525	            elif ch == "\\":
   526	                esc = True
   527	            elif ch == '"':
   528	                in_str = False
   529	            continue
   530	        if node_closed and not ch.isspace():
   531	            if ch == ";":
   532	                _flush()
   533	                continue
   534	            _flush()
   535	        if ch == '"':
   536	            in_str = True
   537	            buf.append(ch)
   538	            continue
   539	        if ch == "{":
   540	            depth += 1
   541	        elif ch == "}":
   542	            depth -= 1
   543	            if depth == 0:
   544	                buf.append(ch)
   545	                node_closed = True
   546	                continue
   547	        elif ch == ";" and depth == 0:
   548	            _flush()
   549	            continue
   550	        buf.append(ch)
   551	    _flush()
   552	    return nodes
   553	
