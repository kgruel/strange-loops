   804	def test_recovery_during_a_tick_leaves_the_chain_verifiable(tmp_path):
   805	    """Reconcile runs after mint — the chain must survive that ordering.
   806	
   807	    append_tick derives prev_hash/window_hash/fact_cursor from sqlite BEFORE
   808	    the row reaches _write, so a line recovered by the append-time reconcile
   809	    lands in the index after the in-flight tick has already committed to its
   810	    cursor. That is safe only because a tick's window is bounded by a fact
   811	    CURSOR, not a timestamp: the recovered row falls outside the sealed
   812	    window by construction and the next tick seals it. Pinned because the
   813	    alternative — a window hash that does not commit to a fact inside its
   814	    own window — would be corruption manufactured by the recovery path.
   815	    """
   816	    import time
   817	
   818	    store = open_store(tmp_path)
   819	    store.append(fact(message="one"))
   820	
   821	    # Writer A's line: durable, unindexed, timestamped inside the window the
   822	    # next tick would otherwise seal.
   823	    orphan = ("01CRASHEDA", "note", time.time(), "sol", "", json.dumps({"m": "two"}))
   824	    with (tmp_path / "s.jsonl").open("a", encoding="utf-8") as fh:
   825	        fh.write(serialize_fact_row(orphan) + "\n")
   826	
   827	    store.append_tick(
   828	        Tick(name="seal", ts=datetime.now(UTC), payload={"n": 1}, origin="t")
   829	    )
   830	    assert store.verify_chain()["ok"]
   831	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")][-1] == "01CRASHEDA"
   832	
   833	    # The next boundary seals the recovered fact, and the chain still holds.
   834	    store.append_tick(
   835	        Tick(name="seal", ts=datetime.now(UTC), payload={"n": 2}, origin="t")
   836	    )
   837	    assert store.verify_chain()["ok"]
   838	    cursors = [
   839	        r[0]
   840	        for r in store._conn.execute("SELECT fact_cursor FROM ticks ORDER BY rowid")
   841	    ]
   842	    assert cursors[1] == "01CRASHEDA"  # sealed by the second tick, not the first
   843	    store.close()
   844	
   845	    reopened = open_store(tmp_path)
   846	    assert reopened.catch_up() == "synced"
   847	    assert reopened.verify_chain()["ok"]
   848	    reopened.close()
