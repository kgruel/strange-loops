+        vertex_path=v_path,
+        store_dir=store_dir,
+        signer=cust.signer,
+    )
+    assert outcome.target_path.exists()
+    assert outcome.report_path.exists()
+    assert verify_migration_report(
+        outcome.report_path,
+        cust.public,
+        verify=cust.verify,
+        target_path=outcome.target_path,
