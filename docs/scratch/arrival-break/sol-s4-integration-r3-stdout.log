+        located = effective_store_clause(text, vertex)
+        before = vertex.read_bytes()
+        try:
+            edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+        except PublishPreconditionRefused as exc:
+            assert vertex.read_bytes() == before
+            print(
+                f"{case}: parsed_store={str(parsed.store)!r} count={located.count} "
+                f"span={located.span} edit=REFUSED condition={exc.condition} "
+                "file_unchanged=True"
+            )
+        else:
+            raise AssertionError(f"{case}: expected bounded refusal")
+
+    for index, text in enumerate(
+        (
+            'store "./legacy.jsonl" backend=r#"unterminated\n',
+            'store r#"unterminated\n',
+            'store "./legacy.jsonl" backend=r##"unterminated"#\n',
+        ),
+        1,
+    ):
+        vertex = root / f"unterminated_{index}.vertex"
+        vertex.write_text(text, encoding="utf-8")
+        before = vertex.read_bytes()
+        try:
+            effective_store_clause(text, vertex)
+        except ParseError:
+            direct = "ParseError"
+        else:
+            raise AssertionError(f"unterminated_{index}: direct locator accepted")
+        try:
+            edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+        except (ParseError, PublishPreconditionRefused) as exc:
+            assert vertex.read_bytes() == before
+            condition = getattr(exc, "condition", type(exc).__name__)
+            print(
+                f"unterminated_{index}: locator={direct} edit=REFUSED "
+                f"condition={condition} file_unchanged=True"
+            )
+        else:
+            raise AssertionError(f"unterminated_{index}: edit accepted")
+
+print("PASS: accepted raw-string cases have exact spans; bounded cases refuse unchanged")
