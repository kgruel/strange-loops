        "01FACT00000000000000000002",
        {
          "kind": "config",
          "ts": 30.0,
          "payload": {
            "setting": "theme",
            "color": "dark"
          },
          "observer": "kyle",
          "origin": ""
        }
      ],
      [
        "01FACT00000000000000000003",
        {
          "kind": "config",
          "ts": 20.0,
          "payload": {
            "setting": "theme",
            "color": "green"
          },
          "observer": "kyle",
          "origin": ""
        }
      ]
    ],
    "cursors": {
      "after_fact_1": "01FACT00000000000000000001",
      "after_fact_2": "01FACT00000000000000000002",
      "head": "head"
