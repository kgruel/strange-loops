   472	def _cas_head_probe(tmpdir: Path, depth: int) -> Sample:
   473	    """`declaration_head()` on an ArrivalStore whose log carries `depth` facts.
   474	
   475	    This is the CAS-token read the edit ceremony pays (twice per ceremony).
   476	    The design accepts a forward log walk here — "ceremonies are rare" — and
   477	    ruling 4 defers any index to a benchmark's justification. This is that
   478	    benchmark: the curve says what the walk costs at depth, so the acceptance
   479	    is a measured trade instead of a hopeful one.
   480	
   481	    The store is opened with a genesis (the walk returns None without one, and
   482	    a None head is a broken probe, not a fast one).
   483	    """
   484	    from atoms import Fact as AtomsFact
   485	    from engine.arrival import ArrivalLog
   486	    from engine.arrival_store import ArrivalStore
   487	    from lang import parse_vertex
   488	    from lang.document import vertex_to_documents
   489	
   490	    store_path = tmpdir / "cas.db"
   491	    log_path = tmpdir / "cas.arrival"
   492	    ArrivalLog.mint(log_path, observer="ledger", signer=_stub_sign, key=_stub_key())
   493	    src = 'name "ledger"\nstore "./cas.arrival"\nloops {\n  note { fold { items "collect" 100 } }\n}\n'
   494	    store = ArrivalStore(
   495	        path=store_path,
   496	        serialize=lambda f: f.to_dict(),
   497	        deserialize=AtomsFact.from_dict,
   498	        fact_signer=_stub_sign,
   499	    )
   500	    try:
   501	        store.absorb_genesis(
   502	            [d.as_json() for d in vertex_to_documents(parse_vertex(src))],
   503	            observer="ledger",
   504	            fact_signer=_stub_sign,
   505	        )
   506	        for i in range(depth):
   507	            store.append(_fact(i))
   508	
   509	        def walk() -> None:
   510	            if store.declaration_head() is None:
   511	                raise ProbeError("declaration_head returned None on an opened lineage")
   512	
   513	        return measure("arrival_cas_head_walk", "arrival", depth, walk)
   514	    finally:
   515	        store.close()
   516	
