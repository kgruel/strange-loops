   207	def _trim(row: tuple, n: int) -> tuple:
   208	    """A full-arity codec row cut to ``n`` fields, refusing to drop a value.
   209	
   210	    Dropping a *present* signature to match a signature-less index would make
   211	    a strip look like agreement, so the trailing fields must be ``None``.
   212	    """
   213	    if len(row) <= n:
   214	        return tuple(row)
   215	    if any(v is not None for v in row[n:]):
   216	        return tuple(row)  # arity mismatch → compares unequal, which is right
   217	    return tuple(row[:n])
