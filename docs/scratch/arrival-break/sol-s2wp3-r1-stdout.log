 _CAMEL = re.compile(r"(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])")
 _NAME_SEP = re.compile(r"[-_]+")
 _PROSE_SEP = re.compile(r"[^a-z0-9_]+")
 _NON_ALNUM = re.compile(r"[^a-z0-9]+")
 
