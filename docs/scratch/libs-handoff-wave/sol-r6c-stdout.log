   497	def kdl_split_top_level_nodes(inner: str) -> list[str]:
   498	    """Split single-line KDL children into their top-level nodes.
   499	
   500	    Quote-aware (including ``\\"`` escapes) and brace-depth-aware: splits at
   501	    depth-0 ``;`` separators, and at the boundary after a depth-0 ``}`` when
   502	    the next node starts without a ``;`` (``decision { } task { }``).
