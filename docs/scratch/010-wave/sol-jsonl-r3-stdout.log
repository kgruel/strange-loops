  1352	            window_start = ""  # new store: cover everything emitted so far
  1353	        elif prev_row[9] is None:
  1354	            window_start = fact_cursor  # pre-chain predecessor: epoch marker
  1355	        else:
  1356	            window_start = prev_row[8]
