    62	def _check_declared_ordering(ordering: Ordering | None, *, single_store: bool) -> None:
    63	    """Validate a declared read ordering against the axis this page path serves.
    64	
    65	    ``None`` is the whole of today's behavior: the defaults are already what the
    66	    paged read paths serve, so nothing reroutes. A DECLARED ordering must resolve
    67	    to that same axis — ``Arrival()`` single-store, ``ByKey('ts')`` aggregate,
    68	    with ``Arrival()`` on an aggregate refused by the one engine resolver. Any
    69	    other declared ordering is refused rather than approximated: ordering-aware
    70	    witness pagination is not this cut.
    71	
    72	    Raises:
    73	        SdkValueError: The ordering is refused, or names an axis paged reads do
    74	            not serve this cut.
    75	    """
    76	    if ordering is None:
    77	        return
    78	    try:
    79	        resolved = resolve_ordering(ordering, single_store=single_store)
    80	    except OrderingError as exc:
    81	        raise SdkValueError(str(exc)) from exc
    82	    served = resolve_ordering(None, single_store=single_store)
    83	    if resolved != served:
    84	        raise SdkValueError(
    85	            f"ordering {ordering!r} is not supported on a paged read this cut: "
    86	            f"this path serves {served!r}. Declare that, or omit ordering."
    87	        )
