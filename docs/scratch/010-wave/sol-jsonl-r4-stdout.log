   103	def emit_tick(path: Path, name: str, payload: dict, origin: str = "") -> None:
   104	    """Emit a tick into a store."""
   105	    from engine import Tick
   106	
   107	    tick = Tick(
   108	        name=name,
   109	        ts=datetime.now(timezone.utc),
   110	        payload=payload,
   111	        origin=origin,
   112	    )
   113	    with _open_store(path, lambda x: x, lambda x: x) as store:
   114	        store.append_tick(tick)
