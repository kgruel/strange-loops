    79	@dataclass(frozen=True)
    80	class Check:
    81	    """One named agreement check and its verdict.
    82	
    83	    ``name`` is the handle a caller reports ("offset", "counts", …) so the
    84	    output can say WHICH check failed rather than "verification failed".
    85	    """
    86	
    87	    name: str
