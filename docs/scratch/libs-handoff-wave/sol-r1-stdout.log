    43	class StoreReader:
    44	    """Read-only connection to a SqliteStore database.
    45	
    46	    Opens the database with PRAGMA query_only=ON. Does not create
    47	    the file or parent directories — raises FileNotFoundError if
    48	    the path does not exist.
    49	    """
    50	
    51	    def __init__(self, path: Path, *, timeout: float = 5.0) -> None:
    52	        self._path = Path(path)
    53	        if not self._path.exists():
    54	            raise FileNotFoundError(f"Store not found: {self._path}")
    55	
    56	        # ``timeout`` is sqlite's busy wait on a locked database. The 5s
    57	        # default suits interactive commands; latency-critical read paths
    58	        # (shell completion) pass a sub-second value — waiting out an
    59	        # exclusive lock is worse than under-listing there.
    60	        self._conn = sqlite3.connect(str(self._path), timeout=timeout)
    61	        self._conn.execute("PRAGMA query_only=ON")
    62	
    63	    @property
    64	    def fact_total(self) -> int:
    65	        """Visible total facts — the reserved ``_decl.*`` namespace excluded.
    66	
    67	        A ``@property`` (not a method) so ``reader.fact_total`` reads as a count,
    68	        not a bound method: a method here silently mis-renders (a truthy bound
    69	        method that format-prints as a repr) at any un-called call site. Excludes
