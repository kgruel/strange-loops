    48	class TestFactProperties:
    49	    """Property tests for Fact atom invariants."""
    50	
    51	    @settings(max_examples=200)
    52	    @given(fact=facts())
    53	    def test_fact_dict_roundtrip_fixpoint(self, fact: Fact) -> None:
    54	        """Any valid Fact serializes to a dict and deserializes to an equal Fact at fixpoint."""
    55	        d = fact.to_dict()
    56	        reconstructed = Fact.from_dict(d)
    57	
    58	        # 1. Reconstructed fact equals original fact
    59	        assert reconstructed == fact
    60	        assert reconstructed.kind == fact.kind
    61	        assert reconstructed.ts == fact.ts
    62	        assert reconstructed.observer == fact.observer
    63	        assert reconstructed.origin == fact.origin
    64	        assert reconstructed.payload == fact.payload
    65	
    66	        # 2. Fixpoint: re-serializing yields identical dict and second deserialization is identical
    67	        d2 = reconstructed.to_dict()
    68	        assert d2 == d
    69	        reconstructed2 = Fact.from_dict(d2)
    70	        assert reconstructed2 == reconstructed
    71	
