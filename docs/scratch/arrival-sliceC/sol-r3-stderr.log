     1	"""Ordering — the declared read order for a stream of records.
     2	
     3	Ordering is DECLARED, never inferred. Two variants:
     4	
     5	- ``Arrival()`` — the substrate's native per-store order. The store yields it;
     6	  this module never synthesizes it from record fields.
     7	- ``ByKey(field)`` — a projection ordered by one declared key, with the record
     8	  id as tie-break only.
     9	
    10	``totalize()`` is the ONLY definition of the sort key, and
    11	``resolve_key_field()`` the ONLY definition of the key FAMILY rule (which keys
    12	come from the envelope, which from the payload). Readers (StoreReader, the
    13	combined read, the conformance lens generator and its runner) import them
    14	rather than growing near-copies of the same ``sort(key=...)`` line or the same
    15	``if field in ("ts", "id")`` branch.
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import math
    21	from collections.abc import Callable, Iterable, Mapping
    22	from dataclasses import dataclass
    23	from typing import Any, TypeVar
    24	
    25	
    26	class OrderingError(Exception):
    27	    """Raised when records cannot be ordered under the declared Ordering.
    28	
    29	    A declaration error against the data — mixed key types under one declared
    30	    key, a ``NaN`` on either side of the ``(K, id)`` sort key, or sort-key
    31	    elements that do not compare — not something a comparator may paper over
    32	    with a coercion.
    33	
    34	    The sort key is ``(K, id)``, so the non-comparable element may be EITHER
    35	    half: a raise here does not by itself blame the declared key. The runtime
    36	    message names which.
    37	    """
    38	
    39	    pass
    40	
    41	
    42	@dataclass(frozen=True)
    43	class Arrival:
    44	    """The substrate's native per-store order.
    45	
    46	    Arrival ordinals are dense PER-LOG, so this names an order the store
    47	    already yields; ``totalize`` returns the records as given, untouched. It
    48	    is not expressible across a combined view of several stores.
    49	    """
    50	
    51	
    52	@dataclass(frozen=True)
    53	class ByKey:
    54	    """Order by one declared key, id ascending as tie-break.
    55	
    56	    Where the key resolves is :func:`resolve_key_field`'s ruling, not this
    57	    dataclass's: ``ts`` and ``id`` against the record envelope, every other
    58	    key against the flat payload.
    59	
    60	    Attributes:
    61	        field: The declared key name. Dotted paths are not this cut.
    62	
    63	    Example:
    64	        ByKey(field="ts")
    65	    """
    66	
    67	    field: str
    68	
    69	
    70	Ordering = Arrival | ByKey
    71	
    72	R = TypeVar("R")
    73	
    74	
    75	def is_suffix_stable(ordering: Ordering) -> bool:
    76	    """Does appending a record extend this projection at its END?
    77	
    78	    A projection is suffix-stable when a newly appended record can only land
    79	    after every record already in it. `Arrival()` is: the substrate's native
    80	    order IS append order, so what arrives later sorts later, always.
    81	
    82	    `ByKey(K)` is NOT. A record's position is its key value, and a record
    83	    arriving now may carry any key — so an append is an INSERTION into the
    84	    middle of the projection, not an extension of its tail.
    85	
    86	    Consumers that hold a result computed over a prefix and want to extend it
    87	    with the newly arrived records — rather than recomputing over the whole
    88	    history — are sound only over a suffix-stable ordering. Engine's
    89	    incremental fold path is the consumer; this predicate is the taxonomy
    90	    fact it dispatches on.
    91	
    92	    Raises:
    93	        OrderingError: Unknown `Ordering` variant. A new variant must be
    94	            RULED suffix-stable or not, never defaulted.
    95	    """
    96	    match ordering:
    97	        case Arrival():
    98	            return True
    99	        case ByKey():
   100	            return False
   101	        case _:
   102	            raise OrderingError(f"unknown Ordering variant: {ordering!r}")
   103	
   104	
   105	#: Declared keys that resolve against the record ENVELOPE rather than the
   106	#: payload. Every other key is a flat payload field — including ``kind``,
   107	#: ``observer`` and ``origin``, which are stored columns but not key
   108	#: candidates on any surface.
   109	ENVELOPE_KEYS = ("ts", "id")
   110	
   111	
   112	def resolve_key_field(record: Mapping[str, Any], field: str, /) -> Any:
   113	    """Resolve a declared ordering key against an envelope+payload record.
   114	
   115	    The FAMILY RULE, one definition for every surface that reads facts as
   116	    ``{"id", "kind", "ts", "observer", "origin", "payload"}`` mappings:
   117	    ``ts`` and ``id`` come from the envelope, every other key from the flat
   118	    payload. A payload field named ``ts`` or ``id`` NEVER shadows the
   119	    envelope — one key, one source, so the same declaration cannot mean two
   120	    things depending on what a payload happens to carry.
   121	
   122	    ``ts`` is column-backed as a storage detail, not a change of semantics;
   123	    a surface that hands ``ts`` over as a ``datetime`` rather than the raw
   124	    REAL orders identically (the conversion is monotone) and stays
   125	    single-typed, so the strict type-identity check in :func:`totalize`
   126	    cannot fire on it.
   127	
   128	    Dotted paths are not in this schema. Missing → ``None``, which
   129	    :func:`totalize` reads as non-membership.
   130	    """
   131	    if field in ENVELOPE_KEYS:
   132	        return record.get(field)
   133	    return resolve_payload_key(record.get("payload"), field)
   134	
   135	
   136	def resolve_payload_key(payload: Any, field: str, /) -> Any:
   137	    """Resolve a non-envelope declared key against a fact payload.
   138	
   139	    The payload half of the family rule, split out so the row-shaped combined
   140	    read (which already holds the parsed payload) resolves through the SAME
   141	    definition rather than repeating ``.get()`` on its own.
   142	
   143	    A payload need not be a mapping — ``Fact`` permits any JSON value — and a
   144	    non-mapping payload has no fields at all. It is therefore a missing-K
   145	    NON-MEMBER of every payload-key projection, exactly as an absent field is:
   146	    ``None``, which :func:`totalize` reads as non-membership. Exclusion by
   147	    declaration, not a crash and not a coercion.
   148	    """
   149	    if not isinstance(payload, Mapping):
   150	        return None
   151	    return payload.get(field)
   152	
   153	
   154	def _default_get_field(record: Any, field: str) -> Any:
   155	    if isinstance(record, Mapping):
   156	        return record.get(field)
   157	    return getattr(record, field, None)
   158	
   159	
   160	def _default_get_id(record: Any) -> Any:
   161	    if isinstance(record, Mapping):
   162	        return record["id"]
   163	    return record.id
   164	
   165	
   166	def totalize(
   167	    records: Iterable[R],
   168	    ordering: Ordering,
   169	    *,
   170	    get_field: Callable[[R, str], Any] = _default_get_field,
   171	    get_id: Callable[[R], Any] = _default_get_id,
   172	) -> list[R]:
   173	    """Order records under a declared Ordering. The one sort-key definition.
   174	
   175	    ``ByKey(K)``: sort key ``(K(record), record.id)``, id ascending. **The id
   176	    is a TIE-BREAK ONLY — never semantic time.**
   177	
   178	    A record without ``K`` is NOT in the ``ByKey(K)`` projection: a key names
   179	    what it projects, and absence is non-membership. A ``None`` value counts
   180	    as absent. This is exclusion-by-declaration — the caller named K — not
   181	    silent loss.
   182	
   183	    Key values of mixed types under one declared key are REFUSED with
   184	    ``OrderingError``. The check is strict TYPE IDENTITY, not comparability:
   185	    ``"5"`` and ``5`` refuse, ``True`` and ``1`` refuse, and so do ``1`` and
   186	    ``2.0`` — Python would happily order that last pair, and refusing it
   187	    anyway is the point. A key whose values are sometimes int and sometimes
   188	    float is a declaration the data does not support, and silently ordering it
   189	    would hide that. Same-typed values that do not compare (dicts, say) are
   190	    refused the same way.
   191	
   192	    ``NaN`` key values are REFUSED. NaN compares false against everything
   193	    including itself, so a sort containing one produces an order that depends
   194	    on the input permutation — it is not a total order, and ``totalize``'s only
   195	    claim is that it totalizes. Infinities are ALLOWED: ``-inf`` and ``+inf``
   196	    order deterministically against every other float, so refusing them would
   197	    overreach — the claim is totalization, not finiteness.
   198	
   199	    A NaN TIE-BREAK ID is refused for the same reason and attributed to the id
   200	    side. The default ``get_id`` returns record ids, which are strings, so only
   201	    a custom ``get_id`` can produce one; the check is float-typed only, exactly
   202	    as on the key side, so a string ``"nan"`` id is an ordinary id.
   203	
   204	    Data that earns more than one refusal refuses by CATEGORY, never by which
   205	    record happened to come first: mixed type wins over a NaN key value, which
   206	    wins over a NaN id. Each check runs as its own complete pass for exactly
   207	    that reason.
   208	
   209	    A record that CARRIES ``K`` but has no id raises the accessor's own error
   210	    (``KeyError``/``AttributeError``), unwrapped and by ruling: an id is the
   211	    substrate's, not the declaration's, so its absence is a broken record
   212	    rather than an ordering declaration that does not fit the data. Only the
   213	    latter is what ``OrderingError`` means. A record missing ``K`` never
   214	    reaches the id accessor at all.
   215	
   216	    ``Arrival()`` returns the records as given — the store's native order is
   217	    the store's job to yield, never synthesized here. Both accessors are
   218	    ignored for ``Arrival()``.
   219	
   220	    Args:
   221	        records: The records to order.
   222	        ordering: ``Arrival()`` or ``ByKey(field)``.
   223	        get_field: Reads a named field off a record. The default reads a
   224	            Mapping key or an attribute, missing → None. Row-tuple callers
   225	            pass their own.
   226	        get_id: Reads the record id. The default reads the ``id`` Mapping key
   227	            or attribute.
   228	
   229	    Returns:
   230	        A new list, ordered. For ``ByKey``, records missing the key are absent.
   231	
   232	    Raises:
   233	        OrderingError: Mixed key types under the declared key, a ``NaN`` on
   234	            either side of the sort key — key value or tie-break id —
   235	            sort-key elements that do not compare, or an unknown Ordering
   236	            variant.
   237	    """
   238	    match ordering:
   239	        case Arrival():
   240	            return list(records)
   241	        case ByKey(field=field):
   242	            # Each refusal gets its OWN complete pass, so which category fires
   243	            # is a property of the data and not of the input permutation:
   244	            # mixed type wins over a NaN key, which wins over a NaN id.
   245	            members: list[tuple[Any, R]] = []
   246	            key_type: type | None = None
   247	            for record in records:
   248	                value = get_field(record, field)
   249	                if value is None:
   250	                    continue
   251	                if key_type is None:
   252	                    key_type = type(value)
   253	                elif type(value) is not key_type:
   254	                    raise OrderingError(
   255	                        f"mixed key types under declared key {field!r}: "
   256	                        f"{key_type.__name__} and {type(value).__name__} "
   257	                        f"(offending value {value!r})"
   258	                    )
   259	                members.append((value, record))
   260	
   261	            for value, _record in members:
   262	                if isinstance(value, float) and math.isnan(value):
   263	                    raise OrderingError(
   264	                        f"NaN key value under declared key {field!r}: {value!r} — "
   265	                        f"NaN compares false against everything including itself, "
   266	                        f"so the resulting order depends on the input permutation "
   267	                        f"and is not a total order. Infinities are fine; NaN is "
   268	                        f"not a position."
   269	                    )
   270	
   271	            keyed: list[tuple[Any, Any, R]] = [
   272	                (value, get_id(record), record) for value, record in members
   273	            ]
   274	
   275	            for _value, record_id, _record in keyed:
   276	                if isinstance(record_id, float) and math.isnan(record_id):
   277	                    raise OrderingError(
   278	                        f"NaN tie-break id under declared key {field!r}: "
   279	                        f"{record_id!r} — the offending element is the ID side "
   280	                        f"of the (K, id) sort key, not the key. NaN compares "
   281	                        f"false against everything including itself, so records "
   282	                        f"sharing a key value would order by input permutation."
   283	                    )
   284	            try:
   285	                keyed.sort(key=lambda entry: (entry[0], entry[1]))
   286	            except TypeError as exc:
   287	                raise OrderingError(
   288	                    f"records under declared key {field!r} do not compare: {exc} "
