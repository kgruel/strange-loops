index 0000000000000000000000000000000000000000..8175e8ca65850bcfc37701dc616e42cce41428d1
--- /dev/null
+++ b//tmp/sol-s4-r3/probe_scanner_raw_adversarial.py
@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+import random
+import tempfile
+from pathlib import Path
+
+from lang import effective_store_clause, parse_vertex_file
+from migrate import edit_vertex_store_clause
+
+
+def raw_string(content: str, hashes: int) -> str:
+    marks = "#" * hashes
+    delimiter = '"' + marks
+    assert delimiter not in content
+    return f'r{marks}"{content}"{marks}'
+
+
+fixed = [
+    (0, "file // not-comment { store } /* x */"),
+    (1, 'file " // not-comment { store } /* x */'),
+    (2, 'file "# // not-comment } store {'),
+    (3, 'file "## /* not-comment */ store'),
+    (4, "file\nstore decoy // still raw\nend"),
+]
+
+rng = random.Random(0x50_4)
+alphabet = "abcdef store/{};*=\t\n\r\"#"
+randomized: list[tuple[int, str]] = []
+for _ in range(1000):
+    hashes = rng.randrange(0, 7)
+    delimiter = '"' + ("#" * hashes)
+    while True:
+        content = "v" + "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 90)))
+        if delimiter not in content:
+            randomized.append((hashes, content))
+            break
+
+suffixes = [
+    ' // KEEP OPERATOR " tail\n',
+    "\t/* KEEP BLOCK */  // KEEP LINE\n",
+    "; // KEEP AFTER SEMICOLON\n",
+    "  \n",
+]
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r3") as tmp:
+    root = Path(tmp)
+    for index, (hashes, content) in enumerate(fixed + randomized):
+        raw = raw_string(content, hashes)
+        clause = f'store "./legacy.jsonl" backend={raw}'
+        suffix = suffixes[index % len(suffixes)]
+        prelude = f'name {raw_string("project store decoy { // ;", hashes)}\n'
+        text = prelude + clause + suffix + 'loops { probe { fold { items "collect" 10 } } }\n'
+        vertex = root / f"case-{index}.vertex"
+        vertex.write_text(text, encoding="utf-8")
+        parse_vertex_file(vertex)
+        located = effective_store_clause(text, vertex)
+        start = len(prelude)
+        expected = (start, start + len(clause))
+        assert located.count == 1, (index, located)
+        assert located.span == expected, (index, hashes, content, located.span, expected)
+        edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+        edited = vertex.read_text(encoding="utf-8")
+        replacement = 'store "./target.arrival" backend="file"'
+        expected_edit = (
+            prelude
+            + replacement
+            + suffix
+            + text[len(prelude) + len(clause) + len(suffix) :]
+        )
+        assert edited == expected_edit, (index, repr(edited), repr(expected_edit))
+
+print(f"PASS: {len(fixed)} fixed + {len(randomized)} deterministic randomized raw-string rewrites")
