     assert log.exists()
     t, row = deserialize_row(lines(log)[0])
     assert t == "fact"
     assert row[0] == fid  # the receipt IS the id in the durable line
     assert [r[0] for r in sqlite_facts(store._path)] == [fid]
     assert offset_of(store) == log.stat().st_size
     store.close()
 
 
