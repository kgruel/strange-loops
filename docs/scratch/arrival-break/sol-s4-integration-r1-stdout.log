   241	
   242	def deserialize_row(line: str) -> tuple[str, tuple]:
   243	    """Decode a single-record line, dispatching on ``"t"``.
   244	
   245	    Returns ``(t, row)`` with the row at full arity (7 fact fields / 11 tick fields,
   246	    signature last). A ``"t":"batch"`` line carries several records and is
   247	    refused here — decode it with :func:`deserialize_records`.
   248	    """
   249	    records = deserialize_records(line)
   250	    if len(records) > 1:
   251	        raise JsonlCodecError(
   252	            "batch line carries multiple records — decode with "
   253	            "deserialize_records, not deserialize_row"
   254	        )
   255	    return records[0]
   256	
   257	
   258	def deserialize_records(line: str) -> list[tuple[str, tuple]]:
   259	    """Decode any line into its record sequence, in on-the-wire order."""
   260	    return records_from_object(load_line(line))
   261	
   262	
   263	def records_from_object(obj: dict) -> list[tuple[str, tuple]]:
   264	    """Decode an already-decoded record object into a sequence of ``(t, row)``."""
   265	    if not isinstance(obj, dict):
   266	        raise JsonlCodecError(
   267	            f"record must be a JSON object, got {type(obj).__name__}"
   268	        )
   269	    t = obj.get("t")
   270	    if t == _BATCH:
   271	        _validate_batch(obj)
   272	        fact = _SPEC["fact"]
   273	        return [("fact", _row_of(elem, fact)) for elem in obj[_ROWS]]
   274	    spec = _SPEC.get(t) if isinstance(t, str) else None
   275	    if spec is None:
   276	        raise JsonlCodecError(f"unknown record discriminator t={t!r}")
   277	    _validate(obj, spec)
   278	    return [(spec.t, _row_of(obj, spec))]

