     8	an open-before-audit erases the very evidence the audit exists to inspect.
     9	
    10	:func:`read_preflight` makes the composition explicit, with three modes
    11	that never blur into each other:
    12	
    13	``AUDIT_ONLY``
    14	    Verify and report. Never constructs a store, never repairs — a damaged
    15	    store comes back as typed damage with all evidence intact.
    16	
    17	``AUDIT_THEN_OPEN``
    18	    Verify; open ONLY if the audit passed. A failing audit refuses to
    19	    open. NOTE the deliberate consequence: a fresh clone (log tracked,
    20	    derived index absent) is a REFUSAL here, because materializing the
    21	    index is repair by definition. That is not a bug — it is the mode
    22	    contract. The sanctioned path for "build/repair whatever is needed and
    23	    open" is ``RECOVER_THEN_OPEN``.
    24	
    25	``RECOVER_THEN_OPEN``
    26	    Audit first (the pre-repair evidence is captured in the result), then
    27	    open — letting the store's own open-time recovery run — then audit
    28	    again to report the post-recovery state. Recovery happens ONLY in this
    29	    mode, and even here some damage refuses: out-of-band index rows raise
    30	    :class:`~engine.jsonl_store.JsonlCanonicalUnsupported` at open (the
    31	    log cannot account for them), and the result says ``refused``, typed
    32	    distinctly from ``recovered``.
    33	
    34	Verification is never silently conflated with repair: repair happens in
    35	exactly one mode, is always preceded by an evidentiary audit, and is always
    36	reported as having happened.
    37	
    38	A sqlite-canonical target has no log/index pair to audit, so agreement is
    39	vacuous: ``agreed=True`` with a reason saying so, and the open modes open
    40	via :func:`engine.jsonl_store.open_canonical_store` as usual. (Chain/content
    41	verification of a sqlite store is ``verify_chain``'s scope, not this gate's.)
    42	
    43	The result is typed for exit-code mapping: :attr:`PreflightResult.status`
    44	is a small closed vocabulary (``PREFLIGHT_STATUSES``) a CLI can map
    45	directly; no integers are baked in here.
    46	"""
    47	
    48	from __future__ import annotations
    49	
    50	from dataclasses import dataclass
    51	from enum import Enum
    52	from pathlib import Path
    53	from typing import Any
    54	
    55	from .canonical_audit import AgreementReport, audit_agreement
    56	from .residence import index_path_for, is_jsonl_canonical
    57	
    58	__all__ = [
    59	    "PREFLIGHT_STATUSES",
    60	    "PreflightMode",
    61	    "PreflightResult",
    62	    "read_preflight",
    63	]
    64	
    65	
    66	class PreflightMode(Enum):
    67	    """The three read-preparation contracts. See the module docstring."""
    68	
    69	    AUDIT_ONLY = "audit-only"
    70	    AUDIT_THEN_OPEN = "audit-then-open"
    71	    RECOVER_THEN_OPEN = "recover-then-open"
    72	
    73	
    74	#: The closed status vocabulary, in rough order of severity. A CLI maps
    75	#: these to exit codes; the engine does not choose the integers.
    76	#:
    77	#: ``ok``            agreed (or vacuously agreed), and opened if requested
    78	#: ``recovered``     RECOVER_THEN_OPEN found damage, repaired, and reopened
    79	#: ``index-behind``  diverged, but only past the consumed prefix
    80	#:                   (``AgreementReport.index_behind`` — a scope statement,
    81	#:                   not an innocence claim; see that docstring)
    82	#: ``diverged``      the artifacts disagree in a way "behind" does not cover
    83	#: ``refused``       an open mode declined to open (audit failed in
    84	#:                   AUDIT_THEN_OPEN, or recovery itself refused)
    85	#: ``unreadable``    the canonical artifact itself cannot be read
    86	PREFLIGHT_STATUSES = (
    87	    "ok",
    88	    "recovered",
    89	    "index-behind",
    90	    "diverged",
    91	    "refused",
    92	    "unreadable",
    93	)
    94	
    95	
    96	@dataclass(frozen=True)
    97	class PreflightResult:
    98	    """What the preflight found, what it did, and what a caller may do next."""
    99	
   100	    mode: PreflightMode
   101	    canonical_path: Path
   102	    index_path: Path
   103	    status: str
   104	    """One of :data:`PREFLIGHT_STATUSES` — the exit-code hook."""
   105	
   106	    report: AgreementReport | None
   107	    """The evidentiary audit — taken BEFORE any open in every mode. ``None``
   108	    only for a sqlite-canonical target, where agreement is vacuous."""
   109	
   110	    post_report: AgreementReport | None
   111	    """RECOVER_THEN_OPEN only: the audit re-run after recovery, so the
   112	    caller can see what recovery left behind. ``None`` in other modes."""
   113	
   114	    agreed: bool
   115	    """Did the pre-open audit pass (vacuously True for sqlite-canonical)?"""
   116	
   117	    opened: bool
   118	    recovered: bool
   119	    """True only when RECOVER_THEN_OPEN observed a failing pre-audit and the
   120	    subsequent open succeeded — i.e. repair actually ran and took."""
   121	
   122	    store: Any | None
   123	    """The opened store handle (a ``SqliteStore`` subclass) in the open
   124	    modes when opening happened; the caller owns closing it."""
   125	
   126	    reason: str
   127	
   128	    def as_dict(self) -> dict[str, Any]:
   129	        return {
   130	            "mode": self.mode.value,
   131	            "canonical_path": str(self.canonical_path),
   132	            "index_path": str(self.index_path),
   133	            "status": self.status,
   134	            "agreed": self.agreed,
   135	            "opened": self.opened,
   136	            "recovered": self.recovered,
   137	            "reason": self.reason,
   138	            "report": self.report.as_dict() if self.report else None,
   139	            **(
   140	                {"post_report": self.post_report.as_dict()}
   141	                if self.post_report
   142	                else {}
   143	            ),
   144	        }
   145	
   146	
   147	def read_preflight(
   148	    target: Path | str | Any,
   149	    mode: PreflightMode = PreflightMode.AUDIT_ONLY,
   150	    **open_kwargs: Any,
   151	) -> PreflightResult:
   152	    """Audit a canonical store — and open it only as the mode allows.
   153	
   154	    ``target`` is a canonical store locator (a ``.jsonl`` log or a
   155	    sqlite-canonical db path), or a :class:`engine.probe.TargetInfo` whose
   156	    ``canonical_path`` is taken — probe and preflight compose. A derived
   157	    index path is accepted and re-routed to its canonical sibling via the
   158	    probe, so no caller can accidentally audit "the index against itself".
   159	
   160	    ``open_kwargs`` are forwarded to :func:`engine.jsonl_store.
   161	    open_canonical_store` in the open modes (``serialize``/``deserialize``
   162	    default to identity, matching ``ensure_index``).
   163	    """
   164	    canonical = _canonical_of(target)
   165	    index = index_path_for(canonical)
   166	
   167	    if not is_jsonl_canonical(canonical):
   168	        return _sqlite_preflight(canonical, mode, open_kwargs)
   169	
   170	    report = audit_agreement(canonical)
   171	    if mode is PreflightMode.AUDIT_ONLY:
   172	        return _audit_only_result(canonical, index, report)
   173	    if mode is PreflightMode.AUDIT_THEN_OPEN:
   174	        return _audit_then_open(canonical, index, report, open_kwargs)
   175	    return _recover_then_open(canonical, index, report, open_kwargs)
   176	
   177	
   178	# --- mode bodies ------------------------------------------------------------
   179	
   180	
   181	def _audit_only_result(
   182	    canonical: Path, index: Path, report: AgreementReport
   183	) -> PreflightResult:
   184	    status, reason = _verdict(canonical, report)
   185	    return PreflightResult(
   186	        mode=PreflightMode.AUDIT_ONLY,
   187	        canonical_path=canonical,
   188	        index_path=index,
   189	        status=status,
   190	        report=report,
   191	        post_report=None,
   192	        agreed=report.ok,
   193	        opened=False,
   194	        recovered=False,
   195	        store=None,
   196	        reason=reason,
   197	    )
   198	
   199	
   200	def _audit_then_open(
   201	    canonical: Path,
   202	    index: Path,
   203	    report: AgreementReport,
   204	    open_kwargs: dict[str, Any],
   205	) -> PreflightResult:
   206	    if not report.ok:
   207	        status, why = _verdict(canonical, report)
   208	        return PreflightResult(
   209	            mode=PreflightMode.AUDIT_THEN_OPEN,
   210	            canonical_path=canonical,
   211	            index_path=index,
   212	            status="refused" if status not in ("unreadable",) else status,
   213	            report=report,
   214	            post_report=None,
   215	            agreed=False,
   216	            opened=False,
   217	            recovered=False,
   218	            store=None,
   219	            reason=(
   220	                f"refusing to open: {why} — audit-then-open never repairs; "
   221	                "recover-then-open is the sanctioned repair-and-open path"
   222	            ),
   223	        )
   224	    store = _open(canonical, open_kwargs)
   225	    return PreflightResult(
   226	        mode=PreflightMode.AUDIT_THEN_OPEN,
   227	        canonical_path=canonical,
   228	        index_path=index,
   229	        status="ok",
   230	        report=report,
   231	        post_report=None,
   232	        agreed=True,
   233	        opened=True,
   234	        recovered=False,
   235	        store=store,
   236	        reason="agreement audit passed; store opened",
   237	    )
   238	
   239	
   240	def _recover_then_open(
   241	    canonical: Path,
   242	    index: Path,
   243	    report: AgreementReport,
   244	    open_kwargs: dict[str, Any],
   245	) -> PreflightResult:
   246	    """Evidence first, then the store's own recovery, then the after-picture."""
   247	    from .jsonl_store import JsonlCanonicalUnsupported
   248	
   249	    if not canonical.exists():
   250	        return PreflightResult(
   251	            mode=PreflightMode.RECOVER_THEN_OPEN,
   252	            canonical_path=canonical,
   253	            index_path=index,
   254	            status="unreadable",
   255	            report=report,
   256	            post_report=None,
   257	            agreed=False,
   258	            opened=False,
   259	            recovered=False,
   260	            store=None,
   261	            reason=(
   262	                f"no canonical log at {canonical} — recovery rebuilds an "
   263	                "index FROM the log; it never invents a log"
   264	            ),
   265	        )
   266	    try:
   267	        store = _open(canonical, open_kwargs)
   268	    except JsonlCanonicalUnsupported as exc:
   269	        return PreflightResult(
   270	            mode=PreflightMode.RECOVER_THEN_OPEN,
   271	            canonical_path=canonical,
   272	            index_path=index,
   273	            status="refused",
   274	            report=report,
   275	            post_report=None,
   276	            agreed=report.ok,
   277	            opened=False,
   278	            recovered=False,
   279	            store=None,
   280	            reason=f"recovery refused: {exc}",
   281	        )
   282	    post = audit_agreement(canonical)
   283	    recovered = not report.ok
   284	    return PreflightResult(
   285	        mode=PreflightMode.RECOVER_THEN_OPEN,
   286	        canonical_path=canonical,
   287	        index_path=index,
   288	        status="recovered" if recovered else "ok",
   289	        report=report,
   290	        post_report=post,
   291	        agreed=report.ok,
   292	        opened=True,
   293	        recovered=recovered,
   294	        store=store,
   295	        reason=(
   296	            "store recovered and opened; pre-recovery evidence in report, "
   297	            "post-recovery state in post_report"
   298	            if recovered
   299	            else "agreement audit passed; store opened (no recovery needed)"
   300	        ),
   301	    )
   302	
   303	
   304	def _sqlite_preflight(
   305	    canonical: Path, mode: PreflightMode, open_kwargs: dict[str, Any]
   306	) -> PreflightResult:
   307	    """Sqlite-canonical: no log/index pair, so agreement is vacuous.
   308	
   309	    A MISSING db is ``unreadable`` in every mode — ``SqliteStore.__init__``
   310	    creates a missing file, and a *read* preflight never creates. Even
   311	    RECOVER_THEN_OPEN refuses: recovery rebuilds derived state from a
   312	    canonical artifact; with no artifact there is nothing to recover FROM
   313	    (the sqlite mirror of "recovery never invents a log"). Store creation
   314	    is a different verb.
   315	    """
   316	    if not canonical.exists():
   317	        return PreflightResult(
   318	            mode=mode,
   319	            canonical_path=canonical,
   320	            index_path=canonical,
   321	            status="unreadable",
   322	            report=None,
   323	            post_report=None,
   324	            agreed=False,
   325	            opened=False,
   326	            recovered=False,
   327	            store=None,
   328	            reason=(
   329	                f"no sqlite-canonical store at {canonical} — a read "
   330	                "preflight never creates a store"
   331	            ),
   332	        )
   333	    reason = (
   334	        "sqlite-canonical store — no derived index to audit; agreement is "
   335	        "vacuous (chain verification is verify_chain's scope)"
   336	    )
   337	    if mode is PreflightMode.AUDIT_ONLY:
   338	        return PreflightResult(
   339	            mode=mode,
   340	            canonical_path=canonical,
   341	            index_path=canonical,
   342	            status="ok",
   343	            report=None,
   344	            post_report=None,
   345	            agreed=True,
   346	            opened=False,
   347	            recovered=False,
   348	            store=None,
   349	            reason=reason,
   350	        )
   351	    store = _open(canonical, open_kwargs)
   352	    return PreflightResult(
   353	        mode=mode,
   354	        canonical_path=canonical,
   355	        index_path=canonical,
   356	        status="ok",
   357	        report=None,
   358	        post_report=None,
   359	        agreed=True,
   360	        opened=True,
   361	        recovered=False,
   362	        store=store,
   363	        reason=reason + "; store opened",
   364	    )
   365	
   366	
   367	# --- helpers ----------------------------------------------------------------
   368	
   369	
   370	def _verdict(canonical: Path, report: AgreementReport) -> tuple[str, str]:
   371	    """An ``AgreementReport`` as a (status, reason) pair for the vocabulary.
   372	
   373	    ``index-behind`` re-states the report's own scope-limited flag; the
   374	    reason keeps its wording so no caller upgrades it to an innocence claim.
   375	    """
   376	    if report.ok:
   377	        return "ok", "log and index agree"
   378	    if any(c.name == "log" and not c.ok for c in report.checks):
   379	        return "unreadable", report.summary()
   380	    if report.index_behind:
   381	        return "index-behind", report.summary()
   382	    return "diverged", report.summary()
   383	
   384	
   385	def _canonical_of(target: Path | str | Any) -> Path:
   386	    """A canonical path from a path-like or a ``TargetInfo``.
   387	
   388	    A derived-index path is re-routed through the probe to its canonical
   389	    sibling; a ``TargetInfo`` contributes its ``canonical_path`` directly.
   390	    """
   391	    canonical_attr = getattr(target, "canonical_path", None)
   392	    if canonical_attr is not None:
   393	        return Path(canonical_attr)
   394	    if hasattr(target, "target_type"):  # a TargetInfo with no canonical
   395	        raise ValueError(
   396	            f"preflight needs a store-bearing target; got a "
   397	            f"{target.target_type!r} probe with no canonical_path"
   398	        )
   399	    from .probe import probe_target
   400	
   401	    info = probe_target(Path(target))
   402	    if info.canonical_path is None:
   403	        raise ValueError(
   404	            f"not a store locator: {target} ({info.reason})"
   405	        )
   406	    return info.canonical_path
   407	
   408	
   409	def _open(canonical: Path, open_kwargs: dict[str, Any]):
   410	    from .jsonl_store import open_canonical_store
   411	
   412	    kwargs: dict[str, Any] = {
   413	        "serialize": lambda d: d,
   414	        "deserialize": lambda d: d,
   415	        **open_kwargs,
   416	    }
   417	    return open_canonical_store(canonical, **kwargs)

