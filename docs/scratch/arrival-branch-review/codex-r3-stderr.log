   606	    def reanchor(self, *args: Any, **kwargs: Any):  # noqa: D102
   607	        # PERMANENT, not deferred (cut B). The queued log-rewrite ceremony is
   608	        # RETIRED: rewriting a log is not an operation in this model, and the
   609	        # rowid-identity property the projections rest on is exactly what a
   610	        # rewrite would destroy. The one case that could break re-derivation
   611	        # is a truncated or rewritten log, and this is the method that would
   612	        # have made it reachable.
   613	        raise ArrivalCanonicalUnsupported(
   614	            "reanchor is not an operation an arrival-canonical store has, and "
   615	            "it is not a later slice's either: it would rewrite index rows "
   616	            "while the arrival log kept the originals, so the index would "
   617	            "stop being a function of the log. Rewriting a log is not an "
   618	            "operation in this model."
   619	        )
