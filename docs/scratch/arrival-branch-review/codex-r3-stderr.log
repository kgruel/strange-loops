  1532	        """Resolve a window cursor (fact id) to its rowid — witness order.
  1533	
  1534	        "" (start-of-store / empty-store sentinel) resolves to 0, before the
  1535	        first rowid. A cursor whose fact no longer exists resolves to None:
  1536	        the window is unresolvable and hashes as empty — any non-empty
  1537	        commitment over it then mismatches. (Deleting a cursor fact that was
  1538	        itself inside a covered window already breaks THAT window's hash.)
  1539	        """
  1540	        if fact_id == "":
  1541	            return 0
  1542	        row = self._conn.execute(
  1543	            "SELECT rowid FROM facts WHERE id = ?", (fact_id,)
  1544	        ).fetchone()
  1545	        return row[0] if row else None
  1546	
  1547	    def _window_hash(self, start: str, end: str) -> str:
  1548	        """Hash the fact window (start, end] in witness order (rowid).
  1549	
  1550	        Cursors are fact ids; ordering and membership are append order — see
  1551	        the ORDERING AUTHORITY note in the chain comment block. Id order is
  1552	        not append order in mixed-id-era stores, and a late-arriving fact
  1553	        with an old event-time id must not retroactively enter a sealed
  1554	        window.
  1555	        """
  1556	        h = hashlib.sha256()
  1557	        lo = self._cursor_rowid(start)
  1558	        hi = self._cursor_rowid(end)
  1559	        if lo is None or hi is None:
  1560	            return h.hexdigest()  # unresolvable cursor → empty commitment
  1561	        # Era-aware row hash: include the signature column when it exists.
  1562	        # Unsigned rows hash identically either way (the signature key is
  1563	        # only added when non-NULL), so pre-delta-3 sealed windows verify
  1564	        # unchanged; signed facts are strip-detectable once sealed.
  1565	        cols = "id, kind, ts, observer, origin, payload"
  1566	        if self._facts_have_signature_column():
  1567	            cols += ", signature"
  1568	        for row in self._conn.execute(
  1569	            f"SELECT {cols} FROM facts "
  1570	            "WHERE rowid > ? AND rowid <= ? ORDER BY rowid",
  1571	            (lo, hi),
  1572	        ):
  1573	            h.update(_fact_row_hash(row).encode())
  1574	        return h.hexdigest()
  1575	
  1576	    def append_tick(self, tick: Tick, *, enforce_floor: bool = True) -> str:
  1577	        """Append a tick to the ticks table, extending the hash chain.
  1578	        Returns the tick row id assigned (so a receipt can read the
  1579	        committed row back — ``tick_signature_state``); historical callers
  1580	        ignored the previous ``None`` return, so the change is additive.
  1581	
  1582	        ``enforce_floor`` (the tick-signing floor, decision design/tick-signing
  1583	        -era-is-a-floor) is ON BY DEFAULT: when no signature was produced AND
  1584	        the store is already in the signed era, refuse — raise
  1585	        ``UnsignedTickInSignedEra`` BEFORE writing, so no unsigned tick is
  1586	        appended and the chain's era-monotonicity holds. Default-on makes the
  1587	        invariant fail-safe: every live mint (each verb that fires a boundary —
  1588	        ``sl seal``, ``sl emit <v> seal``, count/predicate boundaries — and any
  1589	        other live caller such as the tasks harness) is protected without
  1590	        opting in. Only re-mint paths that reconstruct history under their own
  1591	        signer wiring (rebirth/slice/replay) pass ``enforce_floor=False`` — the
  1592	        exemptions are named, not the enforcement.
  1593	
  1594	        Chain semantics (see design/tick-chain-at-store-layer):
  1595	        - prev_hash: sha256 of the previous tick row (any era) — None for
  1596	          the first row in the store.
  1597	        - window bounds are explicit fact ids; membership and ordering are
  1598	          APPEND ORDER (rowid), never id order — the cursor is the id of the
  1599	          newest fact BY ROWID, not MAX(id) (see ORDERING AUTHORITY above):
  1600	          - first tick in a new store: window_start "" (covers all facts);
  1601	          - first chained tick after pre-chain rows: window_start =
  1602	            current append edge (epoch marker — claims no coverage of
  1603	            history it cannot vouch for);
  1604	          - otherwise: window_start = previous tick's fact_cursor.
  1605	        - window_hash commits to every fact row in (window_start, fact_cursor].
  1606	        - signature (delta 2): when a tick_signer was injected, signs the
  1607	          commitment hash of the new row; NULL otherwise (pre-signature era).
