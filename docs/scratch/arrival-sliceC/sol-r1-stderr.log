    23	class FactPage:
    24	    """One bounded page of a generic fact query (:meth:`StoreReader.query_facts`).
    25	
    26	    ``next`` is a 0.8.0 :class:`~engine.witness.WitnessPosition` — the SAME
    27	    cursor type every other temporal seam uses, not a second cursor species.
    28	    It marks the LAST item of this page on the witness (append/rowid) axis;
    29	    hand it back as ``before`` (order ``"newest"``) or ``after`` (order
    30	    ``"oldest"``) to fetch the next page. ``None`` means the walk is complete
    31	    (equivalently: ``truncated`` is False).
    32	
    33	    ``truncated`` is True when more matching rows existed beyond ``limit`` in
    34	    the SAME read snapshot the items came from.
    35	    """
    36	
    37	    items: list[dict]
    38	    next: "WitnessPosition | None"
    39	    truncated: bool
    40	    #: The order the page was walked in — echoed so a consumer holding only
    41	    #: the page knows which parameter ``next`` feeds.
    42	    order: str
