   110	def test_full_scan_is_append_order_not_id_or_ts_order(db):
   111	    """Ordering authority is the witness (append) axis — A3 pinned."""
   112	    visible = [i for i in range(N) if i % 11 != 5]
   113	    append_order_ids = [_mixed_era_id(i) for i in visible]
   114	    with StoreReader(db) as reader:
   115	        oldest = [f["id"] for f in reader.query_facts(limit=1000, order="oldest").items]
   116	        newest = [f["id"] for f in reader.query_facts(limit=1000, order="newest").items]
   117	    assert oldest == append_order_ids
   118	    assert newest == list(reversed(append_order_ids))
   119	    # The adversarial construction actually bites: id order != append order,
   120	    # and ts order != append order.
   121	    assert sorted(oldest) != oldest
   122	    with StoreReader(db) as reader:
   123	        ts_by_id = {f["id"]: f["ts"] for f in reader.query_facts(limit=1000, order="oldest").items}
   124	    assert [i for i, _ in sorted(ts_by_id.items(), key=lambda kv: kv[1])] != oldest
