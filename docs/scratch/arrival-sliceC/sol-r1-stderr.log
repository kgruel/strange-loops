   883	def _override_index(ast: Any, vertex_path: Path, store: Path | str | None) -> Path | None:
   884	    """The sqlite index for an explicit ``store=`` override, or ``None``.
   885	
   886	    "Fold this vertex's declarations over THAT store." The declaration keeps
   887	    answering *what* — the folds, the kinds, and (via the locator's extension)
   888	    what kind of store this is; the override answers only *where*. That split
   889	    is what an app whose contract is one store per workspace needs: it cannot
   890	    put the store beside the packaged vertex file, but it must not fork the
   891	    declaration to say so.
   892	
   893	    ``store`` is a **canonical** locator, so a ``.jsonl`` override resolves
   894	    (and materializes/tails) its derived index exactly like a declared one —
   895	    reads are sqlite reads either way (``engine.residence``).
   896	
   897	    **Must be absolute.** A *declared* ``store "./x.db"`` is relative to the
   898	    vertex file, which is the only anchor a declaration has. An override
   899	    arrives from a caller who has a cwd, so a relative one has two plausible
   900	    anchors and silently picks the vertex's — a packaged vertex plus
   901	    ``store="data/tasks.db"`` reads the package-adjacent database instead of
   902	    the workspace's. Refusing is the explicit form: the caller knows which
   903	    anchor it meant and can say so in one ``.resolve()``.
   904	
   905	    Refused on combine/discover vertices: an aggregate reads N stores and one
   906	    override cannot say which, so the caller must address a member store.
   907	    """
   908	    if store is None:
   909	        return None
   910	    if not Path(store).is_absolute():
   911	        raise ValueError(
   912	            f"store override must be an absolute path, got '{store}' — a "
   913	            "relative override is ambiguous between the vertex's directory "
   914	            f"({vertex_path.parent}) and the caller's cwd ({Path.cwd()}); "
   915	            "resolve it before passing it"
   916	        )
   917	    if ast.combine is not None or ast.discover is not None:
   918	        raise ValueError(
   919	            "store override is per-store and cannot select over a "
   920	            "combine/discover aggregate — address a member store instead"
   921	        )
