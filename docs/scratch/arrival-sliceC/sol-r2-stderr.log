   374	def build_combine_vertex(root: Path, case: LensCase) -> Path:
   375	    """Scaffold one member vertex per member store plus a combine parent."""
   376	    member_paths = []
   377	    for label, facts in case.members.items():
   378	        store_path = root / f"{label}.db"
   379	        vertex_path = root / f"{label}.vertex"
   380	        vertex_path.write_text(
   381	            _MEMBER_KDL.format(label=label, store=store_path, kind=case.kind)
   382	        )
   383	        store = SqliteStore(
   384	            path=store_path,
   385	            serialize=lambda f: f.to_dict() if isinstance(f, Fact) else f,
   386	            deserialize=Fact.from_dict,
   387	        )
   388	        for fid, fact in facts:
   389	            store.append(fact, id_override=fid)
   390	        store.close()
