   367	class JsonlStore(SqliteStore[T], Generic[T]):
   368	    """A store whose canonical persistence is its JSONL log.
   369	
   370	    Same constructor as :class:`SqliteStore` plus an optional ``log_path``
   371	    (defaults to the db path with a ``.jsonl`` suffix). Opening runs
   372	    catch-up; every append writes the log first.
   373	    """
   374	
   375	    def __init__(self, *, log_path: Path | None = None, **kwargs: Any) -> None:
   376	        super().__init__(**kwargs)
   377	        self._log_path = (
   378	            Path(log_path) if log_path is not None else log_path_for(self._path)
   379	        )
   380	        try:
   381	            self._open_index()
   382	        except sqlite3.Error as exc:
   383	            # The derived index itself does not open as sqlite (non-sqlite
   384	            # bytes, truncated header — low-level corruption catch-up cannot
   385	            # route around). The index is DERIVED and the canonical log is
   386	            # the store, so discarding and rebuilding it from the log is this
   387	            # layer's own recovery, same class as the _rebuild triggers. Two
   388	            # guards keep the unlink honest: a transient lock is not
   389	            # corruption (re-raise — another handle owns a live index), and
   390	            # with no canonical log on disk the db is the only artifact
   391	            # (re-raise — never destroy what cannot be re-derived).
   392	            if "database is locked" in str(exc) or not self._log_path.is_file():
   393	                raise
   394	            self._recover_index(kwargs, exc)
   395	
   396	    def _recover_index(self, kwargs: dict[str, Any], exc: BaseException) -> None:
   397	        """Discard-and-rebuild a corrupt derived index — serialized (SOL-R3-04).
   398	
   399	        Concurrent openers racing the destructive discard could each
   400	        unlink-and-recreate, ending on different inodes with divergent
   401	        reads. Recovery therefore runs under an interprocess lock FILE
   402	        beside the index (``flock`` on its own fd — which also serializes
   403	        threads, the lock being per-fd): sqlite cannot provide the lock,
   404	        its file is the casualty. Under the lock a would-be loser first
   405	        RE-OPENS at the path — re-checking corruption and binding whatever
   406	        inode now lives there (the winner's rebuilt index) — and only a
   407	        still-corrupt index is quarantined (atomic rename to
   408	        ``<name>.corrupt.<pid>-<seq>``, never a blind unlink) and rebuilt
   409	        from the log.
   410	        """
   411	        import fcntl
   412	
   413	        from .residence import sqlite_sidecars
   414	
   415	        lock_path = self._path.with_name(self._path.name + ".recovery-lock")
   416	        lock_path.parent.mkdir(parents=True, exist_ok=True)
   417	        with lock_path.open("ab") as lock_fh:
   418	            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
   419	            try:
   420	                # Loser path: a winner may already have recovered — re-check
   421	                # under the lock by reopening the current file at the path.
   422	                super().__init__(**kwargs)
   423	                self._open_index()
   424	                return
   425	            except sqlite3.Error as retry_exc:
   426	                if "database is locked" in str(retry_exc):
   427	                    raise  # a live handle owns the index — not corruption
   428	            _log.warning(
   429	                "jsonl-canonical: derived index %s unusable (%s) — "
   430	                "discarding and rebuilding from %s",
   431	                self._path, exc, self._log_path,
   432	            )
   433	            quarantine = self._path.with_name(
   434	                f"{self._path.name}.corrupt.{os.getpid()}-{next(_QUARANTINE_SEQ)}"
   435	            )
   436	            try:
   437	                self._path.replace(quarantine)  # atomic, evidence preserved
   438	            except FileNotFoundError:
   439	                pass
   440	            for stale in sqlite_sidecars(self._path):
   441	                stale.unlink(missing_ok=True)
   442	            super().__init__(**kwargs)  # fresh empty index at the same path
   443	            self._open_index()  # offset absent + non-empty log ⇒ rebuild
   444	
   445	    def _open_index(self) -> None:
   446	        """Schema prep + catch-up, leaving the db reopenable on failure."""
   447	        try:
   448	            self._ensure_fact_signature_column()
   449	            self._ensure_chain_columns()
   450	            self._ensure_meta_table()
