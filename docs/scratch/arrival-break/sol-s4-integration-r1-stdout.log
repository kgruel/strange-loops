   195	
   196	def _validate_batch(obj: dict, *, validate_rows: bool = True) -> None:
   197	    """Hold a batch envelope to structural rules."""
   198	    unknown = sorted(set(obj) - _BATCH_KEYS)
   199	    if unknown:
   200	        raise JsonlCodecError(f"unknown field(s) in batch line: {unknown}")
   201	    rows = obj.get(_ROWS)
   202	    if not isinstance(rows, list):
   203	        raise JsonlCodecError(
   204	            "batch field 'rows' must be an array of fact records, got "
   205	            f"{type(rows).__name__}"
   206	        )
   207	    if len(rows) < _MIN_BATCH_ROWS:
   208	        raise JsonlCodecError(
   209	            f"batch must carry at least {_MIN_BATCH_ROWS} rows, got "
   210	            f"{len(rows)} — a 1-row batch is a second spelling of a plain "
   211	            "fact line, and an empty one encodes nothing"
   212	        )
   213	    seen_ids: set[str] = set()
   214	    for i, elem in enumerate(rows):
   215	        if not isinstance(elem, dict):
   216	            raise JsonlCodecError(
   217	                f"batch row {i} must be a JSON object, got {type(elem).__name__}"
   218	            )
   219	        t = elem.get("t")
   220	        if t == _BATCH:
   221	            raise JsonlCodecError(f"batch row {i} is a nested batch — batches do not nest")
   222	        if t == "tick":
   223	            raise JsonlCodecError(
   224	                f"batch row {i} is a tick record — ticks are minted "
   225	                "one-at-a-time and chain-linked, never batched"
   226	            )
   227	        if t != "fact":
   228	            raise JsonlCodecError(f"batch row {i} has unknown record discriminator t={t!r}")
   229	        if validate_rows:
   230	            _validate(elem, _SPEC["fact"])
   231	        row_id = elem["id"]
   232	        if row_id in seen_ids:
   233	            raise JsonlCodecError(f"duplicate id {row_id!r} within one batch")
   234	        seen_ids.add(row_id)
