   549	def durable_handle(pos: WitnessPosition) -> str | None:
   550	    """The PORTABLE address form for a position, or ``None`` if not serializable.
   551	
   552	    A10-narrowed durable-handle contract (final-contracts Session 1):
   553	
   554	    - **Adopted** store → ``fact:<lineage>/<id>`` — the lineage-qualified handle.
   555	      Re-resolving it elsewhere verifies the lineage and re-resolves the id in
   556	      the target store (never reuses a rowid), so the same handle can never
   557	      silently mean a different prefix across stores.
   558	    - **Unadopted** store (no lineage), or the empty/genesis sentinel → ``None``:
   559	      **durable serialization is REFUSED** (N1). The position is session-local;
   560	      no surrogate id is invented. A caller rendering cursor metadata MUST NOT
   561	      present a bare ``fact:<id>`` as a reusable handle here — it is not portable
   562	      (the id resolves in ANY store that merged the fact, to a different prefix).
   563	    """
   564	    if pos.unadopted or pos.lineage is None or not pos.fact_id:
   565	        return None
   566	    return f"fact:{pos.lineage}/{pos.fact_id}"
