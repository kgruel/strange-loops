  1196	def damage_a_line(lineage: str, needle: str) -> None:
  1197	    """Replace the first journal line containing ``needle`` with garbage.
  1198	
  1199	    Exactly what a crashed writer or a bad block leaves: a line this build
  1200	    cannot read, sitting in a file it can otherwise read fine.
  1201	    """
  1202	    path = journal_path(lineage)
  1203	    lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
  1204	    for index, line in enumerate(lines):
  1205	        if needle in line:
  1206	            lines[index] = "{ this is not json\n"
  1207	            break
  1208	    else:  # pragma: no cover - a test that damaged nothing proves nothing
  1209	        raise AssertionError(f"no journal line held {needle!r}")
  1210	    path.write_text("".join(lines), encoding="utf-8")
