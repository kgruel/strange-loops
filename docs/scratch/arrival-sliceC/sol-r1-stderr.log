   354	def _expected_for(case: LensCase, rows: list[dict[str, Any]]) -> dict[str, Any]:
   355	    """The expected block for one case, from the combined read's records.
   356	
   357	    The default `ByKey("ts")` family keeps `vertex_facts` as its oracle — those
   358	    vectors are frozen normative artifacts and their order must not start
   359	    depending on a different code path. `totalize` is asserted to AGREE with
   360	    it, which is how the family is pinned "via the atoms primitive" without
   361	    swapping the oracle underneath the frozen files. A disagreement is a
   362	    finding, so it fails the regeneration loudly rather than rewriting bytes.
   363	    """
   364	    def ordered() -> list[dict[str, Any]]:
   365	        return totalize(
   366	            rows, case.ordering, get_field=lens_get_field, get_id=lambda r: r["id"]
   367	        )
   368	
   369	    if case.expect_error:
   370	        try:
   371	            ordered()
   372	        except OrderingError:
   373	            return {"error": "OrderingError"}
   374	        raise AssertionError(
   375	            f"{case.name} declares expect_error but {case.ordering!r} accepted its records"
   376	        )
   377	
   378	    lens_order = [r["id"] for r in ordered()]
   379	
   380	    if case.ordering == DEFAULT_ORDERING:
   381	        production_order = [r["id"] for r in rows]
   382	        if lens_order != production_order:
   383	            raise AssertionError(
   384	                f"{case.name}: atoms totalize disagrees with the production combined "
   385	                f"read under {case.ordering!r} — totalize {lens_order}, "
   386	                f"vertex_facts {production_order}. This is a finding, not a regeneration."
   387	            )
   388	        return {"lens_order": production_order}
   389	
   390	    return {"lens_order": lens_order}
