    71	    "tmp_path_for",
    72	]
    73	
    74	CANONICAL_LOG_SUFFIX = ".jsonl"
    75	SQLITE_SUFFIXES = (".db", ".sqlite")
    76	
    77	_INDEX_SUFFIX = ".db"
    78	
    79	# Which suffix a canonical mode's artifact carries — the sibling bijection's
    80	# one spelling, read by canonical_for. sqlite maps to itself: the index IS
    81	# the canonical artifact there.
    82	_MODE_SUFFIX = {"arrival": ARRIVAL_SUFFIX, "jsonl": CANONICAL_LOG_SUFFIX}
    83	
    84	
    85	def canonical_mode(declared: Path | str) -> str:
    86	    """Which artifact class is authoritative for a store locator.
    87	
    88	    ``"arrival"`` | ``"jsonl"`` | ``"sqlite"`` — one function, three arms,
    89	    callers compare. A family of per-mode booleans is how a two-mode
    90	    architecture creeps back in, so there isn't one.
    91	
    92	    Any suffix that is not a log suffix answers ``"sqlite"``: that is what
    93	    ``open_canonical_store`` does with such a path (connect to it as
    94	    sqlite) — with one named exception, ``engine.compiler``'s flat
    95	    ``EventStore`` fallback for suffixes outside the store family, which
    96	    checks the suffix itself before consulting this switch. "Is this a
    97	    loops artifact at all" is :func:`engine.probe.probe_target`'s question,
    98	    not a path function's.
    99	    """
   100	    suffix = Path(declared).suffix
   101	    if suffix == ARRIVAL_SUFFIX:
   102	        return "arrival"
   103	    if suffix == CANONICAL_LOG_SUFFIX:
   104	        return "jsonl"
   105	    return "sqlite"
   106	
   107	
   108	def is_jsonl_canonical(declared: Path | str) -> bool:  # noqa: D103 — shim, see below
   109	    # Retired alias, NOT exported and named by nothing else in libs: kept
   110	    # importable only for the lazy import at
   111	    # apps/loops/src/loops/commands/store.py:142, which executes before any
   112	    # mode check and would ImportError every store read verb if deleted —
   113	    # apps/ is diff-empty for the whole arrival wave, so the caller cannot
   114	    # move until the CLI-surface cut. Deleted there, together with Rule 18's
   115	    # allowlist entry for this line. Behavior-identical to the pre-arrival
   116	    # answer: an .arrival locator answers False (its agreement audit is a
   117	    # later cut's).
   118	    return canonical_mode(declared) == "jsonl"
   119	
   120	
   121	def canonical_store_path(declared: Path | str, vertex_path: Path | None) -> Path:
   122	    """The declared artifact as an absolute path.
   123	
   124	    Relative locators resolve against the *vertex file's* directory, never
   125	    the process cwd — a vertex is portable, a cwd is not.
   126	    """
   127	    path = Path(declared)
   128	    if not path.is_absolute() and vertex_path is not None:
   129	        path = (Path(vertex_path).parent / path).resolve()
   130	    return path
   131	
   132	
   133	def index_path_for(canonical: Path | str) -> Path:
   134	    """The sqlite file to connect to for a given canonical locator.
   135	
   136	    A log mode (arrival or jsonl) → the sibling ``.db``; sqlite mode →
   137	    itself. Idempotent: feeding an index path back through returns it
   138	    unchanged.
   139	    """
   140	    path = Path(canonical)
   141	    if canonical_mode(path) == "sqlite":
   142	        return path
   143	    return path.with_suffix(_INDEX_SUFFIX)
   144	
   145	
