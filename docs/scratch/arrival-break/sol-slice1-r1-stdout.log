    96	
    97	GRAMMAR_VERSION = 1
    98	GENESIS_KIND = "genesis"
    99	
   100	# The kind that introduces a key into the log's own registry. Its body names
   101	# the observer the key speaks for and the key itself; the record must be
   102	# signed by a key that is ALREADY valid at its ordinal, which is what makes
   103	# the registry a chain of custody rather than a mutable table.
   104	KEY_INTRODUCTION_KIND = "key"
   105	
   106	# Emitted key order. Transport encoding, not canonicalization — the same
   107	# posture ``jsonl_codec._dump`` documents; canonicalization for hashing is JCS
   108	# and is independent of the order bytes come out in. ``rh`` is last purely as
   109	# a reading convenience: it cannot cover itself, so it is computed over the
   110	# object with ``rh`` removed.
   111	RECORD_FIELDS = ("v", "lin", "ord", "prev", "at", "k", "observer", "origin", "body")
   112	_SIG = "sig"
   113	_RH = "rh"
   114	_ALLOWED = frozenset((*RECORD_FIELDS, _SIG, _RH))
