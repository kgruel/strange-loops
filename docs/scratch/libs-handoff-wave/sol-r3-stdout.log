   164	def list_file_read(path: Path) -> tuple[list[str], list[PopulationRow]]:
   165	    """Read header + rows from a .list file.
   166	
   167	    Skips comments (#) and blank lines.
   168	    Last column gets remainder (split limit = len(header) - 1).
   169	    """
   170	    text = path.read_text()
   171	    lines = text.splitlines()
   172	    header: list[str] | None = None
   173	    rows: list[PopulationRow] = []
   174	
   175	    for raw in lines:
   176	        line = raw.strip()
   177	        if not line or line.startswith("#"):
   178	            continue
   179	
   180	        if header is None:
   181	            header = line.split()
   182	            continue
   183	
   184	        parts = line.split(None, len(header) - 1)
   185	        if len(parts) != len(header):
   186	            continue  # skip malformed rows
   187	        values = dict(zip(header, parts))
   188	        rows.append(PopulationRow(key=parts[0], values=values))
   189	
   190	    return header or [], rows
   191	
   192	
   193	def list_file_header(path: Path) -> list[str]:
   194	    """Read only the header row from a .list file.
   195	
   196	    Returns [] if no header is present.
   197	    """
   198	    if not path.exists():
   199	        return []
   200	    for raw in path.read_text().splitlines():
   201	        line = raw.strip()
   202	        if not line or line.startswith("#"):
   203	            continue
   204	        return line.split()
   205	    return []
   206	
