   267	
   268	def read_population(
   269	    vertex: VertexFile, template: TemplateSource, base_dir: Path
   270	) -> PopulationInfo:
   271	    """Read full population — merges file rows + inline rows.
   272	
   273	    Header inferred from first available row's keys.
   274	    """
   275	    file_rows: list[PopulationRow] = []
   276	    file_header: list[str] = []
   277	    file_path: Path | None = None
   278	
   279	    # File-sourced rows
   280	    if isinstance(template.from_, FromFile):
   281	        fp = template.from_.path
   282	        if not fp.is_absolute():
   283	            fp = base_dir / fp
   284	        file_path = fp
   285	        if fp.exists():
   286	            file_header, file_rows = list_file_read(fp)
   287	
   288	    # Inline rows
   289	    inline_rows: list[PopulationRow] = []
   290	    for sp in template.params:
   291	        key = next(iter(sp.values.values())) if sp.values else ""
   292	        inline_rows.append(PopulationRow(key=key, values=dict(sp.values)))
   293	
   294	    # Determine storage
   295	    has_file = template.from_ is not None
   296	    has_inline = len(template.params) > 0
   297	    if has_file and has_inline:
   298	        storage = "both"
   299	    elif has_file:
   300	        storage = "file"
   301	    else:
   302	        storage = "inline"
   303	
   304	    # Merge rows: file first, then inline
   305	    all_rows = file_rows + inline_rows
   306	
   307	    # Infer header
   308	    if file_header:
   309	        header = file_header
   310	    elif all_rows:
   311	        header = list(all_rows[0].values.keys())
   312	    else:
   313	        header = []
   314	
   315	    return PopulationInfo(
   316	        template_name=template_name(template),
   317	        header=header,
   318	        rows=all_rows,
   319	        storage=storage,
   320	        file_path=file_path,
   321	        vertex_path=vertex.path or base_dir,
   322	    )
