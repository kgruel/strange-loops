   247	def _resolve_anchor(conn: sqlite3.Connection, rowid: int) -> TickAnchor | None:
   248	    """Last sealed tick whose ``fact_cursor`` resolves at-or-before ``rowid``.
   249	
   250	    Joins ``ticks.fact_cursor`` to ``facts.id`` (the same id→rowid resolution the
   251	    window hash uses) and takes the highest cursor-rowid within the prefix. Pre-
   252	    chain schemas (no ``fact_cursor`` column) and pre-chain rows (empty cursor)
   253	    contribute nothing — honestly no anchor.
   254	
   255	    Tie-break: when several ticks seal the SAME ``fact_cursor`` (a re-fired
   256	    boundary), the LAST-appended tick wins (``t.rowid DESC``) — the "last tick"
   257	    the docstring promises, resolved deterministically rather than by whichever
   258	    row the engine happened to return.
   259	    """
   260	    tick_cols = {r[1] for r in conn.execute("PRAGMA table_info(ticks)")}
   261	    if "fact_cursor" not in tick_cols:
   262	        return None
   263	    row = conn.execute(
   264	        "SELECT t.name, t.ts, t.fact_cursor FROM ticks t "
   265	        "JOIN facts f ON f.id = t.fact_cursor "
   266	        "WHERE t.fact_cursor IS NOT NULL AND t.fact_cursor <> '' "
   267	        "AND f.rowid <= ? ORDER BY f.rowid DESC, t.rowid DESC LIMIT 1",
   268	        (rowid,),
   269	    ).fetchone()
   270	    if row is None:
   271	        return None
   272	    return TickAnchor(name=row[0], ts=row[1], fact_cursor=row[2])
