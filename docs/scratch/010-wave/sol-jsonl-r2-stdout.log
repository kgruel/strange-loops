   695	def test_ensure_index_is_a_no_op_when_the_index_is_current(tmp_path):
   696	    """The common case must not construct a store or take the write lock."""
   697	    from engine import jsonl_store as mod
   698	
   699	    store = open_store(tmp_path)
   700	    store.append(fact())
   701	    store.close()
   702	
   703	    calls = {"n": 0}
   704	    real = mod.JsonlStore
   705	
   706	    class Counting(real):
   707	        def __init__(self, **kw):
   708	            calls["n"] += 1
   709	            super().__init__(**kw)
   710	
   711	    mod.JsonlStore = Counting
   712	    try:
   713	        assert mod.ensure_index(tmp_path / "s.jsonl") == tmp_path / "s.db"
   714	    finally:
   715	        mod.JsonlStore = real
   716	    assert calls["n"] == 0
