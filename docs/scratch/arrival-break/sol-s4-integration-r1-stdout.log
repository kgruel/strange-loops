   318	# ---------------------------------------------------------------------------
   319	# Test 3: Resume against tampered target refuses with no repair (F2 gate)
   320	# ---------------------------------------------------------------------------
   321	
   322	
   323	def test_resume_against_tampered_target_refuses_no_repair(tmp_path: Path) -> None:
   324	    """(3) Resume against tampered target -> typed refusal, target bytes unchanged (F2)."""
   325	    store_dir = tmp_path / "data"
   326	    store_dir.mkdir(parents=True, exist_ok=True)
   327	    cust = CustodianFixture(tmp_path, "alice")
   328	    source_path = build_synthetic_jsonl(store_dir / "legacy.jsonl")
   329	    v_path = _make_vertex_file(
   330	        tmp_path,
   331	        custodian_name=cust.name,
   332	        custodian_key=cust.public,
   333	        other_observers=[],
   334	    )
   335	
   336	    t_res = transform(source_path, parse_vertex_file(v_path), signer=cust.signer)
   337	    lineage = mint_lineage()
   338	    target_path = store_dir / f"{lineage}.arrival"
   339	
   340	    registry = BackendRegistry.with_builtin_backends()
   341	    desc = StoreDescriptor(backend="file", location=str(target_path), lineage=lineage)
   342	    ledger, _ = registry.open(desc)
   343	    genesis_head = ledger.mint(
   344	        {
   345	            "observer": t_res.genesis.custodian,
   346	            "signer": cust.signer,
   347	            "key": t_res.genesis.key,
   348	            "lineage": lineage,
   349	            "at": 0.0,
   350	        }
   351	    )
   352	    records = []
   353	    prev_rh = genesis_head.record_hash
   354	    for i, d in enumerate(t_res.drafts[:3]):
   355	        rec = build_record(
   356	            lin=lineage,
   357	            ordinal=genesis_head.ordinal + 1 + i,
   358	            prev=prev_rh,
   359	            k=d.kind,
   360	            body=dict(d.body),
   361	            observer=d.observer,
   362	            origin=d.origin,
   363	            at=d.authored_at,
   364	            sig=d.signature,
   365	        )
   366	        records.append(rec)
   367	        prev_rh = rec["rh"]
   368	    ledger.replicate(expected=genesis_head, records=records)
   369	
   370	    # Tamper with an appended record: flip bytes inside the file (e.g. at byte offset 200)
   371	    orig_bytes = bytearray(target_path.read_bytes())
   372	    # Modify payload text inside the record
   373	    tampered_bytes = bytearray(orig_bytes)
   374	    tampered_bytes[len(tampered_bytes) - 50] ^= 0x01
   375	    target_path.write_bytes(tampered_bytes)
   376	    recorded_tampered_bytes = target_path.read_bytes()
   377	
   378	    with pytest.raises(TargetUnopenable) as exc_info:
   379	        run_migration(
   380	            source_path=source_path,
   381	            vertex_path=v_path,
   382	            store_dir=store_dir,
   383	            signer=cust.signer,
   384	            resume_target=target_path,
   385	        )
   386	
   387	    assert isinstance(exc_info.value.cause, StoreLost)
   388	    assert exc_info.value.target_path == str(target_path)
   389	
   390	    # F2: Verification never repairs — target bytes MUST remain unchanged
   391	    assert target_path.read_bytes() == recorded_tampered_bytes
   392	
