   570	            signature = signature_override
   571	        elif self._fact_signer is not None:
   572	            signature = self._fact_signer(
   573	                observer,
   574	                _fact_commitment_hash(d["kind"], d["ts"], observer, origin, payload_text),
   575	            )
   576	        else:
   577	            signature = None
   578	        committed = self._write_fact_row(
   579	            (fact_id, d["kind"], d["ts"], observer, origin, payload_text, signature)
   580	        )
   581	        return fact_id, committed
