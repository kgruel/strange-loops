   175	def _validate_log(source: Path) -> None:
   176	    """Read-only pass: every line of ``source`` must decode, tail included.
   177	
   178	    A REBUILD source is **evidence**, and a different contract from a live
   179	    log. :class:`~engine.jsonl_store.JsonlStore` truncates a torn final line
   180	    because the next append would otherwise concatenate onto junk — repair is
   181	    right when the log is the store being written. Here the log is an input
   182	    someone handed us to read: a torn tail means the evidence is incomplete,
   183	    which is a fact to report, not damage to silently edit away. So this
   184	    validates first and mutates nothing, and construction below only ever
   185	    sees a log it has already proven clean.
   186	    """
   187	    from engine.jsonl_codec import deserialize_row
   188	
   189	    size = source.stat().st_size
   190	    with source.open("rb") as fh:
   191	        if size:
   192	            fh.seek(size - 1)
   193	            if fh.read(1) != b"\n":
   194	                raise ValueError(
   195	                    f"JSONL log has a torn final line (no trailing newline): "
   196	                    f"{source} — a rebuild source is evidence and is never "
   197	                    "repaired; recover or truncate it deliberately first"
   198	                )
   199	            fh.seek(0)
   200	        for raw in fh:
   201	            line = raw.decode("utf-8").strip()
   202	            if line:
   203	                deserialize_row(line)  # JsonlCodecError names the bad line
