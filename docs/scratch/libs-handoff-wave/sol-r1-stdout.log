   239	        raise JsonlCodecError(f"unknown field(s) in {t} line: {unknown}")
   240	    missing = [f for f in spec.fields if f not in obj]
   241	    if missing:
   242	        raise JsonlCodecError(f"missing field(s) in {t} line: {missing}")
   243	    for field in spec.fields:
   244	        value = obj[field]
   245	        if value is None:
   246	            if field not in spec.nullable:
   247	                raise JsonlCodecError(f"{t} field {field!r} must not be null")
