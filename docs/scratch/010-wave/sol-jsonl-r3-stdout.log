#!/usr/bin/env bash
# Dev harness for the monorepo root — repo-level invariants.
#
# `./dev check` runs the tests that belong to no single package: the
# architecture ratchet (tests/test_architecture.py — lib DAG, import
# boundaries, domain-constant pin, frozen-dataclass convention). These
# were previously run only by hand, and 4 of 7 rules silently went red
# (found 2026-07-16, custody extraction). A ratchet nothing runs is
# review vigilance wearing a test's costume — this script is the fix.
#
# Per-package tests keep their documented invocations:
#   uv run --package <name> pytest libs/<name>/tests
set -euo pipefail

cd "$(dirname "$0")"

case "${1:-}" in
    check)
        exec uv run pytest tests/ -q
        ;;
    *)
        echo "Usage: ./dev check    # repo-level invariants (architecture ratchet)"
        exit "$([ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && echo 0 || echo 1)"
        ;;
esac
[project]
name = "strange-loops"
version = "0.9.0"
description = "A system for focusing attention"
readme = "README.md"
license = "MIT"
authors = [{ name = "Kyle Gruel", email = "kylegruel@gmail.com" }]
requires-python = ">=3.11"
# This is a FLAT vendored build: hatchling bundles every libs/*/src into one
# wheel (see [tool.hatch.build] below), so this list must mirror the UNION of
# all vendored libs' third-party deps by hand — the root does not depend on the
# workspace members, it inlines their source. A dep added to a lib's pyproject
# (e.g. engine's rfc8785, added with the JCS migration) is invisible to
# `uv tool install .` until it is also added here. `uv run --package` masks the
