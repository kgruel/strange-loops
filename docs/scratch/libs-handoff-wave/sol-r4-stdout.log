    64	]
    65	
    66	
    67	# ---------------------------------------------------------------------------
    68	# Names and string values
    69	# ---------------------------------------------------------------------------
    70	
    71	# Conservative bare-identifier subset of KDL. The splice layer matches
    72	# children by first token, so quoted node names are not representable —
    73	# names outside this set are rejected rather than escaped.
    74	_BARE_NAME_CHARS = frozenset(
    75	    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
    76	)
    77	
    78	# Node names the loops block treats specially (never kind definitions).
    79	_RESERVED_KIND_NAMES = frozenset({"boundary"})
    80	
    81	
    82	def _validate_kind_name(kind: str) -> None:
    83	    if not kind:
    84	        raise ValueError("kind name is empty")
    85	    if kind in _RESERVED_KIND_NAMES:
    86	        raise ValueError(f"kind name {kind!r} is reserved inside the loops block")
    87	    if kind[0].isdigit() or kind[0] in ".-":
    88	        raise ValueError(
    89	            f"kind name {kind!r} must start with a letter or underscore"
    90	        )
    91	    bad = set(kind) - _BARE_NAME_CHARS
    92	    if bad:
    93	        raise ValueError(
    94	            f"kind name {kind!r} contains characters KDL cannot represent "
    95	            f"safely here: {sorted(bad)!r} (allowed: letters, digits, _ . -)"
    96	        )
    97	
    98	
    99	def _q(value: str, *, what: str) -> str:
   100	    """Quote a string as a KDL string literal.
   101	
   102	    Escapes backslash and double-quote; rejects control characters and
   103	    newlines rather than escaping them (they cannot survive the line-based
   104	    splice layer).
   105	    """
   106	    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in value):
   107	        raise ValueError(
   108	            f"{what} {value!r} contains control characters or newlines, "
   109	            "which are not representable in a single-line KDL value here"
   110	        )
   111	    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
   112	
   113	
   114	def _num(value: float) -> str:
   115	    """Emit a float as a KDL number, dropping a trailing .0 when integral."""
   116	    if float(value).is_integer():
   117	        return str(int(value))
   118	    return repr(float(value))
   119	
   120	
   121	# ---------------------------------------------------------------------------
   122	# LoopDef -> KDL serializer
   123	# ---------------------------------------------------------------------------
   124	
   125	
   126	def _fold_op_kdl(target: str, op) -> str:
   127	    t = _q(target, what="fold target") if set(target) - _BARE_NAME_CHARS else target
   128	    if isinstance(op, FoldCount):
   129	        return f'{t} "count"'
   130	    if isinstance(op, FoldLatest):
   131	        return f'{t} "latest"'
   132	    if isinstance(op, FoldBy):
   133	        return f'{t} "by" {_q(op.key_field, what="fold key_field")}'
   134	    if isinstance(op, FoldSum):
   135	        return f'{t} "sum" {_q(op.field, what="fold field")}'
   136	    if isinstance(op, FoldMax):
   137	        return f'{t} "max" {_q(op.field, what="fold field")}'
   138	    if isinstance(op, FoldMin):
   139	        return f'{t} "min" {_q(op.field, what="fold field")}'
   140	    if isinstance(op, FoldAvg):
   141	        return f'{t} "avg" {_q(op.field, what="fold field")}'
   142	    if isinstance(op, FoldCollect):
   143	        return f'{t} "collect" {int(op.max_items)}'
   144	    if isinstance(op, FoldWindow):
   145	        return f'{t} "window" {int(op.size)} {_q(op.field, what="fold field")}'
   146	    raise ValueError(f"Unknown fold op: {op!r}")
   147	
   148	
   149	def _condition_kdl(cond: BoundaryCondition) -> str:
   150	    value = (
   151	        _num(cond.value)
   152	        if isinstance(cond.value, (int, float))
   153	        else _q(str(cond.value), what="condition value")
   154	    )
   155	    return (
   156	        f'condition {_q(cond.target, what="condition target")} '
   157	        f'{_q(cond.op, what="condition op")} {value}'
   158	    )
   159	
   160	
   161	def _boundary_kdl(boundary: Boundary, indent: str) -> list[str]:
   162	    children: list[str] = []
   163	    if isinstance(boundary, BoundaryWhen):
   164	        head = f'boundary when={_q(boundary.kind, what="boundary kind")}'
   165	        for k, v in boundary.match:
   166	            if set(k) - _BARE_NAME_CHARS:
   167	                raise ValueError(
   168	                    f"boundary match field {k!r} is not a bare KDL identifier"
   169	                )
   170	            head += f' {k}={_q(v, what="boundary match value")}'
   171	        children.extend(_condition_kdl(c) for c in boundary.conditions)
   172	    elif isinstance(boundary, BoundaryAfter):
   173	        head = f"boundary after={int(boundary.count)}"
   174	    elif isinstance(boundary, BoundaryEvery):
   175	        head = f"boundary every={int(boundary.count)}"
   176	    else:
   177	        raise ValueError(f"Unknown boundary: {boundary!r}")
   178	
   179	    if boundary.run is not None:
   180	        children.append(f'run {_q(boundary.run, what="boundary run command")}')
   181	
   182	    if not children:
   183	        return [head]
   184	    lines = [head + " {"]
   185	    lines.extend(indent + c for c in children)
   186	    lines.append("}")
   187	    return lines
   188	
   189	
   190	def loop_def_to_kdl(kind: str, definition: LoopDef, indent: str = "  ") -> str:
   191	    """Serialize a LoopDef as the KDL block ``<kind> { ... }``.
   192	
   193	    Supported domain (the declarative kind surface): ``fold``, ``boundary``,
   194	    ``search``, ``preview``, ``edge``, and ``lifecycle``. Within that
   195	    domain, the output re-parses (via the lang loader) to an equivalent
   196	    LoopDef.
   197	
   198	    Per-kind ``parse`` pipelines are OUTSIDE the supported domain by
   199	    contract: passing a LoopDef with a parse pipeline raises ValueError.
   200	    This is a documented refusal, not a round-trip gap — no full-LoopDef
   201	    round-trip is claimed. Also raises ValueError for names or values KDL
   202	    cannot represent safely here.
   203	    """
   204	    _validate_kind_name(kind)
   205	    if definition.parse:
   206	        raise ValueError(
   207	            "loop_def_to_kdl serializes the declarative kind surface only "
   208	            "(fold/boundary/search/preview/edge/lifecycle); per-kind parse "
   209	            "pipelines are outside its supported domain by contract — "
   210	            "author the parse block by hand"
   211	        )
   212	
   213	    body: list[str] = []
   214	
   215	    if definition.folds:
   216	        body.append("fold {")
   217	        for decl in definition.folds:
   218	            body.append(indent + _fold_op_kdl(decl.target, decl.op))
   219	        body.append("}")
   220	
   221	    if definition.boundary is not None:
   222	        body.extend(_boundary_kdl(definition.boundary, indent))
   223	
   224	    if definition.search:
   225	        body.append(
   226	            "search "
   227	            + " ".join(_q(f, what="search field") for f in definition.search)
   228	        )
   229	
   230	    if definition.preview_fields:
   231	        body.append(
   232	            "preview "
   233	            + " ".join(_q(f, what="preview field") for f in definition.preview_fields)
   234	        )
   235	
   236	    for edge in definition.edges:
   237	        body.append(
   238	            f'edge {_q(edge.field, what="edge field")} '
   239	            f'targets={_q(edge.target, what="edge target")}'
   240	        )
   241	
   242	    if definition.lifecycle is not None:
   243	        lc = definition.lifecycle
   244	        for v in lc.active:
   245	            if "," in v or v != v.strip() or not v:
   246	                raise ValueError(
   247	                    f"lifecycle active value {v!r} cannot round-trip through "
   248	                    "the comma-separated active= property"
   249	                )
   250	        active = ",".join(lc.active)
   251	        body.append(
   252	            f'lifecycle {_q(lc.field, what="lifecycle field")} '
   253	            f'active={_q(active, what="lifecycle active set")}'
   254	        )
   255	
   256	    if not body:
   257	        return f"{kind} {{ }}"
   258	    lines = [f"{kind} {{"]
   259	    lines.extend(indent + ln for ln in body)
   260	    lines.append("}")
   261	    return "\n".join(lines)
   262	
   263	
   264	# ---------------------------------------------------------------------------
   265	# Mutations
   266	# ---------------------------------------------------------------------------
   267	
   268	
   269	def _parse_vertex_or_raise(text: str, context: str):
   270	    """Parse vertex text, wrapping parser errors as a clear ValueError."""
   271	    from .loader import parse_vertex
   272	
   273	    try:
   274	        return parse_vertex(text)
   275	    except Exception as exc:
   276	        raise ValueError(
   277	            f"{context}: input is not a parseable vertex: {exc}"
   278	        ) from exc
   279	
   280	
   281	def _loops_block_child_names(text: str) -> list[str]:
   282	    """First tokens of every depth-0 child node in the ``loops`` block.
   283	
   284	    Raw-text multiplicity view — the one thing the parser oracle cannot see
   285	    (duplicate kind nodes collapse last-wins in the parse). Line-based and
   286	    brace-counted like the splice layer; comment tokens are skipped. Empty
   287	    when there is no ``loops`` block.
   288	    """
   289	    try:
   290	        start, end = kdl_find_block(text, ["loops"])
   291	    except ValueError:
   292	        return []
   293	    lines = text.splitlines()
   294	    names: list[str] = []
   295	
   296	    def _collect_line_nodes(segment: str) -> None:
   297	        for node in kdl_split_top_level_nodes(segment):
   298	            tok = node.split(None, 1)[0].split("{", 1)[0]
   299	            if tok and not tok.startswith("/"):
   300	                names.append(tok)
   301	
   302	    if start == end:
   303	        line = lines[start]
   304	        _collect_line_nodes(line[line.index("{") + 1 : line.rindex("}")])
   305	        return names
   306	
   307	    i = start + 1
   308	    while i < end:
   309	        stripped = lines[i].strip()
   310	        if not stripped or stripped.startswith("//"):
   311	            i += 1
   312	            continue
   313	        opens = stripped.count("{") - stripped.count("}")
   314	        if opens > 0:
   315	            tok = stripped.split(None, 1)[0].split("{", 1)[0]
   316	            if tok and not tok.startswith("/"):
   317	                names.append(tok)
   318	            depth = opens
   319	            i += 1
   320	            while i < end and depth > 0:
   321	                depth += lines[i].count("{") - lines[i].count("}")
   322	                i += 1
   323	            continue
   324	        _collect_line_nodes(stripped)
   325	        i += 1
   326	    return names
   327	
   328	
   329	def _assert_unique_kind_nodes(text: str, context: str) -> None:
   330	    """Refuse duplicate loop-kind nodes in the INPUT (SOL-R3-01 part a).
   331	
   332	    The parser collapses duplicate kind names last-wins, so the parser
   333	    oracle is structurally blind to them: a splice that loses one physical
   334	    duplicate parses definition-equal. Duplicates in the input are
   335	    pathological — a pre-condition refusal on the raw text, not a safety
   336	    detector; the parser oracle remains the post-condition authority.
   337	    """
   338	    from collections import Counter
   339	
   340	    counted = Counter(
   341	        n for n in _loops_block_child_names(text)
   342	        if n not in _RESERVED_KIND_NAMES
   343	    )
   344	    dupes = sorted(n for n, c in counted.items() if c > 1)
   345	    if dupes:
   346	        raise ValueError(
   347	            f"{context}: duplicate loop-kind declaration(s) {dupes} in the "
   348	            "loops block — the parser resolves duplicates last-wins, so a "
   349	            "text mutation over them cannot be verified; deduplicate the "
   350	            "vertex by hand first"
   351	        )
   352	
   353	
   354	def _has_comment_outside_strings(s: str) -> bool:
   355	    """Quote-aware scan for KDL comment openers (``//``, ``/*``, ``/-``)."""
   356	    in_str = esc = False
   357	    for i, ch in enumerate(s):
   358	        if in_str:
   359	            if esc:
   360	                esc = False
   361	            elif ch == "\\":
   362	                esc = True
   363	            elif ch == '"':
   364	                in_str = False
   365	        elif ch == '"':
   366	            in_str = True
   367	        elif ch == "/" and i + 1 < len(s) and s[i + 1] in "/*-":
   368	            return True
   369	    return False
   370	
   371	
   372	def _verified(
   373	    before,
   374	    result: str,
   375	    context: str,
   376	    *,
   377	    added: str | None = None,
   378	    edited: str | None = None,
   379	    removed: str | None = None,
   380	    definition=None,
   381	) -> str:
   382	    """Parse + validate mutated text AND assert the exact expected delta.
   383	
   384	    The PARSER is the safety oracle (arbiter ruling, SOL-R2-01): the
   385	    line/lexeme-based splice layer is best-effort transformation only, so
   386	    every mutation re-parses the result and compares it against the
   387	    pre-mutation parse. The only admissible delta is the requested one —
   388	    add: original kind set plus the new kind, every original definition
   389	    equal; edit: same kind set, only the target changed; remove: set minus
   390	    the target, every other definition equal. Non-loop content (sources,
   391	    routes, store, …) must be untouched in all three. Any mismatch raises
   392	    ValueError naming the preserved-content violation, and the caller's
   393	    original text is never replaced. This makes silent sibling loss
   394	    inexpressible regardless of lexical evasion class (raw strings,
   395	    escaped quotes, comments).
   396	    """
   397	    from .validator import validate_vertex
   398	
   399	    try:
   400	        after = _parse_vertex_or_raise(result, context)
   401	        validate_vertex(after)
   402	    except Exception as exc:
   403	        raise ValueError(
   404	            f"{context} produced an invalid vertex: {exc}"
   405	        ) from exc
   406	
   407	    before_kinds = set(before.loops)
   408	    expected = set(before_kinds)
   409	    if added is not None:
   410	        expected.add(added)
   411	    if removed is not None:
   412	        expected.discard(removed)
   413	    after_kinds = set(after.loops)
   414	    if after_kinds != expected:
   415	        lost = sorted(expected - after_kinds)
   416	        gained = sorted(after_kinds - expected)
   417	        raise ValueError(
   418	            f"{context} violated content preservation: resulting kind set "
   419	            f"differs from the expected delta (lost: {lost}, unexpected: "
   420	            f"{gained}) — refusing; the original text is unchanged. If the "
   421	            "kind shares its physical line with siblings, split each kind "
   422	            "onto its own line first"
   423	        )
   424	    target = added if added is not None else edited
   425	    if target is not None and definition is not None:
   426	        if after.loops.get(target) != definition:
   427	            raise ValueError(
   428	                f"{context} violated content preservation: kind {target!r} "
   429	                "parses back different from the requested definition — "
   430	                "refusing; the original text is unchanged"
   431	            )
   432	    mutated = {added, edited, removed} - {None}
   433	    for k in before_kinds - mutated:
   434	        if before.loops[k] != after.loops[k]:
   435	            raise ValueError(
   436	                f"{context} violated content preservation: sibling kind "
   437	                f"{k!r} was altered by the text splice — refusing; the "
   438	                "original text is unchanged"
   439	            )
   440	    # Non-kind vertex content (store, sources, routes, …) must be untouched.
   441	    # VertexFile fields are exposed via __match_args__ (the frozen-AST shim).
   442	    for f in type(before).__match_args__:
   443	        if f == "loops":
   444	            continue
   445	        if getattr(before, f) != getattr(after, f):
   446	            raise ValueError(
   447	                f"{context} violated content preservation: non-kind vertex "
   448	                f"content changed (field {f!r}) — refusing; the original "
   449	                "text is unchanged"
   450	            )
   451	    return result
   452	
   453	
   454	def add_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   455	    """Add a loop-kind definition to vertex text; returns the new text.
   456	
   457	    Creates the ``loops`` block (appended at end of file) when absent.
   458	    Refuses if the kind already exists. Note the one-way expand-on-insert
   459	    limitation: a single-line ``loops { ... }`` block is expanded across
   460	    lines by the insert.
   461	    """
   462	    _validate_kind_name(kind)
   463	    before = _parse_vertex_or_raise(text, f"add_vertex_kind({kind!r})")
   464	    _assert_unique_kind_nodes(text, f"add_vertex_kind({kind!r})")
   465	    if kind in before.loops:
   466	        raise ValueError(f"kind {kind!r} already exists; use edit_vertex_kind")
   467	
   468	    child = loop_def_to_kdl(kind, definition)
   469	    try:
   470	        kdl_find_block(text, ["loops"])
   471	        has_loops = True
   472	    except ValueError:
   473	        has_loops = False
   474	    if has_loops:
   475	        result = kdl_insert_child(text, ["loops"], child)
   476	    else:
   477	        # No loops block — create one at end of file.
   478	        indented = "\n".join(
   479	            ("  " + ln) if ln.strip() else ln for ln in child.splitlines()
   480	        )
   481	        block = f"loops {{\n{indented}\n}}\n"
   482	        if text and not text.endswith("\n"):
   483	            text += "\n"
   484	        result = text + block
   485	    return _verified(
   486	        before, result, f"add_vertex_kind({kind!r})",
   487	        added=kind, definition=definition,
   488	    )
   489	
   490	
   491	def edit_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   492	    """Replace an existing kind's definition in place; returns the new text.
   493	
   494	    Preserves the kind's position and all surrounding content. Not
   495	    supported when the whole ``loops`` block is a single line (the
   496	    documented expand-on-insert limitation is one-way).
   497	    """
   498	    _validate_kind_name(kind)
   499	    before = _parse_vertex_or_raise(text, f"edit_vertex_kind({kind!r})")
   500	    _assert_unique_kind_nodes(text, f"edit_vertex_kind({kind!r})")
   501	    try:
   502	        start, end = kdl_find_block(text, ["loops", kind])
   503	    except ValueError as exc:
   504	        raise ValueError(
   505	            f"kind {kind!r} not found in loops block (single-line loops "
   506	            "blocks cannot be edited in place — expand across lines first): "
   507	            f"{exc}"
   508	        ) from exc
   509	
   510	    lines = text.splitlines()
   511	    # Trailing-trivia honesty (SOL-R3-01 part c): the splice regenerates the
   512	    # whole block, so it can carry through exactly ONE piece of trivia — the
   513	    # suffix after the block's final close (`} // note`). Anything comment-
   514	    # shaped INSIDE the replaced span would be silently dropped by the
   515	    # regeneration; _verified claims preservation, so that is a refusal.
   516	    end_line = lines[end]
   517	    close_idx = end_line.rindex("}")
   518	    suffix = end_line[close_idx + 1 :].rstrip()
   519	    interior = "\n".join([*lines[start:end], end_line[: close_idx + 1]])
   520	    if _has_comment_outside_strings(interior):
   521	        raise ValueError(
   522	            f"edit_vertex_kind({kind!r}): the {kind!r} block carries a "
   523	            "comment the regenerated definition cannot preserve — move the "
   524	            "comment outside the block (or edit the file by hand) and retry"
   525	        )
   526	    kind_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   527	    child = loop_def_to_kdl(kind, definition)
   528	    new_lines = [
   529	        (kind_indent + ln) if ln.strip() else ln for ln in child.splitlines()
   530	    ]
   531	    if suffix:
   532	        sep = "" if suffix.startswith((" ", "\t")) else " "
   533	        new_lines[-1] += sep + suffix
   534	    lines[start : end + 1] = new_lines
   535	    result = "\n".join(lines)
   536	    if text.endswith("\n"):
   537	        result += "\n"
   538	    return _verified(
   539	        before, result, f"edit_vertex_kind({kind!r})",
   540	        edited=kind, definition=definition,
   541	    )
   542	
   543	
   544	def remove_vertex_kind(text: str, kind: str) -> str:
   545	    """Remove a kind's definition from vertex text; returns the new text.
   546	
   547	    Not supported when the whole ``loops`` block is a single line. Refuses
   548	    (via post-validation) when removal would leave an invalid vertex, e.g.
   549	    removing the last kind of a vertex with no other sources.
   550	    """
   551	    _validate_kind_name(kind)
   552	    before = _parse_vertex_or_raise(text, f"remove_vertex_kind({kind!r})")
   553	    _assert_unique_kind_nodes(text, f"remove_vertex_kind({kind!r})")
   554	    try:
   555	        result = kdl_remove_child(text, ["loops"], kind)
   556	    except ValueError as exc:
   557	        raise ValueError(
   558	            f"kind {kind!r} not found in loops block (single-line loops "
   559	            "blocks cannot be mutated in place — expand across lines first): "
   560	            f"{exc}"
   561	        ) from exc
   562	    return _verified(
   563	        before, result, f"remove_vertex_kind({kind!r})", removed=kind
   564	    )
     1	"""Population management for template sources.
     2	
     3	Read, write, and transform template populations in .vertex files.
     4	Populations are the parameter rows that instantiate a .loop template N times.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	# re deferred to function bodies (avoids enum ~5ms import)
    10	from typing import TYPE_CHECKING
    11	
    12	from .ast import FromFile, TemplateSource, VertexFile
    13	
    14	if TYPE_CHECKING:
    15	    from pathlib import Path
    16	
    17	
    18	# ---------------------------------------------------------------------------
    19	# Data types
    20	# ---------------------------------------------------------------------------
    21	
    22	
    23	class PopulationRow:
    24	    """One row in a template population."""
    25	
    26	    __slots__ = ("key", "values")
    27	
    28	    def __init__(self, key: str, values: dict[str, str]):
    29	        object.__setattr__(self, "key", key)
    30	        object.__setattr__(self, "values", values)
    31	
    32	    def __repr__(self):
    33	        return f"PopulationRow(key={self.key!r}, values={self.values!r})"
    34	
    35	    def __eq__(self, other):
    36	        if type(self) is not type(other):
    37	            return NotImplemented
    38	        return (self.key, self.values) == (other.key, other.values)
    39	
    40	    def __setattr__(self, name, value):
    41	        raise AttributeError(f"cannot assign to field '{name}'")
    42	
    43	    def __delattr__(self, name):
    44	        raise AttributeError(f"cannot delete field '{name}'")
    45	
    46	
    47	class PopulationInfo:
    48	    """Complete population for a template source."""
    49	
    50	    __slots__ = ("template_name", "header", "rows", "storage", "file_path", "vertex_path")
