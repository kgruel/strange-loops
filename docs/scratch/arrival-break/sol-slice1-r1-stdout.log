   121	_JCS_INT_MIN = -(2**53) + 1
   122	
   123	# Reverse scan granularity for finding a line boundary. Chunked so the scan
   124	# never loads the whole log and never gives up as a function of line length.
   125	_CHUNK = 64 * 1024
   126	
   127	_HEX = frozenset("0123456789abcdef")
