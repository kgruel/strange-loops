   151	    """Resolve a fact_cursor id to a terse summary of its target fact.
   152	
   153	    Read-path affordance, NOT part of any commitment — the chain commits
   154	    to ids and hashes; this is the human-facing dereference. Returns
   155	    ``{"cursor_kind": str, "cursor_preview": str}``. An empty cursor
   156	    resolves to empty fields; a dangling cursor (fact deleted) is named
   157	    explicitly rather than silently blank — verify reports that case as
   158	    a break, but read paths still render honestly.
   159	    """
   160	    if not fact_id:
   161	        return {"cursor_kind": "", "cursor_preview": ""}
   162	    row = conn.execute(
   163	        "SELECT kind, payload FROM facts WHERE id = ?", (fact_id,)
   164	    ).fetchone()
   165	    if row is None:
   166	        return {"cursor_kind": "", "cursor_preview": "(cursor fact missing)"}
   167	    try:
   168	        payload = json.loads(row[1])
   169	    except (TypeError, ValueError):
   170	        payload = {}
   171	    preview = ""
   172	    if isinstance(payload, dict):
   173	        for key in ("message", "topic", "name", "status"):
   174	            val = payload.get(key)
   175	            if isinstance(val, str) and val:
   176	                preview = val
   177	                break
   178	    if len(preview) > 80:
   179	        preview = preview[:79] + "…"
   180	    return {"cursor_kind": row[0], "cursor_preview": preview}
   181	
   182	
   183	def _tick_row_hash(row: tuple) -> str:
   184	    """Era-aware identity hash — what the successor's prev_hash commits to.
   185	
   186	    Includes the signature key only when the row carries one, so every
   187	    pre-signature row (and every pre-chain row) hashes byte-identically to
   188	    delta 1 — no re-anchoring. For signed rows the successor chains over
   189	    content+signature, making signature-stripping a detectable break
   190	    (design/tick-signature-in-chain-envelope).
   191	    """
   192	    envelope = _tick_envelope(row)
   193	    if len(row) > 10 and row[10] is not None:
   194	        envelope["signature"] = row[10]
   195	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
   196	
   197	
   198	# Public name: the row-identity hash is a cross-lib contract. libs/store's
   199	# rebirth receipt records the source chain head with THE chain's hash
   200	# function — a reimplementation could silently diverge from what verify
   201	# walks. Same function, two names: _tick_row_hash stays the internal
   202	# spelling, tick_row_hash is the exported contract.
   203	def tick_row_hash(row: tuple) -> str:
   204	    """Era-aware tick row-identity hash (see _tick_row_hash)."""
   205	    return _tick_row_hash(row)
   206	
   207	
   208	def _fact_row_hash(row: tuple) -> str:
   209	    """Era-aware hash of one persisted fact row.
   210	
   211	    Row shape: (id, kind, ts, observer, origin, payload[, signature]).
   212	    The signature key is included only when the row carries one, so every
   213	    pre-signature fact row hashes byte-identically to delta 1/2 — already-
   214	    sealed window hashes never re-anchor. For signed facts the window
   215	    commits over content+signature, making fact-signature-stripping a
   216	    detectable break in any sealed window (delta-2 envelope trick, one
   217	    layer down — design/fact-signing-per-observer-keys).
   218	    """
   219	    envelope = {
   220	        "id": row[0], "kind": row[1], "ts": row[2],
   221	        "observer": row[3], "origin": row[4], "payload": row[5],
   222	    }
   223	    if len(row) > 6 and row[6] is not None:
   224	        envelope["signature"] = row[6]
   225	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
   226	
   227	
   228	def _fact_commitment_hash(
   229	    kind: str, ts: float, observer: str, origin: str, payload_text: str
   230	) -> str:
   231	    """Hash the fact's CONTENT commitment — what the fact signer signs.
   232	
   233	    Content-only by design (design/fact-signature-at-store-column):
   234	    excludes id and rowid, which are custody context, not authored
   235	    content. This is what makes the signature transport-stable — any
   236	    store holding the row can re-derive the commitment and verify
   237	    authorship against the observer registry without trusting the
   238	    sender. Stored payload TEXT is embedded verbatim (same posture as
   239	    the tick envelope: byte-level tamper detection, no re-serialization).
   240	    Never includes the signature (a signature cannot sign itself).
   241	    """
   242	    envelope = {
   243	        "kind": kind, "ts": ts, "observer": observer,
   244	        "origin": origin, "payload": payload_text,
   245	    }
   246	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
   247	
   248	
   249	# Public name: the content commitment is a cross-lib contract —
   250	# libs/store's transport paths and any receive-side verifier must hash
   251	# the same envelope the signer signed. Same function, two names.
   252	def fact_commitment_hash(
   253	    kind: str, ts: float, observer: str, origin: str, payload_text: str
   254	) -> str:
   255	    """Content commitment hash for fact signing (see _fact_commitment_hash)."""
   256	    return _fact_commitment_hash(kind, ts, observer, origin, payload_text)
