+    v_path = tmp_path / "kyle.vertex"
+    v_content = f"""name "Display Name Project"
+store "./data/legacy.jsonl"
+
+observers {{
+  kyle {{
+    key "{cust.public}"
+  }}
+}}
+
+loops {{
+  concept {{ fold {{ items "collect" 100 }} }}
+}}
+"""
