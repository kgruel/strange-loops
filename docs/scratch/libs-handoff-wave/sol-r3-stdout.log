   543	            reason=(
   544	                f"canonical store backend refused the open: {exc} — "
   545	                "refusing before intent creation"
   546	            ),
   547	        )
   548	
   549	    # Per-mode ceremony table. Staleness is the store's own CAS (module
   550	    # docstring): GenesisExists / StaleDeclarationHead refuse inside the
   551	    # absorb transaction with the log byte-identical — there is no separate
   552	    # currency pre-check to race against.
   553	    if preview.mode == "genesis":
   554	        def ceremony() -> dict[str, Any]:
   555	            return store.absorb_genesis(
   556	                list(preview.documents),
   557	                observer=observer,
   558	                origin="",
   559	                fact_signer=fact_signer,
   560	            )
   561	
   562	        stale_exc: tuple = (GenesisExists,)
   563	        stale_reason = "lineage opened since plan: {exc}"
   564	        refuse_exc: tuple = (AmbiguousGenesis, UnsignableGenesis)
   565	    else:
   566	        def ceremony() -> dict[str, Any]:
   567	            return store.absorb_edit(
   568	                list(preview.changes),
   569	                observer=observer,
   570	                origin="",
   571	                fact_signer=fact_signer,
   572	                expected_head=preview.expected_head,
   573	            )
   574	
   575	        stale_exc = (StaleDeclarationHead,)
   576	        stale_reason = "{exc}"
   577	        refuse_exc = (
   578	            AmbiguousGenesis, NoGenesis, ReservedKindViolation, UnsignableEdit,
   579	        )
   580	
   581	    intent_path = _write_intent(preview, observer)
   582	    try:
   583	        receipt = ceremony()
   584	    except stale_exc as exc:
   585	        _remove_intent(intent_path)
   586	        return DeclarationUpdateResult(
   587	            status="stale", reason=stale_reason.format(exc=exc)
   588	        )
   589	    except refuse_exc as exc:
   590	        _remove_intent(intent_path)
   591	        return DeclarationUpdateResult(status="refused", reason=str(exc))
   592	    except (sqlite3.Error, OSError) as exc:
   593	        # A backend failure DURING the absorb is ambiguous on a
   594	        # JSONL-canonical store: the log line (the store) commits before
   595	        # the index row, so the ceremony may already be live. The intent
   596	        # stays — recover_declaration_update classifies not-applied vs
   597	        # applied from the log.
   598	        return DeclarationUpdateResult(
   599	            status="needs-recovery",
   600	            reason=(
   601	                f"store step failed mid-ceremony ({exc}) — run "
   602	                "recover_declaration_update; it classifies "
   603	                "not-applied vs applied from the canonical store"
   604	            ),
   605	            intent_path=intent_path,
   606	        )
   607	    finally:
   608	        store.close()
   609	
   610	    # Store committed — the point of no return. File replace, then intent
   611	    # removal; any failure from here is the recover path's job.
   612	    writer = write_file or _default_file_write
   613	    try:
   614	        writer(vertex_path, preview.proposed_text)
   615	    except BaseException as exc:  # noqa: BLE001 — typed recovery, not a crash
   616	        return DeclarationUpdateResult(
   617	            status="needs-recovery",
   618	            reason=(
   619	                f"store ceremony committed but the file step failed ({exc}) — "
   620	                "run recover_declaration_update on the intent"
   621	            ),
   622	            receipt=receipt,
   623	            intent_path=intent_path,
   624	        )
   625	    _remove_intent(intent_path)
   626	    return DeclarationUpdateResult(
   627	        status="applied",
   628	        reason="declaration updated — store committed, file reconciled",
   629	        receipt=receipt,
   630	        file_written=preview.proposed_text is not None or write_file is not None,
   631	    )
   632	
   633	
   634	# ---------------------------------------------------------------------------
   635	# recover
   636	# ---------------------------------------------------------------------------
   637	
   638	
   639	def recover_declaration_update(intent: Path | str) -> RecoveryOutcome:
   640	    """Classify and (when safe) finish an interrupted declaration update.
   641	
   642	    Idempotent: a ``safe-to-finish`` run completes the file replace and
   643	    removes the intent; a second run over the same path answers
   644	    ``already-applied`` (no pending intent). ``conflict`` leaves the intent
   645	    AND the file exactly as found — nothing is ever clobbered on that path.
   646	
   647	    Classification (module docstring has the full rule): the store's current
   648	    resolved projection fingerprint against the intent's pins — proposed →
   649	    applied (file matching decides ``already-applied`` vs
   650	    ``safe-to-finish``); the pre-ceremony state → ``not-applied`` (intent
   651	    void, removed); anything else → ``conflict``.
   652	    """
   653	    intent_path = Path(intent)
   654	    if not intent_path.exists():
   655	        return RecoveryOutcome(
   656	            classification="already-applied",
   657	            finished=False,
   658	            reason="no pending intent at this path — nothing to recover",
   659	            intent_path=intent_path,
   660	        )
   661	    try:
   662	        record = json.loads(intent_path.read_text(encoding="utf-8"))
   663	        if record.get("v") != _INTENT_VERSION:
   664	            raise ValueError(f"unsupported intent version {record.get('v')!r}")
   665	        mode = record["mode"]
   666	        vertex_path = Path(record["vertex_path"])
   667	        canonical_path = Path(record["canonical_path"])
   668	        proposed_fingerprint = record["proposed_fingerprint"]
   669	        old_store_fingerprint = record.get("old_store_fingerprint")
   670	        proposed_text = record.get("proposed_text")
   671	    except (ValueError, KeyError, TypeError) as exc:
   672	        raise IntentCorrupt(
   673	            f"intent at {intent_path} is not a readable v{_INTENT_VERSION} "
   674	            f"record ({exc}) — refusing to classify from corrupt evidence"
   675	        ) from exc
   676	
   677	    from .declaration import resolve_declaration_documents
   678	    from .residence import index_path_for
   679	
   680	    index_path = index_path_for(canonical_path)
   681	    # Materialize/catch up the index from the canonical log first: a death
   682	    # between the log append and the index commit must still classify as
   683	    # applied (the log is the store). Opening the store runs the S1b
   684	    # tail-in/rebuild rules; a nonexistent store stays nonexistent enough.
   685	    if canonical_path.exists() or index_path.exists():
   686	        store = _open_store(canonical_path)
   687	        store.close()
   688	    current = resolve_declaration_documents(index_path)
   689	
   690	    # None = pre-genesis / unusable — no store projection to fingerprint.
   691	    current_fp = _fingerprint_documents(current) if isinstance(current, list) else None
   692	
   693	    if current_fp == proposed_fingerprint:
   694	        # Store committed. Does the file already match?
   695	        file_matches = (
   696	            proposed_text is not None
   697	            and vertex_path.exists()
   698	            and vertex_path.read_text(encoding="utf-8") == proposed_text
   699	        )
   700	        if file_matches:
     1	"""preflight — canonical agreement as an explicit, typed read preparation.
     2	
     3	The JSONL doctrine says the cheap agreement gate (:func:`engine.
     4	canonical_audit.audit_agreement`) precedes every store read verb. But the
     5	primitive alone leaves each client to compose "audit, then maybe open" by
     6	hand — and the easy mistake is opening FIRST: :class:`~engine.jsonl_store.
     7	JsonlStore.__init__` repairs (catch-up, torn-line truncation, rebuild), so
     8	an open-before-audit erases the very evidence the audit exists to inspect.
     9	
    10	:func:`read_preflight` makes the composition explicit, with three modes
    11	that never blur into each other:
    12	
    13	``AUDIT_ONLY``
    14	    Verify and report. Never constructs a store, never repairs — a damaged
    15	    store comes back as typed damage with all evidence intact.
    16	
    17	``AUDIT_THEN_OPEN``
    18	    Verify; open ONLY if the audit passed. A failing audit refuses to
    19	    open. NOTE the deliberate consequence: a fresh clone (log tracked,
    20	    derived index absent) is a REFUSAL here, because materializing the
    21	    index is repair by definition. That is not a bug — it is the mode
    22	    contract. The sanctioned path for "build/repair whatever is needed and
    23	    open" is ``RECOVER_THEN_OPEN``.
    24	
    25	``RECOVER_THEN_OPEN``
    26	    Audit first (the pre-repair evidence is captured in the result), then
    27	    open — letting the store's own open-time recovery run — then audit
    28	    again to report the post-recovery state. Recovery happens ONLY in this
    29	    mode, and even here some damage refuses: out-of-band index rows raise
    30	    :class:`~engine.jsonl_store.JsonlCanonicalUnsupported` at open (the
    31	    log cannot account for them), and the result says ``refused``, typed
    32	    distinctly from ``recovered``.
    33	
    34	Verification is never silently conflated with repair: repair happens in
    35	exactly one mode, is always preceded by an evidentiary audit, and is always
    36	reported as having happened.
    37	
    38	A sqlite-canonical target has no log/index pair to audit, so agreement is
    39	vacuous: ``agreed=True`` with a reason saying so, and the open modes open
    40	via :func:`engine.jsonl_store.open_canonical_store` as usual. (Chain/content
    41	verification of a sqlite store is ``verify_chain``'s scope, not this gate's.)
    42	
    43	The result is typed for exit-code mapping: :attr:`PreflightResult.status`
    44	is a small closed vocabulary (``PREFLIGHT_STATUSES``) a CLI can map
    45	directly; no integers are baked in here.
    46	"""
    47	
    48	from __future__ import annotations
    49	
    50	from dataclasses import dataclass
    51	from enum import Enum
    52	from pathlib import Path
    53	from typing import Any
    54	
    55	from .canonical_audit import AgreementReport, audit_agreement
    56	from .residence import index_path_for, is_jsonl_canonical
    57	
    58	__all__ = [
    59	    "PREFLIGHT_STATUSES",
    60	    "PreflightMode",
    61	    "PreflightResult",
    62	    "read_preflight",
    63	]
    64	
    65	
    66	class PreflightMode(Enum):
    67	    """The three read-preparation contracts. See the module docstring."""
    68	
    69	    AUDIT_ONLY = "audit-only"
    70	    AUDIT_THEN_OPEN = "audit-then-open"
    71	    RECOVER_THEN_OPEN = "recover-then-open"
    72	
    73	
    74	#: The closed status vocabulary, in rough order of severity. A CLI maps
    75	#: these to exit codes; the engine does not choose the integers.
    76	#:
    77	#: ``ok``            agreed (or vacuously agreed), and opened if requested
    78	#: ``recovered``     RECOVER_THEN_OPEN found damage, repaired, and reopened
    79	#: ``index-behind``  diverged, but only past the consumed prefix
    80	#:                   (``AgreementReport.index_behind`` — a scope statement,
    81	#:                   not an innocence claim; see that docstring)
    82	#: ``diverged``      the artifacts disagree in a way "behind" does not cover
    83	#: ``refused``       an open mode declined to open (audit failed in
    84	#:                   AUDIT_THEN_OPEN, or recovery itself refused)
    85	#: ``unreadable``    the canonical artifact itself cannot be read
    86	PREFLIGHT_STATUSES = (
    87	    "ok",
    88	    "recovered",
    89	    "index-behind",
    90	    "diverged",
    91	    "refused",
    92	    "unreadable",
    93	)
    94	
    95	
    96	@dataclass(frozen=True)
    97	class PreflightResult:
    98	    """What the preflight found, what it did, and what a caller may do next."""
    99	
   100	    mode: PreflightMode
   101	    canonical_path: Path
   102	    index_path: Path
   103	    status: str
   104	    """One of :data:`PREFLIGHT_STATUSES` — the exit-code hook."""
   105	
   106	    report: AgreementReport | None
   107	    """The evidentiary audit — taken BEFORE any open in every mode. ``None``
   108	    only for a sqlite-canonical target, where agreement is vacuous."""
   109	
   110	    post_report: AgreementReport | None
   111	    """RECOVER_THEN_OPEN only, and only when recovery actually ran: the
   112	    audit re-run after recovery, so the caller can see what recovery left
   113	    behind. ``None`` in other modes and on a clean pass (the pre-open
   114	    ``report`` already IS the current picture there)."""
   115	
   116	    agreed: bool
   117	    """Did the pre-open audit pass (vacuously True for sqlite-canonical)?"""
   118	
   119	    opened: bool
   120	    recovered: bool
   121	    """True only when RECOVER_THEN_OPEN observed a failing pre-audit and the
   122	    subsequent open succeeded — i.e. repair actually ran and took."""
   123	
   124	    store: Any | None
   125	    """The opened store handle (a ``SqliteStore`` subclass) in the open
   126	    modes when opening happened; the caller owns closing it."""
   127	
   128	    reason: str
   129	
   130	    def as_dict(self) -> dict[str, Any]:
   131	        return {
   132	            "mode": self.mode.value,
   133	            "canonical_path": str(self.canonical_path),
   134	            "index_path": str(self.index_path),
   135	            "status": self.status,
   136	            "agreed": self.agreed,
   137	            "opened": self.opened,
   138	            "recovered": self.recovered,
   139	            "reason": self.reason,
   140	            "report": self.report.as_dict() if self.report else None,
   141	            **(
   142	                {"post_report": self.post_report.as_dict()}
   143	                if self.post_report
   144	                else {}
   145	            ),
   146	        }
   147	
   148	
   149	def read_preflight(
   150	    target: Path | str | Any,
   151	    mode: PreflightMode = PreflightMode.AUDIT_ONLY,
   152	    **open_kwargs: Any,
   153	) -> PreflightResult:
   154	    """Audit a canonical store — and open it only as the mode allows.
   155	
   156	    ``target`` is a canonical store locator (a ``.jsonl`` log or a
   157	    sqlite-canonical db path), or a :class:`engine.probe.TargetInfo` whose
   158	    ``canonical_path`` is taken — probe and preflight compose. A derived
   159	    index path is accepted and re-routed to its canonical sibling via the
   160	    probe, so no caller can accidentally audit "the index against itself".
   161	
   162	    ``open_kwargs`` are forwarded to :func:`engine.jsonl_store.
   163	    open_canonical_store` in the open modes (``serialize``/``deserialize``
   164	    default to identity, matching ``ensure_index``).
   165	    """
   166	    canonical = _canonical_of(target)
   167	    index = index_path_for(canonical)
   168	
   169	    if not is_jsonl_canonical(canonical):
   170	        return _sqlite_preflight(canonical, mode, open_kwargs)
   171	
   172	    report = audit_agreement(canonical)
   173	    if mode is PreflightMode.AUDIT_ONLY:
   174	        return _audit_only_result(canonical, index, report)
   175	    if mode is PreflightMode.AUDIT_THEN_OPEN:
   176	        return _audit_then_open(canonical, index, report, open_kwargs)
   177	    return _recover_then_open(canonical, index, report, open_kwargs)
   178	
   179	
   180	# --- mode bodies ------------------------------------------------------------
   181	
   182	
   183	def _result(
   184	    mode: PreflightMode,
   185	    canonical: Path,
   186	    index: Path,
   187	    status: str,
   188	    *,
   189	    report: AgreementReport | None = None,
   190	    post_report: AgreementReport | None = None,
   191	    agreed: bool | None = None,
   192	    opened: bool = False,
   193	    recovered: bool = False,
   194	    store: Any | None = None,
   195	    reason: str = "",
   196	) -> PreflightResult:
   197	    """The one PreflightResult constructor — defaults carry the convention.
   198	
   199	    ``agreed`` is the PRE-OPEN audit's own verdict: ``report.ok`` whenever an
   200	    agreement report exists, and never anything else. Only the sqlite-canonical
   201	    branch (no report — agreement is vacuous) sets it explicitly. ``post_report``
   202	    is the post-recovery picture and rides only results where recovery ran.
   203	    """
   204	    if agreed is None:
   205	        agreed = report.ok if report is not None else False
   206	    return PreflightResult(
   207	        mode=mode,
   208	        canonical_path=canonical,
   209	        index_path=index,
   210	        status=status,
   211	        report=report,
   212	        post_report=post_report,
   213	        agreed=agreed,
   214	        opened=opened,
   215	        recovered=recovered,
   216	        store=store,
   217	        reason=reason,
   218	    )
   219	
   220	
   221	def _audit_only_result(
   222	    canonical: Path, index: Path, report: AgreementReport
   223	) -> PreflightResult:
   224	    status, reason = _verdict(canonical, report)
   225	    return _result(
   226	        PreflightMode.AUDIT_ONLY, canonical, index, status,
   227	        report=report, reason=reason,
   228	    )
   229	
   230	
   231	def _audit_then_open(
   232	    canonical: Path,
   233	    index: Path,
   234	    report: AgreementReport,
   235	    open_kwargs: dict[str, Any],
   236	) -> PreflightResult:
   237	    if not report.ok:
   238	        status, why = _verdict(canonical, report)
   239	        return _result(
   240	            PreflightMode.AUDIT_THEN_OPEN, canonical, index,
   241	            status if status == "unreadable" else "refused",
   242	            report=report,
   243	            reason=(
   244	                f"refusing to open: {why} — audit-then-open never repairs; "
   245	                "recover-then-open is the sanctioned repair-and-open path"
   246	            ),
   247	        )
   248	    store = _open(canonical, open_kwargs)
   249	    return _result(
   250	        PreflightMode.AUDIT_THEN_OPEN, canonical, index, "ok",
   251	        report=report, opened=True, store=store,
   252	        reason="agreement audit passed; store opened",
   253	    )
   254	
   255	
   256	def _recover_then_open(
   257	    canonical: Path,
   258	    index: Path,
   259	    report: AgreementReport,
   260	    open_kwargs: dict[str, Any],
   261	) -> PreflightResult:
   262	    """Evidence first, then the store's own recovery, then the after-picture."""
   263	    import sqlite3
   264	
   265	    from .jsonl_codec import JsonlCodecError
   266	    from .jsonl_store import JsonlCanonicalUnsupported
   267	
   268	    mode = PreflightMode.RECOVER_THEN_OPEN
   269	    if not canonical.exists():
   270	        return _result(
   271	            mode, canonical, index, "unreadable", report=report,
   272	            reason=(
   273	                f"no canonical log at {canonical} — recovery rebuilds an "
   274	                "index FROM the log; it never invents a log"
   275	            ),
   276	        )
   277	    try:
   278	        # SOL-R2-03: a derived index that does not open as sqlite is
   279	        # discarded and rebuilt from the log by JsonlStore's own open —
   280	        # recovery lives at the store, not re-spelled here. A residual
   281	        # sqlite3.Error means that rebuild itself failed.
   282	        store = _open(canonical, open_kwargs)
   283	    except JsonlCanonicalUnsupported as exc:
   284	        return _result(
   285	            mode, canonical, index, "refused", report=report,
   286	            reason=f"recovery refused: {exc}",
   287	        )
   288	    except (JsonlCodecError, UnicodeDecodeError) as exc:
   289	        # Canonical corruption recovery cannot fix: the log itself does
   290	        # not decode (bad JSON, unknown discriminator, invalid UTF-8).
   291	        # Typed as ``unreadable`` — the canonical artifact cannot be read
   292	        # — with the pre-recovery audit evidence attached.
   293	        return _result(
   294	            mode, canonical, index, "unreadable", report=report,
   295	            reason=(
   296	                f"canonical log does not decode — corruption recovery "
   297	                f"cannot repair: {exc}"
   298	            ),
   299	        )
   300	    except sqlite3.Error as exc:
   301	        return _result(
   302	            mode, canonical, index, "unreadable", report=report,
   303	            reason=(
   304	                f"derived index unusable and rebuilding it from the log "
   305	                f"also failed: {exc}"
   306	            ),
   307	        )
   308	    except OSError as exc:
   309	        # Environmental open failure (permissions, IO). The artifact may
   310	        # be fine; this process cannot read it — still ``unreadable``.
   311	        return _result(
   312	            mode, canonical, index, "unreadable", report=report,
   313	            reason=f"cannot open canonical store: {exc}",
   314	        )
   315	    recovered = not report.ok
   316	    return _result(
   317	        mode, canonical, index, "recovered" if recovered else "ok",
   318	        report=report,
   319	        post_report=audit_agreement(canonical) if recovered else None,
   320	        opened=True, recovered=recovered, store=store,
   321	        reason=(
   322	            "store recovered and opened; pre-recovery evidence in report, "
   323	            "post-recovery state in post_report"
   324	            if recovered
   325	            else "agreement audit passed; store opened (no recovery needed)"
   326	        ),
   327	    )
   328	
   329	
   330	def _sqlite_preflight(
   331	    canonical: Path, mode: PreflightMode, open_kwargs: dict[str, Any]
   332	) -> PreflightResult:
   333	    """Sqlite-canonical: no log/index pair, so agreement is vacuous.
   334	
   335	    A MISSING db is ``unreadable`` in every mode — ``SqliteStore.__init__``
   336	    creates a missing file, and a *read* preflight never creates. Even
   337	    RECOVER_THEN_OPEN refuses: recovery rebuilds derived state from a
   338	    canonical artifact; with no artifact there is nothing to recover FROM
   339	    (the sqlite mirror of "recovery never invents a log"). Store creation
   340	    is a different verb.
   341	    """
   342	    if not canonical.exists():
   343	        return _result(
   344	            mode, canonical, canonical, "unreadable",
   345	            reason=(
   346	                f"no sqlite-canonical store at {canonical} — a read "
   347	                "preflight never creates a store"
   348	            ),
   349	        )
   350	    reason = (
   351	        "sqlite-canonical store — no derived index to audit; agreement is "
   352	        "vacuous (chain verification is verify_chain's scope)"
   353	    )
   354	    if mode is PreflightMode.AUDIT_ONLY:
   355	        return _result(
   356	            mode, canonical, canonical, "ok", agreed=True, reason=reason,
   357	        )
   358	    store = _open(canonical, open_kwargs)
   359	    return _result(
   360	        mode, canonical, canonical, "ok", agreed=True, opened=True,
   361	        store=store, reason=reason + "; store opened",
   362	    )
   363	
   364	
   365	# --- helpers ----------------------------------------------------------------
   366	
   367	
   368	def _verdict(canonical: Path, report: AgreementReport) -> tuple[str, str]:
   369	    """An ``AgreementReport`` as a (status, reason) pair for the vocabulary.
   370	
   371	    ``index-behind`` re-states the report's own scope-limited flag; the
   372	    reason keeps its wording so no caller upgrades it to an innocence claim.
   373	    """
   374	    if report.ok:
   375	        return "ok", "log and index agree"
   376	    if any(c.name == "log" and not c.ok for c in report.checks):
   377	        return "unreadable", report.summary()
   378	    if report.index_behind:
   379	        return "index-behind", report.summary()
   380	    return "diverged", report.summary()
   381	
   382	
   383	def _canonical_of(target: Path | str | Any) -> Path:
   384	    """A canonical path from a path-like or a ``TargetInfo``.
   385	
   386	    A derived-index path is re-routed through the probe to its canonical
   387	    sibling; a ``TargetInfo`` contributes its ``canonical_path`` directly.
   388	    """
   389	    canonical_attr = getattr(target, "canonical_path", None)
   390	    if canonical_attr is not None:
   391	        return Path(canonical_attr)
   392	    if hasattr(target, "target_type"):  # a TargetInfo with no canonical
   393	        raise ValueError(
   394	            f"preflight needs a store-bearing target; got a "
   395	            f"{target.target_type!r} probe with no canonical_path"
   396	        )
   397	    from .probe import probe_target
   398	
   399	    info = probe_target(Path(target))
   400	    if info.canonical_path is None:
   401	        raise ValueError(
   402	            f"not a store locator: {target} ({info.reason})"
   403	        )
   404	    return info.canonical_path
   405	
   406	
   407	def _open(canonical: Path, open_kwargs: dict[str, Any]):
   408	    from .jsonl_store import open_canonical_store
   409	
   410	    kwargs: dict[str, Any] = {
   411	        "serialize": lambda d: d,
   412	        "deserialize": lambda d: d,
   413	        **open_kwargs,
