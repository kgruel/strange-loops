   127	def _atomic_write(path: Path, data: str) -> None:
   128	    """Tempfile + fsync + rename in ``path``'s directory — the JsonlStore
   129	    durability discipline: the rename publishes only fully-durable bytes."""
   130	    fd, tmp = tempfile.mkstemp(
   131	        prefix=path.name + ".", suffix=".tmp", dir=str(path.parent)
   132	    )
   133	    try:
   134	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   135	            fh.write(data)
   136	            fh.flush()
   137	            os.fsync(fh.fileno())
   138	        Path(tmp).replace(path)
   139	    except BaseException:
   140	        with contextlib.suppress(OSError):
   141	            Path(tmp).unlink()
   142	        raise
