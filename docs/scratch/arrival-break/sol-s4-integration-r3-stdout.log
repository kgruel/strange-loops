+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from lang import effective_store_clause, parse_vertex_file
+from migrate import PublishPreconditionRefused, edit_vertex_store_clause
+
+
+cases = {
+    "hash_raw_decoy": '''name r#"project " store decoy"#
+store "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+''',
+    "quoted_store_node": '''name "project"
+"store" "./legacy.jsonl" // KEEP
+loops { probe { fold { items "collect" 10 } } }
+''',
+    "hash_raw_property": '''name "project"
+store "./legacy.jsonl" backend=r#"fi" // OLD PROPERTY BYTES"# // KEEP COMMENT
+loops { probe { fold { items "collect" 10 } } }
+''',
+    "hash_raw_deletes_comment": '''name "project"
+store "./legacy.jsonl" backend=r#"fi" fake"# // KEEP OPERATOR " tail
+loops { probe { fold { items "collect" 10 } } }
+''',
+}
+failed = False
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r3") as tmp:
+    root = Path(tmp)
+    for case, text in cases.items():
+        vertex = root / f"{case}.vertex"
+        vertex.write_text(text, encoding="utf-8")
+        parsed = parse_vertex_file(vertex)
+        located = effective_store_clause(text, vertex)
+        located_slice = text[slice(*located.span)] if located.span else None
+        before = vertex.read_bytes()
+        print(f"{case}: parsed_name={parsed.name!r} parsed_store={str(parsed.store)!r}")
+        print(f"{case}: count={located.count} span={located.span} slice={located_slice!r}")
+        try:
+            edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+        except PublishPreconditionRefused as exc:
+            print(f"{case}: edit=REFUSED condition={exc.condition} file_unchanged={vertex.read_bytes() == before}")
+            assert vertex.read_bytes() == before
+        else:
+            print(f"{case}: edit=ACCEPTED")
+
+        if case == "hash_raw_property":
+            edited = vertex.read_text(encoding="utf-8")
+            edited_line = edited.splitlines()[1]
+            leaked = "OLD PROPERTY BYTES" in edited_line
+            print(f"{case}: edited_line={edited_line!r} old_property_bytes_leaked={leaked}")
+            if leaked:
+                failed = True
+            continue
+        if case == "hash_raw_deletes_comment":
+            edited = vertex.read_text(encoding="utf-8")
+            marker_preserved = "KEEP OPERATOR" in edited
+            print(f"{case}: edited_line={edited.splitlines()[1]!r} marker_preserved={marker_preserved}")
+            if not marker_preserved:
+                failed = True
+            continue
+
+        token = 'store "./legacy.jsonl"' if case == "hash_raw_decoy" else '"store" "./legacy.jsonl"'
+        real_start = text.index(token)
+        expected = (real_start, real_start + len(token))
+        if located.span != expected:
+            failed = True
+
+if failed:
+    print("FAIL: accepted hash-raw rewrites used an incorrect clause span")
+    raise SystemExit(1)
+print("PASS: valid KDL lexical forms are modeled by the source locator")
diff --git a//tmp/sol-s4-r3/probe_scanner_raw_adversarial.py b//tmp/sol-s4-r3/probe_scanner_raw_adversarial.py
