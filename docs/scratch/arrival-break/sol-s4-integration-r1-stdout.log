    77	def deterministic_ulid(ts: float, seed: str) -> str:
    78	    """Build a ULID from an event timestamp and a deterministic seed.
    79	
    80	    48-bit millisecond timestamp from ``ts``, 80-bit entropy from
    81	    ``sha256(seed)``. Same inputs, same ULID — this is what makes
    82	    rebirth re-runnable and therefore verifiable.
    83	    """
    84	    ms = int(ts * 1000)
    85	    entropy = hashlib.sha256(seed.encode()).digest()[:10]
    86	    return str(ULID.from_bytes(ms.to_bytes(6, "big") + entropy))
