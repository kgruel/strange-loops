   371	def _index_has_row(conn, t: str, row_id: str) -> bool:
   372	    table = "facts" if t == "fact" else "ticks"
   373	    try:
   374	        return bool(
   375	            conn.execute(
   376	                f"SELECT EXISTS(SELECT 1 FROM {table} WHERE id = ?)", (row_id,)
   377	            ).fetchone()[0]
   378	        )
   379	    except Exception:  # noqa: BLE001 — an unreadable index vouches for nothing
   380	        return True
