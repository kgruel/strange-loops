+from __future__ import annotations
+
+from pathlib import Path
+
+from migrate import edit_vertex_store_clause
+
+
+root = Path("/tmp/sol-s4-r1/surgical-comment")
+root.mkdir(parents=True, exist_ok=True)
+vertex = root / "project.vertex"
+marker = "// retain: operator chose this archive"
+original = f'''name "alice"
+store "./legacy.jsonl" {marker}
+loops {{
+  probe {{ fold {{ items "collect" 10 }} }}
+}}
+'''
+vertex.write_text(original, encoding="utf-8")
+edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+edited = vertex.read_text(encoding="utf-8")
+print("edited_store_line=" + edited.splitlines()[1])
+print(f"marker_preserved={marker in edited}")
+if marker in edited:
+    print("PASS: surgical publish preserved non-store comment bytes")
+    raise SystemExit(0)
+print("FAIL: surgical publish deleted a same-line operator comment")
+raise SystemExit(1)

