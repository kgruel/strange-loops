diff --git a//tmp/sol-s4-r2/probe_comment.py b//tmp/sol-s4-r2/probe_comment.py
new file mode 100644
index 0000000000000000000000000000000000000000..ec230e1b79c179ce5d3ce1b2b971e88d8337ddb2
--- /dev/null
+++ b//tmp/sol-s4-r2/probe_comment.py
@@ -0,0 +1,29 @@
+from __future__ import annotations
+
+import tempfile
+from pathlib import Path
+
+from migrate import edit_vertex_store_clause
+
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    vertex = Path(tmp) / "project.vertex"
+    marker = "// retain: operator chose this archive"
+    original = f'''name "display"
+  store "./legacy.jsonl" backend="old"   {marker}
+loops {{ probe {{ fold {{ items "collect" 10 }} }} }}
+'''
+    vertex.write_text(original, encoding="utf-8")
+    edit_vertex_store_clause(vertex, "./target.arrival", backend="file")
+    edited = vertex.read_text(encoding="utf-8")
+    old_line = original.splitlines(keepends=True)[1]
+    new_line = edited.splitlines(keepends=True)[1]
+    old_tail = old_line[old_line.index(marker) - 3:]
+    new_tail = new_line[new_line.index(marker) - 3:]
+    print(f"edited_store_line={new_line.rstrip()}")
+    print(f"trailing_bytes_preserved={new_tail == old_tail}")
+    print(f"other_lines_byte_equal={original.splitlines(keepends=True)[0:1] + original.splitlines(keepends=True)[2:] == edited.splitlines(keepends=True)[0:1] + edited.splitlines(keepends=True)[2:]}")
+    assert new_tail == old_tail
+    assert marker in edited
+
+print("PASS: same-line trailing bytes survive surgical publish")
diff --git a//tmp/sol-s4-r2/probe_custodian.py b//tmp/sol-s4-r2/probe_custodian.py
new file mode 100644
index 0000000000000000000000000000000000000000..e98587f8bbb018deeb34ab89fa1d23be322000a7
--- /dev/null
+++ b//tmp/sol-s4-r2/probe_custodian.py
@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+import contextlib
+import inspect
+import io
+import json
+import tempfile
+from pathlib import Path
+
+from loops.commands.store import _run_migrate
+from migrate import run_migration, transform
+from sign import ed25519
+
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    root = Path(tmp)
+    keypair = ed25519.load_or_generate(root / "keys")
+    source = root / "legacy.jsonl"
+    source.write_text(json.dumps({
+        "t": "fact", "id": "id", "kind": "probe", "ts": 1.0,
+        "observer": "project", "origin": "probe", "payload": "{}",
+    }) + "\n", encoding="utf-8")
+    vertex = root / "project.vertex"
+    vertex.write_text(f'''name "display-name"
+store "./legacy.jsonl"
+observers {{ project {{ key "{keypair.public_b64}" }} }}
+loops {{ probe {{ fold {{ items "collect" 10 }} }} }}
+''', encoding="utf-8")
+    stderr = io.StringIO()
+    with contextlib.redirect_stderr(stderr):
+        rc = _run_migrate([str(source), "--vertex", str(vertex), "--rule", "identity"])
+    signatures = {fn.__name__: str(inspect.signature(fn)) for fn in (run_migration, transform)}
+    forbidden = {fn: [name for name in inspect.signature(obj).parameters if "custodian" in name]
+                 for fn, obj in (("run_migration", run_migration), ("transform", transform))}
+    print(f"vertex_stem={vertex.stem!r} declared_name='display-name' exit_code={rc}")
+    print(f"signatures={signatures!r}")
+    print(f"custodian_parameters={forbidden!r}")
+    assert rc == 0
+    assert forbidden == {"run_migration": [], "transform": []}
+
+print("PASS: stem-derived custody and override removal hold")
diff --git a//tmp/sol-s4-r2/probe_gf3.py b//tmp/sol-s4-r2/probe_gf3.py
new file mode 100644
index 0000000000000000000000000000000000000000..912e0f02dc09e443152c70bc1d904996cfc1eae4
--- /dev/null
+++ b//tmp/sol-s4-r2/probe_gf3.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+
+import json
+import tempfile
+from pathlib import Path
+
+from migrate import LegacySourceRefused, inventory
+
+
+def fact(row_id: str, observer: object = ...) -> dict[str, object]:
+    row: dict[str, object] = {
+        "t": "fact",
+        "id": row_id,
+        "kind": "probe",
+        "ts": 1.0,
+        "origin": "probe",
+        "payload": "{}",
+    }
+    if observer is not ...:
+        row["observer"] = observer
+    return row
+
+
+cases = {
+    "empty": ([fact("a", "alice"), fact("b", "bob"), fact("c", "")], {"empty": 1, "missing": 0}),
+    "missing": ([fact("a", "alice"), fact("b", "bob"), fact("c")], {"empty": 0, "missing": 1}),
+    "both": (
+        [fact("a", "alice"), fact("b", "bob"), fact("c", ""), fact("d")],
+        {"empty": 1, "missing": 1},
+    ),
+    "none": ([fact("a", "alice"), fact("b", "bob")], {"empty": 0, "missing": 0}),
+}
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    root = Path(tmp)
+    for name, (rows, census) in cases.items():
+        source = root / f"{name}.jsonl"
+        source.write_text(json.dumps({"t": "batch", "rows": rows}) + "\n", encoding="utf-8")
+        try:
+            inventory(source)
+        except LegacySourceRefused as exc:
+            print(f"{name}: mixed={exc.mixed_observer_lines!r} absent={exc.absent_observer_lines!r}")
+            assert exc.mixed_observer_lines == ((1, ("alice", "bob"), census),)
+            assert exc.absent_observer_lines == ()
+            message = str(exc)
+            if name == "empty":
+                assert "observer='' (empty string)" in message
+            elif name == "missing":
+                assert "missing 'observer' field" in message
+            elif name == "both":
+                assert "1 missing, 1 empty ''" in message
+            else:
+                assert "row(s)" not in message.split("observers 'alice', 'bob'", 1)[1].splitlines()[0]
+        else:
+            raise AssertionError(f"{name}: mixed batch was accepted")
+
+print("PASS: ruled report-once shape and spelling-distinct mixed census hold")
