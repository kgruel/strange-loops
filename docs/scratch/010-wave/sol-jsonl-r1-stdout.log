   561	    def _poison_index(self, vpath: Path) -> None:
   562	        """Insert a row straight into the derived index, behind the log's back.
   563	
   564	        Exactly the state ``_refuse_out_of_band`` exists to detect: the next
   565	        ``JsonlStore`` construction raises ``JsonlCanonicalUnsupported`` from
   566	        its catch-up, inside ``__init__``.
   567	        """
   568	        import sqlite3
   569	
   570	        db = vpath.parent / "data" / "project.db"
   571	        conn = sqlite3.connect(db)
   572	        cols = [r[1] for r in conn.execute("PRAGMA table_info(facts)")]
   573	        vals = {
   574	            "id": "OUT-OF-BAND-ROW",
   575	            "kind": "note",
   576	            "observer": "x",
   577	            "ts": 1.0,
   578	            "payload": "{}",
   579	            "origin": "",
   580	            "seq": 999,
   581	        }
   582	        used = [c for c in cols if c in vals]
   583	        conn.execute(
   584	            f"INSERT INTO facts ({', '.join(used)}) VALUES ({', '.join('?' * len(used))})",
   585	            [vals[c] for c in used],
   586	        )
   587	        conn.commit()
   588	        conn.close()
