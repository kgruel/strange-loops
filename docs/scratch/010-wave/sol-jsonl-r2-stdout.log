   158	            line, parse_constant=_reject_constant, object_pairs_hook=_no_duplicate_keys
   159	        )
   160	    except JsonlCodecError:
   161	        # Raised by our own hooks — already the right error, with the right
   162	        # message. Re-wrapping it as "not valid JSON" would bury the reason.
   163	        raise
   164	    except ValueError as exc:
   165	        raise JsonlCodecError(f"not valid JSON: {exc}") from exc
   166	    if not isinstance(obj, dict):
   167	        raise JsonlCodecError(
   168	            f"line must be a JSON object, got {type(obj).__name__}"
   169	        )
   170	    return obj
   171	
   172	
   173	def _validate(obj: dict, fields: tuple[str, ...], allowed: frozenset[str],
   174	              nullable: frozenset[str], t: str) -> None:
   175	    unknown = sorted(set(obj) - allowed)
   176	    if unknown:
   177	        raise JsonlCodecError(f"unknown field(s) in {t} line: {unknown}")
   178	    missing = [f for f in fields if f not in obj]
   179	    if missing:
   180	        raise JsonlCodecError(f"missing field(s) in {t} line: {missing}")
   181	    for field in fields:
   182	        value = obj[field]
   183	        if value is None:
   184	            if field not in nullable:
   185	                raise JsonlCodecError(f"{t} field {field!r} must not be null")
   186	            continue
   187	        if field in _NUMERIC:
   188	            # bool is an int subclass — reject it explicitly.
   189	            if isinstance(value, bool) or not isinstance(value, (int, float)):
   190	                raise JsonlCodecError(
   191	                    f"{t} field {field!r} must be a number, got "
   192	                    f"{type(value).__name__}"
   193	                )
   194	            # Standards-valid JSON can still spell a number outside the JCS
   195	            # domain (``1e999`` overflows to inf; a 400-digit integer exceeds
   196	            # the safe-integer bound). Range-check here — the literal parser
   197	            # only sees the NaN/Infinity spellings.
   198	            if isinstance(value, float):
   199	                if not math.isfinite(value):
   200	                    raise JsonlCodecError(
   201	                        f"{t} field {field!r} must be a finite number, got "
   202	                        f"{value!r}"
   203	                    )
   204	            elif not (_JCS_INT_MIN <= value <= _JCS_INT_MAX):
   205	                raise JsonlCodecError(
   206	                    f"{t} field {field!r} is outside the JCS safe-integer "
   207	                    f"domain: {value}"
   208	                )
   209	        elif not isinstance(value, str):
   210	            raise JsonlCodecError(
   211	                f"{t} field {field!r} must be a string, got "
   212	                f"{type(value).__name__}"
   213	            )
   214	    if _SIGNATURE in obj and obj[_SIGNATURE] is None:
   215	        # Absent IS the unsigned era; an explicit null is a second spelling
   216	        # of the same state, so serialize stays the unique canonical form.
   217	        raise JsonlCodecError(
   218	            f"{t} field 'signature' must be absent, not null, when unsigned"
   219	        )
   220	    sig = obj.get(_SIGNATURE)
   221	    if sig is not None and not isinstance(sig, str):
   222	        raise JsonlCodecError(
   223	            f"{t} field 'signature' must be a string, got {type(sig).__name__}"
   224	        )
   225	
   226	
   227	def _row_tuple(obj: dict, fields: tuple[str, ...]) -> tuple:
   228	    return (*(obj[f] for f in fields), obj.get(_SIGNATURE))
   229	
   230	
   231	def deserialize_fact_row(line: str) -> tuple:
   232	    """Decode a ``"t":"fact"`` line to a 7-field row tuple (signature last)."""
   233	    obj = _load(line)
   234	    if obj.get("t") != "fact":
   235	        raise JsonlCodecError(f"expected t='fact', got {obj.get('t')!r}")
   236	    _validate(obj, _FACT_FIELDS, _FACT_KEYS, _FACT_NULLABLE, "fact")
   237	    return _row_tuple(obj, _FACT_FIELDS)
   238	
   239	
   240	def deserialize_tick_row(line: str) -> tuple:
   241	    """Decode a ``"t":"tick"`` line to an 11-field row tuple (signature last)."""
   242	    obj = _load(line)
   243	    if obj.get("t") != "tick":
   244	        raise JsonlCodecError(f"expected t='tick', got {obj.get('t')!r}")
   245	    _validate(obj, _TICK_FIELDS, _TICK_KEYS, _TICK_NULLABLE, "tick")
   246	    return _row_tuple(obj, _TICK_FIELDS)
   247	
   248	
   249	def deserialize_row(line: str) -> tuple[str, tuple]:
   250	    """Decode any line, dispatching on ``"t"``. Returns ``(t, row)``."""
   251	    obj = _load(line)
   252	    t = obj.get("t")
   253	    if t == "fact":
   254	        _validate(obj, _FACT_FIELDS, _FACT_KEYS, _FACT_NULLABLE, "fact")
   255	        return "fact", _row_tuple(obj, _FACT_FIELDS)
   256	    if t == "tick":
   257	        _validate(obj, _TICK_FIELDS, _TICK_KEYS, _TICK_NULLABLE, "tick")
   258	        return "tick", _row_tuple(obj, _TICK_FIELDS)
   259	    raise JsonlCodecError(f"unknown record discriminator t={t!r}")

