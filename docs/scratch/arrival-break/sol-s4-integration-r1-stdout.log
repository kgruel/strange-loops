   111	def test_third_party_and_interpackage_imports_declared():
   112	    """Every imported module must appear in pyproject.toml declared dependencies."""
   113	    packages = [REPO_ROOT / "apps" / "loops"] + [REPO_ROOT / "libs" / lib for lib in LIBS]
   114	    violations: list[str] = []
   115	
   116	    for pkg_dir in packages:
