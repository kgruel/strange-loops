   431	def _write_intent(preview: DeclarationUpdatePreview, observer: str) -> Path:
   432	    intent = {
   433	        "v": _INTENT_VERSION,
   434	        "mode": preview.mode,
   435	        "vertex_path": str(preview.vertex_path),
   436	        "canonical_path": str(preview.canonical_path),
   437	        "created_ts": datetime.now(UTC).timestamp(),
   438	        "observer": observer,
   439	        "old_status": preview.declaration_status,
   440	        "old_decl_head": list(preview.expected_head)
   441	        if preview.expected_head
   442	        else None,
   443	        "old_store_fingerprint": preview.old_store_fingerprint,
   444	        "lineage": preview.generation.get("lineage"),
   445	        "proposed_fingerprint": preview.proposed_fingerprint,
   446	        "proposed_documents": list(preview.documents),
   447	        "proposed_text": preview.proposed_text,
   448	    }
   449	    path = intent_path_for(preview.vertex_path)
   450	    # The CREATE is the gate (thread:intent-gate-toctou): O_CREAT|O_EXCL
   451	    # makes intent creation atomic-by-construction — a racing second apply
   452	    # gets FileExistsError here instead of a tempfile+rename that would
   453	    # clobber the winner's intent evidence. The exists() pre-check upstream
   454	    # stays as the fast path; this is the authoritative one, race-free.
   455	    # fsync discipline kept; a crash mid-write leaves a partial intent,
   456	    # which recovery classifies loudly as IntentCorrupt (refuse, not
   457	    # guess). The sibling no-parent-dir-fsync limitation stays as-is
   458	    # (shared with JsonlStore, documented).
   459	    fd = os.open(str(path), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
   460	    try:
   461	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   462	            fh.write(json.dumps(intent, indent=2) + "\n")
   463	            fh.flush()
   464	            os.fsync(fh.fileno())
   465	    except BaseException:
   466	        # The create won the gate but the bytes never became durable —
   467	        # remove the partial file so the failed apply leaves zero residue
   468	        # (the OSError path upstream reports "nothing mutated").
   469	        with contextlib.suppress(OSError):
   470	            path.unlink()
   471	        raise
   472	    return path
