   280	def _verified(
   281	    before,
   282	    result: str,
   283	    context: str,
   284	    *,
   285	    added: str | None = None,
   286	    edited: str | None = None,
   287	    removed: str | None = None,
   288	) -> str:
   289	    """Parse + validate mutated text AND assert the exact expected delta.
   290	
   291	    The PARSER is the safety oracle (arbiter ruling, SOL-R2-01): the
   292	    line/lexeme-based splice layer is best-effort transformation only, so
   293	    every mutation re-parses the result and compares it against the
   294	    pre-mutation parse. The only admissible delta is the requested one —
   295	    add: original kind set plus the new kind, every original definition
   296	    equal; edit: same kind set, only the target changed; remove: set minus
   297	    the target, every other definition equal. Non-loop content (sources,
   298	    routes, store, …) must be untouched in all three. Any mismatch raises
   299	    ValueError naming the preserved-content violation, and the caller's
   300	    original text is never replaced. This makes silent sibling loss
   301	    inexpressible regardless of lexical evasion class (raw strings,
   302	    escaped quotes, comments).
   303	    """
   304	    from .validator import validate_vertex
   305	
   306	    try:
   307	        after = _parse_vertex_or_raise(result, context)
   308	        validate_vertex(after)
   309	    except Exception as exc:
   310	        raise ValueError(
   311	            f"{context} produced an invalid vertex: {exc}"
   312	        ) from exc
   313	
   314	    before_kinds = set(before.loops)
   315	    expected = set(before_kinds)
   316	    if added is not None:
   317	        expected.add(added)
   318	    if removed is not None:
   319	        expected.discard(removed)
   320	    after_kinds = set(after.loops)
   321	    if after_kinds != expected:
   322	        lost = sorted(expected - after_kinds)
   323	        gained = sorted(after_kinds - expected)
   324	        raise ValueError(
   325	            f"{context} violated content preservation: resulting kind set "
   326	            f"differs from the expected delta (lost: {lost}, unexpected: "
   327	            f"{gained}) — refusing; the original text is unchanged. If the "
   328	            "kind shares its physical line with siblings, split each kind "
   329	            "onto its own line first"
   330	        )
   331	    mutated = {added, edited, removed} - {None}
   332	    for k in before_kinds - mutated:
   333	        if before.loops[k] != after.loops[k]:
   334	            raise ValueError(
   335	                f"{context} violated content preservation: sibling kind "
   336	                f"{k!r} was altered by the text splice — refusing; the "
   337	                "original text is unchanged"
   338	            )
   339	    # Non-kind vertex content (store, sources, routes, …) must be untouched.
   340	    # VertexFile fields are exposed via __match_args__ (the frozen-AST shim).
   341	    for f in type(before).__match_args__:
   342	        if f == "loops":
   343	            continue
   344	        if getattr(before, f) != getattr(after, f):
   345	            raise ValueError(
   346	                f"{context} violated content preservation: non-kind vertex "
   347	                f"content changed (field {f!r}) — refusing; the original "
   348	                "text is unchanged"
   349	            )
   350	    return result
