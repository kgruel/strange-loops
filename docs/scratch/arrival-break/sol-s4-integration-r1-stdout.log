--- /dev/null
+++ b//tmp/sol-s4-r1/probe_cli_self_observer.py
@@ -0,0 +1,58 @@
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+from pathlib import Path
+
+from loops.commands.store import _run_migrate
+from sign import ed25519
+
+
+root = Path("/tmp/sol-s4-r1/cli-self-observer")
+root.mkdir(parents=True, exist_ok=True)
+for path in root.rglob("*"):
+    if path.is_file():
+        path.unlink()
+keypair = ed25519.load_or_generate(root / "keys")
+source = root / "legacy.jsonl"
+source.write_text(
+    json.dumps(
+        {
+            "t": "fact", "id": "id", "kind": "probe", "ts": 1.0,
+            "observer": "project", "origin": "probe", "payload": "{}",
+        },
+        separators=(",", ":"),
+    ) + "\n",
+    encoding="utf-8",
+)
+vertex = root / "project.vertex"
+vertex.write_text(
+    f'''name "display-name"
+store "./legacy.jsonl"
+observers {{
+  project {{
+    key "{keypair.public_b64}"
+  }}
+}}
+loops {{
+  probe {{ fold {{ items "collect" 10 }} }}
+}}
+''',
+    encoding="utf-8",
+)
+stderr = io.StringIO()
+with contextlib.redirect_stderr(stderr):
+    rc = _run_migrate(
+        [str(source), "--vertex", str(vertex), "--rule", "identity"]
+    )
+rendered = stderr.getvalue()
+print(f"vertex_stem={vertex.stem!r}")
+print("vertex_declared_name='display-name'")
+print(f"exit_code={rc}")
+print("stderr=" + rendered.strip().replace("\n", " | "))
+if rc == 0:
+    print("PASS: CLI used the custody-defined self-observer (the vertex stem)")
+    raise SystemExit(0)
+print("FAIL: CLI passed VertexFile.name as custodian and refused a keyed self-observer")
+raise SystemExit(1)
