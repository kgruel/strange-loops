    54	def open_store(tmp_path: Path, name: str = "s", **kw) -> JsonlStore:
    55	    return JsonlStore(
    56	        path=tmp_path / f"{name}.db",
    57	        serialize=lambda f: f.to_dict(),
    58	        deserialize=Fact.from_dict,
    59	        **kw,
    60	    )
