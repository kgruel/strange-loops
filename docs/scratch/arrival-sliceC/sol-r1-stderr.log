   485	            k,
   486	            body,
   487	            observer=rows[0][3],
   488	            origin=rows[0][4],
   489	            at=rows[0][2],
   490	            signer=self._fact_signer,
   491	            following=None if consumed is None else consumed.arrival_ordinal,
   492	        )
