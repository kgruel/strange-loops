   158	def _tick_envelope(row: tuple) -> dict:
   159	    """The 10 commitment fields of a tick row (column order: _TICK_ROW_SQL)."""
   160	    return {
   161	        "id": row[0], "name": row[1], "ts": row[2], "since": row[3],
   162	        "origin": row[4], "payload": row[5], "prev_hash": row[6],
   163	        "window_start": row[7], "fact_cursor": row[8], "window_hash": row[9],
   164	    }
