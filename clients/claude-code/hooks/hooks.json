{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|fork",
      "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/arrival_session.py\" start" }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/arrival_session.py\" end", "timeout": 60 }]
    }],
    "Stop": [{
      "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/arrival_session.py\" stop" }]
    }]
  }
}
