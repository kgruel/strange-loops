   650	def _combined_ticks(
   651	    ast: Any,
   652	    vertex_path: Path,
   653	    since_ts: float,
   654	    until_ts: float,
   655	    name: str | None = None,
   656	    *,
   657	    with_envelope: bool = False,
   658	) -> "list[Tick] | list[tuple[Tick, dict]]":
   659	    """Ticks across multiple stores (combinatorial vertex_ticks).
   660	
   661	    With ``with_envelope=True`` this pass-through carries each member's REAL
   662	    attestation envelope (N4), tagged with ``member`` (a collision-free label
   663	    for the source store — :func:`_member_labels`) — not the blank
   664	    ``chained=False`` placeholder the aggregate returned before.
   665	    A tick's ``fact_cursor`` is a witness handle into ITS OWN member store (A1:
   666	    no shared witness order across the aggregate), so the envelope is resolved
   667	    against that member's own connection and the ``member`` tag tells a consumer
   668	    which store to anchor the cursor against (A9's per-member vector). This path
   669	    opens one :class:`StoreReader` per member (N cold-starts) rather than the
   670	    single ATTACH the fast fold path uses — correctness of per-member cursor
   671	    resolution is worth the ~10ms, and only a ``--ticks`` drill pays it.
   672	    """
   673	    store_paths = _resolve_stores(ast, vertex_path)
   674	    if not store_paths:
   675	        return []
   676	
   677	    if with_envelope:
   678	        from .store_reader import StoreReader
   679	
   680	        labels = _member_labels(store_paths)
   681	        pairs: list[tuple[Tick, dict]] = []
   682	        for path in store_paths:
   683	            try:
   684	                with StoreReader(path) as reader:
   685	                    member_pairs = reader.ticks_between(
   686	                        since_ts, until_ts, name=name, with_envelope=True
   687	                    )
   688	            except FileNotFoundError:
   689	                continue  # absent member store — skip, not a failure
   690	            for tick, env in member_pairs:
   691	                env["member"] = labels[path]
   692	                pairs.append((tick, env))
   693	        pairs.sort(key=lambda pair: pair[0].ts)
   694	        return pairs
   695	
   696	    conn, aliases = _open_combined(store_paths)
   697	    try:
   698	        # See _combined_read for ts-tie ordering note.
   699	        if name is not None:
   700	            selects = [
   701	                f"SELECT name, ts, since, origin, payload "
   702	                f"FROM {'[' + a + '].' if a != 'main' else ''}ticks "
   703	                f"WHERE ts >= ? AND ts <= ? AND name = ?"
   704	                for a in aliases
   705	            ]
   706	            sql = " UNION ALL ".join(selects) + " ORDER BY ts"
   707	            params: list[Any] = []
   708	            for _ in aliases:
   709	                params.extend([since_ts, until_ts, name])
   710	        else:
   711	            selects = [
   712	                f"SELECT name, ts, since, origin, payload "
   713	                f"FROM {'[' + a + '].' if a != 'main' else ''}ticks "
   714	                f"WHERE ts >= ? AND ts <= ?"
   715	                for a in aliases
   716	            ]
   717	            sql = " UNION ALL ".join(selects) + " ORDER BY ts"
   718	            params = []
   719	            for _ in aliases:
   720	                params.extend([since_ts, until_ts])
   721	
   722	        rows = conn.execute(sql, params).fetchall()
   723	        from .tick import Tick  # deferred: not needed on fold path
   724	
   725	        return [
   726	            Tick.from_dict({
   727	                "name": r[0],
   728	                "ts": r[1],
   729	                "since": r[2],
   730	                "origin": r[3],
   731	                "payload": json.loads(r[4]),
   732	            })
   733	            for r in rows
   734	        ]
   735	    finally:
   736	        conn.close()
   737	
