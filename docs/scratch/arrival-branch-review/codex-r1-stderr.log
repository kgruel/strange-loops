    65	def refuse_create_over_arrival_custody(target: Path, action: str) -> None:
    66	    """Refuse to create a store where an arrival log already holds custody.
    67	
    68	    NON-NEGOTIABLE (decision:design/arrival-sliceB-projections, invariant
    69	    15). The target ``.db`` is absent, so a create arm would happily mint a
    70	    store there — but if an ``.arrival`` sits beside it, that path is not a
    71	    store location at all: it is the derived index of a log that holds
    72	    custody. Writing there mints a SECOND custody holder, and the resulting
    73	    index carries rows the log cannot account for.
    74	
    75	    The store is not absent; only its projection is. A projection is built
    76	    from its log, never written by a stranger.
    77	
    78	    ``action`` names what the caller was about to do, so the refusal reads
    79	    as a sentence at each site. One home for the rule, and ``_create``
    80	    enforces it itself, so any future create arm is safe by construction;
    81	    the only call-site guard left is receive's, whose create arm copies a
    82	    foreign db file and never passes through ``_create``.
    83	    """
    84	    from engine.probe import probe_target
    85	
    86	    info = probe_target(target)
    87	    if (
    88	        info.canonical_mode != "arrival"
    89	        or info.canonical_path is None
    90	        or not info.canonical_path.is_file()
    91	    ):
    92	        return
    93	    from engine.arrival_store import ArrivalCanonicalUnsupported
    94	
    95	    raise ArrivalCanonicalUnsupported(
    96	        f"{target} is the derived index of the arrival log at "
    97	        f"{info.canonical_path}, not an absent store — {action} there would "
    98	        "mint a second custody holder beside a live log. The index is "
    99	        "absent, not the store: open the log to build its index, or choose "
   100	        "a target that is not an arrival log's derived index."
   101	    )
   102	
   103	
   104	def _create(path: Path) -> sqlite3.Connection:
   105	    """Create a fresh store with canonical schema.
   106	
   107	    Parent directories are created if needed.
   108	    Raises FileExistsError if the database file already exists, and
   109	    ArrivalCanonicalUnsupported if an arrival log holds custody of the
   110	    path (invariant 15 — enforced here so every create arm that mints a
   111	    store through this function is covered by construction).
   112	    """
   113	    path = Path(path)
   114	    if path.exists():
   115	        raise FileExistsError(f"Store already exists: {path}")
   116	    refuse_create_over_arrival_custody(path, "creating a store")
   117	    path.parent.mkdir(parents=True, exist_ok=True)
   118	    conn = sqlite3.connect(str(path))
   119	    conn.execute("PRAGMA journal_mode=WAL")
   120	    conn.execute("PRAGMA synchronous=NORMAL")
   121	    conn.executescript(_SCHEMA)
   122	    return conn

