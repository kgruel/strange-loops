   163	def rebuild_jsonl(source: Path, target: Path) -> RebuildResult:
   164	    """Rebuild a fresh sqlite store at ``target`` from the JSONL log ``source``.
   165	
   166	    Rebuilding an index from its log is ``engine.jsonl_store``'s own job —
   167	    it is what :class:`~engine.jsonl_store.JsonlStore` does on every open
   168	    whose offset marker cannot be trusted, and it is where the recovery
   169	    rules (torn tail, verbatim insert, no re-mint) already live. This is the
   170	    migration-side wrapper around that: the guard that a rebuild never
   171	    overwrites an existing target, and the counts as a receipt.
   172	
   173	    The rebuilt index comes out *stamped* — offset and row-count markers
   174	    recorded — rather than in the rebuild-on-next-open state, because the
   175	    engine path stamps what it consumed. Hashes and signatures are untouched:
   176	    indexing is not re-emitting.
   177	    """
   178	    from engine.jsonl_store import JsonlStore
   179	
   180	    source, target = Path(source), Path(target)
   181	    if not source.exists():
   182	        raise FileNotFoundError(f"JSONL log not found: {source}")
   183	    if target.exists():
   184	        raise FileExistsError(f"Rebuild target already exists: {target}")
   185	
   186	    target.parent.mkdir(parents=True, exist_ok=True)
   187	    JsonlStore(
   188	        path=target, log_path=source,
   189	        serialize=lambda d: d, deserialize=lambda d: d,
   190	    ).close()
   191	
   192	    conn = _open(target, read_only=True)
   193	    try:
   194	        facts = conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0]
   195	        ticks = conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0]
   196	    finally:
   197	        conn.close()
   198	
   199	    return RebuildResult(facts=int(facts), ticks=int(ticks), path=target)
