   768	def test_interior_tamper_of_an_unsealed_fact_is_caught_by_nothing(tmp_path):
   769	    """The custody boundary, stated as a test rather than left implied.
   770	
   771	    A fact not yet sealed by a tick has no hash committing to its content
   772	    (and, unsigned, no signature either), so a direct sqlite edit is
   773	    undetectable until the next boundary. Same limit verify_facts already
   774	    documents for signature strips. Pinned so the docs cannot quietly widen
   775	    into "verify catches interior tampering" without this failing.
   776	    """
   777	    import sqlite3
   778	
   779	    store = open_store(tmp_path)
   780	    store.append(fact(message="first"))
   781	    store.append_tick(
   782	        Tick(name="seal", ts=datetime.now(UTC), payload={"n": 1}, origin="t")
   783	    )
   784	    store.append(fact(message="live-edge"))
   785	    store.append(fact(message="last"))
   786	    store.close()
   787	
   788	    conn = sqlite3.connect(str(tmp_path / "s.db"))
   789	    edge = conn.execute("SELECT id FROM facts ORDER BY rowid").fetchall()[1][0]
   790	    conn.execute(
   791	        "UPDATE facts SET payload = ? WHERE id = ?",
   792	        (json.dumps({"message": "EDGE"}), edge),
   793	    )
   794	    conn.commit()
   795	    conn.close()
   796	
   797	    store = open_store(tmp_path)
   798	    assert store.catch_up() == "synced"
   799	    assert store.verify_chain()["ok"]
   800	    assert store.verify_facts()["ok"]
   801	    store.close()
