   347	def _currency(canonical: Path) -> bool | None:
   348	    """Offset parity of the derived index, or None when unanswerable.
   349	
   350	    Composes ``jsonl_store._index_is_current`` (one read-only sqlite meta
   351	    read + one stat — it never constructs a store) but refuses to answer
   352	    for a missing index: "current" and "absent" must not collapse.
   353	    """
   354	    from .jsonl_store import _index_is_current
   355	
   356	    if not canonical.is_file():
   357	        return None
