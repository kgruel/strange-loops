index 00000000..94e59a25
--- /dev/null
+++ b/libs/migrate/pyproject.toml
@@ -0,0 +1,64 @@
+[project]
+name = "migrate"
+version = "0.1.0"
+description = "Migration sidecar — quarantine for legacy readers, inventory pass, and arrival transformation"
+readme = "README.md"
+authors = [{ name = "Kyle Gruel", email = "kylegruel@gmail.com" }]
+requires-python = ">=3.11"
+dependencies = [
+    "engine",
+    "store",
+    "lang",
+    "python-ulid>=3.0",
+    "ckdl>=1.0",
+]
+
+[tool.uv.sources]
+engine = { workspace = true }
+store = { workspace = true }
+lang = { workspace = true }
+custody = { workspace = true }
+sign = { workspace = true }
+
+[dependency-groups]
+dev = [
+    # Test-only: real Ed25519 material and domain constants for migration verification
+    "custody",
+    "sign",
+    "hypothesis>=6.100",
+    "pytest>=8.0",
+    "pytest-cov>=6.0",
+    "ruff>=0.8",
+    "ty>=0.0.1a11",
+]
+
+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+[tool.hatch.build.targets.wheel]
+packages = ["src/migrate"]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+
+[tool.coverage.run]
+source = ["src/migrate"]
+branch = true
+
+[tool.coverage.report]
+exclude_lines = [
+    "pragma: no cover",
+    "if TYPE_CHECKING:",
+    "\\.\\.\\.$",
+]
+
+[tool.ruff]
+line-length = 100
+target-version = "py311"
+
+[tool.ruff.lint]
+select = ["E", "F", "I", "UP", "B", "SIM", "PTH"]
+
+[tool.ty.environment]
+python-version = "3.11"
