     1	"""Checkpoint dispatch on the Ordering taxonomy.
     2	
     3	The warm path VertexHandle takes — hold a checkpoint, fold the newly received
     4	rows onto it via ``Spec.replay_from`` — is sound only when appending can extend
     5	the projection at its END. That is a property of the DECLARED read order, not
     6	of the handle: ``atoms.ordering.is_suffix_stable`` is where it is decided.
     7	
     8	These are DISPATCH tests on the taxonomy. They do not touch the checkpoint
     9	machinery in ``engine.handle``; they pin which Ordering variants license it:
    10	
    11	- ``Arrival()`` is suffix-stable, licenses the checkpoint, and is the ordering
    12	  the fold path actually runs under — so the handle reports
    13	  ``"checkpoint-suffix"`` and ``Spec.replay_from`` agrees with a cold replay.
    14	- ``ByKey(K)`` is NOT. An append is an insertion into the middle of the
    15	  projection, so a suffix replay onto a held state can disagree with a cold
    16	  fold — no checkpoint, cold fold only.
    17	
    18	The two negative facts are demonstrated against real data, not restated from
    19	the predicate's docstring; the predicate is then asserted to agree with what
    20	was observed.
    21	"""
    22	
    23	from __future__ import annotations
    24	
    25	import sqlite3
    26	from pathlib import Path
    27	from typing import Any, get_args
    28	
    29	import pytest
    30	from atoms import Field, Spec, Upsert
    31	from atoms.ordering import Arrival, ByKey, Ordering, OrderingError, is_suffix_stable, totalize
    32	
    33	from engine.handle import open_vertex
    34	from engine.sqlite_store import gen_id
    35	
    36	# ---------------------------------------------------------------------------
    37	# 1. The taxonomy answer, enumerated
    38	
    39	
    40	#: The RULED licensing answer for every Ordering variant. Adding a variant to
    41	#: the taxonomy without ruling on it fails `test_every_ordering_variant_is_ruled`.
    42	LICENSING: dict[type, bool] = {Arrival: True, ByKey: False}
    43	
    44	
    45	def test_every_ordering_variant_is_ruled() -> None:
    46	    """No variant may default into (or out of) a checkpoint licence."""
    47	    assert set(get_args(Ordering)) == set(LICENSING), (
    48	        "an Ordering variant is unruled for checkpoint dispatch — rule it here"
    49	    )
    50	
    51	
    52	@pytest.mark.parametrize(
    53	    "ordering,licensed",
    54	    [(Arrival(), True), (ByKey("ts"), False), (ByKey("seq"), False)],
    55	    ids=["arrival", "by-key-ts", "by-key-seq"],
    56	)
    57	def test_suffix_stability_licenses_the_checkpoint(ordering: Ordering, licensed: bool) -> None:
    58	    assert is_suffix_stable(ordering) is licensed
    59	    assert LICENSING[type(ordering)] is licensed
    60	
    61	
    62	def test_unknown_ordering_variant_is_refused_not_defaulted() -> None:
    63	    """A licence is never granted by falling off the end of the match."""
    64	    with pytest.raises(OrderingError, match="unknown Ordering variant"):
    65	        is_suffix_stable("arrival")  # type: ignore[arg-type]
