    45	class StoreReader:
    46	    """Read-only connection to a SqliteStore database.
    47	
    48	    Opens the database with PRAGMA query_only=ON. Does not create
    49	    the file or parent directories — raises FileNotFoundError if
    50	    the path does not exist.
    51	    """
    52	
    53	    def __init__(self, path: Path, *, timeout: float = 5.0) -> None:
    54	        self._path = Path(path)
    55	        if not self._path.exists():
    56	            raise FileNotFoundError(f"Store not found: {self._path}")
    57	
    58	        # ``timeout`` is sqlite's busy wait on a locked database. The 5s
    59	        # default suits interactive commands; latency-critical read paths
    60	        # (shell completion) pass a sub-second value — waiting out an
    61	        # exclusive lock is worse than under-listing there.
    62	        self._conn = sqlite3.connect(str(self._path), timeout=timeout)
    63	        self._conn.execute("PRAGMA query_only=ON")
    64	
    65	    @property
    66	    def fact_total(self) -> int:
    67	        """Visible total facts — the reserved ``_decl.*`` namespace excluded.
    68	
    69	        A ``@property`` (not a method) so ``reader.fact_total`` reads as a count,
    70	        not a bound method: a method here silently mis-renders (a truthy bound
    71	        method that format-prints as a repr) at any un-called call site. Excludes
    72	        ``_decl.*`` by default (SPEC §9.4 — every read surface excludes it),
    73	        using the same ``GLOB`` (not ``LIKE``) predicate as :meth:`fact_kind_stats`
    74	        so the visible total stays consistent with the visible per-kind breakdown.
    75	        Before S4 the delta was a single ``genesis`` row and an honest total could
    76	        ignore it; the edit ceremony (S4) grows the ``_decl.*`` row count on every
    77	        re-absorb, so an unfiltered total would drift from the kinds it sums to.
    78	        For the raw all-rows count use :meth:`fact_total_all`.
    79	        """
    80	        row = self._conn.execute(
    81	            "SELECT COUNT(*) FROM facts WHERE kind NOT GLOB '_decl.*'"
    82	        ).fetchone()
    83	        return row[0]
    84	
    85	    def fact_total_all(self) -> int:
    86	        """Raw total facts, INCLUDING the reserved ``_decl.*`` namespace.
    87	
    88	        The explicit escape hatch defeating the default exclusion of
    89	        :attr:`fact_total` — the ``--kind`` defeat the other read surfaces use,
    90	        named so the intent is legible at the call site.
    91	        """
    92	        row = self._conn.execute("SELECT COUNT(*) FROM facts").fetchone()
    93	        return row[0]
    94	
    95	    @property
    96	    def tick_total(self) -> int:
    97	        """Total number of ticks in the store."""
    98	        row = self._conn.execute("SELECT COUNT(*) FROM ticks").fetchone()
    99	        return row[0]
