+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+
+repo = Path("/Users/kaygee/Code/loops")
+src = repo / "libs/migrate/src"
+forbidden_imports = {
+    "engine.jsonl_codec",
+    "engine.jsonl_store",
+    "store.rebirth",
+    "store._conn",
+    "ckdl",
+    "custody",
+    "sign",
+}
+forbidden_calls = {"replicate", "bootstrap", "truncate_torn_tail"}
+bad_imports: list[str] = []
+bad_calls: list[str] = []
+arrival_log_imports: list[str] = []
+
+for path in sorted(src.rglob("*.py")):
+    tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            names = [alias.name for alias in node.names]
+        elif isinstance(node, ast.ImportFrom):
+            names = [node.module or ""]
+            if node.module == "engine.arrival":
+                for alias in node.names:
+                    if alias.name == "ArrivalLog":
+                        arrival_log_imports.append(f"{path.name}:{node.lineno}")
+        else:
+            names = []
+        for name in names:
+            if any(name == bad or name.startswith(bad + ".") for bad in forbidden_imports):
+                bad_imports.append(f"{path.name}:{node.lineno}:{name}")
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            if node.func.attr in forbidden_calls:
+                bad_calls.append(f"{path.name}:{node.lineno}:{node.func.attr}")
+
+print(f"forbidden_runtime_imports={bad_imports!r}")
+print(f"direct_ArrivalLog_imports={arrival_log_imports!r}")
+print(f"privileged_or_repair_calls={bad_calls!r}")
+if bad_imports or arrival_log_imports or bad_calls:
+    print("FAIL: migration quarantine/admission-only structure regressed")
+    raise SystemExit(1)
+print("PASS: quarantine and admission-only structure hold")
