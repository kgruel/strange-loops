   113	            total_rows += 1
   114	            per_kind_counts[unit.row.kind] += 1
   115	            observer_census[unit.row.observer] += 1
   116	            era = classify_id_era(unit.row.id)
   117	            id_era_census[era] += 1
   118	        elif isinstance(unit, BatchUnit):
   119	            total_rows += len(unit.rows)
   120	            for row in unit.rows:
