   120	
   121	        # Determine own root module names in src/
   122	        src_dir = pkg_dir / "src"
   123	        own_modules: set[str] = set()
   124	        if src_dir.is_dir():
   125	            for item in src_dir.iterdir():
   126	                if not item.name.startswith((".", "_")):
   127	                    own_modules.add(item.stem if item.is_file() else item.name)
   128	
   129	        src_declared = _get_package_declared_modules(pkg_dir, include_dev=False)
   130	        test_declared = _get_package_declared_modules(pkg_dir, include_dev=True)
   131	        test_declared.add("pytest")
   132	        test_declared.add("_pytest")
   133	
   134	        # 1. Check production src/ against [project].dependencies
   135	        for py_file in _src_py_files(pkg_dir):
   136	            rel = _rel(py_file)
   137	            collector = _collect_imports(py_file)
   138	            for mod, lineno in collector.runtime_modules:
