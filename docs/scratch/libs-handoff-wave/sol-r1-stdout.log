   114	def _fingerprint_documents(docs: list[dict[str, Any]]) -> str:
   115	    """Order-independent content hash over a document projection.
   116	
   117	    Sorted by ``(kind, subject)`` — see the module docstring for why order
   118	    must not participate. Distinct from ``declaration_generation``'s
   119	    review fingerprint (order-sensitive, same-source comparator): this one
   120	    compares projections across residences and fold orderings.
   121	    """
   122	    ordered = sorted(docs, key=lambda d: (d["kind"], d["subject"]))
   123	    canonical = json.dumps(ordered, sort_keys=True, separators=(",", ":"))
   124	    return "sha256:" + hashlib.sha256(canonical.encode("utf-8")).hexdigest()
