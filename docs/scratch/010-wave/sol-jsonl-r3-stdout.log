   575	    def _write_fact_row(self, row: tuple) -> None:
   576	        """Persist one assembled fact row (id, kind, ts, observer, origin,
   577	        payload, signature)."""
   578	        self._conn.execute(FACT_INSERT_SQL, row)
   579	        self._conn.commit()
   580	
   581	    def _write_tick_row(self, row: tuple) -> None:
   582	        """Persist one assembled tick row (_TICK_ROW_SQL order + signature)."""
   583	        self._conn.execute(TICK_INSERT_SQL, row)
   584	        self._conn.commit()
