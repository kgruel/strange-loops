tion streams)\\n    to persist alongside their derived state. A mark carries three\\n    fields that together make resumption deterministic:\\n\\n    - arrival_lineage: the lineage id from the log's genesis record\\n    - arrival_offset: byte offset into the file *immediately following*\\n      the newline of the consumed record (0 when no records consumed)\\n    - arrival_ordinal: the ordinal of the last consumed record (-1 when\\n      no records consumed)\\n    \\\"\\\"\\\"\\n\\n    arrival_lineage: str\\n    arrival_offset: int\\n    arrival_ordinal: int\"},{\"file\":\"libs/engine/src/engine/arrival_store.py\",\"lines\":\"101-103\",\"note\":\"store_meta table keys for arrival lineage, offset, ordinal\",\"quote\":\"ARRIVAL_LINEAGE_KEY = \\\"arrival_lineage\\\"\\nARRIVAL_OFFSET_KEY = \\\"arrival_offset\\\"\\nARRIVAL_ORDINAL_KEY = \\\"arrival_ordinal\\\"\"},{\"file\":\"libs/engine/src/engine/store_reader.py\",\"lines\":\"148-154\",\"note\":\"StoreReader.key_prefixes method signature taking kind, key_field, and prefix\",\"quote\":\"    def key_prefixes(\\n        self,\\n        kind: str,\\n        key_field: str,\\n        *,\\n        prefix: str = \\\"\\\",\\n        limit: int = 200,\\n    ) -\\u003e list[str]:\"}],\"not_covered\":\"None. Complete exploration across libs/store, libs/engine, libs/sdk, apps, and tests.\",\"question\":\"Survey the read-primitive surface of the arrival/jsonl store layer: public read/iteration methods, record.id generation, arrival position/sequence/head computations, prefix/key style methods, and call sites outside libs/store.\",\"search_method\":\"git branch --show-current, rg, fd, view_file, grep_search\",\"toolAction\":\"Completing exploration task\",\"toolSummary\":\"Finish exploration\"}\n","error":"exit status 128","duration_seconds":126.592042,"num_turns":1,"structured_output":{"answer":"found","locations":[{"file":"libs/engine/src/engine/sqlite_store.py","lines":"1202-1209","note":"SqliteStore.since method signature, docstring, and rowid ASC ordering","quote":"    def since(self, cursor: int) -\u003e list[T]:\n        \"\"\"Return events with rowid \u003e cursor.\n\n        Rowid is the SQLite integer primary key (receipt order). Events\n        are yielded in receipt order.\n        \"\"\"\n        rows = self._db.execute(\n            \"SELECT kind, ts, observer, origin, payload FROM facts WHERE rowid \u003e ? ORDER BY rowid\","},{"file":"libs/engine/src/engine/sqlite_store.py","lines":"1229-1245","note":"SqliteStore.since_raw method signature, docstring, and rowid ASC ordering","quote":"    def since_raw(self, cursor: int) -\u003e list[tuple[str, dict]]:\n        \"\"\"Return (kind, payload) tuples for replay — no Fact construction.\n\n        The injected ``_ts`` payload field gives downstream folds access to\n        event timestamp without constructing full Fact objects.\n\n        FOLD REPLAY ORDER is receipt order (rowid) — the order this store\n        received the facts. It is NOT timestamp order (the order events\n        occurred). Folds that maintain state across replays depend on\n        receipt order being stable across store instances.\n        \"\"\"\n        rows = self._db.execute(\n            \"SELECT kind, ts, payload FROM facts WHERE rowid \u003e ? ORDER BY rowid\","},{"file":"libs/engine/src/engine/sqlite_store.py","lines":"1255-1267","note":"SqliteStore.replay_cursor method signature, docstring, and rowid ASC ordering","quote":"    def replay_cursor(self, cursor: int):\n        \"\"\"Yield (kind, payload) pairs by streaming from the SQL cursor.\n\n        Avoids materializing all rows in memory. Uses the instance's\n        existing connection (not a dedicated cursor from a second connection).\n        Same receipt-order (rowid) fold replay and ``_ts`` injection as since_raw.\n        \"\"\"\n        cur = self._db.execute(\n            \"SELECT kind, ts, payload FROM facts WHERE rowid \u003e ? ORDER BY rowid\","},{"file":"libs/engine/src/engine/sqlite_store.