   135	# surfaces three layers away as a rebuild-time PK collision), no envelope
   136	# key besides t/rows. Same-ts across rows is deliberately NOT a codec rule
   137	# (D1): it is the declaration ceremony's invariant, enforced by absorb_edit
   138	# and asserted by audit_deep — baking it in here would block future
   139	# batch-emit reuse with distinct ts.
   140	_BATCH = "batch"
   141	_ROWS = "rows"
   142	_BATCH_KEYS = frozenset(("t", _ROWS))
   143	_MIN_BATCH_ROWS = 2
   144	
   145	# JCS (RFC 8785) numeric domain — mirrors rfc8785._impl._INT_MIN/_INT_MAX.
   146	# Integers outside it, and non-finite floats, are not canonicalizable, so a
   147	# line carrying one cannot be hashed: reject at the codec gate rather than
   148	# detonating inside the commitment hashers.
   149	_JCS_INT_MAX = 2**53 - 1
   150	_JCS_INT_MIN = -(2**53) + 1
   151	
   152	
   153	def _dump(obj: dict) -> str:
   154	    """Encode one line. ensure_ascii keeps lines 7-bit and free of raw
   155	    U+2028/U+2029; allow_nan=False refuses non-JSON floats explicitly;
   156	    separators drop insignificant whitespace. Key order is the dict's
   157	    insertion order — sqlite column order — not sorted: this is a transport
   158	    encoding, not a canonicalization (JCS lives in the hashers)."""
   159	    return json.dumps(obj, ensure_ascii=True, allow_nan=False,
   160	                      separators=(",", ":"))
   161	
   162	
   163	def _encode_obj(row: tuple, spec: _Spec) -> dict:
   164	    """Build the line object for a row — and hold it to the decoder's rules.
   165	
   166	    ``serialize(x)`` must always be decodable. Checking arity alone let a
   167	    row with a *typed*-wrong field through: a fact carrying ``ts="1.0"``
   168	    (a string, which sqlite's REAL affinity accepts) got a durable JSONL
   169	    receipt, and then every subsequent open failed on decode — the store
   170	    bricked by a line its own serializer wrote. Running the decoder's
   171	    :func:`_validate` over the object before dumping makes the two
   172	    directions symmetric by construction rather than by parallel
   173	    maintenance, and puts the error at the append site, where it is
   174	    attributable to the caller that built the row.
   175	    """
   176	    n = len(spec.fields)
   177	    if len(row) not in (n, n + 1):
   178	        raise JsonlCodecError(
   179	            f"{spec.t} row must have {n} or {n + 1} fields, got {len(row)}"
   180	        )
   181	    obj: dict = {"t": spec.t}
   182	    obj.update(zip(spec.fields, row[:n], strict=True))
   183	    if len(row) > n and row[n] is not None:
   184	        obj[_SIGNATURE] = row[n]
   185	    _validate(obj, spec)
   186	    return obj
   187	
   188	
   189	def object_of_fact_row(row: tuple) -> dict:
   190	    """A fact row ``(id, kind, ts, observer, origin, payload[, signature])`` as
   191	    its VALIDATED record object."""
   192	    return _encode_obj(row, _SPEC["fact"])
   193	
   194	
   195	def object_of_tick_row(row: tuple) -> dict:
   196	    """A tick row (``_TICK_ROW_SQL`` order, signature optional) as its
   197	    VALIDATED record object."""
   198	    return _encode_obj(row, _SPEC["tick"])
   199	
   200	
   201	def object_of_batch(rows: list[tuple]) -> dict:
   202	    """A multi-row ceremony as ONE atomic record object.
   203	
   204	    ``rows`` are fact row tuples in emission order. One row collapses to a
   205	    plain fact object — a 1-row batch would be a second spelling of the same
   206	    record (the "signature must be absent, not null" ethos), so the envelope
   207	    exists only where multi-row atomicity does. Zero rows is a caller bug.
   208	
   209	    Same both-directions symmetry as the scalar encoders: the built envelope
   210	    is held to :func:`_validate_batch`, so a bad row fails at the append
   211	    site instead of bricking every later open.
   212	    """
   213	    if not rows:
   214	        raise JsonlCodecError("batch requires at least one fact row")
   215	    if len(rows) == 1:
   216	        return object_of_fact_row(rows[0])
   217	    obj = {"t": _BATCH, _ROWS: [_encode_obj(r, _SPEC["fact"]) for r in rows]}
   218	    # Structural half only: every row object just came out of _encode_obj,
   219	    # which already ran the field-level _validate — re-running it per row
   220	    # would be the same check twice on the same object.
   221	    _validate_batch(obj, validate_rows=False)
   222	    return obj
   223	
   224	
   225	# The three serializers are their encoders composed with the dump, mirroring
   226	# the decode side (``deserialize_records`` is the load composed with
   227	# ``records_from_object``). A consumer that already holds — or wants — the
   228	# OBJECT calls the encoder directly rather than dumping a line only to parse
   229	# it straight back; an arrival record's ``body`` is exactly that object.
   230	
   470	def deserialize_records(line: str) -> list[tuple[str, tuple]]:
   471	    """Decode ANY line into its record sequence, in on-the-wire order.
   472	
   473	    A plain fact/tick line yields one ``(t, row)``; a batch line yields its
   474	    inner rows expanded in array order (always ≥ 2 — so ``len > 1`` is
   475	    exactly "this line was a batch"). This is the decode every log consumer
   476	    (replay, catch-up, rebuild, audit) reads through, so batch expansion has
   477	    one spelling.
   478	
   479	    Defined as the line decode composed with :func:`records_from_object`,
   480	    so decoding still has exactly one dispatch.
   481	    """
   482	    return records_from_object(_load(line))
   483	
   484	
   485	def records_from_object(obj: dict) -> list[tuple[str, tuple]]:
   486	    """:func:`deserialize_records` on an ALREADY-DECODED object.
   487	
   488	    An arrival record's ``body`` IS this codec's object for the row it
   489	    carries, so a consumer holding one has nothing to parse — before this
   490	    entry existed, ``arrival_store`` re-encoded the body just to hand a
   491	    string back to the line decoder.
   492	
   493	    The SAME validator runs: an object handed in is held to exactly the
   494	    domain a line is held to. What a line has and an object cannot is a
   495	    duplicate key, which the decode hook catches; everything downstream of
   496	    that hook is shared.
   497	    """
   498	    if not isinstance(obj, dict):
   499	        raise JsonlCodecError(
   500	            f"record must be a JSON object, got {type(obj).__name__}"
   501	        )
   502	    t = obj.get("t")
   503	    if t == _BATCH:
   504	        _validate_batch(obj)
   505	        fact = _SPEC["fact"]
   506	        return [("fact", _row_of(elem, fact)) for elem in obj[_ROWS]]
   507	    spec = _SPEC.get(t) if isinstance(t, str) else None
   508	    if spec is None:
   509	        raise JsonlCodecError(f"unknown record discriminator t={t!r}")
   510	    _validate(obj, spec)
   511	    return [(spec.t, _row_of(obj, spec))]
   512	
   513	
   514	def serialize_object(obj: dict) -> str:
   515	    """Encode an ALREADY-DECODED record object as one canonical line.
   600	            "self-consistency — every admitted signed row's authorship claim "
   601	            "verifies under the source's own key history — not target-"
   602	            "operator trust in the source's keys."
   603	        )
   604	
   605	
   606	def _comparable(t: str, row: tuple) -> tuple:
   607	    """One row's dedup-comparison body, shared by both sides of the merge.
   608	
   609	    Facts compare on the full authored 7-column body minus id. Ticks compare
   610	    on the chainless base minus id: chain columns and the tick signature are
   611	    store-local custody stripped by ``_entry_for`` on every merge, so the
   612	    target's chain can never ground a divergence claim against a source
   613	    tick that legitimately carries a different (or no) chain.
   614	    """
   615	    if t == "fact":
   616	        return ("fact", *row[1:7])
   617	    return ("tick", *row[1:6])
   618	
   619	
   620	_COMPARED_FIELDS = {
   621	    "fact": ("kind", "ts", "observer", "origin", "payload", "signature"),
   622	    "tick": ("name", "ts", "since", "origin", "payload"),
   623	}
   624	
   625	
   626	def _refuse_divergence(t: str, row: tuple, held_body: tuple) -> None:
   627	    incoming = _comparable(t, row)
   628	    if held_body[0] != incoming[0]:
   629	        diverging = ["row class"]
   630	    else:
   631	        diverging = [
   632	            name
   633	            for name, ours, theirs in zip(
   634	                _COMPARED_FIELDS[t], held_body[1:], incoming[1:], strict=True
   635	            )
   636	            if ours != theirs
   637	        ]
   638	    raise MergeDivergence(
   639	        f"{t} id {row[0]!r} exists on both sides with different content "
   640	        f"(diverging: {', '.join(diverging) or 'row class'}) — at most one "
   641	        "of them is what an arrival log says, and a merge that picked a "
   642	        "side would re-mint identity. Nothing was appended. Resolve the "
   643	        "contradiction at its source before merging."
   644	    )
   645	
   646	
   647	def _entries_for(source_rows: _SourceRows, held: dict[str, tuple], custodian: str):
   648	    """The records to append, after dedup.
   649	
   650	    ``custodian`` is the TARGET log's genesis observer, threaded through to
   651	    :func:`_entry_for` for the tick envelopes it mints. It is read once per
   652	    merge attempt at the call site, where the target log is already open,
   653	    rather than re-derived per record.
   654	
   655	    Returns ``(entries, facts, ticks, admitted)``, where ``admitted`` is the
   656	    surviving FACT rows paired with the source position they arrived at —
   657	    the admission set, which is exactly what admission verification is a
   658	    claim about, and exactly what a deduplicated row is not in.
   659	
   660	    A row whose id the target holds is skipped ONLY when its comparison body
   661	    matches the target's (:func:`_comparable`); the same id over different
   662	    content raises :class:`MergeDivergence` before anything is appended.
   663	    A group whose rows are ALL already in the target contributes no record.
   664	    A batch group that is partly deduped contributes its remainder: two or
   665	    more surviving rows still ride as one batch (the ceremony's atomicity is
   666	    the reason the batch exists), a single survivor rides as a plain fact
   667	    line, because a one-row batch is a second spelling the codec refuses.
   668	    A split batch needs no special handling for verification: the admission
   669	    set is per-ROW, so the remainder is simply the rows that are in it.
   670	    """
   671	    from engine.arrival import Entry
   672	
   673	    entries: list[Entry] = []
   674	    admitted: list[tuple[int | None, tuple]] = []
   675	    facts = ticks = 0
   676	    for kind, rows, ordinal in source_rows.groups:
   677	        fresh = []
   678	        for t, row in rows:
   679	            body = held.get(row[0])
   680	            if body is not None:
   681	                if body != _comparable(t, row):
   682	                    _refuse_divergence(t, row, body)
   683	                continue
   684	            fresh.append((t, row))
   685	        if not fresh:
   686	            continue
   687	        for t, row in fresh:
   688	            held[row[0]] = _comparable(t, row)
   689	            if t == "fact":
   690	                facts += 1
   691	                admitted.append((ordinal, row))
   692	            else:
   693	                ticks += 1
   694	        entries.append(_entry_for(kind, fresh, custodian))
   695	    return entries, facts, ticks, admitted
   696	
   697	
   698	def _entry_for(kind: str, rows: list[tuple[str, tuple]], custodian: str):
   699	    """One record for a group of surviving rows.
   700	
   701	    Record shape, asymmetric between facts and ticks, and the asymmetry is
   702	    inherited from the live write path rather than invented here:
   703	
   704	    * ``k`` is the row class, never a fact's own kind. Since wire v1 dropped
   705	      ``body.t``, it is the only place that class is written.
   706	    * ``origin``/``at`` mirror the row's own columns. ``observer`` splits by
   707	      kind, exactly as the live write path splits it
   708	      (:meth:`engine.arrival_store.ArrivalStore._custodian`, ruling 2 of
   709	      decision:design/arrival-wire-v1-seam-triage). A merged FACT's record
   710	      claims its ORIGINAL observer — the record describes the authored row,
   711	      not the operator who admitted it. A merged TICK has no author, so its
   712	      record names THIS log's custodian: ``custodian`` is the TARGET's
   713	      genesis observer, not the source's, because the record being minted
   714	      is the target's own. This is the second, independently-encoded tick
   715	      mint site; a respell that landed only at the live path would leave
   716	      merge committing the retired convention with nothing to catch it.
   717	    * **Fact bodies ride verbatim, the row's own signature included.** The
   718	      fact signature is a per-observer authorship claim over content only,
   719	      carried verbatim and never re-signed; era-aware NULL for a
   720	      pre-signature source.
   721	    * **Tick bodies carry chain columns and the tick signature as
   722	      NULL/absent.** ``prev_hash``/``window_start``/``fact_cursor``/
   723	      ``window_hash`` are store-local custody: carrying them verbatim would
   724	      put ticks in the target whose links reference the SOURCE's chain, so
   725	      the target's chain verification would break on every merged tick. And
   726	      keeping the tick signature while nulling the chain would be a
   727	      verification lie, because the tick signature covers the chain fields.
   728	      The codec accepts all five as nullable — this is the pre-chain era
   729	      shape, honestly claimed.
   730	
   731	    There is no record-level signature. ``merge_store`` takes no signer and
   732	    never will: there is no key to sign with, and the target's operator holds
   733	    no key for a foreign observer anyway. The authorship claim that survives
   734	    is the fact row's own signature, riding in the body. An ADMISSION
   735	    attestation — the target custodian's own claim that it admitted this
   736	    record — is a later cut's.
   737	
   738	    Not signing is separate from not CHECKING: ``merge_store``'s opt-in
   739	    ``verify`` holds these carried signatures to the source's own key
   740	    history before any of this is assembled (:class:`AdmissionUnverified`).
   741	    Whether they were checked or not, they ride verbatim — verification
   742	    decides whether the merge happens, never what a record says.
   743	    """
   744	    from engine.arrival import Entry
   745	    from engine.arrival_body import (
   746	        body_of_batch,
   747	        body_of_fact_row,
   748	        body_of_tick_row,
   749	    )
   750	    from engine.jsonl_codec import TICK_CHAIN_FIELDS, TICK_FIELDS
   751	
   752	    if kind == "tick":
   753	        _t, row = rows[0]
   754	        # Nulling the chain is THIS module's decision (see above); how many
   755	        # columns that is, and where they sit, is the codec's — so the width
   756	        # is derived from its field tuples rather than counted here. The
   757	        # slice reads Nones back in, the source arrival row has them
   758	        # overwritten; both land at the codec's tick arity, signature
   759	        # dropped by riding one short of it.
   760	        base = len(TICK_FIELDS) - len(TICK_CHAIN_FIELDS)
   761	        stripped = (*row[:base], *(None,) * len(TICK_CHAIN_FIELDS))
   762	        return Entry(
   763	            k="tick",
   764	            body=body_of_tick_row(stripped),
   765	            observer=custodian,
   766	            origin=stripped[4],
   767	            at=stripped[2],
   768	        )
   769	
   770	    fact_rows = [row for _t, row in rows]
   771	    first = fact_rows[0]
   772	    k = "batch" if len(fact_rows) > 1 else "fact"
   773	    body = body_of_batch(fact_rows) if k == "batch" else body_of_fact_row(first)
   774	    return Entry(
   775	        k=k, body=body, observer=first[3], origin=first[4], at=first[2]
   776	    )
   777	
   778	
   779	def _rederive_after_append(canonical: Path) -> None:
   780	    """Bring both projections current after the append phase.
   781	
   782	    The index by CONSUME-FORWARD catch-up, not by re-derivation: the records
   783	    just appended are a suffix, so opening the store appends their rows and
   784	    never clears anything. Re-deriving the whole index per merge would be
   785	    O(n) for no reason, and it would renumber nothing but it would still
   786	    drop the search index.
   787	
   788	    The derived log by regeneration, because it is byte-sorted and an append
   789	    to a sorted file is not an append. It is written whether or not one was
   790	    there before: an ABSENT projection builds automatically, because
     1	"""arrival — the append-only log that holds canonical custody for a store.
     2	
     3	Slice 0 of the arrival substrate (design fact
     4	``decision:design/arrival-slice0-record-grammar``; the wire format is written
     5	out in ``docs/dev/arrival-slice0-record-grammar-2026-08-17.md``). One file per
     6	store, ``<name>.arrival``, one JSON object per line. A record's position in
     7	that file — its **ordinal** — is its identity coordinate, paired with the
     8	**lineage** the genesis record opens. Everything derived from the log is a
     9	projection and is never authoritative.
    10	
    11	What slice 0 delivered: the record grammar, genesis minting, append under an
    12	interprocess lock, read by ordinal, the walk with density and chain
    13	verification, torn-tail truncation, corrupt-interior refusal, and the resume
    14	mark. Cut A (decision:design/arrival-sliceA-authority) added the authority
    15	half: the genesis carries the founding public key, self-signed at ordinal 0,
    16	and :func:`verify_authorship` resolves every verifying key from a
    17	``(lineage, ordinal)`` coordinate in the log — never from any artifact
    18	outside it. Projection re-derivation, declared projection orders, and audit
    19	re-basing are later slices and are not here.
    20	
    21	Two postures carry over from the existing store and are load-bearing:
    22	
    23	* **Truncate only what was never complete, and only at the tail.** A final
    24	  line with no ``\\n`` is an interrupted append; anything else that fails to
    25	  decode, fails its ``rh``, breaks the ordinal succession, or breaks the
    26	  ``prev`` link is corruption, and the answer is a human look rather than a
    27	  silent delete — the posture ``ceremony.IntentCorrupt`` already takes. On a
    28	  file that is the only copy, silent recovery is data loss with extra steps.
    29	* **The writer truncates, the reader never does.** Reads take no lock, so a
    30	  reader cannot distinguish "torn" from "an append is in flight right now";
    31	  it sees a complete newline-terminated record or it sees nothing yet. Only
    32	  the appender, holding the lock and knowing no append is in progress, may
    33	  conclude a tail is torn and cut it.
    34	
    35	Known limitation, stated rather than discovered: ``fcntl.flock`` is advisory
    36	and its behaviour over NFS and some network filesystems is unreliable. The
    37	concurrency contract below holds on a local POSIX filesystem. A store on a
    38	network mount is out of contract.
