    81	def _dump(obj: dict) -> str:
    82	    """Encode one line. ensure_ascii keeps lines 7-bit and free of raw
    83	    U+2028/U+2029; allow_nan=False refuses non-JSON floats explicitly;
    84	    separators drop insignificant whitespace. Key order is the dict's
