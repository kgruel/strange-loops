   719	        fact_cursor, observer, signed}``.
   720	        """
   721	        from lang.document import DECL_GENESIS, DECLARATION_PROTOCOL_VERSION
   722	
   723	        if protocol is None:
   724	            protocol = DECLARATION_PROTOCOL_VERSION
   725	
   726	        # Prepare schema OUTSIDE the transaction (these commit): the genesis
   727	        # write and the chain-head read need the signature and chain columns
   728	        # present. Safe pre-work — they mutate no facts.
   729	        self._ensure_sync()
   730	        self._ensure_fact_signature_column()
   731	        self._ensure_chain_columns()
   732	        self._ensure_meta_table()
   733	        # Reconcile derived state BEFORE the transaction (a reconcile commits):
   734	        # the chain-head and fact-cursor pins read below must not miss a
   735	        # durable-but-unindexed line — a mis-pin lands in the canonical log
   736	        # where no rebuild can repair it. No-op when sqlite is the store.
   737	        self._sync_derived_state()
   738	
   739	        conn = self._conn
   740	        prev_iso = conn.isolation_level
   741	        conn.isolation_level = None  # autocommit — explicit transaction control
   742	        try:
   743	            conn.execute("BEGIN IMMEDIATE")
   744	            try:
   745	                own = self._own_lineage_in_txn(conn)
   746	                if own is not None:
   747	                    raise GenesisExists(
   748	                        "the store's own lineage is already open "
   749	                        f"(own_lineage {own}) — re-absorb/edit is a later "
   750	                        "ceremony (no --force)"
   751	                    )
   752	
   753	                chain_head = self.current_chain_head()
   754	                frow = conn.execute(
   755	                    "SELECT id FROM facts ORDER BY rowid DESC LIMIT 1"
   756	                ).fetchone()
   757	                fact_cursor = frow[0] if frow else None
   758	
   759	                payload = {
   760	                    "protocol": protocol,
   761	                    "documents": list(documents),
   762	                    "chain_head": chain_head,
   763	                    "fact_cursor": fact_cursor,
   764	                }
   765	                ts = datetime.now(_UTC).timestamp()
   766	                lineage_id = gen_id()
   767	                payload_text = json.dumps(payload)
   768	                signature = (
