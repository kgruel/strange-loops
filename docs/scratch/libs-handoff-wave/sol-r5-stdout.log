    84	def _find_local_vertex(*, allow_ambiguous: bool = False) -> Path | None:
    85	    """Find a .vertex file in .loops/ or cwd. Returns first match or None.
    86	
    87	    REFUSES BY DEFAULT when the local tier holds more than one instance vertex:
    88	    raises :class:`~loops.errors.AmbiguousLocalVertex` rather than break the tie
    89	    alphabetically. The refusal lives HERE, in the primitive, because gating
    90	    each caller instead left the primitive itself importable as a bypass —
    91	    every new call site was one more chance to forget (sol P1-b round 2). There
    92	    is now no ungated way to ask this question by accident.
    93	
    94	    ``allow_ambiguous=True`` — the literal ``True``, nothing else is honored —
    95	    opts a caller out, for the best-effort uses where
    96	    an arbitrary pick is harmless and an exception would be worse: shell
    97	    completion (must never raise) and topology enumeration (which enumerates
    98	    every candidate anyway, so the pick carries no weight). Every such call
    99	    site is enumerated by Rule 9 in ``tests/test_architecture.py`` — the opt-out
   100	    is explicit at the call site precisely so it can be counted.
   101	    """
   102	    # `is True`, not truthiness: the ratchet in tests/test_architecture.py can
   103	    # only recognize a literal, so anything else it cannot see must not work
   104	    # here either. `allow_ambiguous=1` used to opt out at runtime while Rule 9
   105	    # recorded the call site as safe — runtime and ratchet disagreeing about
   106	    # what counts as an opt-out (sol round 3). They now agree by construction.
   107	    if allow_ambiguous is not True:
   108	        ambiguous = _ambiguous_local_vertices()
   109	        if ambiguous:
   110	            from loops.errors import AmbiguousLocalVertex
   111	
   112	            raise AmbiguousLocalVertex(ambiguous)
   113	    # Prefer .loops/.vertex (workspace root convention)
   114	    loops_dir = Path.cwd() / ".loops"
   115	    dotvertex = loops_dir / ".vertex"
   116	    if dotvertex.exists():
   117	        return dotvertex
   118	    # Fall back to .loops/*.vertex (named vertex)
   119	    if loops_dir.is_dir():
   120	        matches = sorted(loops_dir.glob("*.vertex"))
