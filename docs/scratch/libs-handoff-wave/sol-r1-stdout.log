   407	def _write_intent(preview: DeclarationUpdatePreview, observer: str) -> Path:
   408	    intent = {
   409	        "v": _INTENT_VERSION,
   410	        "mode": preview.mode,
   411	        "vertex_path": str(preview.vertex_path),
   412	        "canonical_path": str(preview.canonical_path),
   413	        "created_ts": datetime.now(UTC).timestamp(),
   414	        "observer": observer,
   415	        "old_status": preview.declaration_status,
   416	        "old_decl_head": list(preview.expected_head)
   417	        if preview.expected_head
   418	        else None,
   419	        "old_store_fingerprint": preview.old_store_fingerprint,
   420	        "lineage": preview.generation.get("lineage"),
   421	        "proposed_fingerprint": preview.proposed_fingerprint,
   422	        "proposed_documents": list(preview.documents),
   423	        "proposed_text": preview.proposed_text,
   424	    }
