// Package store reads loops SQLite event stores. The data format (schema +
// JSON payloads) is the fixed invariant shared with the Python implementation;
// this package reads stores Python wrote, byte-for-byte unchanged.
package store

import (
	"database/sql"
	"encoding/json"
	"fmt"

	_ "modernc.org/sqlite" // pure-Go driver, registered as "sqlite"
)

// Fact is a stored observation as read from the facts table.
type Fact struct {
	Kind     string
	TS       float64
	Observer string
	Origin   string
	Payload  map[string]any
}

// ReadFacts returns all facts in (ts, id) replay order — observation time
// ascending, ULID id as the stable tie-break (SPEC §6.2). This is the
// store-independent total order that makes replay merge-commutative: a fact
// keeps its (ts, id) verbatim through every slice/merge, whereas rowid is
// regenerated in merge-insertion order. Mirrors the incumbent's
// sqlite_store.since_raw / facts_for_replay (ORDER BY ts, id @ loops 14eb723).
//
// The event timestamp is injected into each payload as `_ts` (Latest folds
// consume it — SPEC §4.1/§4.4; replay must never consult the wall clock). The
// reader injects it so the fold layer sees the same envelope on every path.
// The store is opened read-only.
func ReadFacts(path string) ([]Fact, error) {
	db, err := sql.Open("sqlite", "file:"+path+"?mode=ro")
	if err != nil {
		return nil, fmt.Errorf("open %s: %w", path, err)
	}
	defer db.Close()

	rows, err := db.Query("SELECT kind, ts, observer, origin, payload, id FROM facts ORDER BY ts, id")
	if err != nil {
		return nil, fmt.Errorf("query facts: %w", err)
	}
	defer rows.Close()

	var out []Fact
	for rows.Next() {
		var f Fact
		var payloadJSON, id string
		if err := rows.Scan(&f.Kind, &f.TS, &f.Observer, &f.Origin, &payloadJSON, &id); err != nil {
			return nil, fmt.Errorf("scan: %w", err)
		}
		if err := json.Unmarshal([]byte(payloadJSON), &f.Payload); err != nil {
			return nil, fmt.Errorf("decode payload %q: %w", payloadJSON, err)
		}
		if f.Payload == nil {
			f.Payload = map[string]any{}
		}
		f.Payload["_ts"] = f.TS // §6.2 _ts injection
		out = append(out, f)
	}
	return out, rows.Err()
}

// Payloads returns just the fact payloads in (ts, id) replay order — the input
// to a kind-agnostic Spec.Replay (atoms layer applies every fold to every
// payload). Each payload carries the injected `_ts` (see ReadFacts).
func Payloads(path string) ([]map[string]any, error) {
	facts, err := ReadFacts(path)
	if err != nil {
		return nil, err
	}
	out := make([]map[string]any, len(facts))
	for i, f := range facts {
		out[i] = f.Payload
	}
	return out, nil
}
