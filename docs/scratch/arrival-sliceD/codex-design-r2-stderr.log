   176	def cursor_fact_summary(conn, fact_id: str) -> dict:
   177	    """Resolve a fact_cursor id to a terse summary of its target fact.
   178	
   179	    Read-path affordance, NOT part of any commitment — the chain commits
   180	    to ids and hashes; this is the human-facing dereference. Returns
   181	    ``{"cursor_kind": str, "cursor_preview": str}``. An empty cursor
   182	    resolves to empty fields; a dangling cursor (fact deleted) is named
   183	    explicitly rather than silently blank — verify reports that case as
   184	    a break, but read paths still render honestly.
   185	    """
   186	    if not fact_id:
   187	        return {"cursor_kind": "", "cursor_preview": ""}
   188	    row = conn.execute(
   189	        "SELECT kind, payload FROM facts WHERE id = ?", (fact_id,)
   190	    ).fetchone()
   191	    if row is None:
   192	        return {"cursor_kind": "", "cursor_preview": "(cursor fact missing)"}
   193	    try:
   194	        payload = json.loads(row[1])
   195	    except (TypeError, ValueError):
   196	        payload = {}
   197	    preview = ""
   198	    if isinstance(payload, dict):
   199	        for key in ("message", "topic", "name", "status"):
   200	            val = payload.get(key)
   201	            if isinstance(val, str) and val:
   202	                preview = val
   203	                break
   204	    if len(preview) > 80:
   205	        preview = preview[:79] + "…"
   206	    return {"cursor_kind": row[0], "cursor_preview": preview}
