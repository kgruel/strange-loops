+        {"subject": "v", "payload": {"name": "u", "boundary": []}},
+        2,
+    )
+    returned = _fact(
+        "rename-back",
+        "_decl.vertex-defined",
+        {"subject": "v", "payload": {"name": "v", "boundary": []}},
+        3,
+    )
+    assert _reason(
+        _anchor(documents),
+        (renamed, returned),
+        (_tick("old", "pulse", 1),),
+        target_documents=documents,
+    ) == "prior-incarnation"
+
