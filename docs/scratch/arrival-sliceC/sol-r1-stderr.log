    54	def _fold_ids(vertex_path: Path, **kwargs) -> list[str]:
    55	    """Replay ids in the order _combined_read handed them to the fold."""
    56	    from engine.compiler import compile_vertex
    57	    from engine.declaration import load_declaration
    58	
    59	    ast = load_declaration(vertex_path)
    60	    _, payloads = _combined_read(
    61	        ast, vertex_path, compile_vertex(ast), return_payloads=True, **kwargs
    62	    )
    63	    return [p["_id"] for p in payloads["decision"]]
    64	
