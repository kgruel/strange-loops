   342	    def _index_record(self, record: dict) -> None:
   343	        """Stage one record's rows into the index — verbatim, no mint
   344	        machinery, no signer; signatures ride as stored in the body.
   345	
   346	        What a record expands to is :func:`engine.arrival_projection.
   347	        rows_of_record`'s answer and not a second copy of it: the indexer
   348	        and the re-deriver disagreeing about a record is the one
   349	        disagreement this design cannot tolerate.
   350	        """
   351	        for t, row in rows_of_record(record):
   352	            try:
   353	                self._db.execute(
   354	                    FACT_INSERT_SQL if t == "fact" else TICK_INSERT_SQL, row
   355	                )
   356	            except Exception as exc:
   357	                raise ArrivalCanonicalUnsupported(
   358	                    f"the index at {self._path} refuses {t} {row[0]!r} from "
   359	                    f"ordinal {record['ord']} ({exc}) — it holds state the "
   360	                    "log does not account for. Run engine.arrival_projection."
   361	                    f"rederive_projections({str(self._log.path)!r}) to "
   362	                    "discard the projection and rebuild it from the log"
   363	                ) from exc
   364	
   365	    def _reconcile(self) -> ResumeMark | None:
   366	        """Refuse to stamp past a durable record the index has not consumed.
   367	
   368	        Same posture as the log-canonical store: a long-lived handle never
   369	        reopens, so every append reconciles first. Cheap in the common case
   370	        — one meta read and one stat.
   371	
   372	        Returns the mark this reconcile verified or (via catch-up) stamped,
   373	        so the write paths consume the reconciled position instead of
   374	        re-reading ``store_meta`` — the interloper checks are DEFINED
   375	        against exactly this pre-append mark. ``None`` only when the log is
   376	        empty, where no append can succeed anyway.
   377	        """
   378	        mark = self._read_mark()
   379	        if mark is not None and mark.arrival_offset == self._log.size():
   380	            return mark
   381	        self.catch_up()
   382	        return self._read_mark()
   383	
   384	    def _sync_derived_state(self) -> None:
   385	        """Reconcile before mint logic reads chain state off the index.
   386	
   387	        The reconciled mark is kept for :meth:`_ceremony_persist`, which
   388	        runs later inside the same ceremony transaction and must pin its
   389	        append to the head the CEREMONY reconciled against — not to
   390	        whatever the mark says by the time it runs.
   391	        """
   392	        self._reconciled_mark = self._reconcile()
   393	
   394	    # ---- the write path --------------------------------------------------
   395	
   396	    def _write(self, sql: str, row: tuple, encode_row, is_fact: bool) -> str | None:
   397	        """Stage the INSERT, make the record durable in the log, stamp, commit.
   398	
   399	        The INSERT runs first, uncommitted, so a rejected row fails before a
   400	        byte reaches the log and a refused write can never orphan a record.
   401	        The record's body is the codec's object for the COMMITTED read-back
   402	        row — the index and the log must derive-match. The record's arrival signature comes from
   403	        the injected ``fact_signer`` over the arrival commitment; the same
   404	        callable, a different digest, and the composing layer's
   405	        domain-separation prefix already binds both to this store family.
   406	
   407	        A record another writer lands in the log between the reconcile and
   408	        the append would otherwise be skipped forever: our record arrives
   409	        one ordinal later and the stamped mark would claim consumption it
   410	        never performed. The append's own coordinate is the tell — when it
   411	        is not the reconciled ordinal plus one, the staged INSERT rolls
   412	        back (our record is already durable in the log) and catch-up
   413	        consumes everything forward instead, the interloper included. The
   414	        returned signature is the committed row's either way: catch-up
   415	        re-inserts the identical row verbatim from the record's body.
   416	        """
   417	        consumed = self._reconcile()
   418	        # Codec pre-flight on the ASSEMBLED row, NOT dead work: sqlite's
   419	        # column affinity coerces (e.g. a string ts commits as REAL), so the
   420	        # committed-row encode below would ACCEPT a row the codec refuses
   421	        # — this is the gate that fails at the append site, where it is
   422	        # attributable, instead of laundering the value.
   423	        encode_row(row)
   424	        try:
   425	            self._db.execute(sql, row)
   426	            committed_row = self._committed_full_row(
   427	                "facts" if is_fact else "ticks", row[0]
   428	            )
   429	            committed = committed_row[-1]  # signature is the last column
   430	            body = encode_row(committed_row)
   431	            record, mark = self._log.append_marked(
   432	                "fact" if is_fact else "tick",
   433	                body,
   434	                observer=committed_row[3] if is_fact else committed_row[1],
   435	                origin=committed_row[4],
