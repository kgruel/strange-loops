   100	# ---------------------------------------------------------------------------
   101	# 1. Concurrent append, dense ordinals — THE GATE
   102	# ---------------------------------------------------------------------------
   103	
   104	_APPEND_WORKER = """
   105	    import sys
   106	    from engine.arrival import ArrivalLog
   107	
   108	    path, count, tag = sys.argv[1], int(sys.argv[2]), sys.argv[3]
   109	    log = ArrivalLog(path)
   110	    for i in range(count):
   111	        # No retry on purpose. The lock is supposed to make every append
   112	        # succeed first time; a rejection here means the head was read
   113	        # outside the critical section, and the worker must fail loudly
   114	        # rather than paper over it.
   115	        log.append("note", {"w": tag, "i": i}, observer=tag)
   116	    """
   117	
