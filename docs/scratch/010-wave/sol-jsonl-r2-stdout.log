   468	        no scan, no lock. Only a disagreement pays for :meth:`catch_up`
   469	        (which also covers a shrunk log, a torn tail and untrustworthy
   470	        offset metadata). Two handles racing the same orphan line is a loud
   471	        failure, not a silent one: the loser's tail INSERT hits the primary
   472	        key, rolls back, and the line stays recoverable.
   473	        """
   474	        if self._read_offset() == self._log_size():
   475	            return
   476	        self.catch_up()
   477	
   478	    def _write_fact_row(self, row: tuple) -> None:
   479	        self._write(FACT_INSERT_SQL, row, serialize_fact_row(row), True)
   480	
   481	    def _write_tick_row(self, row: tuple) -> None:
   482	        self._write(TICK_INSERT_SQL, row, serialize_tick_row(row), False)
   483	
   484	    # ---- catch-up -----------------------------------------------------
   485	
   486	    def catch_up(self) -> str:
   487	        """Reconcile the sqlite index with the log. Returns what it did:
   488	        ``"synced"``, ``"tailed"``, ``"rebuilt"`` or ``"empty"``."""
   489	        self._truncate_torn_line()
   490	        size = self._log_size()
   491	        offset = self._read_offset()
   492	
   493	        if size == 0:
   494	            # No log yet. An index with rows but no log is not a
   495	            # JSONL-canonical store — refuse rather than invent a log.
   496	            if self._has_rows():
   497	                raise JsonlCanonicalUnsupported(
   498	                    f"{self._path} has indexed rows but no canonical log at "
   499	                    f"{self._log_path} — export it first "
   500	                    "(store.jsonl.export_jsonl), then open it JSONL-canonical"
   501	                )
   502	            self._index_offset(0, 0, 0)
   503	            return "empty"
   504	
   505	        if offset is None:
   506	            self._rebuild("no consumed-offset marker recorded")
   507	            return "rebuilt"
   508	        if not 0 <= offset <= size:
   509	            # Outside the log's byte range in either direction. A negative
   510	            # offset is not a seek position to try — it is metadata that
   511	            # cannot be true, exactly as untrustworthy as one past the end.
   512	            self._rebuild(f"offset {offset} outside the log's 0..{size} byte range")
   513	            return "rebuilt"
   514	        if not self._prefix_intact(offset):
   515	            self._rebuild(f"log content at offset {offset} does not match the index")
   516	            return "rebuilt"
   517	
   518	        marked = self._marked_counts()
   519	        if marked is None:
   520	            # Pre-marker store: no baseline exists, so nothing can be judged
   521	            # out of band. Adopt the current row counts as the baseline so
   522	            # every later open has something honest to compare against.
   523	            base_facts, base_ticks = self._row_counts()
   524	            judge = False
   525	        else:
   526	            base_facts, base_ticks = marked
   527	            judge = True
   528	
   529	        if offset == size:
   530	            if judge:
   531	                self._refuse_out_of_band(base_facts, base_ticks)
   532	            else:
   533	                self._index_offset(offset, base_facts, base_ticks)
   534	            return "synced"
   535	
   536	        facts, ticks = self._tail_forward(offset, base_facts, base_ticks)
   537	        if judge:
   538	            self._refuse_out_of_band(facts, ticks)
   539	        return "tailed"
   540	
   541	    def _refuse_out_of_band(self, expect_facts: int, expect_ticks: int) -> None:
   542	        """Refuse a db carrying rows that never came through the log.
   543	
   544	        ``libs/store``'s merge/receive/rebirth/compact open their own
   545	        connection and INSERT straight into ``facts``/``ticks``. Those rows
   546	        are invisible to the log, so the index is no longer a function of it.
   547	        Refusing is the only non-destructive answer: rebuilding would delete
   548	        precisely the out-of-band rows. Catches inserts only. An edit to the
   549	        last consumed row is the last-line compare's job; an edit to an
   550	        interior row is ``verify_chain``'s (module docstring).
   551	        """
   552	        facts, ticks = self._row_counts()
   553	        if facts == expect_facts and ticks == expect_ticks:
   554	            return
   555	        raise JsonlCanonicalUnsupported(
   556	            f"{self._path} holds rows that did not come through "
   557	            f"{self._log_path}: sqlite has {facts} fact(s)/{ticks} tick(s), the "
   558	            f"log accounts for {expect_facts}/{expect_ticks}. "
   559	            "Out-of-band writers (store.merge, store.receive, rebirth, "
   560	            "compact) are not wired for a JSONL-canonical store. Recovery: "
   561	            "open it as a plain SqliteStore and re-export the log "
   562	            "(store.jsonl.export_jsonl) before reopening JSONL-canonical."
   563	        )
   564	
   565	    def _has_rows(self) -> bool:
   566	        for table in ("facts", "ticks"):
   567	            if self._conn.execute(f"SELECT EXISTS(SELECT 1 FROM {table})").fetchone()[0]:
   568	                return True
   569	        return False
   570	
   571	    def _index_offset(self, offset: int, facts: int, ticks: int) -> None:
   572	        self._stamp(offset, facts, ticks)
   573	        self._conn.commit()
   574	
   575	    def _last_newline_before(self, fh, end: int) -> int:
   576	        """Byte offset just past the last ``\\n`` strictly before ``end``.
   577	
   578	        Scans backwards in chunks — never loads the whole log, and never
   579	        gives up as a function of line length (a single 70KB payload must
   580	        not silently disable the integrity check). 0 when there is none.
   581	        """
   582	        pos = end
   583	        while pos > 0:
   584	            start = max(0, pos - _CHUNK)
   585	            fh.seek(start)
   586	            chunk = fh.read(pos - start)
   587	            idx = chunk.rfind(b"\n")
   588	            if idx != -1:
   589	                return start + idx + 1
   590	            pos = start
   591	        return 0
   592	
   593	    def _truncate_torn_line(self) -> None:
   594	        """Drop a trailing partial line (crash mid-write) from the log.
   595	
   596	        Truncation, not skipping: partial bytes left at the tail would be
   597	        concatenated onto by the next append, corrupting the canonical log.
   598	        """
   599	        size = self._log_size()
   600	        if size == 0:
   601	            return
   602	        with self._log_path.open("rb") as fh:
   603	            fh.seek(size - 1)
   604	            if fh.read(1) == b"\n":
   605	                return
   606	            cut = self._last_newline_before(fh, size)
   607	        # cut is 0 when the whole file is one partial line.
   608	        _log.warning(
   609	            "jsonl-canonical: torn final line in %s — truncating %d byte(s)",
   610	            self._log_path, size - cut,
   611	        )
   612	        with self._log_path.open("r+b") as fh:
   613	            fh.truncate(cut)
   614	            fh.flush()
   615	            os.fsync(fh.fileno())
   616	
   617	    def _prefix_intact(self, offset: int) -> bool:
   618	        """Cheap integrity check on the consumed prefix.
   619	
   620	        ``offset`` must land just past a newline, and the last line before it
   621	        must re-serialize byte-identically from the sqlite row it names — a
   622	        commitment comparison over one line rather than the whole file.
   623	
   624	        One line, not the file: judging every row would make each open O(n)
   625	        over the log. So this catches an edit to the last consumed row and
   626	        nothing behind it — interior content is ``verify_chain``'s scope.
   627	        """
   628	        if offset == 0:
   629	            return True
   630	        with self._log_path.open("rb") as fh:
   631	            fh.seek(offset - 1)
   632	            if fh.read(1) != b"\n":
   633	                return False
   634	            # Walk back to the true line start however long the line is —
   635	            # declining to judge past a fixed window would turn the check off
   636	            # as a function of payload size.
   637	            line_start = self._last_newline_before(fh, offset - 1)
   638	            fh.seek(line_start)
   639	            raw = fh.read(offset - 1 - line_start)
   640	        try:
   641	            line = raw.decode("utf-8")
   642	        except UnicodeError:
   643	            return False
   644	        try:
   645	            t, row = deserialize_row(line)
   646	        except (JsonlCodecError, UnicodeError):
   647	            return False
   648	        return self._row_matches(t, row)
   649	
   650	    def _row_matches(self, t: str, row: tuple) -> bool:
   651	        table, columns = (
   652	            ("facts", FACT_COLUMNS) if t == "fact" else ("ticks", TICK_COLUMNS)
   653	        )
   654	        stored = self._conn.execute(
   655	            f"SELECT {', '.join(columns)} FROM {table} WHERE id = ?", (row[0],)
   656	        ).fetchone()
   657	        if stored is None:
   658	            return False
   659	        # Compare VALUES, not re-serialized text: sqlite's REAL affinity
   660	        # returns 1700000000.0 for a line carrying 1700000000, and
   661	        # re-serializing would make every integral ts/since look corrupt —
   662	        # a full rebuild on every open, drowning the real-corruption signal.
   663	        # Python's cross-type numeric equality normalizes that uniformly.
   664	        return tuple(stored) == tuple(row)
   665	
   666	    def _read_lines(self, offset: int):
   667	        """Yield ``(line, end_offset)`` for every COMPLETE line from offset."""
   668	        with self._log_path.open("rb") as fh:
   669	            fh.seek(offset)
   670	            pos = offset
   671	            for raw in fh:
   672	                if not raw.endswith(b"\n"):
   673	                    return  # incomplete tail — never indexed
   674	                pos += len(raw)
   675	                line = raw[:-1].decode("utf-8").strip()
   676	                if line:
   677	                    yield line, pos
   678	
   679	    def _index_lines(
   680	        self, offset: int, base_facts: int, base_ticks: int
   681	    ) -> tuple[int, int, int]:
   682	        """Index every complete line from ``offset``. Verbatim: no mint
   683	        machinery, no signer, signatures ride as stored.
   684	
   685	        Returns ``(new_facts, new_ticks, end_offset)`` and stamps
   686	        ``base + new`` — the marker is derived from the committed baseline
   687	        handed in, never from per-handle state.
   688	        """
   689	        facts = ticks = 0
   690	        end = offset
   691	        for line, pos in self._read_lines(offset):
   692	            t, row = deserialize_row(line)
   693	            self._conn.execute(FACT_INSERT_SQL if t == "fact" else TICK_INSERT_SQL, row)
   694	            if t == "fact":
   695	                facts += 1
   696	            else:
   697	                ticks += 1
   698	            end = pos
   699	        self._stamp(end, base_facts + facts, base_ticks + ticks)
   700	        self._conn.commit()
   701	        return facts, ticks, end
   702	
   703	    def _tail_forward(
   704	        self, offset: int, base_facts: int, base_ticks: int
   705	    ) -> tuple[int, int]:
   706	        facts, ticks, end = self._index_lines(offset, base_facts, base_ticks)
   707	        _log.info(
   708	            "jsonl-canonical: %s behind %s — tailed %d fact(s), %d tick(s) to %d",
   709	            self._path, self._log_path, facts, ticks, end,
   710	        )
   711	        return base_facts + facts, base_ticks + ticks
   712	
   713	    def _rebuild(self, reason: str) -> None:
   714	        """Rebuild the whole sqlite index from the log.
   715	
   716	        Clears ``facts`` and ``ticks`` only: ``store_meta`` survives, because
   717	        ``own_lineage`` (which ``_decl.genesis`` row is *self*) is identity,
   718	        not fact — it is not in the log and cannot be re-derived from it.
   719	
   720	        The FTS index is dropped in the same transaction. ``facts`` has no
   721	        ``AUTOINCREMENT``, so ``DELETE FROM facts`` resets sqlite's rowid
   722	        counter and re-indexed rows take rowids that previously named other
   723	        facts. ``facts_fts.fact_rowid`` keys on exactly that rowid and
   724	        ``fts_state.last_rowid`` is the incremental watermark, so a surviving
   725	        FTS index would resolve stale text to new facts and skip every
   726	        re-indexed row. Dropping it makes search report ``missing`` (the
   727	        honest "run reindex" state) instead of answering wrongly.
   728	        """
   729	        _log.warning(
   730	            "jsonl-canonical: rebuilding sqlite index %s from %s — %s",
   731	            self._path, self._log_path, reason,
   732	        )
   733	        self._conn.execute("DELETE FROM facts")
   734	        self._conn.execute("DELETE FROM ticks")
   735	        self._conn.execute("DROP TABLE IF EXISTS facts_fts")
   736	        self._conn.execute("DROP TABLE IF EXISTS fts_state")
   737	        facts, ticks, end = self._index_lines(0, 0, 0)
   738	        _log.warning(
   739	            "jsonl-canonical: rebuilt %d fact(s), %d tick(s) from %s (offset %d)",
   740	            facts, ticks, self._log_path, end,
   741	        )
   742	
   743	    # ---- refusals ------------------------------------------------------
   744	
   745	    def _refuse(self, op: str) -> None:
   746	        raise JsonlCanonicalUnsupported(
   747	            f"{op} is not wired for a JSONL-canonical store: it would rewrite "
   748	            "sqlite rows while the canonical log kept the originals, so the "
   749	            "index would stop being a function of the log. See "
   750	            "design/architecture/jsonl-canonical-store — the log-rewrite "
   751	            "ceremony is a later slice."
   752	        )
   753	
   754	    def absorb_genesis(self, *args: Any, **kwargs: Any):  # noqa: D102
   755	        self._refuse("absorb_genesis")
   756	
   757	    def absorb_edit(self, *args: Any, **kwargs: Any):  # noqa: D102
   758	        self._refuse("absorb_edit")
   759	
   760	    def reanchor(self, *args: Any, **kwargs: Any):  # noqa: D102
     1	"""jsonl_codec — the line codec for the canonical JSONL store.
     2	
     3	One interleaved append-only log per store (``.loops/data/<name>.jsonl``);
     4	each line is a JSON object carrying a ``"t"`` discriminator (``"fact"`` or
     5	``"tick"``) plus the persisted row fields, in sqlite column order.
     6	
     7	The load-bearing invariant (design/architecture/jsonl-canonical-store):
     8	**payload rides as the VERBATIM stored TEXT string** — a JSON string value,
     9	never re-serialized, never parsed by this codec. Every commitment hash in
    10	``engine.sqlite_store`` (``_fact_row_hash``, ``_fact_commitment_hash``,
    11	``_tick_envelope``/``_tick_row_hash``) embeds payload verbatim, so a line
    12	round-tripped through this codec re-derives byte-identical hashes and every
    13	existing signature keeps verifying.
    14	
    15	Era handling mirrors the era-aware hashers exactly. All commitment fields
    16	are always present (``null`` when the row holds NULL — pre-chain ticks); the
    17	``signature`` key is emitted only when the row carries one, which is precisely
    18	the condition under which the hashers fold it into the envelope. A 6-tuple
    19	fact row and a 7-tuple row with ``signature=None`` therefore hash identically
    20	and serialize identically; deserializers return the full-arity tuple (7 fact
    21	fields / 11 tick fields) with ``None`` filled in.
    22	
    23	Unknown, missing, or mistyped fields are rejected loudly
    24	(:class:`JsonlCodecError`) — explicit over implicit. A store's canonical log
    25	is not a place for silent tolerance. So is a duplicate key: JSON's last-wins
    26	resolution would let one line carry two ids and a reader silently pick one.
    27	
    28	The rules run in **both** directions from one function. ``serialize`` holds
    29	its object to the same domain ``deserialize`` enforces, so ``serialize(x)``
    30	is always decodable — a wrongly typed field fails at the append site, where
    31	it is attributable, rather than becoming a durable line that bricks every
    32	later open.
    33	"""
    34	
    35	from __future__ import annotations
    36	
    37	import json
    38	import math
    39	
    40	__all__ = [
    41	    "FACT_FIELDS",
    42	    "TICK_FIELDS",
    43	    "JsonlCodecError",
    44	    "serialize_fact_row",
    45	    "serialize_tick_row",
    46	    "deserialize_row",
    47	]
    48	
    49	
    50	class JsonlCodecError(ValueError):
    51	    """A JSONL line does not match the canonical schema."""
    52	
    53	
    54	# Column order — the one spelling of it. ``engine.sqlite_store`` builds its
    55	# INSERT statements from these tuples, so a schema column and a log field can
    56	# never drift apart.
    57	FACT_FIELDS = ("id", "kind", "ts", "observer", "origin", "payload")
    58	TICK_FIELDS = (
    59	    "id", "name", "ts", "since", "origin", "payload",
    60	    "prev_hash", "window_start", "fact_cursor", "window_hash",
    61	)
    62	_SIGNATURE = "signature"
    63	
    64	_NUMERIC = ("ts", "since")
    65	
    66	
    67	class _Spec:
    68	    """Everything the codec knows about one record type, keyed by ``"t"``.
    69	
    70	    Fact and tick differ only in their field tuple and which fields may be
    71	    null; both directions of both types then run one code path, so a rule
    72	    added here cannot apply to one type and be forgotten for the other.
    73	    """
    74	
    75	    __slots__ = ("t", "fields", "allowed", "nullable")
    76	
    77	    def __init__(self, t: str, fields: tuple[str, ...], nullable: frozenset[str]):
    78	        self.t = t
    79	        self.fields = fields
    80	        self.allowed = frozenset((*fields, _SIGNATURE, "t"))
    81	        self.nullable = nullable
    82	
    83	
    84	_SPEC = {
    85	    "fact": _Spec("fact", FACT_FIELDS, frozenset()),
    86	    "tick": _Spec(
    87	        "tick",
    88	        TICK_FIELDS,
    89	        frozenset(("since", "prev_hash", "window_start", "fact_cursor", "window_hash")),
    90	    ),
    91	}
    92	
    93	# JCS (RFC 8785) numeric domain — mirrors rfc8785._impl._INT_MIN/_INT_MAX.
    94	# Integers outside it, and non-finite floats, are not canonicalizable, so a
    95	# line carrying one cannot be hashed: reject at the codec gate rather than
    96	# detonating inside the commitment hashers.
    97	_JCS_INT_MAX = 2**53 - 1
    98	_JCS_INT_MIN = -(2**53) + 1
    99	
   100	
   101	def _dump(obj: dict) -> str:
   102	    """Encode one line. ensure_ascii keeps lines 7-bit and free of raw
   103	    U+2028/U+2029; allow_nan=False refuses non-JSON floats explicitly;
   104	    separators drop insignificant whitespace. Key order is the dict's
   105	    insertion order — sqlite column order — not sorted: this is a transport
   106	    encoding, not a canonicalization (JCS lives in the hashers)."""
   107	    return json.dumps(obj, ensure_ascii=True, allow_nan=False,
   108	                      separators=(",", ":"))
   109	
   110	
   111	def _encode(row: tuple, spec: _Spec) -> str:
   112	    """Build the line object for a row — and hold it to the decoder's rules.
   113	
   114	    ``serialize(x)`` must always be decodable. Checking arity alone let a
   115	    row with a *typed*-wrong field through: a fact carrying ``ts="1.0"``
   116	    (a string, which sqlite's REAL affinity accepts) got a durable JSONL
   117	    receipt, and then every subsequent open failed on decode — the store
   118	    bricked by a line its own serializer wrote. Running the decoder's
   119	    :func:`_validate` over the object before dumping makes the two
   120	    directions symmetric by construction rather than by parallel
   121	    maintenance, and puts the error at the append site, where it is
   122	    attributable to the caller that built the row.
   123	    """
   124	    n = len(spec.fields)
   125	    if len(row) not in (n, n + 1):
   126	        raise JsonlCodecError(
   127	            f"{spec.t} row must have {n} or {n + 1} fields, got {len(row)}"
   128	        )
   129	    obj: dict = {"t": spec.t}
   130	    obj.update(zip(spec.fields, row[:n], strict=True))
   131	    if len(row) > n and row[n] is not None:
   132	        obj[_SIGNATURE] = row[n]
   133	    _validate(obj, spec)
   134	    return _dump(obj)
   135	
   136	
   137	def serialize_fact_row(row: tuple) -> str:
   138	    """Encode a fact row ``(id, kind, ts, observer, origin, payload[, signature])``."""
   139	    return _encode(row, _SPEC["fact"])
   140	
   141	
   142	def serialize_tick_row(row: tuple) -> str:
   143	    """Encode a tick row (``_TICK_ROW_SQL`` order, signature optional)."""
   144	    return _encode(row, _SPEC["tick"])
   145	
   146	
   147	def _reject_constant(name: str) -> None:
   148	    """Refuse the non-JSON literals ``NaN``/``Infinity``/``-Infinity``.
   149	
   150	    Serialization uses ``allow_nan=False``, so these can never be emitted;
   151	    admitting them on read would let a corrupt line past the codec gate and
   152	    detonate later inside the JCS commitment hashers (or land a NaN ``ts``
   153	    in sqlite). Reject at the boundary — explicit over implicit.
   154	    """
   155	    raise JsonlCodecError(f"non-JSON literal {name!r} is not permitted")
   156	
   157	
   158	def _no_duplicate_keys(pairs: list[tuple[str, object]]) -> dict:
   159	    """Build the object, refusing a key spelled twice.
   160	
   161	    ``json.loads`` resolves duplicates last-wins, so ``"id":"A","id":"B"``
   162	    decodes as ``B`` — two different lines with two different meanings that
   163	    a reader silently collapses to one. A canonical log admits exactly one
   164	    spelling per record; ambiguity is corruption, not a parse detail.
   165	    """
   166	    obj: dict = {}
   167	    for key, value in pairs:
   168	        if key in obj:
   169	            raise JsonlCodecError(f"duplicate key {key!r} in line")
   170	        obj[key] = value
   171	    return obj
   172	
   173	
   174	def _load(line: str) -> dict:
   175	    try:
   176	        obj = json.loads(
   177	            line, parse_constant=_reject_constant, object_pairs_hook=_no_duplicate_keys
   178	        )
   179	    except JsonlCodecError:
   180	        # Raised by our own hooks — already the right error, with the right
   181	        # message. Re-wrapping it as "not valid JSON" would bury the reason.
   182	        raise
   183	    except ValueError as exc:
   184	        raise JsonlCodecError(f"not valid JSON: {exc}") from exc
   185	    if not isinstance(obj, dict):
   186	        raise JsonlCodecError(
   187	            f"line must be a JSON object, got {type(obj).__name__}"
   188	        )
   189	    return obj
   190	
   191	
   192	def _validate(obj: dict, spec: _Spec) -> None:
   193	    t = spec.t
   194	    unknown = sorted(set(obj) - spec.allowed)
   195	    if unknown:
   196	        raise JsonlCodecError(f"unknown field(s) in {t} line: {unknown}")
   197	    missing = [f for f in spec.fields if f not in obj]
   198	    if missing:
   199	        raise JsonlCodecError(f"missing field(s) in {t} line: {missing}")
   200	    for field in spec.fields:
   201	        value = obj[field]
   202	        if value is None:
   203	            if field not in spec.nullable:
   204	                raise JsonlCodecError(f"{t} field {field!r} must not be null")
   205	            continue
   206	        if field in _NUMERIC:
   207	            # bool is an int subclass — reject it explicitly.
   208	            if isinstance(value, bool) or not isinstance(value, (int, float)):
   209	                raise JsonlCodecError(
   210	                    f"{t} field {field!r} must be a number, got "
   211	                    f"{type(value).__name__}"
   212	                )
   213	            # Standards-valid JSON can still spell a number outside the JCS
   214	            # domain (``1e999`` overflows to inf; a 400-digit integer exceeds
   215	            # the safe-integer bound). Range-check here — the literal parser
   216	            # only sees the NaN/Infinity spellings.
   217	            if isinstance(value, float):
   218	                if not math.isfinite(value):
   219	                    raise JsonlCodecError(
   220	                        f"{t} field {field!r} must be a finite number, got "
   221	                        f"{value!r}"
   222	                    )
   223	            elif not (_JCS_INT_MIN <= value <= _JCS_INT_MAX):
   224	                raise JsonlCodecError(
   225	                    f"{t} field {field!r} is outside the JCS safe-integer "
   226	                    f"domain: {value}"
   227	                )
   228	        elif not isinstance(value, str):
   229	            raise JsonlCodecError(
   230	                f"{t} field {field!r} must be a string, got "
   231	                f"{type(value).__name__}"
   232	            )
   233	    if _SIGNATURE in obj and obj[_SIGNATURE] is None:
   234	        # Absent IS the unsigned era; an explicit null is a second spelling
   235	        # of the same state, so serialize stays the unique canonical form.
   236	        raise JsonlCodecError(
   237	            f"{t} field 'signature' must be absent, not null, when unsigned"
   238	        )
   239	    sig = obj.get(_SIGNATURE)
   240	    if sig is not None and not isinstance(sig, str):
   241	        raise JsonlCodecError(
   242	            f"{t} field 'signature' must be a string, got {type(sig).__name__}"
   243	        )
