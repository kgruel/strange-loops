   505	    b.append(fact(message="from-b"))
   506	    a.close()
   507	    b.close()
   508	
   509	    assert len(lines(log_path_for(tmp_path / "s.db"))) == 2
   510	    assert len(sqlite_facts(tmp_path / "s.db")) == 2
   511	
   512	    reopened = open_store(tmp_path)  # must not raise
   513	    assert reopened.catch_up() == "synced"
   514	    reopened.close()
