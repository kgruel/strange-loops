   223	            canonical_mode=None,
   224	            canonical_path=None,
   225	            index_path=None,
   226	            exists=False,
   227	            index_current=None,
   228	            declaration_status=None,
   229	            writable=_writable(path),
   230	            canonical_writable=None,
   231	            reason="vertex declaration does not exist",
   232	        )
   233	    try:
   234	        from .declaration import load_declaration_status
   235	
   236	        ast, status = load_declaration_status(path)
   237	    except Exception as exc:  # noqa: BLE001 — a probe reports, never raises
   238	        return TargetInfo(
   239	            target_type="vertex",
   240	            canonical_mode=None,
   241	            canonical_path=None,
   242	            index_path=None,
   243	            exists=True,
   244	            index_current=None,
   245	            declaration_status=None,
   246	            writable=_writable(path),
   247	            canonical_writable=None,
   248	            reason=f"vertex declaration does not resolve: {exc}",
   249	        )
   250	    store_field = getattr(ast, "store", None)
   251	    if store_field is None:
   252	        return TargetInfo(
   253	            target_type="vertex",
   254	            canonical_mode=None,
   255	            canonical_path=None,
   256	            index_path=None,
   257	            exists=True,
   258	            index_current=None,
   259	            declaration_status=status,
   260	            writable=_writable(path),
   261	            canonical_writable=None,
   262	            reason="vertex declares no store — declaration only",
   263	        )
   264	    canonical = canonical_store_path(store_field, path)
   265	    mode = "jsonl" if canonical.suffix == CANONICAL_LOG_SUFFIX else "sqlite"
   266	    return TargetInfo(
   267	        target_type="vertex",
   268	        canonical_mode=mode,
   269	        canonical_path=canonical,
   270	        index_path=index_path_for(canonical),
   271	        exists=True,
   272	        index_current=_currency(canonical) if mode == "jsonl" else None,
   273	        declaration_status=status,
   274	        writable=_writable(path),
   275	        canonical_writable=write_surface_reason(canonical) is None,
   276	        reason=f"vertex declaring a {mode}-canonical store at {canonical}",
   277	    )
