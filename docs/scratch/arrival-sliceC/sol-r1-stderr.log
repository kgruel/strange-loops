    55	def _resolve_combine_stores(ast: Any, vertex_path: Path) -> list[Path]:
    56	    """Resolve combine entries to a list of existing store paths.
    57	
    58	    For each CombineEntry, resolves the vertex name to a .vertex file,
    59	    parses it, and extracts its store path. Skips entries whose store
    60	    doesn't exist (graceful degradation).
    61	    """
    62	    from lang import parse_vertex_file, resolve_vertex
    63	
    64	    home = _loops_home()
    65	    store_paths: list[Path] = []
    66	
    67	    for entry in ast.combine:
    68	        vpath = resolve_vertex(entry.name, home)
    69	        if not vpath.is_absolute():
    70	            vpath = (vertex_path.parent / vpath).resolve()
    71	        if not vpath.exists():
    72	            continue
    73	
    74	        ref_ast = parse_vertex_file(vpath)
    75	        if ref_ast.store is None:
    76	            continue
    77	
    78	        sp = resolved_index(ref_ast.store, vpath)
    79	        if sp.exists():
    80	            store_paths.append(sp)
    81	
    82	    return store_paths
    83	
    84	
    85	def _resolve_discover_stores(ast: Any, vertex_path: Path) -> list[Path]:
    86	    """Resolve discover glob to existing store paths from discovered instances."""
    87	    from lang import parse_vertex_file
    88	
    89	    if ast.discover is None:
    90	        return []
    91	
    92	    base_dir = vertex_path.parent
    93	    store_paths: list[Path] = []
    94	    for match in sorted(base_dir.glob(ast.discover)):
    95	        if match.suffix != ".vertex":
    96	            continue
    97	        # Skip self
    98	        if match.resolve() == vertex_path.resolve():
    99	            continue
   100	        try:
   101	            ref_ast = parse_vertex_file(match)
   102	        except Exception:
   103	            continue
   104	        if ref_ast.store is None:
   105	            continue
   106	        sp = resolved_index(ref_ast.store, match)
   107	        if sp.exists():
   108	            store_paths.append(sp)
   109	    return store_paths
   110	
   111	
   112	def _resolve_stores(ast: Any, vertex_path: Path) -> list[Path]:
   113	    """Resolve store paths from combine or discover."""
   114	    if ast.combine is not None:
   115	        return _resolve_combine_stores(ast, vertex_path)
   116	    if ast.discover is not None:
   117	        return _resolve_discover_stores(ast, vertex_path)
   118	    return []
