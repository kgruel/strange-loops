  1229	def parse_journal_lines(lines: Iterable[str]) -> JournalRead:
  1230	    """Read a journal from its raw lines. Pure — no filesystem.
  1231	
  1232	    The pure half is separate so the conformance vectors can hand it raw log
  1233	    lines and so every read rule is testable without a temporary directory.
  1234	
  1235	    **Every line this build cannot use is skipped and reported, wherever it
  1236	    sits** — which is half of what makes a read incomplete
  1237	    (:class:`HeadLowerBound`); a missing header is the other half. The
  1238	    earlier design distinguished a torn final line from damage further up and
  1239	    refused the latter, on the reasoning that skipping could silently lower
  1240	    *K*. Skipping CAN lower *K* — concurrent writers journal out of order, so
  1241	    the epoch maximum is not the last line and damage anywhere can take it
  1242	    (``finding:s3wp1-epoch-ordinals-do-not-ascend-in-file-order``). But
  1243	    refusing was the wrong answer to it. It made an ordinary crash a permanent
  1244	    incident, and it claimed a protection this location cannot deliver: anyone
  1245	    who can corrupt a line here can delete the whole journal instead and be
  1246	    met with trust-on-first-use. So the loss is **carried in the result type**
  1247	    — :class:`HeadLowerBound` — rather than converted into a verdict, and the
  1248	    positional rule dissolves along with the distinction it enforced.
  1249	
  1250	    **This function never refuses on structure.** Entries with no recognized
  1251	    header are tolerated too: the entries are self-describing evidence that
  1252	    heads were accepted, so what is lost — the protocol and wire versions the
  1253	    hashes derive under — weakens the claim to :class:`HeadLowerBound` rather
  1254	    than voiding the file. The absence is reported without a line number,
  1255	    because an absence does not have one. Only
  1256	    :class:`JournalEquivocation` is raised from here, and it is a statement
  1257	    about the journal's content rather than its readability.
  1258	    :class:`JournalUnreadable` belongs to :func:`read_journal`, where there
  1259	    may be no text to hand this function at all.
  1260	    """
  1261	    scanned, skips, header_seen = _scan(lines)
  1262	    positions = tuple(line for line, _entry in scanned)
  1263	    frozen = tuple(entry for _line, entry in scanned)
  1264	    if frozen and not header_seen:
  1265	        # TOLERATED, not refused. The entries are self-describing evidence
  1266	        # that heads were accepted, and a weakened claim is available — so
  1267	        # refusing the file would be a verdict where a bound would do, which
  1268	        # is the error `HeadUnreadable` was added to correct. What is lost is
  1269	        # the protocol and wire versions the hashes derive under, and losing
  1270	        # that is exactly what a lower bound is for. Reported without a line
  1271	        # number because an absence does not have one.
  1272	        # STRUCTURAL, so no line and no exemption from weight: the header
  1273	        # would be line 1 and would sit below every boundary, but its absence
  1274	        # is a claim about the FILE rather than a line an operator decreed
  1275	        # past. Reported without a line number because an absence does not
  1276	        # have one — which is exactly what marks it structural here.
  1277	        skips.missed(
  1278	            "header: absent, so the protocol and wire versions these record "
  1279	            "hashes derive under are unknown"
  1280	        )
  1281	    epoch, boundary, epoch_notes = _epoch_of(frozen, positions)
  1282	    for line, note in epoch_notes:
  1283	        # A voided reset KEEPS its cause-weight, ruled narrowly: the content of
  1284	        # the line is known, but what the operator INTENDED by it is not, and
  1285	        # that uncertainty is exactly what a bound represents.
  1286	        #
  1287	        # Its position is carried for uniformity, and it never exempts anything:
  1288	        # `_epoch_of` walks BACKWARD and returns at the first valid reset, so
  1289	        # every note it produces comes from a reset ABOVE the boundary by
  1290	        # construction. A failed attempt followed by a successful re-run still
  1291	        # heals — but through the walk short-circuiting past it, not through
  1292	        # this weighting. Stated because a comment claiming the weighting does
  1293	        # that work would describe a path nothing can reach.
  1294	        skips.missed(note, line=line)
  1295	    weakening = skips.weakening(boundary)
  1296	    best = _known_of(epoch)
  1297	    known: EstablishedHead | HeadLowerBound | HeadUnreadable | None
  1298	    if best is not None:
  1299	        known = (
  1300	            HeadLowerBound(at_least=best, skipped=weakening)
  1301	            if weakening
  1302	            else EstablishedHead(entry=best)
  1303	        )
  1304	    elif weakening:
  1305	        # Content was claimed and none of it could be read. NOT first contact.
  1306	        known = HeadUnreadable(skipped=weakening)
  1307	    else:
  1308	        known = None
  1309	    return JournalRead(
  1310	        entries=frozen,
  1311	        epoch=epoch,
  1312	        known=known,
  1313	        bootstrap=frozen[0] if frozen else None,
  1314	        skipped=tuple(skips.all),
  1315	    )
