    22	# Backdated ts against append order: fact ids ascend with rowid, ts does NOT.
    23	# Row 0 lands first but carries the LATEST ts, so arrival order and (ts, id)
    24	# order disagree on every adjacent pair — the fixture discriminates.
    25	_INTERLEAVED = [
    26	    {"id": "F0", "kind": "decision", "ts": 4000.0, "payload": {"topic": "t", "seq": 0}},
    27	    {"id": "F1", "kind": "decision", "ts": 1000.0, "payload": {"topic": "t", "seq": 1}},
    28	    {"id": "F2", "kind": "decision", "ts": 3000.0, "payload": {"topic": "t", "seq": 2}},
    29	    {"id": "F3", "kind": "decision", "ts": 2000.0, "payload": {"topic": "t", "seq": 3}},
    30	]
    31	
    32	_ARRIVAL_IDS = ["F0", "F1", "F2", "F3"]
    33	_TS_IDS = ["F1", "F3", "F2", "F0"]
