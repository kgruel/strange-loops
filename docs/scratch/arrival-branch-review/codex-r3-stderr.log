   270	# ---------------------------------------------------------------------------
   271	# Grammar: validation, hashing, codec
   272	# ---------------------------------------------------------------------------
   273	
   274	
   275	def _canonical_bytes(obj: dict) -> bytes:
   276	    """Canonical encoding for hashing: JCS, RFC 8785.
   277	
   278	    The same canonicalization every commitment in this codebase hashes
   279	    through. It is a total function on the JSON value, so any conforming
   280	    implementation in any language derives the same bytes — which is what a
   281	    cross-language conformance oracle needs and why JCS was adopted.
   282	    """
   283	    return rfc8785.dumps(obj)
   284	
   285	
   286	def _bad(message: str) -> NoReturn:
   287	    """Refuse a record. ``NoReturn`` is load-bearing, not decoration: the
   288	    validators below call this instead of raising inline, and without it a
   289	    reader — human or type checker — cannot see that the checks are total,
   290	    so every subsequent use of the value looks conditional."""
   291	    raise ArrivalGrammarError(message)
   292	
   293	
   294	def _is_int(value: object) -> TypeGuard[int]:
   295	    """A JSON integer. ``bool`` is excluded: ``True`` is an ``int`` in Python
   296	    and would silently pass an ordinal check while encoding as ``true``."""
   297	    return isinstance(value, int) and not isinstance(value, bool)
   298	
   299	
   300	def _check_hex(value: object, field: str) -> None:
   301	    if not isinstance(value, str) or len(value) != 64 or not set(value) <= _HEX:
   302	        _bad(f"{field} must be a 64-char lowercase sha256 hex digest, got {value!r}")
   303	
   304	
   305	def _check_jcs_number(value: object, field: str) -> None:
   306	    """Hold a number to what JCS can canonicalize.
   307	
   308	    Integers outside the 2^53 domain and non-finite floats have no canonical
   309	    form, so a record carrying one could never be hashed.
   310	    """
   311	    if _is_int(value):
   312	        if not _JCS_INT_MIN <= value <= _JCS_INT_MAX:
   313	            _bad(f"{field} {value} is outside the JCS integer domain")
   314	        return
   315	    if isinstance(value, float):
   316	        if not math.isfinite(value):
   317	            _bad(f"{field} must be a finite number, got {value!r}")
   318	        return
   319	    _bad(f"{field} must be a number, got {type(value).__name__}")
   320	
   321	
   322	def _check_body(body: object) -> None:
   323	    """``body`` is a JSON object, and one JCS can canonicalize.
   324	
   325	    A named departure from the line codec, which carries payload as verbatim
   326	    TEXT so that two custody holders cannot disagree byte-wise. In the
   327	    arrival model there is no second copy — the log IS the store — so there
   328	    is no other byte-form to disagree with, and JCS defines the canonical
   329	    bytes. Keeping the body an opaque string would double every escape,
   330	    make the file unreadable by eye, and leave the canonical bytes defined
   331	    by whichever encoder happened to produce the string.
   332	    """
   333	    if not isinstance(body, dict):
   334	        _bad(f"body must be a JSON object, got {type(body).__name__}")
   335	    try:
   336	        _canonical_bytes(body)
   337	    except Exception as exc:  # rfc8785 raises its own family
   338	        _bad(f"body is not canonicalizable under JCS: {exc}")
   339	
   340	
   341	def _validate(record: object, *, require_rh: bool) -> None:
   342	    """The one grammar validator, run in both directions.
   343	
   344	    ``require_rh`` is False while building a record (``rh`` is computed from
   345	    the validated object) and True for anything read back off disk.
   346	
   347	    Takes ``object``, not ``dict``, and the annotation is doing real work:
   348	    :func:`decode_record` hands this whatever ``json.loads`` produced, which
   349	    may be a list or a string, and the first check below is what refuses
   350	    those. Narrowing the signature to ``dict`` would make that check look
   351	    dead to a reader and to a type checker while it stayed live at runtime.
   352	    """
   353	    if not isinstance(record, dict):
   354	        _bad(f"a record must be a JSON object, got {type(record).__name__}")
   355	
   356	    unknown = sorted(set(record) - _ALLOWED)
   357	    if unknown:
   358	        _bad(f"unknown record field(s): {', '.join(unknown)}")
   359	    missing = [f for f in RECORD_FIELDS if f not in record]
   360	    if missing:
   361	        _bad(f"missing record field(s): {', '.join(missing)}")
   362	    if require_rh and _RH not in record:
   363	        _bad("missing record field: rh")
   364	
   365	    if not _is_int(record["v"]) or record["v"] != GRAMMAR_VERSION:
   366	        _bad(f"unsupported grammar version {record['v']!r} (this build writes {GRAMMAR_VERSION})")
   367	
   368	    if not isinstance(record["lin"], str) or not record["lin"]:
   369	        _bad("lin must be a non-empty string")
   370	
   371	    if not _is_int(record["ord"]) or record["ord"] < 0:
   372	        _bad(f"ord must be an integer >= 0, got {record['ord']!r}")
   373	    _check_jcs_number(record["ord"], "ord")
   374	
   375	    # prev is null exactly at ordinal 0 and a digest everywhere else. Both
   376	    # directions are checked: a genesis carrying a prev is as wrong as a
   377	    # successor carrying none.
   378	    if record["ord"] == 0:
   379	        if record["prev"] is not None:
   380	            _bad("prev must be null at ordinal 0")
   381	    else:
   382	        _check_hex(record["prev"], "prev")
   383	
   384	    _check_jcs_number(record["at"], "at")
   385	
   386	    if not isinstance(record["k"], str) or not record["k"]:
   387	        _bad("k must be a non-empty string")
   388	    if not isinstance(record["observer"], str) or not record["observer"]:
   389	        _bad("observer must be a non-empty string")
   390	    if not isinstance(record["origin"], str):
   391	        _bad(f"origin must be a string (may be empty), got {type(record['origin']).__name__}")
   392	
   393	    _check_body(record["body"])
   394	
   395	    # Absent, never null: a record with no signature and a record with
   396	    # ``"sig":null`` must not both be spellable, or they hash differently
   397	    # while meaning the same thing.
   398	    if _SIG in record and (not isinstance(record[_SIG], str) or not record[_SIG]):
   399	        _bad("sig, when present, must be a non-empty string")
   400	
   401	    if _RH in record:
   402	        _check_hex(record[_RH], "rh")
   403	
