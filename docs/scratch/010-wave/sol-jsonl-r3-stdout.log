   423	    def _write(self, sql: str, row: tuple, line: str, is_fact: bool) -> None:
   424	        """Stage the INSERT, make the line durable, then stamp and commit.
   425	
   426	        The INSERT runs first, uncommitted: a rejected row (duplicate id from
   427	        ``id_override``, any constraint) fails before a byte reaches the log,
   428	        so a refused append can never orphan a line. Nothing is observable
   429	        until the commit, which happens strictly after the fsync.
   430	
   431	        Reconcile first: see :meth:`_reconcile`.
   432	        """
