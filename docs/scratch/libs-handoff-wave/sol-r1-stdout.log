    63	def lines(path: Path) -> list[str]:
    64	    return [ln for ln in path.read_text(encoding="utf-8").split("\n") if ln]
    65	
    66	
    67	def sqlite_fact_ids(path: Path) -> list[str]:
    68	    conn = sqlite3.connect(str(path))
    69	    try:
    70	        return [r[0] for r in conn.execute("SELECT id FROM facts ORDER BY rowid")]
    71	    finally:
    72	        conn.close()
