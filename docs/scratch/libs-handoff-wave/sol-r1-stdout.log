   205	class _VertexBoundarySpec(NamedTuple):
   206	    """One vertex-level boundary declaration.
   207	
   208	    A vertex may declare several (e.g. `session closed` and `seal`); each fires
   209	    the whole vertex independently. Specs are evaluated in declaration order —
   210	    the first one a fact satisfies fires the tick, preserving single-boundary
   211	    firing semantics per fact (one fact mints one tick, never several). See
   212	    friction:vertex-boundary-last-declaration-wins.
   213	    """
   214	
   215	    kind: str
   216	    match: tuple[tuple[str, str], ...] = ()
   217	    conditions: tuple = ()
   218	    run: str | None = None
