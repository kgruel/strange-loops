   772	def _epoch_of(
   773	    entries: tuple[HeadAttestation, ...],
   774	) -> tuple[HeadAttestation, ...]:
   775	    """The entries in the current trust epoch, reset-INCLUSIVE.
   776	
   777	    Epoch scoping is what keeps the ceremony and the max-ordinal rule from
   778	    deadlocking each other. After an operator accepts a restore from ordinal
   779	    100 back to 90, the abandoned entries at 91-100 still hold the maximum
   780	    ordinal; unscoped, *K* would read as the head that was deliberately
   781	    abandoned and every subsequent open would refuse a rollback forever. Those
   782	    entries are retained as **evidence, not as claims** — which is the whole
   783	    point of recording the gap.
   784	
   785	    **Inclusive of the reset entry**, not merely the entries after it. The
   786	    reset entry carries the head the operator accepted; scoping it out would
   787	    leave a just-reset journal with an empty epoch, *K* of None, and a next
   788	    open classifying first contact — the deadlock's mirror image, and silent
   789	    re-acceptance by a different route.
   790	    """
   791	    for index in range(len(entries) - 1, -1, -1):
   792	        if entries[index].kind is Kind.TRUST_RESET:
   793	            return entries[index:]
   794	    return entries
