   145	def _walk_from(reader: StoreReader, order: str, page_size: int, page: FactPage) -> list[dict]:
   146	    items: list[dict] = []
   147	    while page.truncated:
   148	        kw = {"before" if order == "newest" else "after": page.next}
   149	        page = reader.query_facts(limit=page_size, order=order, **kw)
   150	        items.extend(page.items)
   151	    return items
