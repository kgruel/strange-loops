  1982	def _reset_away_from(tmp_path: Path, keep: int = 1):
  1983	    """A store reset back from its head, and the authentic backup of that head.
  1984	
  1985	    Returns (log_path, lineage, abandoned_head, backup_bytes). The backup is
  1986	    the REAL pre-reset store — nothing forged, which is the whole difficulty:
  1987	    its chain verifies perfectly and it descends honestly from the decreed
  1988	    head. Only the decree makes it unacceptable.
  1989	    """
  1990	    log_path = minted(tmp_path / "s.arrival")
  1991	    append_legacy(log_path, "one", "two")
  1992	    lineage = lineage_of(log_path)
  1993	    abandoned = FileLedger(ArrivalLog(log_path)).verify(Open())
  1994	    backup = log_path.read_bytes()
  1995	
  1996	    opened(log_path)  # first contact at the pre-reset head: it is now journaled
  1997	    truncate_records(log_path, keep=keep)
  1998	    restored = FileLedger(ArrivalLog(log_path)).verify(Open())
  1999	    trust_reset(
  2000	        accepted=restored,
  2001	        abandoned=abandoned,
  2002	        refused=abandoned,
  2003	        reason="restored from the archive after the incident",
  2004	        location=str(log_path),
  2005	        observed_at=5000.0,
  2006	    )
  2007	    return log_path, lineage, abandoned, backup
