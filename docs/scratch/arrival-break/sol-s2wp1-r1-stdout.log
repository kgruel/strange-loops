   287	def test_append_translates_only_the_cas_refusal(ledger):
   288	    """StaleHead becomes HeadMismatch; a placement fault does not.
   289	
   290	    The reason StaleHead exists. ``AppendRejected`` covers both, and an
   291	    adapter that mapped the parent would be claiming a head mismatch about a
   292	    record that was refused for its shape.
   293	    """
