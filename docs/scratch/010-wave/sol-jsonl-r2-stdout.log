   431	def test_integral_timestamps_stay_synced_across_opens(tmp_path):
   432	    """sqlite REAL affinity must not read as corruption.
   433	
   434	    An int ts in the line comes back as a float from sqlite; comparing
   435	    re-serialized text made that look like divergence, so every open
   436	    rebuilt the entire index and the WARNING became the steady state.
   437	    """
   438	    store = open_store(tmp_path)
   439	    store.append(Fact.of("note", "kyle", ts=1700000000, message="int ts"))
   440	    store.close()
   441	
   442	    for _ in range(3):
