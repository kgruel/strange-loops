  1354	def _resolve_vertex_for_dispatch(name: str) -> Path | None:
  1355	    """Try to resolve a name as a vertex for CLI dispatch. Returns None to fall through.
  1356	
  1357	    Resolution chain (local instance wins over config template):
  1358	    1. Path-like strings (.vertex suffix, ./ or / prefix) — resolve directly if file exists
  1359	    2. Local: .loops/name.vertex
  1360	    3. Local: cwd/name.vertex
  1361	    4. Config-level: LOOPS_HOME/name/name.vertex
  1362	    5. Combine alias: parent/alias → parent's combine child with that alias
  1363	    """
  1364	    if name.endswith(".vertex") or name.startswith("./") or name.startswith("/"):
  1365	        p = Path(name)
  1366	        if p.exists():
  1367	            return p.resolve()
  1368	        return None
  1369	
  1370	    # Local .loops/
  1371	    local = Path.cwd() / ".loops" / f"{name}.vertex"
  1372	    if local.exists():
  1373	        return local.resolve()
  1374	
  1375	    # Local cwd
  1376	    local = Path.cwd() / f"{name}.vertex"
  1377	    if local.exists():
  1378	        return local.resolve()
  1379	
  1380	    # Config-level resolution
  1381	    from lang.population import resolve_vertex
  1382	
  1383	    candidate = resolve_vertex(name, loops_home())
  1384	    if candidate.exists():
  1385	        return candidate.resolve()
  1386	
  1387	    # Combine alias: project/loops → resolve "project" then find child "loops"
  1388	    # Combine vertices live at config level, so we try both local and
  1389	    # config-level resolution for the parent.
  1390	    if "/" in name:
  1391	        parent_name, child_alias = name.split("/", 1)
  1392	
  1393	        # Try local resolution first (might be a local combine vertex)
  1394	        parent = _resolve_vertex_for_dispatch(parent_name)
  1395	        if parent is not None:
  1396	            child = _resolve_combine_child(parent, child_alias)
  1397	            if child is not None:
  1398	                return child
  1399	
  1400	        # Try config-level explicitly (combine vertices typically live here)
  1401	        config_parent = resolve_vertex(parent_name, loops_home())
  1402	        if config_parent.exists() and (parent is None or config_parent.resolve() != parent):
  1403	            child = _resolve_combine_child(config_parent.resolve(), child_alias)
  1404	            if child is not None:
  1405	                return child
  1406	
  1407	    return None
