    57	        if not lib_dir.is_dir():
    58	            continue
    59	        allowed = _LIB_ALLOWED_RUNTIME.get(lib_name, set())
    60	        for py_file in _src_py_files(lib_dir):
    61	            collector = _collect_imports(py_file)
    62	            for other_lib in LIBS:
    63	                if other_lib == lib_name:
    64	                    continue
    65	                if other_lib in allowed:
    66	                    continue
    67	                lines = _imports_module(collector.runtime_modules, other_lib)
    68	                for lineno in lines:
