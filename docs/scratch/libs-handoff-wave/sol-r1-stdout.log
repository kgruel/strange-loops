from lang import edit_vertex_kind, remove_vertex_kind, loop_def_to_kdl
from lang.ast import LoopDef, FoldDecl, FoldBy, Split

text = 'name \"t\"\\nloops { decision { fold { items \"by\" \"topic\" } } task { fold { items \"by\" \"name\" } } }\\n'
basic = LoopDef(folds=(FoldDecl('items', FoldBy('topic')),))
for op in (lambda: edit_vertex_kind(text, 'decision', basic), lambda: remove_vertex_kind(text, 'decision')):
    try:
        op()
    except Exception as exc:
        print(type(exc).__name__, str(exc).split(':')[0])
parse_def = LoopDef(folds=basic.folds, parse=(Split(','),))
try:
    loop_def_to_kdl('csv', parse_def)
except Exception as exc:
    print(type(exc).__name__, str(exc))
