  1499	def test_a_replayed_advance_cannot_reimport_an_abandoned_head():
  1500	    """The acceptance vector, and why direction was the wrong thing to judge by.
  1501	
  1502	    Re-appending an ``advance`` from before a reset used to raise *K* to an
  1503	    abandoned head. I classified that as safe because *K* moved UP, and refused
  1504	    more. That was the wrong axis. The head *K* then named was GENUINE — a real
  1505	    head this machine really did accept — so a store restored from the pre-reset
  1506	    backup presents it exactly, compares EQUAL, and the unchanged arm does no
  1507	    descent verification by design. The ceremonially abandoned state opened
  1508	    silently. A wrongly-raised *K* naming a real abandoned head is a landing
  1509	    pad, not a wall.
  1510	
  1511	    The byte-duplicate gate closes it at the source: the replayed line is
  1512	    literal bytes this journal already holds, so it re-asserts rather than
  1513	    records, and *K* never moves.
  1514	    """
  1515	    _journal_reset_at_5_then_advanced_to_8()
  1516	    assert read_journal(LINEAGE).established_head().head.ordinal == 8
  1517	
  1518	    append_entry(observation(10))  # an abandoned head, re-asserted verbatim
  1519	
  1520	    result = read_journal(LINEAGE)
  1521	    assert any("byte-identical" in note for note in result.skipped)
  1522	    assert isinstance(result.known, EstablishedHead)
  1523	    known = result.established_head()
  1524	    assert known.head.ordinal == 8, "K reached an abandoned head"
  1525	    # And the restored abandoned backup is no longer equal to what is
  1526	    # remembered — it is now a REWRITE, refused on a full comparison rather
  1527	    # than declined on a bound.
  1528	    assert known.head != head(10)
  1529	    assert compare(known, head(10), None) is Outcome.REWRITE
