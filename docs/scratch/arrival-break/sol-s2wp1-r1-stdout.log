    83	    "jsonl_offset": "the retired offset meta key",
    84	    "jsonl_fact_count": "the retired count meta key",
    85	    "jsonl_tick_count": "the retired count meta key",
    86	    "receipt_order": "ordering is by ordinal, not by an order concept",
    87	    # Added at cut B, which retires the R1 doctrine whose vocabulary was "the
