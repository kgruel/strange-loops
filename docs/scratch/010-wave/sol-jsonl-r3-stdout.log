   428	    def _write(self, sql: str, row: tuple, line: str, is_fact: bool) -> None:
   429	        """Stage the INSERT, make the line durable, then stamp and commit.
   430	
   431	        The INSERT runs first, uncommitted: a rejected row (duplicate id from
   432	        ``id_override``, any constraint) fails before a byte reaches the log,
   433	        so a refused append can never orphan a line. Nothing is observable
   434	        until the commit, which happens strictly after the fsync.
   435	
   436	        Reconcile first: see :meth:`_reconcile`.
   437	        """
   438	        self._reconcile()
   439	        try:
   440	            self._conn.execute(sql, row)
   441	            # The INSERT has taken sqlite's write lock, so the committed
   442	            # markers read here cannot be raced by another handle: whatever
   443	            # a concurrent writer stamped is already visible, and nothing
   444	            # further can land until we commit or roll back. Increment from
   445	            # that committed value — never from a per-handle cache, which
   446	            # would stamp a stale count over another writer's correct one
   447	            # and brick the store on the next open.
   448	            marked = self._marked_counts()
   449	            if marked is None:
   450	                facts, ticks = self._row_counts()  # pre-marker store: adopt
   451	            else:
   452	                facts, ticks = marked
   453	                facts += 1 if is_fact else 0
   454	                ticks += 0 if is_fact else 1
   455	            offset = self._append_line(line)
   456	            self._stamp(offset, facts, ticks)
   457	            self._conn.commit()
   458	        except BaseException:
   459	            self._conn.rollback()
   460	            raise
