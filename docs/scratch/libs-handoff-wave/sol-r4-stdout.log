    84	def resolve_vertex(name_or_path: str, home: Path) -> Path:
    85	    """Name or path -> .vertex file path.
    86	
    87	    - Has .vertex extension -> use as-is
    88	    - Starts with . or / -> use as-is (filesystem path)
    89	    - Otherwise -> home / name / name.vertex
    90	    """
    91	    from pathlib import Path
    92	    if (
    93	        name_or_path.endswith(".vertex")
    94	        or name_or_path.startswith("./")
    95	        or name_or_path.startswith("/")
    96	    ):
    97	        return Path(name_or_path)
    98	    return home / name_or_path / f"{Path(name_or_path).name}.vertex"
