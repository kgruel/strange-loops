    94	def emit_fact(path: Path, kind: str, obs: str, payload: dict) -> None:
    95	    """Emit a fact into a store."""
    96	    from atoms import Fact
    97	
    98	    fact = Fact.of(kind, obs, **payload)
    99	    with _open_store(path, Fact.to_dict, Fact.from_dict) as store:
   100	        store.append(fact)
