    29	def _open(tmp_path: Path, log: Path) -> JsonlStore:
    30	    """A store over a COPY of the fixture — fixtures are read-only evidence."""
    31	    copied = tmp_path / log.name
    32	    shutil.copyfile(log, copied)
    33	    return JsonlStore(
    34	        path=tmp_path / (log.stem + ".db"),
    35	        log_path=copied,
    36	        serialize=lambda f: f.to_dict(),
    37	        deserialize=Fact.from_dict,
    38	    )
