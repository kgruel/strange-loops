   209	def _tick_row_hash(row: tuple) -> str:
   210	    """Era-aware identity hash — what the successor's prev_hash commits to.
   211	
   212	    Includes the signature key only when the row carries one, so every
   213	    pre-signature row (and every pre-chain row) hashes byte-identically to
   214	    delta 1 — no re-anchoring. For signed rows the successor chains over
   215	    content+signature, making signature-stripping a detectable break
   216	    (design/tick-signature-in-chain-envelope).
   217	    """
   218	    envelope = _tick_envelope(row)
   219	    if len(row) > 10 and row[10] is not None:
   220	        envelope["signature"] = row[10]
   221	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
