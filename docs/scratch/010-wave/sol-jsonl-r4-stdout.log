   124	def parse_duration(s: str) -> float:
   125	    """Parse duration string like '7d', '24h', '1h' to seconds."""
   126	    m = re.match(r"^(\d+)([dhms])$", s)
   127	    if not m:
   128	        raise ValueError(f"Invalid duration: {s!r} (expected e.g. '7d', '24h', '1h')")
   129	    value = int(m.group(1))
   130	    unit = m.group(2)
   131	    multipliers = {"d": 86400, "h": 3600, "m": 60, "s": 1}
   132	    return value * multipliers[unit]
