    47	def _loops_home() -> Path:
    48	    """Resolve the loops config directory (same convention as CLI)."""
    49	    if env := os.environ.get("LOOPS_HOME"):
    50	        return Path(env)
    51	    xdg = os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))
    52	    return Path(xdg) / "loops"
