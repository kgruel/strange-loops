   102	class CeremonyError(Exception):
   103	    """A ceremony input that cannot be classified — malformed, not stale."""
   104	
   105	
   106	class IntentCorrupt(CeremonyError):
   107	    """An intent file exists but does not decode to a CURRENT intent record.
   108	
   109	    Recovery refuses rather than guessing: a corrupt intent is evidence of a
