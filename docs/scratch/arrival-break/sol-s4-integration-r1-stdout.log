   181	def test_rule_19_allowlist_is_minimal():
   182	    """Assert every entry in _ALLOWLIST corresponds to an active undeclared import violation.
   183	
   184	    The allowlist is shrink-only: an entry must be an actual import AND must still be
   185	    undeclared in its package dependencies (or dev group for test files). If an import is
   186	    properly declared in pyproject.toml, its allowlist entry is redundant and fails the test.
   187	    """
   188	    stale: list[str] = []
   189	    for rel_path, module in sorted(_ALLOWLIST):
   190	        target = REPO_ROOT / rel_path
   191	        if not target.exists():
   192	            stale.append(f"  {rel_path}: file no longer exists")
   193	            continue
   194	        collector = _collect_imports(target)
   195	        imported_tops = {m.split(".")[0] for m, _ in collector.runtime_modules}
   196	        if module not in imported_tops:
   197	            stale.append(f"  {rel_path}: {module!r} is no longer imported")
   198	            continue
   199	
   200	        parts = Path(rel_path).parts
   201	        if len(parts) >= 2 and parts[0] in ("libs", "apps"):
   202	            pkg_dir = REPO_ROOT / parts[0] / parts[1]
   203	            is_test = "tests" in parts
   204	            declared = _get_package_declared_modules(pkg_dir, include_dev=is_test)
   205	            if is_test:
   206	                declared.add("pytest")
   207	                declared.add("_pytest")
   208	            if module in declared:
   209	                stale.append(
   210	                    f"  {rel_path}: {module!r} is declared in {pkg_dir.name}/pyproject.toml "
   211	                    f"(allowlist entry is redundant and must be removed)"
   212	                )
