   307	def add_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   308	    """Add a loop-kind definition to vertex text; returns the new text.
   309	
   310	    Creates the ``loops`` block (appended at end of file) when absent.
   311	    Refuses if the kind already exists. Note the one-way expand-on-insert
   312	    limitation: a single-line ``loops { ... }`` block is expanded across
   313	    lines by the insert.
   314	    """
   315	    _validate_kind_name(kind)
   316	    if _kind_exists(text, kind):
   317	        raise ValueError(f"kind {kind!r} already exists; use edit_vertex_kind")
   318	
   319	    child = loop_def_to_kdl(kind, definition)
   320	    try:
   321	        kdl_find_block(text, ["loops"])
   322	        has_loops = True
   323	    except ValueError:
   324	        has_loops = False
   325	    if has_loops:
   326	        result = kdl_insert_child(text, ["loops"], child)
   327	    else:
   328	        # No loops block — create one at end of file.
   329	        indented = "\n".join(
   330	            ("  " + ln) if ln.strip() else ln for ln in child.splitlines()
   331	        )
   332	        block = f"loops {{\n{indented}\n}}\n"
   333	        if text and not text.endswith("\n"):
   334	            text += "\n"
   335	        result = text + block
   336	    return _validated(result, f"add_vertex_kind({kind!r})")
