   379	
   380	def _sqlite_busy(exc: BaseException) -> bool:
   381	    """Is this sqlite error a transient BUSY/LOCKED, not damage?
   382	
   383	    Primary evidence is the error code (``SQLITE_BUSY`` 5 / ``SQLITE_LOCKED``
   384	    6, low byte of any extended code); the message substring is the fallback
   385	    for wrappers that lose the code.
   386	    """
   387	    code = getattr(exc, "sqlite_errorcode", None)
   388	    if code is not None:
   389	        return (code & 0xFF) in (5, 6)
   390	    return "database is locked" in str(exc) or "database table is locked" in str(exc)
   391	
