   432	                f"{case.name}: atoms totalize disagrees with the production combined "
   433	                f"read under {case.ordering!r} — totalize {lens_order}, "
   434	                f"vertex_facts {production_order}. This is a finding, not a regeneration."
   435	            )
   436	        return {"lens_order": production_order}
