   135	# 3. The handle runs under the licensed variant
   136	
   137	
   138	#: The Ordering the fold path runs under. Single-store fold order IS receipt
   139	#: order, which is exactly Arrival's native per-store order (Rule 17).
   140	FOLD_ORDERING: Ordering = Arrival()
   141	
   142	
   143	_VERTEX_KDL = '''name "t"
   144	store "{store}"
   145	loops {{
   146	  decision {{ fold {{ items "by" "topic" }} }}
   147	}}
   148	observers {{
   149	  kyle {{ key "AAAA" }}
   150	}}
   151	'''
   152	
   153	
   154	def _scaffold(tmp_path: Path) -> tuple[Path, Path]:
   155	    store = tmp_path / "store.db"
   156	    vpath = tmp_path / "t.vertex"
   157	    vpath.write_text(_VERTEX_KDL.format(store=store))
   158	    conn = sqlite3.connect(str(store))
   159	    conn.execute(
   160	        "CREATE TABLE IF NOT EXISTS facts (id TEXT PRIMARY KEY, kind TEXT, ts REAL,"
   161	        " observer TEXT, origin TEXT, payload TEXT, signature TEXT)"
   162	    )
   163	    conn.execute(
   164	        "CREATE TABLE IF NOT EXISTS ticks (id TEXT PRIMARY KEY, name TEXT, ts REAL,"
   165	        " payload TEXT)"
   166	    )
   167	    conn.commit()
   168	    conn.close()
   169	    return vpath, store
   170	
   171	
   172	def _append(store: Path, ts: float, **payload: Any) -> None:
   173	    import json
   174	
   175	    conn = sqlite3.connect(str(store))
   176	    conn.execute(
   177	        "INSERT INTO facts (id, kind, ts, observer, origin, payload, signature)"
   178	        " VALUES (?, ?, ?, ?, ?, ?, ?)",
   179	        (gen_id(), "decision", ts, "kyle", "", json.dumps(payload), ""),
   180	    )
   181	    conn.commit()
   182	    conn.close()
   183	
   184	
   185	def test_handle_takes_the_warm_path_under_the_licensed_ordering(tmp_path: Path) -> None:
   186	    """The licence is not theoretical: the fold path runs under Arrival, and
   187	    the handle's warm refresh is the checkpoint that licence permits.
   188	
   189	    The backdated append is the discriminator — it would be an insertion under
   190	    ByKey('ts'), and the handle still folds it as a suffix, which is only sound
   191	    because the fold ordering is Arrival."""
   192	    assert is_suffix_stable(FOLD_ORDERING), (
   193	        "the fold path's ordering must license the checkpoint the handle takes"
   194	    )
   195	
   196	    vpath, store = _scaffold(tmp_path)
   197	    with open_vertex(vpath) as handle:
   198	        _append(store, 300.0, topic="t", position="first_arrival")
   199	        handle.refresh()
   200	
   201	        _append(store, 100.0, topic="t", position="backdated_but_later_arrival")
   202	        batch = handle.refresh()
   203	
   204	        assert batch is not None
   205	        assert batch.replay_mode == "checkpoint-suffix"

