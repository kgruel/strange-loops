  1666	def make_fidelity_fetcher(path: Path):
  1667	    """Create a fetcher for fidelity drill data.
  1668	
  1669	    Returns a callable (since_ts, until_ts, kind?) -> list[dict].
  1670	    Each call opens and closes its own StoreReader — the TUI calls this
  1671	    on-demand when the user presses 'f', not on every frame.
  1672	    """
  1673	    def fetch(since_ts: float, until_ts: float, kind: str | None = None) -> list[dict]:
  1674	        from engine.store_reader import StoreReader
  1675	
  1676	        store_path = resolve_store_path(path)
  1677	        with StoreReader(store_path) as reader:
  1678	            return reader.facts_between(since_ts, until_ts, kind=kind)
  1679	    return fetch

