   945	def _known_of(epoch: tuple[HeadAttestation, ...]) -> HeadAttestation | None:
   946	    """*K*: the maximum-ordinal entry of the epoch, not the last line.
   947	
   948	    Two writers append concurrently — the arrival lock serializes their
   949	    *appends*, not their journal writes — so lines can land out of order: A
   950	    commits ordinal 5, B commits 6 and journals it, A journals 5 last.
   951	    Last-line semantics would then read K=5 and classify a genuine restore to
   952	    5 as unchanged. Maximum-ordinal closes it, and duplicate entries at one
   953	    ordinal are harmless.
   954	    """
   955	    if not epoch:
   956	        return None
   957	    best = max(epoch, key=lambda entry: entry.head.ordinal)
   958	    tied = {
   959	        entry.head.record_hash
   960	        for entry in epoch
   961	        if entry.head.ordinal == best.head.ordinal
   962	    }
   963	    if len(tied) > 1:
   964	        raise JournalEquivocation(
   965	            f"journal holds {len(tied)} different records at ordinal "
   966	            f"{best.head.ordinal} in the current trust epoch: "
   967	            f"{', '.join(sorted(tied))}"
   968	        )
   969	    return best
