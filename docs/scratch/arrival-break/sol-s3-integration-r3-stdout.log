  1214	    computation. That is not an optimization — see :func:`_scan`.
  1215	    """
  1216	    try:
  1217	        text = journal_path(lineage).read_text(encoding="utf-8")
  1218	    except FileNotFoundError:
  1219	        return None
  1220	    except (OSError, UnicodeDecodeError) as exc:
  1221	        raise JournalUnreadable(
  1222	            f"the journal for lineage {lineage!r} exists but cannot be read "
  1223	            f"as text at all: {exc}"
  1224	        ) from exc
  1225	    scanned, _skips, _header = _scan(text.splitlines(keepends=True))
  1226	    return scanned[-1] if scanned else None
