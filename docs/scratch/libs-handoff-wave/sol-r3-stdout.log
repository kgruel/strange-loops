   165	def cursor_fact_summary(conn, fact_id: str) -> dict:
   166	    """Resolve a fact_cursor id to a terse summary of its target fact.
   167	
   168	    Read-path affordance, NOT part of any commitment — the chain commits
   169	    to ids and hashes; this is the human-facing dereference. Returns
   170	    ``{"cursor_kind": str, "cursor_preview": str}``. An empty cursor
   171	    resolves to empty fields; a dangling cursor (fact deleted) is named
   172	    explicitly rather than silently blank — verify reports that case as
   173	    a break, but read paths still render honestly.
   174	    """
   175	    if not fact_id:
   176	        return {"cursor_kind": "", "cursor_preview": ""}
   177	    row = conn.execute(
   178	        "SELECT kind, payload FROM facts WHERE id = ?", (fact_id,)
   179	    ).fetchone()
   180	    if row is None:
   181	        return {"cursor_kind": "", "cursor_preview": "(cursor fact missing)"}
   182	    try:
   183	        payload = json.loads(row[1])
   184	    except (TypeError, ValueError):
   185	        payload = {}
   186	    preview = ""
   187	    if isinstance(payload, dict):
   188	        for key in ("message", "topic", "name", "status"):
   189	            val = payload.get(key)
   190	            if isinstance(val, str) and val:
   191	                preview = val
   192	                break
   193	    if len(preview) > 80:
   194	        preview = preview[:79] + "…"
   195	    return {"cursor_kind": row[0], "cursor_preview": preview}
