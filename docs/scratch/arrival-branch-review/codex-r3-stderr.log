   815	
   816	def test_gate_a_reader_never_sees_a_partial_record_and_never_truncates(tmp_path):
   817	    """Reads take no lock, so the reader must treat an unterminated tail as
   818	    possibly in flight rather than torn.
   819	
   820	    What this test can and cannot show, stated rather than assumed. Because
   821	    an append reaches disk in one write syscall (see
   822	    :func:`test_a_real_sigkill_cannot_tear_an_append`), a concurrent reader
   823	    on this platform never actually observes a partial record — so the
   824	    "never sees a partial record" half is confirmed here rather than
   825	    stressed. What this test does exercise for real is that an unlocked
   826	    reader running against live writers always sees a dense, intact prefix
   827	    and never shortens the file.
   828	
   829	    The other half — that a reader handed an unterminated tail leaves it
   830	    alone instead of consuming or cutting it — is deterministic and lives in
   831	    :func:`test_the_read_path_leaves_a_torn_tail_alone`, which plants the
   832	    partial bytes rather than hoping to catch them.
   833	    """
   834	    log = _mint(tmp_path)
   835	    writers = [
   836	        _run(_APPEND_WORKER, str(log.path), "120", f"w{n}",
   837	             tmp_path=tmp_path, name=f"live{n}")
   838	        for n in range(2)
   839	    ]
   840	
   841	    observations = []
   842	    failures: list[BaseException] = []
   843	    stop = threading.Event()
   844	
   845	    def read_loop() -> None:
   846	        try:
   847	            while not stop.is_set():
   848	                size = log.path.stat().st_size
   849	                walked = [r["ord"] for r in log.walk()]
   850	                # Dense from 0, every time, however far the writers have got.
   851	                assert walked == list(range(len(walked))), walked
   852	                # The reader must not have shortened the file.
   853	                assert log.path.stat().st_size >= size
   854	                observations.append(len(walked))
   855	        except BaseException as exc:  # surfaced on the main thread below
   856	            failures.append(exc)
   857	
   858	    reader = threading.Thread(target=read_loop)
   859	    reader.start()
   860	    for n, writer in enumerate(writers):
   861	        out, err = writer.communicate(timeout=300)
   862	        assert writer.returncode == 0, f"writer {n} failed:\n{out}\n{err}"
   863	    stop.set()
   864	    reader.join(timeout=60)
   865	
   866	    assert not failures, failures[0]
   867	    assert len(observations) > 1, "the reader never got a look at a live log"
   868	    assert observations != sorted(observations, reverse=True)  # it saw growth
   869	    _verify_by_hand(log, 2 * 120 + 1)
