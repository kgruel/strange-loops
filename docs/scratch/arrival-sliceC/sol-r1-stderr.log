   118	
   119	
   120	def _spec_for_fold_op(op: FoldOp) -> Spec:
   121	    """Construct a Spec with appropriate initial state fields for a given FoldOp."""
   122	    state_fields: list[Field] = []
   123	    if isinstance(op, (Collect, Window)):
   124	        state_fields.append(Field(name=op.target, kind="list"))
   125	    elif isinstance(op, (Upsert, TopN)):
   126	        state_fields.append(Field(name=op.target, kind="dict"))
   127	    elif isinstance(op, Count):
   128	        state_fields.append(Field(name=op.target, kind="int"))
   129	    elif isinstance(op, (Sum, Min, Max, Avg, Latest)):
   130	        state_fields.append(Field(name=op.target, kind="float"))
   131	
   132	    return Spec(
   133	        name="test_spec",
   134	        state_fields=tuple(state_fields),
   135	        folds=(op,),
   136	    )
   137	
   138	
   139	def _prepare_payloads_from_facts(fact_list: list[Fact]) -> list[dict[str, Any]]:
   140	    """Convert a list of facts into a list of dict payloads with _ts injected."""
   141	    result: list[dict[str, Any]] = []
   142	    for f in fact_list:
   143	        if isinstance(f.payload, (dict, MappingProxyType)):
   144	            p = dict(f.payload)
   145	        else:
   146	            p = {"val": f.payload, "amount": f.payload, "score": f.payload}
   147	        p["_ts"] = f.ts
   148	        result.append(p)
   149	    return result
   150	
   151	
   152	class TestFoldDeterminismProperties:
   153	    """Property tests for Spec fold computation determinism and purity."""
   154	
   155	    @settings(max_examples=200)
   156	    @given(fact_list=fact_lists(), op=fold_ops())
   157	    def test_fold_replay_determinism(self, fact_list: list[Fact], op: FoldOp) -> None:
   158	        """Replaying a fact sequence through a Spec produces identical state deterministically."""
   159	        spec = _spec_for_fold_op(op)
   160	        payloads_seq = _prepare_payloads_from_facts(fact_list)
   161	
   162	        state1 = spec.replay(payloads_seq)
   163	        state2 = spec.replay(payloads_seq)
   164	        assert state1 == state2
   165	
   166	    @settings(max_examples=200)
   167	    @given(fact_list=fact_lists(), op=fold_ops())
   168	    def test_fold_apply_equals_replay(self, fact_list: list[Fact], op: FoldOp) -> None:
   169	        """Iterative Spec.apply from initial_state produces the same final state as Spec.replay."""
   170	        spec = _spec_for_fold_op(op)
   171	        payloads_seq = _prepare_payloads_from_facts(fact_list)
   172	
   173	        replay_state = spec.replay(payloads_seq)
   174	
   175	        apply_state = spec.initial_state()
   176	        for p in payloads_seq:
   177	            apply_state = spec.apply(apply_state, p)
   178	
   179	        assert apply_state == replay_state
   180	
   181	    @settings(max_examples=200)
   182	    @given(fact=facts(), op=fold_ops())
   183	    def test_fold_apply_purity(self, fact: Fact, op: FoldOp) -> None:
   184	        """Spec.apply is pure and never mutates the input state dictionary in place."""
   185	        spec = _spec_for_fold_op(op)
   186	        payload = dict(fact.payload) if isinstance(fact.payload, dict) else {"val": fact.payload}
   187	        payload["_ts"] = fact.ts
   188	
   189	        initial = spec.initial_state()
   190	        snapshot = copy.deepcopy(initial)
   191	
   192	        _ = spec.apply(initial, payload)
   193	        assert initial == snapshot
