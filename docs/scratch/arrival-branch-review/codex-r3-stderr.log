   918	        # then misses and revalidates rather than pairing one entry's key
   919	        # with another's value.
   920	        cached_line, cached_record = self._genesis_line, self._genesis_record
   921	        if raw == cached_line and cached_record is not None:
   922	            return cached_record
   923	        record = self._validated_genesis(raw)
   924	        self._genesis_record = record
   925	        self._genesis_line = raw  # published last, so the key implies the value
   926	        return record
