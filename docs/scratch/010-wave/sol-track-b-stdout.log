func (f Min) build() FoldFn {
	return func(state, payload map[string]any) {
		v, ok := payload[f.Field]
		if !ok || v == nil {
			return
		}
		nv, isNum := asFloat(v)
		if !isNum {
			reject(state, f.Target) // off-type (bool/string) skips + counts (§4.4)
			return
		}
		cur, hasCur := asFloat(state[f.Target])
		if !hasCur || nv < cur {
			state[f.Target] = v
		}
	}
}

func (f Max) build() FoldFn {
	return func(state, payload map[string]any) {
		v, ok := payload[f.Field]
		if !ok || v == nil {
			return
		}
		nv, isNum := asFloat(v)
		if !isNum {
			reject(state, f.Target) // off-type (bool/string) skips + counts (§4.4)
			return
		}
		cur, hasCur := asFloat(state[f.Target])
		if !hasCur || nv > cur {
			state[f.Target] = v
		}
	}
}

func (f Avg) build() FoldFn {
	sumKey := f.Target + "_sum"
	countKey := f.Target + "_count"
	return func(state, payload map[string]any) {
		v, ok := payload[f.Field]
		if !ok || v == nil {
			return
		}
		nv, isNum := asFloat(v)
		if !isNum {
			// Rejected values must NOT bump the denominator — a persisted
			// _count including them would diverge from any re-fold (§4.4).
			reject(state, f.Target)
			return
		}
		s := numOr(state, sumKey, 0) + nv
		c := numOr(state, countKey, 0) + 1
		state[sumKey] = s
		state[countKey] = c
		state[f.Target] = s / c
	}
}

func (f Window) build() FoldFn {
	return func(state, payload map[string]any) {
		v, ok := payload[f.Field]
		if !ok || v == nil {
			return
		}
		items, _ := state[f.Target].([]any)
		items = append(items, v)
		if len(items) > f.Size {
			items = items[len(items)-f.Size:]
		}
		state[f.Target] = items
	}
}

// cloneMap shallow-copies a map (nil-safe). Mirrors Python dict(payload) /
// {**existing}: nested containers are shared, matching Python's shallow copy
// in the fold bodies (Spec.apply deep-copies the whole state to restore
// purity).
func cloneMap(m map[string]any) map[string]any {
	out := make(map[string]any, len(m))
	for k, v := range m {
		out[k] = v
	}
	return out
}

// BuildFold compiles a fold descriptor to a closure. Mirrors build_fold_fn.
func BuildFold(op FoldOp) FoldFn { return op.build() }
package atoms

import "fmt"

// Canonical, language-neutral op encoding (the precursor to the eventual
// schema). Both the Go decoder here and the loops repo's tools/gen_vectors.py
// build their native
// op from this same JSON shape — that agreement IS the conformance contract.
//
// Numbers arrive as float64 (encoding/json); helpers narrow them to int.

func optStr(m map[string]any, key string) *string {
	if v, ok := m[key]; ok && v != nil {
		s := asString(v)
		return &s
	}
	return nil
}

func reqStr(m map[string]any, key string) string {
	if v, ok := m[key]; ok && v != nil {
		return asString(v)
	}
	return ""
}

func optInt(m map[string]any, key string) *int {
	if v, ok := m[key]; ok && v != nil {
		if f, isNum := asFloat(v); isNum {
			n := int(f)
			return &n
		}
	}
	return nil
}

func intOr(m map[string]any, key string, def int) int {
	if p := optInt(m, key); p != nil {
		return *p
	}
	return def
}

func boolOr(m map[string]any, key string, def bool) bool {
	if v, ok := m[key]; ok {
		if b, isBool := v.(bool); isBool {
			return b
		}
	}
	return def
}

func strSlice(v any) []string {
	l, _ := v.([]any)
	out := make([]string, 0, len(l))
	for _, e := range l {
		out = append(out, asString(e))
	}
	return out
}

func strMap(v any) map[string]string {
	m, _ := v.(map[string]any)
	out := make(map[string]string, len(m))
	for k, e := range m {
		out[k] = asString(e)
	}
	return out
}

// DecodeFold builds a FoldOp from its canonical encoding.
func DecodeFold(m map[string]any) (FoldOp, error) {
	op := reqStr(m, "op")
	switch op {
	case "latest":
		return Latest{Target: reqStr(m, "target")}, nil
	case "count":
		return Count{Target: reqStr(m, "target")}, nil
	case "sum":
		return Sum{Target: reqStr(m, "target"), Field: reqStr(m, "field")}, nil
	case "collect":
		return Collect{Target: reqStr(m, "target"), Max: intOr(m, "max", 0)}, nil
	case "upsert":
		return Upsert{Target: reqStr(m, "target"), Key: reqStr(m, "key")}, nil
	case "topn":
		return TopN{Target: reqStr(m, "target"), Key: reqStr(m, "key"), By: reqStr(m, "by"), N: intOr(m, "n", 0), Desc: boolOr(m, "desc", true)}, nil
	case "min":
		return Min{Target: reqStr(m, "target"), Field: reqStr(m, "field")}, nil
	case "max":
		return Max{Target: reqStr(m, "target"), Field: reqStr(m, "field")}, nil
	case "avg":
		return Avg{Target: reqStr(m, "target"), Field: reqStr(m, "field")}, nil
	case "window":
		return Window{Target: reqStr(m, "target"), Field: reqStr(m, "field"), Size: intOr(m, "size", 0)}, nil
	default:
		return nil, fmt.Errorf("unknown fold op: %q", op)
	}
}

// DecodeFolds builds a fold pipeline from a JSON array of encoded folds.
func DecodeFolds(raw []any) ([]FoldOp, error) {
	out := make([]FoldOp, 0, len(raw))
	for _, e := range raw {
		m, ok := e.(map[string]any)
		if !ok {
			return nil, fmt.Errorf("fold descriptor is not an object: %T", e)
		}
		f, err := DecodeFold(m)
		if err != nil {
			return nil, err
		}
		out = append(out, f)
	}
	return out, nil
}

// DecodeParse builds a ParseOp from its canonical encoding.
func DecodeParse(m map[string]any) (ParseOp, error) {
	op := reqStr(m, "op")
	switch op {
	case "skip":
		return Skip{Startswith: optStr(m, "startswith"), Contains: optStr(m, "contains"), Equals: optStr(m, "equals"), Field: optStr(m, "field")}, nil
	case "split":
		return Split{Delim: optStr(m, "delim"), Max: optInt(m, "max")}, nil
	case "pick":
		idx := []int{}
		if l, ok := m["indices"].([]any); ok {
			for _, e := range l {
				if f, isNum := asFloat(e); isNum {
					idx = append(idx, int(f))
				}
			}
		}
		return Pick{Indices: idx}, nil
	case "rename":
		mapping := map[int]string{}
		if mm, ok := m["mapping"].(map[string]any); ok {
			for k, v := range mm {
				var i int
				if _, err := fmt.Sscanf(k, "%d", &i); err == nil {
					mapping[i] = asString(v)
				}
			}
		}
		return Rename{Mapping: mapping}, nil
	case "transform":
		t := Transform{Field: reqStr(m, "field"), Strip: optStr(m, "strip"), Lstrip: optStr(m, "lstrip"), Rstrip: optStr(m, "rstrip")}
		if r, ok := m["replace"].([]any); ok && len(r) == 2 {
			t.Replace = &[2]string{asString(r[0]), asString(r[1])}
		}
		return t, nil
	case "coerce":
		return Coerce{Types: strMap(m["types"])}, nil
	case "select":
		return Select{Fields: strSlice(m["fields"])}, nil
	case "explode":
		e := Explode{Path: reqStr(m, "path")}
		if c, ok := m["carry"].(map[string]any); ok {
			e.Carry = map[string]string{}
			for k, v := range c {
				e.Carry[k] = asString(v)
			}
		}
		return e, nil
	case "project":
		return Project{Fields: strMap(m["fields"])}, nil
	case "where":
		return Where{Path: reqStr(m, "path"), Op: reqStr(m, "where_op"), Value: optStr(m, "value"), Values: strSlice(m["values"])}, nil
	case "flatten":
		return Flatten{Field: reqStr(m, "field"), Into: reqStr(m, "into"), Extract: strSlice(m["extract"])}, nil
	default:
		return nil, fmt.Errorf("unknown parse op: %q", op)
	}
}

// DecodeParsePipeline builds a parse pipeline from a JSON array.
func DecodeParsePipeline(raw []any) ([]ParseOp, error) {
	out := make([]ParseOp, 0, len(raw))
	for _, e := range raw {
		m, ok := e.(map[string]any)
		if !ok {
			return nil, fmt.Errorf("parse descriptor is not an object: %T", e)
		}
		p, err := DecodeParse(m)
		if err != nil {
			return nil, err
		}
		out = append(out, p)
	}
	return out, nil
}

