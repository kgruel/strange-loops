   344	# --- inspection helpers (all read-only) -------------------------------------
   345	
   346	
   347	def _currency(canonical: Path) -> bool | None:
   348	    """Offset parity of the derived index, or None when unanswerable.
   349	
   350	    Composes ``jsonl_store._index_is_current`` (one read-only sqlite meta
   351	    read + one stat — it never constructs a store) but refuses to answer
   352	    for a missing index: "current" and "absent" must not collapse.
   353	    """
   354	    from .jsonl_store import _index_is_current
   355	
   356	    if not canonical.is_file():
   357	        return None
   358	    index = index_path_for(canonical)
   359	    if not index.is_file():
   360	        return False
   361	    return _index_is_current(index, canonical)
   362	
   363	
   364	def write_surface_reason(canonical_path: Path | str) -> str | None:
   365	    """Reason the canonical store's FULL write surface is unwritable, or None.
   366	
   367	    The surface a store-writing ceremony touches is wider than the canonical
   368	    artifact (SOL-R1-04 + SOL-R2-04): a JSONL-canonical open also writes the
   369	    derived sqlite index, and any sqlite open needs the containing directory
   370	    for its WAL/SHM siblings. Pure ``os.access`` inspection — ``_writable``
   371	    walks to the nearest existing ancestor, so a missing index counts as
   372	    creatable when its directory is writable. A location-scoped claim, never
   373	    an open-success promise. Idempotent on a ``.db`` (index == canonical).
   374	    """
   375	    canonical_path = Path(canonical_path)
   376	    if not _writable(canonical_path):
   377	        return f"canonical store not writable: {canonical_path}"
   378	    index = index_path_for(canonical_path)
   379	    if not _writable(index):
   380	        return f"derived index not writable: {index}"
   381	    if not _writable(canonical_path.parent):
   382	        return (
   383	            f"store directory not writable: {canonical_path.parent} — "
   384	            "sqlite needs it for WAL/SHM siblings"
   385	        )
   386	    return None
   387	
   388	
   389	def _writable(path: Path) -> bool:
   390	    """Filesystem writability of ``path``, or of its nearest existing ancestor."""
   391	    probe = path
   392	    while not probe.exists():
   393	        parent = probe.parent
   394	        if parent == probe:
   395	            return False
   396	        probe = parent
   397	    return os.access(probe, os.W_OK)
   398	
   399	
   400	def _log_content_note(path: Path) -> str:
   401	    """Corroborate a ``.jsonl`` suffix against its first complete line."""
   402	    try:
   403	        with path.open("rb") as fh:
   404	            raw = fh.readline()
   405	    except OSError as exc:
   406	        return f"; content unreadable: {exc}"
   407	    if not raw.strip():
   408	        return ""
   409	    if not raw.endswith(b"\n"):
   410	        return "; first line incomplete (torn or still being written)"
   280	    assert intent.exists() and intent.read_bytes() == intent_before
   281	    assert world["vertex"].read_text(encoding="utf-8") == file_before
   282	    _audit_ok(world)
