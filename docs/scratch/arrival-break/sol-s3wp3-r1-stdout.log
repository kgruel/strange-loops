  1318	def test_an_incomplete_read_does_not_answer_advanced_above_the_bound(tmp_path):
  1319	    """The second unsound proceed-answer, and the one a reader talks themselves
  1320	    into.
  1321	
  1322	    "Below the bound is a rollback" is easy to believe and easy to get right.
  1323	    "Above the bound is an advance" *feels* equally safe and is not: nothing
  1324	    bounds the accepted head from ABOVE, so a presented head at ordinal 3 may
  1325	    still sit below an entry at 200 that the read missed, and descent verified
  1326	    from the bound says nothing about an entry that was never on the walk.
  1327	
  1328	    **This seam is where that rule becomes enforced behavior.** Nothing
  1329	    upstream pins it — ``established_head()`` refuses rather than answering,
  1330	    ``HeadLowerBound`` has no public methods at all, and the comparison vectors
  1331	    recompute the arithmetic in their own runner rather than driving the
  1332	    module. So a caller that reached for ``at_least`` and compared it like a
  1333	    head would meet nothing that objected, which is exactly why the assertion
  1334	    lives here.
  1335	
  1336	    The write assertion is the other half: journaling a ``DESCENDANT`` entry at
  1337	    the presented head would raise the bound on evidence the read did not have,
  1338	    which is how a degraded open launders itself into a memory.
  1339	    """
  1340	    log_path = minted(tmp_path / "s.arrival")
  1341	    append_legacy(log_path, "one")
  1342	    opened(log_path)
  1343	    lineage = lineage_of(log_path)
  1344	    append_entry_for_damage(lineage)
  1345	    damage_a_line(lineage, "damage-me")
  1346	    before = journal_bytes(lineage)
  1347	
  1348	    append_legacy(log_path, "two", "three")
  1349	    ledger = opened(log_path)
  1350	
  1351	    comparison = ledger.opened.comparison
  1352	    assert isinstance(comparison, Indeterminate), "an advance was claimed"
  1353	    assert comparison.presented.ordinal == 3
  1354	    assert comparison.at_least is not None
  1355	    assert comparison.at_least.ordinal == 1
  1356	    assert journal_bytes(lineage) == before, "the bound was raised on nothing"
