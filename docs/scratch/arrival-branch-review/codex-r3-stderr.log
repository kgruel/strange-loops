   108	
   109	class ArrivalCanonicalUnsupported(NotImplementedError):
   110	    """An operation an arrival-canonical store refuses rather than fudges.
   111	
   112	    Two families: history-mutating ops (they would rewrite index rows while
   113	    the log kept the originals), and index states that only projection
   114	    re-derivation can honestly resolve — which is the next cut's verb, so
   115	    refusing keeps it designable there. A refusal names what the caller can
   116	    do instead.
   117	    """
   118	
   119	
   120	class ArrivalStore(SqliteStore[T], Generic[T]):
   121	    """A store whose canonical persistence is its arrival log.
   122	
   123	    Same constructor as :class:`SqliteStore` plus an optional ``log_path``
   124	    (defaults to the db path with the ``.arrival`` suffix). Opening runs
   125	    catch-up; every append lands in the log first.
   126	
   127	    The log must be minted before the store accepts writes — movement 1
   128	    (genesis, with the founding key) is its custodian's act, performed with
   129	    key material this class never sees. An unminted log opens as an empty
   130	    store and refuses appends with the mint-first message.
   131	    """
   132	
   133	    def __init__(self, *, log_path: Path | None = None, **kwargs: Any) -> None:
   134	        super().__init__(**kwargs)
   135	        self._log = ArrivalLog(
   136	            Path(log_path)
   137	            if log_path is not None
   138	            else canonical_for(self._path, "arrival")
   139	        )
   140	        # The mark the last ceremony-path reconcile verified — see
   141	        # _sync_derived_state / _ceremony_persist.
   142	        self._reconciled_mark: ResumeMark | None = None
   143	        try:
   144	            self._ensure_fact_signature_column()
   145	            self._ensure_chain_columns()
   146	            self._ensure_meta_table()
   147	            self.catch_up()
   148	        except BaseException:
   149	            # A raise out of __init__ must leave the db reopenable: an
   150	            # uncommitted write on a leaked connection locks the file.
   151	            conn = self._db
   152	            try:
   153	                conn.rollback()
   154	            finally:
   155	                conn.close()
   156	            raise
   157	
   158	    @property
   159	    def log_path(self) -> Path:
   160	        """The arrival log this store's sqlite index derives from."""
   161	        return self._log.path
   162	
   163	    @property
   164	    def _db(self) -> sqlite3.Connection:
   165	        """The open index connection, narrowed.
   166	
   167	        ``SqliteStore`` nulls ``_conn`` on close; nothing in this class runs
   168	        after close, so a None here is a caller bug and refuses loudly
   169	        rather than surfacing as an attribute error three frames deep.
   170	        """
   171	        conn = self._conn
   172	        if conn is None:
   173	            raise RuntimeError(f"store at {self._path} is closed")
   174	        return conn
   175	
   176	    # ---- the resume mark ------------------------------------------------
   177	
   178	    def _read_mark(self) -> ResumeMark | None:
   179	        """The persisted mark, or None when any field is absent or untyped.
   180	
   181	        All three fields or nothing: a partial mark is not a position, and
   182	        :meth:`engine.arrival.ArrivalLog.walk_marked` re-validates whatever
   183	        this returns at the adoption site anyway.
   184	        """
   185	        lineage = self._meta_get(ARRIVAL_LINEAGE_KEY)
   186	        offset = _as_int(self._meta_get(ARRIVAL_OFFSET_KEY))
   187	        ordinal = _as_int(self._meta_get(ARRIVAL_ORDINAL_KEY))
   188	        if not isinstance(lineage, str) or offset is None or ordinal is None:
   189	            return None
   190	        return ResumeMark(
   191	            arrival_lineage=lineage, arrival_offset=offset, arrival_ordinal=ordinal
   192	        )
   193	
   194	    def _stamp_mark(self, mark: ResumeMark) -> None:
   195	        """Stage the three mark fields — the caller owns the commit."""
   196	        self._meta_set(ARRIVAL_LINEAGE_KEY, mark.arrival_lineage)
   197	        self._meta_set(ARRIVAL_OFFSET_KEY, mark.arrival_offset)
   198	        self._meta_set(ARRIVAL_ORDINAL_KEY, mark.arrival_ordinal)
   199	
   200	    # ---- catch-up --------------------------------------------------------
   201	
   202	    def catch_up(self) -> str:
   203	        """Reconcile the index with the log by consuming forward.
   204	
   205	        Returns what it did: ``"synced"``, ``"tailed"``, ``"built"`` or
   206	        ``"empty"``. Refuses (:class:`ArrivalCanonicalUnsupported`) whenever
   207	        honesty would require discarding index rows — that is projection
   208	        re-derivation, the next cut's verb.
   209	
   210	        Runs on every open, so "there is nothing to do" is the case that has
   211	        to be cheap: it answers from ``store_meta`` reads and one stat,
   212	        taking no lock at all. Everything past that fast path takes the
   213	        sqlite write lock —
   214	        see the comment at the escalation for why the mark is re-read inside
   215	        it, and why the fast path cannot weaken that.
   216	        """
   217	        mark = self._read_mark()
   218	        if self._log.size() == 0:
   219	            if has_rows(self._db) or mark is not None:
   220	                raise ArrivalCanonicalUnsupported(
   221	                    f"{self._path} carries index state but there is no "
   222	                    f"arrival log at {self._log.path} — an index without its "
   223	                    "log cannot be reconciled, and re-derivation cannot "
   224	                    "manufacture a log: offering it here would name an "
   225	                    "operation that destroys the only surviving artifact. "
   226	                    "Restore the log, or open the db as a plain sqlite store"
   227	                )
   228	            return "empty"
   229	
   230	        if mark is None and has_rows(self._db):
   231	            raise ArrivalCanonicalUnsupported(
   232	                f"{self._path} holds rows but no arrival resume mark — an "
   233	                "index that carries state cannot be consumed forward. Run "
   234	                "engine.arrival_projection.rederive_projections("
   235	                f"{str(self._log.path)!r}) to discard the projection and "
   236	                "rebuild it from the log, or open the db as a plain sqlite "
   237	                "store"
   238	            )
   239	
   240	        # NOTHING TO DO — the lock-free common case. Catch-up runs on every

