    56	@dataclass(frozen=True)
    57	class DerivedLogMergeResult:
    58	    """What the union contained. Counts, never a verdict about the stores."""
    59	
    60	    lines: int
    61	    from_ours: int
    62	    from_theirs: int
    63	    shared: int
