    89	    return HeadAttestation(
    90	        head=head(ordinal, digest, lineage),
    91	        kind=kind,
    92	        level=level,
    93	        observed_at=1787779020.0,
    94	        note=note,
    95	    )
    96	
    97	
    98	# ---------------------------------------------------------------------------
    99	# The classifier: every row (§C.1)
   100	# ---------------------------------------------------------------------------
   101	
   102	
   103	def test_no_memory_is_first_contact():
   104	    """Nothing remembered, so nothing was proven — and the label is permanent."""
   105	    assert compare(None, head(7), None) is Outcome.FIRST_CONTACT
   106	
   107	
   108	def test_identical_head_is_unchanged():
   109	    known = observation(7)
   110	    assert compare(known, head(7), None) is Outcome.UNCHANGED
   111	
   112	
   113	def test_unchanged_never_consults_the_evidence():
   114	    """The dominant case must not pay for evidence it cannot use.
   115	
   116	    ``at_known`` deliberately contradicts the remembered head here. If the
   117	    unchanged arm consulted it, this would classify a rewrite.
   118	    """
   119	    known = observation(7)
   120	    assert compare(known, head(7), head(7, "f")) is Outcome.UNCHANGED
   121	
   122	
   123	def test_higher_ordinal_with_matching_record_at_the_known_ordinal_advances():
   124	    known = observation(7)
   125	    assert compare(known, head(9), known.head) is Outcome.ADVANCED
   126	
   127	
   128	def test_lower_ordinal_is_rollback():
   129	    """A store may not present a head below the one this machine accepted."""
   130	    known = observation(9)
   131	    assert compare(known, head(7), None) is Outcome.ROLLBACK
   132	
   133	
