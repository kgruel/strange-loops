   138	# ---------------------------------------------------------------------------
   139	# Row readers / hash helpers
   140	# ---------------------------------------------------------------------------
   141	
   142	def _rows(path, table, cols):
   143	    """Read rows at full arity — narrow (pre-chain) schemas select NULL for
   144	    the columns they do not have, independently of the code under test."""
   145	    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
   146	    have = {r[1] for r in conn.execute(f"PRAGMA table_info({table})")}
   147	    sql = ", ".join(c if c in have else "NULL" for c in cols)
   148	    out = [tuple(raw) for raw in
   149	           conn.execute(f"SELECT {sql} FROM {table} ORDER BY rowid")]
   150	    conn.close()
   151	    return out
   152	
   153	
   154	_FACT_COLS = ("id", "kind", "ts", "observer", "origin", "payload", "signature")
   155	_TICK_COLS = ("id", "name", "ts", "since", "origin", "payload", "prev_hash",
   156	              "window_start", "fact_cursor", "window_hash", "signature")
   157	
   158	
   159	def _fact_rows(path):
   160	    return _rows(path, "facts", _FACT_COLS)
   161	
   162	
   163	def _tick_rows(path):
   164	    return _rows(path, "ticks", _TICK_COLS)
   165	
   166	
   167	def _chain_head(path):
   168	    from engine import SqliteStore
   169	
   170	    store = SqliteStore(path=path, serialize=lambda d: d, deserialize=lambda d: d)
   171	    head = store.current_chain_head()
   172	    store.close()
   173	    return head
   174	
   175	
   176	def _verify(path):
   177	    from engine import SqliteStore
   178	
   179	    store = SqliteStore(path=path, serialize=lambda d: d, deserialize=lambda d: d)
   180	    chain = store.verify_chain(verifier=_fake_verifier)
   181	    # verify_facts' verifier is per-observer: (observer, signature, digest).
   182	    facts = store.verify_facts(
   183	        verifier=lambda _obs, sig, digest: _fake_verifier(sig, digest))
   184	    store.close()
   185	    return chain, facts
