    14	class _LazyDataclassFields:
    15	    """Descriptor that installs __dataclass_fields__ on first access."""
    16	
    17	    def __set_name__(self, owner, name):
    18	        self._name = name
    19	        self._owner = owner
    20	
    21	    def __get__(self, obj, objtype=None):
    22	        cls = objtype or type(obj)
    23	        # Install real __dataclass_fields__ and __dataclass_params__
    24	        import dataclasses
    25	        fields = {}
    26	        for name, default in [("kind", dataclasses.MISSING), ("ts", dataclasses.MISSING),
    27	                               ("payload", dataclasses.MISSING), ("observer", dataclasses.MISSING),
    28	                               ("origin", "")]:
