   334	def _open_combined(store_paths: list[Path]) -> tuple[sqlite3.Connection, list[str]]:
     1	"""_combined_read under a DECLARED ordering (Cut C, Q2).
     2	
     3	'arrival' is single-store-only: a combine-of-one reads on the arrival axis by
     4	default, an aggregate of several reads on the ``(ts, id)`` lens, and declaring
     5	``Arrival()`` on an aggregate is refused.
     6	"""
