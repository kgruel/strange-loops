   223	def _fact_row_hash(row: tuple) -> str:
   224	    """Era-aware hash of one persisted fact row.
   225	
   226	    Row shape: (id, kind, ts, observer, origin, payload[, signature]).
   227	    The signature key is included only when the row carries one, so every
   228	    pre-signature fact row hashes byte-identically to delta 1/2 — already-
   229	    sealed window hashes never re-anchor. For signed facts the window
   230	    commits over content+signature, making fact-signature-stripping a
   231	    detectable break in any sealed window (delta-2 envelope trick, one
   232	    layer down — design/fact-signing-per-observer-keys).
   233	    """
   234	    envelope = {
   235	        "id": row[0], "kind": row[1], "ts": row[2],
   236	        "observer": row[3], "origin": row[4], "payload": row[5],
   237	    }
   238	    if len(row) > 6 and row[6] is not None:
   239	        envelope["signature"] = row[6]
   240	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
