   441	def _freeze_store_dir(split_world) -> Path:
   442	    """Read-only store DIRECTORY, canonical file itself still writable."""
   443	    import os
   444	
   445	    storedir = split_world["storedir"]
   446	    storedir.chmod(0o555)
   447	    canonical = (
   448	        split_world["log"]
   449	        if split_world["mode"] == "jsonl"
   450	        else split_world["index"]
   451	    )
   452	    assert os.access(canonical, os.W_OK), "repro needs a writable canonical"
   453	    return storedir
