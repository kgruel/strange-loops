  1470	    @staticmethod
  1471	    def _check_follows(record: dict, head: dict) -> None:
  1472	        """The head checks, plus placement. Refuse before a byte is written.
  1473	
  1474	        Placement is checked on the way IN as well as on the way out
  1475	        (:meth:`walk`) because the two catch different things: the walk
  1476	        catches a file someone hand-wrote, and this catches a caller — every
  1477	        append funnels through here, so ``append`` and ``append_record``
  1478	        are both covered.
  1479	        """
