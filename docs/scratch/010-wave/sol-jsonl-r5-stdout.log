    71	def test_tasks_vertex_reads_name_their_store():
    72	    """Rule: no un-allowlisted vertex_* read may resolve its own store."""
    73	    sites = _call_sites()
    74	    assert sites, "the AST walk found no vertex_* calls — the ratchet went blind"
    75	
    76	    offenders = [
    77	        f"{rel}:{lineno} {func}() -> {callee}(...) without store="
    78	        for (rel, func, callee), lineno, has_store in sites
    79	        if not has_store and (rel, func, callee) not in _PACKAGE_RELATIVE
    80	    ]
    81	    assert not offenders, (
    82	        "tasks-vertex reads must pass store=workspace_store(vp) — the vertex is "
    83	        "packaged, the store is workspace-relative (friction:tasks-read-write-"
    84	        "residence-split):\n  " + "\n  ".join(offenders)
    85	    )
