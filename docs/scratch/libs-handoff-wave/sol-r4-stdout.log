   304	def ensure_index(canonical: Path) -> Path:
   305	    """Materialize — and catch up — the sqlite index for a JSONL-canonical log.
   306	
   307	    The doctrine's fresh-clone case: the ``.jsonl`` is tracked in git, the
   308	    derived ``.db`` is not, so the first read after a clone finds no index.
   309	    Opening a :class:`JsonlStore` runs the S3 catch-up (offset absent + a
   310	    non-empty log ⇒ full rebuild), which is exactly "materialize the index
   311	    from the log". Closing immediately leaves no handle behind.
   312	
   313	    An *existing* index is not evidence of a current one. The log is the
   314	    store: a line can be durable and unindexed (the post-fsync crash
   315	    window, or another process's log write). Short-circuiting on
   316	    ``index.exists()`` left every read-only invocation — which never
   317	    constructs a ``JsonlStore`` — silently omitting canonical facts until
   318	    some writer happened along. So an existing index is checked for
   319	    staleness (:func:`_index_is_current`: one read-only meta read, one
   320	    stat) and opened only when it is behind.
   321	
   322	    A no-op — no store constructed, no lock taken — when ``canonical`` is
   323	    not JSONL-canonical, when the log itself is missing (nothing to build
   324	    from; let the caller's own not-found handling speak), or when the index
   325	    is already current. Read paths may call this on every resolve.
   326	    """
   327	    from .residence import index_path_for, is_jsonl_canonical
   328	
   329	    canonical = Path(canonical)
   330	    index = index_path_for(canonical)
   331	    if not is_jsonl_canonical(canonical) or not canonical.exists():
   332	        return index
   333	    if index.exists() and _index_is_current(index, canonical):
   334	        return index
   335	    store: JsonlStore[Any] = JsonlStore(
   336	        path=index,
   337	        log_path=canonical,
   338	        serialize=lambda d: d,
   339	        deserialize=lambda d: d,
   340	    )
   341	    store.close()
   342	    return index
