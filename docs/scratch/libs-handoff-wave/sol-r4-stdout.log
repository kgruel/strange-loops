+def _sqlite_busy(exc: BaseException) -> bool:
+    """Is this sqlite error a transient BUSY/LOCKED, not damage?
+
+    Primary evidence is the error code (``SQLITE_BUSY`` 5 / ``SQLITE_LOCKED``
