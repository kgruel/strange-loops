    98	@pytest.mark.parametrize("page_size", [1, 7, 10, 53, 100])
    99	def test_pagination_equals_full_scan_mixed_id_eras(db, order, page_size):
   100	    with StoreReader(db) as reader:
   101	        full = reader.query_facts(limit=10_000, order=order)
   102	        assert not full.truncated and full.next is None
   103	        paged = _walk(reader, order, page_size)
   104	    full_ids = [f["id"] for f in full.items]
   105	    paged_ids = [f["id"] for f in paged]
   106	    assert paged_ids == full_ids                      # no gaps, no reorders
   107	    assert len(set(paged_ids)) == len(paged_ids)      # no duplicates
