   102	def fact_line(fact: dict) -> "Block":
   103	    """Render a single fact as a styled Block."""
   104	    from painted.core.block import Block
   105	    from painted.palette import current_palette
   106	
   107	    p = current_palette()
   108	    ts = fact["ts"]
   109	    if isinstance(ts, datetime):
   110	        dt = ts
   111	    else:
   112	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   113	
   114	    time_str = format_ts(dt)
   115	    kind = fact["kind"]
   116	    obs = fact.get("observer", "")
   117	    payload = fact["payload"]
   118	
   119	    parts = [f"{k}={v}" for k, v in payload.items() if v is not None and v != ""]
   120	    summary = " ".join(parts)
   121	
   122	    who = f" ({obs})" if obs else ""
   123	    text = f"  {time_str} [{kind}]{who} {summary}" if summary else f"  {time_str} [{kind}]{who}"
   124	    return Block.text(text, p.muted)
