   243	def _fact_commitment_hash(
   244	    kind: str, ts: float, observer: str, origin: str, payload_text: str
   245	) -> str:
   246	    """Hash the fact's CONTENT commitment — what the fact signer signs.
   247	
   248	    Content-only by design (design/fact-signature-at-store-column):
   249	    excludes id and rowid, which are custody context, not authored
   250	    content. This is what makes the signature transport-stable — any
   251	    store holding the row can re-derive the commitment and verify
   252	    authorship against the observer registry without trusting the
   253	    sender. Stored payload TEXT is embedded verbatim (same posture as
   254	    the tick envelope: byte-level tamper detection, no re-serialization).
   255	    Never includes the signature (a signature cannot sign itself).
   256	    """
   257	    envelope = {
   258	        "kind": kind, "ts": ts, "observer": observer,
   259	        "origin": origin, "payload": payload_text,
   260	    }
   261	    return hashlib.sha256(_canonical_bytes(envelope)).hexdigest()
