   209	
   210	class FileLedger:
   211	    """Custody over one ``.arrival`` log, in the contract's vocabulary.
   212	
   213	    Satisfies :class:`engine.arrival_contract.ArrivalLedger` in full, and
   214	    offers one op beyond it — ``import_prefix``, which the Protocol
   215	    deliberately does not declare (see the module docstring).
   216	
   217	    **Which verification level each operation invokes** (§06 requires a
   218	    backend to say): :meth:`read`, :meth:`scan` and :meth:`head` all reach
   219	    their answer through :meth:`engine.arrival.ArrivalLog.walk`, so they
   220	    invoke FULL — the log's read path establishes that everything before a
   221	    coordinate is intact before it will name what is at it. Only
   222	    :meth:`verify` with an :class:`~engine.arrival_contract.Open` scope is
   223	    cheap. That is a property of this backend, not of the contract; a backend
   224	    with stored head metadata would answer :meth:`head` at OPEN.
   225	    """
   226	
   227	    def __init__(
   228	        self, log: ArrivalLog, *, max_atomic_records: int | None = None
   229	    ) -> None:
   230	        """``max_atomic_records`` is None for "no configured limit".
   231	
   232	        Different from a limit of one: §04 requires every backend to support
   233	        one record and lets it advertise more. The file append holds the
   234	        whole group under one lock and one fsync with no limit of its own, so
   235	        an unset limit is the honest default — but a deployment that wants
   236	        one gets a refusal that fires BEFORE any mutation, which is what §04
   237	        asks for and what §12's configured-limit gate exercises.
   238	        """
   239	        self._log = log
   240	        self._max_atomic_records = max_atomic_records
   241	
   242	    # -- custody -----------------------------------------------------------
   243	
   244	    def mint(self, options: Mapping[str, Any]) -> Head:
   245	        """Exclusively create one signed genesis and return head 0.
   246	
   247	        ``options`` are adapter-interpreted, the same way §02's ``location``
   248	        is: this backend forwards them to
   249	        :meth:`engine.arrival.ArrivalLog.mint`, which needs an observer, a
   250	        signer and the founding public key.
   251	
   252	        A second mint raises ``GenesisRefused`` — a backend exception, not a
   253	        contract refusal, because the ratified refusal set has no member for
   254	        "already minted". Passing it through is the honest option; the
   255	        alternative is choosing one of the five and claiming something the
   256	        evidence does not support.
   257	        """
   258	        log = ArrivalLog.mint(self._log.path, **dict(options))
   259	        self._log = log
   260	        return _head_of(log.genesis())
   261	
   262	    def append(
   263	        self, expected: Head | None, drafts: Sequence[RecordDraft]
   264	    ) -> Commit:
   265	        """Compare the full head, then assign and commit — indivisibly (§04).
   266	
   267	        The whole transition is :meth:`ArrivalLog.append_marked_many`: the
   268	        fence, the full-head compare (F1), coordinate assignment, one write
   269	        and one fsync. Nothing is re-implemented here, which is the point —
   270	        the append fence is ``flock``-based and per-open-file-description,
   271	        and a second appender beside it would be a second way to be wrong.
   272	
   273	        ``before`` is derived rather than re-read: the first record's
   274	        ``prev`` IS the predecessor's record hash and its ordinal minus one
   275	        IS the predecessor's ordinal, so the head the append actually landed
   276	        on is known exactly, without a second trip past a log another writer
   277	        is free to extend.
   278	        """
   279	        if not drafts:
   280	            raise ValueError(
   281	                "append was handed no drafts — an empty append is a caller "
   282	                "bug, not a no-op to absorb"
   283	            )
   284	        if (
   285	            self._max_atomic_records is not None
   286	            and len(drafts) > self._max_atomic_records
   287	        ):
   288	            raise AtomicLimitExceeded(
   289	                f"{len(drafts)} records exceeds this backend's configured "
   290	                f"atomic limit of {self._max_atomic_records} — refused before "
   291	                "any mutation, because splitting the request across "
   292	                "transactions would turn one logical group into several"
   293	            )
   294	        entries = [
   295	            Entry(
   296	                k=draft.kind,
   297	                body=dict(draft.body),
   298	                observer=draft.observer,
   299	                origin=draft.origin,
   300	                at=draft.authored_at,
   301	                signature=draft.signature,
   302	            )
   303	            for draft in drafts
   304	        ]
   305	        try:
   306	            records, _mark = self._log.append_marked_many(
   307	                entries, following=expected
   308	            )
   309	        except StaleHead as exc:
   310	            # 1:1, and only from the CAS subclass. The parent AppendRejected
   311	            # is also raised for placement faults in a carried-in candidate,
   312	            # and mapping those to HeadMismatch would assert something about
   313	            # the head that the fault does not say.
   314	            raise HeadMismatch(str(exc)) from exc
   315	
   316	        first, last = records[0], records[-1]
   317	        return Commit(
   318	            before=Head(
   319	                lineage=first["lin"],
   320	                ordinal=first["ord"] - 1,
