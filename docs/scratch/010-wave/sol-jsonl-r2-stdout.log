    93	    """Build the line object for a row — and hold it to the decoder's rules.
    94	
    95	    ``serialize(x)`` must always be decodable. Checking arity alone let a
    96	    row with a *typed*-wrong field through: a fact carrying ``ts="1.0"``
    97	    (a string, which sqlite's REAL affinity accepts) got a durable JSONL
    98	    receipt, and then every subsequent open failed on decode — the store
    99	    bricked by a line its own serializer wrote. Running the decoder's
   100	    :func:`_validate` over the object before dumping makes the two
   101	    directions symmetric by construction rather than by parallel
   102	    maintenance, and puts the error at the append site, where it is
   103	    attributable to the caller that built the row.
   104	    """
   105	    n = len(fields)
   106	    if len(row) not in (n, n + 1):
   107	        raise JsonlCodecError(
   108	            f"{t} row must have {n} or {n + 1} fields, got {len(row)}"
   109	        )
   110	    obj: dict = {"t": t}
   111	    obj.update(zip(fields, row[:n], strict=True))
   112	    if len(row) > n and row[n] is not None:
   113	        obj[_SIGNATURE] = row[n]
   114	    _validate(obj, fields, allowed, nullable, t)
   115	    return obj
   116	
   117	
   118	def serialize_fact_row(row: tuple) -> str:
   119	    """Encode a fact row ``(id, kind, ts, observer, origin, payload[, signature])``."""
   120	    return _dump(_row_dict(row, _FACT_FIELDS, _FACT_KEYS, _FACT_NULLABLE, "fact"))
   121	
   122	
   123	def serialize_tick_row(row: tuple) -> str:
   124	    """Encode a tick row (``_TICK_ROW_SQL`` order, signature optional)."""
   125	    return _dump(_row_dict(row, _TICK_FIELDS, _TICK_KEYS, _TICK_NULLABLE, "tick"))
   126	
   127	
   128	def _reject_constant(name: str) -> None:
   129	    """Refuse the non-JSON literals ``NaN``/``Infinity``/``-Infinity``.
   130	
   131	    Serialization uses ``allow_nan=False``, so these can never be emitted;
   132	    admitting them on read would let a corrupt line past the codec gate and
   133	    detonate later inside the JCS commitment hashers (or land a NaN ``ts``
   134	    in sqlite). Reject at the boundary — explicit over implicit.
   135	    """
   136	    raise JsonlCodecError(f"non-JSON literal {name!r} is not permitted")
   137	
   138	
   139	def _no_duplicate_keys(pairs: list[tuple[str, object]]) -> dict:
   140	    """Build the object, refusing a key spelled twice.
   141	
   142	    ``json.loads`` resolves duplicates last-wins, so ``"id":"A","id":"B"``
   143	    decodes as ``B`` — two different lines with two different meanings that
   144	    a reader silently collapses to one. A canonical log admits exactly one
   145	    spelling per record; ambiguity is corruption, not a parse detail.
   146	    """
   147	    obj: dict = {}
   148	    for key, value in pairs:
   149	        if key in obj:
   150	            raise JsonlCodecError(f"duplicate key {key!r} in line")
   151	        obj[key] = value
   152	    return obj
   153	
   154	
   155	def _load(line: str) -> dict:
   156	    try:
