   768	            # line is indexed entirely or (torn) truncated entirely, so a
   769	            # ceremony can never index as a subset. facts += N; the offset
   770	            # stamps at the line's end as for any line.
   771	            for t, row in deserialize_records(line):
   772	                try:
   773	                    self._conn.execute(
   774	                        FACT_INSERT_SQL if t == "fact" else TICK_INSERT_SQL, row
   775	                    )
   776	                except sqlite3.IntegrityError as exc:
   777	                    if rebuilding:
   778	                        # The tables were just cleared, so a collision here
   779	                        # means the LOG carries the id twice. Rebuilding again
   780	                        # would recurse forever on a log that cannot index.
   781	                        raise JsonlCanonicalUnsupported(
   782	                            f"{self._log_path} carries {t} {row[0]} more than "
   783	                            "once — the canonical log cannot be indexed as "
   784	                            "written"
   785	                        ) from exc
   786	                    raise _RowAlreadyIndexed(
   787	                        f"index already holds {t} {row[0]}, a row the "
   788	                        f"consumed-offset marker ({offset}) calls unindexed"
