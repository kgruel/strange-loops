  1715	def _fsync_dir(directory: Path) -> None:
  1716	    """fsync a directory so a newly created entry survives a power cut."""
  1717	    fd = os.open(str(directory), os.O_RDONLY)
  1718	    try:
  1719	        os.fsync(fd)
  1720	    finally:
  1721	        os.close(fd)

