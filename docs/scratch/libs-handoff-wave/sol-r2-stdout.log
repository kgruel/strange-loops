   524	        fact_signer = credentials.for_write(vertex_path).fact_signer
   525	
   526	    # Cheap currency pre-check (edit mode) before the intent lands — the CAS
   527	    # inside absorb_edit remains the atomic guard; this only avoids intent
   528	    # churn on an already-known-stale preview.
   529	    if preview.mode == "edit":
   530	        store = _open_store(preview.canonical_path)
   125	    origins: list[str] | None = None,
   126	) -> tuple[str, list]:
   127	    """Build WHERE clause and params from filter arguments.
   128	
   129	    Kind matching supports both exact and prefix: kinds=["ui"] matches
   130	    "ui" exactly and anything starting with "ui." (e.g. "ui.key").
   131	    """
   132	    clauses: list[str] = []
   133	    params: list = []
   134	
   135	    if since is not None:
   136	        clauses.append("ts >= ?")
   137	        params.append(since)
   138	
   139	    if before is not None:
   140	        clauses.append("ts < ?")
   141	        params.append(before)
   142	
   143	    if kinds:
   144	        kind_clauses = []
   145	        for kind in kinds:
   146	            kind_clauses.append("(kind = ? OR kind LIKE ? || '.%')")
   147	            params.extend([kind, kind])
   148	        clauses.append("(" + " OR ".join(kind_clauses) + ")")
   149	
   150	    if observers:
   151	        placeholders = ", ".join(["?"] * len(observers))
   152	        clauses.append(f"observer IN ({placeholders})")
   153	        params.extend(observers)
   154	
   155	    if origins:
   156	        placeholders = ", ".join(["?"] * len(origins))
   157	        clauses.append(f"origin IN ({placeholders})")
   158	        params.extend(origins)
   159	
   160	    if not clauses:
   161	        return "", []
   162	
   163	    return " WHERE " + " AND ".join(clauses), params

