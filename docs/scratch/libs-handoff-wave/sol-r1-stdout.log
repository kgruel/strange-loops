    76	    store = _open(tmp_path, GOLDEN)
    77	    conn = sqlite3.connect(str(store._path))
    78	    try:
    79	        facts = conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0]
    80	        ticks = conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0]
    81	        order = [r[0] for r in conn.execute("SELECT kind FROM facts ORDER BY rowid")]
    82	    finally:
