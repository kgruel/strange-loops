  1609	        return self.append_tick_attested(tick, enforce_floor=enforce_floor)[0]
  1610	
  1611	    def append_tick_attested(
  1612	        self, tick: Tick, *, enforce_floor: bool = True
  1613	    ) -> tuple[str, str | None]:
  1614	        """:meth:`append_tick`, also returning the committed row's signature.
  1615	
  1616	        Same committed-row posture as :meth:`append_attested`: the signature
  1617	        is read back inside the write transaction, after the INSERT (AFTER
  1618	        triggers fired), before the commit (SOL-R3-02).
  1619	        :meth:`tick_signature_state` remains the public read-back API for
  1620	        cross-checks.
  1621	        """
  1622	        self._ensure_sync()
  1623	        self._ensure_chain_columns()
  1624	        # Every read below (prev_row, the fact cursor, the signed-era probe)
  1625	        # derives chain state from sqlite. Where sqlite is a derived index,
  1626	        # it must have consumed the whole canonical log first — see
  1627	        # _sync_derived_state.
  1628	        self._sync_derived_state()
