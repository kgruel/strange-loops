   444	                    row_tuple = (fact_id, kind, ts, observer, origin, payload, sig)
   445	                    row_for_hash = row_tuple if (sig_col and sig is not None) else row_tuple[:6]
   446	                    content_hasher.update(json.dumps(list(row_for_hash), separators=(",", ":")).encode())
   447	
   448	                    fr = FactRow(
