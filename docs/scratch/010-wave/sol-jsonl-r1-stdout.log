   283	
   284	def test_jcs_boundary_integers_accepted():
   285	    # The bound itself is inside the domain — reject one past it, not it.
   286	    for number in ("9007199254740991", "-9007199254740991"):
   287	        line = (
   288	            '{"t":"fact","id":"i","kind":"k","ts":' + number + ","
   289	            '"observer":"o","origin":"g","payload":"{}"}'
   290	        )
   291	        assert deserialize_fact_row(line)[2] == int(number)
     1	"""JSONL-canonical store — the authority flip's write path.
     2	
     3	The claim under test: the durable JSONL line is the store, sqlite is an
     4	index derived from it. So the receipt must originate at the line (a crash
     5	between line and index loses nothing and changes no id), the log must never
     6	be left corrupt (torn line truncated), a lying offset must force a rebuild,
     7	and signatures must ride the whole path verbatim — never re-signed.
     8	"""
     9	
    10	import json
    11	from datetime import UTC, datetime
    12	from pathlib import Path
    13	
    14	import pytest
    15	from atoms import Fact
    16	
    17	from engine.jsonl_codec import deserialize_row
    18	from engine.jsonl_store import JsonlCanonicalUnsupported, JsonlStore, log_path_for
    19	from engine.sqlite_store import (
    20	    SqliteStore,
    21	    _fact_commitment_hash,
    22	    tick_row_hash,
    23	)
    24	from engine.tick import Tick
    25	
    26	# --- helpers ---------------------------------------------------------------
    27	
    28	
    29	def open_store(tmp_path: Path, name: str = "s", **kw) -> JsonlStore:
    30	    return JsonlStore(
    31	        path=tmp_path / f"{name}.db",
    32	        serialize=lambda f: f.to_dict(),
    33	        deserialize=Fact.from_dict,
    34	        **kw,
    35	    )
    36	
    37	
    38	def fact(kind: str = "note", observer: str = "kyle", **payload) -> Fact:
    39	    return Fact.of(kind, observer, **(payload or {"message": "hi"}))
    40	
    41	
    42	def lines(path: Path) -> list[str]:
    43	    return [ln for ln in path.read_text(encoding="utf-8").split("\n") if ln]
    44	
    45	
    46	def sqlite_facts(path: Path) -> list[tuple]:
    47	    import sqlite3
    48	
    49	    conn = sqlite3.connect(str(path))
    50	    try:
    51	        return conn.execute(
    52	            "SELECT id, kind, ts, observer, origin, payload, signature "
    53	            "FROM facts ORDER BY rowid"
    54	        ).fetchall()
    55	    finally:
    56	        conn.close()
    57	
    58	
    59	def offset_of(store: JsonlStore) -> int:
    60	    return store._read_offset()
    61	
    62	
    63	# --- the basic contract ----------------------------------------------------
    64	
    65	
    66	def test_append_writes_log_first_and_receipt_matches_sqlite(tmp_path):
    67	    store = open_store(tmp_path)
    68	    fid = store.append(fact())
    69	    log = log_path_for(tmp_path / "s.db")
    70	
    71	    assert log.exists()
    72	    t, row = deserialize_row(lines(log)[0])
    73	    assert t == "fact"
    74	    assert row[0] == fid  # the receipt IS the id in the durable line
    75	    assert [r[0] for r in sqlite_facts(store._path)] == [fid]
    76	    assert offset_of(store) == log.stat().st_size
    77	    store.close()
    78	
