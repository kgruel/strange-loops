   125	# ---------------------------------------------------------------------------
   126	# Test 1: Full round-trip on synthetic legacy stores (both JSONL and SQLite arms)
   127	# ---------------------------------------------------------------------------
   128	
   129	
   130	@pytest.mark.parametrize("source_format", ["jsonl", "sqlite"])
   131	def test_full_roundtrip_synthetic_store(tmp_path: Path, source_format: str) -> None:
   132	    """(1) Full round-trip: inventory equality, signature preservation, Full verify,
   133	
   134	    journal first entry is bootstrap/MINT, descriptor updated, report verifies.
   135	    """
   136	    store_dir = tmp_path / "data"
   137	    store_dir.mkdir(parents=True, exist_ok=True)
   138	
   139	    cust = CustodianFixture(tmp_path, "alice")
   140	    bob_key = ed25519.load_or_generate(tmp_path / "keys" / "bob").public_b64
   141	    carol_key = ed25519.load_or_generate(tmp_path / "keys" / "carol").public_b64
   142	
   143	    if source_format == "jsonl":
   144	        source_path = build_synthetic_jsonl(store_dir / "legacy.jsonl")
   145	    else:
   146	        source_path = build_synthetic_sqlite(store_dir / "legacy.db")
   147	
   148	    v_path = _make_vertex_file(
   149	        tmp_path,
   150	        custodian_name=cust.name,
   151	        custodian_key=cust.public,
   152	        other_observers=[("bob", bob_key), ("carol", carol_key)],
   153	        store_rel_path=f"./data/{source_path.name}",
   154	    )
   155	
   156	    outcome = run_migration(
   157	        source_path=source_path,
   158	        vertex_path=v_path,
   159	        store_dir=store_dir,
   160	        signer=cust.signer,
   161	    )
   162	
   163	    # 1. Target and report exist
   164	    assert outcome.target_path.exists()
   165	    assert outcome.report_path.exists()
   166	    assert outcome.target_path.name == f"{outcome.lineage}.arrival"
   167	    assert outcome.report_path.name == f"{outcome.lineage}.migration-report.json"
   168	
   169	    # 2. Target verifies Full internally
   170	    registry = BackendRegistry.with_builtin_backends()
   171	    desc = StoreDescriptor(backend="file", location=str(outcome.target_path))
   172	    ledger, _ = registry.open(desc)
   173	    verified_head = ledger.verify(Full(through=outcome.head))
   174	    assert verified_head == outcome.head
   175	
   176	    # 3. Journal first entry is bootstrap/MINT (§E gap 1)
   177	    j_read = read_journal(outcome.lineage)
   178	    assert len(j_read.entries) >= 1
   179	    assert j_read.entries[0].kind == Kind.BOOTSTRAP
   180	    assert j_read.entries[0].level == Level.MINT
   181	    assert j_read.bootstrap == j_read.entries[0]
   182	
   183	    # 4. Report verifies signature and matches target head claim (§I.1)
   184	    assert verify_migration_report(
   185	        report_path=outcome.report_path,
   186	        public_key=cust.public,
   187	        verify=cust.verify,
   188	        target_path=outcome.target_path,
   189	    )
   190	
   191	    # 5. Authored inner signatures are preserved byte-for-byte (§I.2)
   192	    records = list(ledger.scan(through=outcome.head))
   193	    signed_facts = [
   194	        r["body"]
   195	        for r in records
   196	        if r.get("k") == "fact" and r["body"].get("signature") is not None
   197	    ]
   198	    # Check that FACT_UUID4_SIGNED and FACT_CANONICAL_ULID_SIGNED kept their signatures
   199	    assert any(f.get("signature") == "sig-alice-1" for f in signed_facts)
   200	    assert any(f.get("signature") == "sig-alice-4" for f in signed_facts)
   201	
   202	    # 6. Descriptor updated atomically with verification-by-re-parse (§H)
   203	    post_ast = parse_vertex_file(v_path)
   204	    assert post_ast.store_backend == BackendDecl(name="file")
   205	    resolved_desc = descriptor_for(post_ast, v_path)
   206	    assert resolved_desc is not None
   207	    assert resolved_desc.backend == "file"
   208	    assert Path(resolved_desc.location).resolve() == outcome.target_path.resolve()
   209	
   210	    # 7. Legacy store is never mutated and never deleted (§Contract ruling 9)
   211	    assert source_path.exists()
   212	
