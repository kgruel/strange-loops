  1765	def test_a_failed_ceremony_attempt_does_not_bound_a_successful_rerun():
  1766	    """The healing story end to end.
  1767	
  1768	    A reset whose binding did not match is a weakening cause, so the operator's
  1769	    own failed attempt could otherwise bound every read after it — the remedy
  1770	    being the thing that broke them.
  1771	
  1772	    It heals through the epoch walk rather than through position weighting, and
  1773	    the distinction matters for anyone reading this as coverage of the latter:
  1774	    ``_epoch_of`` walks BACKWARD and returns at the first valid reset, so the
  1775	    voided attempt below it is never examined and produces no note at all.
  1776	    Position scoping is exercised by the damage tests, not by this one.
  1777	    """
  1778	    append_entry(observation(1))
  1779	    append_entry(observation(9))
  1780	    append_entry(observation(2, kind=Kind.TRUST_RESET, level=Level.FULL))  # voided
  1781	    assert isinstance(read_journal(LINEAGE).known, HeadLowerBound)
  1782	
  1783	    append_reset(9)  # the operator re-runs it, correctly this time
  1784	
  1785	    result = read_journal(LINEAGE)
  1786	    known = result.established_head()  # healed
  1787	    assert known is not None
  1788	    assert known.head.ordinal == 9
  1789	    # The voided attempt is not even reported, and that is the backward walk
  1790	    # short-circuiting at the first valid boundary rather than a loss: the
  1791	    # operator was already told at the time, because `trust_reset` reads its
  1792	    # own entry back and raises `TrustResetNotHonored` when it does not take.
  1793	    assert not any("trust-reset" in note for note in result.skipped)
