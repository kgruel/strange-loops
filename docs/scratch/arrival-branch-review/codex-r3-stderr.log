   495	    def _declaration_head_in_txn(
   496	        self, conn: Any, lineage_id: str
   497	    ) -> tuple[int, str] | None:
   498	        """The ``(record_ordinal, id)`` of the newest self-lineage declaration.
   499	
   500	        The CAS token names the axis this store actually accretes on. Its
   501	        first coordinate is the ARRIVAL ordinal of the log record whose
   502	        expansion carries the row — so the rows of one batch record (a
   503	        multi-change edit ceremony) share an ordinal and the tie-break falls
   504	        to the fact id, which is the one place this axis is observably not
   505	        the index's rowid.
   506	
   507	        The predicate is the base class's, verbatim: own genesis
   508	        participates, and a foreign ``_decl.*`` row is excluded by the
   509	        lineage its payload stamps. Only the coordinate changed.
   510	
   511	        The log answers, because the log is the store. No ordinal column, no
   512	        side table: a second place the coordinate is written is a second
   513	        thing that can disagree with the log, and the indexer/re-deriver
   514	        disagreement is the one this family does not tolerate. The cost is
   515	        one forward walk per read — twice per edit ceremony, and ceremonies
   516	        are rare.
   517	
   518	        Bounded at the reconciled position rather than at end-of-file. The
   519	        ceremony reads this INSIDE its transaction, having reconciled
   520	        against a specific prefix; a record another writer lands mid-ceremony
   521	        is :meth:`_ceremony_persist`'s ``following`` refusal to judge, not
   522	        this read's, and the bound also keeps a walk from reaching a tail
   523	        that is mid-append.
   524	        """
   525	        mark = self._read_mark()
   526	        if mark is None:
   527	            return None
   528	        best: tuple[int, str] | None = None
   529	        for record in self._log.walk():
   530	            ordinal = record["ord"]
   531	            if ordinal > mark.arrival_ordinal:
   532	                break
   533	            for kind_of_row, row in rows_of_record(record):
   534	                if kind_of_row != "fact":
   535	                    continue
   536	                fact_id, kind, payload_text = row[0], row[1], row[5]
   537	                if not kind.startswith("_decl."):
   538	                    continue
   539	                if fact_id == lineage_id:
   540	                    pass  # own genesis participates
   541	                else:
   542	                    try:
   543	                        payload = json.loads(payload_text)
   544	                    except (json.JSONDecodeError, TypeError):
   545	                        continue
   546	                    if payload.get("lineage") != lineage_id:
   547	                        continue
   548	                candidate = (ordinal, fact_id)
   549	                if best is None or candidate > best:
   550	                    best = candidate
   551	        return best
   552	
   553	    # ---- ceremonies -------------------------------------------------------
   554	
   555	    def _genesis_lineage_id(self) -> str:
   556	        """The declaration genesis row projects the ARRIVAL lineage.
   557	
   558	        ``store_meta.own_lineage`` is stamped with this same value by the
   559	        base ceremony, so identity is written from arrival, read from
   560	        sqlite, and re-derivable from the log with every projection gone —
   561	        the strongest assertion in the cut's gate. The row id being the
   562	        lineage id preserves the legacy invariant the CAS head-tracking
   563	        keys off.
   564	        """
   565	        try:
   566	            return self._log.lineage()
   567	        except GenesisRefused as exc:
   568	            raise GenesisRefused(
   569	                f"{self._log.path} has no arrival genesis — the declaration "
   570	                "absorb is movement 2; mint the arrival genesis (movement 1, "
   571	                "with the founding key) first"
   572	            ) from exc
   573	
   574	    def _genesis_payload(self, protocol: int, documents: list) -> dict[str, Any]:
   575	        """``{protocol, documents}`` — the era pins dissolve.
   576	
   577	        The old cursor pin's claim ("everything before me predates
   578	        historization") is ``ord < N``, structural under the dense ordinal;
   579	        the old chain-head pin was a tick-row hash, a projection artifact a
   580	        signed immutable record must not rest an integrity claim on
   581	        (arrival law 1). A later cut that wants a tick anchor names an
   582	        arrival coordinate, not a row hash.
   583	        """
   584	        return {"protocol": protocol, "documents": list(documents)}
   585	
   586	    def adopt_lineage(self, lineage_id: str | None = None) -> dict[str, Any]:
   587	        """Refused: an arrival store's identity is structural at ordinal 0.
   588	
   589	        There is nothing to adopt — the log's genesis IS the identity, and
   590	        foreign genesis records cannot exist above ordinal 0. Restamping the
   591	        ``own_lineage`` projection marker from the log is projection repair,
   592	        which :meth:`catch_up` does when the marker is absent and
   593	        :func:`engine.arrival_projection.rederive_projections` does when it
   594	        re-derives everything; deleting this ceremony would break the legacy
   595	        modes that still need it. Refusal keeps both doors open.
   596	        """
   597	        raise ArrivalCanonicalUnsupported(
   598	            "adopt is not a ceremony an arrival-canonical store has: "
   599	            "identity is the arrival genesis at ordinal 0, structurally — "
   600	            "there is nothing to choose between. If the own_lineage marker "
   601	            "is missing, reopening the store restores it from the log "
   602	            "(catch-up), and engine.arrival_projection.rederive_projections "
   603	            "restores it alongside every other projection row."
   604	        )
