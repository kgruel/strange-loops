    20	_SCHEMA = """\
    21	CREATE TABLE IF NOT EXISTS facts (
    22	    id       TEXT NOT NULL PRIMARY KEY,
    23	    kind     TEXT NOT NULL,
    24	    ts       REAL NOT NULL,
    25	    observer TEXT NOT NULL,
    26	    origin   TEXT NOT NULL DEFAULT '',
    27	    payload  TEXT NOT NULL CHECK (json_valid(payload)),
    28	    signature TEXT
    29	);
    30	CREATE INDEX IF NOT EXISTS idx_facts_kind ON facts(kind);
    31	CREATE INDEX IF NOT EXISTS idx_facts_ts   ON facts(ts);
    32	
    33	CREATE TABLE IF NOT EXISTS ticks (
    34	    id           TEXT NOT NULL PRIMARY KEY,
    35	    name         TEXT NOT NULL,
    36	    ts           REAL NOT NULL,
    37	    since        REAL,
    38	    origin       TEXT NOT NULL,
    39	    payload      TEXT NOT NULL CHECK (json_valid(payload)),
    40	    prev_hash    TEXT,
    41	    window_start TEXT,
    42	    fact_cursor  TEXT,
    43	    window_hash  TEXT
