   164	def _append_drafts(
   165	    ledger: Any,
   166	    current_head: Head,
   167	    drafts: Sequence[RecordDraft],
   168	    chunk_size: int = 500,
   169	) -> Head:
   170	    """Append drafts through AttestedLedger in chunks using ordinary contract append."""
   171	    head = current_head
   172	    for i in range(0, len(drafts), chunk_size):
   173	        chunk_drafts = drafts[i : i + chunk_size]
   174	        commit = ledger.append(expected=head, drafts=chunk_drafts)
   175	        head = commit.after
   176	    return head
