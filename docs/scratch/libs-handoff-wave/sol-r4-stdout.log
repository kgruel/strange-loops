   620	        inner = line[open_idx + 1 : close_idx].strip()
   621	        closing_indent = line[: len(line) - len(line.lstrip())]
   622	        # Preserve the COMPLETE suffix after the matching close — a trailing
   623	        # comment (`} // note`) must survive the expansion (SOL-R2-05).
   624	        closing = closing_indent + "}" + line[close_idx + 1 :].rstrip()
