    67	class TestFactAttestation:
    68	    def test_signed_store_signing_observer_signed_true_and_row_verifies(
    69	        self, tmp_path, canonical,
    70	    ):
    71	        """Oracle 1: signed=True AND the committed row verifies via the
    72	        verify machinery — cross-checked, not the receipt's own claim."""
    73	        store = _store(tmp_path, canonical,
    74	                       fact_signer=_fake_signer_for({"alice"}))
    75	        v = _vertex(store)
    76	        receipt = v.receive_receipt(Fact.of("note", "alice", n=1))
    77	
    78	        assert receipt.stored
    79	        assert receipt.attestation == FactAttestation(
    80	            signed=True, observer="alice", signature_present=True,
    81	        )
    82	        report = store.verify_facts(verifier=_fake_verifier)
    83	        assert report["ok"] is True
    84	        assert report["signed"] == 1
    85	        assert report["sig_checked"] is True
