   356	    if presented.ordinal == remembered.ordinal:
   357	        # Equal ordinal, and not equal heads, so the hashes differ.
   358	        return Outcome.SAME_HEIGHT_FORK
   359	    if at_known != remembered:
   360	        return Outcome.REWRITE
   361	    return Outcome.ADVANCED
   362	
   363	
   364	def compare_absent_store(known: HeadAttestation | None) -> AbsentStoreOutcome:
   365	    """Judge a location whose log is absent or empty (§D.4).
   366	
   367	    ``verify(Open())`` on a missing or empty log refuses with
   368	    ``GenesisRefused``, so the seam must branch on that rather than treat it
   369	    as corruption — an absent store is the ordinary state of a location a
   370	    moment before it is minted into.
   371	
   372	    The split is on memory, not on the store: with nothing remembered this is
   373	    pre-genesis and refusing would make minting impossible; with a head
   374	    remembered it is a loss, and proceeding would license a silent re-mint
   375	    under a remembered lineage.
   376	    """
   377	    return (
   378	        AbsentStoreOutcome.PRE_GENESIS
   379	        if known is None
   380	        else AbsentStoreOutcome.STORE_LOST
   381	    )
   382	
   383	
   384	#: Which refusal each refusing outcome raises. The mapping lives here so the
   385	#: seam does not re-implement the posture table, and so "which outcomes
   386	#: refuse" is one enumerable fact rather than a chain of ``if`` statements in
   387	#: whatever calls the classifier.
   388	REFUSALS: dict[Outcome, type[AttestationRefusal]] = {
   389	    Outcome.ROLLBACK: HeadRollback,
   390	    Outcome.SAME_HEIGHT_FORK: HeadFork,
   391	    Outcome.REWRITE: HeadRewrite,
   392	    Outcome.LINEAGE_REPLACED: LineageReplaced,
   393	}
   394	
   395	#: The same table for the absent-store split.
   396	ABSENT_STORE_REFUSALS: dict[AbsentStoreOutcome, type[AttestationRefusal]] = {
   397	    AbsentStoreOutcome.STORE_LOST: StoreLost,
   398	}
   399	
   400	
   401	def refusal_for(
   402	    outcome: Outcome | AbsentStoreOutcome,
   403	) -> type[AttestationRefusal] | None:
   404	    """The refusal this outcome raises, or None if it proceeds."""
   405	    if isinstance(outcome, AbsentStoreOutcome):
   406	        return ABSENT_STORE_REFUSALS.get(outcome)
   407	    return REFUSALS.get(outcome)
   408	
   409	
   410	# ---------------------------------------------------------------------------
   411	# Where the journal lives (§A.3)
   412	# ---------------------------------------------------------------------------
   413	
   414	#: Conservative: a leading alphanumeric, then alphanumerics, dot, dash,
   415	#: underscore. A ULID passes; a path separator, a leading dot, an empty
   416	#: string, a traversal segment and a name long enough to trouble a filesystem
   417	#: all fail. Narrow by intent — widening it later is additive, and every
   418	#: character admitted is a character some filesystem treats specially.
   419	_SAFE_LINEAGE = re.compile(r"\A[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")
   420	
   421	#: Names the heads directory already spends on something else. ``bindings``
   422	#: is the transitional binding file below, and a lineage literally named
   423	#: "bindings" would otherwise write its observations into it. Compared
   424	#: case-folded because the filesystems this runs on are commonly
   425	#: case-insensitive, so ``BINDINGS`` collides just as hard.
   426	_RESERVED_LINEAGE_NAMES = frozenset({"bindings"})
   427	
   428	#: The journal grammar version. A literal rather than an import of
   429	#: ``engine.arrival.GRAMMAR_VERSION``: reaching for it would drag the whole
   430	#: file codec into a module whose readability must not depend on it, and the
   431	#: two version each other independently anyway — this is the journal's
   432	#: grammar, not the record grammar.
   433	_JOURNAL_VERSION = 1
   434	
   435	#: Stated in the header so a journal written under wire v1 is never silently
   436	#: compared against a v2 head whose hashes derive differently.
   437	_PROTOCOL_VERSION = 1
   438	_WIRE_VERSION = 1
   439	
   440	#: The serialized ``type``. Never bare "attestation" — see the module
   441	#: docstring's vocabulary note.
   442	_OBSERVATION_TYPE = "arrival-head-observation"
   443	
   444	
   445	def state_root() -> Path:
   446	    """The per-user state root for loops, honoring ``XDG_STATE_HOME``.
   447	
   448	    A *state* root, not a config root, and that separation is the whole
   449	    threat-model argument: the live config-level stores are themselves under
   450	    ``$XDG_CONFIG_HOME/loops``, so a memory kept there would share a restore
   451	    boundary with the very stores it witnesses. Same for a sibling file beside
   452	    the store, for ``.loops/state/``, and for git tracking as a sole home. A
   453	    state root is outside all of them.
   454	
   455	    Follows ``vertex_reader._loops_home()``'s idiom for the config root, with
   456	    the standard ``~/.local/state`` fallback, so tests can point it at a
   457	    temporary directory the way the CLI tests already do for config.
   458	    """
   459	    xdg = os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local" / "state"))
   460	    return Path(xdg) / "loops"
   461	
   462	
   463	def heads_dir() -> Path:
   464	    """Where head journals live: one file per lineage."""
   465	    return state_root() / "heads"
   466	
   467	
   468	def journal_path(lineage: str) -> Path:
   469	    """The journal for this lineage, refusing a name it cannot safely key on.
   470	
   471	    **Keyed by lineage, not by path**, and that is the load-bearing half of
   472	    the design. A worktree gets no project store of its own, so a path-keyed
   473	    cache would manufacture a fresh first contact per worktree — silent
   474	    re-acceptance through the back door, on the most ordinary operation there
   475	    is. A restored old copy opened at a *new* path still presents its lineage,
   476	    still finds this journal, and is still classified a rollback.
   477	    """
   478	    if not _SAFE_LINEAGE.match(lineage) or lineage.casefold() in _RESERVED_LINEAGE_NAMES:
   479	        raise UnsafeLineageName(
   480	            f"lineage {lineage!r} cannot be used as a head-journal filename; "
   481	            "this says nothing about the store, only that the cache cannot "
   482	            "key on that string"
   483	        )
   484	    return heads_dir() / f"{lineage}.jsonl"
   485	
   486	
   487	# ---------------------------------------------------------------------------
   488	# Serialization (§B.3)
   489	# ---------------------------------------------------------------------------
   490	
   491	
   492	def _header_line() -> str:
   493	    """The first line of a new journal: what this file is."""
   494	    return (
   495	        json.dumps(
   496	            {
   497	                "v": _JOURNAL_VERSION,
   498	                "type": _OBSERVATION_TYPE,
   499	                "protocol": _PROTOCOL_VERSION,
   500	                "wire": _WIRE_VERSION,
   501	            },
   502	            separators=(",", ":"),
   503	            sort_keys=True,
   504	        )
   505	        + "\n"
   506	    )
   507	
   508	
   509	def _entry_line(entry: HeadAttestation) -> str:
   510	    """One entry as one line.
   511	
   512	    ``location`` and ``note`` are omitted when empty. They are diagnosis, so
   513	    absent and empty carry the same (absence of a) claim, and leaving them out
   514	    keeps a line that is appended on every commit small.
   515	    """
   516	    record: dict[str, object] = {
   517	        "v": _JOURNAL_VERSION,
   518	        "kind": entry.kind.value,
   519	        "level": entry.level.value,
   520	        "lineage": entry.head.lineage,
   521	        "ordinal": entry.head.ordinal,
   522	        "record_hash": entry.head.record_hash,
   523	        "observed_at": entry.observed_at,
   524	    }
   525	    if entry.location:
   526	        record["location"] = entry.location
   527	    if entry.note:
   528	        record["note"] = entry.note
   529	    return json.dumps(record, separators=(",", ":"), sort_keys=True) + "\n"
   530	
   531	
   532	def _parse_entry(raw: object) -> HeadAttestation | None:
   533	    """One decoded JSON line as an entry, or None if this build cannot read it.
   534	
   535	    None means "a later build wrote something this one does not understand",
   536	    and the caller skips and reports it. It does **not** mean malformed —
   537	    malformed JSON never reaches here.
   538	
   539	    §B.3's forward-compatibility promise, **as re-scoped by the gate**: an
   540	    entry from a later build is skipped and reported, never refused *on its
   541	    own account*. That much survives verbatim, and it is what keeps a shared
   542	    journal from bricking an older build. What it never licensed is the
   543	    stronger reading — that a comparison holding **zero** readable evidence
   544	    should proceed. Declining there refuses no entry; it declines a question
   545	    nothing left in the journal can answer, and the alternative is
   546	    trust-on-first-use granted precisely because the journal became
   547	    unreadable (:class:`HeadUnreadable`).
   548	
   549	    The version-skew consequence, stated rather than hidden: an older build
   550	    reading a purely newer journal declines its comparisons. Resolution is
   551	    operator work — run the newer build, or the trust-reset ceremony.
   552	
   553	    Unknown *fields* need no handling at all: the journal is append-only and
   554	    never rewritten, so fields this build does not name are preserved on disk
   555	    by construction and ignored here.
   556	    """
   557	    if not isinstance(raw, dict):
   558	        return None
   559	    if raw.get("v") != _JOURNAL_VERSION:
   560	        return None
   561	    if "kind" not in raw:
   562	        # The header, or a future sibling of it. Not an entry; not damage.
   563	        return None
   564	    try:
   565	        kind = Kind(raw["kind"])
   566	        level = Level(raw["level"])
   567	    except (KeyError, ValueError):
   568	        return None
   569	    lineage = raw.get("lineage")
   570	    ordinal = raw.get("ordinal")
   571	    record_hash = raw.get("record_hash")
   572	    observed_at = raw.get("observed_at")
   573	    if (
   574	        not isinstance(lineage, str)
   575	        or not isinstance(ordinal, int)
   576	        or isinstance(ordinal, bool)
   577	        or not isinstance(record_hash, str)
   578	        or not isinstance(observed_at, (int, float))
   579	        or isinstance(observed_at, bool)
   580	    ):
   581	        return None
   582	    return HeadAttestation(
   583	        head=Head(lineage=lineage, ordinal=ordinal, record_hash=record_hash),
   584	        kind=kind,
   585	        level=level,
   586	        observed_at=float(observed_at),
   587	        location=raw["location"] if isinstance(raw.get("location"), str) else "",
   588	        note=raw["note"] if isinstance(raw.get("note"), str) else "",
   589	    )
   590	
   591	
   592	# ---------------------------------------------------------------------------
   593	# Reading the journal (§B.3's three read rules)
   594	# ---------------------------------------------------------------------------
   595	
   596	
   597	@dataclass(frozen=True)
   598	class EstablishedHead:
   599	    """*K*, from an epoch every line of which was readable.
   600	
   601	    The head, full stop: a presented head equal to this one IS unchanged, and
   602	    all seven comparison rows are sound against it.
   603	    """
   604	
   605	    entry: HeadAttestation
   606	
   607	
   608	@dataclass(frozen=True)
   609	class HeadLowerBound:
   610	    """*K* is **at least** this. Lines in the epoch could not be read.
   611	
   612	    An unreadable line carries no information about the ordinal it held, so
   613	    the readable entries bound the accepted head from below and nothing bounds
   614	    it from above. Deliberately **no** ``entry`` attribute: the field is named
   615	    ``at_least`` so that no expression reaches a head from this type without
   616	    naming the weaker claim, and so a caller cannot reach one uniformly across
   617	    both cases.
   618	
   619	    What a bound can and cannot answer:
   620	
   621	    * **Sound.** A presented head *below* the bound is a rollback — the
   622	      accepted head is at least the bound, so it is certainly above what is
   623	      being presented.
   624	    * **Unsound, and this is the trap.** A presented head *equal to* the bound
   625	      is not unchanged; it may be a rollback from the very entry that could
   626	      not be read.
   627	    * **Unsound for the same reason, one step further.** A presented head
   628	      *above* the bound is not an advance either. Nothing bounds the accepted
   629	      head from above, so a head at ordinal 95 may still sit below a lost
   630	      entry at 200 — and descent verified from the bound says nothing about
   631	      an entry that was never on the walk. Both proceed answers are
   632	      unobtainable; only the refusal below the bound survives.
   633	
   634	    **Gathering evidence from the store does not resolve any of this** — a
   635	    walk verifies the store's own chain, and the missing fact is about what
   636	    this machine previously ACCEPTED, which the store never knew. Recovering
   637	    it means repairing the journal or running the trust-reset ceremony, both
   638	    of which are operator work.
   639	    """
   640	
   641	    at_least: HeadAttestation
   642	    skipped: tuple[str, ...]
   643	
   644	
   645	@dataclass(frozen=True)
   646	class HeadUnreadable:
   647	    """The journal claimed content and **none of it** could be read.
   648	
   649	    The third state, and it is not the absence of one. An empty journal says
   650	    "nothing was ever accepted here" and first-contact TOFU is the honest
   651	    answer to it. A journal holding lines this build cannot read says
   652	    something else entirely: heads WERE accepted, and their ordinals are
   653	    exactly what has been lost. Collapsing the two would let a journal be
   654	    trusted on first use precisely because it became unreadable, which is the
   655	    silent re-acceptance every rule in this module exists to prevent
   656	    (``finding:s3wp1-gate-all-entries-unreadable-silent-tofu``).
   657	
   658	    Carries no ordinal, deliberately and by construction. :class:`HeadLowerBound`
   659	    can at least refuse anything below its bound; here there is no bound, so
   660	    **every** comparison declines — rollback included. There is nothing to
   661	    compare against.
   662	    """
   663	
   664	    skipped: tuple[str, ...]
   665	
   666	
   667	@dataclass(frozen=True)
   668	class JournalRead:
   669	    """Everything a caller needs from one pass over a journal.
   670	
   671	    One structure because the ratified scope's three artifacts — a cached
   672	    head, a bootstrap receipt at migration, and a periodic full-audit entry —
   673	    dissolve into one append-only journal: the remembered head is the
   674	    highest-ordinal entry, the bootstrap receipt is the first entry, an audit
   675	    entry is an entry.
   676	    """
   677	
   678	    entries: tuple[HeadAttestation, ...]
   679	    """Every readable entry, in the order the file holds them."""
   680	
   681	    epoch: tuple[HeadAttestation, ...]
   682	    """The current trust epoch: the last trust-reset entry and everything after
   683	    it, or all entries when there has never been a reset."""
   684	
   685	    known: EstablishedHead | HeadLowerBound | HeadUnreadable | None
   686	    """*K*, and how much of a claim it is. See the two types.
   687	
   688	    Two types rather than a head plus a flag, deliberately: the weakened case
   689	    has no ``entry`` attribute at all, so there is no expression that reaches
   690	    a comparable head without first saying which case it is in."""
   691	
   692	    bootstrap: HeadAttestation | None
   693	    """The journal's first entry, whatever epoch it belongs to. A journal
   694	    beginning at :attr:`Level.MINT` was witnessed from genesis forward; one
   695	    beginning at :attr:`Level.FIRST_CONTACT` was trusted on sight, and that
   696	    label is permanent."""
   697	
   698	    skipped: tuple[str, ...]
   699	    """Lines this build could not use, each with why. Reported rather than
   700	    swallowed: a tolerated loss that nobody is told about is just a loss."""
   701	
   702	    def established_head(self) -> HeadAttestation | None:
   703	        """*K* for a full comparison, or a refusal if the read was incomplete.
   704	
   705	        This is the only way to obtain an argument for :func:`compare`, and it
   706	        refuses rather than answering when any epoch line was unreadable. That
   707	        refusal is the point: against an incomplete journal the cheap
   708	        "presented equals *K*, therefore unchanged" shortcut is not merely
   709	        discouraged, it is unobtainable.
   710	        """
   711	        if isinstance(self.known, HeadLowerBound):
   712	            raise IndeterminateComparison(
   713	                "this journal has unreadable lines in the current trust "
   714	                f"epoch, so its head is only known to be at or above ordinal "
   715	                f"{self.known.at_least.head.ordinal}; a presented head cannot "
   716	                "be called unchanged or advanced against a bound. Unreadable: "
   717	                + "; ".join(self.known.skipped)
   718	            )
   719	        if isinstance(self.known, HeadUnreadable):
   720	            raise IndeterminateComparison(
   721	                "this journal holds content but none of it is readable by "
   722	                "this build, so nothing is known about the head it accepted "
   723	                "— not even a lower bound. This is NOT first contact: heads "
   724	                "were accepted here. Unreadable: "
   725	                + "; ".join(self.known.skipped)
   726	            )
   727	        return self.known.entry if self.known is not None else None
   728	
   729	
   730	def _epoch_of(
   731	    entries: tuple[HeadAttestation, ...],
   732	) -> tuple[HeadAttestation, ...]:
   733	    """The entries in the current trust epoch, reset-INCLUSIVE.
   734	
   735	    Epoch scoping is what keeps the ceremony and the max-ordinal rule from
   736	    deadlocking each other. After an operator accepts a restore from ordinal
   737	    100 back to 90, the abandoned entries at 91-100 still hold the maximum
   738	    ordinal; unscoped, *K* would read as the head that was deliberately
   739	    abandoned and every subsequent open would refuse a rollback forever. Those
   740	    entries are retained as **evidence, not as claims** — which is the whole
   741	    point of recording the gap.
   742	
   743	    **Inclusive of the reset entry**, not merely the entries after it. The
   744	    reset entry carries the head the operator accepted; scoping it out would
   745	    leave a just-reset journal with an empty epoch, *K* of None, and a next
   746	    open classifying first contact — the deadlock's mirror image, and silent
   747	    re-acceptance by a different route.
   748	    """
   749	    for index in range(len(entries) - 1, -1, -1):
   750	        if entries[index].kind is Kind.TRUST_RESET:
   751	            return entries[index:]
   752	    return entries
   753	
   754	
   755	def _known_of(epoch: tuple[HeadAttestation, ...]) -> HeadAttestation | None:
   756	    """*K*: the maximum-ordinal entry of the epoch, not the last line.
   757	
   758	    Two writers append concurrently — the arrival lock serializes their
   759	    *appends*, not their journal writes — so lines can land out of order: A
   760	    commits ordinal 5, B commits 6 and journals it, A journals 5 last.
   761	    Last-line semantics would then read K=5 and classify a genuine restore to
   762	    5 as unchanged. Maximum-ordinal closes it, and duplicate entries at one
   763	    ordinal are harmless.
   764	    """
   765	    if not epoch:
   766	        return None
   767	    best = max(epoch, key=lambda entry: entry.head.ordinal)
   768	    tied = {
   769	        entry.head.record_hash
   770	        for entry in epoch
   771	        if entry.head.ordinal == best.head.ordinal
   772	    }
   773	    if len(tied) > 1:
   774	        raise JournalEquivocation(
   775	            f"journal holds {len(tied)} different records at ordinal "
   776	            f"{best.head.ordinal} in the current trust epoch: "
   777	            f"{', '.join(sorted(tied))}"
   778	        )
   779	    return best
   780	
   781	
   782	def _is_header(decoded: object) -> bool:
   783	    """Whether this line is a journal header — by SHAPE, never by position.
   784	
   785	    Keyed on the ``type`` string a header carries. An earlier version treated
   786	    ANY dict without ``kind`` as a header, which absorbed ``{}`` — and every
   787	    other kindless dict — **silently, with no skip recorded**: a second byte
   788	    pattern through which a line could be lost without being reported, and so
   789	    a second route to the classification the journal exists to prevent
   790	    (``finding:s3wp1-gate-kindless-dict-absorbed-as-header``). Anything that
   791	    is not this shape and is not an entry is a skipped line like any other.
   792	
   793	    Deliberately keyed on the type rather than on ``protocol``/``wire`` as
   794	    well, so a later build that adds header fields is still recognized. A
   795	    header naming a DIFFERENT type is not this journal's header and is not
   796	    treated as one.
   797	    """
   798	    return (
   799	        isinstance(decoded, dict)
   800	        and "kind" not in decoded
   801	        and decoded.get("type") == _OBSERVATION_TYPE
   802	    )
   803	
   804	
   805	def parse_journal_lines(lines: Iterable[str]) -> JournalRead:
   806	    """Read a journal from its raw lines. Pure — no filesystem.
   807	
   808	    The pure half is separate so the conformance vectors can hand it raw log
   809	    lines and so every read rule is testable without a temporary directory.
   810	
   811	    **Every unreadable line is skipped and reported, wherever it sits.** The
   812	    earlier design distinguished a torn final line from damage further up and
   813	    refused the latter, on the reasoning that skipping could silently lower
   814	    *K*. Skipping CAN lower *K* — concurrent writers journal out of order, so
   815	    the epoch maximum is not the last line and damage anywhere can take it
   816	    (``finding:s3wp1-epoch-ordinals-do-not-ascend-in-file-order``). But
   817	    refusing was the wrong answer to it. It made an ordinary crash a permanent
   818	    incident, and it claimed a protection this location cannot deliver: anyone
   819	    who can corrupt a line here can delete the whole journal instead and be
   820	    met with trust-on-first-use. So the loss is **carried in the result type**
   821	    — :class:`HeadLowerBound` — rather than converted into a verdict, and the
   822	    positional rule dissolves along with the distinction it enforced.
   823	
   824	    :class:`JournalUnreadable` survives for structural damage that breaks the
   825	    read itself: entries with no header. The header states the protocol and
   826	    wire versions the hashes derive under, and comparing hashes whose
   827	    derivation is unknown is not a weaker answer, it is a meaningless one.
   828	    """
   829	    entries: list[HeadAttestation] = []
   830	    skipped: list[str] = []
   831	    header_seen = False
   832	    for index, line in enumerate(lines):
   833	        stripped = line.strip()
   834	        if not stripped:
   835	            continue
   836	        try:
   837	            decoded = json.loads(stripped)
   838	        except ValueError as exc:
   839	            skipped.append(f"line {index + 1}: does not parse ({exc})")
   840	            continue
   841	        if _is_header(decoded):
   842	            # Not tracked by position: two writers racing to create the same
   843	            # journal can each write one, so "the header is line 1" is not a
   844	            # property this reader may assume.
   845	            header_seen = True
   846	            continue
   847	        entry = _parse_entry(decoded)
   848	        if entry is None:
   849	            skipped.append(f"line {index + 1}: not readable by this build")
   850	            continue
   851	        entries.append(entry)
   852	
   853	    frozen = tuple(entries)
   854	    if frozen and not header_seen:
   855	        raise JournalUnreadable(
   856	            f"journal holds {len(frozen)} entries but no header, so the "
   857	            "protocol and wire versions their hashes derive under are unknown"
   858	        )
   859	    epoch = _epoch_of(frozen)
   860	    best = _known_of(epoch)
   861	    known: EstablishedHead | HeadLowerBound | HeadUnreadable | None
   862	    if best is not None:
   863	        known = (
   864	            HeadLowerBound(at_least=best, skipped=tuple(skipped))
   865	            if skipped
   866	            else EstablishedHead(entry=best)
   867	        )
   868	    elif skipped:
   869	        # Content was claimed and none of it could be read. NOT first contact.
   870	        known = HeadUnreadable(skipped=tuple(skipped))
   871	    else:
   872	        known = None
   873	    return JournalRead(
   874	        entries=frozen,
   875	        epoch=epoch,
   876	        known=known,
   877	        bootstrap=frozen[0] if frozen else None,
   878	        skipped=tuple(skipped),
   879	    )
   880	
   881	
   882	def read_journal(lineage: str) -> JournalRead:
   883	    """This lineage's journal, or an empty read if it has none.
   884	
   885	    An absent journal is not a fault — it is first contact, and answering
   886	    with an empty read rather than raising is what lets the classifier say so.
   887	    """
   888	    path = journal_path(lineage)
   889	    try:
   890	        text = path.read_text(encoding="utf-8")
   891	    except FileNotFoundError:
   892	        return JournalRead(
   893	            entries=(), epoch=(), known=None, bootstrap=None, skipped=()
   894	        )
   895	    return parse_journal_lines(text.splitlines(keepends=True))
