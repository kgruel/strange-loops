   393	def _verdict(canonical: Path, report: AgreementReport) -> tuple[str, str]:
   394	    """An ``AgreementReport`` as a (status, reason) pair for the vocabulary.
   395	
   396	    ``index-behind`` re-states the report's own scope-limited flag; the
   397	    reason keeps its wording so no caller upgrades it to an innocence claim.
   398	    """
   399	    if report.ok:
   400	        return "ok", "log and index agree"
   401	    if any(c.name == "log" and not c.ok for c in report.checks):
   402	        return "unreadable", report.summary()
   403	    if report.index_behind:
   404	        return "index-behind", report.summary()
   405	    return "diverged", report.summary()
