   268	    kind: str, ts: float, observer: str, origin: str, payload_text: str
   269	) -> str:
   270	    """Content commitment hash for fact signing (see _fact_commitment_hash)."""
   271	    return _fact_commitment_hash(kind, ts, observer, origin, payload_text)
