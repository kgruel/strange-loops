   401	def _read_arrival_source(canonical: Path) -> _SourceRows:
   402	    """Walk the source's arrival log from ordinal 0, in ORDINAL order.
   403	
   404	    NON-NEGOTIABLE. Merging is replaying the source's arrival into the
   405	    target's arrival; it consumes no event-time input at all. Structural
   406	    records expand to no rows and so contribute no group — a lineage's
   407	    genesis and its key introductions belong to that lineage, and carrying
   408	    them across would claim the target's log opened them.
   409	    """
   410	    from engine.arrival import ArrivalLog
   411	    from engine.arrival_projection import rows_of_record
   412	
   413	    groups: list[tuple[str, list[tuple[str, tuple]], int | None]] = []
   414	    facts = ticks = 0
   415	    for record in ArrivalLog(canonical).walk():
   416	        rows = rows_of_record(record)
   417	        if not rows:
   418	            continue
   419	        groups.append((record["k"], rows, record["ord"]))
   420	        for t, _row in rows:
   421	            if t == "fact":
   422	                facts += 1
   423	            else:
