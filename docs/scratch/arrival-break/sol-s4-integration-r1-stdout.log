   100	
   101	    per_kind_counts: dict[str, int] = defaultdict(int)
   102	    observer_census: dict[str, int] = defaultdict(int)
   103	    id_era_census: dict[str, int] = {
   104	        "canonical-ulid": 0,
   105	        "lowercase-ulid": 0,
   106	        "other": 0,
