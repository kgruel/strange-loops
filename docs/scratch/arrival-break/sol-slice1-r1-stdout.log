    62	    "LOCK_SUFFIX",
    63	    "TMP_SUFFIX",
    64	    "GRAMMAR_VERSION",
    65	    "GENESIS_KIND",
    66	    "KEY_INTRODUCTION_KIND",
    67	    "RECORD_FIELDS",
