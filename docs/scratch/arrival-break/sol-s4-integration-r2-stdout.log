+from __future__ import annotations
+
+import json
+import tempfile
+from pathlib import Path
+
+from migrate import LegacySourceRefused, inventory
+
+
+def fact(row_id: str, observer: object = ...) -> dict[str, object]:
+    row: dict[str, object] = {
+        "t": "fact",
+        "id": row_id,
+        "kind": "probe",
+        "ts": 1.0,
+        "origin": "probe",
+        "payload": "{}",
+    }
+    if observer is not ...:
+        row["observer"] = observer
+    return row
+
+
+cases = {
+    "empty": ([fact("a", "alice"), fact("b", "bob"), fact("c", "")], {"empty": 1, "missing": 0}),
+    "missing": ([fact("a", "alice"), fact("b", "bob"), fact("c")], {"empty": 0, "missing": 1}),
+    "both": (
+        [fact("a", "alice"), fact("b", "bob"), fact("c", ""), fact("d")],
+        {"empty": 1, "missing": 1},
+    ),
+    "none": ([fact("a", "alice"), fact("b", "bob")], {"empty": 0, "missing": 0}),
+}
+
+with tempfile.TemporaryDirectory(dir="/tmp/sol-s4-r2") as tmp:
+    root = Path(tmp)
+    for name, (rows, census) in cases.items():
+        source = root / f"{name}.jsonl"
+        source.write_text(json.dumps({"t": "batch", "rows": rows}) + "\n", encoding="utf-8")
+        try:
+            inventory(source)
+        except LegacySourceRefused as exc:
+            print(f"{name}: mixed={exc.mixed_observer_lines!r} absent={exc.absent_observer_lines!r}")
+            assert exc.mixed_observer_lines == ((1, ("alice", "bob"), census),)
+            assert exc.absent_observer_lines == ()
+            message = str(exc)
+            if name == "empty":
+                assert "observer='' (empty string)" in message
+            elif name == "missing":
+                assert "missing 'observer' field" in message
+            elif name == "both":
+                assert "1 missing, 1 empty ''" in message
+            else:
+                assert "row(s)" not in message.split("observers 'alice', 'bob'", 1)[1].splitlines()[0]
+        else:
+            raise AssertionError(f"{name}: mixed batch was accepted")
+
+print("PASS: ruled report-once shape and spelling-distinct mixed census hold")
