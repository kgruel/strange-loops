     1	"""Legacy SQLite reader — frozen read spine for canonical SQLite stores.
     2	
     3	Historical artifact copied from ``store.rebirth`` at commit
     4	``affe92a6fc1a034b477cbc068cc563f6e5ca69e6``.
     5	
     6	This module provides the READ-ONLY SQLite spine for migration:
     7	- Open legacy SQLite databases strictly read-only (URI mode ``file:...?mode=ro``);
     8	- Compute witness-order content hash (verifiable claim);
     9	- Read historical fact rows and tick columns in witness (rowid) order.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import hashlib
    15	import json
    16	import sqlite3
    17	from pathlib import Path
    18	
    19	from .legacy_ids import FactRow
    20	
    21	__all__ = [
    22	    "open_legacy_sqlite",
    23	    "read_facts",
    24	    "read_ticks",
    25	    "_tick_columns",
    26	    "_facts_have_signature",
    27	    "_content_sha256",
    28	]
    29	
    30	_TICK_BASE_COLS = ("id", "name", "ts", "since", "origin", "payload")
    31	_TICK_CHAIN_COLS = (
    32	    "prev_hash",
    33	    "window_start",
    34	    "fact_cursor",
    35	    "window_hash",
    36	    "signature",
    37	)
    38	
    39	
    40	def open_legacy_sqlite(path: Path | str) -> sqlite3.Connection:
    41	    """Open a legacy SQLite database strictly read-only."""
    42	    path_obj = Path(path).resolve()
    43	    if not path_obj.exists():
    44	        raise FileNotFoundError(f"Legacy sqlite source not found: {path_obj}")
    45	    return sqlite3.connect(f"file:{path_obj}?mode=ro", uri=True)
    46	
    47	
    48	def _tick_columns(conn: sqlite3.Connection) -> list[str]:
    49	    """Tick columns present in this store, canonical order, era-aware."""
    50	    have = {r[1] for r in conn.execute("PRAGMA table_info(ticks)")}
    51	    return [c for c in (*_TICK_BASE_COLS, *_TICK_CHAIN_COLS) if c in have]
    52	
    53	
    54	def _facts_have_signature(conn: sqlite3.Connection) -> bool:
    55	    """Whether this store's facts table carries the delta-3 signature column."""
    56	    return "signature" in {
    57	        r[1] for r in conn.execute("PRAGMA table_info(facts)")
    58	    }
    59	
    60	
    61	def _content_sha256(conn: sqlite3.Connection) -> str:
    62	    """Witness-order content hash: every fact row in rowid order, then every tick row.
    63	
    64	    This is the SAME-FORMAT row-content identity of a SQLite store's contents.
    65	    It hashes all facts in rowid order, then all ticks in rowid order. It is
    66	    stable across re-reads and invariant to physical file rewrites (VACUUM),
    67	    but is NOT comparable across formats (JSONL hashes in line order).
    68	    """
    69	    h = hashlib.sha256()
    70	    sig_col = _facts_have_signature(conn)
    71	    for row in conn.execute(
    72	        "SELECT id, kind, ts, observer, origin, payload"
    73	        + (", signature" if sig_col else "")
    74	        + " FROM facts ORDER BY rowid"
    75	    ):
    76	        # Era-aware: the signature joins the row hash only when non-NULL,
    77	        # so a store's content hash is stable across the column's arrival
    78	        # (same posture as engine's fact row hash).
    79	        if sig_col and row[6] is None:
    80	            row = row[:6]
    81	        h.update(json.dumps(list(row), separators=(",", ":")).encode())
    82	    cols = _tick_columns(conn)
    83	    for row in conn.execute(
    84	        f"SELECT {', '.join(cols)} FROM ticks ORDER BY rowid"
    85	    ):
    86	        h.update(json.dumps(list(row), separators=(",", ":")).encode())
    87	    return h.hexdigest()
    88	
    89	
    90	def read_facts(conn: sqlite3.Connection) -> list[FactRow]:
    91	    """Read all fact rows from legacy SQLite store in rowid order."""
    92	    sig_col = _facts_have_signature(conn)
    93	    rows: list[FactRow] = []
    94	    for raw in conn.execute(
    95	        "SELECT id, kind, ts, observer, origin, payload"
    96	        + (", signature" if sig_col else "")
    97	        + " FROM facts ORDER BY rowid"
    98	    ):
    99	        rows.append(FactRow(*raw) if sig_col else FactRow(*raw, signature=None))
   100	    return rows
   101	
   102	
   103	def read_ticks(conn: sqlite3.Connection) -> list[dict]:
   104	    """Read all tick rows from legacy SQLite store in rowid order."""
   105	    cols = _tick_columns(conn)
   106	    ticks: list[dict] = []
   107	    for raw in conn.execute(
   108	        f"SELECT {', '.join(cols)} FROM ticks ORDER BY rowid"
   109	    ):
   110	        ticks.append(dict(zip(cols, raw, strict=True)))
   111	    return ticks

