   657	# Resume mark
   658	# ---------------------------------------------------------------------------
   659	
   660	
   661	@dataclass(frozen=True)
   662	class ResumeMark:
   663	    """Where a reader stopped: three fields, trusted only when all agree.
   664	
   665	    ``arrival_offset`` is the byte just past the last consumed record's
   666	    ``\\n``; ``arrival_ordinal`` is that record's ``ord``. The ordinal is the
   667	    field the old byte-offset custody could not carry, and it is why a mark
   668	    is checkable against the log alone with no projection consulted — the
   669	    property that lets a later slice rebuild projections from nothing. It is
   670	    also why the two row counts the old custody kept dissolve: the ordinal is
   671	    dense, so "how many records precede this one" is ``ord``, by
   672	    construction.
   673	
   674	    A mark that fails any check is discarded and the reader restarts from
   675	    ordinal 0. Discarding is cheap and always safe — it costs a re-read,
   676	    never data — which is why a mark may be dropped silently where a corrupt
   677	    record may not.
   678	    """
   679	
   680	    arrival_lineage: str
   681	    arrival_offset: int
   682	    arrival_ordinal: int
   683	
   684	
   685	@dataclass(frozen=True)
   686	class Entry:
   687	    """One record a batched append will assemble, minus its coordinate.
   688	
   689	    The coordinate — lineage, ordinal, ``prev`` — is the LOG's to assign, and
   690	    it can only be assigned under the lock, which is exactly why a caller
   691	    with several records to land hands over the parts it owns and lets
   692	    :meth:`ArrivalLog.append_marked_many` chain them.
   693	
   694	    There is deliberately no signer field. The one consumer is
   695	    :func:`store.merge_store`, which takes no signer and never will: the
   696	    target's operator holds no key for a foreign observer, and the grammar
   697	    makes record signatures optional above ordinal 0. A signer here would be
   698	    a parameter with no caller and an invitation to fabricate authorship.
   699	    """
   700	
   701	    k: str
   702	    body: dict
   703	    observer: str
   704	    origin: str = ""
   705	    at: float | None = None
   706	
   707	
   708	def _records_only(pairs: Iterator[tuple[dict, object]]) -> Iterator[dict]:
   709	    """Project the record out of a ``(record, position)`` pair stream.
   710	
   711	    The one mark-stripping spelling: every public walk is a projection of
   712	    the position-carrying verification loop, never a second copy of it.
   713	    """
   714	    return (record for record, _ in pairs)
