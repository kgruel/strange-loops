   632	def test_a_crashed_writers_durable_line_is_indexed_before_the_next_append(tmp_path):
   633	    """Writer A dies after fsync; long-lived writer B must not stamp past it.
   634	
   635	    B never reopens, so open-time catch-up cannot help — the reconcile has
   636	    to happen on the append itself.
   637	    """
   638	    b = open_store(tmp_path)
   639	    first = b.append(fact(message="one"))
   640	
   641	    # Writer A: line durable, index never told (the post-fsync crash window).
   642	    orphan = ("01CRASHEDA", "note", 2.0, "sol", "", json.dumps({"m": "two"}))
   643	    with (tmp_path / "s.jsonl").open("a", encoding="utf-8") as fh:
   644	        fh.write(serialize_fact_row(orphan) + "\n")
   645	
   646	    third = b.append(fact(message="three"))
   647	    b.close()
   648	
   649	    assert [r[0] for r in sqlite_facts(tmp_path / "s.db")] == [
   650	        first, "01CRASHEDA", third
   651	    ]
