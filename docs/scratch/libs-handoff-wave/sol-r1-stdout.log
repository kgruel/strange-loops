   321	        fact_id=fact_id,
   322	        rowid=rowid,
   323	        seq=seq,
   324	        lineage=marker,
   325	        unadopted=marker is None,
   326	        anchor=resolved_anchor,
   327	        store=str(Path(store_path).resolve()),
