   466	def verify_position_for_store(
   467	    at: WitnessPosition, store_path: Path, *, timeout: float = 5.0
   468	) -> WitnessPosition:
   469	    """Return the position to APPLY against ``store_path``, or refuse (A10).
   470	
   471	    A witness position's ``rowid`` is an index into ONE store's append order;
   472	    applying it to another store silently selects an unrelated prefix. Cases:
   473	
   474	    - the target store IS the store the position was resolved against (same
   475	      resolved path) — returns ``at`` unchanged (its rowid is valid, unadopted
   476	      handles included, N1);
   477	    - the position is lineage-qualified (adopted) AND the target store shares
   478	      that lineage — **re-resolves** ``at.fact_id`` in the target store and
   479	      returns the target-store position. The source rowid is NEVER reused: append
   480	      order is per-store, so a merge that copied the fact reorders it (B1c). A
   481	      fact id absent from the target raises :class:`UnknownWitnessHandle`;
   482	      - an unadopted position (no lineage) on a different store, or a lineage
   483	      mismatch, raises :class:`WitnessLineageMismatch` with teaching.
   484	
   485	    Called at every engine ``at=`` selector (``vertex_fold`` / ``vertex_facts`` /
   486	    ``resolve_declaration_documents``) before the rowid is applied, so no read
   487	    layer trusts a foreign position — the guard that the in-memory check alone
   488	    could not give once a handle is serialized and re-used across stores.
   489	    """
   490	    target = str(Path(store_path).resolve())
   491	    if at.store == target:
   492	        return at
   493	    if at.lineage is None:
   494	        raise WitnessLineageMismatch(
   495	            f"witness position (fact {at.fact_id!r}) was resolved against "
   496	            f"{at.store} but is being applied to {target} — an UNADOPTED handle "
   497	            "is session-local to its own store (N1); its rowid means nothing "
   498	            "here. Resolve the position against this store, or adopt the store "
   499	            "to mint a portable lineage-qualified handle."
   500	        )
   501	    conn = _open_readonly(store_path, timeout=timeout)
   502	    target_lineage = _read_own_lineage(conn) if conn is not None else None
   503	    if conn is not None:
   504	        conn.close()
   505	    if target_lineage != at.lineage:
   506	        raise WitnessLineageMismatch(
   507	            f"witness position (lineage {at.lineage}) was resolved against "
   508	            f"{at.store} and does not match this store's lineage "
   509	            f"({target_lineage}) at {target} — a lineage-qualified handle "
   510	            "resolves only against its own lineage (A10). Address the correct "
   511	            "store, or re-resolve the position here."
   512	        )
   513	    # Same lineage, DIFFERENT store: re-resolve the fact id in the target store
   514	    # so the applied rowid is the TARGET's append position (B1c) — never the
   515	    # source's. The empty/genesis sentinel maps to the target's empty prefix.
   516	    return resolve_witness_position(store_path, at.fact_id, timeout=timeout)
   517	
   518	
   519	def _resolve_address_rowid(conn: sqlite3.Connection, address: str) -> tuple[str, int]:
   520	    """Map an address to ``(fact_id, rowid)`` — primary-key lookup only (A3)."""
   521	    if address == GENESIS_SENTINEL:
   522	        return GENESIS_SENTINEL, 0
   523	    if address == "head":
   524	        row = conn.execute(
   525	            "SELECT id, rowid FROM facts ORDER BY rowid DESC LIMIT 1"
   526	        ).fetchone()
   527	        if row is None:
   528	            return GENESIS_SENTINEL, 0  # empty store → empty prefix
