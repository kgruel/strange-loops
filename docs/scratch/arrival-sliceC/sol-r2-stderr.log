   356	
   357	# Combined-read row shape: (id, kind, ts, observer, origin, payload, rowid).
   358	_ROW_INDEX = {"id": 0, "kind": 1, "ts": 2, "observer": 3, "origin": 4, "payload": 5}
   359	
   360	#: The ENVELOPE keys, positioned in the combined-read row. Derived from the
   361	#: atoms family rule rather than restated, so this row-shaped surface cannot
   362	#: drift from the mapping-shaped one (:func:`atoms.resolve_key_field`): only
   363	#: ``ts`` and ``id`` are envelope-resolved. ``kind``/``observer``/``origin``
   364	#: are stored columns but NOT key candidates — they resolve against the
   365	#: payload like any other declared key, which almost never carries them, so
   366	#: their projection is empty by non-membership rather than a grouping of the
   367	#: read by its columns.
   368	#:
   369	#: ts is a sqlite REAL column, so column-backed ts values are always float —
   370	#: the atoms strict type-identity check never sees an int/float mix here.
   371	_ROW_ENVELOPE_COLUMNS = {field: _ROW_INDEX[field] for field in ENVELOPE_KEYS}
   372	
   373	
   374	def _row_field(row: tuple, field: str) -> Any:
   375	    """Read a declared ordering key off a combined-read row.
   376	
   377	    The row-shaped spelling of :func:`atoms.resolve_key_field`: the envelope
   378	    keys are read straight off the tuple, anything else is a flat payload
   379	    field and costs a JSON parse. The default orderings (``Arrival()``,
   380	    ``ByKey('ts')``) are envelope-only and never reach the parse.
   381	
   382	    The payload arm defers to :func:`atoms.resolve_payload_key` rather than
   383	    calling ``.get()`` itself, so a non-mapping payload is the same missing-K
   384	    non-member here as on the mapping-shaped surface — one definition, not two
   385	    spellings that can disagree.
   386	    """
   387	    index = _ROW_ENVELOPE_COLUMNS.get(field)
   388	    if index is not None:
   389	        return row[index]
   390	    return resolve_payload_key(json.loads(row[5]), field)
   391	
   392	
   393	def _row_id(row: tuple) -> str:
   394	    return row[0]
