  1358	
  1359	        row = (gen_id(), d["name"], d["ts"], d["since"], d["origin"],
  1360	               payload_text, prev_hash, window_start, fact_cursor, window_hash)
  1361	        signature = (
  1362	            self._tick_signer(_tick_commitment_hash(row))
