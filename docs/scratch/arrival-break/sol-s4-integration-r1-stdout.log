    45	
    46	
    47	def test_lib_dependency_dag():
    48	    """Enforce the lib dependency DAG.
    49	
    50	    Allowed runtime: engine -> lang, engine -> atoms (function-local).
    51	    All other cross-lib runtime imports are forbidden.
    52	    Relative imports (intra-package) are excluded by the collector.
    53	    """
    54	    violations = []
