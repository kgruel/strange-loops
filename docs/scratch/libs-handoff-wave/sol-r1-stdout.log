   161	def _eval_condition(state: Any, condition: Any) -> bool:
   162	    """Evaluate a single BoundaryCondition against fold state.
   163	
   164	    State can be a dict (named targets) or MappingProxyType. The condition's
   165	    target is looked up in state, then compared using the operator.
   166	    """
   167	    from types import MappingProxyType
   168	    if isinstance(state, MappingProxyType):
   169	        state = dict(state)
   170	    if not isinstance(state, dict):
   171	        return False
   172	    value = state.get(condition.target)
   173	    if value is None:
   174	        return False
   175	    try:
   176	        fval = float(value)
   177	        fcomp = float(condition.value)
   178	    except (ValueError, TypeError):
   179	        # Fall back to string comparison for == and !=
   180	        if condition.op == "==":
   181	            return str(value) == str(condition.value)
   182	        if condition.op == "!=":
   183	            return str(value) != str(condition.value)
   184	        return False
   185	    if condition.op == ">=":
   186	        return fval >= fcomp
   187	    if condition.op == "<=":
   188	        return fval <= fcomp
   189	    if condition.op == ">":
   190	        return fval > fcomp
   191	    if condition.op == "<":
   192	        return fval < fcomp
   193	    if condition.op == "==":
   194	        return fval == fcomp
   195	    if condition.op == "!=":
   196	        return fval != fcomp
   197	    return False
   198	
   199	
   200	def _eval_conditions(state: Any, conditions: tuple) -> bool:
   201	    """Evaluate all BoundaryConditions — AND semantics."""
   202	    return all(_eval_condition(state, c) for c in conditions)
   203	
