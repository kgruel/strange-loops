   205	def receipt_group_span(conn: sqlite3.Connection, rowid: int) -> tuple[int, int] | None:
   206	    """If ``rowid`` falls strictly inside a receipt group, return its span.
   207	
   208	    A receipt group is a maximal run of ``_decl.*`` rows that are **contiguous in
   209	    rowid** and share one effective ``ts`` and one ``lineage`` — the atomic
   210	    footprint of one absorb ceremony (``sqlite_store.absorb_edit``: one
   211	    ``BEGIN IMMEDIATE``, one stamped ``ts``). Returns ``(first_rowid,
   212	    last_rowid)`` when ``first <= rowid < last`` (the prefix would include a
   213	    *partial* ceremony); ``None`` otherwise — a cutoff at-or-after the group's
   214	    last row includes the whole ceremony (fine), and a genesis or a lone edit is
   215	    a singleton run that can never be mid-group.
   216	
   217	    Origin-guaranteed by the write path, not interchange-guaranteed: a
   218	    kind-filtered slice can split a group across stores, and the shared-ts test
   219	    is a heuristic until a durable group id ships (A2 residue). The scan is over
   220	    ``_decl.*`` rows only — negligible on the live corpus (≤1 such row exists
   221	    store-wide today).
   222	    """
   223	    rows = conn.execute(
   224	        "SELECT rowid, ts, payload FROM facts WHERE kind GLOB '_decl.*' ORDER BY rowid"
   225	    ).fetchall()
   226	    if not rows:
   227	        return None
   228	    runs: list[tuple[int, int]] = []
   229	    run_start = prev_rowid = rows[0][0]
   230	    prev_ts = rows[0][1]
   231	    prev_lineage = _lineage_of(rows[0][2])
   232	    for rid, ts, payload_text in rows[1:]:
   233	        lineage = _lineage_of(payload_text)
   234	        if rid == prev_rowid + 1 and ts == prev_ts and lineage == prev_lineage:
   235	            pass  # same ceremony — extend the run
   236	        else:
   237	            runs.append((run_start, prev_rowid))
   238	            run_start = rid
   239	        prev_rowid, prev_ts, prev_lineage = rid, ts, lineage
   240	    runs.append((run_start, prev_rowid))
   241	    for first, last in runs:
   242	        if first <= rowid < last:
   243	            return (first, last)
   244	    return None
