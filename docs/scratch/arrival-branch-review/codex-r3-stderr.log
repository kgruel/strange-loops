   480	def apply_declaration_update(
   481	    preview: DeclarationUpdatePreview,
   482	    *,
   483	    observer: str,
   484	    credentials: CredentialProvider | None = None,
   485	    write_file: Callable[[Path, str | None], None] | None = None,
   486	) -> DeclarationUpdateResult:
   487	    """Apply a planned declaration update — atomic, or a typed state.
   488	
   489	    Sequence (store-first, every prefix recoverable):
   490	
   491	    1. open the canonical store — a failure here provably mutated nothing
   492	       and no intent exists yet, so it refuses typed with zero residue;
   493	    2. durable intent (sibling ``.vertex.intent``, exclusive O_CREAT|O_EXCL
   494	       create + fsync — the create is the race-free gate) —
   495	       a write failure here is a typed pre-ceremony ``refused`` (nothing
   496	       mutated), and the store handle from (1) is closed either way;
   497	    3. the S1b store ceremony — ``absorb_genesis`` or
   498	       ``absorb_edit(expected_head=preview.expected_head)`` — which holds the
   499	       identity check, CAS, sign-final-payload, and append in ONE
   500	       transaction; a stale preview refuses INSIDE that transaction with the
   501	       canonical log byte-identical;
   502	    4. the file-cache replace (``write_file`` injectable; the shipped default
   503	       atomically writes ``preview.proposed_text``);
   504	    5. intent removal.
   505	
   506	    A typed refusal in (3) removes the intent (nothing mutated) and returns
   507	    ``stale``/``refused``; a raw backend failure there is ambiguous (the log
   508	    commits before the index) and leaves the intent as ``needs-recovery``.
   509	    A failure in (4) — including process death, which simply never reaches
   510	    (5) — leaves the intent for :func:`recover_declaration_update` and, when
   511	    the process survives to report it, returns the typed ``needs-recovery``
   512	    state.
   513	
   514	    ``credentials`` supplies the operation-fresh fact signer
   515	    (:class:`~engine.handle.CredentialProvider`, the ratified S3 shape);
   516	    ``None`` or a ``None`` signer refuses at the store's own signing gate —
   517	    declaration events are the attestation root.
   518	    """
   519	    from .sqlite_store import (
   520	        AmbiguousGenesis,
   521	        GenesisExists,
   522	        NoGenesis,
   523	        ReservedKindViolation,
   524	        StaleDeclarationHead,
   525	        UnsignableEdit,
   620	            )
   621	
   622	        stale_exc = (StaleDeclarationHead,)
   623	        stale_reason = "{exc}"
   624	        refuse_exc = (
   625	            AmbiguousGenesis, NoGenesis, ReservedKindViolation, UnsignableEdit,
   626	        )
   627	
   628	    try:
   629	        # Intent creation lives INSIDE the store-lifetime try/finally
   630	        # (SOL-R3-06): the open now precedes the intent, so a failing
   631	        # intent write must not leak the handle. An expected write failure
   632	        # is a typed pre-ceremony refusal — nothing mutated, no residue.
   633	        try:
   634	            intent_path = _write_intent(preview, observer)
   635	        except FileExistsError:
   636	            # The exclusive create lost a race the exists() fast path could
   637	            # not see (TOCTOU window): another apply's intent landed between
   638	            # the check and the create. Same typed outcome as the fast path,
   639	            # and the winner's intent bytes are untouched.
   640	            return DeclarationUpdateResult(
   641	                status="pending-intent",
   642	                reason=(
   643	                    f"pending declaration-update intent at {pending} — "
   644	                    "another apply won the intent gate; run "
   645	                    "recover_declaration_update first"
   646	                ),
   647	                intent_path=pending,
   648	            )
   649	        except OSError as exc:
   650	            return DeclarationUpdateResult(
   651	                status="refused",
   652	                reason=(
   653	                    f"could not persist the declaration-update intent "
   654	                    f"({exc}) — refusing before the ceremony; nothing mutated"
   655	                ),
   656	            )
   657	        receipt = ceremony()
   658	    except stale_exc as exc:
   659	        _remove_intent(intent_path)
   660	        return DeclarationUpdateResult(
   661	            status="stale", reason=stale_reason.format(exc=exc)
   662	        )
   663	    except refuse_exc as exc:
   664	        _remove_intent(intent_path)
   665	        return DeclarationUpdateResult(status="refused", reason=str(exc))
   666	    except (sqlite3.Error, OSError) as exc:
   667	        # A backend failure DURING the absorb is ambiguous on a
   668	        # JSONL-canonical store: the log line (the store) commits before
   669	        # the index row, so the ceremony may already be live. The intent
   670	        # stays — recover_declaration_update classifies not-applied vs
   671	        # applied from the log.
   672	        return DeclarationUpdateResult(
   673	            status="needs-recovery",
   674	            reason=(
   675	                f"store step failed mid-ceremony ({exc}) — run "
   676	                "recover_declaration_update; it classifies "
   677	                "not-applied vs applied from the canonical store"
   678	            ),
   679	            intent_path=intent_path,
   680	        )
   681	    finally:
   682	        store.close()
   683	
   684	    # Store committed — the point of no return. File replace, then intent
   685	    # removal; any failure from here is the recover path's job.
   686	    writer = write_file or _default_file_write
   687	    try:
   688	        writer(vertex_path, preview.proposed_text)
   689	    except BaseException as exc:  # noqa: BLE001 — typed recovery, not a crash
   690	        return DeclarationUpdateResult(
   691	            status="needs-recovery",
   692	            reason=(
   693	                f"store ceremony committed but the file step failed ({exc}) — "
   694	                "run recover_declaration_update on the intent"
   695	            ),
   696	            receipt=receipt,
   697	            intent_path=intent_path,
   698	        )
   699	    _remove_intent(intent_path)
   700	    return DeclarationUpdateResult(
   701	        status="applied",
   702	        reason="declaration updated — store committed, file reconciled",
   703	        receipt=receipt,
   704	        file_written=preview.proposed_text is not None or write_file is not None,
   705	    )
   706	
