   516	def test_stale_handle_appending_after_another_wrote_stamps_the_truth(tmp_path):
   517	    """Sequential variant: a long-lived handle must not stamp a stale count."""
   518	    stale = open_store(tmp_path)  # opened when the store was empty
   519	    other = open_store(tmp_path)
   520	    for i in range(5):
   521	        other.append(fact(message=f"m{i}"))
   522	    other.close()
   523	
   524	    stale.append(fact(message="late"))
   525	    stale.close()
   526	
   527	    assert len(sqlite_facts(tmp_path / "s.db")) == 6
   528	    reopened = open_store(tmp_path)
   529	    assert reopened.catch_up() == "synced"
   530	    reopened.close()
