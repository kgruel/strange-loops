   455	    def _write(self, sql: str, row: tuple, line: str, is_fact: bool) -> None:
   456	        """Stage the INSERT, make the line durable, then stamp and commit.
   457	
   458	        The INSERT runs first, uncommitted: a rejected row (duplicate id from
   459	        ``id_override``, any constraint) fails before a byte reaches the log,
   460	        so a refused append can never orphan a line. Nothing is observable
   461	        until the commit, which happens strictly after the fsync.
   462	
   463	        Reconcile first: see :meth:`_reconcile`.
   464	        """
   465	        self._reconcile()
