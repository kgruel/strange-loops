   161	def test_emit_writes_the_log_when_the_locator_is_jsonl(tmp_path):
   162	    """The dormant defect made live.
   163	
   164	    Task declarations are all `.db` today, so this app's writes look fine.
   165	    The day one flips to `.jsonl`, a hand-built SqliteStore would write
   166	    sqlite bytes straight into the declared canonical log. Routing through
   167	    engine's open_canonical_store is what keeps that from happening.
   168	    """
   169	    from engine.jsonl_codec import deserialize_row
   170	    from strange_loops.store import emit_fact, emit_tick
   171	
   172	    canonical = tmp_path / "data" / "tasks.jsonl"
   173	    emit_fact(canonical, "task.created", "kyle", {"name": "t1"})
   174	    emit_tick(canonical, "task.tick", {"task": "t1", "status": "completed"})
   175	
   176	    assert canonical.exists()
   177	    assert (tmp_path / "data" / "tasks.db").exists()  # the derived index
   178	    records = [
   179	        deserialize_row(ln)
   180	        for ln in canonical.read_text(encoding="utf-8").splitlines()
   181	        if ln
   182	    ]
   183	    assert [t for t, _ in records] == ["fact", "tick"]
