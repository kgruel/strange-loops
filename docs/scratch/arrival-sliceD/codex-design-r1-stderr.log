   506	    def _ensure_sync(self) -> None:
   507	        """Set synchronous=NORMAL before first write. Deferred so schema load
   508	        happens on first read (replay_into) rather than on pragma."""
   509	        if not self._sync_set:
   510	            self._conn.execute("PRAGMA synchronous=NORMAL")
   511	            self._sync_set = True
   512	
   513	    def append(
   514	        self,
   515	        event: T,
   516	        *,
   517	        id_override: str | None = None,
   518	        signature_override: str | None = None,
   519	    ) -> str:
   520	        """Append one event to the store. Returns the ID assigned.
   521	
   522	        If id_override is provided, that ID is used; otherwise a new ID
   523	        is generated via gen_id(). The ID is returned in either case so
   524	        callers (e.g. emit's receipt path) can reference the stored row.
   525	
   526	        Signature (delta 3): when a fact_signer was injected, signs the
   527	        CONTENT commitment of the new row under the fact's own observer;
   528	        NULL when the signer returns None for that observer (per-observer
   529	        pre-signature era). signature_override carries an EXISTING
   530	        signature verbatim — replay/rebirth/transport paths must preserve
   531	        the original authorship signature, never re-sign (re-signing
   532	        another observer's fact under a local key would be forgery; the
   533	        override bypasses the signer entirely).
   534	        """
   535	        return self.append_attested(
   536	            event, id_override=id_override, signature_override=signature_override
   537	        )[0]
   538	
   539	    def append_attested(
   540	        self,
   541	        event: T,
   542	        *,
   543	        id_override: str | None = None,
   544	        signature_override: str | None = None,
   545	    ) -> tuple[str, str | None]:
   546	        """:meth:`append`, also returning the committed row's signature.
   547	
   548	        The signature handed back is the COMMITTED column, read back inside
   549	        the write transaction after the INSERT (any AFTER triggers have
   550	        fired) and before the commit — the write-receipt attestation
   551	        contract (LIBS_CHANGES P1: "the committed row, or the write
   552	        operation's actual result"). Assembly state is not enough: an AFTER
   553	        INSERT trigger can rewrite the row between the two, and the receipt
   554	        follows the row (SOL-R3-02). ``signature_override`` flows through
   555	        the assembly verbatim. :meth:`fact_signature` remains the public
   556	        read-back API for cross-checks.
   557	        """
   558	        if self._conn is None:
   559	            # close() is part of the public lifecycle now — use-after-close
   560	            # gets a named error, not AttributeError on a None connection.
   561	            raise RuntimeError(f"store closed: {self._path}")
   562	        self._ensure_sync()
   563	        self._ensure_fact_signature_column()
   564	        d = self._serialize(event)
   565	        fact_id = id_override if id_override is not None else gen_id()
   566	        observer = d["observer"]
   567	        origin = d.get("origin", "")
   568	        payload_text = json.dumps(d["payload"])
