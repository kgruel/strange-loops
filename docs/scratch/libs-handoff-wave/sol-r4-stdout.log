   491	def edit_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   492	    """Replace an existing kind's definition in place; returns the new text.
   493	
   494	    Preserves the kind's position and all surrounding content. Not
   495	    supported when the whole ``loops`` block is a single line (the
   496	    documented expand-on-insert limitation is one-way).
   497	    """
   498	    _validate_kind_name(kind)
   499	    before = _parse_vertex_or_raise(text, f"edit_vertex_kind({kind!r})")
   500	    _assert_unique_kind_nodes(text, f"edit_vertex_kind({kind!r})")
   501	    try:
   502	        start, end = kdl_find_block(text, ["loops", kind])
   503	    except ValueError as exc:
   504	        raise ValueError(
   505	            f"kind {kind!r} not found in loops block (single-line loops "
   506	            "blocks cannot be edited in place — expand across lines first): "
   507	            f"{exc}"
   508	        ) from exc
   509	
   510	    lines = text.splitlines()
   511	    # Trailing-trivia honesty (SOL-R3-01 part c): the splice regenerates the
   512	    # whole block, so it can carry through exactly ONE piece of trivia — the
   513	    # suffix after the block's final close (`} // note`). Anything comment-
   514	    # shaped INSIDE the replaced span would be silently dropped by the
   515	    # regeneration; _verified claims preservation, so that is a refusal.
   516	    end_line = lines[end]
   517	    close_idx = end_line.rindex("}")
   518	    suffix = end_line[close_idx + 1 :].rstrip()
   519	    interior = "\n".join([*lines[start:end], end_line[: close_idx + 1]])
   520	    if _has_comment_outside_strings(interior):
   521	        raise ValueError(
   522	            f"edit_vertex_kind({kind!r}): the {kind!r} block carries a "
   523	            "comment the regenerated definition cannot preserve — move the "
   524	            "comment outside the block (or edit the file by hand) and retry"
   525	        )
   526	    kind_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   527	    child = loop_def_to_kdl(kind, definition)
   528	    new_lines = [
   529	        (kind_indent + ln) if ln.strip() else ln for ln in child.splitlines()
   530	    ]
   531	    if suffix:
   532	        sep = "" if suffix.startswith((" ", "\t")) else " "
   533	        new_lines[-1] += sep + suffix
   534	    lines[start : end + 1] = new_lines
   535	    result = "\n".join(lines)
   536	    if text.endswith("\n"):
   537	        result += "\n"
   538	    return _verified(
   539	        before, result, f"edit_vertex_kind({kind!r})",
   540	        edited=kind, definition=definition,
   541	    )
   542	
   543	
   544	def remove_vertex_kind(text: str, kind: str) -> str:
   545	    """Remove a kind's definition from vertex text; returns the new text.
   546	
   547	    Not supported when the whole ``loops`` block is a single line. Refuses
   548	    (via post-validation) when removal would leave an invalid vertex, e.g.
   549	    removing the last kind of a vertex with no other sources.
   550	    """
   551	    _validate_kind_name(kind)
   552	    before = _parse_vertex_or_raise(text, f"remove_vertex_kind({kind!r})")
   553	    _assert_unique_kind_nodes(text, f"remove_vertex_kind({kind!r})")
   554	    try:
   555	        result = kdl_remove_child(text, ["loops"], kind)
   556	    except ValueError as exc:
   557	        raise ValueError(
   558	            f"kind {kind!r} not found in loops block (single-line loops "
   559	            "blocks cannot be mutated in place — expand across lines first): "
   560	            f"{exc}"
   561	        ) from exc
   562	    return _verified(
   563	        before, result, f"remove_vertex_kind({kind!r})", removed=kind
   564	    )

