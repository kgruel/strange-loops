   283	    after: str | None = None,
   284	    include_internal: bool = False,
   285	) -> FactPageResult:
   286	    """Read a bounded page of facts with stable witness pagination cursors.
   287	
   288	    Parameters:
   289	        target: Path to .vertex, .jsonl, or .db artifact.
   290	        limit: Maximum number of facts to return.
   291	        kind: Optional kind filter.
   292	        observer: Optional observer identity filter.
   293	        order: Sort direction along the ordering axis — 'oldest' ascending,
   294	            'newest' descending.
   295	        ordering: Declared read ordering. ``None`` keeps today's axis: receipt
   296	            order for a single-store vertex, the ``(ts, id)`` read lens for an
   297	            aggregate. Declaring ``Arrival()`` on a multi-store aggregate is
   298	            refused — see :func:`engine.vertex_reader.resolve_ordering`. Only
   299	            the resolved default axis is supported this cut; any other declared
   300	            ordering is refused rather than silently approximated.
   301	        before: Cursor token to fetch rows before (older than) the cursor in newest order.
   302	        after: Cursor token to fetch rows after (newer than) the cursor in oldest order.
   303	        include_internal: Whether to include internal `_decl.*` facts.
   304	
   305	    Returns:
   306	        FactPageResult containing deserialized fact items and pagination metadata.
   307	    """
   308	    if order not in ("newest", "oldest"):
   309	        raise SdkValueError(f"invalid order '{order}': expected 'newest' or 'oldest'")
   310	
   311	    info = resolve_target(target)
   312	    target_path = Path(target).resolve()
   313	
   314	    if info.target_type == "vertex":
   315	        decl_ast, _ = load_declaration_status(target_path)
   316	        is_aggregate = decl_ast is not None and (
   317	            decl_ast.combine is not None or decl_ast.discover is not None
   318	        )
