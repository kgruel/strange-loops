   405	def _key_shape_fault(value: object) -> str | None:
   406	    """Why ``value`` is not a well-formed public key, or None when it is.
   407	
   408	    Shape only — raw-32-byte base64, the ratified wire format. Whether a
   409	    signature actually verifies under it is the injected verifier's answer
   410	    (:func:`verify_authorship`); the grammar refuses what could never be a
   411	    key so a malformed one fails at the append site rather than bricking
   412	    verification later.
   413	    """
   414	    if not isinstance(value, str) or not value:
   415	        return f"key must be a non-empty string, got {type(value).__name__}"
   416	    try:
   417	        raw = base64.b64decode(value, validate=True)
   418	    except (binascii.Error, ValueError) as exc:
   419	        return f"key is not valid base64: {exc}"
   420	    if len(raw) != _KEY_RAW_LEN:

