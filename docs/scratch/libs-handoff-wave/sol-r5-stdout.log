   645	    # ------------------------------------------------------------------
   646	    # Row-write seam. Both append paths assemble the full persisted row —
   647	    # exactly the 7-field fact / 11-field tick shape the commitment hashers
   648	    # and engine.jsonl_codec take — and hand it to these hooks, which own the
   649	    # INSERT *and* the commit. Subclasses (engine.jsonl_store) override them
   650	    # to make a durable JSONL line the authoritative write and sqlite the
   651	    # derived index, without touching mint logic or the read surface.
   652	    # ------------------------------------------------------------------
   653	
   654	    def _sync_derived_state(self) -> None:
   655	        """Seam: bring derived state up to date before reading chain state.
   656	
   657	        A no-op here — sqlite IS the state. A subclass whose sqlite is a
   658	        DERIVED index (engine.jsonl_store) must reconcile the index with its
   659	        canonical log *before* any mint reads chain state from it: a durable
   660	        but unindexed line would otherwise be invisible to the predecessor,
   661	        window-start and fact-cursor derivation, and the resulting mis-linked
   662	        tick lands in the canonical log where no rebuild can repair it.
   663	
   664	        Called at the top of ``append_tick`` (before the ``prev_row`` read)
   665	        and at the top of ``absorb_genesis``/``absorb_edit`` — strictly
   666	        BEFORE their ``BEGIN IMMEDIATE``, because a reconcile commits and
   667	        would split the ceremony transaction. The chain-head, fact-cursor and
   668	        declaration-head reads inside those transactions therefore see an
   669	        index that has consumed every durable line.
   670	        """
   671	
   672	    def _ceremony_persist(self, rows: list[tuple]) -> None:
   673	        """Seam: make a declaration ceremony's rows canonical, pre-commit.
   674	
   675	        Called inside the open ``BEGIN IMMEDIATE`` transaction, after every
   676	        CAS check has passed and all fact-row INSERTs (and meta stamps) are
   677	        staged, immediately before COMMIT. ``rows`` are the full 7-field
   678	        persisted fact rows, in emission order.
   679	
   680	        A no-op here — sqlite IS the store, and the staged INSERTs commit.
   681	        ``engine.jsonl_store`` overrides it to append the ceremony as ONE
   682	        durable log line (a plain fact line for one row, a ``batch`` envelope
   683	        for several) and stamp the consumed offset/counts, preserving
   684	        ``_write``'s ordering: refusals before any log byte, fsync before the
   685	        index row is observable.
   686	        """
   687	
   688	    def _committed_row_state(self, table: str, row_id: str) -> tuple[bool, str | None]:
   689	        """(exists, signature) of the row as it stands post-INSERT, pre-commit.
   690	
   691	        Existence and signature are separate answers (SOL-R4-02): a NULL
   692	        signature on a committed row and a row an AFTER trigger deleted are
   693	        different facts, and conflating them once minted a stored=True
   694	        receipt for no row. ``table`` is an internal constant
   695	        (``facts``/``ticks``), never caller input.
   696	        """
   697	        r = self._conn.execute(
   698	            f"SELECT signature FROM {table} WHERE id = ?", (row_id,)  # noqa: S608
   699	        ).fetchone()
   700	        return (r is not None, r[0] if r is not None else None)
   701	
   702	    def _committed_full_row(self, table: str, row_id: str) -> tuple:
   703	        """The COMPLETE inserted row, post-INSERT pre-commit, or refuse.
   704	
   705	        Read back after any AFTER triggers fired, in persisted column
   706	        order — what the store will actually commit. An absent row is the
   707	        SOL-R4-02 typed refusal. Used wherever the caller must compare or
   708	        persist the committed truth, not the assembled intent: the JSONL
   709	        log derivation (SOL-R4-03) and the ceremony full-row equality
   710	        check (R4 arbiter follow-up).
   711	        """
   712	        columns = FACT_COLUMNS if table == "facts" else TICK_COLUMNS
   713	        r = self._conn.execute(
   714	            f"SELECT {', '.join(columns)} FROM {table} "  # noqa: S608
   715	            "WHERE id = ?", (row_id,)
   716	        ).fetchone()
   717	        if r is None:
   718	            raise CommittedRowMissing(
   719	                f"the inserted {table} row {row_id} is ABSENT at pre-commit "
   720	                "read-back (a schema-level rewrite, e.g. an AFTER INSERT "
   721	                "trigger, deleted it) — rolling back; refusing to mint a "
   722	                "stored receipt for a row the store did not keep"
   723	            )
   724	        return tuple(r)
   725	
   726	    def _committed_signature(self, table: str, row_id: str) -> str | None:
   727	        """The COMMITTED signature; raises if the row itself is gone.
   728	
   729	        The one read-back per write (SOL-R3-02): executed after the INSERT
   730	        — so any AFTER triggers have already fired — and before the commit,
   731	        it reads exactly what will be committed. An ABSENT row (something
   732	        deleted it out from under the staged INSERT) is a typed refusal
   733	        (SOL-R4-02): callers roll back — a store that eats rows must not
   734	        get a stored=True receipt.
   735	        """
   736	        exists, signature = self._committed_row_state(table, row_id)
   737	        if not exists:
   738	            raise CommittedRowMissing(
   739	                f"the inserted {table} row {row_id} is ABSENT at pre-commit "
   740	                "read-back (a schema-level rewrite, e.g. an AFTER INSERT "
   741	                "trigger, deleted it) — rolling back; refusing to mint a "
   742	                "stored receipt for a row the store did not keep"
   743	            )
   744	        return signature
   745	
   746	    def _write_fact_row(self, row: tuple) -> str | None:
   747	        """Persist one assembled fact row (id, kind, ts, observer, origin,
   748	        payload, signature). Returns the COMMITTED signature (read back
   749	        inside the transaction, after triggers, before commit); raises
   750	        CommittedRowMissing — after rollback — if the row is gone."""
   751	        try:
   752	            self._conn.execute(FACT_INSERT_SQL, row)
   753	            committed = self._committed_signature("facts", row[0])
   754	            self._conn.commit()
   755	        except BaseException:
   756	            self._conn.rollback()
   757	            raise
   758	        return committed
   759	
   760	    def _write_tick_row(self, row: tuple) -> str | None:
   761	        """Persist one assembled tick row (_TICK_ROW_SQL order + signature).
   762	        Same read-back + rollback-on-absence contract as facts."""
   763	        try:
   764	            self._conn.execute(TICK_INSERT_SQL, row)
   765	            committed = self._committed_signature("ticks", row[0])
   766	            self._conn.commit()
   767	        except BaseException:
   768	            self._conn.rollback()
   769	            raise
   770	        return committed
   771	
   772	    def current_chain_head(self) -> str | None:
   773	        """The row-identity hash of the latest *chained* tick, or None.
   774	
   775	        What a successor tick's ``prev_hash`` commits to (era-aware
   776	        ``_tick_row_hash``) — the "chain head" a genesis pins. None when the
   777	        store has no chained tick (a pre-chain-only or empty store pins on
   778	        the fact cursor instead). Read-only; never migrates schema.
   779	        """
   780	        cols = {r[1] for r in self._conn.execute("PRAGMA table_info(ticks)")}
   781	        if "window_hash" not in cols:
   782	            return None
   783	        row_sql = _TICK_ROW_SQL if "signature" in cols else _TICK_ROW_SQL_V1
   784	        row = self._conn.execute(
   785	            f"SELECT {row_sql} FROM ticks "
   786	            "WHERE window_hash IS NOT NULL ORDER BY rowid DESC LIMIT 1"
   787	        ).fetchone()
   788	        if row is None:
   789	            return None
   790	        # _tick_row_hash reads an 11-field row (signature at [10]); a delta-1
   500	            self._meta_set(key, value)
   501	
   502	    def _row_counts(self) -> tuple[int, int]:
   503	        facts = self._conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0]
   504	        ticks = self._conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0]
   505	        return int(facts), int(ticks)
   506	
   507	    def _log_size(self) -> int:
   508	        try:
   509	            return self._log_path.stat().st_size
   510	        except OSError:
   511	            return 0
   512	
   513	    # ---- the write path ----------------------------------------------
   514	
   515	    def _append_line(self, line: str) -> int:
   516	        """Append one durable line; return the log size after it.
   517	
   518	        fsync, not just flush: the receipt is minted here, so the line must
   519	        outlive a power cut, not merely a process crash.
   520	        """
   521	        self._log_path.parent.mkdir(parents=True, exist_ok=True)
   522	        data = (line + "\n").encode("utf-8")
   523	        with self._log_path.open("ab") as fh:
   524	            fh.write(data)
   525	            fh.flush()
   526	            os.fsync(fh.fileno())
   527	            return fh.tell()
   528	
   529	    def _write(
   530	        self, sql: str, row: tuple, serialize_row, is_fact: bool
   531	    ) -> str | None:
   532	        """Stage the INSERT, make the line durable, then stamp and commit.
   533	
   534	        The INSERT runs first, uncommitted: a rejected row (duplicate id from
   535	        ``id_override``, any constraint) fails before a byte reaches the log,
   536	        so a refused append can never orphan a line. Nothing is observable
   537	        until the commit, which happens strictly after the fsync.
   538	
   539	        The log line serializes the COMMITTED read-back row, not the
   540	        caller-assembled one (SOL-R4-03): an AFTER trigger that rewrites
   541	        the row would otherwise put one truth in the index and another in
   542	        the canonical log — instant derivation divergence
   543	        (``audit_agreement`` fails on the very next check). The index is
   544	        what was committed; the log must derive-match it byte-for-byte.
   545	
   546	        Reconcile first: see :meth:`_reconcile`.
   547	        """
   548	        self._reconcile()
   549	        # Codec pre-flight on the ASSEMBLED row: a row the codec refuses
   550	        # (string timestamp, non-JSON constant) must fail before sqlite's
   551	        # column affinity can coerce it into something committable — the
   552	        # early-refusal gate the codec has always been. The actual log
   553	        # bytes still come from the read-back row below.
   554	        serialize_row(row)
   555	        try:
   556	            self._conn.execute(sql, row)
   557	            # Committed-row honesty (SOL-R3-02 + SOL-R4-02/03): read the
   558	            # COMPLETE row back after the INSERT (AFTER triggers fired),
   559	            # before any log byte and before commit — the receipt AND the
   560	            # log line both report what the index will actually hold; an
   561	            # absent row refuses.
   562	            committed_row = self._committed_full_row(
   563	                "facts" if is_fact else "ticks", row[0]
   564	            )
   565	            committed = committed_row[-1]  # signature is the last column
   566	            line = serialize_row(committed_row)
   567	            # The INSERT has taken sqlite's write lock, so the committed
   568	            # markers read here cannot be raced by another handle: whatever
   569	            # a concurrent writer stamped is already visible, and nothing
   570	            # further can land until we commit or roll back. Increment from
   571	            # that committed value — never from a per-handle cache, which
   572	            # would stamp a stale count over another writer's correct one
   573	            # and brick the store on the next open.
   574	            marked = self._marked_counts()
   575	            if marked is None:
   576	                facts, ticks = self._row_counts()  # pre-marker store: adopt
   577	            else:
   578	                facts, ticks = marked
   579	                facts += 1 if is_fact else 0
   580	                ticks += 0 if is_fact else 1
   581	            offset = self._append_line(line)
   582	            self._stamp(offset, facts, ticks)
   583	            self._conn.commit()
   584	            return committed
   585	        except BaseException:
   586	            self._conn.rollback()
   587	            raise
   588	
   589	    def _reconcile(self) -> None:
   590	        """Refuse to stamp past a durable line the index has not consumed.
   591	
   592	        A failure *after* the fsync (sqlite error, power cut, the process
   593	        dying) rolls the transaction back, leaving the line durable and the
   594	        offset unstamped — that is the recoverable state, and the next open
   595	        tails it forward. But a long-lived handle never reopens: it would
   596	        append line N+1 and stamp the offset past *both*, burying the orphan
   597	        forever while reporting ``synced``. So every append reconciles first.
   598	
   599	        Cheap in the common case: one ``store_meta`` read and one ``stat``,
   600	        no scan, no lock. Only a disagreement pays for :meth:`catch_up`
   601	        (which also covers a shrunk log, a torn tail and untrustworthy
   602	        offset metadata). Two handles racing the same orphan line is a loud
   603	        failure, not a silent one: the loser's tail INSERT hits the primary
   604	        key, rolls back, and the line stays recoverable.
   605	        """
   606	        if self._read_offset() == self._log_size():
   607	            return
   608	        self.catch_up()
   609	
   610	    def _sync_derived_state(self) -> None:
   611	        """Reconcile before the mint reads chain state off the index.
   612	
   613	        ``_write``'s reconcile is too late for a tick: ``append_tick`` has by
   614	        then already derived ``prev_hash``, ``window_start`` and the fact
   615	        cursor from an index that may not have consumed a durable line. The
   616	        successor would link past the orphan, and that mis-linkage goes into
   617	        the canonical log itself — where no later catch-up or rebuild can
   618	        repair it. Reconciling in front of the derivation costs two syscalls
   619	        when the index is current.
   620	        """
   621	        self._reconcile()
   622	
   623	    def _ceremony_persist(self, rows: list[tuple]) -> None:
   624	        """Make a declaration ceremony canonical: one durable line, stamped.
   625	
   626	        Runs inside the ceremony's open ``BEGIN IMMEDIATE`` transaction,
   627	        after every CAS check passed and the fact INSERTs (+ meta stamps)
   628	        are staged, immediately before the caller's COMMIT — the same shape
   629	        as :meth:`_write` steps 3–4. One row serializes as a plain fact
   630	        line; several as one ``batch`` envelope line (the log's atomicity
   631	        unit), so recovery can never expose a partial ceremony. Any failure
   632	        after the fsync rolls the index back and leaves the line durable
   633	        and unindexed — the standard recoverable state the next
   634	        open/reconcile tails forward, all N rows atomically.
   635	        """
   636	        line = serialize_batch(rows) if len(rows) > 1 else serialize_fact_row(rows[0])
   637	        # Same committed-marker discipline as _write: the staged INSERTs
   638	        # hold sqlite's write lock, so the marker read here cannot be raced.
