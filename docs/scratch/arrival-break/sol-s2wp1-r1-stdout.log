    65	    # module is the one that most needs it, because it is where the arrival
    66	    # vocabulary becomes the vocabulary every future backend inherits.
    67	    # `arrival_registry` is slice 2's WP4 and joins when it is born.
    68	    "libs/engine/src/engine/arrival_contract.py",
