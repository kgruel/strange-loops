   555	def kdl_insert_child(
   556	    text: str,
   557	    parent_path: list[str],
   558	    child_text: str,
   559	) -> str:
   560	    """Insert child_text into the block at parent_path.
   561	
   562	    Placement rule: after the last existing sibling whose first token matches
   563	    the first token of child_text (preserves authorial grouping). If no such
   564	    sibling exists, insert just before the parent's closing brace.
   565	
   566	    child_text may be multi-line. Leading common whitespace is stripped, then
   567	    each line is re-indented to match the parent's child-indent.
   568	    """
   569	    if not child_text.strip():
   570	        raise ValueError("child_text is empty")
   571	    had_trailing = text.endswith("\n")
   572	    lines = text.splitlines()
   573	    start, end = kdl_find_block(text, parent_path)
   574	    indent = _detect_indent(lines, start, end)
   575	
   576	    # Normalize child_text: dedent + strip outer blank lines.
   577	    from textwrap import dedent
   578	    body = dedent(child_text).strip("\n")
   579	    child_lines = [
   580	        (indent + ln) if ln.strip() else ln  # don't indent blank lines
   581	        for ln in body.splitlines()
   582	    ]
   583	    # First token of child for sibling-grouping placement.
   584	    child_first = child_lines[0].strip().split(None, 1)[0]
   585	
   586	    # Find insertion point: after last sibling-of-same-first-token at depth 0
   587	    # inside the block, else just before the closing brace.
   588	    insert_at = end  # default: line where closing '}' lives — insert before it
   589	    depth = 0
   590	    for i in range(start + 1, end):
   591	        stripped = lines[i].strip()
   592	        if depth == 0:
   593	            tok = stripped.split(None, 1)[0] if stripped else ""
   594	            # Strip any leading '/' (e.g. // comments) so comments don't match.
   595	            if tok and tok == child_first:
   596	                # Determine where this sibling ends — could be single-line or
   597	                # span a block.
   598	                sib_open = lines[i].count("{") - lines[i].count("}")
   599	                if sib_open == 0:
   600	                    insert_at = i + 1
   601	                else:
   602	                    # Walk to matching close.
   603	                    d = sib_open
   604	                    j = i + 1
   605	                    while j < end and d > 0:
   606	                        d += lines[j].count("{") - lines[j].count("}")
   607	                        j += 1
   608	                    insert_at = j
   609	        depth += lines[i].count("{") - lines[i].count("}")
   610	
   611	    # Special case: parent block is single-line `name { ... }` — split it.
   612	    if start == end:
   613	        # Convert single-line block into multi-line and place child inside.
   614	        # We re-emit the line as: <opening>\n<child>\n<closing>
   615	        line = lines[start]
   616	        # Find first '{' and last '}'.
   617	        open_idx = line.index("{")
   618	        close_idx = line.rindex("}")
   619	        opening = line[: open_idx + 1].rstrip()
   620	        inner = line[open_idx + 1 : close_idx].strip()

