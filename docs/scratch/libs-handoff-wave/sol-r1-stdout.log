   313	# --- L1: the default agreement gate ----------------------------------------
   314	
   315	
   316	def audit_agreement(canonical: Path) -> AgreementReport:
   317	    """The default gate: do the log and its index still agree, cheaply?
   318	
   319	    Three checks, in the order a divergence is most likely to be explained by:
   320	
   321	    ``index``      the derived index exists and is a readable store
   322	    ``offset``     stamped byte offset == the log's size on disk
   323	    ``counts``     stamped fact/tick counts == ``COUNT(*)`` per table
   324	    ``last-line``  the last complete log line == the index row it names
   325	
   326	    Together they catch the two lie-shapes the index-only walk missed: an
   327	    out-of-band sqlite row (counts diverge) and a durable-but-unindexed log
   328	    line (offset diverges). Interior agreement is ``audit_deep``'s scope.
   329	    """
   330	    canonical = Path(canonical)
   331	    from .residence import index_path_for
   332	
   333	    checks: list[Check] = []
   334	    size = _log_size(canonical)
   335	    if size < 0:
   336	        return AgreementReport(
   337	            (Check("log", False, f"canonical log unreadable at {canonical}"),)
   338	        )
   339	
   340	    conn = _open_index(index_path_for(canonical))
   341	    if conn is None:
   342	        return AgreementReport(
   343	            (
   344	                Check(
   345	                    "index",
   346	                    False,
   347	                    f"no readable derived index at {index_path_for(canonical)} — "
   348	                    "run any read verb to materialize it, then verify",
   349	                ),
   350	            )
   351	        )
   352	    try:
   353	        checks.append(Check("index", True, "derived index readable"))
   354	        offset = _meta_int(conn, OFFSET_KEY)
   355	        counts = _row_counts(conn)
   356	        checks.append(_check_offset(conn, canonical, offset, size))
   357	        checks.append(_check_counts(conn, counts))
   358	        checks.append(_check_last_line(conn, canonical, size, offset))
   359	        return AgreementReport(tuple(checks), counts=counts)
   360	    finally:
   361	        conn.close()
   362	
   363	
   364	def _row_counts(conn) -> dict[str, int]:
   365	    return {
   366	        "facts": conn.execute("SELECT COUNT(*) FROM facts").fetchone()[0],
   367	        "ticks": conn.execute("SELECT COUNT(*) FROM ticks").fetchone()[0],
   368	    }
