   241	def log_block(facts: list[dict], ticks: list[dict] | None = None) -> "Block":
   242	    """Render facts and ticks interleaved chronologically with date grouping.
   243	
   244	    Returns a Block. Pass ticks=None or [] for fact-only logs.
   245	    """
   246	    from painted.core.block import Block
   247	    from painted.core.compose import join_vertical
   248	    from painted.palette import current_palette
   249	
   250	    ticks = ticks or []
   251	
   252	    if not facts and not ticks:
   253	        p = current_palette()
   254	        return Block.text("No facts in the given time range.", p.muted)
   255	
   256	    # Build unified timeline: (ts, type, item)
   257	    entries: list[tuple[float, str, dict]] = []
   258	    for f in facts:
   259	        ts = f["ts"]
   260	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   261	        entries.append((ts_val, "fact", f))
   262	    for t in ticks:
   263	        ts = t["ts"]
   264	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   265	        entries.append((ts_val, "tick", t))
   266	
   267	    entries.sort(key=lambda e: e[0])
   268	
   269	    p = current_palette()
   270	    # Group by date, then join groups with gap=1
   271	    date_groups: list[Block] = []
   272	    current_group: list[Block] = []
   273	    current_date = None
   274	    for ts_val, entry_type, item in entries:
   275	        dt = datetime.fromtimestamp(ts_val, tz=timezone.utc)
   276	        date_str = format_date(dt)
   277	        if date_str != current_date:
   278	            if current_group:
   279	                date_groups.append(join_vertical(*current_group))
   280	            current_group = [Block.text(f"{date_str}:", p.accent)]
   281	            current_date = date_str
   282	
   283	        if entry_type == "fact":
   284	            current_group.append(fact_line(item))
   285	        else:
   286	            current_group.append(tick_line(item))
   287	
   288	    if current_group:
   289	        date_groups.append(join_vertical(*current_group))
   290	
   291	    return join_vertical(*date_groups, gap=1)
   292	
   293	
   294	def format_ts_iso(dt: datetime) -> str:
   295	    """Format datetime as ISO 8601 for FULL zoom display."""
   296	    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")
   297	
   298	
   299	def _is_secondary(key: str, value) -> bool:
   300	    """Whether a payload field should be shown on continuation lines at DETAILED+.
   301	
   302	    Secondary: description, worktree, output, message, base_branch, or any value >40 chars.
   303	    """
   304	    if key in ("description", "worktree", "output", "message", "base_branch"):
   305	        return True
   306	    return isinstance(value, str) and len(value) > 40
   307	
   308	
   309	def fact_line_zoom(fact: dict, zoom) -> "list[Block]":
   310	    """Render a fact as one or more Blocks depending on zoom level.
   311	
   312	    SUMMARY: delegates to fact_line() — single line.
   313	    DETAILED: primary line + secondary fields on indented continuation lines.
   314	    FULL: ISO timestamp, each payload field on its own indented line.
   315	    """
   316	    from painted import Zoom
   317	    from painted.core.block import Block
   318	    from painted.palette import current_palette
   319	
   320	    if zoom <= Zoom.SUMMARY:
   321	        return [fact_line(fact)]
   322	
   323	    p = current_palette()
   324	    ts = fact["ts"]
   325	    if isinstance(ts, datetime):
   326	        dt = ts
   327	    else:
   328	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   329	
   330	    kind = fact["kind"]
   331	    obs = fact.get("observer", "")
   332	    payload = fact["payload"]
   333	    who = f" ({obs})" if obs else ""
   334	
   335	    if zoom == Zoom.FULL:
   336	        # ISO timestamp, kind + observer on primary line, each field on own line
   337	        time_str = format_ts_iso(dt)
   338	        lines: list[Block] = [Block.text(f"  {time_str} [{kind}]{who}", p.muted)]
   339	        for k, v in payload.items():
   340	            if v is not None and v != "":
   341	                lines.append(Block.text(f"      {k}={v}", p.muted))
   342	        origin = fact.get("origin", "")
   343	        if origin:
   344	            lines.append(Block.text(f"      origin={origin}", p.muted))
   345	        return lines
   346	
   347	    # DETAILED: primary fields inline, secondary on continuation lines
   348	    primary_parts = []
   349	    secondary: list[tuple[str, str]] = []
   350	    for k, v in payload.items():
   351	        if v is None or v == "":
   352	            continue
   353	        if _is_secondary(k, v):
   354	            secondary.append((k, str(v)))
   355	        else:
   356	            primary_parts.append(f"{k}={v}")
   357	
   358	    time_str = format_ts(dt)
   359	    summary = " ".join(primary_parts)
   360	    text = f"  {time_str} [{kind}]{who} {summary}" if summary else f"  {time_str} [{kind}]{who}"
   361	    lines = [Block.text(text, p.muted)]
   362	    for k, v in secondary:
   363	        lines.append(Block.text(f"      {k}={v}", p.muted))
   364	    return lines
   365	
   366	
   367	def tick_line_zoom(tick: dict, zoom) -> "list[Block]":
   368	    """Render a tick as one or more Blocks depending on zoom level.
   369	
   370	    SUMMARY: delegates to tick_line() — single line.
   371	    DETAILED: + origin if present.
   372	    FULL: ISO timestamp, all payload fields individually.
   373	    """
   374	    from painted import Zoom
   375	    from painted.core.block import Block
   376	    from painted.palette import current_palette
   377	
   378	    if zoom <= Zoom.SUMMARY:
   379	        return [tick_line(tick)]
   380	
   381	    p = current_palette()
   382	    ts = tick["ts"]
   383	    if isinstance(ts, datetime):
   384	        dt = ts
   385	    else:
   386	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   387	
   388	    payload = tick.get("payload", {}) if isinstance(tick.get("payload"), dict) else {}
   389	    origin = tick.get("origin", "")
   390	
   391	    if zoom == Zoom.FULL:
   392	        time_str = format_ts_iso(dt)
   393	        name = tick.get("name", "")
   394	        lines: list[Block] = [Block.text(f"  {time_str} ⚡ {name}", p.accent)]
   395	        for k, v in payload.items():
   396	            if v is not None and v != "":
   397	                lines.append(Block.text(f"      {k}={v}", p.muted))
   398	        if origin:
   399	            lines.append(Block.text(f"      origin={origin}", p.muted))
   400	        return lines
   401	
   402	    # DETAILED: normal tick line + origin continuation
   403	    lines = [tick_line(tick)]
   404	    if origin:
   405	        lines.append(Block.text(f"      origin={origin}", p.muted))
   406	    return lines
   407	
   408	
   409	def log_block_zoom(facts: list[dict], ticks: list[dict] | None, zoom) -> "Block":
   410	    """Render facts and ticks with zoom-aware detail.
   411	
   412	    MINIMAL: kind counts one-liner.
   413	    SUMMARY/DETAILED/FULL: date-grouped timeline using fact_line_zoom/tick_line_zoom.
   414	    """
   415	    from painted import Zoom
   416	    from painted.core.block import Block
   417	    from painted.core.compose import join_vertical
   418	    from painted.palette import current_palette
   419	
   420	    ticks = ticks or []
   421	    p = current_palette()
   422	
   423	    if not facts and not ticks:
   424	        return Block.text("No facts in the given time range.", p.muted)
   425	
   426	    if zoom == Zoom.MINIMAL:
   427	        # Count facts by kind, one-liner
   428	        counts: dict[str, int] = {}
   429	        for f in facts:
   430	            kind = f["kind"]
   431	            counts[kind] = counts.get(kind, 0) + 1
   432	        for t in ticks:
   433	            counts["tick"] = counts.get("tick", 0) + 1
   434	        parts = [f"{n} {k}" for k, n in sorted(counts.items())]
   435	        return Block.text(", ".join(parts), p.muted)
   436	
   437	    # SUMMARY/DETAILED/FULL — date-grouped timeline
   438	    entries: list[tuple[float, str, dict]] = []
   439	    for f in facts:
   440	        ts = f["ts"]
   441	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   442	        entries.append((ts_val, "fact", f))
   443	    for t in ticks:
   444	        ts = t["ts"]
   445	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   446	        entries.append((ts_val, "tick", t))
   447	
   448	    entries.sort(key=lambda e: e[0])
   449	
   450	    # Group by date, then join groups with gap=1
   451	    date_groups: list[Block] = []
   452	    current_group: list[Block] = []
   453	    current_date = None
   454	    for ts_val, entry_type, item in entries:
   455	        dt = datetime.fromtimestamp(ts_val, tz=timezone.utc)
   456	        date_str = format_date(dt)
   457	        if date_str != current_date:
   458	            if current_group:
   459	                date_groups.append(join_vertical(*current_group))
   460	            current_group = [Block.text(f"{date_str}:", p.accent)]
   461	            current_date = date_str
   462	
   463	        if entry_type == "fact":
   464	            current_group.extend(fact_line_zoom(item, zoom))
   465	        else:
   466	            current_group.extend(tick_line_zoom(item, zoom))
   467	
   468	    if current_group:
   469	        date_groups.append(join_vertical(*current_group))
   470	
   471	    return join_vertical(*date_groups, gap=1)
   472	
