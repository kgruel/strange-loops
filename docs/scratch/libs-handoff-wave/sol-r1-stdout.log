   223	        # Raised by our own hooks — already the right error, with the right
   224	        # message. Re-wrapping it as "not valid JSON" would bury the reason.
   225	        raise
   226	    except ValueError as exc:
   227	        raise JsonlCodecError(f"not valid JSON: {exc}") from exc
   228	    if not isinstance(obj, dict):
   229	        raise JsonlCodecError(
   230	            f"line must be a JSON object, got {type(obj).__name__}"
   231	        )
   232	    return obj
   233	
