    36	        cls.__dataclass_fields__ = fields
    37	        cls.__dataclass_params__ = dataclasses._DataclassParams(
    38	            init=True, repr=True, eq=True, order=False, unsafe_hash=False, frozen=True,
    39	            match_args=True, kw_only=False, slots=True, weakref_slot=False,
    40	        )
    41	        return fields
    42	
    43	
    44	def _freeze(val):
    45	    if isinstance(val, (dict, MappingProxyType)):
    46	        try:
    47	            return tuple(sorted((k, _freeze(v)) for k, v in val.items()))
    48	        except TypeError:
    49	            return tuple(sorted(
    50	                ((k, _freeze(v)) for k, v in val.items()),
    51	                key=lambda item: (type(item[0]).__name__, repr(item[0])),
    52	            ))
    53	    elif isinstance(val, (list, tuple)):
    54	        return tuple(_freeze(v) for v in val)
    55	    elif isinstance(val, set):
    56	        try:
    57	            return tuple(sorted(_freeze(v) for v in val))
    58	        except TypeError:
    59	            return tuple(sorted(
    60	                (_freeze(v) for v in val),
    61	                key=lambda item: (type(item).__name__, repr(item)),
    62	            ))
    63	    return val
