    74	class JsonlCodecError(ValueError):
    75	    """A JSONL line does not match the canonical schema."""
    76	
    77	
    78	# Column order — the one spelling of it. ``engine.sqlite_store`` builds its
    79	# INSERT statements from these tuples, so a schema column and a log field can
    80	# never drift apart.
    81	FACT_FIELDS = ("id", "kind", "ts", "observer", "origin", "payload")
    82	_TICK_BASE_FIELDS = ("id", "name", "ts", "since", "origin", "payload")
    83	# The chain columns, named as a group because a consumer that carries a tick
    84	# ACROSS stores must null them — they are store-local custody — and would
    85	# otherwise re-count them by hand. The codec owns the COUNT; whether to null
    86	# them is the consumer's decision, not this module's.
    87	TICK_CHAIN_FIELDS = ("prev_hash", "window_start", "fact_cursor", "window_hash")
    88	TICK_FIELDS = (*_TICK_BASE_FIELDS, *TICK_CHAIN_FIELDS)
    89	SIGNATURE_FIELD = "signature"
    90	_SIGNATURE = SIGNATURE_FIELD
    91	
    92	# Which fields of a row may be null, per row class. Named at module level —
    93	# rather than inline in ``_SPEC`` — because they describe the SQLITE ROW, not
    94	# this module's line framing: :mod:`engine.arrival_body` frames the same rows
    95	# without a ``t`` discriminator and holds them to exactly this domain. One
    96	# definition of "what a well-formed row is" is what keeps the two framings
    97	# from drifting about it.
    98	FACT_NULLABLE: frozenset[str] = frozenset()
