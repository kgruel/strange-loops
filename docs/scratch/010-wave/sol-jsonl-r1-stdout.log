    44	
    45	def _make_store(path, *, prechain=True, chained=True, signed=True):
    46	    """Build a store spanning the eras asked for.
    47	
    48	    prechain: legacy narrow schema rows (NULL chain columns, no signature
    49	    columns at all) written before the chain existed.
    50	    chained: an unsigned chained tick through engine.append_tick.
    51	    signed: signed facts + a signed chained tick.
    52	    """
    53	    if prechain:
    54	        conn = sqlite3.connect(str(path))
    55	        conn.executescript("""\
    56	            CREATE TABLE facts (
    57	                id       TEXT NOT NULL PRIMARY KEY,
    58	                kind     TEXT NOT NULL,
    59	                ts       REAL NOT NULL,
    60	                observer TEXT NOT NULL,
    61	                origin   TEXT NOT NULL DEFAULT '',
    62	                payload  TEXT NOT NULL CHECK (json_valid(payload))
    63	            );
    64	            CREATE TABLE ticks (
    65	                id       TEXT NOT NULL PRIMARY KEY,
    66	                name     TEXT NOT NULL,
    67	                ts       REAL NOT NULL,
    68	                since    REAL,
    69	                origin   TEXT NOT NULL,
    70	                payload  TEXT NOT NULL CHECK (json_valid(payload))
    71	            );
    72	        """)
    73	        rows = [
    74	            (uid, "decision", _BASE_TS + i, "kyle", "",
    75	             json.dumps({"topic": f"old/{i}", "message": "uuid era ünïcode"}))
    76	            for i, uid in enumerate(_UUID_IDS)
    77	        ]
    78	        conn.executemany(
    79	            "INSERT INTO facts (id, kind, ts, observer, origin, payload) "
    80	            "VALUES (?, ?, ?, ?, ?, ?)", rows)
    81	        conn.execute(
    82	            "INSERT INTO ticks (id, name, ts, since, origin, payload) "
    83	            "VALUES (?, ?, ?, ?, ?, ?)",
    84	            (str(ULID()), "session", _BASE_TS + 50, _BASE_TS, "test",
    85	             json.dumps({"facts": 2})))
    86	        conn.commit()
    87	        conn.close()
    88	
    89	    from engine import SqliteStore, Tick
    90	
    91	    if chained:
    92	        store = SqliteStore(path=path, serialize=lambda d: d,
    93	                            deserialize=lambda d: d)
    94	        _append_facts(store, 3, "kyle", _BASE_TS + 100)
    95	        store.append_tick(Tick(
    96	            name="seal", ts=datetime.fromtimestamp(_BASE_TS + 150, tz=UTC),
    97	            origin="test", payload={"reason": "unsigned chained"},
    98	        ), enforce_floor=False)
    99	        store.close()
   100	
   101	    if signed:
   102	        store = SqliteStore(path=path, serialize=lambda d: d,
   103	                            deserialize=lambda d: d,
   104	                            tick_signer=_fake_signer,
   105	                            fact_signer=_fake_fact_signer)
   106	        _append_facts(store, 2, "kyle", _BASE_TS + 200)
   107	        _append_facts(store, 1, "guest", _BASE_TS + 210)
   108	        store.append_tick(Tick(
   109	            name="seal", ts=datetime.fromtimestamp(_BASE_TS + 250, tz=UTC),
   110	            origin="test", payload={"reason": "signed"},
   111	        ))
   112	        # A second tick with NO new facts — same fact_cursor as the one
   113	        # above, exercising the tie-break on tick append order.
   114	        store.append_tick(Tick(
   115	            name="seal", ts=datetime.fromtimestamp(_BASE_TS + 260, tz=UTC),
   116	            origin="test", payload={"reason": "no new facts"},
   117	        ))
   118	        store.close()
   119	    return path
