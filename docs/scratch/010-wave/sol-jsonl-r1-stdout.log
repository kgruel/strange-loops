   402	def test_duplicate_line_in_log_does_not_brick_reopen(tmp_path):
   403	    """Even a hand-corrupted log must leave the store openable.
   404	
   405	    The old failure mode: a rebuild raised from __init__ with DELETE FROM
   406	    facts uncommitted on a leaked connection, so every later open failed
   407	    with 'database is locked' — one bad open bricked the store forever.
   408	    """
   409	    import sqlite3
   410	
   411	    store = open_store(tmp_path)
   412	    log = log_path_for(store._path)
   413	    store.append(fact(message="one"))
   414	    store.close()
   415	
   416	    with log.open("a", encoding="utf-8") as fh:  # duplicate the only line
   417	        fh.write(lines(log)[0] + "\n")
   418	    conn = sqlite3.connect(str(tmp_path / "s.db"))
   419	    conn.execute("DELETE FROM store_meta WHERE key = 'jsonl_offset'")
   420	    conn.commit()
   421	    conn.close()
   422	
   423	    with pytest.raises(sqlite3.IntegrityError):
   424	        open_store(tmp_path)
   425	    # the db is not locked: a second attempt fails the same way, not worse
   426	    with pytest.raises(sqlite3.IntegrityError):
   427	        open_store(tmp_path)
