   586	    def current_chain_head(self) -> str | None:
   587	        """The row-identity hash of the latest *chained* tick, or None.
   588	
   589	        What a successor tick's ``prev_hash`` commits to (era-aware
   590	        ``_tick_row_hash``) — the "chain head" a genesis pins. None when the
   591	        store has no chained tick (a pre-chain-only or empty store pins on
   592	        the fact cursor instead). Read-only; never migrates schema.
   593	        """
   594	        cols = {r[1] for r in self._conn.execute("PRAGMA table_info(ticks)")}
   595	        if "window_hash" not in cols:
   596	            return None
   597	        row_sql = _TICK_ROW_SQL if "signature" in cols else _TICK_ROW_SQL_V1
   598	        row = self._conn.execute(
   599	            f"SELECT {row_sql} FROM ticks "
   600	            "WHERE window_hash IS NOT NULL ORDER BY rowid DESC LIMIT 1"
   601	        ).fetchone()
   602	        if row is None:
   603	            return None
   604	        # _tick_row_hash reads an 11-field row (signature at [10]); a delta-1
   605	        # schema yields 10 — pad the signature slot NULL.
   606	        return _tick_row_hash(row if len(row) > 10 else (*row, None))
