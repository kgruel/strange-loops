   219	    """Render facts and ticks interleaved chronologically with date grouping.
   220	
   221	    Returns a Block. Pass ticks=None or [] for fact-only logs.
   222	    """
   223	    from painted.core.block import Block
   224	    from painted.core.compose import join_vertical
   225	    from painted.palette import current_palette
   226	
   227	    ticks = ticks or []
   228	
   229	    if not facts and not ticks:
   230	        p = current_palette()
   231	        return Block.text("No facts in the given time range.", p.muted)
   232	
   233	    # Build unified timeline: (ts, type, item)
   234	    entries: list[tuple[float, str, dict]] = []
   235	    for f in facts:
   236	        ts = f["ts"]
   237	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   238	        entries.append((ts_val, "fact", f))
   239	    for t in ticks:
   240	        ts = t["ts"]
   241	        ts_val = ts.timestamp() if isinstance(ts, datetime) else ts
   242	        entries.append((ts_val, "tick", t))
   243	
   244	    entries.sort(key=lambda e: e[0])
   245	
   246	    p = current_palette()
   247	    # Group by date, then join groups with gap=1
   248	    date_groups: list[Block] = []
   249	    current_group: list[Block] = []
   250	    current_date = None
   251	    for ts_val, entry_type, item in entries:
   252	        dt = datetime.fromtimestamp(ts_val, tz=timezone.utc)
   253	        date_str = format_date(dt)
   254	        if date_str != current_date:
   255	            if current_group:
   256	                date_groups.append(join_vertical(*current_group))
   257	            current_group = [Block.text(f"{date_str}:", p.accent)]
   258	            current_date = date_str
   259	
   260	        if entry_type == "fact":
   261	            current_group.append(fact_line(item))
   262	        else:
   263	            current_group.append(tick_line(item))
   264	
   265	    if current_group:
   266	        date_groups.append(join_vertical(*current_group))
   267	
   268	    return join_vertical(*date_groups, gap=1)
