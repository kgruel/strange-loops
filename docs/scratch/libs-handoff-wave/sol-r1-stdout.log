   543	    if rowid <= 0:
   544	        return GENESIS_SENTINEL
   545	    row = conn.execute("SELECT id FROM facts WHERE rowid = ?", (rowid,)).fetchone()
   546	    return row[0] if row else GENESIS_SENTINEL
