     1	"""Public vertex-kind mutation API over the generic KDL splice layer.
     2	
     3	Text-level add/edit/remove of loop-kind definitions in `.vertex` files,
     4	plus a LoopDef-to-KDL serializer whose supported domain is the declarative
     5	kind surface: ``fold``, ``boundary``, ``search``, ``preview``, ``edge``,
     6	and ``lifecycle``. Per-kind ``parse`` pipelines are OUTSIDE that domain by
     7	contract — serializing a ``LoopDef`` with a parse pipeline raises
     8	``ValueError`` (a documented refusal, not a round-trip gap; zero corpus
     9	usage, scope-the-claim). Built on
    10	``population.kdl_insert_child`` / ``kdl_remove_child`` — comments,
    11	whitespace, and ordering of unrelated content are preserved.
    12	
    13	Guarantees:
    14	- Every mutation parses and validates the result before returning, and the
    15	  PARSER is the safety oracle: the pre-mutation and post-mutation parses
    16	  are compared and only the exact requested delta is admissible — sibling
    17	  kinds and non-kind content must be definition-equal or the mutation
    18	  raises and the original text stands (SOL-R2-01 arbiter ruling:
    19	  construction over detection; the lexical splice layer is best-effort
    20	  transformation only and carries no safety claim).
    21	- Insert-then-remove round-trips to byte-identical text when the ``loops``
    22	  block already exists across multiple lines.
    23	
    24	Documented one-way limitation (expand-on-insert): adding a kind to a
    25	single-line ``loops { ... }`` block expands it across lines (semantically
    26	equivalent, not byte-identical). Editing or removing a kind inside a
    27	single-line ``loops`` block is not supported — expand it first (any insert
    28	does) or reformat by hand.
    29	
    30	PROVABLE DOMAIN (SOL-R4-01 arbiter ruling): the lexical guards — sibling
    31	multiplicity (``_loops_block_child_names``) and comment detection
    32	(``_has_comment_outside_strings``) — are quote-aware scans over plain
    33	``"…"`` KDL strings only. KDL raw strings (``#"…"#`` / ``##"…"##``) and
    34	multi-line strings (``\"\"\"``) are OUTSIDE that domain: the scanners
    35	cannot track them, and the parser oracle is structurally blind to the
    36	physical multiplicity and trivia they can hide. Rather than grow a KDL
    37	lexer, every mutation refuses up front when the vertex text contains any
    38	of those delimiters (``_assert_scanner_provable_domain``) — a permanent,
    39	conservative refusal; edit such files by hand. The parser oracle
    40	(``_verified``) remains the post-condition backstop inside the domain.
    41	"""
    42	
    43	from __future__ import annotations
    44	
    45	from typing import TYPE_CHECKING
    46	
    47	from .ast import (
    48	    BoundaryAfter,
    49	    BoundaryEvery,
    50	    BoundaryWhen,
    51	    FoldAvg,
    52	    FoldBy,
    53	    FoldCollect,
    54	    FoldCount,
    55	    FoldLatest,
    56	    FoldMax,
    57	    FoldMin,
    58	    FoldSum,
    59	    FoldWindow,
    60	)
    61	from .population import (
    62	    kdl_find_block,
    63	    kdl_insert_child,
    64	    kdl_remove_child,
    65	    kdl_split_top_level_nodes,
    66	)
    67	
    68	if TYPE_CHECKING:
    69	    from .ast import Boundary, BoundaryCondition, LoopDef
    70	
    71	__all__ = [
    72	    "add_vertex_kind",
    73	    "edit_vertex_kind",
    74	    "loop_def_to_kdl",
    75	    "remove_vertex_kind",
    76	]
    77	
    78	
    79	# ---------------------------------------------------------------------------
    80	# Names and string values
    81	# ---------------------------------------------------------------------------
    82	
    83	# Conservative bare-identifier subset of KDL. The splice layer matches
    84	# children by first token, so quoted node names are not representable —
    85	# names outside this set are rejected rather than escaped.
    86	_BARE_NAME_CHARS = frozenset(
    87	    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
    88	)
    89	
    90	# Node names the loops block treats specially (never kind definitions).
    91	_RESERVED_KIND_NAMES = frozenset({"boundary"})
    92	
    93	
    94	def _validate_kind_name(kind: str) -> None:
    95	    if not kind:
    96	        raise ValueError("kind name is empty")
    97	    if kind in _RESERVED_KIND_NAMES:
    98	        raise ValueError(f"kind name {kind!r} is reserved inside the loops block")
    99	    if kind[0].isdigit() or kind[0] in ".-":
   100	        raise ValueError(
   101	            f"kind name {kind!r} must start with a letter or underscore"
   102	        )
   103	    bad = set(kind) - _BARE_NAME_CHARS
   104	    if bad:
   105	        raise ValueError(
   106	            f"kind name {kind!r} contains characters KDL cannot represent "
   107	            f"safely here: {sorted(bad)!r} (allowed: letters, digits, _ . -)"
   108	        )
   109	
   110	
   111	def _q(value: str, *, what: str) -> str:
   112	    """Quote a string as a KDL string literal.
   113	
   114	    Escapes backslash and double-quote; rejects control characters and
   115	    newlines rather than escaping them (they cannot survive the line-based
   116	    splice layer).
   117	    """
   118	    if any(ord(c) < 0x20 or ord(c) == 0x7F for c in value):
   119	        raise ValueError(
   120	            f"{what} {value!r} contains control characters or newlines, "
   121	            "which are not representable in a single-line KDL value here"
   122	        )
   123	    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
   124	
   125	
   126	def _num(value: float) -> str:
   127	    """Emit a float as a KDL number, dropping a trailing .0 when integral."""
   128	    if float(value).is_integer():
   129	        return str(int(value))
   130	    return repr(float(value))
   131	
   132	
   133	# ---------------------------------------------------------------------------
   134	# LoopDef -> KDL serializer
   135	# ---------------------------------------------------------------------------
   136	
   137	
   138	def _fold_op_kdl(target: str, op) -> str:
   139	    t = _q(target, what="fold target") if set(target) - _BARE_NAME_CHARS else target
   140	    if isinstance(op, FoldCount):
   141	        return f'{t} "count"'
   142	    if isinstance(op, FoldLatest):
   143	        return f'{t} "latest"'
   144	    if isinstance(op, FoldBy):
   145	        return f'{t} "by" {_q(op.key_field, what="fold key_field")}'
   146	    if isinstance(op, FoldSum):
   147	        return f'{t} "sum" {_q(op.field, what="fold field")}'
   148	    if isinstance(op, FoldMax):
   149	        return f'{t} "max" {_q(op.field, what="fold field")}'
   150	    if isinstance(op, FoldMin):
   151	        return f'{t} "min" {_q(op.field, what="fold field")}'
   152	    if isinstance(op, FoldAvg):
   153	        return f'{t} "avg" {_q(op.field, what="fold field")}'
   154	    if isinstance(op, FoldCollect):
   155	        return f'{t} "collect" {int(op.max_items)}'
   156	    if isinstance(op, FoldWindow):
   157	        return f'{t} "window" {int(op.size)} {_q(op.field, what="fold field")}'
   158	    raise ValueError(f"Unknown fold op: {op!r}")
   159	
   160	
   161	def _condition_kdl(cond: BoundaryCondition) -> str:
   162	    value = (
   163	        _num(cond.value)
   164	        if isinstance(cond.value, (int, float))
   165	        else _q(str(cond.value), what="condition value")
   166	    )
   167	    return (
   168	        f'condition {_q(cond.target, what="condition target")} '
   169	        f'{_q(cond.op, what="condition op")} {value}'
   170	    )
   171	
   172	
   173	def _boundary_kdl(boundary: Boundary, indent: str) -> list[str]:
   174	    children: list[str] = []
   175	    if isinstance(boundary, BoundaryWhen):
   176	        head = f'boundary when={_q(boundary.kind, what="boundary kind")}'
   177	        for k, v in boundary.match:
   178	            if set(k) - _BARE_NAME_CHARS:
   179	                raise ValueError(
   180	                    f"boundary match field {k!r} is not a bare KDL identifier"
   181	                )
   182	            head += f' {k}={_q(v, what="boundary match value")}'
   183	        children.extend(_condition_kdl(c) for c in boundary.conditions)
   184	    elif isinstance(boundary, BoundaryAfter):
   185	        head = f"boundary after={int(boundary.count)}"
   186	    elif isinstance(boundary, BoundaryEvery):
   187	        head = f"boundary every={int(boundary.count)}"
   188	    else:
   189	        raise ValueError(f"Unknown boundary: {boundary!r}")
   190	
   191	    if boundary.run is not None:
   192	        children.append(f'run {_q(boundary.run, what="boundary run command")}')
   193	
   194	    if not children:
   195	        return [head]
   196	    lines = [head + " {"]
   197	    lines.extend(indent + c for c in children)
   198	    lines.append("}")
   199	    return lines
   200	
   201	
   202	def loop_def_to_kdl(kind: str, definition: LoopDef, indent: str = "  ") -> str:
   203	    """Serialize a LoopDef as the KDL block ``<kind> { ... }``.
   204	
   205	    Supported domain (the declarative kind surface): ``fold``, ``boundary``,
   206	    ``search``, ``preview``, ``edge``, and ``lifecycle``. Within that
   207	    domain, the output re-parses (via the lang loader) to an equivalent
   208	    LoopDef.
   209	
   210	    Per-kind ``parse`` pipelines are OUTSIDE the supported domain by
   211	    contract: passing a LoopDef with a parse pipeline raises ValueError.
   212	    This is a documented refusal, not a round-trip gap — no full-LoopDef
   213	    round-trip is claimed. Also raises ValueError for names or values KDL
   214	    cannot represent safely here.
   215	    """
   216	    _validate_kind_name(kind)
   217	    if definition.parse:
   218	        raise ValueError(
   219	            "loop_def_to_kdl serializes the declarative kind surface only "
   220	            "(fold/boundary/search/preview/edge/lifecycle); per-kind parse "
   221	            "pipelines are outside its supported domain by contract — "
   222	            "author the parse block by hand"
   223	        )
   224	
   225	    body: list[str] = []
   226	
   227	    if definition.folds:
   228	        body.append("fold {")
   229	        for decl in definition.folds:
   230	            body.append(indent + _fold_op_kdl(decl.target, decl.op))
   231	        body.append("}")
   232	
   233	    if definition.boundary is not None:
   234	        body.extend(_boundary_kdl(definition.boundary, indent))
   235	
   236	    if definition.search:
   237	        body.append(
   238	            "search "
   239	            + " ".join(_q(f, what="search field") for f in definition.search)
   240	        )
   241	
   242	    if definition.preview_fields:
   243	        body.append(
   244	            "preview "
   245	            + " ".join(_q(f, what="preview field") for f in definition.preview_fields)
   246	        )
   247	
   248	    for edge in definition.edges:
   249	        body.append(
   250	            f'edge {_q(edge.field, what="edge field")} '
   251	            f'targets={_q(edge.target, what="edge target")}'
   252	        )
   253	
   254	    if definition.lifecycle is not None:
   255	        lc = definition.lifecycle
   256	        for v in lc.active:
   257	            if "," in v or v != v.strip() or not v:
   258	                raise ValueError(
   259	                    f"lifecycle active value {v!r} cannot round-trip through "
   260	                    "the comma-separated active= property"
   261	                )
   262	        active = ",".join(lc.active)
   263	        body.append(
   264	            f'lifecycle {_q(lc.field, what="lifecycle field")} '
   265	            f'active={_q(active, what="lifecycle active set")}'
   266	        )
   267	
   268	    if not body:
   269	        return f"{kind} {{ }}"
   270	    lines = [f"{kind} {{"]
   271	    lines.extend(indent + ln for ln in body)
   272	    lines.append("}")
   273	    return "\n".join(lines)
   274	
   275	
   276	# ---------------------------------------------------------------------------
   277	# Mutations
   278	# ---------------------------------------------------------------------------
   279	
   280	
   281	def _parse_vertex_or_raise(text: str, context: str):
   282	    """Parse vertex text, wrapping parser errors as a clear ValueError."""
   283	    from .loader import parse_vertex
   284	
   285	    try:
   286	        return parse_vertex(text)
   287	    except Exception as exc:
   288	        raise ValueError(
   289	            f"{context}: input is not a parseable vertex: {exc}"
   290	        ) from exc
   291	
   292	
   293	# Delimiters of KDL string syntax the lexical scanners cannot track.
   294	# ``#"`` opens (and ``"#`` closes) a raw string of any hash depth — matching
   295	# either substring anywhere (even inside a plain string) is deliberately
   296	# over-broad: refusal is the cheap, permanent answer (zero raw strings in the
   297	# .vertex corpus). ``\"\"\"`` is a KDL multi-line string opener, equally
   298	# untrackable by the single-line quote scan.
   299	_UNPROVABLE_DELIMITERS = ('#"', '"#', '"""')
   300	
   301	
   302	def _assert_scanner_provable_domain(text: str, context: str) -> None:
   303	    """Refuse mutation over syntax the lexical scanners cannot prove safe.
   304	
   305	    See the module docstring's PROVABLE DOMAIN contract (SOL-R4-01). The
   306	    scan covers the WHOLE vertex text, not just the ``loops`` block: the
   307	    block span itself is found by the same raw-string-blind line scan, so a
   308	    raw string outside the block could corrupt the span the guards inspect.
   309	    """
   310	    for delim in _UNPROVABLE_DELIMITERS:
   311	        if delim in text:
   312	            raise ValueError(
   313	                f"{context}: the vertex text contains {delim!r} — KDL "
   314	                "raw-string / multi-line-string syntax the mutation "
   315	                "scanner cannot prove safe to splice over (its guards "
   316	                'track plain "…" strings only); edit the file by hand'
   317	            )
   318	
   319	
   320	def _loops_block_child_names(text: str) -> list[str]:
   321	    """First tokens of every depth-0 child node in the ``loops`` block.
   322	
   323	    Raw-text multiplicity view — the one thing the parser oracle cannot see
   324	    (duplicate kind nodes collapse last-wins in the parse). Line-based and
   325	    brace-counted like the splice layer; comment tokens are skipped. Empty
   326	    when there is no ``loops`` block.
   327	    """
   328	    try:
   329	        start, end = kdl_find_block(text, ["loops"])
   330	    except ValueError:
   331	        return []
   332	    lines = text.splitlines()
   333	    names: list[str] = []
   334	
   335	    def _collect_line_nodes(segment: str) -> None:
   336	        for node in kdl_split_top_level_nodes(segment):
   337	            tok = node.split(None, 1)[0].split("{", 1)[0]
   338	            if tok and not tok.startswith("/"):
   339	                names.append(tok)
   340	
   341	    if start == end:
   342	        line = lines[start]
   343	        _collect_line_nodes(line[line.index("{") + 1 : line.rindex("}")])
   344	        return names
   345	
   346	    i = start + 1
   347	    while i < end:
   348	        stripped = lines[i].strip()
   349	        if not stripped or stripped.startswith("//"):
   350	            i += 1
   351	            continue
   352	        opens = stripped.count("{") - stripped.count("}")
   353	        if opens > 0:
   354	            tok = stripped.split(None, 1)[0].split("{", 1)[0]
   355	            if tok and not tok.startswith("/"):
   356	                names.append(tok)
   357	            depth = opens
   358	            i += 1
   359	            while i < end and depth > 0:
   360	                depth += lines[i].count("{") - lines[i].count("}")
   361	                i += 1
   362	            continue
   363	        _collect_line_nodes(stripped)
   364	        i += 1
   365	    return names
   366	
   367	
   368	def _assert_unique_kind_nodes(text: str, context: str) -> None:
   369	    """Refuse duplicate loop-kind nodes in the INPUT (SOL-R3-01 part a).
   370	
   371	    The parser collapses duplicate kind names last-wins, so the parser
   372	    oracle is structurally blind to them: a splice that loses one physical
   373	    duplicate parses definition-equal. Duplicates in the input are
   374	    pathological — a pre-condition refusal on the raw text, not a safety
   375	    detector; the parser oracle remains the post-condition authority.
   376	    """
   377	    from collections import Counter
   378	
   379	    counted = Counter(
   380	        n for n in _loops_block_child_names(text)
   381	        if n not in _RESERVED_KIND_NAMES
   382	    )
   383	    dupes = sorted(n for n, c in counted.items() if c > 1)
   384	    if dupes:
   385	        raise ValueError(
   386	            f"{context}: duplicate loop-kind declaration(s) {dupes} in the "
   387	            "loops block — the parser resolves duplicates last-wins, so a "
   388	            "text mutation over them cannot be verified; deduplicate the "
   389	            "vertex by hand first"
   390	        )
   391	
   392	
   393	def _has_comment_outside_strings(s: str) -> bool:
   394	    """Quote-aware scan for KDL comment openers (``//``, ``/*``, ``/-``)."""
   395	    in_str = esc = False
   396	    for i, ch in enumerate(s):
   397	        if in_str:
   398	            if esc:
   399	                esc = False
   400	            elif ch == "\\":
   401	                esc = True
   402	            elif ch == '"':
   403	                in_str = False
   404	        elif ch == '"':
   405	            in_str = True
   406	        elif ch == "/" and i + 1 < len(s) and s[i + 1] in "/*-":
   407	            return True
   408	    return False
   409	
   410	
   411	def _verified(
   412	    before,
   413	    result: str,
   414	    context: str,
   415	    *,
   416	    added: str | None = None,
   417	    edited: str | None = None,
   418	    removed: str | None = None,
   419	    definition=None,
   420	) -> str:
   421	    """Parse + validate mutated text AND assert the exact expected delta.
   422	
   423	    The PARSER is the safety oracle (arbiter ruling, SOL-R2-01): the
   424	    line/lexeme-based splice layer is best-effort transformation only, so
   425	    every mutation re-parses the result and compares it against the
   426	    pre-mutation parse. The only admissible delta is the requested one —
   427	    add: original kind set plus the new kind, every original definition
   428	    equal; edit: same kind set, only the target changed; remove: set minus
   429	    the target, every other definition equal. Non-loop content (sources,
   430	    routes, store, …) must be untouched in all three. Any mismatch raises
   431	    ValueError naming the preserved-content violation, and the caller's
   432	    original text is never replaced. This makes silent sibling loss
   433	    inexpressible regardless of lexical evasion class (raw strings,
   434	    escaped quotes, comments).
   435	    """
   436	    from .validator import validate_vertex
   437	
   438	    try:
   439	        after = _parse_vertex_or_raise(result, context)
   440	        validate_vertex(after)
   441	    except Exception as exc:
   442	        raise ValueError(
   443	            f"{context} produced an invalid vertex: {exc}"
   444	        ) from exc
   445	
   446	    before_kinds = set(before.loops)
   447	    expected = set(before_kinds)
   448	    if added is not None:
   449	        expected.add(added)
   450	    if removed is not None:
   451	        expected.discard(removed)
   452	    after_kinds = set(after.loops)
   453	    if after_kinds != expected:
   454	        lost = sorted(expected - after_kinds)
   455	        gained = sorted(after_kinds - expected)
   456	        raise ValueError(
   457	            f"{context} violated content preservation: resulting kind set "
   458	            f"differs from the expected delta (lost: {lost}, unexpected: "
   459	            f"{gained}) — refusing; the original text is unchanged. If the "
   460	            "kind shares its physical line with siblings, split each kind "
   461	            "onto its own line first"
   462	        )
   463	    target = added if added is not None else edited
   464	    if target is not None and definition is not None:
   465	        if after.loops.get(target) != definition:
   466	            raise ValueError(
   467	                f"{context} violated content preservation: kind {target!r} "
   468	                "parses back different from the requested definition — "
   469	                "refusing; the original text is unchanged"
   470	            )
   471	    mutated = {added, edited, removed} - {None}
   472	    for k in before_kinds - mutated:
   473	        if before.loops[k] != after.loops[k]:
   474	            raise ValueError(
   475	                f"{context} violated content preservation: sibling kind "
   476	                f"{k!r} was altered by the text splice — refusing; the "
   477	                "original text is unchanged"
   478	            )
   479	    # Non-kind vertex content (store, sources, routes, …) must be untouched.
   480	    # VertexFile fields are exposed via __match_args__ (the frozen-AST shim).
   481	    for f in type(before).__match_args__:
   482	        if f == "loops":
   483	            continue
   484	        if getattr(before, f) != getattr(after, f):
   485	            raise ValueError(
   486	                f"{context} violated content preservation: non-kind vertex "
   487	                f"content changed (field {f!r}) — refusing; the original "
   488	                "text is unchanged"
   489	            )
   490	    return result
   491	
   492	
   493	def add_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   494	    """Add a loop-kind definition to vertex text; returns the new text.
   495	
   496	    Creates the ``loops`` block (appended at end of file) when absent.
   497	    Refuses if the kind already exists. Note the one-way expand-on-insert
   498	    limitation: a single-line ``loops { ... }`` block is expanded across
   499	    lines by the insert.
   500	    """
   501	    _validate_kind_name(kind)
   502	    before = _parse_vertex_or_raise(text, f"add_vertex_kind({kind!r})")
   503	    _assert_scanner_provable_domain(text, f"add_vertex_kind({kind!r})")
   504	    _assert_unique_kind_nodes(text, f"add_vertex_kind({kind!r})")
   505	    if kind in before.loops:
   506	        raise ValueError(f"kind {kind!r} already exists; use edit_vertex_kind")
   507	
   508	    child = loop_def_to_kdl(kind, definition)
   509	    try:
   510	        kdl_find_block(text, ["loops"])
   511	        has_loops = True
   512	    except ValueError:
   513	        has_loops = False
   514	    if has_loops:
   515	        result = kdl_insert_child(text, ["loops"], child)
   516	    else:
   517	        # No loops block — create one at end of file.
   518	        indented = "\n".join(
   519	            ("  " + ln) if ln.strip() else ln for ln in child.splitlines()
   520	        )
   521	        block = f"loops {{\n{indented}\n}}\n"
   522	        if text and not text.endswith("\n"):
   523	            text += "\n"
   524	        result = text + block
   525	    return _verified(
   526	        before, result, f"add_vertex_kind({kind!r})",
   527	        added=kind, definition=definition,
   528	    )
   529	
   530	
   531	def edit_vertex_kind(text: str, kind: str, definition: LoopDef) -> str:
   532	    """Replace an existing kind's definition in place; returns the new text.
   533	
   534	    Preserves the kind's position and all surrounding content. Not
   535	    supported when the whole ``loops`` block is a single line (the
   536	    documented expand-on-insert limitation is one-way).
   537	    """
   538	    _validate_kind_name(kind)
   539	    before = _parse_vertex_or_raise(text, f"edit_vertex_kind({kind!r})")
   540	    _assert_scanner_provable_domain(text, f"edit_vertex_kind({kind!r})")
   541	    _assert_unique_kind_nodes(text, f"edit_vertex_kind({kind!r})")
   542	    try:
   543	        start, end = kdl_find_block(text, ["loops", kind])
   544	    except ValueError as exc:
   545	        raise ValueError(
   546	            f"kind {kind!r} not found in loops block (single-line loops "
   547	            "blocks cannot be edited in place — expand across lines first): "
   548	            f"{exc}"
   549	        ) from exc
   550	
   551	    lines = text.splitlines()
   552	    # Trailing-trivia honesty (SOL-R3-01 part c): the splice regenerates the
   553	    # whole block, so it can carry through exactly ONE piece of trivia — the
   554	    # suffix after the block's final close (`} // note`). Anything comment-
   555	    # shaped INSIDE the replaced span would be silently dropped by the
   556	    # regeneration; _verified claims preservation, so that is a refusal.
   557	    end_line = lines[end]
   558	    close_idx = end_line.rindex("}")
   559	    suffix = end_line[close_idx + 1 :].rstrip()
   560	    interior = "\n".join([*lines[start:end], end_line[: close_idx + 1]])
   561	    if _has_comment_outside_strings(interior):
   562	        raise ValueError(
   563	            f"edit_vertex_kind({kind!r}): the {kind!r} block carries a "
   564	            "comment the regenerated definition cannot preserve — move the "
   565	            "comment outside the block (or edit the file by hand) and retry"
   566	        )
   567	    kind_indent = lines[start][: len(lines[start]) - len(lines[start].lstrip())]
   568	    child = loop_def_to_kdl(kind, definition)
   569	    new_lines = [
   570	        (kind_indent + ln) if ln.strip() else ln for ln in child.splitlines()
   571	    ]
   572	    if suffix:
   573	        sep = "" if suffix.startswith((" ", "\t")) else " "
   574	        new_lines[-1] += sep + suffix
   575	    lines[start : end + 1] = new_lines
   576	    result = "\n".join(lines)
   577	    if text.endswith("\n"):
   578	        result += "\n"
   579	    return _verified(
   580	        before, result, f"edit_vertex_kind({kind!r})",
   581	        edited=kind, definition=definition,
   582	    )
   583	
   584	
   585	def remove_vertex_kind(text: str, kind: str) -> str:
   586	    """Remove a kind's definition from vertex text; returns the new text.
   587	
   588	    Not supported when the whole ``loops`` block is a single line. Refuses
   589	    (via post-validation) when removal would leave an invalid vertex, e.g.
   590	    removing the last kind of a vertex with no other sources.
   591	    """
   592	    _validate_kind_name(kind)
   593	    before = _parse_vertex_or_raise(text, f"remove_vertex_kind({kind!r})")
   594	    _assert_scanner_provable_domain(text, f"remove_vertex_kind({kind!r})")
   595	    _assert_unique_kind_nodes(text, f"remove_vertex_kind({kind!r})")
   596	    try:
   597	        result = kdl_remove_child(text, ["loops"], kind)
   598	    except ValueError as exc:
   599	        raise ValueError(
   600	            f"kind {kind!r} not found in loops block (single-line loops "
   601	            "blocks cannot be mutated in place — expand across lines first): "
   602	            f"{exc}"
   603	        ) from exc
   604	    return _verified(
   605	        before, result, f"remove_vertex_kind({kind!r})", removed=kind
   606	    )
   650	    # to make a durable JSONL line the authoritative write and sqlite the
   651	    # derived index, without touching mint logic or the read surface.
   652	    # ------------------------------------------------------------------
   653	
   654	    def _sync_derived_state(self) -> None:
   655	        """Seam: bring derived state up to date before reading chain state.
   656	
   657	        A no-op here — sqlite IS the state. A subclass whose sqlite is a
   658	        DERIVED index (engine.jsonl_store) must reconcile the index with its
   659	        canonical log *before* any mint reads chain state from it: a durable
   660	        but unindexed line would otherwise be invisible to the predecessor,
   661	        window-start and fact-cursor derivation, and the resulting mis-linked
   662	        tick lands in the canonical log where no rebuild can repair it.
   663	
   664	        Called at the top of ``append_tick`` (before the ``prev_row`` read)
   665	        and at the top of ``absorb_genesis``/``absorb_edit`` — strictly
   666	        BEFORE their ``BEGIN IMMEDIATE``, because a reconcile commits and
   667	        would split the ceremony transaction. The chain-head, fact-cursor and
   668	        declaration-head reads inside those transactions therefore see an
   669	        index that has consumed every durable line.
   670	        """
   671	
   672	    def _ceremony_persist(self, rows: list[tuple]) -> None:
   673	        """Seam: make a declaration ceremony's rows canonical, pre-commit.
   674	
   675	        Called inside the open ``BEGIN IMMEDIATE`` transaction, after every
   676	        CAS check has passed and all fact-row INSERTs (and meta stamps) are
   677	        staged, immediately before COMMIT. ``rows`` are the full 7-field
   678	        persisted fact rows, in emission order.
   679	
   680	        A no-op here — sqlite IS the store, and the staged INSERTs commit.
   681	        ``engine.jsonl_store`` overrides it to append the ceremony as ONE
   682	        durable log line (a plain fact line for one row, a ``batch`` envelope
   683	        for several) and stamp the consumed offset/counts, preserving
   684	        ``_write``'s ordering: refusals before any log byte, fsync before the
   685	        index row is observable.
   686	        """
   687	
   688	    def _committed_row_state(self, table: str, row_id: str) -> tuple[bool, str | None]:
   689	        """(exists, signature) of the row as it stands post-INSERT, pre-commit.
   690	
   691	        Existence and signature are separate answers (SOL-R4-02): a NULL
   692	        signature on a committed row and a row an AFTER trigger deleted are
   693	        different facts, and conflating them once minted a stored=True
   694	        receipt for no row. ``table`` is an internal constant
   695	        (``facts``/``ticks``), never caller input.
   696	        """
   697	        r = self._conn.execute(
   698	            f"SELECT signature FROM {table} WHERE id = ?", (row_id,)  # noqa: S608
   699	        ).fetchone()
   700	        return (r is not None, r[0] if r is not None else None)
   701	
   702	    def _committed_full_row(self, table: str, row_id: str) -> tuple:
   703	        """The COMPLETE inserted row, post-INSERT pre-commit, or refuse.
   704	
   705	        Read back after any AFTER triggers fired, in persisted column
   706	        order — what the store will actually commit. An absent row is the
   707	        SOL-R4-02 typed refusal. Used wherever the caller must compare or
   708	        persist the committed truth, not the assembled intent: the JSONL
   709	        log derivation (SOL-R4-03) and the ceremony full-row equality
   710	        check (R4 arbiter follow-up).
   711	        """
   712	        columns = FACT_COLUMNS if table == "facts" else TICK_COLUMNS
   713	        r = self._conn.execute(
   714	            f"SELECT {', '.join(columns)} FROM {table} "  # noqa: S608
   715	            "WHERE id = ?", (row_id,)
   716	        ).fetchone()
   717	        if r is None:
   718	            raise CommittedRowMissing(
   719	                f"the inserted {table} row {row_id} is ABSENT at pre-commit "
   720	                "read-back (a schema-level rewrite, e.g. an AFTER INSERT "
   721	                "trigger, deleted it) — rolling back; refusing to mint a "
   722	                "stored receipt for a row the store did not keep"
   723	            )
   724	        return tuple(r)
   725	
   726	    def _committed_signature(self, table: str, row_id: str) -> str | None:
   727	        """The COMMITTED signature; raises if the row itself is gone.
   728	
   729	        The one read-back per write (SOL-R3-02): executed after the INSERT
   730	        — so any AFTER triggers have already fired — and before the commit,
   731	        it reads exactly what will be committed. An ABSENT row (something
   732	        deleted it out from under the staged INSERT) is a typed refusal
   733	        (SOL-R4-02): callers roll back — a store that eats rows must not
   734	        get a stored=True receipt.
   735	        """
   736	        exists, signature = self._committed_row_state(table, row_id)
   737	        if not exists:
   738	            raise CommittedRowMissing(
   739	                f"the inserted {table} row {row_id} is ABSENT at pre-commit "
   740	                "read-back (a schema-level rewrite, e.g. an AFTER INSERT "
   741	                "trigger, deleted it) — rolling back; refusing to mint a "
   742	                "stored receipt for a row the store did not keep"
   743	            )
   744	        return signature
   745	
   746	    def _write_fact_row(self, row: tuple) -> str | None:
   747	        """Persist one assembled fact row (id, kind, ts, observer, origin,
   748	        payload, signature). Returns the COMMITTED signature (read back
   749	        inside the transaction, after triggers, before commit); raises
   750	        CommittedRowMissing — after rollback — if the row is gone."""
   751	        try:
   752	            self._conn.execute(FACT_INSERT_SQL, row)
   753	            committed = self._committed_signature("facts", row[0])
   754	            self._conn.commit()
   755	        except BaseException:
   756	            self._conn.rollback()
   757	            raise
   758	        return committed
   759	
   760	    def _write_tick_row(self, row: tuple) -> str | None:
   761	        """Persist one assembled tick row (_TICK_ROW_SQL order + signature).
   762	        Same read-back + rollback-on-absence contract as facts."""
   763	        try:
   764	            self._conn.execute(TICK_INSERT_SQL, row)
   765	            committed = self._committed_signature("ticks", row[0])
   766	            self._conn.commit()
   767	        except BaseException:
   768	            self._conn.rollback()
   769	            raise
   770	        return committed
   771	
   772	    def current_chain_head(self) -> str | None:
   773	        """The row-identity hash of the latest *chained* tick, or None.
   774	
   775	        What a successor tick's ``prev_hash`` commits to (era-aware
   776	        ``_tick_row_hash``) — the "chain head" a genesis pins. None when the
   777	        store has no chained tick (a pre-chain-only or empty store pins on
   778	        the fact cursor instead). Read-only; never migrates schema.
   779	        """
   780	        cols = {r[1] for r in self._conn.execute("PRAGMA table_info(ticks)")}
   781	        if "window_hash" not in cols:
   782	            return None
   783	        row_sql = _TICK_ROW_SQL if "signature" in cols else _TICK_ROW_SQL_V1
   784	        row = self._conn.execute(
   785	            f"SELECT {row_sql} FROM ticks "
   786	            "WHERE window_hash IS NOT NULL ORDER BY rowid DESC LIMIT 1"
   787	        ).fetchone()
   788	        if row is None:
   789	            return None
   790	        # _tick_row_hash reads an 11-field row (signature at [10]); a delta-1
   791	        # schema yields 10 — pad the signature slot NULL.
   792	        return _tick_row_hash(row if len(row) > 10 else (*row, None))
   793	
   794	    def absorb_genesis(
   795	        self,
   796	        documents: list,
   797	        *,
   798	        observer: str,
   799	        origin: str = "",
   800	        fact_signer: Callable[[str, str], str | None] | None,
   801	        protocol: int | None = None,
   802	    ) -> dict[str, Any]:
   803	        """Open the store's declaration lineage — the atomic genesis primitive.
   804	
   805	        The lineage-opening ceremony's write half (SPEC §9.2 era rule),
   806	        performed as ONE ``BEGIN IMMEDIATE`` transaction so the identity check,
   807	        the era pins, and the append are indivisible: a concurrent emit cannot
   808	        falsify a pin between read and write, and two concurrent absorbs cannot
   809	        both mint a genesis (the second blocks on the write lock, then sees the
   810	        first's row and refuses).
   811	
   812	        Steps, all inside the transaction:
   813	
   814	        1. Refuse (``GenesisExists``) if the store's OWN lineage is already
   815	           open — the ``store_meta.own_lineage`` marker exists. An unmarked
   816	           store with ANY ``_decl.genesis`` rows refuses as ambiguous:
   817	           identity is claimed only by the explicit :meth:`adopt_lineage`
   818	           ceremony, never inferred from facts (the singleton heuristic was
   819	           a hijack vector — closing re-review #1). Foreign genesis rows
   820	           (marker present, ids differ) do NOT block: merge legitimately
   821	           carries them as inert citizens (§9.2 Lineage), and a store that
   822	           received one must still be able to mint its own identity.
   823	        2. Read the era pins — chain head (latest chained tick's row hash) and
   824	           fact cursor (newest fact by WITNESS order / rowid) — so
   825	           "everything before me predates historization" is verifiable.
   826	        3. Build the whole payload (``documents`` + ``protocol`` + pins), sign
   827	           its CONTENT commitment under ``observer`` via ``fact_signer``, and
   828	           refuse (``UnsignableGenesis``, rollback) if no signature is
   829	           produced. The signed commitment is over the ACTUAL final payload,
   830	           never a throwaway probe — genesis is the attestation root.
   831	        4. Append the ``_decl.genesis`` row, stamp ``store_meta.own_lineage``
   832	           with its id (the store-local identity marker — merge copies facts,
   833	           never meta, so identity cannot arrive from outside), and commit.
   834	           The genesis row's own id IS the lineage id (§9.2), returned in the
   835	           receipt.
   836	
   837	        This is protocol surface the Go conformance oracle mirrors: the payload
   838	        shape (``protocol``, ``documents``, ``chain_head``, ``fact_cursor``),
   839	        the witness-order cursor, and the sign-final-payload rule are the
   840	        contract. ``documents`` are the subject-scoped declaration documents
   841	        (from ``lang.document.vertex_to_documents``); this method stamps the
   842	        protocol and pins around them.
   843	
   844	        Returns a receipt dict: ``{lineage, protocol, documents, chain_head,
   845	        fact_cursor, observer, signed}``.
   846	        """
   847	        from lang.document import DECL_GENESIS, DECLARATION_PROTOCOL_VERSION
   848	
   849	        if protocol is None:
   850	            protocol = DECLARATION_PROTOCOL_VERSION
   851	
   852	        # Prepare schema OUTSIDE the transaction (these commit): the genesis
   853	        # write and the chain-head read need the signature and chain columns
   854	        # present. Safe pre-work — they mutate no facts.
   855	        self._ensure_sync()
   856	        self._ensure_fact_signature_column()
   857	        self._ensure_chain_columns()
   858	        self._ensure_meta_table()
   859	        # Reconcile derived state BEFORE the transaction (a reconcile commits):
   860	        # the chain-head and fact-cursor pins read below must not miss a
   861	        # durable-but-unindexed line — a mis-pin lands in the canonical log
   862	        # where no rebuild can repair it. No-op when sqlite is the store.
   863	        self._sync_derived_state()
   864	
   865	        conn = self._conn
   866	        prev_iso = conn.isolation_level
   867	        conn.isolation_level = None  # autocommit — explicit transaction control
   868	        try:
   869	            conn.execute("BEGIN IMMEDIATE")
   870	            try:
   871	                own = self._own_lineage_in_txn(conn)
   872	                if own is not None:
   873	                    raise GenesisExists(
   874	                        "the store's own lineage is already open "
   875	                        f"(own_lineage {own}) — re-absorb/edit is a later "
   876	                        "ceremony (no --force)"
   877	                    )
   878	
   879	                chain_head = self.current_chain_head()
   880	                frow = conn.execute(
   881	                    "SELECT id FROM facts ORDER BY rowid DESC LIMIT 1"
   882	                ).fetchone()
   883	                fact_cursor = frow[0] if frow else None
   884	
   885	                payload = {
   886	                    "protocol": protocol,
   887	                    "documents": list(documents),
   888	                    "chain_head": chain_head,
   889	                    "fact_cursor": fact_cursor,
   890	                }
   891	                ts = datetime.now(_UTC).timestamp()
   892	                lineage_id = gen_id()
   893	                payload_text = json.dumps(payload)
   894	                signature = (
   895	                    fact_signer(
   896	                        observer,
   897	                        _fact_commitment_hash(
   898	                            DECL_GENESIS, ts, observer, origin, payload_text
   899	                        ),
   900	                    )
   901	                    if fact_signer is not None
   902	                    else None
   903	                )
   904	                if signature is None:
   905	                    raise UnsignableGenesis(
   906	                        f"no signature produced for observer {observer!r} — a "
   907	                        "genesis must be signed (it is the lineage's "
   908	                        "attestation root); set up signing first"
   909	                    )
   910	
   911	                row = (
   912	                    lineage_id, DECL_GENESIS, ts, observer, origin,
   913	                    payload_text, signature,
   914	                )
   915	                conn.execute(FACT_INSERT_SQL, row)
   916	                # Committed-row honesty (SOL-R3-02 + R4 arbiter follow-up):
   917	                # read the WHOLE row back after the INSERT (AFTER triggers
   918	                # fired), before any log byte and before COMMIT, and refuse
   919	                # on ANY divergence — the signature covers the final
   920	                # persisted payload (ratified encoding contract), so a
   921	                # rewritten non-signature field leaves a signature that no
   922	                # longer verifies against its row; persisting either the
   923	                # assembled or the mutated row would be a verification lie.
   924	                if self._committed_full_row("facts", lineage_id) != row:
   925	                    raise UnsignableGenesis(
   926	                        "the committed genesis row does not match the "
   927	                        "assembled, signed row (a schema-level rewrite, "
   928	                        "e.g. an AFTER INSERT trigger, altered it) — its "
   929	                        "signature would no longer verify against what the "
   930	                        "store holds; refusing to commit"
   931	                    )
   932	                conn.execute(
   933	                    "INSERT OR REPLACE INTO store_meta (key, value) "
   934	                    "VALUES ('own_lineage', ?)",
   935	                    (lineage_id,),
   936	                )
   937	                self._ceremony_persist([row])
   938	                conn.execute("COMMIT")
   939	            except Exception:
   940	                if conn.in_transaction:
   941	                    conn.execute("ROLLBACK")
   942	                raise
   943	        finally:
   944	            conn.isolation_level = prev_iso
   945	
   946	        return {
   947	            "lineage": lineage_id,
   948	            "protocol": protocol,
   949	            "documents": len(payload["documents"]),
   950	            "chain_head": chain_head,
   951	            "fact_cursor": fact_cursor,
   952	            "observer": observer,
   953	            "signed": True,
   954	        }
   955	
   956	    def absorb_edit(
   957	        self,
   958	        changes: list,
   959	        *,
   960	        observer: str,
   961	        origin: str = "",
   962	        fact_signer: Callable[[str, str], str | None] | None,
   963	        expected_head: tuple[float, str] | None = None,
   964	    ) -> dict[str, Any]:
   965	        """Re-emit changed declaration subjects over an open lineage (S4).
   966	
   967	        The edit ceremony's write half (SPEC §9.2). Each ``change`` is a
   968	        subject-granular whole-document delta (from
   969	        ``lang.document.diff_documents``), duck-typed by four attributes:
   970	        ``kind`` (the final ``_decl.*-defined`` or ``*-retired`` event kind),
   971	        ``subject``, ``payload`` (the whole document payload for a definition,
   972	        ``None`` for a removal), and ``annotation`` (``added``/``modified``/
   973	        ``removed`` — rides the row as ``change=``).
   974	
   975	        Performed as ONE ``BEGIN IMMEDIATE`` transaction so the batch is
   976	        all-or-nothing (a half-applied ontology change is the §9.1 lie
   977	        mid-flight) and the lineage id is read consistently:
   978	
   979	        1. Resolve the store's OWN lineage: the ``store_meta.own_lineage``
   980	           marker. No marker + no genesis rows → :class:`NoGenesis`;
   981	           unmarked + genesis rows → :class:`AmbiguousGenesis` (identity is
   982	           claimed by :meth:`adopt_lineage`, never inferred).
   983	        2. If ``expected_head`` is given, compare it against the store's
   984	           current declaration head — the ``(ts, id)`` of the newest
   985	           self-lineage ``_decl.*`` row (genesis included). A mismatch raises
   986	           :class:`StaleDeclarationHead` (rollback): the caller diffed against
   987	           a head that has since moved (concurrent re-absorb), and applying a
   988	           stale diff could leave the store matching neither input file.
   989	        3. Every row in the ceremony shares ONE effective ``ts``, stamped
   990	           once — the ceremony is a single ontology transition. Without this,
   991	           a historical ``as_of`` cursor could land *between* the rows of one
   992	           edit and observe a half-applied ontology (e.g. a rename showing
   993	           both old and new kinds) — transaction atomicity protects live
   994	           readers, not rewound ones.
   995	        4. Kinds are allowlisted to the frozen definition/tombstone vocabulary
   996	           (:class:`ReservedKindViolation` otherwise) — this primitive is the
   997	           edit ceremony's write half, not a general ``_decl.*`` append escape.
   998	        5. For each change, build the resolver's overlay/tombstone contract
   999	           payload — ``{lineage, subject, payload, change}`` for a definition,
  1000	           ``{lineage, subject, change}`` for a tombstone — sign its CONTENT
  1001	           commitment under ``observer``, and refuse (:class:`UnsignableEdit`,
  1002	           rollback) if any is unsigned. Append every row and commit.
  1003	
  1004	        An empty ``changes`` list is a no-op (no transaction, empty receipt) —
