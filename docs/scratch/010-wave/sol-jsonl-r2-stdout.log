   493	def test_two_open_handles_do_not_brick_the_store(tmp_path):
   494	    """Regression: per-handle count caching bricked a consistent store.
   495	
   496	    Two handles open at once (a daemon plus an ``sl emit``), one append
   497	    through each. The log has both lines, sqlite has both rows, the offset
   498	    equals the file size — fully consistent. A cached per-handle counter
   499	    made the second committer stamp 1 against COUNT(*)=2, so the next open
   500	    refused, naming out-of-band writers that never ran.
   501	    """
   502	    a = open_store(tmp_path)
   503	    b = open_store(tmp_path)
