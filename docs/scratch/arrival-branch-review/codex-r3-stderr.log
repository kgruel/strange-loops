   720	
   721	
   722	class ArrivalLog:
   723	    """One arrival log, addressed by its path.
   724	
   725	    Cheap to construct and holds no open file: every operation opens what it
   726	    needs. Appends across processes are mutually exclusive, enforced by an
   727	    advisory ``LOCK_EX`` on ``<name>.arrival.lock`` held for the whole
   728	    read-head, validate, write, fsync sequence. Reads take no lock and are
   729	    safe at any time against a concurrent append.
   730	
   731	    Exclusion rather than lock-free ``O_APPEND`` is forced by the addressing
   732	    scheme, not chosen for convenience: the ordinal follows from the head, so
   733	    correctness requires reading the head and writing to be indivisible. Two
   734	    processes that both read head ``ord=7`` would both write ``ord=8``, and a
   735	    duplicate coordinate is a corrupt interior that refuses forever.
   736	
   737	    ``flock`` specifically because it is released when the holding process
   738	    dies. A crashed writer must not wedge the store, which is the opposite of
   739	    what an ``O_EXCL`` lock file would give — that behaviour is right for the
   740	    one-shot genesis gate and wrong for an operation that runs constantly.
   741	    """
   742	
   743	    def __init__(self, path: Path | str) -> None:
   744	        self.path = Path(path)
   745	        self.lock_path = lock_path_for(self.path)
   746	        self.tmp_path = tmp_path_for(self.path)
   747	        # Memo for :meth:`_genesis_from`, keyed on the genesis line's bytes.
   748	        self._genesis_line: bytes | None = None
   749	        self._genesis_record: dict | None = None
