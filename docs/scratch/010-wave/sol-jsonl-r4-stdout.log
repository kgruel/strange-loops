   513	class _ChainWalk:
   514	    """Re-derives the tick chain from log content as the log streams by.
   515	
   516	    Keeps ``(id, row-hash)`` per fact — bounded by fact count, never payload
   517	    size — because a window commitment is a hash over the fact rows inside it
   518	    and the log is the only place those rows are authoritative.
   519	    """
   520	
   521	    def __init__(self) -> None:
   522	        self._fact_ids: list[str] = []
   523	        self._fact_hashes: list[bytes] = []
   524	        self._pos: dict[str, int] = {}
   525	        self._prev_row: tuple | None = None
   526	        self._last_cursor: str | None = None
   527	        self._breaks: list[str] = []
   528	        self._chained = 0
   529	
   530	    def feed(self, lineno: int, t: str, row: tuple) -> None:
   531	        if t == "fact":
   532	            self._pos.setdefault(row[0], len(self._fact_ids))
   533	            self._fact_ids.append(row[0])
   534	            self._fact_hashes.append(bytes.fromhex(_fact_row_hash(row)))
   535	            return
   536	        self._tick(lineno, row)
   537	
   538	    def _tick(self, lineno: int, row: tuple) -> None:
   539	        if row[9] is None:  # pre-chain era — nothing committed to verify
   540	            self._prev_row = row
   541	            return
   542	        self._chained += 1
   543	        expected_prev = (
   544	            _tick_row_hash(self._prev_row) if self._prev_row is not None else None
   545	        )
   546	        if row[6] != expected_prev:
   547	            self._break(lineno, row, "prev_hash mismatch — tick sequence altered")
   548	        if self._last_cursor is not None and row[7] != self._last_cursor:
   549	            self._break(
   550	                lineno, row,
   551	                "window_start does not continue the previous fact_cursor — "
   552	                "coverage gap",
   553	            )
   554	        if self._window_hash(row[7], row[8]) != row[9]:
   555	            self._break(
   556	                lineno, row, "window_hash mismatch — facts in the window altered"
   557	            )
   558	        self._last_cursor = row[8]
   559	        self._prev_row = row
   560	
   561	    def _break(self, lineno: int, row: tuple, reason: str) -> None:
   562	        if len(self._breaks) < 10:
   563	            self._breaks.append(f"log line {lineno} (tick {row[0]}): {reason}")
   564	
   565	    def _cursor_pos(self, fact_id: str) -> int | None:
   566	        """A window cursor as a position in log fact order.
   567	
   568	        ``""`` is the start-of-store sentinel (position 0, before the first
   569	        fact); an id the log never carried is unresolvable — the window then
   570	        hashes empty, exactly as ``SqliteStore._window_hash`` does, so an
   571	        honest empty window still agrees and a real one mismatches.
   572	        """
   573	        if fact_id == "":
   574	            return 0
   575	        pos = self._pos.get(fact_id)
   576	        return None if pos is None else pos + 1
   577	
   578	    def _window_hash(self, start: str, end: str) -> str:
   579	        lo = self._cursor_pos(start)
   580	        hi = self._cursor_pos(end)
   581	        if lo is None or hi is None:
