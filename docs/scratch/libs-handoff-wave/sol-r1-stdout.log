    48	def test_golden_decodes_to_the_exact_record_sequence():
    49	    lines = _lines(GOLDEN)
    50	    discriminators = [json.loads(ln)["t"] for ln in lines]
    51	    assert discriminators == ["fact", "fact", "fact", "batch", "batch", "tick"]
    52	
    53	    per_line = [deserialize_records(ln) for ln in lines]
    54	    assert [len(records) for records in per_line] == [1, 1, 1, 2, 3, 1]
    55	
    56	    flat = [rec for records in per_line for rec in records]
    57	    assert [t for t, _ in flat] == ["fact"] * 8 + ["tick"]
    58	    kinds = [row[1] for t, row in flat if t == "fact"]
    59	    assert kinds[0] == "_decl.genesis"
    60	    assert kinds[1] == kinds[2] == "note"
    61	    assert all(k.startswith("_decl.kind-") for k in kinds[3:])
    62	    # each ceremony stamps ONE effective ts (D1's ceremony half)
    63	    for records in per_line[3:5]:
    64	        assert len({row[2] for _, row in records}) == 1
    65	    # every ceremony (_decl.*) row is signed; ids unique across the log
    66	    assert all(
    67	        row[-1] is not None
    68	        for t, row in flat
    69	        if t == "fact" and row[1].startswith("_decl.")
    70	    )
    71	    ids = [row[0] for _, row in flat]
    72	    assert len(set(ids)) == len(ids)
