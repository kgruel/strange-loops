   707	class _Divergences:
   708	    """Content divergences found by the deep walk — all of them, capped report.
   709	
   710	    Reporting only the first divergence made "one edited row" and "the whole
   711	    index rewritten" print identically. The count is exact; the enumerated
   712	    detail stops at :attr:`_CAP` so a wholesale divergence cannot flood a
   713	    terminal.
   714	    """
   715	
   716	    _CAP = 10
   717	
   718	    def __init__(self) -> None:
   719	        self._details: list[str] = []
   720	        self._n = 0
   721	        self._all_beyond = True
   722	
   723	    def __bool__(self) -> bool:
   724	        return self._n > 0
   725	
   726	    def add(self, detail: str, beyond_offset: bool) -> None:
   727	        self._n += 1
   728	        if len(self._details) < self._CAP:
   729	            self._details.append(detail)
   730	        self._all_beyond = self._all_beyond and beyond_offset
   731	
   732	    def verdict(self) -> Check:
   733	        detail = "; ".join(self._details)
   734	        if self._n > len(self._details):
   735	            detail += f"; (+{self._n - len(self._details)} more)"
   736	        return Check("content", False, detail, beyond_offset=self._all_beyond)
