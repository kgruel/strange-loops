apps/tasks/loops/project.vertex
name "project"
store "data/project.db"

loops {
  decision {
    fold {
      items "by" "topic"
    }
  }

  thread {
    fold {
      items "by" "name"
    }
  }

  plan {
    fold {
      items "by" "name"
    }
  }

  completion {
    fold {
      items "by" "task"
    }
  }
}
apps/tasks/loops/tasks.vertex
name "tasks"
store "data/tasks.db"

loops {
  task.created {
    fold {
      items "by" "name"
    }
  }

  task.assigned {
    fold {
      items "by" "name"
    }
  }

  task.stage {
    fold {
      items "by" "name"
    }
  }

  task.completed {
    fold {
      items "by" "name"
    }
  }

  task.merged {
    fold {
      items "by" "name"
    }
  }

  worker.started {
    fold {
      items "by" "task"
    }
  }

  worker.output {
    fold {
      output "collect" 10000
    }
  }

  worker.output.complete {
    fold {
      items "by" "task"
    }
    boundary when="worker.output.complete"
  }
}

emit "task.tick"
apps/tasks/loops/harnesses/sonnet.loop
