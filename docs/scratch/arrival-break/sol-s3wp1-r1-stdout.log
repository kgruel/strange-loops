    45	    compare_absent_store,
    46	    heads_dir,
    47	    journal_path,
    48	    parse_journal_lines,
    49	    read_journal,
    50	    record_binding,
    51	    refusal_for,
    52	    state_root,
    53	    unaccounted_heads,
    54	)
    55	
    56	HEADER = json.dumps(
    57	    {"v": 1, "type": "arrival-head-observation", "protocol": 1, "wire": 1}
    58	)
    59	LINEAGE = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
    60	OTHER_LINEAGE = "01BX5ZZKBKACTAV9WEVGEMMVRZ"
    61	
    62	
    63	@pytest.fixture(autouse=True)
    64	def _isolated_state_root(tmp_path, monkeypatch):
    65	    """Point the state root at a temporary directory, for every test here.
    66	
    67	    Autouse rather than per-test: one forgotten opt-in is one test writing to
    68	    the real ``~/.local/state/loops``, and that failure would be invisible
    69	    until it had already happened.
    70	    """
    71	    monkeypatch.setenv("XDG_STATE_HOME", str(tmp_path / "state"))
    72	    return tmp_path / "state"
    73	
    74	
    75	def head(ordinal: int, digest: str = "a", lineage: str = LINEAGE) -> Head:
    76	    """A head whose hash is a recognizable 64-hex string."""
    77	    return Head(lineage=lineage, ordinal=ordinal, record_hash=digest * 64)
    78	
    79	
    80	def observation(
    81	    ordinal: int,
    82	    digest: str = "a",
    83	    *,
