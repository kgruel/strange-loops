   396	
   397	def resolve_ordering(ordering: Ordering | None, *, single_store: bool) -> Ordering:
   398	    """Resolve the declared read ordering, applying the Q2 rule.
   399	
   400	    Single store: ``Arrival()`` by default — the substrate's native order,
   401	    which is also the fold axis. Aggregate: ``ByKey('ts')`` by default, the
   402	    event-time read lens. ``Arrival()`` on an aggregate is REFUSED.
   403	
   404	    Raises:
   405	        OrderingError: ``Arrival()`` declared on an aggregate read.
   406	    """
   407	    if ordering is None:
   408	        return Arrival() if single_store else ByKey("ts")
   409	    if not single_store and isinstance(ordering, Arrival):
   410	        raise OrderingError(
   411	            "Arrival() is not available on an aggregate read: arrival ordinals are "
   412	            "dense per-log, so a combined view of several stores has no cross-store "
   413	            "arrival total order. Declare ByKey(field) instead — e.g. ByKey('ts'), "
   414	            "the aggregate default."
   415	        )
   416	    return ordering
   417	
   418	
   419	def _fetch_combined_rows(
   420	    conn: sqlite3.Connection,
   421	    aliases: list[str],
   422	    until_ts: float | None,
   423	    ordering: Ordering,
   424	) -> list[tuple]:
   425	    """All fact rows across the attached stores, ready for ``ordering``.
   426	
   427	    Under ``Arrival()`` the rows are put in the store's native ARRIVAL order
   428	    (rowid ascending) here, because yielding that order is the store's job and
   429	    ``totalize`` will not synthesize it. ``Arrival()`` is reachable only for a
   430	    single store — :func:`resolve_ordering` refuses it on an aggregate, where
   431	    rowid is per-store and no native total order exists.
   432	
   433	    Under ``ByKey(K)`` the rows come back exactly as read: ``totalize`` sorts
   434	    on ``(K, id)``, and ``id`` is unique, so the key is total and the input
   435	    order cannot reach the output. Sorting first would be work discarded.
   436	    """
   437	    ts_clause = " WHERE ts <= ?" if until_ts is not None else ""
   438	    selects = [
   439	        f"SELECT id, kind, ts, observer, origin, payload, rowid "
   440	        f"FROM {'[' + a + '].' if a != 'main' else ''}facts{ts_clause}"
   441	        for a in aliases
   442	    ]
   443	    sql = " UNION ALL ".join(selects)
   444	    params = (until_ts,) * len(aliases) if until_ts is not None else ()
   445	    rows = conn.execute(sql, params).fetchall()
   446	    # Sort in Python — avoids a SQLite index scan for the ORDER BY, which
   447	    # causes random I/O (~14ms vs ~1ms for unsorted read).
   448	    if isinstance(ordering, Arrival):
   449	        rows.sort(key=lambda r: r[6])
   450	    return rows
   451	
   452	
   453	def _combined_read(
   454	    ast: Any, vertex_path: Path, specs: dict, *, observer: str | None = None,
   455	    ordering: Ordering | None = None,
   456	    return_payloads: bool = False,
   457	    until_ts: float | None = None,
   458	) -> "dict[str, dict[str, Any]] | tuple[dict[str, dict[str, Any]], dict[str, list[dict]]]":
   459	    """Fold state across multiple stores (combinatorial vertex_read).
   460	
   461	    Fetches all facts in a single SQL query across attached stores,
   462	    then groups by kind and replays through specs. Single query avoids
   463	    the SQLite cold-start penalty (~10ms) that would hit the first of
   464	    N per-kind queries.
   465	
   466	    ``ordering`` declares the replay order. ``None`` resolves per
   467	    :func:`resolve_ordering` — ``Arrival()`` for a single store, ``ByKey('ts')``
   468	    for an aggregate, and ``Arrival()`` on an aggregate is refused.
   469	
   470	    When ``return_payloads=True``, returns ``(raw_state, kind_payloads)``
   471	    so callers can use the per-kind payload lists for retain_facts /
   472	    source_facts population without re-querying the stores.
   473	
   474	    ``until_ts`` (0.8.0 fold-state-``as_of``, A9) caps every member's facts
   475	    to ``ts <= until_ts`` — the event-time projection over an aggregate.
   476	    Membership itself stays CURRENT file state regardless (aggregation
   477	    internal tables are not yet built, the shipped "aggregate-head" honesty
   478	    marker) — only the facts axis is cut by the cursor.
   479	    """
   480	    store_paths = _resolve_stores(ast, vertex_path)
   481	
   482	    # Resolve BEFORE the empty-members return: whether a declared ordering fits
   483	    # this read is a property of the DECLARATION, not of how many members
   484	    # happen to resolve right now. An aggregate whose members are all currently
   485	    # missing still has no cross-store arrival axis, so Arrival() is refused
   486	    # there exactly as it is once the members come back — otherwise the same
   487	    # declaration would start refusing only after enough files appeared, and
   488	    # the refusal would be availability-dependent.
   489	    ordering = resolve_ordering(ordering, single_store=len(store_paths) == 1)
   490	
   491	    if not store_paths:
   492	        empty_raw = {kind: spec.initial_state() for kind, spec in specs.items()}
   493	        if return_payloads:
   494	            return empty_raw, {k: [] for k in specs}
   495	        return empty_raw
   496	
   497	    conn, aliases = _open_combined(store_paths)
   498	    try:
   499	        # Single query for all facts, then ordered by the DECLARED ordering.
   500	        #
   501	        # Under Arrival() the fetch's native order stands: receipt order, the
   502	        # ratified fold axis, matching StoreReader.facts_by_kind. Under
   503	        # ByKey(K) the fold is a lens projection, not a receipt replay, and
   504	        # may disagree with an Arrival fold of the same facts — which is why
   505	        # a combined read (no cross-store arrival axis) is ByKey by rule.
   506	        #
   507	        # ByKey(K) on a payload field also drops facts lacking K from the
   508	        # fold INPUT: a key names what it projects, and the caller named K.
   509	        rows = totalize(
   510	            _fetch_combined_rows(conn, aliases, until_ts, ordering),
   511	            ordering,
   512	            get_field=_row_field,
   513	            get_id=_row_id,
   514	        )
   515	
   516	        # Build kind → spec lookup, including sub-kind (dot-prefix) routing.
   517	        # "thread.foo" → "thread" if "thread" is a spec kind.
   518	        spec_kinds = set(specs)
   519	        kind_payloads: dict[str, list] = {k: [] for k in specs}
   520	
   521	        for r in rows:
   522	            kind = r[1]
   523	            if observer and not observer_matches(r[3], observer):
   524	                continue
   525	            # Exact match
   526	            if kind in spec_kinds:
   527	                target = kind
   528	            else:
   529	                # Sub-kind: "foo.bar" → check "foo"
   530	                dot = kind.find(".")
   531	                if dot < 0:
   532	                    continue
   533	                prefix = kind[:dot]
   534	                if prefix not in spec_kinds:
   535	                    continue
   536	                target = prefix
   537	            p = json.loads(r[5])
   538	            p["_id"] = r[0]
   539	            p["_ts"] = r[2]
   540	            p["_observer"] = r[3]
   541	            p["_origin"] = r[4] or ""
   542	            kind_payloads[target].append(p)
   543	
   544	        raw = {
   545	            kind: spec.replay(kind_payloads[kind])
   546	            for kind, spec in specs.items()
   547	        }
   548	        if return_payloads:
   549	            return raw, kind_payloads
   550	        return raw
   551	    finally:
   552	        conn.close()
   553	
