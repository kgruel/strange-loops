   430	def _check_offset(conn, canonical: Path, offset: int | None, size: int) -> Check:
   431	    if offset is None:
   432	        if size == 0:
   433	            return Check("offset", True, "empty log, nothing to have consumed")
   434	        return Check(
   435	            "offset", False,
   436	            f"no consumed-offset marker, but the log holds {size} byte(s) — "
   437	            "the index cannot account for the canonical log",
   438	        )
   439	    if offset == size:
   440	        return Check("offset", True, f"index has consumed all {size} byte(s)")
   441	    if offset < size:
   442	        if _suffix_unindexed(conn, canonical, offset, size):
   443	            return Check(
   444	                "offset", False,
   445	                f"index is behind the log by {size - offset} byte(s) "
   446	                f"(offset {offset}, log {size}), and the first unindexed line "
   447	                "is genuinely unindexed — consistent with an interrupted "
   448	                "append; run --deep to judge the rest of that suffix",
   449	                beyond_offset=True,
