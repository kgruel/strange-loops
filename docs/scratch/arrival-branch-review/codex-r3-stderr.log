   194	def probe_target(path: Path | str) -> TargetInfo:
   195	    """Classify a path against the residence rule — pure inspection.
   196	
   197	    Never creates, materializes, or repairs anything (module docstring has
   198	    the full contract). Returns a :class:`TargetInfo` for every input; an
   199	    unrecognized suffix answers ``target_type="unknown"`` rather than
   200	    raising, because "what is this?" deserves an answer even when the
   201	    answer is "not a loops artifact".
   202	    """
   203	    path = Path(path)
   204	    suffix = path.suffix
   205	    if suffix == VERTEX_SUFFIX:
   206	        return _probe_vertex(path)
   207	    if suffix == ARRIVAL_SUFFIX:
   208	        return _probe_arrival(path)
