   951	    def walk(self) -> Iterator[dict]:
   952	        """Every complete record in order, fully verified.
   953	
   954	        Verifies, per record: that it decodes, that its ``rh`` recomputes
   955	        (inside :func:`decode_record`), that it may sit where it sits — the
   956	        full genesis rules at ordinal 0 and no genesis kind above it, via
   957	        :func:`_placement_fault` — that its lineage matches the genesis's,
   958	        that its ordinal is the next one — dense and ascending from 0, so a
   959	        gap or a repeat is caught — and that its ``prev`` names its
   960	        predecessor's ``rh``. Any failure raises :class:`ArrivalCorrupt`
   961	        naming the ordinal. Nothing is skipped and nothing is truncated.
   962	
   963	        The genesis rules are enforced HERE and not only in
   964	        :meth:`genesis`, because a walk that trusted position 0 without
   965	        judging it would read a forged unsigned genesis clean — and
   966	        :meth:`read` and :meth:`head` both reach their answer through this
   967	        walk, so the check has to live on the path they share.
   968	
   969	        A trailing line with no ``\\n`` ends the walk without complaint. The
   970	        reader holds no lock, so it cannot tell an interrupted append from
   971	        one that is in flight this instant, and it must assume the kinder of
   972	        the two.
   973	
   974	        **This is a generator: calling it validates nothing.** Every check
   975	        above runs as records are pulled, so ``log.walk()`` on its own is
   976	        not an integrity test and must not be used as one — ``list(...)``
   977	        it, or iterate it to the end. The laziness is deliberate (a caller
   978	        reading the first ten records of a large log should not pay for the
   979	        rest), and it is worth naming because "I called walk and it did not
   980	        raise" is a natural and wrong way to read this code.
   981	        """
   982	        yield from _records_only(self._walk_marked_from_zero())
