   530	def days_since_audit(read: JournalRead, now: float) -> float | None:
   531	    """Days since the last audit entry in the CURRENT epoch, or None.
   532	
   533	    Report only. The open path never triggers an audit, because a full walk at
   534	    open is exactly what the adapter refused to pay under an ``Open`` label —
   535	    an operation that quietly upgraded its own verification level would be
   205	        switch for a safety property is a shape the arrival vocabulary
   206	        ratchet's own denylist rejects: custody is structural rather than
   207	        configured, so there is no flag here and no second opener that skips
   208	        the comparison.
   209	
   210	        The comparison happens at construction, which means **this method
   211	        raises what the comparison raises**: a rollback, a fork, a rewrite, a
   212	        replacement or a lost store refuses the open rather than being reported
   213	        afterwards by a caller who might not ask. This is also why the seam
   214	        sits here rather than deeper — the opener above performs no recovery,
   215	        so the comparison sees the store as it is rather than as a catch-up
   216	        just repaired it.
   217	        """
   218	        opener = self._openers.get(descriptor.backend)
   219	        if opener is None:
   220	            known = ", ".join(self.registered()) or "(none)"
   221	            raise UnknownBackend(
   222	                f"no adapter registered for backend {descriptor.backend!r} "
   223	                f"(registered: {known})"
   224	            )
   225	        ledger, query = opener(descriptor)
   226	        attested = AttestedLedger(
   227	            ledger, location=descriptor.location, query=query
   228	        )
   229	        return attested, query

