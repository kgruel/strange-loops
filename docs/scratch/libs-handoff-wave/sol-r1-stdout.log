  1244	    def _extended_tick_query(self, new_ticks: list[StoredTick]) -> dict[str, StoredTick]:
  1245	        """A NEW tick-query map (copy + folded new ticks) — never an in-place
  1246	        mutation of the published one, so ``_publish`` can swap it by reference
  1247	        without a reader observing a half-update."""
  1248	        updated = dict(self._tick_query)
  1249	        for t in new_ticks:
  1250	            updated[t.name] = t  # rowid-ordered → last wins = latest
  1251	        return updated
