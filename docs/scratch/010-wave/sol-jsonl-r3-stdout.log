   635	    def _prefix_intact(self, offset: int) -> bool:
   636	        """Cheap integrity check on the consumed prefix.
   637	
   638	        ``offset`` must land just past a newline, and the last line before it
   639	        must re-serialize byte-identically from the sqlite row it names — a
   640	        commitment comparison over one line rather than the whole file.
   641	
   642	        One line, not the file: judging every row would make each open O(n)
   643	        over the log. So this catches an edit to the last consumed row and
   644	        nothing behind it — interior content is ``verify_chain``'s scope.
   645	        """
   646	        if offset == 0:
   647	            return True
   648	        with self._log_path.open("rb") as fh:
   649	            fh.seek(offset - 1)
   650	            if fh.read(1) != b"\n":
   651	                return False
   652	            # Walk back to the true line start however long the line is —
   653	            # declining to judge past a fixed window would turn the check off
   654	            # as a function of payload size.
   655	            line_start = self._last_newline_before(fh, offset - 1)
   656	            fh.seek(line_start)
   657	            raw = fh.read(offset - 1 - line_start)
   658	        try:
   659	            line = raw.decode("utf-8")
   660	        except UnicodeError:
   661	            return False
   662	        try:
   663	            t, row = deserialize_row(line)
   664	        except (JsonlCodecError, UnicodeError):
   665	            return False
   666	        return self._row_matches(t, row)
