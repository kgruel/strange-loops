   270	
   271	def format_ts_iso(dt: datetime) -> str:
   272	    """Format datetime as ISO 8601 for FULL zoom display."""
   273	    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")
   274	
   275	
   276	def _is_secondary(key: str, value) -> bool:
   277	    """Whether a payload field should be shown on continuation lines at DETAILED+.
   278	
   279	    Secondary: description, worktree, output, message, base_branch, or any value >40 chars.
   280	    """
   281	    if key in ("description", "worktree", "output", "message", "base_branch"):
   282	        return True
   283	    return isinstance(value, str) and len(value) > 40
   284	
   285	
   286	def fact_line_zoom(fact: dict, zoom) -> "list[Block]":
   287	    """Render a fact as one or more Blocks depending on zoom level.
   288	
   289	    SUMMARY: delegates to fact_line() — single line.
   290	    DETAILED: primary line + secondary fields on indented continuation lines.
   291	    FULL: ISO timestamp, each payload field on its own indented line.
   292	    """
   293	    from painted import Zoom
   294	    from painted.core.block import Block
   295	    from painted.palette import current_palette
   296	
   297	    if zoom <= Zoom.SUMMARY:
   298	        return [fact_line(fact)]
   299	
   300	    p = current_palette()
   301	    ts = fact["ts"]
   302	    if isinstance(ts, datetime):
   303	        dt = ts
   304	    else:
   305	        dt = datetime.fromtimestamp(ts, tz=timezone.utc)
   306	
   307	    kind = fact["kind"]
   308	    obs = fact.get("observer", "")
   309	    payload = fact["payload"]
   310	    who = f" ({obs})" if obs else ""
   311	
   312	    if zoom == Zoom.FULL:
   313	        # ISO timestamp, kind + observer on primary line, each field on own line
   314	        time_str = format_ts_iso(dt)
   315	        lines: list[Block] = [Block.text(f"  {time_str} [{kind}]{who}", p.muted)]
   316	        for k, v in payload.items():
   317	            if v is not None and v != "":
   318	                lines.append(Block.text(f"      {k}={v}", p.muted))
   319	        origin = fact.get("origin", "")
   320	        if origin:
   321	            lines.append(Block.text(f"      origin={origin}", p.muted))
   322	        return lines
   323	
   324	    # DETAILED: primary fields inline, secondary on continuation lines
   325	    primary_parts = []
   326	    secondary: list[tuple[str, str]] = []
   327	    for k, v in payload.items():
   328	        if v is None or v == "":
   329	            continue
   330	        if _is_secondary(k, v):
   331	            secondary.append((k, str(v)))
   332	        else:
   333	            primary_parts.append(f"{k}={v}")
   334	
   335	    time_str = format_ts(dt)
   336	    summary = " ".join(primary_parts)
   337	    text = f"  {time_str} [{kind}]{who} {summary}" if summary else f"  {time_str} [{kind}]{who}"
   338	    lines = [Block.text(text, p.muted)]
   339	    for k, v in secondary:
   340	        lines.append(Block.text(f"      {k}={v}", p.muted))
   341	    return lines
   342	
   343	
   344	def tick_line_zoom(tick: dict, zoom) -> "list[Block]":
