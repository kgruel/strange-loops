   797	def _known_of(epoch: tuple[HeadAttestation, ...]) -> HeadAttestation | None:
   798	    """*K*: the maximum-ordinal entry of the epoch, not the last line.
   799	
   800	    Two writers append concurrently — the arrival lock serializes their
   801	    *appends*, not their journal writes — so lines can land out of order: A
   802	    commits ordinal 5, B commits 6 and journals it, A journals 5 last.
   803	    Last-line semantics would then read K=5 and classify a genuine restore to
   804	    5 as unchanged. Maximum-ordinal closes it, and duplicate entries at one
   805	    ordinal are harmless.
   806	    """
   807	    if not epoch:
   808	        return None
   809	    best = max(epoch, key=lambda entry: entry.head.ordinal)
   810	    tied = {
   811	        entry.head.record_hash
   812	        for entry in epoch
   813	        if entry.head.ordinal == best.head.ordinal
   814	    }
   815	    if len(tied) > 1:
   816	        raise JournalEquivocation(
   817	            f"journal holds {len(tied)} different records at ordinal "
   818	            f"{best.head.ordinal} in the current trust epoch: "
   819	            f"{', '.join(sorted(tied))}"
   820	        )

